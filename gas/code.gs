      function getReport(body) {
        try {
          var auth = resolveAuthContext(body);
          var reportId = String(body.reportId || '').trim();
          if (!reportId) return { success: false, error: 'Липсва reportId.' };
          var rptSheet = getReportsSheet();
          var data = rptSheet.getDataRange().getValues();
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][RPT_COL.ID - 1]).trim() !== reportId) continue;
            var r = data[i];
            return {
              success: true,
              report: {
                id: String(r[RPT_COL.ID - 1]),
                projectId: String(r[RPT_COL.PROJECT_ID - 1]),
                reportType: String(r[RPT_COL.REPORT_TYPE - 1]),
                status: String(r[RPT_COL.STATUS - 1]),
                period: String(r[RPT_COL.PERIOD - 1]),
                submittedBy: String(r[RPT_COL.SUBMITTED_BY - 1]),
                submittedAt: String(r[RPT_COL.SUBMITTED_AT - 1]),
                scientificContent: (function() { try { return JSON.parse(String(r[RPT_COL.SCIENTIFIC_CONTENT - 1] || '{}')); } catch (_) { return String(r[RPT_COL.SCIENTIFIC_CONTENT - 1] || ''); } })(),
                financialSummary: (function() { try { return JSON.parse(String(r[RPT_COL.FINANCIAL_SUMMARY - 1] || '{}')); } catch (_) { return String(r[RPT_COL.FINANCIAL_SUMMARY - 1] || ''); } })(),
                reviewerId: String(r[RPT_COL.REVIEWER_ID - 1]),
                reviewerScore: String(r[RPT_COL.REVIEWER_SCORE - 1]),
                reviewedAt: String(r[RPT_COL.REVIEWED_AT - 1]),
                acceptedAt: String(r[RPT_COL.ACCEPTED_AT - 1]),
                returnComment: String(r[RPT_COL.RETURN_COMMENT - 1]),
                fileIds: (function() { try { return JSON.parse(String(r[RPT_COL.FILE_IDS - 1] || '[]')); } catch (_) { return []; } })(),
                history: (function() { try { return JSON.parse(String(r[RPT_COL.HISTORY - 1] || '[]')); } catch (_) { return []; } })()
              }
            };
          }
          return { success: false, error: 'Отчетът не е намерен.' };
        } catch (err) {
          logError('getReport', err, body);
          return { success: false, error: 'getReport failed: ' + err.message };
        }
      }

      function acceptReport(body) {
        try {
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin && auth.role !== ROLE_CKK && auth.role !== ROLE_NIDD) return { success: false, error: 'Нямате право.' };
          var reportId = String(body.reportId || '').trim();
          if (!reportId) return { success: false, error: 'Липсва reportId.' };
          var rptSheet = getReportsSheet();
          var data = rptSheet.getDataRange().getValues();
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][RPT_COL.ID - 1]).trim() !== reportId) continue;
            var now = new Date().toISOString();
            var hist = [];
            try { hist = JSON.parse(String(data[i][RPT_COL.HISTORY - 1] || '[]')); } catch (_) {}
            hist.push({ status: 'accepted', ts: now, by: auth.userId });
            var acceptedRow = data[i].slice();
            acceptedRow[RPT_COL.STATUS - 1] = 'accepted';
            acceptedRow[RPT_COL.ACCEPTED_AT - 1] = now;
            if (body.reviewerScore !== undefined) acceptedRow[RPT_COL.REVIEWER_SCORE - 1] = body.reviewerScore;
            if (body.reviewedAt !== undefined) acceptedRow[RPT_COL.REVIEWED_AT - 1] = body.reviewedAt;
            acceptedRow[RPT_COL.HISTORY - 1] = JSON.stringify(hist);
            rptSheet.getRange(i + 1, 1, 1, RPT_TOTAL_COLS).setValues([acceptedRow]);
            console.log('[AUDIT] acceptReport', auth.userId, { reportId: reportId });
            return { success: true };
          }
          return { success: false, error: 'Отчетът не е намерен.' };
        } catch (err) {
          logError('acceptReport', err, body);
          return { success: false, error: 'acceptReport failed: ' + err.message };
        }
      }

      function returnReport(body) {
        try {
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin && auth.role !== ROLE_CKK && auth.role !== ROLE_NIDD) return { success: false, error: 'Нямате право.' };
