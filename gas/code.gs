          try { _bustSheetCache_(SHEET_NAME); } catch (_) {}
          try { var _cacheKey = 'fm:u:' + caller; if (_sheetReadCache_['fm:u:' + caller]) delete _sheetReadCache_['fm:u:' + caller]; } catch (_) {}
          try { if (_sheetReadCache_['fm:a']) delete _sheetReadCache_['fm:a']; } catch (_) {}
          try { logTransaction('form.delete', caller, { formId: id, status: 'deleted', folderCleaned: folderDeleted, sessionFilesDeleted: sessionFilesDeleted }); } catch (_) {}
          return { success: true, id: id, folderCleaned: folderDeleted, sessionFilesDeleted: sessionFilesDeleted };
        } catch (err) {
          try { logError('deleteFormDraft', err, Object.assign({}, body||{}, {_stage:'deleteFormDraft_'})); } catch (_) {}
