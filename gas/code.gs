        var now = Date.now();
        // v12.28.2-perf: Faster failover — after 1 failure, skip health check for 3s
        if (!_mysqlHealthCache_.ok && (_mysqlHealthCache_.failCount || 0) >= _MYSQL_FAST_FAIL_THRESHOLD) {
          var fastFailAge = now - _mysqlHealthCache_.ts;
          var fastFailTTL = 3000; // v12.28.2-perf: 5s→3s — quicker recovery window
          if (fastFailAge < fastFailTTL) {
            return false;
          }
          _mysqlHealthCache_.failCount = 0;
        }

        if (_mysqlHealthCache_.ok && (now - _mysqlHealthCache_.ts) < _mysqlHealthCache_.ttl) {
          return true;
        }
        // v12.28.2-perf: Warm cache — extend TTL to 60s for known-healthy connections
        if (_mysqlHealthCache_.ok && _mysqlHealthCache_.warmCount > 2 && (now - _mysqlHealthCache_.ts) < 60000) {
          return true;
        }
        try {
          var _pool = HOSTINGER_URL_POOL.length ? HOSTINGER_URL_POOL : [_getHostingerUrl_()];
          var pingPayload = JSON.stringify({ action: 'ping', _gasSync: true });
          // v12.28.2-perf: Aggressive timeouts — primary 1s, pool 2s each
          for (var _pi = 0; _pi < _pool.length; _pi++) {
            var _tryUrl = _pool[_pi];
            if (!_tryUrl || _tryUrl.indexOf('http') !== 0) continue;
            try {
              var _pingTimeout = (_pi === 0) ? 1.0 : 2.0; // primary 1s, others 2s
              var opts = {
                method: 'post',
                contentType: 'application/json',
                payload: pingPayload,
                muteHttpExceptions: true,
                timeout: _pingTimeout
              };
              var resp = UrlFetchApp.fetch(_tryUrl, opts);
              var code = resp.getResponseCode();
              var text = resp.getContentText();
              if (code === 200 && text) {
                var parsed = JSON.parse(text);
                if (parsed && parsed.ping === 'pong') {
                  _markHostingerHealthy_(_tryUrl);
                  var warmCount = (_mysqlHealthCache_.warmCount || 0) + 1;
                  _mysqlHealthCache_ = { ok: true, ts: now, ttl: 30000, failCount: 0, warmCount: warmCount };
                  return true;
                }
              }
            } catch (_) { /* try next URL */ }
          }
        } catch (_) {}
        _mysqlHealthCache_.failCount = (_mysqlHealthCache_.failCount || 0) + 1;
        _mysqlHealthCache_ = { ok: false, ts: now, ttl: 5000, failCount: _mysqlHealthCache_.failCount }; // v12.28.2-perf: 10s→5s retry window
        return false;
      }

      /**
       * v10.4.1-hostingerdb: Sync a full data set (e.g. ALL applications) to MySQL cache.
       * Used after initial deployment or when MySQL needs a complete refresh.
       * Sends the data as a gascachesync batch so the PHP backend can bulk-INSERT.
       * @param {string} dataType — 'applications' | 'competitions' | 'reviewers' | 'projects' |
       *                            'documents' | 'all'
       * @param {string} [userEmail] — optional user filter
       */
      // Per-execution sync dedup (module-level, not window — GAS V8 has no window)
      var __erpSyncDone__ = {};
      function _syncFullDataSetToMySQL_(dataType, userEmail) {
        try {
          if (!HOSTINGER_API_URL) return;
          var syncKey = '_fullSync_' + dataType + '_' + (userEmail || 'all');
          // Deduplicate: skip if already synced within this execution
          if (__erpSyncDone__[syncKey]) return;
          __erpSyncDone__[syncKey] = true;

          var dataSets = [];
          if (dataType === 'all' || dataType === 'applications') {
            try {
              var formsData = userEmail
                ? getForms({ userId: userEmail, isAdmin: false, lean: false,
                    forceRefresh: true, __skipReauth: true })
                : getForms({ isAdmin: true, lean: false, forceRefresh: true,
                    __skipReauth: true });
              if (formsData && formsData.success && formsData.forms) {
                dataSets.push({ action: 'getforms', data: formsData.forms });
              }
            } catch (_) {}
          }
          if (dataType === 'all' || dataType === 'competitions') {
            try {
              var compsData = getCompetitions({ isAdmin: true, activeOnly: false,
                forceRefresh: true, __skipReauth: true });
              if (compsData && compsData.success && compsData.competitions) {
                dataSets.push({ action: 'getcompetitions', data: compsData.competitions });
              }
            } catch (_) {}
          }
          if (dataType === 'all' || dataType === 'reviewers') {
            try {
              var revData = getReviewers({ isAdmin: true, forceRefresh: true,
                __skipReauth: true });
              if (revData && revData.success && revData.reviewers) {
                dataSets.push({ action: 'getreviewers', data: revData.reviewers });
              }
            } catch (_) {}
          }
          if (dataType === 'all' || dataType === 'projects') {
            try {
              var projData = getProjects({ isAdmin: true, forceRefresh: true,
                __skipReauth: true });
              if (projData && projData.success && projData.projects) {
                dataSets.push({ action: 'getprojects', data: projData.projects });
              }
            } catch (_) {}
          }
          if (dataType === 'all' || dataType === 'documents') {
            try {
              var docData = listDocuments({ isAdmin: true, forceRefresh: true,
                __skipReauth: true });
              if (docData && docData.success && docData.documents) {
                dataSets.push({ action: 'listdocuments', data: docData.documents });
              }
            } catch (_) {}
          }

          if (!dataSets.length) return;

          // Send each data set to the PHP cache individually to respect size limits
          for (var si = 0; si < dataSets.length; si++) {
            try {
              var cachePayload = {
                action: 'gascachesync',
                cacheKey: 'fullsync:' + dataSets[si].action + ':' +
                  (userEmail || 'all') + ':' + new Date().getTime(),
                responseData: JSON.stringify(dataSets[si].data),
                action: dataSets[si].action,
                userEmail: userEmail || '',
                ttlSeconds: 3600
              };
              _syncToMySQL_('gascachesync', cachePayload);
            } catch (_) {}
          }
          console.info('[HostingerSync] Full data sync complete for: ' + dataType +
            ' (' + dataSets.length + ' data sets)');
        } catch (_) { /* silent */ }
      }

      /**
       * v10.4.1-hostingerdb: Mirror Drive file creation to MySQL.
       * Called whenever a new file is created in Drive so the PHP backend
       * can track it without re-scanning Drive.
       * @param {Object} fileInfo — { fileId, name, mimeType, size, parentFolder, formId? }
       */
      function _syncDriveFileToMySQL_(fileInfo) {
        try {
          var _syncUrl = _getHostingerUrl_();
          if (!_syncUrl || !fileInfo || !fileInfo.fileId) return;
          var payload = {
            action: 'syncdrivefile',
            fileId: fileInfo.fileId,
            fileName: fileInfo.name || '',
            mimeType: fileInfo.mimeType || '',
            fileSize: fileInfo.size || 0,
            parentFolder: fileInfo.parentFolder || '',
            formId: fileInfo.formId || '',
            projectType: fileInfo.projectType || '',
            userEmail: fileInfo.userEmail || '',
            _gasSync: true
          };
