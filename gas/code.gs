          try { logError('getTRL', err, body); } catch (_) {}
          return { success: false, error: 'getTRL failed: ' + err.message };
        }
      }

      // ═══════════════════════════════════════════════════════════════════
      //  v6.8.0 — SUPPORT LETTERS for ПНИ
      // ═══════════════════════════════════════════════════════════════════

      function saveSupportLetters(body) {
        try {
          var proposalId = String(body.proposalId || '').trim();
          var applicantEmail = String(body.applicantEmail || '').trim();
          var letters = Array.isArray(body.letters) ? body.letters : [];
          if (!proposalId || !applicantEmail) {
            return { success: false, error: 'Липсват задължителни полета (proposalId, applicantEmail).' };
          }
          if (letters.length > 2) {
            return { success: false, error: 'Могат да бъдат приложени до 2 писма за подкрепа.' };
          }
          var ss = _getOrCreateSheet_('SupportLetters',
            ['id', 'proposalId', 'applicantEmail', 'organizationName', 'organizationType',
             'fileId', 'fileName', 'description', 'createdAt']
          );
          // Remove existing
          var data = ss.getDataRange().getValues();
          var rowsToDelete = [];
          for (var i = data.length - 1; i >= 1; i--) {
            if (String(data[i][1]).trim() === proposalId) rowsToDelete.push(i + 1);
          }
          rowsToDelete.sort(function(a,b){ return b - a; });
          rowsToDelete.forEach(function(r) { ss.deleteRow(r); });
          var saved = [];
          letters.forEach(function(l) {
            var id = _uuid_();
            ss.appendRow([id, proposalId, applicantEmail,
              String(l.organizationName || '').trim(),
              String(l.organizationType || '').trim(), // 'bulgarian' | 'foreign'
              String(l.fileId || '').trim(),
              String(l.fileName || '').trim(),
              String(l.description || '').trim(),
              new Date().toISOString()
            ]);
            saved.push({ id: id, organizationName: l.organizationName });
          });
          try { logTransaction('SAVE_SUPPORT_LETTERS', applicantEmail, proposalId, { count: saved.length }); } catch (_) {}
          return { success: true, saved: saved };
        } catch (err) {
          try { logError('saveSupportLetters', err, body); } catch (_) {}
          return { success: false, error: 'saveSupportLetters failed: ' + err.message };
        }
      }

      function getSupportLetters(body) {
        try {
          var proposalId = String(body.proposalId || '').trim();
          if (!proposalId) return { success: false, error: 'proposalId is required.' };
          var ss = _getOrCreateSheet_('SupportLetters',
            ['id', 'proposalId', 'applicantEmail', 'organizationName', 'organizationType',
             'fileId', 'fileName', 'description', 'createdAt']
          );
          var data = ss.getDataRange().getValues();
          var result = [];
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][1]).trim() === proposalId) {
              result.push({
                id: data[i][0], proposalId: data[i][1], applicantEmail: data[i][2],
                organizationName: data[i][3], organizationType: data[i][4],
                fileId: data[i][5], fileName: data[i][6], description: data[i][7],
                createdAt: data[i][8]
              });
            }
          }
          return { success: true, letters: result };
        } catch (err) {
          try { logError('getSupportLetters', err, body); } catch (_) {}
          return { success: false, error: 'getSupportLetters failed: ' + err.message };
        }
      }

      // ═══════════════════════════════════════════════════════════════════
      //  v6.9.0 — USER NOTIFICATION PREFERENCES
      //  Per-user notification channel toggles stored in a UserPreferences
      //  sheet. When a user opts out of a channel, the corresponding
      //  notification type is skipped in _queueDeferredEmail_ and
      //  notifyApplicant_.
      // ═══════════════════════════════════════════════════════════════════

      var DEFAULT_NOTIFICATION_PREFS = {
        email_otp: true,              // OTP verification codes
        email_status_change: true,    // Application status transitions
        email_review_invite: true,    // Invitation to review
        email_review_reminder: true,  // Review deadline reminders
        email_comment: true,          // Admin comments/corrections
        email_contract: true,         // Contract signing notifications
        email_report_due: true,       // Report deadline reminders
        email_expense: true,          // Expense approval/rejection
        email_sanction: true,         // Sanction notifications
        email_new_message: true,      // New message from admin
        email_broadcast: true,        // System-wide announcements
        email_change_request: true,   // Change request approval/rejection
        inapp_messages: true,         // In-app message notifications
        inapp_alerts: true,           // Critical alerts (banner/toast)
        notification_frequency: 'instant' // Delivery frequency
      };

      // ── Shared pref-merge helper (v6.9.0+) ─────────────────────────────
      // Used by saveUserPreferences, getUserPreferences,
      // _getSystemNotificationSettings_, and saveSystemNotificationSettings.
      // Starts with defaults, overlays incoming values, preserving their
      // original type (boolean, string, number). Everything else → boolean.
      function _mergePrefs_(overrides, defaults) {
        var base = defaults || DEFAULT_NOTIFICATION_PREFS;
        var merged = Object.assign({}, base);
        if (!overrides || typeof overrides !== 'object') return merged;
        Object.keys(overrides).forEach(function(k) {
          var v = overrides[k];
          if (typeof v === 'boolean' || typeof v === 'string' || typeof v === 'number') {
            merged[k] = v;
          } else if (v !== undefined && v !== null) {
            merged[k] = !!v;
          }
        });
        return merged;
      }

      // ── UserPreferences sheet accessor (cached per execution) ──────────
      // Called by saveUserPreferences, getUserPreferences, and
      // _checkNotificationPref_. The sheet reference is cached for the
      // lifetime of this execution to avoid repeated getSheetByName calls.
      var _userPrefsSheetCache_ = null;
      function _getUserPrefsSheet_() {
        if (_userPrefsSheetCache_) return _userPrefsSheetCache_;
        _userPrefsSheetCache_ = _getOrCreateSheet_('UserPreferences',
          ['email', 'prefsJson', 'updatedAt']
        );
        return _userPrefsSheetCache_;
      }

      // ── Per-execution UserPreferences data cache ──────────────────────
      // _checkNotificationPref_ reads the full sheet data on every call.
      // For hot paths (many emails sent per request), this cache avoids
      // N × getDataRange().getValues() bridge crossings.
      var _cachedUserPrefsData_ = null;
      var _cachedUserPrefsDataTs_ = 0;
      function _getUserPrefsData_() {
        // Bust after any write to UserPreferences (saveUserPreferences
        // increments _userPrefsVersion_). Simple invalidation via timestamp.
        if (_cachedUserPrefsData_ && (_cachedUserPrefsDataTs_ === _userPrefsVersion_)) {
          return _cachedUserPrefsData_;
        }
        try {
          _cachedUserPrefsData_ = _getUserPrefsSheet_().getDataRange().getValues();
          _cachedUserPrefsDataTs_ = _userPrefsVersion_;
        } catch (_) {
          _cachedUserPrefsData_ = [];
        }
        return _cachedUserPrefsData_;
      }
      var _userPrefsVersion_ = 0;
      function _bustUserPrefsCache_() {
        _userPrefsVersion_ = Date.now();
        _cachedUserPrefsData_ = null;
        _userPrefsSheetCache_ = null;
        _cachedUserPrefsDataTs_ = 0;
      }

      /**
       * Get system-wide notification settings.
       * Stored in ScriptProperties under key 'SYSTEM_NOTIFICATION_SETTINGS'.
       * When a channel is false, ALL users are blocked from receiving that
       * notification type, regardless of their personal preference.
       * Admins can override individual channels for themselves.
       */
      function _getSystemNotificationSettings_() {
        try {
          var sp = _scriptProps_();
          var raw = sp.getProperty('SYSTEM_NOTIFICATION_SETTINGS');
          if (raw) {
            var parsed = {};
            try { parsed = JSON.parse(raw); } catch (_) {}
            return _mergePrefs_(parsed, DEFAULT_NOTIFICATION_PREFS);
          }
          return Object.assign({}, DEFAULT_NOTIFICATION_PREFS);
        } catch (_) {
          return Object.assign({}, DEFAULT_NOTIFICATION_PREFS);
        }
      }

      /**
       * Save system-wide notification settings (admin only).
       * @param {Object} body — { prefs: { email_otp: true, ... } }
       */
      function saveSystemNotificationSettings(body) {
        try {
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin) return { success: false, error: 'Само администратор може да променя системните настройки.' };
          var prefs = body.prefs || {};
          var merged = _mergePrefs_(prefs, DEFAULT_NOTIFICATION_PREFS);
          _scriptProps_().setProperty('SYSTEM_NOTIFICATION_SETTINGS', JSON.stringify(merged));
          try { logTransaction('SAVE_SYSTEM_NOTIFICATION_SETTINGS', auth.userId || 'admin', 'system', merged); } catch (_) {}
          return { success: true, prefs: merged };
        } catch (err) {
          try { logError('saveSystemNotificationSettings', err, body); } catch (_) {}
          return { success: false, error: 'saveSystemNotificationSettings failed: ' + err.message };
        }
      }

      /**
       * Admin utility: toggle DEV_DISABLE_ADMIN_EMAILS via ScriptProperty.
       * Call from GAS editor or via API with admin credentials.
       * setDevAdminEmailsEnabled({ enabled: false }) → turns OFF suppression (admin emails flow).
       * setDevAdminEmailsEnabled({ enabled: true  }) → turns ON  suppression (dev/staging safety).
       */
      function setDevAdminEmailsEnabled(body) {
        try {
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin) return { success: false, error: 'Само администратор може да промени тази настройка.' };
          // enabled:true  → DEV_DISABLE_ADMIN_EMAILS=false (admin emails ARE enabled)
          // enabled:false → DEV_DISABLE_ADMIN_EMAILS=true  (admin emails suppressed)
          var wantEnabled = (body.enabled === true || body.enabled === 'true' || body.enabled === '1');
          var propValue = wantEnabled ? 'false' : 'true';
          _scriptProps_().setProperty('DEV_DISABLE_ADMIN_EMAILS', propValue);
          _devAdminEmailsDisabled = !wantEnabled; // update runtime cache
          try { logTransaction('SET_DEV_ADMIN_EMAILS', auth.userId, 'system', { enabled: wantEnabled, propValue: propValue }); } catch (_) {}
          return {
            success: true,
            adminEmailsEnabled: wantEnabled,
            message: wantEnabled
              ? 'Админ имейли включени (реално изпращане).'
              : 'Админ имейли потиснати (режим разработка).'
          };
        } catch (err) {
          try { logError('setDevAdminEmailsEnabled', err, body); } catch (_) {}
          return { success: false, error: 'setDevAdminEmailsEnabled failed: ' + err.message };
        }
      }

      /**
       * getSystemNotificationSettings — existing function.
       */
      function getSystemNotificationSettings(body) {
        try {
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin) return { success: false, error: 'Само администратор може да чете системните настройки.' };
          var adminEmailsEnabled = !_devAdminEmailsDisabled;
          return {
            success: true,
            prefs: _getSystemNotificationSettings_(),
            adminEmailsEnabled: adminEmailsEnabled
          };
        } catch (err) {
          return { success: false, error: err.message };
        }
      }

      /**
       * listAdminEmails — return all admin accounts from both ScriptProperties and MySQL.
       * No admin auth required (used by _loadMySqlAdminEmails_ and login flow).
       */
      function listAdminEmails(body) {
        try {
          // Ensure admin credentials are loaded
          try { loadAdminCredentials_(); } catch (_) {}
          // Also ensure MySQL admin emails are loaded
          if (!_mysqlAdminEmailsLoaded_) { _loadMySqlAdminEmails_(true); }

          // Collect from ScriptProperties
          var spEmails = (typeof _ADMIN_EMAILS_SERVER !== 'undefined' && Array.isArray(_ADMIN_EMAILS_SERVER))
            ? _ADMIN_EMAILS_SERVER : [];
          // Collect from MySQL cache
          var mysqlEmails = Array.isArray(_MYSQL_ADMIN_EMAILS_) ? _MYSQL_ADMIN_EMAILS_ : [];

          // Merge unique
          var seen = {}; var combined = [];
          spEmails.forEach(function(e){ var lc = String(e).toLowerCase().trim(); if (lc && !seen[lc]) { seen[lc] = true; combined.push({email: lc, role: 'admin', source: 'scriptproperties'}); } });
          mysqlEmails.forEach(function(e){ var lc = String(e).toLowerCase().trim(); if (lc && !seen[lc]) { seen[lc] = true; combined.push({email: lc, role: 'admin', source: 'mysql'}); } });

          return {
            success: true,
            adminEmails: combined,
            adminEmailsCount: combined.length,
            _sources: { scriptProperties: spEmails.length, mysql: mysqlEmails.length }
          };
        } catch (err) {
          return { success: false, error: 'listAdminEmails failed: ' + err.message };
        }
      }

      /**
       * addAdminEmail — promote a user to admin.
       * Updates ScriptProperties ADMIN_EMAILS and syncs to MySQL.
       * Body: { email, role?, name? }
       */
      function addAdminEmail(body) {
        try {
          // v7.0.0: Bust auth cache BEFORE processing so the promoted user is
          // recognized immediately without waiting for next GAS execution.
          _bustAuthCache_();

          // Allow server-to-server sync (_gasSync or _phpSync) to bypass auth check
          if (!body._gasSync && !body._phpSync) {
            var auth = resolveAuthContext(body);
            if (!auth.isAdmin) return { success: false, error: 'Само администратор може да добавя администратори.' };
          }

          var e = String(body.email || '').toLowerCase().trim();
          if (!e || e.indexOf('@') === -1) return { success: false, error: 'Невалиден имейл адрес.' };
          var role = body.role || 'admin';
          var name = body.name || '';

          // 1. Update ScriptProperties ADMIN_EMAILS
          try { loadAdminCredentials_(); } catch (_) {}
          var currentEmails = (typeof _ADMIN_EMAILS_SERVER !== 'undefined' && Array.isArray(_ADMIN_EMAILS_SERVER))
            ? _ADMIN_EMAILS_SERVER.slice() : [];

          if (currentEmails.indexOf(e) === -1) {
            currentEmails.push(e);
            var emailsStr = currentEmails.join(',');
            secretManager_().set('ADMIN_EMAILS', emailsStr);
            _ADMIN_EMAILS_SERVER = currentEmails;
          }

          // 2. Also update MySQL runtime cache
          if (_MYSQL_ADMIN_EMAILS_.indexOf(e) === -1) {
            _MYSQL_ADMIN_EMAILS_.push(e);
          }

          // 3. Bust CacheService credentials cache so next execution picks up change
          try { _scriptCache_().remove('_ADMIN_CREDS'); } catch (_) {}
          try { _scriptCache_().remove(_MYSQL_ADMIN_CACHE_KEY_); } catch (_) {}

          // 4. Sync to MySQL via PHP (fire-and-forget)
          try {
            var url = _getHostingerUrl_();
            if (url) {
              UrlFetchApp.fetch(url, {
                method: 'post', contentType: 'application/json',
                payload: JSON.stringify({ action: 'addadminemail', email: e, role: role, name: name, _gasSync: true }),
                muteHttpExceptions: true, timeout: 3000
              });
            }
          } catch (_) { /* fire-and-forget — ScriptProperties is authoritative */ }

          // 5. Log transaction
          try { logTransaction('ADD_ADMIN_EMAIL', (auth && auth.userId) || '_sync_', 'system', { email: e, role: role }); } catch (_) {}

          return { success: true, email: e, role: role, isAdmin: true, message: 'Имейлът ' + e + ' е повишен до администратор.' };
        } catch (err) {
          try { logError('addAdminEmail', err, body); } catch (_) {}
          return { success: false, error: 'addAdminEmail failed: ' + err.message };
        }
      }

      /**
       * removeAdminEmail — revoke admin privileges from a user.
       * Updates ScriptProperties ADMIN_EMAILS and syncs to MySQL.
       * Body: { email }
       */
      function removeAdminEmail(body) {
        try {
          // v7.0.0: Bust auth cache so demoted user loses admin immediately
          _bustAuthCache_();

          // Allow server-to-server sync (_gasSync or _phpSync) to bypass auth check
          if (!body._gasSync && !body._phpSync) {
            var auth = resolveAuthContext(body);
            if (!auth.isAdmin) return { success: false, error: 'Само администратор може да премахва администратори.' };
          }

          var e = String(body.email || '').toLowerCase().trim();
          if (!e) return { success: false, error: 'Липсва имейл адрес.' };

          // 1. Update ScriptProperties ADMIN_EMAILS
          try { loadAdminCredentials_(); } catch (_) {}
          var currentEmails = (typeof _ADMIN_EMAILS_SERVER !== 'undefined' && Array.isArray(_ADMIN_EMAILS_SERVER))
            ? _ADMIN_EMAILS_SERVER.slice() : [];

          var idx = currentEmails.indexOf(e);
          if (idx !== -1) {
            currentEmails.splice(idx, 1);
            var emailsStr = currentEmails.join(',');
            secretManager_().set('ADMIN_EMAILS', emailsStr);
            _ADMIN_EMAILS_SERVER = currentEmails;
          }

          // 2. Also remove from MySQL runtime cache
          var mIdx = _MYSQL_ADMIN_EMAILS_.indexOf(e);
          if (mIdx !== -1) { _MYSQL_ADMIN_EMAILS_.splice(mIdx, 1); }

          // 3. Bust CacheService caches
          try { _scriptCache_().remove('_ADMIN_CREDS'); } catch (_) {}
          try { _scriptCache_().remove(_MYSQL_ADMIN_CACHE_KEY_); } catch (_) {}

          // 4. Sync to MySQL via PHP (fire-and-forget)
          try {
            var url = _getHostingerUrl_();
            if (url) {
              UrlFetchApp.fetch(url, {
                method: 'post', contentType: 'application/json',
                payload: JSON.stringify({ action: 'removeadminemail', email: e, _gasSync: true }),
                muteHttpExceptions: true, timeout: 3000
              });
            }
          } catch (_) {}

          // 5. Log transaction
          try { logTransaction('REMOVE_ADMIN_EMAIL', (auth && auth.userId) || '_sync_', 'system', { email: e }); } catch (_) {}

          return { success: true, email: e, isAdmin: false, message: 'Администраторските права за ' + e + ' са премахнати.' };
        } catch (err) {
          try { logError('removeAdminEmail', err, body); } catch (_) {}
          return { success: false, error: 'removeAdminEmail failed: ' + err.message };
        }
      }

      /**
       * syncAdminEmails — sync admin emails from ScriptProperties to MySQL.
       * Called after admin promotion/demotion, or manually.
       * Body: { emails?, roles? } — if omitted, pushes current ScriptProperties list.
       */
      function syncAdminEmails(body) {
        try {
          // Allow server-to-server sync (_gasSync or _phpSync) to bypass auth check
          if (!body._gasSync && !body._phpSync) {
            var auth = resolveAuthContext(body);
            if (!auth.isAdmin) return { success: false, error: 'Само администратор може да синхронизира администратори.' };
          }

          // Get current list from ScriptProperties
          try { loadAdminCredentials_(); } catch (_) {}
          var emails = body.emails || (typeof _ADMIN_EMAILS_SERVER !== 'undefined' ? _ADMIN_EMAILS_SERVER : []);
          var roles = body.roles || {};

          if (!Array.isArray(emails) || !emails.length) {
            return { success: false, error: 'Няма администраторски имейли за синхронизация.' };
          }

          // Bust local caches
          _mysqlAdminEmailsLoaded_ = false;
          _MYSQL_ADMIN_EMAILS_ = [];
          try { _scriptCache_().remove('_ADMIN_CREDS'); } catch (_) {}
          try { _scriptCache_().remove(_MYSQL_ADMIN_CACHE_KEY_); } catch (_) {}

          // Sync to MySQL via PHP
          var synced = 0; var failed = 0;
          for (var i = 0; i < emails.length; i++) {
            var e = String(emails[i]).toLowerCase().trim();
            if (!e || e.indexOf('@') === -1) { failed++; continue; }
            try {
              var url = _getHostingerUrl_();
              if (url) {
                UrlFetchApp.fetch(url, {
                  method: 'post', contentType: 'application/json',
                  payload: JSON.stringify({
                    action: 'addadminemail', email: e,
                    role: roles[e] || body.defaultRole || 'admin',
                    _gasSync: true
                  }),
                  muteHttpExceptions: true, timeout: 2000
                });
              }
              if (_MYSQL_ADMIN_EMAILS_.indexOf(e) === -1) { _MYSQL_ADMIN_EMAILS_.push(e); }
              synced++;
            } catch (_) { failed++; }
          }

          // Update ScriptProperties
          var emailsStr = emails.join(',');
          secretManager_().set('ADMIN_EMAILS', emailsStr);
          _ADMIN_EMAILS_SERVER = emails.slice();

          try { logTransaction('SYNC_ADMIN_EMAILS', (auth && auth.userId) || '_sync_', 'system', { synced: synced, failed: failed, total: emails.length }); } catch (_) {}

          return {
            success: true,
            synced: synced,
            failed: failed,
            adminEmails: _ADMIN_EMAILS_SERVER,
            message: 'Синхронизирани ' + synced + ' администраторски имейла' + (failed ? ' (' + failed + ' грешки)' : '')
          };
        } catch (err) {
          try { logError('syncAdminEmails', err, body); } catch (_) {}
          return { success: false, error: 'syncAdminEmails failed: ' + err.message };
        }
      }

      /**
       * Save user notification preferences.
       * Creates/updates a row in the UserPreferences sheet.
       * @param {Object} body — { email, prefs: { ... } }
       */
      function saveUserPreferences(body) {
        try {
          var email = String(body.email || '').trim().toLowerCase();
          var prefs = body.prefs || {};
          if (!email) return { success: false, error: 'Email is required.' };

          var ss = _getUserPrefsSheet_();
          var data = ss.getDataRange().getValues();
          var foundRow = -1;
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][0]).toLowerCase().trim() === email) {
              foundRow = i + 1;
              break;
            }
          }

          var merged = _mergePrefs_(prefs, DEFAULT_NOTIFICATION_PREFS);
          var json = JSON.stringify(merged);
          var now = new Date().toISOString();

          if (foundRow > 0) {
            ss.getRange(foundRow, 2).setValue(json);
            ss.getRange(foundRow, 3).setValue(now);
          } else {
            ss.appendRow([email, json, now]);
          }

          _bustUserPrefsCache_();
          try { logTransaction('SAVE_USER_PREFS', email, 'prefs', { keys: Object.keys(merged).length }); } catch (_) {}
          return { success: true, prefs: merged };
        } catch (err) {
          try { logError('saveUserPreferences', err, body); } catch (_) {}
          return { success: false, error: 'saveUserPreferences failed: ' + err.message };
        }
      }

      /**
       * Load user notification preferences.
       * Returns defaults if no saved preferences exist.
       * @param {Object} body — { email }
       */
      function getUserPreferences(body) {
        try {
          var email = String(body.email || '').trim().toLowerCase();
          if (!email) return { success: false, error: 'Email is required.' };

          var data = _getUserPrefsData_();
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][0]).toLowerCase().trim() === email) {
              var saved = {};
              try { saved = JSON.parse(String(data[i][1] || '{}')); } catch (_) {}
              return { success: true, prefs: _mergePrefs_(saved, DEFAULT_NOTIFICATION_PREFS), updatedAt: data[i][2] };
            }
          }
          return { success: true, prefs: Object.assign({}, DEFAULT_NOTIFICATION_PREFS), updatedAt: null };
        } catch (err) {
          try { logError('getUserPreferences', err, body); } catch (_) {}
          return { success: false, error: 'getUserPreferences failed: ' + err.message };
        }
      }

      /**
       * Export all user data as a downloadable JSON snapshot.
       * Collects forms, documents, messages, notifications, and preferences.
       * @param {Object} body — { email, clearDraftsAfterExport }
       */
      function exportMyData(body) {
        try {
          var email = String(body.email || body.userId || '').trim().toLowerCase();
          if (!email) return { success: false, error: 'Email is required.' };
          var clearDrafts = !!body.clearDraftsAfterExport;
          var snapshot = {};

          // 1. Forms
          var forms = getForms({ userId: email });
          snapshot.forms = forms.forms || [];

          // 2. Documents
          var docs = listMyDocuments({ userId: email });
          snapshot.documents = docs.documents || [];

          // 3. Messages
          var msgs = getMessages({ email: email });
          snapshot.messages = msgs.messages || [];

          // 4. Notifications
          try {
            var prefsBody = { email: email, userId: email };
            var prefs = getMyNotifications(prefsBody);
            snapshot.notifications = prefs.notifications || [];
          } catch (_) { snapshot.notifications = []; }

          // 5. Preferences
          try {
            var userPrefs = getUserPreferences({ email: email });
            snapshot.preferences = userPrefs.prefs || {};
          } catch (_) { snapshot.preferences = {}; }

          // 6. Activity log
          try {
            var activity = getMyActivityLog({ email: email });
            snapshot.activity = activity.entries || [];
          } catch (_) { snapshot.activity = []; }

          // 7. Review data (if applicable)
          try {
            var reviews = getReviewerForms({ reviewerEmail: email });
            snapshot.reviews = reviews.forms || [];
          } catch (_) { snapshot.reviews = []; }

          // Optionally clear drafts after export
          var cleared = 0;
          if (clearDrafts) {
            try {
              var draftForms = (snapshot.forms || []).filter(function(f) { return f.status === 'draft'; });
              draftForms.forEach(function(f) {
                try {
                  deleteFormDraft_({ id: f.id });
                  cleared++;
                } catch (_) {}
              });
            } catch (_) {}
          }

          try { logTransaction('EXPORT_MY_DATA', email, 'export', { clearDrafts: clearDrafts, cleared: cleared }); } catch (_) {}
          return {
            success: true,
            snapshot: snapshot,
            cleared: cleared,
            exportedAt: new Date().toISOString(),
            userEmail: email
          };
        } catch (err) {
          try { logError('exportMyData', err, body); } catch (_) {}
          return { success: false, error: 'exportMyData failed: ' + err.message };
        }
      }

      /**
       * Clear all draft forms for the given user.
       * Marks them as hidden/deleted rather than permanently erasing.
       * @param {Object} body — { email }
       */
      function clearMyDrafts(body) {
        try {
          var email = String(body.email || body.userId || '').trim().toLowerCase();
          if (!email) return { success: false, error: 'Email is required.' };

          var forms = getForms({ userId: email });
          var draftForms = (forms.forms || []).filter(function(f) { return f.status === 'draft'; });
          var cleared = 0;
          draftForms.forEach(function(f) {
            try {
              deleteFormDraft_({ id: f.id });
              cleared++;
            } catch (_) {}
          });

          try { logTransaction('CLEAR_MY_DRAFTS', email, 'drafts', { cleared: cleared }); } catch (_) {}
          return { success: true, cleared: cleared };
        } catch (err) {
          try { logError('clearMyDrafts', err, body); } catch (_) {}
          return { success: false, error: 'clearMyDrafts failed: ' + err.message };
        }
      }

      /**
       * Get both system and personal notification settings in one call.
       * Admin users get system prefs + their own prefs.
       * Regular users get only their own prefs (system is applied server-side).
       */
      function getNotificationSettings(body) {
        try {
          var email = String(body.email || '').trim().toLowerCase();
          if (!email) return { success: false, error: 'Email is required.' };
          var auth = resolveAuthContext(body);

          // Get personal prefs
          var personalRes = getUserPreferences({ email: email });
          if (!personalRes.success) return personalRes;

          var result = {
            success: true,
            personal: personalRes.prefs
          };

          // Admin users can also see and manage system settings
          if (auth && auth.isAdmin) {
            result.system = _getSystemNotificationSettings_();
            result.isAdmin = true;
            // Expose admin email kill-switch state so the UI can render the toggle correctly
            try {
              result.adminEmailsEnabled = !_devAdminEmailsDisabled;
            } catch (_) {
              result.adminEmailsEnabled = false; // safe default
            }
          }

          return result;
        } catch (err) {
          try { logError('getNotificationSettings', err, body); } catch (_) {}
          return { success: false, error: 'getNotificationSettings failed: ' + err.message };
        }
      }
      function _checkNotificationPref_(email, channelKey) {
        if (!email || !channelKey) return true;
        try {
          // 1. Check system-wide settings first
          var sysPrefs = _getSystemNotificationSettings_();
          if (sysPrefs[channelKey] === false) {
            if (_isAdminRecipient_(email)) return true;
            return false;
          }

          // 2. Check personal user preference (uses per-execution cache)
          var data = _getUserPrefsData_();
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][0]).toLowerCase().trim() === String(email).toLowerCase().trim()) {
              var saved = {};
              try { saved = JSON.parse(String(data[i][1] || '{}')); } catch (_) {}
              return saved[channelKey] !== false; // default true if key missing
            }
          }
        } catch (_) {}
        return true;
      }

      /**
       * Map notification type to channel key for preference checking.
       * Used by notifyApplicant_ and other dispatch functions.
       */
      // Pre-built lookup for _notificationChannelForKey_ — avoids re-creating
      // the map on every call. ~24 entries, compiled once at parse time.
      var _NOTIFICATION_CHANNEL_MAP = {
        'status_change': 'email_status_change',
        'status': 'email_status_change',
        'review_invite': 'email_review_invite',
        'review_assignment': 'email_review_invite',
        'review_reminder': 'email_review_reminder',
        'review_returned': 'email_review_reminder',
        'comment': 'email_comment',
        'correction': 'email_comment',
        'returned': 'email_comment',
        'contract': 'email_contract',
        'contract_sign': 'email_contract',
        'report_due': 'email_report_due',
        'report_overdue': 'email_report_due',
        'expense': 'email_expense',
        'expense_approve': 'email_expense',
        'expense_reject': 'email_expense',
        'sanction': 'email_sanction',
        'otp': 'email_otp',
        'broadcast': 'email_broadcast',
        'new_message': 'email_new_message',
        'message': 'email_new_message',
        'change_request': 'email_change_request',
        'change_approve': 'email_change_request',
        'change_reject': 'email_change_request'
      };
      function _notificationChannelForKey_(notificationType) {
        return _NOTIFICATION_CHANNEL_MAP[notificationType] || null;
      }

      /**
       * Check notification preference for a given email and type.
       * @param {string} email
       * @param {string} notificationType — logical type e.g. 'status_change', 'review_invite'
       * @returns {boolean} — true if notification should be sent
       */
      function _shouldSendNotification_(email, notificationType) {
        if (!email || !notificationType) return true;
        var channelKey = _notificationChannelForKey_(notificationType);
        if (!channelKey) return true; // unknown type, send by default
        return _checkNotificationPref_(email, channelKey);
      }

