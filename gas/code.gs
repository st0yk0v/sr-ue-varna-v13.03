            if (active !== 'true' && active !== '1') continue;
            if (contestType && String(data[i][1] || '').toLowerCase() !== contestType.toLowerCase()) continue;
            templates.push({
              templateId:   String(data[i][0]),
              contestType:  String(data[i][1]),
              name:         String(data[i][2]),
              order:        Number(data[i][3]) || 0,
              driveFileId:  String(data[i][4]),
              isRequired:   String(data[i][5] || '').toLowerCase() === 'true',
              active:       true,
              version:      String(data[i][7] || '1.0')
