      // Reusable header band on each XLSX sheet (logo placeholder + title +
      // institution name + report id). Branded with primary colour.
      // colCount: number of columns in the sheet's data area; the brand band
      // is merged across this width so freeze-column actions never cut a merge.
      function _xlsxBrandHeader_(sheet, sectionTitle, reportId, colCount) {
        var n = Math.max(1, parseInt(colCount, 10) || 4);
        var lastCol = _xlsxColLetter_(n);
        // Brand-aligned navy band (matches the frontend --brand-navy palette
        // and the PDF cover) instead of the off-tone #1a1a2e / #5b48d8 used in
        // the v3 prototype. Result: every section sheet looks like a single
        // continuous officially-branded "отчетен документ" page.
        sheet.getRange('A1:' + lastCol + '1').merge().setValue(INSTITUTION.legalName_bg + ' • ' + INSTITUTION.shortName + ' • ' + INSTITUTION.issuingBody)
          .setFontWeight('bold').setBackground('#16234A').setFontColor('#ffffff').setHorizontalAlignment('center').setFontSize(11);
        sheet.getRange('A2:' + lastCol + '2').merge().setValue(sectionTitle)
          .setFontWeight('bold').setBackground('#233874').setFontColor('#ffffff').setHorizontalAlignment('center').setFontSize(12);
        sheet.getRange('A3:' + lastCol + '3').merge().setValue('Отчет ID: ' + reportId + ' • Генериран: ' + nowISO() + ' • ЕИК: ' + INSTITUTION.eik + ' • МОН код: ' + INSTITUTION.mes_code)
          .setFontStyle('italic').setBackground('#f0f0fa').setFontSize(9).setHorizontalAlignment('center');
        sheet.setRowHeight(1, 22).setRowHeight(2, 24).setRowHeight(3, 18);
      }
      // Convert 1-based column index to A1-letter (handles AA, AB, …)
      function _xlsxColLetter_(n) {
        var s = ''; n = Math.max(1, n);
        while (n > 0) { var r = (n - 1) % 26; s = String.fromCharCode(65 + r) + s; n = Math.floor((n - 1) / 26); }
        return s;
      }

      function _appendSignatureToMONFile_(driveFileId, signatureBase64, signerEmail) {
        try {
          var file = DriveApp.getFileById(driveFileId);
          var mime = file.getMimeType();
          var ts = nowISO();
          var sigHashShort = sha256Hex_(signatureBase64 || (signerEmail+ts)).substring(0, 32);

          if (mime === 'application/vnd.google-apps.document') {
            var doc = DocumentApp.openById(driveFileId);
            var body = doc.getBody();
            body.appendPageBreak();
            body.appendParagraph('— ЕЛЕКТРОНЕН ПЕЧАТ И ВРЕМЕВИ ПОДПИС —').setHeading(DocumentApp.ParagraphHeading.HEADING2).setAlignment(DocumentApp.HorizontalAlignment.CENTER);
            body.appendParagraph('');
            body.appendParagraph('Подписващ: ' + signerEmail).setBold(true);
            body.appendParagraph('Длъжност: ' + INSTITUTION.rectorTitle + ' на ' + INSTITUTION.legalName_bg);
            body.appendParagraph('Времеви печат (ISO 8601): ' + ts);
            body.appendParagraph('Хеш на подпис (SHA-256): ' + sigHashShort + '…').setFontFamily('Courier New');
            body.appendParagraph('');
            // Embed signature image (raster PNG, SVG data-URI, or auto-seal SVG)
            try {
              var raw = String(signatureBase64 || '');
              var mimeMatch = raw.match(/^data:(image\/[a-z+\-]+);base64,(.+)$/i);
              var imgMime = mimeMatch ? mimeMatch[1] : 'image/png';
              var b64 = mimeMatch ? mimeMatch[2] : raw.replace(/^data:image\/[a-z+\-]+;base64,/, '');
              // Apps Script DocumentApp doesn't render SVG inline reliably; for SVG, convert to text seal.
              if (imgMime === 'image/svg+xml') {
                var dec = Utilities.newBlob(Utilities.base64Decode(b64), 'image/svg+xml', 'seal.svg').getDataAsString();
                body.appendParagraph('[Електронен печат]').setItalic(true);
                body.appendParagraph(dec.replace(/<[^>]+>/g,' ').replace(/\s+/g,' ').substring(0, 200) + '…').setFontSize(8).setForegroundColor('#666666');
              } else {
                var blob = Utilities.newBlob(Utilities.base64Decode(b64), imgMime, 'signature.png');
                body.appendImage(blob).setWidth(280);
              }
            } catch (imgErr) { body.appendParagraph('(подписът не може да се рендира; SHA-256: ' + sigHashShort + ')').setItalic(true); }

            body.appendParagraph('');
            body.appendParagraph('Заверено от ' + INSTITUTION.legalName_bg + ' • ЕИК ' + INSTITUTION.eik + ' • ' + ts).setFontSize(8).setItalic(true).setForegroundColor('#666666').setAlignment(DocumentApp.HorizontalAlignment.CENTER);
            doc.saveAndClose();
          } else if (mime === 'application/vnd.google-apps.spreadsheet') {
            var ss = SpreadsheetApp.openById(driveFileId);
            var sigSheet = ss.getSheetByName('Декларация') || ss.getSheetByName('VI. Декларация') || ss.insertSheet('Декларация');
            // Fill or update signature rows
            sigSheet.getRange('A11').setValue('— ЕЛЕКТРОНЕН ПЕЧАТ И ВРЕМЕВИ ПОДПИС —').setFontWeight('bold').setFontSize(12).setBackground('#233874').setFontColor('#ffffff');
            sigSheet.getRange('A11:D11').merge().setHorizontalAlignment('center');
            sigSheet.getRange('A13').setValue('Подписващ').setFontWeight('bold');     sigSheet.getRange('B13').setValue(signerEmail);
            sigSheet.getRange('A14').setValue('Длъжност').setFontWeight('bold');      sigSheet.getRange('B14').setValue(INSTITUTION.rectorTitle + ' на ' + INSTITUTION.legalName_bg);
            sigSheet.getRange('A15').setValue('Времеви печат').setFontWeight('bold'); sigSheet.getRange('B15').setValue(ts);
            sigSheet.getRange('A16').setValue('Хеш на подпис').setFontWeight('bold'); sigSheet.getRange('B16').setValue(sigHashShort + '…').setFontFamily('Courier New');
            sigSheet.getRange('A18').setValue('Заверено от ' + INSTITUTION.legalName_bg + ' • ЕИК ' + INSTITUTION.eik).setFontStyle('italic').setFontSize(9);
            // Try to insert signature image
            try {
              var raw2 = String(signatureBase64 || '');
              var mimeMatch2 = raw2.match(/^data:(image\/[a-z+\-]+);base64,(.+)$/i);
              var imgMime2 = mimeMatch2 ? mimeMatch2[1] : 'image/png';
              var b642 = mimeMatch2 ? mimeMatch2[2] : raw2.replace(/^data:image\/[a-z+\-]+;base64,/, '');
              var blob2 = Utilities.newBlob(Utilities.base64Decode(b642), imgMime2, 'signature' + (imgMime2==='image/svg+xml'?'.svg':'.png'));
              sigSheet.insertImage(blob2, 4, 13).setWidth(280);
            } catch (_) {}
          } else {
            file.setDescription('Подписано от ' + signerEmail + ' на ' + ts + ' (SHA-256: ' + sigHashShort + ')');
          }

          // Audit
          _logMonDocAudit_('', 'MON_DOC_SIGNED', driveFileId, signerEmail, sigHashShort, { mime: mime, ts: ts });
          return true;
        } catch (e) {
          console.warn('_appendSignatureToMONFile_ failed: ' + e.message);
          try { _logMonDocAudit_('', 'MON_DOC_SIGN_FAILED', driveFileId, signerEmail, '', { error: e.message }); } catch (_) {}
          return false;
        }
      }

      // ════════════════════════════════════════════════════════════
      //  cleanupMONDuplicates — admin-only one-shot housekeeping.
      //  Walks every MON report row, keeps only the IDs currently
      //  referenced in EXPORT_FILE_ID/EXPORT_XLSX_ID, and trashes any
      //  loose "МОН-Отчет-*" Drive file owned by the executor that is
      //  not referenced. Also moves all referenced live files into the
      //  canonical MON-Отчети/<year>/ folder. Returns counts.
      // ════════════════════════════════════════════════════════════
      function cleanupMONDuplicates(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin && auth.role !== ROLE_RECTOR && auth.role !== ROLE_VICE_RECTOR && auth.role !== ROLE_NIDD) {
            return { success: false, error: 'Само администратор / Ректор / Зам.-ректор НИИРК / НИДД може да изпълни почистването.' };
          }
          var sheet = getMinistryReportsSheet();
          var rows = sheet.getDataRange().getValues();
          var keepIds = {};
          var yearByFile = {};
          for (var i = 1; i < rows.length; i++) {
            var pid = String(rows[i][MON_COL.EXPORT_FILE_ID - 1]||'').trim();
            var xid = String(rows[i][MON_COL.EXPORT_XLSX_ID - 1]||'').trim();
            var yr  = String(rows[i][MON_COL.YEAR - 1]||'');
            if (pid) { keepIds[pid] = true; yearByFile[pid] = yr; }
            if (xid) { keepIds[xid] = true; yearByFile[xid] = yr; }
          }

          // 1. Move all referenced live files into canonical folder.
          var moved = 0;
          Object.keys(keepIds).forEach(function(fid){
            try {
              var f = DriveApp.getFileById(fid);
              if (!f || f.isTrashed()) return;
              var targetFolder = _monGetReportFolder_(yearByFile[fid] || new Date().getFullYear());
              var alreadyIn = false;
              var prnts = f.getParents();
              while (prnts.hasNext()) {
                var pf = prnts.next();
                if (pf.getId() === targetFolder.getId()) { alreadyIn = true; }
                else { try { pf.removeFile(f); } catch(_){} }
              }
              if (!alreadyIn) { targetFolder.addFile(f); moved++; }
            } catch (_) {}
          });

          // 2. Trash any loose МОН-Отчет-* files owned by executor that
          //    are NOT in keepIds. Limit to 500 per run for safety.
          var trashed = 0;
          try {
            var iterators = [
              DriveApp.searchFiles('title contains "МОН-Отчет" and trashed=false'),
              DriveApp.searchFiles('title contains "MON-Отчет" and trashed=false')
            ];
            for (var it = 0; it < iterators.length && trashed < 500; it++) {
              var fit = iterators[it];
              while (fit.hasNext() && trashed < 500) {
                var f = fit.next();
                if (keepIds[f.getId()]) continue;
                try { f.setTrashed(true); trashed++; }
                catch (_) {}
              }
            }
          } catch (searchErr) { console.warn('cleanup search failed: ' + searchErr.message); }

          try { logTransaction('CLEANUP_MON_DUPLICATES', auth.userId, '', { kept: Object.keys(keepIds).length, moved: moved, trashed: trashed }); } catch (_) {}
          return { success: true, kept: Object.keys(keepIds).length, moved: moved, trashed: trashed };
        } catch (err) {
          logError('cleanupMONDuplicates', err, body);
          return { success: false, error: 'cleanupMONDuplicates failed: ' + err.message };
        }
      }

      // ── Scheduled archival of acknowledged reports >30 days ──
      function _processMONArchival_() {
        try {
          var sheet = getMinistryReportsSheet();
          var data = sheet.getDataRange().getValues();
          var cutoff = Date.now() - 30 * 24 * 60 * 60 * 1000;
          var archivedCount = 0;
          for (var i = 1; i < data.length; i++) {
            var st = String(data[i][MON_COL.STATUS - 1]).toLowerCase();
            if (st !== 'acknowledged') continue;
            var ackAt = new Date(String(data[i][MON_COL.ACKNOWLEDGED_AT - 1] || ''));
            if (isNaN(ackAt.getTime()) || ackAt.getTime() > cutoff) continue;
            var historyArr = _monParseJson_(data[i][MON_COL.HISTORY - 1], []);
            historyArr.push({ status: MON_STATUS.ARCHIVED, ts: nowISO(), by: 'system', role: 'system', note: 'Auto-archive +30d' });
            sheet.getRange(i + 1, MON_COL.STATUS).setValue(MON_STATUS.ARCHIVED);
            sheet.getRange(i + 1, MON_COL.HISTORY).setValue(JSON.stringify(historyArr));
            archivedCount++;
          }
          if (archivedCount > 0) console.log('[MON] Auto-archived ' + archivedCount + ' reports.');
          return archivedCount;
        } catch (e) { console.warn('_processMONArchival_ failed: ' + e.message); return 0; }
      }

      // ── Scheduled MON deadline reminders / overdue alerts ────
      function _processMONDeadlines_() {
        try {
          var sheet = getMinistryReportsSheet();
          var data = sheet.getDataRange().getValues();
          var now = new Date();
          var year = now.getFullYear();
          var deadlines = [
            { type: 'semiannual', period: year + '-H1',   due: new Date(year, 6, 10) },     // 10 July
            { type: 'semiannual', period: (year - 1) + '-H2', due: new Date(year, 0, 10) }, // 10 Jan
            { type: 'annual',     period: (year - 1) + '-FY', due: new Date(year, 0, 10) }
          ];
          var reminders = 0;
          deadlines.forEach(function(dl) {
            var exists = false;
            for (var i = 1; i < data.length; i++) {
              var t = String(data[i][MON_COL.REPORT_TYPE - 1]).toLowerCase();
              var p = String(data[i][MON_COL.PERIOD - 1]).trim();
              var st = String(data[i][MON_COL.STATUS - 1]).toLowerCase();
              if (t === dl.type && p === dl.period && st !== 'cancelled') { exists = true; break; }
            }
            if (exists) return;
            var msUntil = dl.due.getTime() - now.getTime();
            var daysUntil = Math.ceil(msUntil / (24 * 60 * 60 * 1000));
            if (daysUntil <= 7 && daysUntil >= 0) {
              _monNotify_(_monNidds_(), 'Краен срок за МОН отчет след ' + daysUntil + ' дни',
                '⏰ Предстоящ краен срок',
                [{ label: 'Тип', value: dl.type }, { label: 'Период', value: dl.period }, { label: 'Срок', value: Utilities.formatDate(dl.due, 'Europe/Sofia', 'dd.MM.yyyy') }, { label: 'Оставащи дни', value: String(daysUntil) }]);
              reminders++;
            } else if (daysUntil < 0) {
              _monNotify_(_monNidds_(), 'ПРОСРОЧЕН МОН отчет — ' + dl.period,
                '🚨 Просрочен отчет към МОН',
                [{ label: 'Тип', value: dl.type }, { label: 'Период', value: dl.period }, { label: 'Срок', value: Utilities.formatDate(dl.due, 'Europe/Sofia', 'dd.MM.yyyy') }, { label: 'Дни просрочка', value: String(-daysUntil) }]);
              reminders++;
            }
          });
          return reminders;
        } catch (e) { console.warn('_processMONDeadlines_ failed: ' + e.message); return 0; }
      }

      // ============================================================
      //  PROCESS 1 — AC + Rector approval handlers
      // ============================================================

      function approveCompetitionByAC(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin && auth.role !== ROLE_ACADEMIC_COUNCIL) {
            return { success: false, error: 'Само Академичен съвет или Администратор.' };
          }
          var competitionId = String(body.competitionId || '').trim();
          var decision = String(body.decision || '').toLowerCase().trim();
          if (['approved','rejected'].indexOf(decision) === -1) {
            return { success: false, error: 'Невалидно решение.' };
          }
          var sheet = _ensureCompetitionExtColumns_();
          var data = sheet.getDataRange().getValues();
          var rowIdx = -1;
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][COMP_COL.ID - 1]).trim() === competitionId) { rowIdx = i + 1; break; }
          }
          if (rowIdx < 0) return { success: false, error: 'Конкурсът не е намерен.' };
          var currentStatus = String(data[rowIdx - 1][COMP_COL.STATUS - 1]).toLowerCase();
          if (currentStatus !== 'configured' && currentStatus !== 'draft') {
            return { success: false, error: 'Може да се одобрява само конкурс в статус „configured" / „draft" (текущ: „' + currentStatus + '").' };
          }
          var newStatus = decision === 'approved' ? 'approved_by_ac' : 'configured';
          sheet.getRange(rowIdx, COMP_COL.STATUS).setValue(newStatus);
          sheet.getRange(rowIdx, COMP_EXT_COL.AC_APPROVED_BY).setValue(auth.userId);
          sheet.getRange(rowIdx, COMP_EXT_COL.AC_APPROVED_AT).setValue(nowISO());
          if (body.meetingMinutesUrl) sheet.getRange(rowIdx, COMP_EXT_COL.AC_MINUTES_URL).setValue(String(body.meetingMinutesUrl));

          _monNotify_(_monNidds_(), 'Решение на АС за конкурс ' + competitionId, '🏛 Решение на Академичния съвет',
            [{ label: 'Конкурс', value: competitionId }, { label: 'Решение', value: decision }, { label: 'От', value: auth.userId }, { label: 'Бележки', value: String(body.notes || '') }]);
          try { logTransaction('AC_APPROVE_COMPETITION', auth.userId, competitionId, { decision: decision }); } catch (_) {}
          return { success: true, status: newStatus };
        } catch (err) {
          logError('approveCompetitionByAC', err, body);
          return { success: false, error: 'approveCompetitionByAC failed: ' + err.message };
        }
      }

      function issueRectorOrder(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin && auth.role !== ROLE_RECTOR) {
            return { success: false, error: 'Само Ректор или Администратор.' };
          }
          var competitionId = String(body.competitionId || '').trim();
          var orderNumber = String(body.orderNumber || '').trim();
          var orderDate = String(body.orderDate || '').trim() || nowISO();
          var orderDocId = String(body.orderDocId || '').trim();
          if (!orderNumber) return { success: false, error: 'Липсва номер на заповед.' };

          var sheet = _ensureCompetitionExtColumns_();
          var data = sheet.getDataRange().getValues();
          var rowIdx = -1;
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][COMP_COL.ID - 1]).trim() === competitionId) { rowIdx = i + 1; break; }
          }
          if (rowIdx < 0) return { success: false, error: 'Конкурсът не е намерен.' };
          var st = String(data[rowIdx - 1][COMP_COL.STATUS - 1]).toLowerCase();
          if (st !== 'approved_by_ac') return { success: false, error: 'Изисква се статус „approved_by_ac" (текущ: „' + st + '").' };

          sheet.getRange(rowIdx, COMP_COL.STATUS).setValue('opened');
          sheet.getRange(rowIdx, COMP_EXT_COL.RECTOR_ORDER_NUMBER).setValue(orderNumber);
          sheet.getRange(rowIdx, COMP_EXT_COL.RECTOR_ORDER_DATE).setValue(orderDate);
          if (orderDocId) sheet.getRange(rowIdx, COMP_EXT_COL.RECTOR_ORDER_DOC_ID).setValue(orderDocId);

          _monNotify_(_monNidds_(), 'Заповед на Ректора за конкурс ' + competitionId, '📜 Издадена заповед на Ректора',
            [{ label: 'Конкурс', value: competitionId }, { label: '№ заповед', value: orderNumber }, { label: 'Дата', value: orderDate }]);
          try { logTransaction('RECTOR_ORDER_COMPETITION', auth.userId, competitionId, { orderNumber: orderNumber, orderDate: orderDate }); } catch (_) {}
          return { success: true, status: 'opened' };
        } catch (err) {
          logError('issueRectorOrder', err, body);
          return { success: false, error: 'issueRectorOrder failed: ' + err.message };
        }
      }

      // ============================================================
      //  PROCESS 4 — Two-step reviewer assignment
      // ============================================================

      function proposeReviewers(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin && auth.role !== ROLE_CKK) {
            return { success: false, error: 'Само ЦКК или Администратор.' };
          }
          var formId = String(body.formId || '').trim();
          var reviewerEmails = normalizeReviewerEmails_(body.reviewerEmails || body.reviewers || []);
          var justification = String(body.justification || '').trim();
          if (!formId) return { success: false, error: 'Липсва formId.' };
          if (!reviewerEmails.length) return { success: false, error: 'Няма предложени рецензенти.' };

          var sheet = getReviewerProposalsSheet();
          var formSheet = getSheet();
          var found = findRowByID(formSheet, formId);
          if (!found) return { success: false, error: 'Заявлението не е намерено.' };
          var competitionId = String(found.rowData[COL.COMPETITION - 1] || '').trim();

          var id = _monNewId_('RPP');
          var now = nowISO();
          var historyArr = [{ status: 'pending', ts: now, by: auth.userId, role: auth.role }];
          var row = new Array(RPP_TOTAL_COLS);
          row[RPP_COL.ID - 1] = id;
          row[RPP_COL.FORM_ID - 1] = formId;
          row[RPP_COL.COMPETITION_ID - 1] = competitionId;
          row[RPP_COL.PROPOSED_BY - 1] = auth.userId;
          row[RPP_COL.PROPOSED_AT - 1] = now;
          row[RPP_COL.PROPOSED_REVIEWERS - 1] = JSON.stringify(reviewerEmails);
          row[RPP_COL.JUSTIFICATION - 1] = justification;
          row[RPP_COL.STATUS - 1] = 'pending';
          row[RPP_COL.HISTORY - 1] = JSON.stringify(historyArr);
          for (var k = 0; k < RPP_TOTAL_COLS; k++) if (row[k] === undefined) row[k] = '';
          sheet.appendRow(row);

          // Patch application status to reviewers_proposed
          try {
            formSheet.getRange(found.rowIndex, COL.STATUS).setValue('reviewers_proposed');
          } catch (_) {}

          _monNotify_(_monNidds_(), 'Предложени рецензенти за заявление ' + formId, '🧑‍⚖ Предложени рецензенти — чакат потвърждение',
            [{ label: 'Заявление', value: formId }, { label: 'Конкурс', value: competitionId }, { label: 'ЦКК предложи', value: reviewerEmails.join(', ') }, { label: 'Обосновка', value: justification }]);
          try { logTransaction('PROPOSE_REVIEWERS', auth.userId, formId, { proposalId: id, count: reviewerEmails.length }); } catch (_) {}
          return { success: true, proposalId: id };
        } catch (err) {
          logError('proposeReviewers', err, body);
          return { success: false, error: 'proposeReviewers failed: ' + err.message };
        }
      }

      function confirmReviewers(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin && auth.role !== ROLE_RECTOR) {
            return { success: false, error: 'Само Ректор или Администратор може да потвърди.' };
          }
          var proposalId = String(body.proposalId || '').trim();
          var approve = body.approve === true || body.approve === 'true';
          var modificationsNote = String(body.modificationsNote || '').trim();
          if (!proposalId) return { success: false, error: 'Липсва proposalId.' };

          var sheet = getReviewerProposalsSheet();
          var data = sheet.getDataRange().getValues();
          var rowIdx = -1;
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][RPP_COL.ID - 1]).trim() === proposalId) { rowIdx = i + 1; break; }
          }
          if (rowIdx < 0) return { success: false, error: 'Предложението не е намерено.' };
          var st = String(data[rowIdx - 1][RPP_COL.STATUS - 1]).toLowerCase();
          if (st !== 'pending') return { success: false, error: 'Предложението не е в очакване.' };

          var formId = String(data[rowIdx - 1][RPP_COL.FORM_ID - 1]).trim();
          var proposed = _monParseJson_(data[rowIdx - 1][RPP_COL.PROPOSED_REVIEWERS - 1], []);
          var historyArr = _monParseJson_(data[rowIdx - 1][RPP_COL.HISTORY - 1], []);
          var now = nowISO();

          if (!approve) {
            historyArr.push({ status: 'rejected', ts: now, by: auth.userId, role: auth.role, note: modificationsNote });
            sheet.getRange(rowIdx, RPP_COL.STATUS).setValue('rejected');
            sheet.getRange(rowIdx, RPP_COL.CONFIRMED_BY).setValue(auth.userId);
            sheet.getRange(rowIdx, RPP_COL.CONFIRMED_AT).setValue(now);
            sheet.getRange(rowIdx, RPP_COL.MODIFICATIONS_NOTE).setValue(modificationsNote);
            sheet.getRange(rowIdx, RPP_COL.HISTORY).setValue(JSON.stringify(historyArr));
            // Revert application status
            try {
              var formSheet = getSheet();
              var found = findRowByID(formSheet, formId);
              if (found) formSheet.getRange(found.rowIndex, COL.STATUS).setValue('eligible');
            } catch (_) {}
            try { logTransaction('REJECT_REVIEWER_PROPOSAL', auth.userId, proposalId, { reason: modificationsNote }); } catch (_) {}
            return { success: true, status: 'rejected' };
          }

          var finalReviewers = Array.isArray(body.finalReviewers) && body.finalReviewers.length
            ? normalizeReviewerEmails_(body.finalReviewers)
            : proposed.slice();
          var newStatus = (modificationsNote || (finalReviewers.join(',') !== proposed.join(','))) ? 'modified' : 'confirmed';
          historyArr.push({ status: newStatus, ts: now, by: auth.userId, role: auth.role, note: modificationsNote });

          // FIXED: call assignReviewers FIRST, then persist proposal status only on success.
          // Previously the proposal was marked 'confirmed' before the assignment call,
          // so a failed assignment left a confirmed proposal with zero reviewers assigned.
          var assignRes = assignReviewers({
            formId: formId,
            reviewers: finalReviewers,
            reviewerNames: body.reviewerNames || {},
            overrideRules: !!body.overrideRules,
            userId: auth.userId,
            email: auth.userId,
            isAdmin: auth.isAdmin,
            _bypassTwoStep: true
          });

          if (!assignRes || !assignRes.success) {
            try { logError('confirmReviewers_assignFailed', new Error(assignRes && assignRes.error || 'unknown'), { proposalId: proposalId }); } catch (_) {}
            return { success: false, error: 'Назначаването на рецензенти не успя: ' + ((assignRes && assignRes.error) || 'неуспешно').substring(0, 200) };
          }

          // Persist proposal status now that assignment succeeded
          sheet.getRange(rowIdx, RPP_COL.STATUS).setValue(newStatus);
          sheet.getRange(rowIdx, RPP_COL.CONFIRMED_BY).setValue(auth.userId);
          sheet.getRange(rowIdx, RPP_COL.CONFIRMED_AT).setValue(now);
          sheet.getRange(rowIdx, RPP_COL.FINAL_REVIEWERS).setValue(JSON.stringify(finalReviewers));
          sheet.getRange(rowIdx, RPP_COL.MODIFICATIONS_NOTE).setValue(modificationsNote);
          sheet.getRange(rowIdx, RPP_COL.HISTORY).setValue(JSON.stringify(historyArr));

          try { logTransaction('CONFIRM_REVIEWER_PROPOSAL', auth.userId, proposalId, { finalReviewers: finalReviewers, assignSuccess: true }); } catch (_) {}
          return { success: true, status: newStatus, assignment: assignRes };
        } catch (err) {
          logError('confirmReviewers', err, body);
          return { success: false, error: 'confirmReviewers failed: ' + err.message };
        }
      }

      // ── Per-execution reviewer proposals memo ──
      var _reviewerProposalsMemo_ = null;
      var _reviewerProposalsDv_ = 0;
      function getReviewerProposals(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin && [ROLE_CKK, ROLE_RECTOR, ROLE_VICE_RECTOR, ROLE_NIDD].indexOf(auth.role) === -1) {
            return { success: false, error: 'Нямате право.' };
          }
          // Per-execution memo: RPP changes infrequently and the sheet is
          // small; avoid re-reading and re-parsing JSON blobs on every call.
          var dv = getDataVersions_();
          var dvSnap = dv.reviewer_proposals || 0;
          if (_reviewerProposalsMemo_ && _reviewerProposalsDv_ === dvSnap && !body.forceRefresh) {
            return _reviewerProposalsMemo_;
          }
          var sheet = getReviewerProposalsSheet();
          var data = _cachedSheetData_(sheet);
          var filterForm = body.formId ? String(body.formId).trim() : null;
          var filterStatus = body.status ? String(body.status).toLowerCase() : null;
          var out = [];
          for (var i = 1; i < data.length; i++) {
            if (filterForm && String(data[i][RPP_COL.FORM_ID - 1]).trim() !== filterForm) continue;
            if (filterStatus && String(data[i][RPP_COL.STATUS - 1]).toLowerCase() !== filterStatus) continue;
            out.push({
              id: data[i][RPP_COL.ID - 1],
              formId: data[i][RPP_COL.FORM_ID - 1],
              competitionId: data[i][RPP_COL.COMPETITION_ID - 1],
              proposedBy: data[i][RPP_COL.PROPOSED_BY - 1],
              proposedAt: data[i][RPP_COL.PROPOSED_AT - 1],
              proposedReviewers: _monParseJson_(data[i][RPP_COL.PROPOSED_REVIEWERS - 1], []),
              justification: data[i][RPP_COL.JUSTIFICATION - 1],
              status: String(data[i][RPP_COL.STATUS - 1]).toLowerCase(),
              confirmedBy: data[i][RPP_COL.CONFIRMED_BY - 1],
              confirmedAt: data[i][RPP_COL.CONFIRMED_AT - 1],
              finalReviewers: _monParseJson_(data[i][RPP_COL.FINAL_REVIEWERS - 1], []),
              modificationsNote: data[i][RPP_COL.MODIFICATIONS_NOTE - 1],
              history: _monParseJson_(data[i][RPP_COL.HISTORY - 1], [])
            });
          }
          out.sort(function(a, b) { return String(b.proposedAt || '').localeCompare(String(a.proposedAt || '')); });
          var result = { success: true, proposals: out };
          _reviewerProposalsMemo_ = result;
          _reviewerProposalsDv_ = dvSnap;
          return result;
        } catch (err) {
          logError('getReviewerProposals', err, body);
          return { success: false, error: 'getReviewerProposals failed: ' + err.message };
        }
      }

      // ============================================================
      //  PROCESS 8b — Scheduled review deadline reminders
      // ============================================================

      function _processReviewDeadlineReminders_() {
        try {
          return sendReviewDeadlineReminders({ userId: 'system', isAdmin: true });
        } catch (e) {
          console.warn('_processReviewDeadlineReminders_ failed: ' + e.message);
          return { success: false, error: e.message };
        }
      }

      // ============================================================
      //  PROCESS 9 — Scheduled project reporting reminders
      // ============================================================

      function _processProjectReportingDeadlines_() {
        try {
          var res = sendDeadlineReminders({ userId: 'system', isAdmin: true });
          // Auto-transition overdue projects (deadline + 5d w/o report) to report_overdue.
          var dlRes = getReportDeadlines({ userId: 'system', isAdmin: true });
          if (dlRes && dlRes.success && Array.isArray(dlRes.deadlines)) {
            var sheet = getProjectsSheet();
            var data = sheet.getDataRange().getValues();
            var now = Date.now();
            dlRes.deadlines.forEach(function(dl) {
              try {
                if (!dl.overdue) return;
                var due = new Date(dl.dueDate).getTime();
                if (isNaN(due)) return;
                if ((now - due) < 5 * 24 * 60 * 60 * 1000) return;
                for (var i = 1; i < data.length; i++) {
                  if (String(data[i][PROJ_COL.ID - 1]).trim() === String(dl.projectId).trim()) {
                    var st = String(data[i][PROJ_COL.STATUS - 1]).toLowerCase();
                    if (st === 'report_overdue') return;
                    // Honour the state machine: only flip when the current
                    // status declares 'report_overdue' as a valid next hop.
                    // (PROJECT_TRANSITIONS is in scope at module level.)
                    var allowed = (typeof PROJECT_TRANSITIONS !== 'undefined' && PROJECT_TRANSITIONS[st]) || [];
                    if (allowed.indexOf('report_overdue') === -1) return;
                    sheet.getRange(i + 1, PROJ_COL.STATUS).setValue('report_overdue');
                    try { logTransaction('AUTO_REPORT_OVERDUE', 'system', String(dl.projectId).trim(), { from: st, dueDate: dl.dueDate }); } catch (_) {}
                    return;
                  }
                }
              } catch (_) {}
            });
          }
          return res;
        } catch (e) { console.warn('_processProjectReportingDeadlines_ failed: ' + e.message); return { success: false, error: e.message }; }
      }

      // ── One-time scheduled trigger installer ─────────────────
      function _installScheduledTriggers_() {
        var targets = [
          '_processMONArchival_',
          '_processMONDeadlines_',
          '_processProjectReportingDeadlines_',
          '_processReviewDeadlineReminders_',
          '_drainOrphanEmailQueue_',
          '_drainOrphanDriveCopyQueue_',
          '_processDailyErrorDigest_',
          '_processGdprAutoAnonymise_',
          '_processNightlyBackup_'
        ];
        var triggers = ScriptApp.getProjectTriggers();
        triggers.forEach(function(t) {
          if (targets.indexOf(t.getHandlerFunction()) !== -1) {
            try { ScriptApp.deleteTrigger(t); } catch (_) {}
          }
        });
        ScriptApp.newTrigger('_processMONArchival_').timeBased().everyDays(1).atHour(3).create();
        ScriptApp.newTrigger('_processMONDeadlines_').timeBased().everyDays(1).atHour(7).create();
        ScriptApp.newTrigger('_processReviewDeadlineReminders_').timeBased().everyDays(1).atHour(7).create();
        ScriptApp.newTrigger('_processProjectReportingDeadlines_').timeBased().everyDays(1).atHour(8).create();
        // Hourly safety net for the deferred email queue: if a one-shot
        // trigger was lost (quota, auth race) the next hourly tick drains it.
        ScriptApp.newTrigger('_drainOrphanEmailQueue_').timeBased().everyHours(1).create();
        // Hourly safety net for the deferred Drive-copy queue (v9.44.0-timeout-fix).
        ScriptApp.newTrigger('_drainOrphanDriveCopyQueue_').timeBased().everyHours(1).create();
        // Daily admin error digest (06:00 local).
        ScriptApp.newTrigger('_processDailyErrorDigest_').timeBased().everyDays(1).atHour(6).create();
        // Weekly GDPR auto-anonymisation sweep (Sundays at 02:00).
        ScriptApp.newTrigger('_processGdprAutoAnonymise_').timeBased().onWeekDay(ScriptApp.WeekDay.SUNDAY).atHour(2).create();
        // Nightly Sheets-to-Drive backup (01:00 local).
        ScriptApp.newTrigger('_processNightlyBackup_').timeBased().everyDays(1).atHour(1).create();
        return { success: true, installed: targets };
      }
      // Backward-compatible alias.
      function _installMONTriggers_() { return _installScheduledTriggers_(); }

      // ============================================================
      //  SCHEDULED JOBS — Production hardening (2026-05)
      // ============================================================

      /**
       * Hourly safety-net for the deferred email queue.
       * `_queueDeferredEmail_` schedules a one-shot trigger; if that trigger
       * fails to fire (Apps Script quota / auth race / project re-deploy),
       * messages would otherwise sit in ScriptProperties forever. This drainer
       * runs once an hour and reuses the existing processor.
       */
      function _drainOrphanEmailQueue_() {
        try {
          var props = _scriptProps_();
          var queue = [];
          try { queue = JSON.parse(props.getProperty(_EMAIL_QUEUE_PROP) || '[]'); } catch (_) {}
          if (!queue.length) return { success: true, drained: 0 };
          // Forcibly clear the trigger flag so the processor re-runs even if
          // a stale flag (older than 30 min) was left behind by a crashed run.
          var flagTs = Number(props.getProperty(_EMAIL_TRIGGER_FLAG) || 0);
          if (flagTs && (Date.now() - flagTs) < 30 * 60 * 1000) {
            // Recent — let the in-flight one-shot drain it.
            return { success: true, drained: 0, deferred: true };
          }
          _processDeferredEmailQueue_();
          return { success: true, drained: queue.length };
        } catch (e) {
          try { logError('_drainOrphanEmailQueue_', e, {}); } catch (_) {}
          return { success: false, error: e.message };
        }
      }

      /**
       * Hourly safety-net for the deferred Drive-copy queue (v9.44.0-timeout-fix).
       * Mirrors _drainOrphanEmailQueue_ for _processDeferredDriveCopyQueue_.
       * Rescues any jobs whose one-shot trigger failed to fire.
       */
      function _drainOrphanDriveCopyQueue_() {
        try {
          var props = _scriptProps_();
          var queue = [];
          try { queue = JSON.parse(props.getProperty(_DRIVE_COPY_QUEUE_PROP) || '[]'); } catch (_) {}
          if (!queue.length) return { success: true, drained: 0 };
          var flagTs = Number(props.getProperty(_DRIVE_COPY_TRIGGER_FLAG) || 0);
          if (flagTs && (Date.now() - flagTs) < 30 * 60 * 1000) {
            return { success: true, drained: 0, deferred: true };
          }
          _processDeferredDriveCopyQueue_();
          return { success: true, drained: queue.length };
        } catch (e) {
          try { logError('_drainOrphanDriveCopyQueue_', e, {}); } catch (_) {}
          return { success: false, error: e.message };
        }
      }

      /**
       * Email a daily digest of new ErrorLog rows to administrators.
       * Reads ErrorLog rows whose timestamp falls in the last 24h, groups
       * by action, and sends one HTML summary to every admin email returned
       * by `loadAdminCredentials_`. No-op when there are no fresh errors.
       */
      function _processDailyErrorDigest_() {
        try {
          var ss = _getCachedSpreadsheet();
          var sh = ss.getSheetByName('ErrorLog');
          if (!sh || sh.getLastRow() < 2) return { success: true, count: 0 };
          var data = sh.getDataRange().getValues();
          var since = Date.now() - 24 * 60 * 60 * 1000;
          var groups = {}; var total = 0;
          for (var i = 1; i < data.length; i++) {
            var ts = new Date(data[i][0]).getTime();
            if (isNaN(ts) || ts < since) continue;
            var action = String(data[i][1] || 'unknown');
            var msg = String(data[i][2] || '');
            if (!groups[action]) groups[action] = { count: 0, samples: [] };
            groups[action].count++;
            if (groups[action].samples.length < 3) groups[action].samples.push(msg.substring(0, 200));
            total++;
          }
          if (!total) return { success: true, count: 0 };
          var rows = Object.keys(groups).sort(function(a, b) { return groups[b].count - groups[a].count; });
          var html = '<h3>Дневен отчет на грешките — последни 24h</h3><p><strong>Общо: ' + total + '</strong></p><table border="1" cellpadding="6" cellspacing="0" style="border-collapse:collapse;font-family:Arial,sans-serif;font-size:13px"><tr><th>Действие</th><th>Брой</th><th>Примерни съобщения</th></tr>';
          rows.forEach(function(a) {
            var g = groups[a];
            html += '<tr><td>' + a + '</td><td align="right">' + g.count + '</td><td>' + g.samples.map(function(s) { return s.replace(/[<>&]/g, function(c) { return ({'<':'&lt;','>':'&gt;','&':'&amp;'})[c]; }); }).join('<br>—<br>') + '</td></tr>';
          });
          html += '</table>';
          var admins = [];
          try {
            loadAdminCredentials_();
            if (typeof _SYSTEM_ADMIN_USER !== 'undefined' && _SYSTEM_ADMIN_USER) admins.push(_SYSTEM_ADMIN_USER);
          } catch (_) {}
          // Fallback: dpo@ue-varna.bg (per privacy policy).
          if (!admins.length) admins.push('scientific.projects@ue-varna.bg');
          admins.forEach(function(to) {
            if (DEV_DISABLE_ADMIN_EMAILS) {
              console.info('_processDailyErrorDigest_: [DEV] admin email suppressed -> ' + to);
              return;
            }
            try {
              MailApp.sendEmail({
                to: to,
                subject: '[ИУ-Варна ERP] Дневен отчет на грешки — ' + new Date().toISOString().substring(0, 10),
                htmlBody: html
              });
            } catch (sendErr) {
              console.warn('Error digest send failed for ' + to + ': ' + sendErr.message);
            }
          });
          return { success: true, count: total, admins: admins.length };
        } catch (e) {
          try { logError('_processDailyErrorDigest_', e, {}); } catch (_) {}
          return { success: false, error: e.message };
        }
      }

      /**
       * Weekly GDPR retention sweep — anonymise Applications older than 5y.
       * Per PRIVACY.md the legal basis (Art. 6(1)(в)) requires application
       * data to be retained for 5 years post-decision; afterwards it must be
       * anonymised (audit trail rows are kept per Art. 17 carve-out).
       */
      function _processGdprAutoAnonymise_() {
        try {
          var RETENTION_DAYS = 5 * 365;
          var cutoff = Date.now() - RETENTION_DAYS * 24 * 60 * 60 * 1000;
          var sheet = getSheet();
          var data = sheet.getDataRange().getValues();
          if (data.length < 2) return { success: true, anonymised: 0 };
          var anonymisedEmails = {};
          // Use status + timestamp columns to find fully-resolved old apps.
          var TERMINAL = { rejected:1, ineligible:1, accepted_closed:1, closed_with_sanction:1, terminated:1 };
          for (var i = 1; i < data.length; i++) {
            var row = data[i];
            var status = String(row[COL.STATUS - 1] || '').toLowerCase();
            if (!TERMINAL[status]) continue;
            var ts = new Date(row[COL.TIMESTAMP - 1] || 0).getTime();
            if (isNaN(ts) || ts > cutoff) continue;
            var email = String(row[COL.USER_EMAIL - 1] || '').toLowerCase().trim();
            if (!email || /@anonymized\.local$/.test(email)) continue;
            anonymisedEmails[email] = true;
          }
          var subjects = Object.keys(anonymisedEmails);
          if (!subjects.length) return { success: true, anonymised: 0 };
          var totalRows = 0;
          subjects.forEach(function(subject) {
            try {
              var res = gdprErasure({
                subjectEmail: subject,
                reason: 'AUTO_RETENTION_5Y',
                userId: 'system',
                isAdmin: true
              });
              if (res && res.success) totalRows += (res.rowsAnonymized || 0);
            } catch (subErr) {
              console.warn('Auto-anonymise failed for ' + subject + ': ' + subErr.message);
            }
          });
          try { logTransaction('GDPR_AUTO_ANONYMISE', 'system', 'retention_5y', { subjects: subjects.length, rows: totalRows }); } catch (_) {}
          return { success: true, anonymised: subjects.length, rows: totalRows };
        } catch (e) {
          try { logError('_processGdprAutoAnonymise_', e, {}); } catch (_) {}
          return { success: false, error: e.message };
        }
      }

      /**
       * Nightly backup — copy the live spreadsheet into a Backups folder
       * with a date-stamped name. Retains last 30 backups; older copies are
       * trashed (Drive trash retains for 30 more days as a second safety net).
       */
      function _processNightlyBackup_() {
        try {
          var ss = _getCachedSpreadsheet();
          var liveFile = DriveApp.getFileById(ss.getId());
          var rootFolder = liveFile.getParents().hasNext()
            ? liveFile.getParents().next()
            : DriveApp.getFolderById(DRIVE_FOLDER_ID);
          var BACKUP_NAME = 'Backups';
          var it = rootFolder.getFoldersByName(BACKUP_NAME);
          var backupFolder = it.hasNext() ? it.next() : rootFolder.createFolder(BACKUP_NAME);
          var stamp = new Date().toISOString().replace(/[:.]/g, '-').substring(0, 19);
          var copyName = ss.getName() + ' — backup ' + stamp;
          var copy = liveFile.makeCopy(copyName, backupFolder);
          // Retention: keep only the most recent 30 backups.
          var existing = [];
          var fIt = backupFolder.getFiles();
          while (fIt.hasNext()) {
            var f = fIt.next();
            if (f.getName().indexOf(' — backup ') !== -1) {
              existing.push({ id: f.getId(), name: f.getName(), created: f.getDateCreated().getTime() });
            }
          }
          existing.sort(function(a, b) { return b.created - a.created; });
          var toTrash = existing.slice(30);
          toTrash.forEach(function(rec) {
            try { DriveApp.getFileById(rec.id).setTrashed(true); } catch (_) {}
          });
          try { logTransaction('NIGHTLY_BACKUP', 'system', copy.getId(), { name: copyName, kept: Math.min(existing.length, 30), trashed: toTrash.length }); } catch (_) {}
          return { success: true, backupId: copy.getId(), name: copyName, trashed: toTrash.length };
        } catch (e) {
          try { logError('_processNightlyBackup_', e, {}); } catch (_) {}
          return { success: false, error: e.message };
        }
      }

      // ============================================================
      //  ADMIN NOTIFICATIONS — dedicated endpoint for admin-level events
      //  v12.15.0-adminhistory: Separate from getMyNotifications to prevent
      //  data leaks. Shows system-wide events relevant to administrators:
      //  new submissions, admin edits, status transitions, review completions.
      //  Uses TransactionLog with targeted action prefixes.
      // ============================================================
      function getAdminNotifications(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin) return { success: false, error: 'Отказан достъп: само администратори.' };
          var limit = Math.max(1, Math.min(300, Number(body.limit) || 100));
          var kindPrefix = String(body.kindPrefix || '').toUpperCase();

          var ss = _getCachedSpreadsheet();
          var sh = ss.getSheetByName('TransactionLog');
          if (!sh || sh.getLastRow() < 2) return { success: true, notifications: [], total: 0 };

          var data = sh.getDataRange().getValues();
          var notifications = [];
          var adminActions = [
            'SUBMIT_FORM', 'RESUBMIT_FORM', 'ADMIN_EDIT_FORM', 'TRANSITION_PROJECT',
            'SUBMIT_REVIEW', 'ASSIGN_REVIEWERS', 'CONFIRM_REVIEWERS', 'SIGN_CONTRACT',
            'CREATE_EXPENSE', 'SUBMIT_REPORT', 'APPROVE_EXPENSE', 'ADD_SANCTION',
            'SEND_ADMIN_MESSAGE', 'CREATE_COMPETITION', 'CLOSE_COMPETITION',
            'PUBLISH_RESULTS', 'EDIT_FORM', 'UPLOAD_FILE', 'DELETE_FILE',
            'CREATE_PROJECT', 'UPDATE_PROJECT', 'CREATE_CONTRACT'
          ];

          for (var i = data.length - 1; i >= 1 && notifications.length < limit; i--) {
            var action = String(data[i][1] || '').toUpperCase();
            // If kindPrefix is specified, filter by it; otherwise show all admin-relevant
            if (kindPrefix && action.indexOf(kindPrefix) !== 0) continue;
            if (!kindPrefix && adminActions.indexOf(action) === -1) continue;

            var ts = data[i][0];
            var entity = String(data[i][2] || '');
            var entityId = String(data[i][3] || '');
            var details = String(data[i][4] || '{}');
            var actor = String(data[i][5] || '');

            // Parse timestamp safely
            var tsMs = new Date(ts).getTime() || 0;

            notifications.push({
              id: 'an:' + i,
              action: action,
              type: 'admin',
              entity: entity,
              entityId: entityId,
              details: details,
              actor: actor,
              timestamp: String(ts),
              tsMs: tsMs
            });
          }

          // Newest first
          notifications.sort(function(a, b) { return b.tsMs - a.tsMs; });

          return {
            success: true,
            notifications: notifications,
            total: notifications.length
          };
        } catch (err) {
          try { logError('getAdminNotifications', err, body); } catch (_) {}
          return { success: false, error: 'getAdminNotifications failed: ' + err.message, notifications: [] };
        }
      }

      // ============================================================
      //  NOTIFICATION LOG — admin-facing TransactionLog reader
      // ============================================================

      /**
       * Read recent rows from TransactionLog so admins can verify which
       * notifications were sent (ZЕДЕУУ chain-of-custody requirement).
       * Filterable by `kindPrefix` (e.g. "SEND_" or "EMAIL_") and `since` ISO date.
       */
      function getNotificationLog(body) {
        try {
          var auth = resolveAuthContext(body || {});
          if (!auth.isAdmin) return { success: false, error: 'Отказан достъп: само администратори.' };
          var ss = _getCachedSpreadsheet();
          var sh = ss.getSheetByName('TransactionLog');
          if (!sh || sh.getLastRow() < 2) return { success: true, entries: [], total: 0 };
          var data = sh.getDataRange().getValues();
          var sinceMs = body && body.since ? new Date(body.since).getTime() : 0;
          var kindPrefix = body && body.kindPrefix ? String(body.kindPrefix).toUpperCase() : '';
          var entityFilter   = body && body.entity   ? String(body.entity).toLowerCase() : '';
          var entityIdFilter = body && body.entityId ? String(body.entityId).toLowerCase() : '';
          var actorFilter    = body && body.actor    ? String(body.actor).toLowerCase() : '';
          var limit = Math.max(1, Math.min(500, Number((body && body.limit) || 200)));
          var entries = [];
          // Walk newest-first so we can stop early once limit hit.
          for (var i = data.length - 1; i >= 1 && entries.length < limit; i--) {
            var ts = data[i][0]; var action = String(data[i][1] || '');
            if (kindPrefix && action.toUpperCase().indexOf(kindPrefix) !== 0) continue;
            if (entityFilter   && String(data[i][2] || '').toLowerCase().indexOf(entityFilter) === -1) continue;
            if (entityIdFilter && String(data[i][3] || '').toLowerCase().indexOf(entityIdFilter) === -1) continue;
            if (actorFilter    && String(data[i][5] || '').toLowerCase().indexOf(actorFilter) === -1) continue;
            if (sinceMs) {
              var t = new Date(ts).getTime();
              if (isNaN(t) || t < sinceMs) continue;
            }
            entries.push({
              timestamp: String(ts),
              action: action,
              entity: String(data[i][2] || ''),
              entityId: String(data[i][3] || ''),
              details: String(data[i][4] || ''),
              user: String(data[i][5] || '')
            });
          }
          return { success: true, entries: entries, total: entries.length };
        } catch (err) {
          try { logError('getNotificationLog', err, body); } catch (_) {}
          return { success: false, error: 'getNotificationLog failed: ' + err.message };
        }
      }

      /**
       * USER-FACING activity log — every authenticated principal can read
       * the rows of TransactionLog that concern them personally.
       *
       * A row is considered "mine" if my userId / email appears in:
       *   - column F (User)           – Session.getActiveUser snapshot
       *   - column B (Action) entity payloads where actor is logged as entity
       *   - column C (Entity)         – many handlers store auth.userId here
       *   - column D (EntityId)       – reviewer email, applicant email, etc.
       *   - column E (Details)        – JSON body usually carries actor email
       *
       * Returned rows are anonymised: the system-administrator email is
       * masked, free-text "details" are clipped to 240 chars to avoid
       * leaking other users' PII that may have travelled inside a payload.
       */
      function getMyActivityLog(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          var me = String(auth.userId || '').trim().toLowerCase();
          if (!me) return { success: false, error: 'Не сте удостоверени.' };

          var ss = _getCachedSpreadsheet();
          var sh = ss.getSheetByName('TransactionLog');
          if (!sh || sh.getLastRow() < 2) return { success: true, entries: [], total: 0 };

          var data = sh.getDataRange().getValues();
          var sinceMs   = body.since ? new Date(body.since).getTime() : 0;
          var prefix    = body.kindPrefix ? String(body.kindPrefix).toUpperCase() : '';
          var limit     = Math.max(1, Math.min(500, Number(body.limit) || 200));

          // Pre-build candidate identifiers — userId can be email or name; tolerate both.
          var idTokens = [me];
          var atIdx = me.indexOf('@');
          if (atIdx > 0) idTokens.push(me.substr(0, atIdx)); // local-part fallback

          function rowMatchesMe(row) {
            var blob = (String(row[1] || '') + '|' +
                        String(row[2] || '') + '|' +
                        String(row[3] || '') + '|' +
                        String(row[4] || '') + '|' +
                        String(row[5] || '')).toLowerCase();
            for (var k = 0; k < idTokens.length; k++) {
              if (idTokens[k].length >= 3 && blob.indexOf(idTokens[k]) !== -1) return true;
            }
            return false;
          }

          var entries = [];
          for (var i = data.length - 1; i >= 1 && entries.length < limit; i--) {
            var action = String(data[i][1] || '');
            if (prefix && action.toUpperCase().indexOf(prefix) !== 0) continue;
            if (sinceMs) {
              var t = new Date(data[i][0]).getTime();
              if (isNaN(t) || t < sinceMs) continue;
            }
            if (!rowMatchesMe(data[i])) continue;

            var detailsStr = String(data[i][4] || '');
            if (detailsStr.length > 240) detailsStr = detailsStr.substr(0, 240) + '…';
            entries.push({
              timestamp: String(data[i][0]),
              action: action,
              entity: String(data[i][2] || ''),
              entityId: String(data[i][3] || ''),
              details: detailsStr
            });
          }
          return { success: true, entries: entries, total: entries.length };
        } catch (err) {
          try { logError('getMyActivityLog', err, body); } catch (_) {}
          return { success: false, error: 'getMyActivityLog failed: ' + err.message };
        }
      }

      /** Log a user logout event from the frontend. */
      function logUserLogout(body) {
        try {
          body = body || {};
          var email = String(body.email || body.userId || extractUserId(body) || '').toLowerCase().trim();
          if (!email) return { success: false, error: 'Missing email' };
          logTransaction('LOGOUT', 'user', email, { method: 'client_side' });
          return { success: true };
        } catch (err) {
          return { success: false, error: err.message };
        }
      }

      /* ─── NOTIFICATIONS CENTRE (УЦ — „Известия") ─────────────────────────────────
       * Aggregates a per-user notification feed from existing data sources:
       *   1. Status-change history of the user's own applications (COL.HISTORY)
       *   2. Messages FROM the administrator addressed to the user's applications
       * Read/unread is derived from a per-user "seen" timestamp persisted in the
       * lightweight "NotificationsSeen" sheet (email | seenAt).
       */
      function _getNotifSeenSheet_() {
        return _getOrCreateSheet_('NotificationsSeen', ['email', 'seenAt']);
      }

      function _getNotifSeenAt_(email) {
        try {
          var sh = _getNotifSeenSheet_();
          var data = sh.getDataRange().getValues();
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][0]).toLowerCase().trim() === email) {
              var t = new Date(data[i][1]).getTime();
              return isNaN(t) ? 0 : t;
            }
          }
        } catch (_) {}
        return 0;
      }

      // ── Per-user notification cache prefix ──
      // Cache key: 'MYNOTIF::v1::{email}'
      // TTL: 30 seconds — notification freshness is important but full-sheet
      // scans are expensive. The cache is busted on every mutation via touchDataVersion_.
      var _NOTIF_CACHE_PREFIX_ = 'MYNOTIF::v1::';
      var _NOTIF_CACHE_TTL_SEC_ = 30; // 30 seconds

      /**
       * getMyNotifications — v12.15.0-adminhistory
       *
       * Returns aggregated notifications for the authenticated user.
       * Data sources:
       *   1. Applications sheet COL.HISTORY entries (type 'status')
       *   2. Messages sheet with role='admin' (type 'message')
       *
       * Performance improvements:
       *   - CacheService-backed (30s TTL, busted on data version change)
       *   - Uses _cachedSheetData_ for Applications sheet
       *   - Filters sensitive/internal admin entries for non-admin viewers
       *   - Supports cursor-based pagination via body.after / body.before
       */
      function getMyNotifications(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          var me = String(auth.userId || '').trim().toLowerCase();
          if (!auth.authenticated || !me) return { success: false, error: 'Не сте удостоверени.', notifications: [] };
          var limit = Math.max(1, Math.min(300, Number(body.limit) || 120));
          var isAdmin = !!auth.isAdmin;

          // ── Try cache first ──
          var cacheKey = _NOTIF_CACHE_PREFIX_ + me;
          var cache = _scriptCache_();
          var cachedRaw = null;
          var dataVersion = '';
          try { dataVersion = JSON.stringify(getDataVersions_()); } catch (_) {}
          try {
            cachedRaw = cache.get(cacheKey);
            if (cachedRaw) {
              var cached = JSON.parse(cachedRaw);
              // If the data version matches, use cached result
              if (cached && cached._dv === dataVersion && Array.isArray(cached.notifications)) {
                var seenAt = _getNotifSeenAt_(me);
                var unread = 0;
                for (var cn = 0; cn < cached.notifications.length; cn++) {
                  var ts = new Date(cached.notifications[cn].timestamp).getTime() || 0;
                  cached.notifications[cn].read = ts <= seenAt;
                  if (!cached.notifications[cn].read) unread++;
                }
                return {
                  success: true,
                  notifications: cached.notifications.slice(0, limit),
                  unread: unread,
                  seenAt: seenAt ? new Date(seenAt).toISOString() : null,
                  cached: true
                };
              }
            }
          } catch (_) {}

          var notifications = [];
          var myForms = {}; // formId -> { title, status }

          // 1. Status-change history from the user's own applications
          var sheet = getSheet();
          var rows = _cachedSheetData_(sheet); // uses existing per-execution cache
          for (var i = 1; i < rows.length; i++) {
            var row = rows[i];
            var owner = String(row[COL.USER_EMAIL - 1] || '').trim().toLowerCase();
            var isMine = owner === me;
            if (!isMine) {
              try {
                var tm = safeParseJSON(row[COL.TEAM_MEMBERS - 1], []);
                if (Array.isArray(tm)) {
                  for (var t = 0; t < tm.length; t++) {
                    var em = String((tm[t] && (tm[t].email || tm[t])) || '').toLowerCase().trim();
                    if (em === me) { isMine = true; break; }
                  }
                }
              } catch (_) {}
            }
            if (!isMine) continue;

            var formId = String(row[COL.ID - 1] || '');
            var title = String(row[COL.TITLE - 1] || '') || formId;
            var curStatus = String(row[COL.STATUS - 1] || '');
            myForms[formId] = { title: title, status: curStatus };

            var hist = safeParseJSON(row[COL.HISTORY - 1], []);
            if (Array.isArray(hist)) {
              for (var h = 0; h < hist.length; h++) {
                var ev = hist[h] || {};
                var act = String(ev.action || ev.status || '');
                if (!act) continue;

                // ── v12.15.0-adminhistory: Filter sensitive entries ──
                // History entries with _internal:true or role:'admin' that
                // contain sensitive keywords are hidden from non-admin viewers
                // to prevent data leaks.
                var isSensitive = !!ev._internal;
                var containsSensitiveKeyword = (
                  act.indexOf('Вътрешен') === 0 ||
                  act.indexOf('Служебен') === 0 ||
                  act.indexOf('Конфиденциално') === 0
                );
                if (!isAdmin && (isSensitive || containsSensitiveKeyword)) continue;

                // Admin-only fields that should not leak to applicants
                var skipForApplicant = [
                  'Вътрешна бележка', 'Служебен коментар', 'Вътрешен преглед',
                  'Административна бележка'
                ];
                if (!isAdmin) {
                  var shouldSkip = false;
                  for (var _sk = 0; _sk < skipForApplicant.length; _sk++) {
                    if (act.indexOf(skipForApplicant[_sk]) === 0) { shouldSkip = true; break; }
                  }
                  if (shouldSkip) continue;
                }

                notifications.push({
                  id: 'h:' + formId + ':' + h,
                  type: 'status',
                  formId: formId,
                  title: title,
                  status: String(ev.status || curStatus || ''),
                  text: act,
                  comment: String(ev.comment || ''),
                  actor: String(ev.user || ev.actor || ''),
                  timestamp: String(ev.date || ev.timestamp || '')
                });
              }
            }
          }

          // 2. Messages FROM the administrator addressed to the user's applications
          try {
            var msh = _getMessagesSheet_();
            var mdata = _cachedSheetData_(msh); // uses existing per-execution cache
            for (var m = 1; m < mdata.length; m++) {
              var mFormId = String(mdata[m][1] || '');
              if (!myForms[mFormId]) continue;
              if (String(mdata[m][3] || '') !== 'admin') continue; // only messages from admin
              // ── v12.15.0-adminhistory: Skip admin-internal messages ──
              if (!isAdmin && String(mdata[m][4] || '').indexOf('[ВЪТРЕШНО]') === 0) continue;
              notifications.push({
                id: 'm:' + String(mdata[m][0] || (mFormId + ':' + m)),
                type: 'message',
                formId: mFormId,
                title: myForms[mFormId].title,
                status: myForms[mFormId].status,
                text: String(mdata[m][4] || ''),
                actor: String(mdata[m][2] || 'администратор'),
                timestamp: String(mdata[m][5] || ''),
                msgRead: (mdata[m][6] === true || String(mdata[m][6]) === 'true')
              });
            }
          } catch (_) {}

          // Newest first
          notifications.sort(function(a, b) {
            return (new Date(b.timestamp).getTime() || 0) - (new Date(a.timestamp).getTime() || 0);
          });
          if (notifications.length > limit) notifications = notifications.slice(0, limit);

          var seenAt = _getNotifSeenAt_(me);
          var unread = 0;
          for (var n = 0; n < notifications.length; n++) {
            var ts = new Date(notifications[n].timestamp).getTime() || 0;
            var isUnread = ts > seenAt;
            notifications[n].read = !isUnread;
            if (isUnread) unread++;
          }

          // ── Cache the result (without read flags — those are time-sensitive) ──
          try {
            var cachePayload = { _dv: dataVersion, notifications: notifications };
            cache.put(cacheKey, JSON.stringify(cachePayload), _NOTIF_CACHE_TTL_SEC_);
          } catch (_) {}

          return {
            success: true,
            notifications: notifications,
            unread: unread,
            seenAt: seenAt ? new Date(seenAt).toISOString() : null
          };
        } catch (err) {
          try { logError('getMyNotifications', err, body); } catch (_) {}
          return { success: false, error: 'getMyNotifications failed: ' + err.message, notifications: [] };
        }
      }

      function markNotificationsSeen(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          var me = String(auth.userId || '').trim().toLowerCase();
          if (!auth.authenticated || !me) return { success: false, error: 'Не сте удостоверени.' };
          var now = new Date().toISOString();
          var sh = _getNotifSeenSheet_();
          var data = sh.getDataRange().getValues();
          var foundRow = -1;
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][0]).toLowerCase().trim() === me) { foundRow = i + 1; break; }
          }
          if (foundRow > 0) sh.getRange(foundRow, 2).setValue(now);
          else sh.appendRow([me, now]);
          return { success: true, seenAt: now };
        } catch (err) {
          try { logError('markNotificationsSeen', err, body); } catch (_) {}
          return { success: false, error: 'markNotificationsSeen failed: ' + err.message };
        }
      }

      /* ─── MESSAGES / CHAT ────────────────────────────────────────────────────────
      * Sheet: "Messages" with columns: id | formId | senderEmail | role | message | timestamp | read
      * The sheet is created on first write if it doesn't exist.
      */
      function _getMessagesSheet_() {
        var ss = _getCachedSpreadsheet();
        var sh = ss.getSheetByName('Messages');
        if (!sh) {
          sh = ss.insertSheet('Messages');
          sh.getRange(1, 1, 1, 7).setValues([['id', 'formId', 'senderEmail', 'role', 'message', 'timestamp', 'read']]);
          sh.setFrozenRows(1);
        } else {
          // Migration: add 'read' column if missing (pre-v6.1 sheets)
          var headers = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0];
          var hasReadCol = false;
          for (var hi = 0; hi < headers.length; hi++) {
            if (String(headers[hi]).toLowerCase().trim() === 'read') { hasReadCol = true; break; }
          }
          if (!hasReadCol && sh.getLastColumn() >= 6) {
            sh.getRange(1, sh.getLastColumn() + 1).setValue('read');
          }
        }
        return sh;
      }

      function getMessages(body) {
        try {
          var formId = String(body.formId || '').trim();
          if (!formId) return { success: false, error: 'formId required' };
          var ctx = resolveAuthContext(body);
          if (!ctx.authenticated) return { success: false, error: 'Not authenticated' };
          var sh = _getMessagesSheet_();
          var data = sh.getDataRange().getValues();
          var messages = [];
          var callerRole = ctx.isAdmin ? 'admin' : 'applicant';
          var unreadCount = 0;
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][1]) !== formId) continue;
            var isRead = data[i][6] === true || String(data[i][6]) === 'true';
            messages.push({
              id:          String(data[i][0]),
              formId:      String(data[i][1]),
              senderEmail: String(data[i][2]),
              role:        String(data[i][3]),
              message:     String(data[i][4]),
              timestamp:   String(data[i][5]),
              read:        !!isRead
            });
            // Count unread messages that were NOT sent by the caller
            if (!isRead && String(data[i][3]) !== callerRole) unreadCount++;
          }
          return { success: true, messages: messages, unreadCount: unreadCount };
        } catch (err) {
          try { logError('getMessages', err, body); } catch (_) {}
          return { success: false, error: 'getMessages failed: ' + err.message };
        }
      }

      /* ─── Mark messages as read for a form ─────────────────────────── */
      function markMessagesRead(body) {
        try {
          var formId = String(body.formId || '').trim();
          if (!formId) return { success: false, error: 'formId required' };
          var ctx = resolveAuthContext(body);
          if (!ctx.authenticated) return { success: false, error: 'Not authenticated' };
          var sh = _getMessagesSheet_();
          var data = sh.getDataRange().getValues();
          var callerRole = ctx.isAdmin ? 'admin' : 'applicant';
          var readCol = data[0].indexOf('read');
          if (readCol < 0) return { success: true, marked: 0 };
          var marked = 0;
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][1]) !== formId) continue;
            if (String(data[i][3]) === callerRole) continue; // own messages already "read"
            if (data[i][readCol] === true || String(data[i][readCol]) === 'true') continue;
            sh.getRange(i + 1, readCol + 1).setValue(true);
            marked++;
          }
          if (marked > 0) { try { touchDataVersion_('messages'); } catch (_) {} }
          return { success: true, marked: marked };
        } catch (err) {
          try { logError('markMessagesRead', err, body); } catch (_) {}
          return { success: false, error: 'markMessagesRead failed: ' + err.message };
        }
      }

      /* ─── Lightweight unread-count poll (no message bodies) ────────── */
      function getUnreadMessageCount(body) {
        try {
          var formId = String(body.formId || '').trim();
          var ctx = resolveAuthContext(body);
          if (!ctx.authenticated) return { success: false, unread: 0, error: 'Not authenticated' };
          var sh = _getMessagesSheet_();
          var data = sh.getDataRange().getValues();
          var callerRole = ctx.isAdmin ? 'admin' : 'applicant';
          var readCol = data[0].indexOf('read');
          var unread = 0;
          for (var i = 1; i < data.length; i++) {
            if (formId && String(data[i][1]) !== formId) continue;
            var isRead = readCol >= 0 && (data[i][readCol] === true || String(data[i][readCol]) === 'true');
            if (!isRead && String(data[i][3]) !== callerRole) unread++;
          }
          return { success: true, unread: unread };
        } catch (err) {
          return { success: false, unread: 0, error: 'getUnreadMessageCount failed: ' + err.message };
        }
      }

      function sendMessage(body) {
        try {
          var formId  = String(body.formId  || '').trim();
          var message = String(body.message || '').trim();
          var role    = String(body.role    || 'applicant');
          if (!formId || !message) return { success: false, error: 'formId and message required' };
          var ctx = resolveAuthContext(body);
          if (!ctx.authenticated) return { success: false, error: 'Not authenticated' };
          var sh = _getMessagesSheet_();
          var id = Utilities.getUuid();
          var ts = new Date().toISOString();
          // Column order: id, formId, senderEmail, role, message, timestamp, read
          var lastCol = sh.getLastColumn();
          if (lastCol >= 7) {
            sh.appendRow([id, formId, ctx.email || '', role, message, ts, false]);
          } else {
            sh.appendRow([id, formId, ctx.email || '', role, message, ts]);
          }
          try { touchDataVersion_('messages'); } catch (_) {}
          // Best-effort email notification (non-blocking, both directions)
          try {
            var targetEmail = '', targetName = '';
            // Look up the applicant email from the Applications sheet
            try {
              var appSheet = getSheet();
              var appFound = findRowByID(appSheet, formId);
              if (appFound) {
                targetEmail = String(appFound.rowData[COL.USER_EMAIL - 1] || '').trim();
                targetName  = String(appFound.rowData[COL.USER_NAME  - 1] || '').trim();
              }
            } catch (_) {}
            if (targetEmail) {
              var senderLabel = role === 'admin' ? 'администратор' : 'кандидат';
              // Pull project status + title for the visual badge that appears in every email
              var _msgProjStatus = '';
              var _msgProjTitle = '';
              try {
                if (appFound && appFound.rowData) {
                  _msgProjStatus = String(appFound.rowData[COL.STATUS - 1] || '');
                  _msgProjTitle  = String(appFound.rowData[COL.TITLE  - 1] || '');
                }
              } catch (_) {}
              if (role === 'admin') {
                // Admin → Applicant: route through notifyApplicant_ to respect email_new_message pref.
                // Now wraps the message in the branded buildNotificationHtml_ template with status badge.
                var _adminMsgIntro = '<p style="margin:0 0 12px">Получавате ново съобщение от <strong>администратор</strong> по вашата заявка.</p>' +
                  '<blockquote style="border-left:3px solid ' + BRAND_TEAL + ';padding:10px 16px;color:#3c4043;margin:8px 0;background:#F4FAF8;border-radius:4px;white-space:pre-wrap">' + xmlEscape_(message) + '</blockquote>' +
                  '<p style="margin:12px 0 0;font-size:13px;color:#5f6368">Можете да отговорите от модула „Съобщения" в детайла на заявката.</p>';
                var _adminMsgLines = [
                  { label: 'Заявка:', value: formId },
                  _msgProjTitle ? { label: 'Заглавие:', value: _msgProjTitle } : null,
                  { label: 'Дата:', value: new Date().toLocaleString('bg-BG', { timeZone: 'Europe/Sofia' }) }
                ].filter(Boolean);
                var _adminMsgHtml = buildNotificationHtml_(
                  '💬 Ново съобщение от администратор',
                  _adminMsgLines,
                  'Това известие е автоматично — отговорете от портала, а не от пощата си.',
                  { introHtml: _adminMsgIntro, status: _msgProjStatus, ctaLabel: 'Отвори съобщенията', preheader: 'Ново съобщение по заявка ' + formId }
                );
                notifyApplicant_(targetEmail, 'Ново съобщение по заявка ' + formId + ' | ИУ Варна', _adminMsgHtml, 'email_new_message');
              } else {
                // Applicant → Admin: route through notifyApplicant_ so DEV_DISABLE_ADMIN_EMAILS is respected
                var adminEmails = [];
                try {
                  loadAdminCredentials_();
                  if (Array.isArray(_ADMIN_EMAILS_SERVER) && _ADMIN_EMAILS_SERVER.length) {
                    adminEmails = _ADMIN_EMAILS_SERVER.slice();
                  } else if (Array.isArray(ADMIN_EMAILS_SERVER) && ADMIN_EMAILS_SERVER.length) {
                    adminEmails = ADMIN_EMAILS_SERVER.slice();
                  }
                } catch (_) {}
                if (adminEmails.length > 0) {
                  var _appMsgIntro = '<p style="margin:0 0 12px">Кандидат <strong>' + xmlEscape_(ctx.email || '') + '</strong> изпрати ново съобщение по заявка.</p>' +
                    '<blockquote style="border-left:3px solid ' + BRAND_TEAL + ';padding:10px 16px;color:#3c4043;margin:8px 0;background:#F4FAF8;border-radius:4px;white-space:pre-wrap">' + xmlEscape_(message) + '</blockquote>';
                  var _appMsgLines = [
                    { label: 'Заявка:', value: formId },
                    _msgProjTitle ? { label: 'Заглавие:', value: _msgProjTitle } : null,
                    { label: 'Кандидат:', value: targetName || targetEmail },
                    { label: 'Дата:', value: new Date().toLocaleString('bg-BG', { timeZone: 'Europe/Sofia' }) }
                  ].filter(Boolean);
                  var _appMsgHtml = buildNotificationHtml_(
                    '💬 Ново съобщение от кандидат',
                    _appMsgLines,
                    'Отворете заявката в портала, за да прегледате контекста и отговорите.',
                    { introHtml: _appMsgIntro, status: _msgProjStatus, ctaLabel: 'Отвори в портала', preheader: 'Ново съобщение от кандидат — ' + formId }
                  );
                  adminEmails.forEach(function(ae) {
                    notifyApplicant_(ae, 'Ново съобщение от кандидат — заявка ' + formId + ' | ИУ Варна', _appMsgHtml, 'email_new_message');
                  });
                }
              }
            }
          } catch (_) {}
          return { success: true, id: id, timestamp: ts };
        } catch (err) {
          try { logError('sendMessage', err, body); } catch (_) {}
          return { success: false, error: 'sendMessage failed: ' + err.message };
        }
      }

      /**
       * requestCorrection — Admin-only quick action.
       * Posts a structured "correction needed" message + email + optional return-to-applicant.
       * Body: { formId, reason, targetField?, targetDocName?, returnToApplicant? }
       */
      function requestCorrection(body) {
        try {
          body = body || {};
          var ctx = resolveAuthContext(body);
          if (!ctx.authenticated) return { success: false, error: 'Not authenticated' };
          if (!ctx.isAdmin) return { success: false, error: 'Admin only' };
          var formId       = String(body.formId || '').trim();
          var reason       = String(body.reason || '').trim();
          var targetField  = String(body.targetField  || '').trim();
          var targetDoc    = String(body.targetDocName || '').trim();
          var returnToApp  = !!body.returnToApplicant;
          if (!formId || !reason) return { success: false, error: 'formId and reason required' };

          var sheet = getSheet();
          var found = findRowByID(sheet, formId);
          if (!found) return { success: false, error: 'Application not found' };
          var row = found.rowData;
          var applicantEmail = String(row[COL.USER_EMAIL - 1] || '').trim();
          var applicantName  = String(row[COL.USER_NAME  - 1] || '').trim();
          var projTitle      = String(row[COL.TITLE - 1] || '');
          var prevStatus     = String(row[COL.STATUS - 1] || '');

          // Compose structured message text
          var msgLines = ['✉️ ИСКАНА КОРЕКЦИЯ ОТ АДМИНИСТРАТОР'];
          if (targetDoc)   msgLines.push('Документ: ' + targetDoc);
          if (targetField) msgLines.push('Поле: ' + targetField);
          msgLines.push('');
          msgLines.push('Причина: ' + reason);
          var msgText = msgLines.join('\n');

          // 1. Append structured message via Messages sheet
          var sh = _getMessagesSheet_();
          var msgId = Utilities.getUuid();
          var ts = new Date().toISOString();
          var lastCol = sh.getLastColumn();
          if (lastCol >= 7) {
            sh.appendRow([msgId, formId, ctx.email || '', 'admin', msgText, ts, false]);
          } else {
            sh.appendRow([msgId, formId, ctx.email || '', 'admin', msgText, ts]);
          }
          try { touchDataVersion_('messages'); } catch (_) {}

          // 2. Update status to RETURNED (if requested) so applicant can edit
          if (returnToApp && prevStatus !== 'returned' && prevStatus !== 'draft') {
            try {
              row[COL.STATUS - 1] = 'returned';
              if (typeof COL.RETURN_COMMENT !== 'undefined') {
                row[COL.RETURN_COMMENT - 1] = String(row[COL.RETURN_COMMENT - 1] || '') +
                  (row[COL.RETURN_COMMENT - 1] ? '\n\n' : '') +
                  '[' + new Date().toLocaleString('bg-BG') + '] ' + (ctx.email || 'admin') + ': ' + reason +
                  (targetDoc ? ' (док.: ' + targetDoc + ')' : '') +
                  (targetField ? ' (поле: ' + targetField + ')' : '');
              }
              safeSetRow_(sheet, found.rowIndex, row, sheet.getLastColumn());
              try { touchDataVersion_('applications'); } catch (_) {}
              try {
                logTransaction('REQUEST_CORRECTION', 'application', formId, {
                  by: ctx.email, reason: reason.slice(0, 200), targetField: targetField, targetDoc: targetDoc
                });
              } catch (_) {}
            } catch (statusErr) {
              // continue with email even if status update fails
            }
          }

          // 3. Send branded email notification
          if (applicantEmail) {
            try {
              var introHtml = '<p style="margin:0 0 12px"><strong>Администратор от ЦКК</strong> иска корекция по вашата заявка.</p>' +
                (targetDoc ? '<p style="margin:8px 0"><strong>Коригирайте документ:</strong> <span style="color:#7B0000">' + xmlEscape_(targetDoc) + '</span></p>' : '') +
                (targetField ? '<p style="margin:8px 0"><strong>Поле:</strong> <span style="color:#7B0000">' + xmlEscape_(targetField) + '</span></p>' : '') +
                '<blockquote style="border-left:3px solid #DC2626;padding:10px 16px;color:#3c4043;margin:12px 0;background:#FEF2F2;border-radius:4px;white-space:pre-wrap">' + xmlEscape_(reason) + '</blockquote>' +
                (returnToApp ? '<p style="margin:12px 0 0"><strong>Заявката е върната</strong> в режим "За корекция". Можете да я редактирате в портала.</p>' : '<p style="margin:12px 0 0">Моля, влезте в портала и коригирайте.</p>');
              var lines = [
                { label: 'Заявка:', value: formId },
                projTitle ? { label: 'Заглавие:', value: projTitle } : null,
                { label: 'Администратор:', value: ctx.email || '' },
                { label: 'Дата:', value: new Date().toLocaleString('bg-BG', { timeZone: 'Europe/Sofia' }) }
              ].filter(Boolean);
              var html = buildNotificationHtml_(
                '⚠️ Искана корекция по заявката',
                lines,
                'След корекцията, преподайте заявката за преглед.',
                { introHtml: introHtml, status: returnToApp ? 'returned' : prevStatus, ctaLabel: 'Отвори заявката', preheader: 'Искана корекция по заявка ' + formId }
              );
              notifyApplicant_(applicantEmail, '⚠️ Искана корекция по заявка ' + formId + ' | ИУ Варна', html, 'email_correction_request');
            } catch (emailErr) {
              try { logError('requestCorrection email', emailErr, { formId: formId }); } catch (_) {}
            }
          }

          return {
            success: true,
            messageId: msgId,
            status: returnToApp ? 'returned' : prevStatus,
            emailedTo: applicantEmail || null
          };
        } catch (err) {
          try { logError('requestCorrection', err, body); } catch (_) {}
          return { success: false, error: 'requestCorrection: ' + err.message };
        }
      }

      /* ─── DRAFT DELETE (UC-applicant) ──────────────────────────────────────
      * Allows the applicant to delete their own form ONLY when status='draft'.
      * Server-side validation: ownership + status guard. Audited via History.
      * Cleans up:
      *   1. Drive app folder + all contents (system copies of uploaded files)
      *   2. Applicant session-folder copies created by generateApplicationDocument
      *      (files in My Documents / SESSION_FOLDER_NAME with matching formId prefix)
      *   3. ScriptProperties caches (folder-id memo + autosave draft key)
      *   4. Sheet row
      *   5. In-memory _sheetReadCache_ so next getForms call reflects deletion
      * Frontend: calls api('deleteform', {id, userId, email}).
      * ────────────────────────────────────────────────────────────────────── */
      function deleteFormDraft_(body) {
        try {
          var id = String((body && (body.id || body.formId)) || '').trim();
          if (!id) return { success: false, error: 'Missing form id' };
          var caller = String((body && (body.email || body.userId)) || '').toLowerCase().trim();
          if (!caller) return { success: false, error: 'Не сте удостоверен.' };
          var sh = getSheet();
          if (!sh) return { success: false, error: 'Forms sheet missing' };
          // Use the per-execution sheet data cache so a preceding getForms call
          // (same execution) does not force a redundant full-sheet read.
          var data = _cachedSheetData_(sh);
          if (data.length < 2) return { success: false, error: 'Формулярът не е намерен.' };
          var head = data[0];
          // Normalise header names to lowercase so indexOf is case-insensitive
          for (var _hi = 0; _hi < head.length; _hi++) { head[_hi] = String(head[_hi] || '').toLowerCase(); }
          var idIdx   = head.indexOf('id');
          var stIdx   = head.indexOf('status');
          var emIdx   = head.indexOf('useremail'); if (emIdx < 0) emIdx = head.indexOf('userid');
          var fidIdx  = head.indexOf('fileids');
          var adIdx   = head.indexOf('attacheddocs');
          if (idIdx < 0 || stIdx < 0 || emIdx < 0) return { success: false, error: 'Schema mismatch' };
          var rowIdx = -1, rowData = null;
          for (var r = 1; r < data.length; r++) {
            if (String(data[r][idIdx]) !== id) continue;
            var st = String(data[r][stIdx] || '').toLowerCase();
