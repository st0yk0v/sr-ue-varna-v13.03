        loadAdminCredentials_();
        if (u === _SYSTEM_ADMIN_USER && p === _SYSTEM_ADMIN_PASS) {
          try { logTransaction('LOGIN_ADMIN', 'admin', _SYSTEM_ADMIN_USER, { role: ROLE_ADMIN }); } catch (_) {}
          return {
            success: true,
            user: {
              name: 'Администратор',
              email: _SYSTEM_ADMIN_USER,
              userId: _SYSTEM_ADMIN_USER,
              picture: null
            },
            isAdmin: true,
            role: ROLE_ADMIN
          };
        }
        // ── Rector-administrator (УЦ-16 / УЦ-22 / УЦ-25) ──
        if (_SYSTEM_RECADMIN_USER && u === _SYSTEM_RECADMIN_USER && p === _SYSTEM_RECADMIN_PASS) {
          try { auditAppendChainRow_('rector_login', _SYSTEM_RECADMIN_USER, { ts: new Date().toISOString() }); } catch (_) {}
          try { logTransaction('LOGIN_RECTOR', 'admin', _SYSTEM_RECADMIN_USER, { role: ROLE_RECTOR }); } catch (_) {}
          return {
            success: true,
            user: {
              name: 'Ректор (администратор)',
