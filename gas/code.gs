              applicantName: String(body.applicantName || auth.userId || '').trim(),
              projectTitle: String(body.projectTitle || '').trim()
            };
            _prefillBudgetMetadata_(copyId, tpl.gid, metaPayload);
          } catch (_) {}

          try {
            logTransaction('COPY_BUDGET_TEMPLATE', 'file', copyId, {
              by: auth.userId, projectType: projectType, prefilled: prefilled, src: tpl.id
            });
          } catch (_) {}

          var editLink = 'https://docs.google.com/spreadsheets/d/' + copyId + '/edit';
          // v12.30.2-defensive: use MIME-aware secure links. The old hardcoded
          // drive.google.com/file/d/{id}/preview URL fails in iframes for
          // Google-native Sheets with "За съжаление файлът... не съществува"
          // (see buildSecureFileLinks_ v18.0.3 note).
          var _bLinks = buildSecureFileLinks_(copyId, { allowDownload: true, mimeType: 'application/vnd.google-apps.spreadsheet' });
          var fileObj = {
            id: copyId,
              driveId: copyId,
            name: copy.getName(),
            mimeType: 'application/vnd.google-apps.spreadsheet',
            typeLabel: 'Google Sheets',
            previewLink: _bLinks.previewLink,
            webViewLink: editLink,
            editLink: editLink,
            googleSheetEditLink: editLink,
            googleDocEditLink: editLink,
            downloadUrl: _bLinks.downloadUrl || copy.getUrl(),
            folderName: 'Моите документи',
            origin: 'budget',
            templateSourceId: tpl.id,
            templateSourceName: original.getName(),
            projectType: projectType,
            _generated: true,
            docType: 'budget'
          };
          return {
            success: true,
            message: 'Бюджетната таблица е готова' + (prefilled > 0 ? (' (попълнени са ' + prefilled + ' клетки)') : '') + '.',
            file: fileObj,
