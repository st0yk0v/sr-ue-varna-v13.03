      // ============================================================
      //  REPAIR ALL SHEETS – Admin-only recovery after manual edits
      //  Validates headers, re-indexes data, fixes protection.
      //  Call via action: repairallsheets
      // ============================================================
      function repairAllSheets(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin) {
            return { success: false, error: 'Отказан достъп: Само администратори могат да поправят таблиците.' };
          }

          var report = { applications: null, competitions: null, reviewers: null, protection: [] };

          // Clear sheet cache so we get fresh handles
          _sheetCache = {};

          var ss = _getCachedSpreadsheet();

          // 1. Remove ALL existing sheet-level protections so repair can proceed
          var allSheets = ss.getSheets();
          for (var s = 0; s < allSheets.length; s++) {
            try {
              var prots = allSheets[s].getProtections(SpreadsheetApp.ProtectionType.SHEET);
              for (var p = 0; p < prots.length; p++) {
                try { prots[p].remove(); } catch (_) {}
              }
            } catch (_) {}
          }

          // 2. Repair Applications sheet
          try {
            var appSheet = ss.getSheetByName(SHEET_NAME);
            if (appSheet) {
              report.applications = repairSheetHeaders_(appSheet, EXPECTED_HEADERS, TOTAL_COLS);
            } else {
              report.applications = { repaired: false, message: 'Sheet not found — will be created on next access' };
            }
          } catch (e) {
            report.applications = { repaired: false, error: e.message };
          }

          // 3. Repair Competitions sheet
          try {
            var compSheet = ss.getSheetByName(COMPETITIONS_SHEET_NAME);
            if (compSheet) {
              report.competitions = repairSheetHeaders_(compSheet, COMP_EXPECTED_HEADERS, COMP_TOTAL_COLS);
            } else {
              report.competitions = { repaired: false, message: 'Sheet not found — will be created on next access' };
            }
          } catch (e) {
            report.competitions = { repaired: false, error: e.message };
          }

          // 4. Repair Reviewers sheet
          try {
            var revSheet = ss.getSheetByName(REVIEWERS_SHEET_NAME);
            if (revSheet) {
              report.reviewers = repairSheetHeaders_(revSheet, REV_EXPECTED_HEADERS, REV_TOTAL_COLS);
            } else {
              report.reviewers = { repaired: false, message: 'Sheet not found — will be created on next access' };
            }
          } catch (e) {
            report.reviewers = { repaired: false, error: e.message };
          }

          // 5. Re-apply protection (now with admin emails included)
          try {
            var appS = getSheet();
            report.protection.push('Applications: OK');
          } catch (e) { report.protection.push('Applications: ' + e.message); }
          try {
            var compS = getCompetitionsSheet();
            report.protection.push('Competitions: OK');
          } catch (e) { report.protection.push('Competitions: ' + e.message); }
          try {
            var revS = getReviewersSheet();
            report.protection.push('Reviewers: OK');
          } catch (e) { report.protection.push('Reviewers: ' + e.message); }

          // 6. Invalidate all caches
          try { invalidateCache('COMPETITIONS'); } catch (_) {}
          try { invalidateCache('REVIEWERS_ALL'); } catch (_) {}

          // 7. Re-sync derived sheets
          try { syncAllDerivedSheets_(true); } catch (_) {}

          return {
            success: true,
            message: 'Таблиците са поправени и защитите са обновени. Администраторите вече имат достъп.',
            report: report,
            timestamp: nowISO()
          };
        } catch (err) {
          logError('repairAllSheets', err, body);
          return { success: false, error: 'repairAllSheets failed: ' + err.message };
        }
      }

      /**
       * Sync Handler - Called after data modifications
       */
      function syncSheets(body) {
        try {
          // Invalidate caches to force refresh
          invalidateCache('COMPETITIONS');
          invalidateCache('REVIEWERS_ALL');
          var props = _scriptProps_();
          var all = props.getProperties();
          Object.keys(all).forEach(function(k) {
