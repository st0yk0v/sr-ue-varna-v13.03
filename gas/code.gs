        // Pre-flight validation
        if (!email || String(email).indexOf('@') < 1) {
          return { ok: false, error: 'Невалиден имейл адрес: ' + email };
        }
        // NOTE: OTP is a SECURITY MECHANISM, not a notification.
        // Suppression lists and notification preferences MUST NOT block OTP delivery.
        // If a user cannot receive their verification code, they are locked out entirely.
        // ── PERF: skip the MailApp.getRemainingDailyQuota() pre-flight ──
        // It adds ~150–300 ms per send and the daily quota (100 / personal,
        // 1500 / Workspace) is rarely the actual failure mode. When the quota
        // really is exhausted MailApp throws synchronously below and we surface
        // the same error to the caller.
        // Single-attempt rich send with one minimal fallback. Logos are
        // intentionally omitted (see comment above) so the multi-attempt
        // ladder for noReply/name compatibility is the only fallback we keep.
        try {
          MailApp.sendEmail({
            to: email,
            subject: subject,
            body: bodyText,
            htmlBody: htmlBody,
            noReply: true,
            name: 'ERP Научни проекти – ИУ Варна'
          });
          console.info('_otpSendEmail_: sent to ' + email + ' (rich)');
          return { ok: true, attempt: 1 };
        } catch (err1) {
          console.warn('_otpSendEmail_ rich attempt failed: ' + err1.message + ' — falling back to minimal');
          try {
            MailApp.sendEmail(email, subject, bodyText, { htmlBody: htmlBody });
            console.info('_otpSendEmail_: sent to ' + email + ' (minimal)');
            return { ok: true, attempt: 2 };
          } catch (err2) {
            try { logError('_otpSendEmail_', err2, { email: email }); } catch (_) {}
            return { ok: false, error: 'Изпращането на имейл се провали: ' + err2.message };
          }
        }
      }

      /**
       * Generate + email a one-time 6-digit code for a given (scope, email, ref).
       * Returns { success, codeSent, expiresIn, cooldown }.
       */
      // ── Global per-email flood guard (sliding-window counter) ──
      // Anti-abuse cap on the number of OTP emails per address within a window
      // WITHOUT hard-blocking legitimately-distinct actions. The previous rule
      // ("one code per 60 s for ANY scope/ref") broke multi-step flows: e.g.
      // sign an application, then immediately confirm another action — the
      // second request was throttled and NO code was ever stored for it,
      // locking the user out until the cooldown expired AND they re-requested.
      // A counter lets each distinct action receive its own code while still
      // stopping a flood of requests.
      var OTP_GLOBAL_WINDOW_S  = 5 * 60;   // 5-minute sliding window
      var OTP_GLOBAL_MAX_SENDS = 6;        // max OTP emails per window per email
      var OTP_GLOBAL_PREFIX = '2FA::GLOBALCNT::';
      function _otpGlobalKey_(email) {
        return OTP_GLOBAL_PREFIX + String(email || '').toLowerCase().trim();
      }

      function _otpIssue_(scope, email, ref) {
        email = String(email || '').toLowerCase().trim();
        if (!email || email.indexOf('@') < 0) {
          return { success: false, error: 'Невалиден имейл за изпращане на код.' };
        }
        var cache = _scriptCache_();
        var now = Date.now();

        // ── Global flood guard (sliding-window counter) ──
        // Distinct actions each get their own code; only a true flood (more
        // than OTP_GLOBAL_MAX_SENDS emails inside the window) is throttled.
        var globalKey = _otpGlobalKey_(email);
        var globalRec = null;
        try { globalRec = JSON.parse(cache.get(globalKey) || 'null'); } catch (_) { globalRec = null; }
        if (!globalRec || !globalRec.windowStart || (now - globalRec.windowStart) >= OTP_GLOBAL_WINDOW_S * 1000) {
          globalRec = { windowStart: now, count: 0 };
        }
        if (globalRec.count >= OTP_GLOBAL_MAX_SENDS) {
          var waitMs = OTP_GLOBAL_WINDOW_S * 1000 - (now - globalRec.windowStart);
          return {
            success: true,
            codeSent: false,
            throttled: true,
            globalThrottle: true,
            cooldown: Math.max(1, Math.ceil(waitMs / 1000)),
            expiresIn: OTP_TTL_SECONDS,
            message: 'Твърде много заявки за код. Опитайте отново след малко.'
          };
        }

        var key = _otpKey_(scope, email, ref);
        var existingRaw = cache.get(key);
        if (existingRaw) {
          try {
            var existing = JSON.parse(existingRaw);
            if (existing && existing.issuedAt && (now - existing.issuedAt) < OTP_RESEND_COOLDOWN_S * 1000) {
              return {
                success: true,
                codeSent: false,
                throttled: true,
                cooldown: OTP_RESEND_COOLDOWN_S - Math.floor((now - existing.issuedAt) / 1000),
                expiresIn: Math.max(0, OTP_TTL_SECONDS - Math.floor((now - existing.issuedAt) / 1000))
              };
            }
          } catch (_) {}
        }
        var code = _otpGenerateCode_();
        var salt = Utilities.getUuid();
        var record = {
          hash: _otpHash_(code, salt),
          salt: salt,
          attempts: 0,
          issuedAt: now,
          scope: scope || 'default',
          ref: String(ref || '')
        };
        cache.put(key, JSON.stringify(record), OTP_TTL_SECONDS);
        var sent = _otpSendEmail_(email, code);
        if (!sent || !sent.ok) {
          cache.remove(key);
          var errMsg = (sent && sent.error) ? sent.error : 'Неуспешно изпращане на код за потвърждение.';
          return { success: false, error: errMsg };
        }
        // ── Increment the global window counter only on a real successful send ──
        globalRec.count = (globalRec.count || 0) + 1;
        var remWin = Math.max(30, OTP_GLOBAL_WINDOW_S - Math.floor((now - globalRec.windowStart) / 1000));
        try { cache.put(globalKey, JSON.stringify(globalRec), remWin); } catch (_) {}
        console.info('_otpIssue_: code issued for ' + email + ' scope=' + scope + ' ref=' + ref + ' (attempt=' + sent.attempt + ', windowCount=' + globalRec.count + '/' + OTP_GLOBAL_MAX_SENDS + ')');
        return { success: true, codeSent: true, expiresIn: OTP_TTL_SECONDS, cooldown: OTP_RESEND_COOLDOWN_S, ref: ref };
      }

      /**
       * Verify a submitted code. On success, the cache entry is consumed.
       * Returns { success, error?, attemptsLeft? }.
       */
      function _otpVerify_(scope, email, ref, code) {
        email = String(email || '').toLowerCase().trim();
        code = String(code || '').replace(/[^0-9]/g, '');
        if (!email) return { success: false, error: 'Липсва имейл.' };
        if (code.length !== 6) return { success: false, error: 'Кодът трябва да е 6 цифри.' };
        var cache = _scriptCache_();
        var key = _otpKey_(scope, email, ref);
        var raw = cache.get(key);
        if (!raw) return { success: false, error: 'Кодът е изтекъл или не съществува. Поискайте нов.', expired: true };
        var rec;
        try { rec = JSON.parse(raw); } catch (_) { cache.remove(key); return { success: false, error: 'Повреден запис на код.' }; }
        if (rec.attempts >= OTP_MAX_ATTEMPTS) {
          cache.remove(key);
          return { success: false, error: 'Превишен брой опити. Поискайте нов код.', locked: true };
        }
        var hashTry = _otpHash_(code, rec.salt);
        if (hashTry !== rec.hash) {
          rec.attempts = (rec.attempts || 0) + 1;
          // re-store with remaining TTL approximation (cache resets TTL — acceptable trade-off)
          var elapsed = Math.floor((Date.now() - rec.issuedAt) / 1000);
          var ttlLeft = Math.max(10, OTP_TTL_SECONDS - elapsed);
          cache.put(key, JSON.stringify(rec), ttlLeft);
          return { success: false, error: 'Грешен код.', attemptsLeft: OTP_MAX_ATTEMPTS - rec.attempts };
        }
        // Success — consume
        cache.remove(key);
        try { logTransaction('LOGIN_2FA', String(scope || 'default'), email, { ref: String(ref || ''), ok: true }); } catch (_) {}
        return { success: true };
      }

      // ============================================================
      //  2FA — Email-only (Google-style "G-XXXXXX" verification code)
      //  No authenticator apps. Every protected action issues a fresh
      //  6-digit numeric code by email and verifies it. Codes expire
      //  in 5 minutes and allow up to 5 attempts.
      // ============================================================

      /**
       * Issue an email OTP for the given (scope, email, ref).
       * Returns: { success, mode:'email', codeSent, expiresIn, cooldown, throttled?, error? }
       */
      function _2faIssue_(scope, email, ref) {
        var r = _otpIssue_(scope, email, ref);
        if (r) r.mode = 'email';
        return r;
      }

      /**
       * Verify an email OTP. Returns { success, mode:'email', error?, attemptsLeft? }.
       */
      function _2faVerify_(scope, email, ref, code) {
        var r = _otpVerify_(scope, email, ref, code);
        if (r) r.mode = 'email';
        return r;
      }

      /**
       * Public API endpoint: issue a 2FA email code.
       * Body: { scope, email|userId, ref }.
       */
      function initiate2fa(body) {
        body = body || {};
        var auth = {};
        try { auth = resolveAuthContext(body) || {}; } catch (_) { auth = {}; }
        var email = String(body.email || body.userId || auth.userId || '').toLowerCase().trim();
        var scope = String(body.scope || 'submitform').toLowerCase().trim();
        var ref   = String(body.ref || body.id || '').trim();
        if (!email) return { success: false, error: 'Липсва имейл за изпращане на код.' };
        if (email.indexOf('@') < 1) return { success: false, error: 'Невалиден имейл за изпращане на код.' };
        return _2faIssue_(scope, email, ref);
      }

      /**
       * Public API endpoint: verify a 2FA email code.
       * Body: { scope, email|userId, ref, code|otpCode }.
       */
      function verify2fa(body) {
        body = body || {};
        var auth = {};
        try { auth = resolveAuthContext(body) || {}; } catch (_) { auth = {}; }
        var email = String(body.email || body.userId || auth.userId || '').toLowerCase().trim();
        var scope = String(body.scope || 'signature').toLowerCase().trim();
        var ref   = String(body.ref || body.id || '').trim();
        var code  = String(body.code || body.otpCode || body.otp || '').trim();
        if (!email) return { success: false, error: 'Липсва имейл.' };
        return _2faVerify_(scope, email, ref, code);
      }

      /**
       * Public API endpoint: report 2FA status (always email-mode in this build).
       */
      function get2faStatus(body) {
        body = body || {};
        var auth = {};
        try { auth = resolveAuthContext(body) || {}; } catch (_) { auth = {}; }
        var email = String(body.email || body.userId || auth.userId || '').toLowerCase().trim();
        return {
          success: true,
          enabled: !!email,        // email-OTP is always-on for any authenticated email
          mode: 'email',
          channel: 'email',
          email: email,
          message: 'Двуфакторното удостоверяване по имейл е активно за всички чувствителни действия.'
        };
      }

      /**
       * Diagnostic endpoint: directly attempts to send a test 2FA email and
       * reports back exactly what happened (quota, attempt that succeeded,
       * raw error). Use to debug why codes are not arriving.
       * Body: { email|userId }.
       */
      function test2faEmail(body) {
        body = body || {};
        var auth = resolveAuthContext(body);
        var email = String(body.email || body.userId || auth.userId || '').toLowerCase().trim();
        if (!email) return { success: false, error: 'Липсва имейл.' };
        var diag = {
          email: email,
          scriptUser: '',
          effectiveUser: '',
          remainingQuota: -1,
          sendResult: null,
          timestamp: nowISO()
        };
        try { diag.scriptUser = (Session.getActiveUser() && Session.getActiveUser().getEmail()) || ''; } catch (_) {}
        try { diag.effectiveUser = (Session.getEffectiveUser() && Session.getEffectiveUser().getEmail()) || ''; } catch (_) {}
        try { diag.remainingQuota = MailApp.getRemainingDailyQuota(); }
        catch (qErr) { diag.quotaError = qErr.message; }
        var code = _otpGenerateCode_();
        diag.testCode = code;
        var sent = _otpSendEmail_(email, code);
        diag.sendResult = sent;
        return Object.assign({ success: !!(sent && sent.ok) }, diag);
      }

      // ── DEV KILL-SWITCH (mutable runtime cache) ──────────────────────
      // Cached at parse time + updated when admin toggles via setSystemNotificationSettings.
      // Prevents repeated _scriptProps_().getProperty() calls across the request lifecycle.
      var _devAdminEmailsDisabled = true; // safe default until loaded
      var DEV_DISABLE_ADMIN_EMAILS = (function() {
        try {
          var v = _scriptProps_().getProperty('DEV_DISABLE_ADMIN_EMAILS');
          if (v === 'false' || v === '0') { _devAdminEmailsDisabled = false; return false; }
          if (v === 'true'  || v === '1') { _devAdminEmailsDisabled = true; return true; }
        } catch (_) {}
        _devAdminEmailsDisabled = true;
        return true; // safe default: suppress admin emails until explicitly turned off
      })();

      // ── Per-recipient email suppression ──────────────────────────
      // Temporarily suppress ALL notifications (applicant, reviewer,
      // leader, OTP, status-change, etc.) to the listed addresses.
      // Logged so the suppression is visible in GAS execution logs.
      // Remove the entry to resume normal delivery.
      var _EMAIL_SUPPRESS_LIST_ = [
        // Add emails here to suppress all notifications to them during dev
      ];
      function _isSuppressedRecipient_(email) {
        if (!email || !_EMAIL_SUPPRESS_LIST_.length) return false;
        var lc = String(email).trim().toLowerCase();
        for (var i = 0; i < _EMAIL_SUPPRESS_LIST_.length; i++) {
          if (String(_EMAIL_SUPPRESS_LIST_[i]).trim().toLowerCase() === lc) return true;
        }
        return false;
      }

      function _isAdminRecipient_(email) {
        if (!email) return false;
        try { loadAdminCredentials_(); } catch (_) {}
        var lc = String(email).trim().toLowerCase();
        var list = (typeof _ADMIN_EMAILS_SERVER !== 'undefined' && _ADMIN_EMAILS_SERVER)
          ? _ADMIN_EMAILS_SERVER
          : (typeof ADMIN_EMAILS_SERVER !== 'undefined' ? ADMIN_EMAILS_SERVER : []);
        for (var i = 0; i < list.length; i++) {
          if (String(list[i]).trim().toLowerCase() === lc) return true;
        }
        return false;
      }

      function notifyApplicant_(recipientEmail, subject, htmlBody, notifyType) {
        if (!recipientEmail) {
          console.warn('notifyApplicant_: no recipientEmail provided');
          try { logError('notifyApplicant_', new Error('No recipient email provided'), { subject: subject }); } catch (_) {}
          return { ok: false, reason: 'Липсва имейл адрес на получателя.' };
        }
        if (!isValidEmail(recipientEmail)) {
          console.warn('notifyApplicant_: invalid email: ' + recipientEmail);
          try { logError('notifyApplicant_', new Error('Invalid email address'), { to: recipientEmail, subject: subject }); } catch (_) {}
          return { ok: false, reason: 'Невалиден имейл адрес: ' + recipientEmail };
        }
        // ── v6.9.0: Check notification preferences ──
        // User can opt-out of this type of notification. Admin system-wide
        // blocks also checked. OTP notifications always deliver regardless.
        var notifyTypeStr = String(notifyType || '');
        if (notifyTypeStr && notifyTypeStr !== 'otp') {
          if (!_shouldSendNotification_(recipientEmail, notifyTypeStr)) {
            console.info('notifyApplicant_: [PREF] suppressed by user/system preference — ' + recipientEmail + ' | type: ' + notifyTypeStr + ' | subject: ' + subject);
            return { ok: false, reason: 'Получателят е изключил този тип известия.' };
          }
        }
        // Per-recipient suppression: silently drop ALL notifications to
        // addresses in _EMAIL_SUPPRESS_LIST_.
        if (_isSuppressedRecipient_(recipientEmail)) {
          console.info('notifyApplicant_: [SUPPRESS] recipient in suppression list -> ' + recipientEmail + ' | subject: ' + subject);
          return { ok: false, reason: 'Получателят е в списъка за потискане на известия.' };
        }
        // DEV: the admin-email kill-switch ONLY blocks emails TO admin recipients.
        // Regular applicant/candidate emails are NEVER blocked by this flag.
        if (DEV_DISABLE_ADMIN_EMAILS && _isAdminRecipient_(recipientEmail)) {
          console.info('notifyApplicant_: [DEV] admin email suppressed -> ' + recipientEmail + ' | subject: ' + subject);
          return { ok: false, reason: 'DEV режим: известията до администратори са спрени.' };
        }
        try {
          var quota = MailApp.getRemainingDailyQuota();
          if (quota <= 0) {
            console.error('notifyApplicant_: MailApp daily quota exhausted');
            try { logError('notifyApplicant_', new Error('Daily email quota exhausted (remaining: ' + quota + ')'), { to: recipientEmail, subject: subject }); } catch (_) {}
            return { ok: false, reason: 'Дневната квота за имейли е изчерпана. Опитайте отново след полунощ.' };
          }
          // ── Inline SVG logos already embedded in the HTML template (v9.44.1) ──
          // No Drive blob fetching, no CID rewriting — the template IS the authority.
          var sendOpts = {
            to: recipientEmail,
            subject: subject,
            htmlBody: htmlBody,
            noReply: true,
            name: 'ERP Научни проекти – ИУ Варна',
            replyTo: 'science@ue-varna.bg'
          };
          MailApp.sendEmail(sendOpts);
          console.info('notifyApplicant_: email sent to ' + recipientEmail + ' | subject: ' + subject + ' | quota remaining: ' + (quota - 1));
          return { ok: true, reason: '' };
        } catch (err) {
          console.error('notifyApplicant_: FAILED for ' + recipientEmail + ' – ' + err.message);
          try { logError('notifyApplicant_', err, { to: recipientEmail, subject: subject }); } catch (_) {}
          return { ok: false, reason: 'Грешка при изпращане: ' + (err.message || 'неизвестна') };
        }
      }

      // ── Official portal URL (CTA target on every branded email) ─────────
      var BRAND_PORTAL_URL = 'https://scienceandresearch.ue-varna.bg/nauchni-proekti/';
      // Brand palette — mirrors styles.css :root
      //   --brand-gradient: linear-gradient(180deg,#2A4490 0%,#233874 55%,#1B2C5C 100%)
      //   --brand-teal:#159379  (accent / underline / button mid-color)
      var BRAND_PRIMARY_0  = '#2A4490';
      var BRAND_PRIMARY    = '#233874';
      var BRAND_PRIMARY_2  = '#1B2C5C';
      var BRAND_TEAL       = '#159379';
      var BRAND_TEAL_DEEP  = '#0F7E66';
      // Backwards-compat alias — the old code called the teal accent "GOLD".
      var BRAND_GOLD       = BRAND_TEAL;

      // Status badge palette — shared visual language across ALL system emails.
      // Renders a colored pill inside the email body so every recipient sees the
      // current project/workflow state with the same visual cue used in the UI.
      var _STATUS_BADGE_MAP_ = {
        'draft':        { label: '🟡 Чернова',                bg: '#FFF7E6', fg: '#8A5A00', border: '#F4C36B' },
        'submitted':    { label: '📨 Подадено',               bg: '#E8F0FE', fg: '#1A3A8F', border: '#A8C0F2' },
        'under_review': { label: '🔍 Под преглед',            bg: '#E3F2FD', fg: '#0B3D7A', border: '#90C7F5' },
        'in_review':    { label: '🔍 Под преглед',            bg: '#E3F2FD', fg: '#0B3D7A', border: '#90C7F5' },
        'returned':     { label: '↩️ Върнато за корекция',    bg: '#FFEBEE', fg: '#9B1B1B', border: '#F2A0A0' },
        'rejected':     { label: '❌ Отхвърлено',             bg: '#FCE4EC', fg: '#8B0E2A', border: '#E596A8' },
        'approved':     { label: '✅ Одобрено',               bg: '#E6F4EA', fg: '#137333', border: '#82C99B' },
        'active':       { label: '🚀 В изпълнение',           bg: '#E8F5F2', fg: '#0B5040', border: '#86C9B5' },
        'completed':    { label: '🏁 Завършено',              bg: '#E0F2F1', fg: '#004D40', border: '#7DBBB5' },
        'cancelled':    { label: '🚫 Прекратено',             bg: '#ECEFF1', fg: '#37474F', border: '#B0BEC5' },
        'archived':     { label: '🗂️ Архивирано',             bg: '#F5F5F5', fg: '#555',    border: '#CCC' }
      };
      function _statusBadgeHtml_(statusKey) {
        if (!statusKey) return '';
        var sk = String(statusKey).toLowerCase().trim();
        var def = _STATUS_BADGE_MAP_[sk];
        if (!def) {
          // Unknown status — render as a neutral pill with the raw label
          def = { label: String(statusKey), bg: '#F5F5F5', fg: '#444', border: '#CCC' };
        }
        return '<div style="margin:0 0 14px"><span style="display:inline-block;padding:6px 14px;border-radius:999px;font-size:13px;font-weight:600;background:' +
               def.bg + ';color:' + def.fg + ';border:1px solid ' + def.border +
               ';letter-spacing:.2px;line-height:1.2">' + xmlEscape_(def.label) + '</span></div>';
      }

      function buildNotificationHtml_(heading, bodyLines, footerNote, opts) {
        opts = opts || {};
        var ctaLabel = opts.ctaLabel || 'Отвори портала';
        var ctaUrl   = opts.ctaUrl   || BRAND_PORTAL_URL;
        var preheader= opts.preheader|| (heading || '');
        var introHtml= opts.introHtml ? String(opts.introHtml) : '';
        var statusHtml = _statusBadgeHtml_(opts.status || '');

        var rows = (bodyLines || []).map(function(ln) {
          return '<tr>' +
            '<td style="padding:8px 14px 8px 0;color:#5f6368;font-size:13px;white-space:nowrap;vertical-align:top;border-bottom:1px solid #f1f1f1">' +
              xmlEscape_(ln.label || '') +
            '</td>' +
            '<td style="padding:8px 0;font-weight:600;color:#202124;font-size:14px;border-bottom:1px solid #f1f1f1;word-break:break-word">' +
              xmlEscape_(ln.value || '') +
            '</td></tr>';
        }).join('');

        var year = new Date().getFullYear();
        var portalHostLabel = 'scienceandresearch.ue-varna.bg';

        return '<!DOCTYPE html><html lang="bg"><head><meta charset="utf-8">' +
          '<meta name="viewport" content="width=device-width,initial-scale=1">' +
          '<title>' + xmlEscape_(heading || 'ERP Научни проекти') + '</title>' +
          '</head><body style="margin:0;padding:0;font-family:Segoe UI,Roboto,Helvetica,Arial,sans-serif;font-size:14px;color:#202124;background:#f7f8fc">' +
          // Preheader (hidden inbox preview)
          '<div style="display:none;font-size:1px;color:#f7f8fc;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden">' +
            xmlEscape_(preheader) +
          '</div>' +
          '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f7f8fc;padding:24px 12px">' +
            '<tr><td align="center">' +
              '<table role="presentation" width="640" cellpadding="0" cellspacing="0" border="0" style="max-width:640px;width:100%;background:#ffffff;border-radius:14px;overflow:hidden;box-shadow:0 4px 18px rgba(35,56,116,.10)">' +
                // ── HEADER (logo-free, institution name only) ──
                '<tr><td style="background:linear-gradient(180deg,' + BRAND_PRIMARY_0 + ' 0%,' + BRAND_PRIMARY + ' 55%,' + BRAND_PRIMARY_2 + ' 100%);padding:0;border-bottom:4px solid ' + BRAND_TEAL + '">' +
                  '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">' +
                    '<tr>' +
                      '<td align="center" valign="middle" style="padding:20px 24px;color:#ffffff">' +
                        '<div style="font-size:12px;letter-spacing:2px;text-transform:uppercase;opacity:.85">' + xmlEscape_(INSTITUTION.legalName_bg) + '</div>' +
                        '<div style="font-size:20px;font-weight:700;margin-top:5px">Научноизследователски институт</div>' +
                        '<div style="font-size:12px;opacity:.85;margin-top:3px">ERP Научни проекти</div>' +
                      '</td>' +
                    '</tr>' +
                  '</table>' +
                '</td></tr>' +
                // ── HEADING ──
                '<tr><td style="padding:28px 32px 8px 32px">' +
                  '<h1 style="margin:0;font-size:20px;line-height:1.35;color:' + BRAND_PRIMARY + ';font-weight:700">' + xmlEscape_(heading || '') + '</h1>' +
                '</td></tr>' +
                // ── STATUS BADGE (visual status pill, shared across ALL emails) ──
                (statusHtml ? '<tr><td style="padding:4px 32px 0 32px">' + statusHtml + '</td></tr>' : '') +
                // ── INTRO (optional) ──
                (introHtml ? '<tr><td style="padding:0 32px 12px 32px;color:#3c4043;font-size:14px;line-height:1.6">' + introHtml + '</td></tr>' : '') +
