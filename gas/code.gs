          // This runs BEFORE the handler map to guarantee these always work.
          if (action === 'editcompetition')      { return jsonResponse_(wrapPostResult_('editcompetition', editCompetition(body), body)); }
          if (action === 'createcompetition')     { return jsonResponse_(wrapPostResult_('createcompetition', createCompetition(body), body)); }
          if (action === 'deletecompetition')     { return jsonResponse_(wrapPostResult_('deletecompetition', deleteCompetition(body), body)); }
          if (action === 'archivecompetition')    { return jsonResponse_(wrapPostResult_('archivecompetition', archiveCompetition(body), body)); }
          if (action === 'repairallsheets')       { return jsonResponse_(wrapPostResult_('repairallsheets', repairAllSheets(body), body)); }
