      // ═══════════════════════════════════════════════════════════════════════
      //  v16.0.0-appconfig — GAS FALLBACK for app configuration
      //  Assembles ALL application config from existing GAS structures
      //  (PROJECT_TYPE_RULES, FORM_SCHEMAS, ALLOWED_STATUS_TRANSITIONS, etc.)
      //  Used when PHP/SQL layer is unavailable. Primary source is SQL.
      // ═══════════════════════════════════════════════════════════════════════
      function getAppConfig(body) {
        try {
          var config = {};

          // ── Code version ──
          config.code_version = CODE_VERSION;

          // ── Project types (from PROJECT_TYPE_RULES) ──
          config.project_types = [];
          var activeTypes = ['ФНИ','ПНИ','ДНП','НПФ'];
          for (var ti = 0; ti < activeTypes.length; ti++) {
            var code = activeTypes[ti];
            var rules = PROJECT_TYPE_RULES[code];
            if (!rules) continue;
            var pt = {
              code: code,
              label: rules.label || code,
              max_budget_eur: rules.maxBudgetEUR || 0,
              min_duration_months: rules.minDurationMonths || 12,
              max_duration_months: rules.maxDurationMonths || 36,
              max_team_members: rules.maxTeamMembers || 5,
              max_student_collaborators: rules.maxStudentCollaborators || 3,
              reviewer_fee_eur: rules.reviewerFeeEUR || null,
              annual_report_reviewer_fee_eur: rules.annualReportReviewerFeeEUR || null,
              monograph_reviewer_fee_eur: rules.monographReviewerFeeEUR || null,
              monograph_per_review_fee_eur: rules.monographPerReviewFeeEUR || null,
              requires_trl: !!rules.requiresTRL,
              requires_support_letters: !!rules.requiresSupportLetters,
              requires_self_assessment: !!rules.requiresSelfAssessment,
              no_expenses_first_month: !!rules.noExpensesFirstMonth,
              no_team_remuneration: !!rules.noTeamRemuneration,
            };
            // Expense limits
            pt.expense_limits = [];
            if (rules.expenseLimits) {
              var limitKeys = Object.keys(rules.expenseLimits);
              for (var li = 0; li < limitKeys.length; li++) {
                pt.expense_limits.push({
                  limit_key: limitKeys[li],
                  max_value: rules.expenseLimits[limitKeys[li]],
                });
              }
            }
            // Form sections + fields (from FORM_SCHEMAS)
            pt.sections = [];
            var schema = FORM_SCHEMAS[code];
            if (schema && schema.sections) {
              for (var si = 0; si < schema.sections.length; si++) {
                var sec = schema.sections[si];
                var section = {
                  section_id: sec.id,
                  label_bg: sec.label,
                  sort_order: si + 1,
                  required: !!sec.required,
                  max_items: sec.maxItems || null,
                  fields: []
                };
                if (sec.fields) {
                  for (var fi = 0; fi < sec.fields.length; fi++) {
                    section.fields.push({
                      field_id: sec.fields[fi],
                      required: true // GAS schema marks all listed fields as required
                    });
                  }
                }
                pt.sections.push(section);
              }
            }
            // Flags
            pt.flags = {};
            if (schema && schema.rules) {
              var ruleKeys = Object.keys(schema.rules);
              for (var ri = 0; ri < ruleKeys.length; ri++) {
                var rk = ruleKeys[ri];
                if (rk === 'budgetCategoryLimits') continue;
                pt.flags[rk] = !!schema.rules[rk];
              }
            }
            // Required documents (from REQUIRED_DOCUMENTS_BY_TYPE)
            pt.required_documents = [];
            var reqDocs = REQUIRED_DOCUMENTS_BY_TYPE[code];
            if (reqDocs) {
              for (var di = 0; di < reqDocs.length; di++) {
                pt.required_documents.push({
                  doc_key: reqDocs[di],
                  name: _DOC_LABELS_[reqDocs[di]] || reqDocs[di]
                });
              }
            }
            // NPF tiers
            if (code === 'НПФ' && rules.npfTiers) {
              pt.npf_tiers = [];
              var tierKeys = Object.keys(rules.npfTiers);
              for (var ti2 = 0; ti2 < tierKeys.length; ti2++) {
                var tk = tierKeys[ti2];
                pt.npf_tiers.push({
                  tier_code: tk,
                  label_bg: rules.npfTiers[tk].label,
                  max_budget_eur: rules.npfTiers[tk].maxEUR
                });
              }
            }
            config.project_types.push(pt);
          }

          // ── Status transitions (from ALLOWED_STATUS_TRANSITIONS) ──
          config.status_transitions = {};
          var stKeys = Object.keys(ALLOWED_STATUS_TRANSITIONS);
          for (var ski = 0; ski < stKeys.length; ski++) {
            var fromSt = stKeys[ski];
            var toList = ALLOWED_STATUS_TRANSITIONS[fromSt];
            if (!config.status_transitions.application) config.status_transitions.application = {};
            config.status_transitions.application[fromSt] = [];
            for (var tli = 0; tli < toList.length; tli++) {
              config.status_transitions.application[fromSt].push({
                to_status: toList[tli]
              });
            }
          }

          // ── Application statuses (from all unique status codes in transitions) ──
          config.application_statuses = [];
          var seen = {};
          for (var ski2 = 0; ski2 < stKeys.length; ski2++) {
            if (!seen[stKeys[ski2]]) {
              seen[stKeys[ski2]] = true;
              config.application_statuses.push({
                status_code: stKeys[ski2],
                label_bg: stKeys[ski2]
              });
            }
            var arr = ALLOWED_STATUS_TRANSITIONS[stKeys[ski2]];
            for (var tli2 = 0; tli2 < arr.length; tli2++) {
              if (!seen[arr[tli2]]) {
                seen[arr[tli2]] = true;
                config.application_statuses.push({
                  status_code: arr[tli2],
                  label_bg: arr[tli2]
                });
              }
            }
          }

          // ── Priority areas (from PRIORITY_AREAS) ──
          config.priority_areas = [];
          for (var pai = 0; pai < PRIORITY_AREAS.length; pai++) {
            config.priority_areas.push({ name_bg: PRIORITY_AREAS[pai] });
          }

          // ── Labels (from _DOC_LABELS_) ──
          config.labels = {};
          var docLabelKeys = Object.keys(_DOC_LABELS_);
          for (var dli = 0; dli < docLabelKeys.length; dli++) {
            config.labels['doc.' + docLabelKeys[dli]] = _DOC_LABELS_[docLabelKeys[dli]];
          }

          // ── Institution (from INSTITUTION constant) ──
          config.institution = {};
          var instKeys = Object.keys(INSTITUTION);
          for (var iii = 0; iii < instKeys.length; iii++) {
            config.institution['INSTITUTION_' + instKeys[iii].toUpperCase()] = INSTITUTION[instKeys[iii]];
          }

          return { success: true, config: config, _source: 'gas' };
        } catch (err) {
          try { logError('getAppConfig', err, body); } catch (_) {}
          return { success: false, error: 'getAppConfig failed: ' + err.message };
        }
      }

      // ── Per-execution competition memo ────────────────────────────────────
      // getCompetitionById_ is called 14+ times per execution (eligibility
      // loops, sanction checks, ranking, notifications, contract generation,
      // reviewer assignment, etc.). Each call walked the full competitions
      // array. The memo gives O(1) lookup for repeat IDs within one execution.
      // Busted by forceRefresh and by _bustCompMemo_ (called from every
      // competition invalidation path).
      var _competitionMemo_ = {};
      function _bustCompMemo_() { _competitionMemo_ = {}; }
      function getCompetitionById_(competitionId, forceRefresh) {
        var id = String(competitionId || '').trim();
        if (!id) return null;
        if (forceRefresh) { _bustCompMemo_(); }
        if (_competitionMemo_[id]) return _competitionMemo_[id];
        var source = getOrCacheCompetitions(!!forceRefresh);
        for (var i = 0; i < source.length; i++) {
          var c = source[i] || {};
          if (String(c.id || '').trim() !== id) continue;
          var result = {
            id: id,
            name: String(c.name || ''),
            deadline: String(c.deadline || c.dateEnd || ''),
            dateEnd: String(c.dateEnd || c.deadline || ''),
            status: normalizeCompetitionStatus_(c.status),
            created: String(c.created || ''),
            description: String(c.description || '')
          };
          _competitionMemo_[id] = result;
          return result;
        }
        _competitionMemo_[id] = null; // negative cache: "not found"
        return null;
      }

      function canSelectCompetition_(competitionId, authCtx, forceRefresh) {
        var comp = getCompetitionById_(competitionId, forceRefresh);
        if (!comp) return false;
        if (authCtx && authCtx.isAdmin) return true;
        return shouldExposeCompetitionToApplicant_(comp);
      }

      // ============================================================
      //  ROW COLOR HELPER
      //  PERF_MODE: skipped — purely cosmetic. setBackground on a row of
      //  TOTAL_COLS cells costs ~80–250ms per write and is invoked on every
      //  status change. Removing it from the hot path makes status updates
      //  feel instant. Derived-sheet sync (Табло) still reflects status.
      // ============================================================
      function applyRowColor(sheet, rowIndex, status) {
        if (PERF_MODE) return;
        var color;
        switch (String(status || '').toLowerCase()) {
          case 'submitted': color = '#FFFDE7'; break;
          case 'approved':  color = '#E8F5E9'; break;
          case 'rejected':  color = '#FFEBEE'; break;
          case 'returned':  color = '#FFF3E0'; break;
          default:          color = '#FFFFFF'; break;
        }
        sheet.getRange(rowIndex, 1, 1, TOTAL_COLS).setBackground(color);
      }

      // ============================================================
      //  ROUTING
      // ============================================================

      // ── Phase 5: idempotency cache for write actions ──
      // The frontend attaches a unique `_idemKey` to every write request and reuses
      // it on transient-failure retries. We cache the successful result here for
      // ~5 minutes so a retried call returns the original outcome instead of
      // executing the write twice (which would create duplicate sheet rows / Drive
      // files when a network drop hides a successful response from the client).
      var _IDEM_CACHE_TTL_S = 1200; // 20 minutes (extended for perf — version-keyed, safe)
      var _IDEM_CACHE_PREFIX = 'idem:';
      function _idemCacheGet_(key) {
        if (!key) return null;
        try {
          var raw = _scriptCache_().get(_IDEM_CACHE_PREFIX + key);
          if (!raw) return null;
          return JSON.parse(raw);
        } catch (_) { return null; }
      }
      function _idemCachePut_(key, result) {
        if (!key || !result || result.success !== true) return;
        try {
          var s = JSON.stringify(result);
          // CacheService limit is 100KB per value — skip oversized payloads
          if (s.length > 95 * 1024) return;
          _scriptCache_().put(_IDEM_CACHE_PREFIX + key, s, _IDEM_CACHE_TTL_S);
        } catch (_) {}
      }
      function _idemKeyFromBody_(body) {
        var k = body && body._idemKey;
        return (typeof k === 'string' && k.length > 0 && k.length <= 128) ? k : '';
      }

      /**
       * gasApiCall — called by the frontend via google.script.run.
       * Accepts a JSON string, dispatches exactly like doPost, returns a plain object.
       * This bypasses the /exec URL entirely so deployment-URL mismatches cannot happen.
       */
      function gasApiCall(jsonString) {
        try {
          var body = typeof jsonString === 'string' ? JSON.parse(jsonString) : (jsonString || {});
          var rawAction = resolveRequestAction_(body);
          var action = normalizeAction_(rawAction);

          // Phase 5: idempotent retry — return cached successful write result if any
          var _idemK = _idemKeyFromBody_(body);
          if (_idemK && !_BATCH_READ_ACTIONS[action]) {
            var _cachedIdem = _idemCacheGet_(_idemK);
            if (_cachedIdem) return _cachedIdem;
          }

          // Priority inline dispatch
          if (action === 'editcompetition')   return wrapPostResult_('editcompetition', editCompetition(body), body);
          if (action === 'createcompetition') return wrapPostResult_('createcompetition', createCompetition(body), body);
          if (action === 'deletecompetition') return wrapPostResult_('deletecompetition', deleteCompetition(body), body);
          if (action === 'archivecompetition')return wrapPostResult_('archivecompetition', archiveCompetition(body), body);
          if (action === 'repairallsheets')   return wrapPostResult_('repairallsheets', repairAllSheets(body), body);
          if (action === 'getversion')        return { success: true, version: CODE_VERSION, handlers: Object.keys(getApiActionHandlers_()).length };
          if (action === 'ping')               return _handlePing_(body);

          var result = executeApiAction_(action, body, { readOnlyOnly: false });
          if (result === null) {
            try { result = fallbackDispatch_(action, body); } catch (fb) {
              result = { success: false, error: 'Dispatch error (' + action + '): ' + fb.message };
            }
          }
          if (result === null) {
            result = buildUnknownActionResult_(action, rawAction, body);
            logError('unknown_action', new Error('Unknown action: ' + action + ' [gasApiCall]'), body);
          }
          try { if (result && result.success === true) postProcessMutation_(action); } catch (_) {}
          if (_idemK && !_BATCH_READ_ACTIONS[action]) _idemCachePut_(_idemK, result);
          return result;
        } catch (err) {
          return { success: false, error: err.message || 'gasApiCall error' };
        }
      }

      // ── Batch API – combine multiple read requests in a single round-trip ──
      // Accepts { requests: [ { action, ...params }, ... ] }
      // Only READ actions are permitted (no mutations) to prevent side-effects.
      // v12.18.0: Expanded whitelist — added pagination, metrics, and MON-report reads
      var _BATCH_READ_ACTIONS = {
        getforms:1, getcompetitions:1, getpubliccompetitions:1, getcompetitionsfeed:1,
        getcompetitionsummary:1, listdocuments:1, getdocumentssummary:1, getreviewers:1, getreviewerforms:1, getreviewerbudgetsummary:1,
        checkadmin:1, getsystemhealth:1, getcontestboard:1, getversion:1,
        getsecretmanagerstatus:1,
        getcalendarevents:1, getdatachangestream:1, geterrorlog:1,
        getapplicationsbycompetition:1, getsigneddocuments:1,
        getinitialdata:1, getdocumentssummary:1,
        // New module read actions
        getprojects:1, getproject:1, getreports:1, getreport:1,
        getchangerequests:1, checksanctions:1, checkeligibility:1,
        getexpenses:1, getfinancialsummary:1, getdeliverables:1,
        getreportdeadlines:1, generatemonreport:1, validateprojectresults:1,
        getprojectdashboard:1, getboarddata:1,
        // Library management reads
        listlibraryfolders:1, ping:1,
        // v12.18.0: Pagination + metrics
        loadmoreforms:1, loadmorecompetitions:1, getmetricsdashboard:1,
        // v12.18.0: Additional read actions for batch support
        getuserpreferences:1, getnotificationsettings:1, getnotificationlog:1,
        getadminnotifications:1, getmyactivitylog:1, getmynotifications:1,
        getpublicresults:1, getreviewdeadlines:1, getcontractdeadlines:1,
        getcompetitionpanel:1, getdashboardcontext:1, getapplicationversions:1,
        getmonreports:1, getmonreport:1, getmonreporthistory:1,
        listmydocuments:1, listdriveassets:1, listallattachments:1,
        listckkmembers:1, listparticipants:1, getselfassessment:1,
        getdataversion:1, getreviewerproposals:1, getapplicationversions:1,
        checkcompliance:1, getcomplianceaudit:1, auditverifychain:1,
        gdpraccess:1, gdprexport:1, getprivacypolicy:1,
        // v12.28.2-404fix: Required templates — stable read
        getrequiredapplicationtemplates:1,
        // ── v8 docSQL: Instant document reads (batch-safe) ──
        getapplicationdocuments:1, getformdocuments:1,
        getdocumentsbyfolder:1, getdocumenturl:1,
        searchdocuments:1,

        // v12.41.2: New batch-safe read actions
        gethttpcheck:1, httpcheck:1, getversioninfo:1,
        listapihandlers:1, verifyconfiguration:1
      };
      function batchApi(body) {
        try {
          var requests = body && body.requests;
          if (!Array.isArray(requests) || requests.length === 0) {
            return { success: false, error: 'batchApi requires a non-empty requests array' };
          }
          if (requests.length > 10) {
            return { success: false, error: 'batchApi supports at most 10 requests per call' };
          }
          var results = [];
          var batchTiming = { start: _perfStart_('batch'), items: [] };
          for (var i = 0; i < requests.length; i++) {
            var req = requests[i] || {};
            var rawAction = String(req.action || '').trim();
            var action = normalizeAction_(rawAction);
            // Only allow read-only actions in batch
            if (!_BATCH_READ_ACTIONS[action]) {
              results.push({ success: false, error: 'Action "' + rawAction + '" is not permitted in batch (read-only actions only)' });
              continue;
            }
            try {
              var itemStart = new Date().getTime();
              var result = executeApiAction_(action, req, { readOnlyOnly: true });
              var itemDuration = new Date().getTime() - itemStart;
              if (result === null) {
                result = { success: false, error: 'Unknown action: ' + rawAction };
              }
              // v12.17.2: Include per-item timing
              if (typeof result === 'object' && result !== null) {
                result._itemTiming = { action: action, ms: itemDuration };
              }
              results.push(result);
              batchTiming.items.push({ action: action, ms: itemDuration });
            } catch (err) {
              results.push({ success: false, error: err.message || 'batch item error' });
            }
          }
          var resp = { success: true, results: results };
          // v12.17.2: Include batch-level timing for monitoring
          resp._batchTiming = batchTiming;
          return resp;
        } catch (err) {
          return { success: false, error: 'batchApi error: ' + err.message };
        }
      }

      // ============================================================
      //  INSTANT-LOAD: getInitialData
      //  Returns forms + competitions + documents in ONE execution so
      //  the frontend only needs a single round-trip on login instead
      //  of three separate GAS calls (3× cold-start avoided).
      // ============================================================
      function getInitialData(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          var isAdmin = auth.isAdmin;
          var userId = auth.userId;
          // Conditional fetch: if the client knows the current data versions and
