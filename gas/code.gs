/**
 * Initialize webhook token for Laravel integration.
 * Run once after deploy: setupWebhook('your-secret-token')
 * The token must match GAS_WEBHOOK_TOKEN in Laravel .env.
 */
function setupWebhook(token) {
  if (!token || typeof token !== 'string') {
    return { success: false, error: 'Token required' };
  }
  _scriptProps_().setProperty('WEBHOOK_TOKEN', token);
  return { success: true, message: 'Webhook token configured' };
}

/**
 * Set up hourly trigger for automated tasks.
 * Run once after deploy: setupAutomatedTriggers()
 * Triggers runAutomatedTasks() every hour.
 */
function setupAutomatedTriggers() {
  var triggers = ScriptApp.getProjectTriggers();
  for (var i = 0; i < triggers.length; i++) {
    if (triggers[i].getHandlerFunction() === 'runAutomatedTasks') {
      ScriptApp.deleteTrigger(triggers[i]);
    }
  }

  ScriptApp.newTrigger('runAutomatedTasks')
    .timeBased()
    .everyHours(1)
    .create();

  return { success: true, message: 'Hourly trigger created' };
}

/**
 * Main automated tasks runner (called by hourly trigger).
 * Closes expired competitions and processes the sync queue.
 */
function runAutomatedTasks() {
  try {
    _closeExpiredCompetitions_();
  } catch (e) { logError('auto_close_expired', e); }

  try {
    _processSyncQueue_();
  } catch (e) { logError('auto_process_queue', e); }

  try {
    var props = _scriptProps_().getProperties();
    props.LAST_QUEUE_PROCESS = nowISO();
    _scriptProps_().setProperties(props);
  } catch (_) {}

  return { success: true };
}

/**
 * Helper: ensure Drive folder exists for competition.
 */
function _ensureCompetitionFolder_(compId, compName) {
  try {
    var root = getOrCreateSessionRootFolder_();
    if (!root) return null;

    var folderName = compId + ' — ' + (compName || 'Competition');
    var existing = root.getFoldersByName(folderName);
    if (existing.hasNext()) return existing.next().getId();

    var folder = root.createFolder(folderName);
    return folder.getId();
  } catch (_) {
    return null;
  }
}

/**
 * Helper: invalidate competitions cache by bumping cache version.
 */
function _invalidateCompetitionsCache_() {
  try {
    _scriptProps_().setProperty('CACHE_VERSION', String(Date.now()));
  } catch (_) {}
}

