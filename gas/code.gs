              fastOk = documents.length > 0;
            }
          } catch (e) {
            console.warn('listDocuments fast path failed, falling back to DriveApp: ' + e.message);
            fastOk = false;
          }

          if (!fastOk) {
            try {
              var officialFolder = DriveApp.getFolderById(OFFICIAL_DOCS_FOLDER_ID);
              scanFolderRecursive(officialFolder, officialFolder.getName(), documents, seenIds);
            } catch (e) { console.warn('Official docs error: ' + e.message); }

            if (isAdmin) {
              try {
                var mainFolder = DriveApp.getFolderById(DRIVE_FOLDER_ID);
                collectFilesTopLevel(mainFolder, mainFolder.getName(), documents, seenIds);
              } catch (e) { console.warn('Main folder error: ' + e.message); }
            }
          }

          // ── Non-admin filter: only expose ФНИ/ПНИ/ДНП/НПФ category documents ──
          // Applicants & reviewers should only see documents relevant to their
          // project-type proposals, not internal admin documents (Нормативни,
          // Шаблони, Насоки, Критерии, etc.).  Admin users see everything.
          // Uses the same matching logic as the frontend getDocCategory():
          //  1. folderName contains a canonical category code (case-insensitive)
          //  2. filename contains a canonical category code (case-insensitive)
          if (!isAdmin) {
            var _ALLOWED_CATS = ['ФНИ', 'ПНИ', 'ДНП', 'НПФ'];
            documents = documents.filter(function (d) {
              var fn = String(d.folderName || '').toUpperCase().trim();
              var nm = String(d.name || '').toUpperCase();
              for (var ci = 0; ci < _ALLOWED_CATS.length; ci++) {
                var cat = _ALLOWED_CATS[ci];
                // folderName contains the category (e.g. "ФНИ", "ФНИ 2026", "ФНИ/Шаблони")
                if (fn.indexOf(cat) !== -1) return true;
                // filename contains the category (e.g. "ФНИ_формуляр.docx")
                if (nm.indexOf(cat) !== -1) return true;
              }
              return false;
            });
          }

          // Ensure canonical subfolders exist in Drive (idempotent)
          try { _ensureLibrarySubfolders_(); } catch (_) {}

          // Cache for 6 hours; version-bumps invalidate immediately. Skip if > 95 KB.
          if (cacheKey && sc) {
            try {
              var json = JSON.stringify(documents);
              if (json.length < 95000) sc.put(cacheKey, json, 21600);
              // L1: also persist to shadow so cold-cache hits stay sub-second.
              try { _shadowCacheSave_('ds:', (isAdmin ? 'a' : 'p'), getDataVersions_().system, json); } catch (_) {}
            } catch (e) { console.warn('Doc cache write: ' + e.message); }
          }

          // Per-execution memo: subsequent listDocuments calls in the same
          // execution return instantly. Cleared by upload/delete handlers.
          _listDocsMemo_ = { key: _exeKey, result: { success: true, documents: documents } };

          return { success: true, documents: documents };
        } catch (err) {
          return { success: false, error: 'listDocuments failed: ' + err.message, documents: [] };
        }
      }

      /**
       * Fast bulk Drive listing using the Advanced Drive Service.
       * Issues ONE Drive.Files.list call per page (1000 items) and ONE per
       * subfolder (only when recurse=true). All metadata (id/name/mimeType/
       * size/createdDate/modifiedDate/parents) is returned in the same call,
       * eliminating the per-file getter round-trips that DriveApp incurs.
       */
      function _listDocsFast_(rootFolderId, documents, seenIds, recurse) {
        if (!rootFolderId) return;
        var folderQueue = [{ id: rootFolderId, label: '' }];
        try {
          var rootMeta = Drive.Files.get(rootFolderId, { fields: 'id,name' });
          folderQueue[0].label = (rootMeta && rootMeta.name) || 'Общи';
        } catch (_) {
          try {
            var rootMeta2 = Drive.Files.get(rootFolderId, { fields: 'id,title' });
            folderQueue[0].label = (rootMeta2 && rootMeta2.title) || 'Общи';
          } catch (__) { folderQueue[0].label = 'Общи'; }
        }

        var docsSinceYield = 0;
        var YIELD_EVERY = 120;
        while (folderQueue.length > 0) {
          var current = folderQueue.shift();
          var pageToken = null;
          do {
            if (_checkDeadline_('_listDocsFast_:page')) {
              console.warn('_listDocsFast_ deadline near; stopping enumeration for ' + current.id);
              break;
            }
            var resp;
            try {
              resp = Drive.Files.list({
                q: "'" + current.id + "' in parents and trashed = false",
                maxResults: 1000,
                pageSize: 1000,
                pageToken: pageToken,
                fields: 'nextPageToken,items(id,name,mimeType,size,createdTime,modifiedTime,title)',
                orderBy: 'modifiedTime desc'
              });
            } catch (e) {
              try {
                resp = Drive.Files.list({
                  q: "'" + current.id + "' in parents and trashed = false",
                  maxResults: 1000,
                  pageSize: 1000,
                  pageToken: pageToken,
                  orderBy: 'modifiedTime desc'
                });
              } catch (e2) {
                console.warn('_listDocsFast_ page error in ' + current.id + ': ' + e2.message);
                break;
              }
            }
            var items = (resp && (resp.items || resp.files)) || [];
            for (var i = 0; i < items.length; i++) {
              var f = items[i];
              var fid = f.id;
              if (!fid || seenIds[fid]) continue;
              var mime = f.mimeType || '';
              if (mime === 'application/vnd.google-apps.shortcut') continue;
              var fname = f.title || f.name || '';
              if (mime === 'application/vnd.google-apps.folder') {
                if (recurse) folderQueue.push({ id: fid,
              driveId: fid, label: fname || current.label });
                continue;
              }
              if (!isDocumentMimeType(mime)) continue;
              seenIds[fid] = true;
              var preview = buildSecureFileLinks_(fid, { allowPreview: true, allowDownload: true, mimeType: mime }).previewLink;
              if (!preview) preview = 'https://drive.google.com/file/d/' + fid + '/preview?rm=minimal';
              var downloadUrl = buildSecureFileLinks_(fid, { allowPreview: false, allowDownload: true, mimeType: mime }).downloadUrl;
              var sizeBytes = Number(f.fileSize || f.size || 0);
              var _fnLower2 = String(current.label || '').toLowerCase();
              var _isTpl = (_fnLower2.indexOf('шаблон')!==-1||_fnLower2.indexOf('template')!==-1||_fnLower2.indexOf('фни')!==-1||_fnLower2.indexOf('пни')!==-1||_fnLower2.indexOf('днп')!==-1||_fnLower2.indexOf('нпф')!==-1);
              var _isReg = (_fnLower2.indexOf('нормативни')!==-1||_fnLower2.indexOf('правилник')!==-1||_fnLower2.indexOf('наредба')!==-1||_fnLower2.indexOf('критерии')!==-1||_fnLower2.indexOf('инфо')!==-1||_fnLower2.indexOf('info')!==-1);
              var _isCopyable = _isTpl && !_isReg;

              documents.push({
                  id: fid,
                  driveId: fid,
                  name: fname,
                  mimeType: mime,
                  typeLabel: mimeTypeLabel(mime),
                  size: formatFileSize_(sizeBytes),
                  sizeBytes: sizeBytes,
                  folderName: current.label || 'Общи',
                  previewLink: preview,
                  webViewLink: preview,
                  downloadUrl: downloadUrl,
                  drive_id: fid,
                  preview_link: preview,
                  web_view_link: preview,
                  download_url: downloadUrl,
                  created: f.createdDate || f.createdTime || '',
                  modified: f.modifiedDate || f.modifiedTime || '',
                  isCopyable: _isCopyable
              });
              docsSinceYield++;
              if (docsSinceYield >= YIELD_EVERY) {
                Utilities.flush();
                docsSinceYield = 0;
              }
            }
            pageToken = resp && resp.nextPageToken;
          } while (pageToken);
        }
      }

      function scanFolderRecursive(folder, folderLabel, documents, seenIds) {
        if (_checkDeadline_('scanFolderRecursive')) return;
        collectFilesTopLevel(folder, folderLabel, documents, seenIds);
        var subs = folder.getFolders();
        while (subs.hasNext()) {
          if (_checkDeadline_('scanFolderRecursive:subs')) break;
          var sub = subs.next();
          scanFolderRecursive(sub, sub.getName(), documents, seenIds);
        }
      }

      function collectFilesTopLevel(folder, folderLabel, documents, seenIds) {
        var files = folder.getFiles();
        while (files.hasNext()) {
          if (_checkDeadline_('collectFilesTopLevel')) break;
          var file     = files.next();
          var fileId   = file.getId();
          if (seenIds[fileId]) continue;
          var mimeType = file.getMimeType();
          if (mimeType === 'application/vnd.google-apps.shortcut') continue;
          if (mimeType === 'application/vnd.google-apps.folder')   continue;
          if (!isDocumentMimeType(mimeType)) continue;
          seenIds[fileId] = true;
          // listDocuments() returns OFFICIAL_DOCS for everyone (admin-curated
          // policy/template documents) and DRIVE_FOLDER for admins only — both
          // are download-eligible by policy. Always emit /preview as the
          // "open" link so the document viewer cannot be pivoted to /edit.
          var _previewLink = 'https://drive.google.com/file/d/' + fileId + '/preview?rm=minimal';
          // v9.37.0-regulatory: isCopyable flag — templates are copyable,
          // regulatory/informational documents are view-only.
          // Heuristic: files in folders containing "шаблон", "template", "ФНИ",
          // "ПНИ", "ДНП", "НПФ" (but NOT "нормативни", "правилник", "наредба",
          // "критерии", "инфо", "info") are copyable templates.
          var _fnLower = String(folderLabel || '').toLowerCase();
          var _isTemplate = (
            _fnLower.indexOf('шаблон') !== -1 ||
            _fnLower.indexOf('template') !== -1 ||
            _fnLower.indexOf('фни') !== -1 ||
            _fnLower.indexOf('пни') !== -1 ||
            _fnLower.indexOf('днп') !== -1 ||
            _fnLower.indexOf('нпф') !== -1
          );
          var _isRegulation = (
            _fnLower.indexOf('нормативни') !== -1 ||
            _fnLower.indexOf('правилник') !== -1 ||
            _fnLower.indexOf('наредба') !== -1 ||
            _fnLower.indexOf('критерии') !== -1 ||
            _fnLower.indexOf('инфо') !== -1 ||
            _fnLower.indexOf('info') !== -1
          );
          var isCopyable = _isTemplate && !_isRegulation;

          documents.push({
            id: fileId,
            driveId: fileId,
            name: file.getName(),
            mimeType: mimeType,
            typeLabel: mimeTypeLabel(mimeType),
            size: formatFileSize_(file.getSize()),
            sizeBytes: Number(file.getSize() || 0),
            folderName: folderLabel || 'Общи',
            previewLink: _previewLink,
            webViewLink: _previewLink,
            downloadUrl: _mimeDownloadUrl_(fileId, mimeType),
            drive_id: fileId,
            preview_link: _previewLink,
            web_view_link: _previewLink,
            download_url: _mimeDownloadUrl_(fileId, mimeType),
            created: Utilities.formatDate(file.getDateCreated(), 'Europe/Sofia', "yyyy-MM-dd'T'HH:mm:ss.SSSXXX"),
            modified: Utilities.formatDate(file.getLastUpdated(), 'Europe/Sofia', "yyyy-MM-dd'T'HH:mm:ss.SSSXXX"),
            isCopyable: isCopyable
          });
        }
      }

      function isDocumentMimeType(mimeType) {
        if (!mimeType) return false;
        // Pre-compiled regex — avoids per-call array literal + .some() closure
        return _RE_DOC_MIME.test(mimeType);
      }
      // REMOVED: var _DOC_MIME_RE was a duplicate — consolidated into _RE_DOC_MIME above.

      /**
       * Human-readable file size: bytes → "12.3 MB" / "450 KB" / "—".
       * Native Google file types (Docs/Sheets/Slides) report size 0 from the
       * Drive API; we render those as an em‑dash so the UI doesn't show a
       * misleading "0.0 KB". Binary files are scaled to the largest unit
       * ≤ the value, so a 12 MB PDF no longer renders as "12345.6 KB".
       */
      function formatFileSize_(bytes) {
        var n = Number(bytes || 0);
        if (!isFinite(n) || n <= 0) return '—';
        if (n < 1024)               return n + ' B';
        if (n < 1024 * 1024)        return (n / 1024).toFixed(1) + ' KB';
        if (n < 1024 * 1024 * 1024) return (n / (1024 * 1024)).toFixed(1) + ' MB';
        return (n / (1024 * 1024 * 1024)).toFixed(2) + ' GB';
      }

      function mimeTypeLabel(mimeType) {
        if (!mimeType) return 'Документ';
        var t = mimeType.toLowerCase();
        if (t.indexOf('pdf')          !== -1) return 'PDF';
        if (t.indexOf('spreadsheet')  !== -1 || t.indexOf('excel')      !== -1) return 'Excel';
        if (t.indexOf('document')     !== -1 || t.indexOf('msword')     !== -1) return 'Word';
        if (t.indexOf('presentation') !== -1 || t.indexOf('powerpoint') !== -1) return 'Slides';
        if (t.indexOf('plain')        !== -1) return 'Text';
        return 'Документ';
      }

      // ══════════════════════════════════════════════════════════════════
      //  LIBRARY MANAGEMENT – Admin CRUD for official-documents Drive folder
      //  (v4.7.0-library-mgmt)
      // ══════════════════════════════════════════════════════════════════

      /**
       * uploadLibraryFile(body)
       * Admin-only. Accepts an array of {name, data(base64), mimeType, folderId?}
       * and saves each to OFFICIAL_DOCS_FOLDER_ID (or a named subfolder).
       * Bumps DATA_VER_SYSTEM so listDocuments cache auto-invalidates.
       */
      function uploadLibraryFile(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin) return { success: false, error: 'Само администратори могат да качват документи в библиотеката.' };

          var files = body.files;
          if (!Array.isArray(files) || files.length === 0) {
            return { success: false, error: 'Няма предоставени файлове за качване.' };
          }

          var folderName = _sanitiseFileName_(String(body.folderName || '').trim(), 100);
          var targetFolder;
          try {
            var rootFolder = DriveApp.getFolderById(OFFICIAL_DOCS_FOLDER_ID);
            if (folderName) {
              // Look for existing subfolder or create it
              var subs = rootFolder.getFoldersByName(folderName);
              if (subs.hasNext()) {
                targetFolder = subs.next();
              } else {
                targetFolder = rootFolder.createFolder(folderName);
              }
            } else {
              targetFolder = rootFolder;
            }
          } catch (e) {
            return { success: false, error: 'Не може да се достъпи папката на библиотеката: ' + e.message };
          }

          var results = [];
          var errors = [];
          var MAX_SIZE = 25 * 1024 * 1024; // 25 MB per file

          for (var i = 0; i < files.length; i++) {
            var f = files[i];
            var fname = _sanitiseFileName_(String(f.name || 'untitled').trim());
            var fdata = String(f.data || f.content || '');
            var fmime = String(f.mimeType || f.type || 'application/octet-stream').trim();

            if (!fdata) { errors.push({ name: fname, error: 'Празен файл' }); continue; }

            // ── MIME type allowlist for library uploads ──
            // Only documents, spreadsheets, PDFs, images, and plain text are
            // accepted in the official library. Executables, archives, and
            // generic binary blobs are rejected.
            var LIBRARY_ALLOWED_MIMES = [
              'application/pdf',
              'application/msword',
              'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
              'application/vnd.oasis.opendocument.text',
              'application/vnd.google-apps.document',
              'application/vnd.ms-excel',
              'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
              'application/vnd.oasis.opendocument.spreadsheet',
              'application/vnd.google-apps.spreadsheet',
              'image/png', 'image/jpeg', 'image/gif', 'image/svg+xml',
              'text/plain', 'text/csv',
              'application/rtf', 'application/vnd.google-apps.presentation'
            ];
            var mimeAllowed = LIBRARY_ALLOWED_MIMES.indexOf(fmime) !== -1;
            // Also accept any mime starting with known-safe prefixes
            if (!mimeAllowed) {
              mimeAllowed = fmime.indexOf('application/vnd.google-apps.') === 0 ||
                            fmime.indexOf('image/') === 0 ||
                            fmime.indexOf('text/') === 0;
            }
            if (!mimeAllowed) {
              errors.push({ name: fname, error: 'Непозволен тип файл: ' + fmime });
              continue;
            }

            try {
              // Decode base64 → blob
              var decoded;
              try {
                // Strip data URI prefix if present
                var b64 = fdata.replace(/^data:[^;]*;base64,/, '');
                decoded = Utilities.base64Decode(b64);
              } catch (de) {
                errors.push({ name: fname, error: 'Невалиден base64 формат' });
                continue;
              }

              if (decoded.length > MAX_SIZE) {
                errors.push({ name: fname, error: 'Файлът надвишава 25 MB' });
                continue;
              }

              var blob = Utilities.newBlob(decoded, fmime, fname);
              var uploaded = targetFolder.createFile(blob);

              // Make viewable by anyone with link (library docs are public)
              try { uploaded.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW); } catch (_) {}

              results.push({
                id: uploaded.getId(),
                name: uploaded.getName(),
                mimeType: uploaded.getMimeType(),
                size: uploaded.getSize(),
                sizeLabel: formatFileSize_(uploaded.getSize()),
                folderName: folderName || 'Общи',
                previewLink: 'https://drive.google.com/file/d/' + uploaded.getId() + '/preview?rm=minimal',
                downloadUrl: 'https://drive.google.com/uc?export=download&id=' + uploaded.getId()
              });
            } catch (ue) {
              errors.push({ name: fname, error: ue.message });
            }
          }

          // Bump system version to invalidate document cache
          if (results.length > 0) {
            try { touchDataVersion_('system'); } catch (_) {}
          }

          return {
            success: results.length > 0,
            uploaded: results,
            errors: errors.length > 0 ? errors : undefined,
            message: results.length + ' файла качени' + (errors.length > 0 ? ', ' + errors.length + ' грешки' : '')
          };
        } catch (err) {
          try { logError('uploadLibraryFile', err, body); } catch (_) {}
          return { success: false, error: 'uploadLibraryFile: ' + err.message };
        }
      }

      /**
       * deleteLibraryFile(body)
       * Admin-only. Trashes a file by ID. Only files inside OFFICIAL_DOCS_FOLDER_ID
       * (or a descendant folder) can be deleted. Bumps DATA_VER_SYSTEM.
       */
      function deleteLibraryFile(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin) return { success: false, error: 'Само администратори могат да изтриват документи от библиотеката.' };

          var fileId = String(body.id || body.fileId || '').trim();
          if (!fileId) return { success: false, error: 'Липсва ID на файл.' };

          var file;
          try { file = DriveApp.getFileById(fileId); } catch (e) {
            return { success: false, error: 'Файлът не е намерен: ' + e.message };
          }

          // Security: only allow deletion of files inside the official docs folder
          if (!_isInsideOfficialDocsFolder_(fileId)) {
            return { success: false, error: 'Файлът не е в библиотеката с официални документи. Отказан достъп.' };
          }

          var fname = file.getName();
          try { file.setTrashed(true); } catch (te) {
            return { success: false, error: 'Не може да се изтрие файлът: ' + te.message };
          }

          // Bump system version to invalidate document cache
          try { touchDataVersion_('system'); } catch (_) {}

          return { success: true, message: '„' + fname + '" е изтрит.', id: fileId };
        } catch (err) {
          try { logError('deleteLibraryFile', err, body); } catch (_) {}
          return { success: false, error: 'deleteLibraryFile: ' + err.message };
        }
      }

      /**
       * createLibraryFolder(body)
       * Admin-only. Creates a subfolder inside OFFICIAL_DOCS_FOLDER_ID.
       */
      function createLibraryFolder(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin) return { success: false, error: 'Само администратори могат да създават папки в библиотеката.' };

          var folderName = _sanitiseFileName_(String(body.name || body.folderName || '').trim(), 100);
          if (!folderName) return { success: false, error: 'Името на папката е задължително.' };
          if (folderName.length > 100) return { success: false, error: 'Името не може да надвишава 100 символа.' };

          var rootFolder;
          try { rootFolder = DriveApp.getFolderById(OFFICIAL_DOCS_FOLDER_ID); } catch (e) {
            return { success: false, error: 'Основната папка не е намерена.' };
          }

          // Check if folder already exists
          var existing = rootFolder.getFoldersByName(folderName);
          if (existing.hasNext()) {
            return { success: false, error: 'Вече съществува папка с име „' + folderName + '".' };
          }

          var created = rootFolder.createFolder(folderName);
          return { success: true, message: 'Папка „' + folderName + '" е създадена.', folderId: created.getId(), name: folderName };
        } catch (err) {
          try { logError('createLibraryFolder', err, body); } catch (_) {}
          return { success: false, error: 'createLibraryFolder: ' + err.message };
        }
      }

      /**
       * deleteLibraryFolder(body)
       * Admin-only. Deletes an empty subfolder inside OFFICIAL_DOCS_FOLDER_ID.
       * Refuses to delete non-empty folders (safety check).
       */
      function deleteLibraryFolder(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin) return { success: false, error: 'Само администратори могат да изтриват папки от библиотеката.' };

          var folderId = String(body.id || body.folderId || '').trim();
          if (!folderId) return { success: false, error: 'Липсва ID на папка.' };

          var folder;
          try { folder = DriveApp.getFolderById(folderId); } catch (e) {
            return { success: false, error: 'Папката не е намерена.' };
          }

          // Safety: only delete subfolders of OFFICIAL_DOCS_FOLDER_ID
          if (!_isInsideOfficialDocsFolder_(folderId)) {
            return { success: false, error: 'Папката не е в библиотеката. Отказан достъп.' };
          }

          // Refuse to delete non-empty folders
          if (folder.getFiles().hasNext() || folder.getFolders().hasNext()) {
            return { success: false, error: 'Папката не е празна. Преместете или изтрийте файловете първо.' };
          }

          var fname = folder.getName();
          try { folder.setTrashed(true); } catch (te) {
            return { success: false, error: 'Не може да се изтрие папката: ' + te.message };
          }

          return { success: true, message: 'Папка „' + fname + '" е изтрита.', id: folderId };
        } catch (err) {
          try { logError('deleteLibraryFolder', err, body); } catch (_) {}
          return { success: false, error: 'deleteLibraryFolder: ' + err.message };
        }
      }

      /**
       * listLibraryFolders(body)
       * Returns subfolder names + IDs inside OFFICIAL_DOCS_FOLDER_ID.
       * PERF: fileCount is set to 0 here — the frontend computes accurate
       * counts from the listDocuments response (which uses the fast Drive
