      // ============================================================
      //  ERROR LOGGING & DIAGNOSTICS
      // ============================================================
      function logError(action, error, context) {
        try {
          var ss = _getCachedSpreadsheet();
          var logSheet = ss.getSheetByName('ErrorLog');
          if (!logSheet) {
            logSheet = ss.insertSheet('ErrorLog');
            logSheet.appendRow(['Timestamp', 'Action', 'Error Message', 'Context', 'Stack Trace']);
            logSheet.getRange(1, 1, 1, 5).setBackground('#7B1B1B').setFontColor('#fff');
          }
          // Sanitize context: strip sensitive fields before logging
          var safeContext = {};
          if (context && typeof context === 'object') {
            var keys = Object.keys(context);
            for (var i = 0; i < keys.length; i++) {
              if (['password','signature','signatureAdmin','credential'].indexOf(keys[i]) === -1) {
                safeContext[keys[i]] = context[keys[i]];
              }
            }
          }
          logSheet.appendRow([
            nowISO(),
            action,
            (error && error.message) ? error.message : String(error),
            JSON.stringify(safeContext),
            (error && error.stack) ? error.stack : ''
          ]);
        } catch (e) {
          // Silently fail logging to not break the application
        }
      }

      function getErrorLog(body) {
        try {
          var auth = resolveAuthContext(body || {});
          if (!auth.isAdmin) return { success: false, error: 'Отказан достъп: Само администратори.' };
          var ss = _getCachedSpreadsheet();
          var logSheet = ss.getSheetByName('ErrorLog');
          if (!logSheet) return { success: true, errors: [], total: 0 };

          var data = logSheet.getDataRange().getValues();
          var errors = [];
          var limit = Math.min(data.length - 1, 100); // Last 100 errors

          for (var i = Math.max(1, data.length - limit); i < data.length; i++) {
            if (data[i][0]) {
              errors.push({
                timestamp: String(data[i][0]),
                action: String(data[i][1]),
                message: String(data[i][2]),
                context: data[i][3] ? String(data[i][3]) : '{}',
                stack: String(data[i][4])
              });
            }
          }

          return { success: true, errors: errors, total: data.length - 1 };
        } catch (err) {
          return { success: false, error: err.message };
        }
      }

      // ============================================================
      //  AVТОРИЗАЦИЯ И ПОМОЩНИ ФУНКЦИИ
      // ============================================================

      function extractUserId(body) {
        if (!body) return '';
        var val = body.userId || body.email || body.userEmail || body.username || '';
        return String(val).toLowerCase().trim();
      }

      // ── ROLE CONSTANTS ──
      var ROLE_ADMIN             = 'admin';
      var ROLE_REVIEWER          = 'reviewer';
      var ROLE_APPLICANT_REVIEWER= 'applicant-reviewer';
      var ROLE_APPLICANT         = 'applicant';    // Extended roles per regulation workflow
      var ROLE_RECTOR            = 'rector';
      var ROLE_VICE_RECTOR       = 'vice_rector';
      var ROLE_CKK               = 'ckk';          // ЦКК – Central Competition Commission
      var ROLE_NIDD              = 'nidd';         // НИДД department
      var ROLE_ACADEMIC_COUNCIL  = 'academic_council';
      var ROLE_PROJECT_LEAD      = 'project_lead'; // approved project leader
      var ROLE_FINANCIAL         = 'financial';    // financial control
      var ROLE_ACCOUNTING        = 'accounting';   // accounting (osch.)
      var ROLE_LIBRARY           = 'library';
      var ROLE_UNIT_HEAD         = 'unit_head';    // head of department/unit
      var ROLE_TEAM_MEMBER       = 'team_member';  // member of project team
      var VALID_ROLES = [ROLE_ADMIN, ROLE_REVIEWER, ROLE_APPLICANT_REVIEWER, ROLE_APPLICANT,
        ROLE_RECTOR, ROLE_VICE_RECTOR, ROLE_CKK, ROLE_NIDD, ROLE_ACADEMIC_COUNCIL,
        ROLE_PROJECT_LEAD, ROLE_TEAM_MEMBER, ROLE_FINANCIAL, ROLE_ACCOUNTING, ROLE_LIBRARY, ROLE_UNIT_HEAD];

      // ── MySQL admin emails cache (v12.26.1-perf) ─────────────────────
      // Two-tier cache: L1 = per-execution (in-memory), L2 = cross-execution
      // (CacheService, 30min TTL). This saves ~200-500ms on cold starts by
      // avoiding the HTTP call to PHP on every execution.
      var _mysqlAdminEmailsLoaded_ = false;
      var _MYSQL_ADMIN_EMAILS_ = [];
      var _MYSQL_ADMIN_CACHE_KEY_ = 'MYSQL_ADMIN_EMAILS::v2';
      var _MYSQL_ADMIN_CACHE_TTL_ = 1800; // 30min cross-execution cache — version-key ensures instant invalidation on admin list changes
      var _MYSQL_ADMIN_CACHE_VER_KEY_ = 'MYSQL_ADMIN_CACHE_VER'; // bumped when admin list changes
      var _adminCacheVerMemo_ = ''; // tracks last seen admin cache version for L2 invalidation
      // Per-execution memo for PHP admin check fallback to avoid repeated HTTP calls
      var _phpAdminCheckMemo_ = {};

      /**
       * Lazily load admin emails from the MySQL admin_emails table.
       * Two-tier: tries in-memory cache first, then CacheService (cross-exec),
       * then HTTP fetch to PHP as last resort.
       * @param {boolean} [skipHttp] — if true, only check caches, don't fetch
       */
      /**
       * Lazily load admin emails from the MySQL admin_emails table.
       * Two-tier: tries in-memory cache first, then CacheService (cross-exec),
       * then HTTP fetch to PHP as last resort.
       * @param {boolean} [skipHttp] — if true, only check caches, don't fetch
       */
      function _loadMySqlAdminEmails_(skipHttp) {
        if (_mysqlAdminEmailsLoaded_) return;

        // L2: Cross-execution CacheService (5min TTL, avoids HTTP on warm starts)
        // v12.30.0-perf: Also check version key — if admin list was modified (e.g.
        // SQL promotion), bumping the version forces a hard refresh from PHP.
        try {
          var _sc = _scriptCache_();
          var _cachedVer = _sc.get(_MYSQL_ADMIN_CACHE_VER_KEY_);
          if (_cachedVer && _cachedVer !== _adminCacheVerMemo_) {
            // Version changed — skip L2 cache, fetch fresh from PHP
            _adminCacheVerMemo_ = _cachedVer;
            _sc.remove(_MYSQL_ADMIN_CACHE_KEY_);
            throw new Error('cache_version_changed');
          }
          var _cached = _sc.get(_MYSQL_ADMIN_CACHE_KEY_);
          if (_cached) {
            var _parsed = JSON.parse(_cached);
            if (Array.isArray(_parsed) && _parsed.length) {
              _MYSQL_ADMIN_EMAILS_ = _parsed;
              _mysqlAdminEmailsLoaded_ = true;
              return;
            }
          }
        } catch (_) {}

        // L3: HTTP fetch from PHP (only if skipHttp is falsy)
        if (skipHttp) { _mysqlAdminEmailsLoaded_ = true; return; }
        try {
          var url = _getHostingerUrl_();
          if (!url) { _mysqlAdminEmailsLoaded_ = true; return; }
          var _doFetch = function() {
            var payload = JSON.stringify({ action: 'listadminemails' });
            return UrlFetchApp.fetch(url, {
              method: 'post', contentType: 'application/json',
              payload: payload, muteHttpExceptions: true, timeout: 2000
            });
          };
          var resp = _doFetch();
          // Retry once on transient failure
          if (resp.getResponseCode() >= 500 || resp.getResponseCode() === 0) {
            Utilities.sleep(300);
            resp = _doFetch();
          }
          if (resp.getResponseCode() < 300) {
            var data = JSON.parse(resp.getContentText());
            if (data && data.success) {
              // v19.0.0-refactor: Always flush and rebuild from PHP response
              _MYSQL_ADMIN_EMAILS_ = [];
              if (data.adminEmails && data.adminEmails.length) {
                var _phpVer = String(data.cacheVersion || '0');
                if (_phpVer !== '0' && _phpVer !== _adminCacheVerMemo_) {
                  _adminCacheVerMemo_ = _phpVer;
                  try { _scriptCache_().remove(_MYSQL_ADMIN_CACHE_KEY_); } catch (_) {}
                  try { _scriptCache_().put(_MYSQL_ADMIN_CACHE_VER_KEY_, _phpVer, 86400); } catch (_) {}
                } else if (_phpVer === '0') {
                  console.warn('[AdminCache] PHP returned cacheVersion=0 — version invalidation disabled. Check PHP listadminemails endpoint.');
                }
                for (var i = 0; i < data.adminEmails.length; i++) {
                  var em = String(data.adminEmails[i].email || '').toLowerCase().trim();
                  if (em) _MYSQL_ADMIN_EMAILS_.push(em);
                }
              }
              // Store in CacheService for cross-execution reuse
              try {
                _scriptCache_().put(_MYSQL_ADMIN_CACHE_KEY_, JSON.stringify(_MYSQL_ADMIN_EMAILS_), _MYSQL_ADMIN_CACHE_TTL_);
              } catch (_) {}
            }
          } else {
            // HTTP error — keep stale cache, note the failure
            console.warn('[AdminCache] PHP returned HTTP ' + resp.getResponseCode() + ' — keeping stale admin cache.');
          }
        } catch (e) {
          console.warn('[AdminCache] HTTP fetch from PHP failed: ' + (e.message || 'unknown') + ' — admin recognition may lag until next fetch.');
        } finally {
          _mysqlAdminEmailsLoaded_ = true;
        }
      }

      function isAdminUser(identifier) {
        if (!identifier) return false;
        var val = String(identifier).toLowerCase().trim();

        // Load credentials from Secret Manager (falls back to hardcoded)
        loadAdminCredentials_();

        // Admin username/password authentication (always works)
        if (val === _SYSTEM_ADMIN_USER.toLowerCase()) return true;
        // Rector username/password authentication
        if (_SYSTEM_RECADMIN_USER && val === _SYSTEM_RECADMIN_USER.toLowerCase()) return true;

        // Google Sign-In check: does the email match the admin list?
        if (typeof _ADMIN_EMAILS_SERVER !== 'undefined' && _ADMIN_EMAILS_SERVER && _ADMIN_EMAILS_SERVER.length) {
          if (_ADMIN_EMAILS_SERVER.indexOf(val) !== -1) return true;
        }
        // Legacy fallback: some callers still reference ADMIN_EMAILS_SERVER const
        if (typeof ADMIN_EMAILS_SERVER !== 'undefined' && ADMIN_EMAILS_SERVER && ADMIN_EMAILS_SERVER.length) {
          if (ADMIN_EMAILS_SERVER.indexOf(val) !== -1) return true;
        }

        // ── v12.26.1-perf: Also check MySQL admin_emails table ──
        // Two-tier: CacheService L2 checked first (no HTTP cost),
        // HTTP fetch only on cold cache miss (resolved within 30min).
        if (!_mysqlAdminEmailsLoaded_) { _loadMySqlAdminEmails_(); }
        if (_MYSQL_ADMIN_EMAILS_.indexOf(val) !== -1) return true;

        // v19.0.0-refactor: Check PHP fallback memo (populated by resolveAuthContext).
        // Catches SQL-promoted admins that the GAS cache hasn't picked up yet.
        if (typeof _phpAdminCheckMemo_ !== 'undefined' && _phpAdminCheckMemo_[val]) return true;

        return false;
      }

      /**
       * Check whether the given email is a registered reviewer in the Reviewers sheet.
       * Uses a lightweight cache to avoid repeated sheet reads within the same execution.
       */
      var _reviewerEmailsCache = null;
      var _reviewerEmailsCacheTick = 0;
      function isReviewerUser_(email) {
        if (!email) return false;
        var val = String(email).toLowerCase().trim();
        // FIXED: _executionTick was never set, so the per-execution cache was
        // rebuilt on every single call. Using a simple null-check instead —
        // the variable lives for the lifetime of the GAS execution isolate.
        if (!_reviewerEmailsCache) {
          _reviewerEmailsCache = {};
          // ── CacheService fast-path: avoids Reviewers sheet read across cold starts ──
          try {
            var cached = _scriptCache_().get('REV_EMAILS_MAP');
            if (cached) { _reviewerEmailsCache = JSON.parse(cached); }
          } catch (_) {}
          if (!Object.keys(_reviewerEmailsCache).length) {
            try {
              var revSheet = getReviewersSheet();
              var data = _cachedSheetData_(revSheet);
              for (var i = 1; i < data.length; i++) {
                var e = String(data[i][REV_COL.EMAIL - 1] || '').toLowerCase().trim();
                if (e) _reviewerEmailsCache[e] = true;
              }
              // v12.26.0-perf: Bumped TTL 120→600s — reviewer email map changes rarely
              try { _scriptCache_().put('REV_EMAILS_MAP', JSON.stringify(_reviewerEmailsCache), 600); } catch (_) {}
            } catch (_) {}
          }
        }
        return !!_reviewerEmailsCache[val];
      }

      /**
       * Check whether the given email belongs to a ЦКК (CKK) member.
       * Reads from ScriptProperties key 'CKK_MEMBERS' (comma-separated @ue-varna.bg emails).
       * Falls back to the default admin-emails list if the property is not set.
       *
       * v9.37.0-regulatory: per Бележки и коментари.docx —
       *   "Членовете на ЦКК не участват в проектни предложения"
       */
      var _ckkEmailsCache = null;
      function isCKKMember_(email) {
        if (!email) return false;
        var val = String(email).toLowerCase().trim();
        if (_ckkEmailsCache && _ckkEmailsCache[val] !== undefined) return _ckkEmailsCache[val];
        _ckkEmailsCache = _ckkEmailsCache || {};
        // Try ScriptProperties first
        try {
          var ckkRaw = _scriptProps_().getProperty('CKK_MEMBERS');
          if (ckkRaw) {
            var ckkList = ckkRaw.split(',').map(function(e){ return String(e).trim().toLowerCase(); }).filter(Boolean);
            _ckkEmailsCache[val] = ckkList.indexOf(val) !== -1;
            return _ckkEmailsCache[val];
          }
        } catch (_) {}
        // Fallback: default admin emails ARE the CKK (separation waiting on config)
        _ckkEmailsCache[val] = (_ADMIN_EMAILS_SERVER && _ADMIN_EMAILS_SERVER.indexOf(val) !== -1);
        return _ckkEmailsCache[val];
      }

      /**
       * Resolve the user's role based on server-side data.
       * Roles (in priority order): admin > ckk > applicant-reviewer > reviewer > applicant.
       * v9.37.0-regulatory: CKK members are detected via isCKKMember_() and
       *   assigned ROLE_CKK. CKK members are BLOCKED from submitting proposals.
       */
      function resolveUserRole_(userId, isAdmin) {
        if (isAdmin) return ROLE_ADMIN;
        // CKK check — must come before reviewer/applicant because CKK members
        // cannot be applicants (per Бележки и коментари.docx)
        if (isCKKMember_(userId)) return ROLE_CKK;
        var isRev = isReviewerUser_(userId);
        if (isRev) {
          // Check if they also have applications (applicant-reviewer)
          // Use a targeted single-column read instead of full getDataRange
          try {
            var sheet = getSheet();
            var lastRow = sheet.getLastRow();
            if (lastRow > 1) {
              var emails = sheet.getRange(2, COL.USER_EMAIL, lastRow - 1, 1).getValues();
              for (var i = 0; i < emails.length; i++) {
                if (String(emails[i][0] || '').toLowerCase().trim() === userId) return ROLE_APPLICANT_REVIEWER;
              }
            }
          } catch (_) {}
          return ROLE_REVIEWER;
        }
        return ROLE_APPLICANT;
      }

      // ── Per-execution auth context cache ────────────────────────────────
      // resolveAuthContext is called once per sub-function (getForms, getCompetitions,
      // listDocuments, etc.).  getInitialData alone triggers 4 calls.  Each call previously
      // paid: 1× PropertiesService read (loadAdminCredentials_) + 1× possible Reviewers
      // sheet read + 1× possible Applications column read.  The cache collapses N calls
      // into 1 real call + N-1 zero-cost hash lookups for the lifetime of the GAS execution.
      // ── v7.0.0: Auth context cache with forced re-auth support ────────────
      // CRITICAL FIX: _authContextCache was a per-execution singleton that NEVER
      // expired. When an admin promotes a user via SQL (is_admin toggled), the
      // cached role stayed 'applicant' for the entire GAS execution lifetime.
      // Now we track the script property version so any ScriptProperties write
      // (e.g. addAdminEmail) busts the cache for the NEXT request.
      // The per-execution memo still prevents redundant sheet scans WITHIN one
      // request while __forceReauth lets callers opt into a fresh resolution.
      var _authContextCache = {};
      var _authContextCacheVersion = 0;
      var _AUTH_CACHE_BUST_PROP = '_AUTH_CTX_CACHE_VER';
      function _getAuthCacheVersion_() {
        try { return Number(_scriptProps_().getProperty(_AUTH_CACHE_BUST_PROP) || 0); } catch (_) { return 0; }
      }
      function _bustAuthCache_() {
        try {
          var v = _getAuthCacheVersion_() + 1;
          _scriptProps_().setProperty(_AUTH_CACHE_BUST_PROP, String(v));
          _authContextCache = {};
          _authCtxMemo_ = null;
          _authContextCacheVersion = v;
          loadAdminCredentials_(); // Force re-load admin list
        } catch (_) {}
      }

      // ── Per-execution auth context memo ─────────────────────────────────
      // resolveAuthContext is called ~10+ times per execution (once per
      // endpoint, plus sub-calls from notify, logTransaction, etc.). Each call
      // scans AdminUsers sheet + reviewer logic. Memoising once per doPost
      // eliminates ~9 redundant sheet scans per request.
      // v7.0.0: Added cache version check — if the global bust version changed
      // (admin added/removed via SQL/MySQL sync), force re-resolution.
      var _authCtxMemo_ = null;
      function resolveAuthContext(body) {
        // Fast-path: caller (e.g. getInitialData) already resolved auth and
        // populated userId/isAdmin/role — skip re-resolution entirely.
        if (body && body.__skipReauth && body.userId) {
          var _ctx = { userId: body.userId, isAdmin: !!body.isAdmin, role: body.role || (body.isAdmin ? ROLE_ADMIN : ROLE_APPLICANT), authenticated: true };
          _authCtxMemo_ = _ctx;
          return _ctx;
        }
        // v7.0.0: Check if global bust version changed → force re-auth
        var _currentCacheVersion = _getAuthCacheVersion_();
        if (_currentCacheVersion !== _authContextCacheVersion) {
          _authContextCache = {};
          _authCtxMemo_ = null;
          _authContextCacheVersion = _currentCacheVersion;
        }
        if (_authCtxMemo_ && !body.__forceReauth) return _authCtxMemo_;
        body = body || {};
        var userId = extractUserId(body);
        var uname  = body.username || '';
        // v19.0.0-refactor: Use JSON key to avoid delimiter collision; never include password
        var cacheKey = JSON.stringify([userId, uname]);
        if (_authContextCache[cacheKey]) { _authCtxMemo_ = _authContextCache[cacheKey]; return _authCtxMemo_; }
        loadAdminCredentials_();
        var isAdmin = isAdminUser(userId);
        if (body.username === _SYSTEM_ADMIN_USER && body.password === _SYSTEM_ADMIN_PASS) {
          isAdmin = true;
          userId = _SYSTEM_ADMIN_USER;
        }
        // Rector-administrator credential pair (УЦ-16 / УЦ-22 / УЦ-25)
        var _isRecAdmin = false;
        if (_SYSTEM_RECADMIN_USER && body.username === _SYSTEM_RECADMIN_USER && body.password === _SYSTEM_RECADMIN_PASS) {
          isAdmin = true;
          userId = _SYSTEM_RECADMIN_USER;
          _isRecAdmin = true;
        } else if (_SYSTEM_RECADMIN_USER && String(userId || '').toLowerCase() === _SYSTEM_RECADMIN_USER.toLowerCase()) {
          // userId echoed back from a previous adminLogin response
          isAdmin = true;
          _isRecAdmin = true;
        }
        // ── PHP fallback: if local admin list doesn't recognise this email,
        //    check with the PHP API (SQL admin_emails table is authoritative).
        //    Uses a per-execution memo to avoid repeated HTTP calls.
        //    This ensures SQL-promoted admins are recognised even when the
        //    GAS-side admin cache (CacheService, 30min TTL) is stale.
        // v19.0.0-refactor: Also check non-email userIds via isAdminUser which
        //    now consults _phpAdminCheckMemo_. The @-check below remains for the
        //    HTTP fallback path (email-based admin lookup).
        if (!isAdmin && !uname && userId) {
          if (_phpAdminCheckMemo_.hasOwnProperty(userId)) {
            if (_phpAdminCheckMemo_[userId]) {
              isAdmin = true;
              _isRecAdmin = false;
            }
          } else if (userId.indexOf('@') > 0) {
            try {
              var _phpUrl = _getHostingerUrl_();
              if (_phpUrl) {
                var _phpResp = JSON.parse(UrlFetchApp.fetch(_phpUrl, {
                  method: 'post', contentType: 'application/json',
                  payload: JSON.stringify({ action: 'checkadmin', email: userId }),
                  muteHttpExceptions: true, timeout: 1500
                }).getContentText());
                if (_phpResp && _phpResp.success && _phpResp.isAdmin) {
                  console.warn('[Auth] PHP fallback confirmed admin for ' + userId + ' — GAS-side cache was stale. Updating admin list.');
                  isAdmin = true;
                  _isRecAdmin = false;
                  if (_MYSQL_ADMIN_EMAILS_.indexOf(userId) === -1) {
                    _MYSQL_ADMIN_EMAILS_.push(userId);
                    // Bust cross-execution cache so subsequent GAS calls
                    // also recognise this admin immediately
                    try { _scriptCache_().remove(_MYSQL_ADMIN_CACHE_KEY_); } catch (_) {}
                    // Re-cache with updated list
                    try { _scriptCache_().put(_MYSQL_ADMIN_CACHE_KEY_, JSON.stringify(_MYSQL_ADMIN_EMAILS_), _MYSQL_ADMIN_CACHE_TTL_); } catch (_) {}
                  }
                  _phpAdminCheckMemo_[userId] = true;
                } else {
                  // v15.0.0-perf: Only cache when PHP explicitly says non-admin
                  // (successful response with isAdmin=false). Network errors/timeouts
                  // should NOT be cached — let the next call retry the PHP check.
                  if (_phpResp && _phpResp.success) {
                    _phpAdminCheckMemo_[userId] = false;
                  }
                }
              }
            } catch (e) {
              console.warn('[AuthCtx] PHP checkadmin fallback HTTP failed: ' + (e.message || 'unknown') + ' — admin recognition relies on GAS-only data for this request.');
            }
          }
        }
        var role = _isRecAdmin ? ROLE_RECTOR : resolveUserRole_(userId, isAdmin);
        var ctx = { userId: userId, isAdmin: isAdmin, role: role, authenticated: !!(userId || uname) };
        _authContextCache[cacheKey] = ctx;
        _authCtxMemo_ = ctx;
        return ctx;
      }

      function normalizeCompetitionStatus_(status) {
        var s = String(status || '').toLowerCase().trim();
        if (!s) return 'active';
        if (s === 'активен' || s === 'active' || s === 'open') return 'active';
        if (s === 'затворен' || s === 'closed') return 'closed';
        if (s === 'архивиран' || s === 'архив' || s === 'archived') return 'archived';
        if (s === 'draft' || s === 'pending') return 'draft';
        if (s === 'results_published' || s === 'публикуван' || s === 'published') return 'results_published';
        return s;
      }

      function shouldExposeCompetitionToApplicant_(competition) {
        if (!competition) return false;
        var normalized = normalizeCompetitionStatus_(competition.status);
        // Only hide archived competitions; show everything else to applicants (draft, active, closed, pending, etc.)
        if (normalized === 'archived') return false;

        // ── Hide "Допълнителна конкурсна сесия" entries from applicant view ──
        // Per Бележки и коментари 2026-05-18: additional/supplementary sessions
        // must NOT appear in the applicant competition selector.
        var ct = String(competition.callType || '').toLowerCase().trim();
        if (ct === 'additional' || ct === 'допълнителна' || ct === 'supplementary') return false;

        // Active, open, published competitions are always visible
        if (normalized === 'active' || normalized === 'open' || normalized === 'draft') return true;

        // results_published competitions are visible to applicants so they can see the outcome
        if (normalized === 'results_published') return true;

        // Closed competitions are still visible if deadline has not passed yet.
        if (normalized === 'closed') {
          var d = String(competition.deadline || competition.dateEnd || '').trim();
          if (!d) return true;
          var dd = new Date(d);
          if (isNaN(dd.getTime())) return true;

          // If the deadline is date-only, treat it as end-of-day local time.
          if (/^\d{4}-\d{2}-\d{2}$/.test(d)) {
            dd.setHours(23, 59, 59, 999);
          }
          return dd.getTime() >= Date.now();
        }

        // Unknown statuses should not hide competitions from applicants (show by default)
        return true;
      }

