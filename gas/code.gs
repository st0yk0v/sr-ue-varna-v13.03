                      '<strong style="color:#202124">' + xmlEscape_(INSTITUTION.legalName_bg) + '</strong><br>' +
                      xmlEscape_(INSTITUTION.address) + '<br>' +
                      'ЕИК: ' + xmlEscape_(INSTITUTION.eik) + ' · ' +
                      '<a href="' + xmlEscape_(INSTITUTION.website) + '" style="color:' + BRAND1 + ';text-decoration:none">' + xmlEscape_(INSTITUTION.website.replace(/^https?:\/\//,'')) + '</a> · ' +
