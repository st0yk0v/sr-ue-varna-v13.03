      var _listDocsMemo_ = null;

      // ── L1: persistent chunked shadow cache (PropertiesService) ───────────
      // listDocuments and getForms results are large and cold-cache fetches
      // are slow (Drive recursion / sheet read). CacheService entries evict
      // (6 h cap, 100 KB cap, LRU pressure); when they do, the next request
      // pays the full latency. This shadow cache survives CacheService eviction
      // by chunking the JSON into 9 KB PropertiesService values, version-keyed
      // so a `touchDataVersion_()` call automatically invalidates it (the next
      // successful call repopulates under the new version and a GC sweep drops
      // stale chunks). Reads cost one getProperties() bridge call (~50–150 ms);
      // far cheaper than a 2–30 s Drive scan.
      var _SHADOW_CHUNK = 9000;          // PropertiesService per-value limit ~9 KB
      var _SHADOW_MAX_CHUNKS = 50;       // ~450 KB ceiling (safety guard)
      function _shadowCacheLoad_(prefix, role, version) {
        try {
          var props = _scriptProps_().getProperties();
          var headKey = prefix + role + ':' + version + ':h';
          var head = props[headKey];
          if (!head) return null;
          var meta; try { meta = JSON.parse(head); } catch (_) { return null; }
          if (!meta || !meta.n || meta.n > _SHADOW_MAX_CHUNKS) return null;
          var parts = new Array(meta.n);
          for (var i = 0; i < meta.n; i++) {
            var v = props[prefix + role + ':' + version + ':c' + i];
            if (v == null) return null;
            parts[i] = v;
          }
          try { return JSON.parse(parts.join('')); } catch (_) { return null; }
        } catch (_) { return null; }
      }
      function _shadowCacheSave_(prefix, role, version, value) {
        try {
          var json = typeof value === 'string' ? value : JSON.stringify(value);
          if (!json) return;
          var n = Math.ceil(json.length / _SHADOW_CHUNK);
          if (n > _SHADOW_MAX_CHUNKS) return;
          var updates = {};
          updates[prefix + role + ':' + version + ':h'] = JSON.stringify({ n: n, ts: Date.now(), len: json.length });
          for (var i = 0; i < n; i++) {
            updates[prefix + role + ':' + version + ':c' + i] = json.substr(i * _SHADOW_CHUNK, _SHADOW_CHUNK);
          }
          _scriptProps_().setProperties(updates, false);
