      /**
       * Email-template logo workaround. When a logo blob is unavailable
       * (Drive id missing AND URL fallback fails), the email HTML still has
       * `<img src="cid:logoMain"...>` which renders as a broken-image icon.
       * This helper rewrites such img tags into a self-contained CSS text
       * badge ("ИУВ" / "НИИ") so the header always looks complete.
       *
       * @deprecated since v3.33.0 — all email templates were migrated to
       *   inline SVG (no more `cid:` references). This helper is now dead
       *   code; retained only as a safety net should a legacy template
       *   resurface. Do not wire into new flows.
       *
       * @param {string} html      Full email HTML.
       * @param {Object} have      { logoMain:boolean, logoScience:boolean }
       * @return {string} HTML with missing-cid img tags swapped for badges.
       */
      function _rewriteMissingLogoCids_(html, have) {
        if (!html) return html;
        have = have || {};
        var BADGES = {
          logoMain:    { text: 'ИУВ', bg: '#ffffff', fg: '#233874', label: 'ИУ – Варна' },
          logoScience: { text: 'НИИ', bg: '#ffffff', fg: '#159379', label: 'НИИ' }
        };
        Object.keys(BADGES).forEach(function (slot) {
          if (have[slot]) return;
          var b = BADGES[slot];
          // Match the entire <img ... src="cid:<slot>" ...> tag (any order of attrs)
          // and replace with a flat-styled text badge of similar size (64x64).
          var re = new RegExp('<img\\b[^>]*src="cid:' + slot + '"[^>]*>', 'gi');
          var badge =
            '<div style="display:inline-block;width:64px;height:64px;line-height:64px;' +
            'background:' + b.bg + ';color:' + b.fg + ';border-radius:8px;' +
            'font-family:Segoe UI,Roboto,Arial,sans-serif;font-weight:800;font-size:16px;' +
            'text-align:center;letter-spacing:.5px;border:1px solid #e5e7eb;' +
            'box-sizing:border-box" title="' + xmlEscape_(b.label) + '">' + b.text + '</div>';
          html = html.replace(re, badge);
          // Smaller variant (56x56) used inside the OTP email header.
          var re56 = new RegExp('<img\\b[^>]*src="cid:' + slot + '"[^>]*>', 'gi'); // already global, no-op (kept for clarity)
          // No-op: re already matched both 64 and 56 sizes via wildcard attr match.
          re56 = null;
        });
        return html;
      }

