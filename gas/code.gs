      // ── Internal helpers (NOT registered in handler map) ──────

      // Pull a per-project detail list for the report year. Joins Projects ↔
      // Expenses (for spent total). Returns array of { id, code, title, leader,
      // leaderEmail, direction, status, budget, spent, startDate, endDate }.
      function _monGetProjectsListForYear_(year) {
        var out = [];
        try {
          var projData = getProjectsSheet().getDataRange().getValues();
          var expData = getExpensesSheet().getDataRange().getValues();
          var spentByProject = {};
          for (var ei = 1; ei < expData.length; ei++) {
            if (String(expData[ei][EXP_COL.STATUS - 1]).trim() !== 'approved') continue;
            var pid = String(expData[ei][EXP_COL.PROJECT_ID - 1]).trim();
            spentByProject[pid] = (spentByProject[pid] || 0) + (parseFloat(expData[ei][EXP_COL.AMOUNT - 1]) || 0);
          }
          for (var pi = 1; pi < projData.length; pi++) {
            var pYear = String(projData[pi][PROJ_COL.YEAR - 1]).trim();
            if (year && pYear !== String(year)) continue;
            var pid2 = String(projData[pi][PROJ_COL.ID - 1]).trim();
            if (!pid2) continue;
            var budgetRaw = projData[pi][PROJ_COL.BUDGET - 1];
            var budgetTotal = 0;
            if (typeof budgetRaw === 'number') budgetTotal = budgetRaw;
            else if (budgetRaw) {
              // Budget may be JSON {byGroup:..., total:N} or plain number string
              try { var bj = JSON.parse(String(budgetRaw)); if (bj && typeof bj.total==='number') budgetTotal = bj.total; else if (typeof bj==='number') budgetTotal = bj; }
              catch (_) { budgetTotal = parseFloat(String(budgetRaw).replace(/[^\d.\-]/g,'')) || 0; }
            }
            out.push({
              id: pid2,
              code: String(projData[pi][PROJ_COL.PROJECT_CODE - 1]||''),
              title: String(projData[pi][PROJ_COL.TITLE - 1]||''),
              leader: String(projData[pi][PROJ_COL.LEADER_NAME - 1]||''),
              leaderEmail: String(projData[pi][PROJ_COL.LEADER_EMAIL - 1]||''),
              direction: String(projData[pi][PROJ_COL.DIRECTION - 1]||''),
              status: String(projData[pi][PROJ_COL.STATUS - 1]||''),
              year: pYear,
              budget: budgetTotal,
              spent: spentByProject[pid2] || 0,
              startDate: String(projData[pi][PROJ_COL.START_DATE - 1]||''),
              endDate: String(projData[pi][PROJ_COL.END_DATE - 1]||'')
            });
          }
        } catch (e) { console.warn('_monGetProjectsListForYear_: ' + e.message); }
        return out;
      }

      // ────────────────────────────────────────────────────────────
      //  INSTITUTIONAL REPORT AGGREGATOR (chl. 92, al. 3 ZVO)
      //  Builds the 8-section institutional self-audit per the
      //  МОН/НИИ template (Раздели I–VIII), combining financial AND
      //  non-financial aspects from all data sources for a given
      //  reporting period (year + optional date window).
      //  Sections:
      //   I.   Научни и практико-приложни събития (events)
      //   II.  Научни изследвания (research narratives)
      //   III. Научни публикации (publications)
      //   IV.  Проекти и проектни предложения (projects: closed,
      //        ongoing, submitted proposals — w/ budgets)
      //   V.   Експертна дейност (expert activity)
      //   VI.  Партньорства (partners list)
      //   VII. Организация и управление (org & mgmt changes)
      //   VIII.Популяризиране на дейността (promotion)
      //  Plus a financial appendix (totals + cost-group breakdown).
      // ────────────────────────────────────────────────────────────
      function _monAggregateInstitutional_(opts) {
        opts = opts || {};
        var year = String(opts.year || new Date().getFullYear());
        var pStart = opts.periodStart ? new Date(opts.periodStart) : null;
        var pEnd   = opts.periodEnd   ? new Date(opts.periodEnd)   : null;
        var inWindow = function(iso){
          if (!pStart && !pEnd) return true;
          if (!iso) return true;
          var d = new Date(iso); if (isNaN(d.getTime())) return true;
          if (pStart && d < pStart) return false;
          if (pEnd   && d > pEnd)   return false;
          return true;
        };
        var sections = {
          events: [],
          research: [],
          publications: [],
          projects: { completed: [], ongoing: [], proposals: [] },
          expert: [],
          partnerships: [],
          organization: [],
          promotion: []
        };
        var totals = {
          eventsCount: 0, researchCount: 0, publicationsCount: 0,
          projectsCompleted: 0, projectsOngoing: 0, projectsProposals: 0,
          expertCount: 0, partnershipsCount: 0,
          budgetTotal: 0, spentTotal: 0,
          attractedFunds: 0
        };

        // ── Read source sheets defensively (any failure = empty section, never throw) ──
        try {
          var projData = getProjectsSheet().getDataRange().getValues();
          var delData  = getDeliverablesSheet().getDataRange().getValues();
          var expData  = getExpensesSheet().getDataRange().getValues();
          var compData = getCompetitionsSheet().getDataRange().getValues();
          var formData = (function(){ try { return getFormsSheet().getDataRange().getValues(); } catch(_){ return []; } })();

          // Spent map (approved expenses only)
          var spentByProject = {};
          for (var ei = 1; ei < expData.length; ei++) {
            if (String(expData[ei][EXP_COL.STATUS - 1]).trim() !== 'approved') continue;
            var pid_e = String(expData[ei][EXP_COL.PROJECT_ID - 1]).trim();
            var amt_e = parseFloat(expData[ei][EXP_COL.AMOUNT - 1]) || 0;
            spentByProject[pid_e] = (spentByProject[pid_e] || 0) + amt_e;
            totals.spentTotal += amt_e;
          }

          // Build set of project IDs in scope (year-matched)
          var projIdsInScope = {};
          var projectsRich = [];
          for (var pi = 1; pi < projData.length; pi++) {
            // Same orphan/mock guard as generateMONReport — keeps Раздел IV
            // (Проекти и проектни предложения) aligned with reality.
            if (_isOrphanProjectRow_(projData[pi])) continue;
            var pYear = String(projData[pi][PROJ_COL.YEAR - 1]).trim();
            if (year && pYear !== year) continue;
            var pId = String(projData[pi][PROJ_COL.ID - 1]).trim();
            if (!pId) continue;
            projIdsInScope[pId] = true;
            var budgetRaw = projData[pi][PROJ_COL.BUDGET - 1];
            var budgetTotal = 0;
            if (typeof budgetRaw === 'number') budgetTotal = budgetRaw;
            else if (budgetRaw) {
              try { var bj = JSON.parse(String(budgetRaw)); if (bj && typeof bj.total==='number') budgetTotal = bj.total; else if (typeof bj==='number') budgetTotal = bj; }
              catch (_) { budgetTotal = parseFloat(String(budgetRaw).replace(/[^\d.\-]/g,'')) || 0; }
            }
            totals.budgetTotal += budgetTotal;
            var team = [];
            try { var tm = projData[pi][PROJ_COL.TEAM_MEMBERS - 1]; if (tm) { var tparsed = JSON.parse(String(tm)); if (Array.isArray(tparsed)) team = tparsed; } } catch(_){}
            var rec = {
              id: pId,
              code: String(projData[pi][PROJ_COL.PROJECT_CODE - 1]||''),
              title: String(projData[pi][PROJ_COL.TITLE - 1]||''),
              leader: String(projData[pi][PROJ_COL.LEADER_NAME - 1]||''),
              leaderEmail: String(projData[pi][PROJ_COL.LEADER_EMAIL - 1]||''),
              direction: String(projData[pi][PROJ_COL.DIRECTION - 1]||''),
              status: String(projData[pi][PROJ_COL.STATUS - 1]||''),
              startDate: String(projData[pi][PROJ_COL.START_DATE - 1]||''),
              endDate: String(projData[pi][PROJ_COL.END_DATE - 1]||''),
              budget: budgetTotal,
              spent: 0, // filled below
              year: pYear,
              team: team,
              notes: String(projData[pi][PROJ_COL.NOTES - 1]||'')
            };
            rec.spent = spentByProject[pId] || 0;
            rec.utilization = rec.budget > 0 ? (rec.spent / rec.budget * 100) : 0;
            projectsRich.push(rec);
          }

          // ── РАЗДЕЛ IV: Проекти ── (partition by status)
          var closedStates  = ['accepted_closed','closed','successfully_completed','partially_completed','closed_with_sanction','closed_with_restriction','archived'];
          var activeStates  = ['active','in_execution','progress_updated','expense_requested','change_requested','change_under_review','change_approved','contract_signed','contracted','reporting_due','final_reporting'];
          projectsRich.forEach(function(p){
            var item = {
              id: p.id, code: p.code, title: p.title, leader: p.leader, direction: p.direction,
              status: p.status, period: (p.startDate||'—') + ' – ' + (p.endDate||'—'),
              budget: p.budget, spent: p.spent, utilization: p.utilization,
              partners: (p.team||[]).map(function(t){return (t&&(t.name||t.email))||'';}).filter(Boolean),
              attribution: 'Екип на проекта' + (p.leader ? ' (ръководител: ' + p.leader + ')' : '')
            };
            if (closedStates.indexOf(p.status) >= 0) { sections.projects.completed.push(item); totals.projectsCompleted++; }
            else if (activeStates.indexOf(p.status) >= 0) { sections.projects.ongoing.push(item); totals.projectsOngoing++; }
          });

          // Submitted proposals (Forms in admin/review pipeline matched to scope year via Created)
          for (var fi = 1; fi < formData.length; fi++) {
            var fStatus = String(formData[fi][COL.STATUS - 1]||'').toLowerCase();
            var fCreated = String(formData[fi][COL.CREATED - 1]||'');
            if (fCreated && year && fCreated.indexOf(year) === -1) continue;
            if (!inWindow(fCreated)) continue;
            if (['submitted','admin_review','in_review','reviewed','scored','ranked','proposed_for_funding','rejected','approved_for_funding'].indexOf(fStatus) < 0) continue;
            var statusOutcome = (fStatus === 'rejected') ? 'не е одобрено'
                              : (['approved_for_funding','proposed_for_funding'].indexOf(fStatus)>=0 ? 'одобрено' : 'в процес на оценка');
            sections.projects.proposals.push({
              id: String(formData[fi][COL.ID - 1]||''),
              title: String(formData[fi][COL.TITLE - 1]||'(без заглавие)'),
              leader: String(formData[fi][COL.USER_NAME - 1]||''),
              competition: String(formData[fi][COL.COMPETITION - 1]||''),
              status: fStatus, outcome: statusOutcome,
              submitted: String(formData[fi][COL.SUBMITTED - 1]||fCreated),
              attribution: 'НИИ — Икономически университет – Варна'
            });
            totals.projectsProposals++;
          }

          // ── РАЗДЕЛ III: Публикации & Раздел I/V derived from Deliverables ──
          for (var di = 1; di < delData.length; di++) {
            var dProjId = String(delData[di][DEL_COL.PROJECT_ID - 1]).trim();
            if (!projIdsInScope[dProjId]) continue;
            var dStatus = String(delData[di][DEL_COL.STATUS - 1]||'').toLowerCase();
            if (dStatus !== 'completed' && dStatus !== 'accepted') continue;
            var dCompleted = String(delData[di][DEL_COL.COMPLETED_DATE - 1]||delData[di][DEL_COL.CREATED_AT - 1]||'');
            if (!inWindow(dCompleted)) continue;
            var dType  = String(delData[di][DEL_COL.TYPE - 1]||'').toLowerCase();
            var dTitle = String(delData[di][DEL_COL.TITLE - 1]||'(без заглавие)');
            var dDesc  = String(delData[di][DEL_COL.DESCRIPTION - 1]||'');
            var dURL   = String(delData[di][DEL_COL.URL - 1]||'');
            var dMeta  = {};
            try { dMeta = JSON.parse(String(delData[di][DEL_COL.METADATA - 1]||'{}')); } catch(_){}
            var pRef = projectsRich.filter(function(x){return x.id===dProjId;})[0] || {};
            var attrib = pRef.leader ? ('Екип на проект „' + (pRef.title||pRef.code) + '" (' + pRef.leader + ')') : 'НИИ — ИУ – Варна';
            var entry = { type: dType, title: dTitle, description: dDesc, url: dURL, completedDate: dCompleted, projectId: dProjId, projectCode: pRef.code||'', attribution: attrib, metadata: dMeta };
            if (dType === 'publication_scopus' || dType === 'publication_wos' || dType === 'publication_other' || dType === 'monograph') {
              sections.publications.push(entry); totals.publicationsCount++;
            } else if (dType === 'conference') {
              sections.events.push(entry); totals.eventsCount++;
            } else if (dType === 'trl_product' || dType === 'prototype' || dType === 'patent' || dType === 'international_proposal') {
              sections.expert.push(entry); totals.expertCount++;
            }
          }

          // ── РАЗДЕЛ II: Изследвания (research narratives derived from active+completed projects with notes/description) ──
          projectsRich.forEach(function(p){
            if (closedStates.indexOf(p.status) < 0 && activeStates.indexOf(p.status) < 0) return;
            sections.research.push({
              projectId: p.id, projectCode: p.code, title: p.title, direction: p.direction,
              leader: p.leader, period: (p.startDate||'—') + ' – ' + (p.endDate||'—'),
              budget: p.budget, status: p.status,
              description: (p.notes && p.notes.length > 5) ? p.notes : 'Научно-изследователска дейност в рамките на проект „' + (p.title||p.code) + '" под ръководството на ' + (p.leader||'академичния състав') + '.',
              attribution: p.leader ? 'Екип на проекта (ръководител: ' + p.leader + ')' : 'НИИ — ИУ – Варна'
            });
            totals.researchCount++;
          });

          // ── РАЗДЕЛ VI: Партньорства (unique partner names extracted from teams + competitions) ──
          var partnersSet = {};
          projectsRich.forEach(function(p){
            (p.team||[]).forEach(function(t){
              var name = (t && (t.affiliation||t.organization||t.partner||t.org));
              if (name) partnersSet[String(name).trim()] = true;
            });
          });
          Object.keys(partnersSet).forEach(function(name,idx){
            sections.partnerships.push({ index: idx+1, name: name });
            totals.partnershipsCount++;
          });

          // ── РАЗДЕЛ VII: Организация и управление (competition lifecycle events in window) ──
          for (var ci = 1; ci < compData.length; ci++) {
            var cYear = String(compData[ci][COMP_COL.YEAR - 1]).trim();
            if (year && cYear !== year) continue;
            var cCreated = String(compData[ci][COMP_COL.CREATED - 1]||'');
            if (!inWindow(cCreated)) continue;
            sections.organization.push({
              type: 'competition_lifecycle',
              description: 'Обявен и проведен конкурс „' + String(compData[ci][COMP_COL.NAME - 1]||'') + '" (' + String(compData[ci][COMP_COL.CALL_TYPE - 1]||'') + ', статус: ' + String(compData[ci][COMP_COL.STATUS - 1]||'') + ')',
              createdAt: cCreated,
              attribution: 'ЦКК / НИИ — ИУ – Варна'
            });
          }

          // ── РАЗДЕЛ VIII: Популяризиране — derive from published competitions count ──
          var publishedComps = 0;
          for (var ck = 1; ck < compData.length; ck++) {
            var st_c = String(compData[ck][COMP_COL.STATUS - 1]||'').toLowerCase();
            if (['published','open_for_submission','active'].indexOf(st_c) >= 0) publishedComps++;
          }
          if (publishedComps > 0) {
            sections.promotion.push({
              description: 'Публикувани и популяризирани ' + publishedComps + ' конкурса за финансиране на проекти на уебстраницата на НИИ и в академичната общност.',
              attribution: 'Административен екип на НИИ'
            });
          }
          sections.promotion.push({
            description: 'Текущо информиране на академичния състав за предстоящи научни конференции, срещи и обучения чрез вътрешната ERP система.',
            attribution: 'Административен екип на НИИ'
          });

        } catch (eAgg) {
          console.warn('_monAggregateInstitutional_ partial failure: ' + eAgg.message);
        }

        // ── Derived KPI block (institutional math, all defensive against /0) ──
        var allProjects = sections.projects.completed.concat(sections.projects.ongoing);
        var projectCount = allProjects.length || 0;
        var sumUtil = 0; var perfectClosures = 0;
        allProjects.forEach(function(p){
          var u = Number(p.utilization||0); sumUtil += u;
          if (u >= 95 && u <= 105) perfectClosures++;
        });
        var avgUtilization = projectCount > 0 ? (sumUtil / projectCount) : 0;
        var avgBudget = projectCount > 0 ? (totals.budgetTotal / projectCount) : 0;
        var avgSpent  = projectCount > 0 ? (totals.spentTotal  / projectCount) : 0;
        var globalUtilization = totals.budgetTotal > 0 ? (totals.spentTotal / totals.budgetTotal * 100) : 0;
        var completionRate = (totals.projectsCompleted + totals.projectsOngoing) > 0
          ? (totals.projectsCompleted / (totals.projectsCompleted + totals.projectsOngoing) * 100) : 0;
        var proposalApprovalRate = totals.projectsProposals > 0
          ? (sections.projects.proposals.filter(function(p){return p.outcome==='одобрено';}).length / totals.projectsProposals * 100) : 0;
        var pubPerProject = projectCount > 0 ? (totals.publicationsCount / projectCount) : 0;
        var unspentBudget = Math.max(0, totals.budgetTotal - totals.spentTotal);
        var derived = {
          projectCount: projectCount,
          avgUtilizationPct: Math.round(avgUtilization * 100) / 100,
          globalUtilizationPct: Math.round(globalUtilization * 100) / 100,
          completionRatePct: Math.round(completionRate * 100) / 100,
          proposalApprovalPct: Math.round(proposalApprovalRate * 100) / 100,
          avgBudgetPerProject: Math.round(avgBudget * 100) / 100,
          avgSpentPerProject:  Math.round(avgSpent  * 100) / 100,
          publicationsPerProject: Math.round(pubPerProject * 100) / 100,
          perfectClosures: perfectClosures,
          unspentBudget: Math.round(unspentBudget * 100) / 100,
          deliverablesTotal: (totals.publicationsCount + totals.eventsCount + totals.expertCount)
        };

        return {
          institutionalCompliant: true,
          templateRef: 'НИИ — ИУ Варна — отчет по чл. 92, ал. 3 ЗВО (8-секционен формат)',
          year: year,
          periodStart: opts.periodStart || '',
          periodEnd: opts.periodEnd || '',
          sections: sections,
          totals: totals,
          derived: derived,
          signatory: {
            title: INSTITUTION.rectorTitle,
            institution: INSTITUTION.legalName_bg,
            location: 'гр. Варна',
            date: nowISO().slice(0,10)
          }
        };
      }

      // Synthesize a digital seal SVG (rendered as PNG base64) when no manual
      // signature image was uploaded. Embeds institution short-name, signer
      // email, ISO timestamp, and a short content hash — matching the visible
      // signature payload that gets stored in MON_COL.SIGNATURE_HASH.
      function _monAutoGenerateSeal_(reportId, signerEmail, ts, contentHash) {
        var label = INSTITUTION.shortName + ' • ' + (signerEmail||'') + ' • ' + (ts||nowISO());
        var hashShort = String(contentHash||'').substring(0, 24);
        // Build a compact SVG (will be base64-embedded as image/svg+xml).
        var svg = '<svg xmlns="http://www.w3.org/2000/svg" width="540" height="180" viewBox="0 0 540 180">'
          + '<rect x="6" y="6" width="528" height="168" fill="#fafbff" stroke="#233874" stroke-width="3" rx="10"/>'
          + '<circle cx="78" cy="90" r="56" fill="none" stroke="#233874" stroke-width="3"/>'
          + '<text x="78" y="78" text-anchor="middle" font-family="Arial,sans-serif" font-size="11" font-weight="700" fill="#233874">ИУ</text>'
          + '<text x="78" y="94" text-anchor="middle" font-family="Arial,sans-serif" font-size="9" fill="#233874">ВАРНА</text>'
          + '<text x="78" y="108" text-anchor="middle" font-family="Arial,sans-serif" font-size="7" fill="#233874">МОН отчет</text>'
          + '<text x="160" y="38" font-family="Arial,sans-serif" font-size="11" font-weight="700" fill="#16234A">ЕЛЕКТРОНЕН ПЕЧАТ / DIGITAL SEAL</text>'
          + '<text x="160" y="60" font-family="Arial,sans-serif" font-size="9" fill="#333">Отчет ID: ' + _xmlEscape_(reportId) + '</text>'
          + '<text x="160" y="78" font-family="Arial,sans-serif" font-size="9" fill="#333">Подписващ: ' + _xmlEscape_(signerEmail||'') + '</text>'
          + '<text x="160" y="96" font-family="Arial,sans-serif" font-size="9" fill="#333">Времеви печат: ' + _xmlEscape_(ts||nowISO()) + '</text>'
          + '<text x="160" y="114" font-family="Courier New,monospace" font-size="8" fill="#666">SHA-256: ' + _xmlEscape_(hashShort) + '…</text>'
          + '<text x="160" y="138" font-family="Arial,sans-serif" font-size="8" font-style="italic" fill="#233874">Удостоверение по чл. 13 ЗЕДЕУУ — ' + _xmlEscape_(INSTITUTION.legalName_bg) + '</text>'
          + '<text x="160" y="156" font-family="Arial,sans-serif" font-size="8" fill="#888">' + _xmlEscape_(INSTITUTION.address) + ' • ЕИК ' + _xmlEscape_(INSTITUTION.eik) + '</text>'
          + '</svg>';
        return 'data:image/svg+xml;base64,' + Utilities.base64Encode(svg);
      }
      function _xmlEscape_(s){ return String(s||'').replace(/[<>&"']/g,function(c){return {'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;',"'":'&apos;'}[c];}); }

      // Dedicated audit hook for MON document lifecycle events. Pipes into the
      // hash-chained AuditLog (via logTransaction) AND tags the entry with the
      // generated file id + content hash for legal traceability.
      function _logMonDocAudit_(reportId, action, fileId, signerEmail, contentHash, details) {
        try {
          var payload = Object.assign({
            fileId: fileId || '',
            fileUrl: fileId ? ('https://drive.google.com/file/d/' + fileId + '/view') : '',
            contentHash: contentHash || '',
            institution: INSTITUTION.legalName_bg,
            eik: INSTITUTION.eik,
            ts: nowISO()
          }, details || {});
          logTransaction(action, signerEmail || 'system', reportId, payload);
        } catch (e) { console.warn('_logMonDocAudit_ failed: ' + e.message); }
      }

      // ════════════════════════════════════════════════════════════
      //  MON Drive folder organisation + dedup helpers (v3.5.0)
      //  Files generated by MON pipeline land under a deterministic
      //  hierarchy:  <DRIVE_FOLDER_ID>/MON-Отчети/<year>/   so the
      //  Rector's "Моят диск" never accumulates orphan duplicates.
      //  When the same report is regenerated, the previous Drive file
      //  is trashed BEFORE the cell is rewritten with the new ID.
      // ════════════════════════════════════════════════════════════
      function _monGetReportFolder_(year) {
        var y = String(year || new Date().getFullYear());
        var props = null; try { props = _scriptProps_(); } catch (_) {}
        var cacheKey = 'MON_FOLDER_' + y;
        if (props) { try { var cached = props.getProperty(cacheKey); if (cached) { try { return DriveApp.getFolderById(cached); } catch (_) {} } } catch (_) {}
        }
        var root;
        try { root = DriveApp.getFolderById(DRIVE_FOLDER_ID); }
        catch (_) { root = DriveApp.getRootFolder(); }
        var monIt = root.getFoldersByName('MON-Отчети');
        var monRoot = monIt.hasNext() ? monIt.next() : root.createFolder('MON-Отчети');
        var yIt = monRoot.getFoldersByName(y);
        var yFolder = yIt.hasNext() ? yIt.next() : monRoot.createFolder(y);
        if (props) { try { props.setProperty(cacheKey, yFolder.getId()); } catch (_) {} }
        return yFolder;
      }
      /** Move a freshly created file into the year folder and trash the previous
       *  artefact (if a Drive ID was passed). Robust against deleted/missing
       *  oldFileId. Returns the (now-organised) newFileId for chaining. */
      function _monMoveAndReplace_(newFileId, oldFileId, year) {
        try {
          var folder = _monGetReportFolder_(year);
          var f = DriveApp.getFileById(newFileId);
          // Apps Script Drive API: addFile/removeFile from each parent.
          var parents = f.getParents();
          while (parents.hasNext()) { try { parents.next().removeFile(f); } catch (_) {} }
          folder.addFile(f);
        } catch (mvErr) { console.warn('_monMoveAndReplace_ move failed: ' + mvErr.message); }
        if (oldFileId && oldFileId !== newFileId) {
          try { DriveApp.getFileById(oldFileId).setTrashed(true); }
          catch (trashErr) { /* old file may already be gone — non-fatal */ }
        }
        return newFileId;
      }

      function _generateMONReportPdf_(reportId) {
        var found = _monFindById_(reportId);
        if (!found) throw new Error('Report not found');
        var data = _monParseJson_(found.rowData[MON_COL.EDITED_DATA - 1], {});
        if (!data || !data.competitions) {
          // Fallback: regenerate snapshot if EDITED_DATA empty.
          try {
            var snap = generateMONReport({ year: parseInt(found.rowData[MON_COL.YEAR - 1],10), reportType: String(found.rowData[MON_COL.REPORT_TYPE - 1]), period: String(found.rowData[MON_COL.PERIOD - 1]) });
            if (snap && snap.success) data = snap;
          } catch (_){}
        }
        var year = String(found.rowData[MON_COL.YEAR - 1]||'');
        var period = String(found.rowData[MON_COL.PERIOD - 1]||'');
        var rType = String(found.rowData[MON_COL.REPORT_TYPE - 1]||'');
        var prevPdfId = String(found.rowData[MON_COL.EXPORT_FILE_ID - 1]||'').trim();
        var projectsList = _monGetProjectsListForYear_(year);

        var doc = DocumentApp.create('МОН-Отчет-PDF-' + reportId + '-' + year);
        var body = doc.getBody();
        body.setMarginTop(36).setMarginBottom(36).setMarginLeft(40).setMarginRight(40);

        // ════════════════════════════════════════════════════════════
        //  COVER PAGE — 1:1 mirror of НИИ 2022 institutional template
        //  (attached sample). Layout:
        //    • Two centred logos at top: ИУ – Варна main logo + НИИ
        //      science seal, side-by-side in a borderless 1×2 table.
        //    • Vertical breathing room.
        //    • Three-line bold caps title in serif:
        //         „ОТЧЕТ ЗА ДЕЙНОСТТА
        //          НА НАУЧНОИЗСЛЕДОВАТЕЛСКИ ИНСТИТУТ
        //          КЪМ ИКОНОМИЧЕСКИ УНИВЕРСИТЕТ – ВАРНА“
        //    • Year line in bold („2025 г.“) — matches sample's „2022 г.“
        //    • Hard page-break to body.
        // ════════════════════════════════════════════════════════════
        var mainLogoBlob    = _getMainLogoBlob_();
        var scienceLogoBlob = _getScienceLogoBlob_();
        // Spacer paragraphs to push the logo block below the top margin.
        for (var _pad = 0; _pad < 2; _pad++) body.appendParagraph('');
        // Two-logo row in a borderless table (one logo per cell, both centered).
        var coverLogoTbl = body.appendTable([['', '']]);
        coverLogoTbl.setBorderWidth(0);
        var coverLeftCell  = coverLogoTbl.getCell(0,0);
        var coverRightCell = coverLogoTbl.getCell(0,1);
        try { coverLeftCell.getChild(0).asParagraph().setAlignment(DocumentApp.HorizontalAlignment.CENTER); } catch(_){}
        try { coverRightCell.getChild(0).asParagraph().setAlignment(DocumentApp.HorizontalAlignment.CENTER); } catch(_){}
        try {
          if (mainLogoBlob) {
            var mImg = coverLeftCell.appendImage(mainLogoBlob);
            mImg.setWidth(170).setHeight(170);
          } else if (scienceLogoBlob) {
            // If only one logo is configured, still render it on the left so
            // single-logo tenants don't see an empty cell.
            var mImgFb = coverLeftCell.appendImage(scienceLogoBlob);
            mImgFb.setWidth(170).setHeight(170);
          }
        } catch(_){}
        try {
          if (scienceLogoBlob && mainLogoBlob && scienceLogoBlob !== mainLogoBlob) {
            var sImg = coverRightCell.appendImage(scienceLogoBlob);
            sImg.setWidth(170).setHeight(170);
          } else if (!mainLogoBlob && scienceLogoBlob) {
            // Single-logo fallback: keep the right cell empty.
          }
        } catch(_){}
        for (var _pad2 = 0; _pad2 < 6; _pad2++) body.appendParagraph('');
        var _coverFont = 'Cambria';
        var titleLine1 = body.appendParagraph('ОТЧЕТ ЗА ДЕЙНОСТТА');
        titleLine1.setAlignment(DocumentApp.HorizontalAlignment.CENTER).setBold(true).setFontSize(20).setFontFamily(_coverFont);
        var titleLine2 = body.appendParagraph('НА НАУЧНОИЗСЛЕДОВАТЕЛСКИ ИНСТИТУТ');
        titleLine2.setAlignment(DocumentApp.HorizontalAlignment.CENTER).setBold(true).setFontSize(18).setFontFamily(_coverFont);
        var titleLine3 = body.appendParagraph('КЪМ ' + (INSTITUTION.legalName_bg || 'ИКОНОМИЧЕСКИ УНИВЕРСИТЕТ – ВАРНА').toUpperCase());
        titleLine3.setAlignment(DocumentApp.HorizontalAlignment.CENTER).setBold(true).setFontSize(18).setFontFamily(_coverFont);
        body.appendParagraph('');
        var yearLine = body.appendParagraph(year + ' г.');
        yearLine.setAlignment(DocumentApp.HorizontalAlignment.CENTER).setBold(true).setFontSize(18).setFontFamily(_coverFont);
        body.appendPageBreak();

        // ── Branded header on body page (compact: small main logo + requisites) ──
        var headerLogoBlob = mainLogoBlob || scienceLogoBlob;
        var headerTbl = body.appendTable([['','']]);
        headerTbl.setBorderWidth(0);
        var leftCell = headerTbl.getCell(0,0); leftCell.setWidth(110);
        try { if (headerLogoBlob) leftCell.appendImage(headerLogoBlob).setWidth(90).setHeight(90); }
        catch(_){ leftCell.appendParagraph('[ЛОГО]').setBold(true); }
        var rightCell = headerTbl.getCell(0,1);
        var nameP = rightCell.appendParagraph(INSTITUTION.legalName_bg);
        nameP.setHeading(DocumentApp.ParagraphHeading.HEADING2).setBold(true);
        rightCell.appendParagraph(INSTITUTION.legalName_en).setItalic(true);
        rightCell.appendParagraph(INSTITUTION.address);
        rightCell.appendParagraph('ЕИК: ' + INSTITUTION.eik + ' • Институционален код към МОН: ' + INSTITUTION.mes_code);
        rightCell.appendParagraph(INSTITUTION.website + ' • ' + INSTITUTION.email);

        body.appendHorizontalRule();
        body.appendParagraph('ОТЧЕТ ЗА НАУЧНОИЗСЛЕДОВАТЕЛСКАТА ДЕЙНОСТ').setHeading(DocumentApp.ParagraphHeading.TITLE).setAlignment(DocumentApp.HorizontalAlignment.CENTER);
        body.appendParagraph('по чл. 92, ал. 3 ЗВО и Наредба за условията и реда за оценката, планирането, разпределението и разходването на средствата от държавния бюджет за финансиране на присъщата на държавните висши училища научна или художественотворческа дейност').setItalic(true).setFontSize(9).setAlignment(DocumentApp.HorizontalAlignment.CENTER);
        body.appendParagraph('');
        var metaTbl = body.appendTable([
          ['Идентификатор на отчета:', reportId],
          ['Тип отчет:', rType],
          ['Отчетен период:', period],
          ['Отчетна година:', year],
          ['Издаващо звено:', INSTITUTION.issuingBody],
          ['Дата на генериране:', nowISO()]
        ]);
        metaTbl.setBorderWidth(1).setBorderColor('#cccccc');
        body.appendParagraph('');

        // ════════════════════════════════════════════════════════════
        //  Institutional 8-section render (per НИИ template & чл.92,
        //  ал.3 ЗВО). Falls back to compact stats if `institutional`
        //  block is missing from the snapshot.
        // ════════════════════════════════════════════════════════════
        var inst = data.institutional || null;
        // Apply red header chrome to a FULL-WIDTH single-cell table so the bar
        // renders as a continuous dark-red band (1:1 with НИИ 2022 sample),
        // instead of a text-background highlight that wraps mid-line.
        var sectionStyle = function(p){
          try {
            // The caller passes a paragraph holding the title text. We promote
            // it to a banner: insert a 1×1 bordered table directly before it,
            // copy the title text into the table cell with red-bg/white-fg/bold,
            // then remove the original paragraph. This produces a uniform
            // dark-red rectangle that always spans the full content width.
            var titleText = p.getText() || '';
            var pIdx = body.getChildIndex(p);
            var bannerTbl = body.insertTable(pIdx, [[titleText]]);
            bannerTbl.setBorderWidth(0);
            var cell = bannerTbl.getCell(0,0);
            // Cell padding for breathing room (Apps Script API in pt).
            try { cell.setPaddingTop(4).setPaddingBottom(4).setPaddingLeft(8).setPaddingRight(8); } catch(_){}
            cell.setBackgroundColor('#7B0000');
            var cellPara = cell.getChild(0).asParagraph();
            var t = cellPara.editAsText();
            var len = t.getText().length;
            if (len > 0) {
              var attrs = {};
              attrs[DocumentApp.Attribute.BACKGROUND_COLOR] = '#7B0000';
              attrs[DocumentApp.Attribute.FOREGROUND_COLOR] = '#ffffff';
              attrs[DocumentApp.Attribute.BOLD] = true;
              attrs[DocumentApp.Attribute.FONT_SIZE] = 12;
              attrs[DocumentApp.Attribute.FONT_FAMILY] = 'Cambria';
              attrs[DocumentApp.Attribute.UNDERLINE] = false;
              attrs[DocumentApp.Attribute.ITALIC] = false;
              t.setAttributes(0, len - 1, attrs);
            }
            // Remove the original (now-redundant) paragraph that was promoted.
            try { body.removeChild(p); } catch(_){}
            return cellPara;
          } catch(_){ return p; }
        };
        // Body paragraph normalizer — guarantees clean ink-on-white styling so
        // no header chrome can bleed into rows of body text.
        var bodyP = function(p){
          try {
            var attrs = {};
            attrs[DocumentApp.Attribute.BACKGROUND_COLOR] = null;
            attrs[DocumentApp.Attribute.FOREGROUND_COLOR] = '#1a1a2e';
            attrs[DocumentApp.Attribute.BOLD] = false;
            attrs[DocumentApp.Attribute.ITALIC] = false;
            attrs[DocumentApp.Attribute.UNDERLINE] = false;
            p.setAttributes(attrs);
          } catch(_){}
          return p;
        };
        var attrItalic = function(p){
          try {
            var attrs = {};
            attrs[DocumentApp.Attribute.BACKGROUND_COLOR] = null;
            attrs[DocumentApp.Attribute.FOREGROUND_COLOR] = '#555555';
            attrs[DocumentApp.Attribute.ITALIC] = true;
            attrs[DocumentApp.Attribute.UNDERLINE] = false;
            attrs[DocumentApp.Attribute.BOLD] = false;
            p.setAttributes(attrs);
            p.setAlignment(DocumentApp.HorizontalAlignment.RIGHT);
          } catch(_){}
          return p;
        };
        // Empty-state line — italic muted gray, no inherited chrome.
        var emptyP = function(text){
          var p = body.appendParagraph(text);
          try {
            var attrs = {};
            attrs[DocumentApp.Attribute.BACKGROUND_COLOR] = null;
            attrs[DocumentApp.Attribute.FOREGROUND_COLOR] = '#777777';
            attrs[DocumentApp.Attribute.ITALIC] = true;
            attrs[DocumentApp.Attribute.UNDERLINE] = false;
            attrs[DocumentApp.Attribute.BOLD] = false;
            p.setAttributes(attrs);
          } catch(_){}
          return p;
        };

        // Monkey-patch body.appendParagraph so EVERY body line is normalized to
        // ink-on-white via bodyP() — prevents the dark-red header chrome from
        // bleeding forward into following paragraphs (root cause of the
        // "red-underlined unreadable отчет body" bug). Section headers still
        // override via text-range attrs in sectionStyle(), so they render red.
        var _appendOrig = body.appendParagraph.bind(body);
        body.appendParagraph = function(text){ return bodyP(_appendOrig(text)); };

        if (inst && inst.sections) {
          var S = inst.sections;

          // ── РАЗДЕЛ I: Научни и практико-приложни събития ──
          sectionStyle(body.appendParagraph('I. НАУЧНИ И ПРАКТИКО-ПРИЛОЖНИ СЪБИТИЯ'));
          if (S.events && S.events.length) {
            S.events.forEach(function(ev,i){
              body.appendParagraph((i+1)+'. ' + (ev.title||'(без заглавие)') + (ev.description?(' — ' + ev.description):''));
              attrItalic(body.appendParagraph('Реализирал дейността: ' + (ev.attribution||'НИИ — ИУ – Варна')));
            });
          } else {
            body.appendParagraph('През отчетния период не са регистрирани събития в информационната система.').setItalic(true).setForegroundColor('#777777');
          }

          // ── РАЗДЕЛ II: Научни изследвания ──
          body.appendParagraph('');
          sectionStyle(body.appendParagraph('II. НАУЧНИ ИЗСЛЕДВАНИЯ'));
          if (S.research && S.research.length) {
            S.research.forEach(function(r,i){
              body.appendParagraph((i+1)+'. ' + (r.description||r.title));
              body.appendParagraph('   Период: ' + r.period + ' • Бюджет: ' + (Number(r.budget||0) / 1.95583).toFixed(2) + ' € • Статус: ' + r.status).setFontSize(9);
              attrItalic(body.appendParagraph('Реализирал дейността: ' + (r.attribution||'НИИ — ИУ – Варна')));
            });
          } else {
            body.appendParagraph('През отчетния период не са регистрирани активни научни изследвания.').setItalic(true).setForegroundColor('#777777');
          }

          // ── РАЗДЕЛ III: Научни публикации ──
          body.appendParagraph('');
          sectionStyle(body.appendParagraph('III. НАУЧНИ ПУБЛИКАЦИИ'));
          if (S.publications && S.publications.length) {
            var pubTypeLbl = { publication_scopus:'Scopus', publication_wos:'Web of Science', publication_other:'Друга публикация', monograph:'Монография' };
            S.publications.forEach(function(p,i){
              var tag = pubTypeLbl[p.type] || p.type;
              body.appendParagraph((i+1)+'. [' + tag + '] ' + p.title + (p.url?(' — ' + p.url):''));
              if (p.description) body.appendParagraph('   ' + p.description).setFontSize(9);
              attrItalic(body.appendParagraph('Реализирал дейността: ' + (p.attribution||'НИИ — ИУ – Варна')));
            });
          } else {
            body.appendParagraph('През отчетния период не са регистрирани приключени публикации.').setItalic(true).setForegroundColor('#777777');
          }

          // ── РАЗДЕЛ IV: Проекти и проектни предложения ──
          body.appendParagraph('');
          sectionStyle(body.appendParagraph('IV. ПРОЕКТИ И ПРОЕКТНИ ПРЕДЛОЖЕНИЯ'));
          // (а) Приключили
          body.appendParagraph('Приключили проекти').setBold(true).setUnderline(true);
          if (S.projects && S.projects.completed && S.projects.completed.length) {
            S.projects.completed.forEach(function(p,i){
              body.appendParagraph((i+1)+'. „' + p.title + '" (код: ' + (p.code||'—') + ')');
              body.appendParagraph('   Ръководител: ' + (p.leader||'—') + ' • Направление: ' + (p.direction||'—') + ' • Период: ' + p.period).setFontSize(9);
              body.appendParagraph('   Бюджет: ' + (Number(p.budget||0) / 1.95583).toFixed(2) + ' € • Изразходвани: ' + (Number(p.spent||0) / 1.95583).toFixed(2) + ' € (' + Number(p.utilization||0).toFixed(2) + '%)').setFontSize(9);
              attrItalic(body.appendParagraph('Реализирал дейността: ' + p.attribution));
            });
          } else { body.appendParagraph('Няма приключени проекти за отчетния период.').setItalic(true).setForegroundColor('#777777'); }

          // (б) Текущи
          body.appendParagraph('');
          body.appendParagraph('Текущи проекти').setBold(true).setUnderline(true);
          if (S.projects && S.projects.ongoing && S.projects.ongoing.length) {
            S.projects.ongoing.forEach(function(p,i){
              body.appendParagraph((i+1)+'. „' + p.title + '" (код: ' + (p.code||'—') + ')');
              body.appendParagraph('   Ръководител: ' + (p.leader||'—') + ' • Период: ' + p.period + ' • Статус: ' + p.status).setFontSize(9);
              body.appendParagraph('   Бюджет: ' + (Number(p.budget||0) / 1.95583).toFixed(2) + ' € • Усвоени: ' + (Number(p.spent||0) / 1.95583).toFixed(2) + ' € (' + Number(p.utilization||0).toFixed(2) + '%)').setFontSize(9);
              attrItalic(body.appendParagraph('Реализирал дейността: ' + p.attribution));
            });
          } else { body.appendParagraph('Няма активни проекти за отчетния период.').setItalic(true).setForegroundColor('#777777'); }

          // (в) Изготвени и подадени проектни предложения
          body.appendParagraph('');
          body.appendParagraph('Изготвени и подадени проектни предложения').setBold(true).setUnderline(true);
          if (S.projects && S.projects.proposals && S.projects.proposals.length) {
            S.projects.proposals.forEach(function(p,i){
              body.appendParagraph((i+1)+'. Проектно предложение „' + p.title + '" — конкурс: ' + (p.competition||'—') + '. Изход: ' + p.outcome + '.');
              attrItalic(body.appendParagraph('Реализирал дейността: ' + p.attribution));
            });
          } else { body.appendParagraph('Няма подадени проектни предложения за отчетния период.').setItalic(true).setForegroundColor('#777777'); }

          // ── РАЗДЕЛ V: Експертна дейност ──
          body.appendParagraph('');
          sectionStyle(body.appendParagraph('V. ЕКСПЕРТНА ДЕЙНОСТ'));
          if (S.expert && S.expert.length) {
            S.expert.forEach(function(x,i){
              body.appendParagraph((i+1)+'. ' + x.title + (x.description?(' — ' + x.description):''));
              attrItalic(body.appendParagraph('Реализирал дейността: ' + (x.attribution||'НИИ — ИУ – Варна')));
            });
          } else { body.appendParagraph('През отчетния период не е регистрирана експертна дейност.').setItalic(true).setForegroundColor('#777777'); }

          // ── РАЗДЕЛ VI: Партньорства ──
          body.appendParagraph('');
          sectionStyle(body.appendParagraph('VI. ПАРТНЬОРСТВА'));
          if (S.partnerships && S.partnerships.length) {
            S.partnerships.forEach(function(pp){ body.appendParagraph(pp.index + '. ' + pp.name); });
          } else { body.appendParagraph('Няма регистрирани партньорства за отчетния период.').setItalic(true).setForegroundColor('#777777'); }

          // ── РАЗДЕЛ VII: Организация и управление ──
          body.appendParagraph('');
          sectionStyle(body.appendParagraph('VII. ОРГАНИЗАЦИЯ И УПРАВЛЕНИЕ'));
          if (S.organization && S.organization.length) {
            S.organization.forEach(function(o,i){
              body.appendParagraph((i+1)+'. ' + o.description);
              attrItalic(body.appendParagraph('Реализирал дейността: ' + (o.attribution||'НИИ — ИУ – Варна')));
            });
          } else { body.appendParagraph('Няма регистрирани организационни промени за отчетния период.').setItalic(true).setForegroundColor('#777777'); }

          // ── РАЗДЕЛ VIII: Популяризиране ──
          body.appendParagraph('');
          sectionStyle(body.appendParagraph('VIII. ПОПУЛЯРИЗИРАНЕ НА ДЕЙНОСТТА'));
          if (S.promotion && S.promotion.length) {
            S.promotion.forEach(function(pr,i){
              body.appendParagraph((i+1)+'. ' + pr.description);
              attrItalic(body.appendParagraph('Реализирал дейността: ' + (pr.attribution||'Административен екип на НИИ')));
            });
          }

          // ── ФИНАНСОВО ПРИЛОЖЕНИЕ (mandatory annex) ──
          body.appendParagraph('');
          sectionStyle(body.appendParagraph('ФИНАНСОВО ПРИЛОЖЕНИЕ'));
          var fin0 = data.financials || {}; var totSpent0 = Number(fin0.totalSpent||0);
          body.appendParagraph('Общ бюджет на проектите в обхвата: ' + (Number(inst.totals.budgetTotal||0) / 1.95583).toFixed(2) + ' €').setBold(true);
          body.appendParagraph('Общо изразходвани одобрени средства: ' + (Number(inst.totals.spentTotal||0) / 1.95583).toFixed(2) + ' €').setBold(true);
          var finRows0 = [['Група разходи','Сума (€)','Дял (%)']];
          var fByGroup0 = fin0.byGroup || {};
          Object.keys(fByGroup0).forEach(function(k){
            var amt0 = Number(fByGroup0[k]||0);
            var pct0 = totSpent0>0 ? ((amt0/totSpent0)*100).toFixed(2) : '0.00';
            finRows0.push([k, (amt0/1.95583).toFixed(2), pct0 + '%']);
          });
          if (finRows0.length === 1) finRows0.push(['—','0.00','0.00%']);
          var ftbl0 = body.appendTable(finRows0); ftbl0.getRow(0).editAsText().setBold(true); ftbl0.setBorderWidth(0.5);

        } else {
          // Legacy compact rendering (fallback when institutional block missing)
          body.appendParagraph('РАЗДЕЛ I — Конкурси: общо ' + ((data.competitions||{}).total||0));
          body.appendParagraph('РАЗДЕЛ II — Проекти: общо ' + ((data.projects||{}).total||0));
          body.appendParagraph('РАЗДЕЛ III — Изразходвани средства: ' + (Number((data.financials||{}).totalSpent||0) / 1.95583).toFixed(2) + ' €.');
        }

        // ── РАЗДЕЛ ПОДПИС: Декларация и подпис ──
        body.appendParagraph('');
        body.appendParagraph('ДЕКЛАРАЦИЯ И ПОДПИС').setHeading(DocumentApp.ParagraphHeading.HEADING2);
        body.appendParagraph('Долуподписаният(ата) ' + INSTITUTION.rectorTitle + ' на ' + INSTITUTION.legalName_bg + ' декларирам, че настоящият отчет е изготвен на базата на действителни данни от информационната система на ' + INSTITUTION.shortName + ' и отговаря на изискванията на чл. 92, ал. 3 ЗВО и подзаконовите нормативни актове.');
        body.appendParagraph('');
        var sigTbl = body.appendTable([
          ['Длъжност:', INSTITUTION.rectorTitle + ' на ' + INSTITUTION.legalName_bg],
          ['Дата:', (inst && inst.signatory && inst.signatory.date) || nowISO().slice(0,10)],
          ['Локация:', (inst && inst.signatory && inst.signatory.location) || 'гр. Варна'],
          ['Подпис / Електронен печат:', '________________________']
        ]);
        sigTbl.setBorderWidth(0);

        // ── Footer: Audit trail ──
        body.appendHorizontalRule();
        var auditP = body.appendParagraph('Документът е генериран автоматично от ERP системата на ' + INSTITUTION.shortName + '. Идентификатор на отчета: ' + reportId + '. Времеви печат на генериране: ' + nowISO() + '. Хеш-верига на одита се проверява чрез действие „auditverifychain".');
        auditP.setFontSize(8).setItalic(true).setForegroundColor('#666666');

        doc.saveAndClose();
        var fileId = doc.getId();
        try {
          var file = DriveApp.getFileById(fileId);
          file.setSharing(DriveApp.Access.DOMAIN_WITH_LINK, DriveApp.Permission.VIEW);
        } catch (_) {}

        // Organise into MON-Отчети/<year>/ and trash previous PDF (dedup)
        try { _monMoveAndReplace_(fileId, prevPdfId, year); } catch (_) {}
        // Mirror the new fileId back into the row immediately so a parallel
        // call can't race-create another duplicate.
        try { found.sheet.getRange(found.rowIndex, MON_COL.EXPORT_FILE_ID).setValue(fileId); } catch (_) {}

        // Audit
        var contentHash = sha256Hex_(reportId + '|pdf|' + JSON.stringify(data) + '|' + nowISO());
        _logMonDocAudit_(reportId, 'MON_DOC_GENERATED_PDF', fileId, '', contentHash, { sectionsCount: 6, projectsCount: projectsList.length, replacedPrev: !!prevPdfId });
        return fileId;
      }

      function _generateMONReportXlsx_(reportId) {
        var found = _monFindById_(reportId);
        if (!found) throw new Error('Report not found');
        var data = _monParseJson_(found.rowData[MON_COL.EDITED_DATA - 1], {});
        if (!data || !data.competitions) {
          try {
            var snap = generateMONReport({ year: parseInt(found.rowData[MON_COL.YEAR - 1],10), reportType: String(found.rowData[MON_COL.REPORT_TYPE - 1]), period: String(found.rowData[MON_COL.PERIOD - 1]) });
            if (snap && snap.success) data = snap;
          } catch (_) {}
        }
        var year = String(found.rowData[MON_COL.YEAR - 1]||'');
        var period = String(found.rowData[MON_COL.PERIOD - 1]||'');
        var rType = String(found.rowData[MON_COL.REPORT_TYPE - 1]||'');
        var prevXlsxId = String(found.rowData[MON_COL.EXPORT_XLSX_ID - 1]||'').trim();
        var projectsList = _monGetProjectsListForYear_(year);

        var ss = SpreadsheetApp.create('МОН-Отчет-XLSX-' + reportId + '-' + year);

        // ───── Sheet 1: Титулна страница ─────
        // Brand-correct cover: BOTH institutional logos (main ИУ–Варна + НИИ
        // science seal) side-by-side, mirroring the official PDF cover. This
        // turns the workbook into a recognisably-official "отчетен документ"
        // matching the НИИ 2022 institutional template the PDF already uses.
        var sh1 = ss.getActiveSheet().setName('Титулна');
        sh1.setColumnWidth(1, 30).setColumnWidth(2, 220).setColumnWidth(3, 220).setColumnWidth(4, 220);
        try {
          var mainBlobX = _getMainLogoBlob_();
          var sciBlobX  = _getScienceLogoBlob_();
          // Reserve a tall row so the inserted images don't overflow into meta.
          sh1.setRowHeight(2, 140);
          if (mainBlobX) {
            // Main logo on the LEFT (cell B2).
            sh1.insertImage(mainBlobX, 2, 2, 4, 4).setWidth(120).setHeight(120);
          }
          if (sciBlobX && sciBlobX !== mainBlobX) {
            // НИИ science seal on the RIGHT (cell D2) — matches the PDF cover
            // 1×2 logo table layout. If only one logo is configured, this
            // branch is skipped so we don't render the same image twice.
            sh1.insertImage(sciBlobX, 4, 2, 4, 4).setWidth(120).setHeight(120);
          } else if (!mainBlobX && sciBlobX) {
            // Single-logo fallback: still show the science seal on the left.
            sh1.insertImage(sciBlobX, 2, 2, 4, 4).setWidth(120).setHeight(120);
          }
        } catch (_) {}
        sh1.getRange('B7:D7').merge().setValue(INSTITUTION.legalName_bg).setFontWeight('bold').setFontSize(16).setHorizontalAlignment('center');
        sh1.getRange('B8:D8').merge().setValue(INSTITUTION.legalName_en).setFontStyle('italic').setFontSize(11).setHorizontalAlignment('center');
        sh1.getRange('B9:D9').merge().setValue(INSTITUTION.address).setFontSize(10).setHorizontalAlignment('center');
        sh1.getRange('B10:D10').merge().setValue('ЕИК: ' + INSTITUTION.eik + ' • Институционален код към МОН: ' + INSTITUTION.mes_code).setFontSize(10).setHorizontalAlignment('center');
        sh1.getRange('B11:D11').merge().setValue(INSTITUTION.website + ' • ' + INSTITUTION.email).setFontSize(10).setHorizontalAlignment('center');

        sh1.getRange('B13:D13').merge().setValue('ОТЧЕТ ЗА НАУЧНОИЗСЛЕДОВАТЕЛСКАТА ДЕЙНОСТ').setFontWeight('bold').setFontSize(14).setHorizontalAlignment('center').setBackground('#233874').setFontColor('#ffffff');
        sh1.getRange('B14:D14').merge().setValue('по чл. 92, ал. 3 ЗВО — ' + INSTITUTION.issuingBody).setFontStyle('italic').setHorizontalAlignment('center').setFontSize(10);

        var metaStart = 16;
        var metaPairs = [
          ['Идентификатор на отчета', reportId],
          ['Тип отчет', rType],
          ['Отчетен период', period],
          ['Отчетна година', year],
          ['Издаващо звено', INSTITUTION.issuingBody],
          ['Дата на генериране', nowISO()],
          ['Статус', String(found.rowData[MON_COL.STATUS - 1]||'')]
        ];
        metaPairs.forEach(function(p,i){
          sh1.getRange(metaStart+i, 2).setValue(p[0]).setFontWeight('bold').setBackground('#f0f0fa');
          sh1.getRange(metaStart+i, 3, 1, 2).merge().setValue(p[1]);
        });
        sh1.getRange(metaStart, 2, metaPairs.length, 3).setBorder(true,true,true,true,true,true);

        // ════════════════════════════════════════════════════════════
        //  INSTITUTIONAL NARRATIVE SHEETS (per НИИ template & чл.92,
        //  ал.3 ЗВО). 8 sections matching the official report format.
        //  Falls back to bare quantitative sheets if institutional
        //  block is not present in the snapshot.
        // ════════════════════════════════════════════════════════════
        var inst = data.institutional || null;
        if (inst && inst.sections) {
          var SX = inst.sections;
          var renderListSheet = function(sheetName, sectionLabel, items, columns) {
            var sh = ss.insertSheet(sheetName);
            _xlsxBrandHeader_(sh, sectionLabel, reportId, columns.length);
            // Header row
            sh.getRange(4,1,1,columns.length).setValues([columns.map(function(c){return c.label;})])
              .setFontWeight('bold').setBackground('#7B0000').setFontColor('#ffffff');
            if (items && items.length) {
              var rows = items.map(function(it,i){
                return columns.map(function(c){ return c.key==='_idx' ? (i+1) : (it[c.key] != null ? it[c.key] : ''); });
              });
              sh.getRange(5,1,rows.length,columns.length).setValues(rows);
            } else {
              sh.getRange(5,1).setValue('(няма данни за отчетния период)').setFontStyle('italic').setFontColor('#777777');
            }
            columns.forEach(function(c,i){ sh.setColumnWidth(i+1, c.width||120); });
            sh.setFrozenRows(4);
            return sh;
          };

          // I. Събития
          renderListSheet('I. Събития', 'I. НАУЧНИ И ПРАКТИКО-ПРИЛОЖНИ СЪБИТИЯ', SX.events||[], [
            {key:'_idx',label:'№',width:50},{key:'title',label:'Заглавие',width:340},
            {key:'description',label:'Описание',width:280},{key:'completedDate',label:'Дата',width:100},
            {key:'projectCode',label:'Проект',width:90},{key:'attribution',label:'Реализирал',width:240}
          ]);

          // II. Изследвания
          renderListSheet('II. Изследвания', 'II. НАУЧНИ ИЗСЛЕДВАНИЯ', SX.research||[], [
            {key:'_idx',label:'№',width:50},{key:'title',label:'Тема на изследването',width:320},
            {key:'leader',label:'Ръководител',width:180},{key:'direction',label:'Направление',width:160},
            {key:'period',label:'Период',width:160},{key:'budget',label:'Бюджет (€)',width:110},
            {key:'status',label:'Статус',width:120},{key:'attribution',label:'Реализирал',width:220}
          ]);

          // III. Публикации
          renderListSheet('III. Публикации', 'III. НАУЧНИ ПУБЛИКАЦИИ', SX.publications||[], [
            {key:'_idx',label:'№',width:50},{key:'type',label:'Тип',width:140},
            {key:'title',label:'Заглавие',width:360},{key:'description',label:'Описание / Източник',width:260},
            {key:'url',label:'URL',width:200},{key:'completedDate',label:'Дата',width:100},
            {key:'projectCode',label:'Проект',width:90},{key:'attribution',label:'Реализирал',width:220}
          ]);

          // IV. Проекти — three sub-sections in one sheet
          var sh4i = ss.insertSheet('IV. Проекти');
          _xlsxBrandHeader_(sh4i, 'IV. ПРОЕКТИ И ПРОЕКТНИ ПРЕДЛОЖЕНИЯ', reportId, 11);
          var rowCursor = 4;
          var renderProjectGroup = function(label, list){
            sh4i.getRange(rowCursor,1,1,11).merge().setValue(label).setFontWeight('bold').setBackground('#7B0000').setFontColor('#ffffff').setHorizontalAlignment('left');
            rowCursor++;
            var hdr = ['№','Код','Заглавие','Ръководител','Направление','Период','Статус','Бюджет (€)','Изразходвани (€)','Усвоени (%)','Партньори'];
            sh4i.getRange(rowCursor,1,1,hdr.length).setValues([hdr]).setFontWeight('bold').setBackground('#f0e3e3');
            rowCursor++;
            if (list && list.length) {
              var rows = list.map(function(p,i){
                return [i+1, p.code||'—', p.title||'(без заглавие)', p.leader||'—', p.direction||'—',
                  p.period||'—', p.status||p.outcome||'—',
                  Number(p.budget||0) / 1.95583, Number(p.spent||0) / 1.95583, Number(p.utilization||0),
                  (p.partners||[]).join(', ')];
              });
              sh4i.getRange(rowCursor,1,rows.length,hdr.length).setValues(rows);
              sh4i.getRange(rowCursor,8,rows.length,2).setNumberFormat('#,##0.00 "€"');
              sh4i.getRange(rowCursor,10,rows.length,1).setNumberFormat('0.00"%"');
              rowCursor += rows.length;
            } else {
              sh4i.getRange(rowCursor,1).setValue('(няма записи)').setFontStyle('italic').setFontColor('#777777');
              rowCursor++;
            }
            rowCursor++; // gap
          };
          renderProjectGroup('Приключили проекти', (SX.projects&&SX.projects.completed)||[]);
          renderProjectGroup('Текущи проекти',     (SX.projects&&SX.projects.ongoing)||[]);
          // Proposals have a slightly different schema (no budget/spent)
          sh4i.getRange(rowCursor,1,1,11).merge().setValue('Изготвени и подадени проектни предложения').setFontWeight('bold').setBackground('#7B0000').setFontColor('#ffffff').setHorizontalAlignment('left'); rowCursor++;
          var pHdr = ['№','ID','Заглавие','Конкурс','Ръководител','Подадено','Изход','Реализирал'];
          sh4i.getRange(rowCursor,1,1,pHdr.length).setValues([pHdr]).setFontWeight('bold').setBackground('#f0e3e3'); rowCursor++;
