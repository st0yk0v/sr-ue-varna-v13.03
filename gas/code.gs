      /**
       * Get the form schema for a given project type.
       * @param {string} projectType — e.g. 'ФНИ', 'ПНИ', 'ДНП', 'НПФ'
       * @returns {Object} — { sections: [...], rules: {...} } or null
       */
      function getFormSchema(body) {
        try {
          var projectType = _normalizeProjectType_(String(body.projectType || '').trim());
          if (!projectType || projectType === 'МПП' || projectType === 'ИП' || projectType === 'ДП' || projectType === 'ПНТ') {
            return { success: false, error: 'Неподдържан тип проект: ' + String(body.projectType || '').substring(0, 30) };
          }
          var schema = FORM_SCHEMAS[projectType] || null;
          if (!schema) {
            // Fallback: return a minimal default schema for unknown types
            return {
              success: true,
              schema: {
                sections: [
                  { id: 'info', label: 'Обща информация', required: true, fields: ['title','description','area'] },
                  { id: 'budget', label: 'Бюджет', required: true, fields: ['budgetCategories','total'] },
                  { id: 'documents', label: 'Документи', required: true, fields: ['attachments'] }
                ]
              }
            };
          }
          return { success: true, schema: schema };
        } catch (err) {
          try { logError('getFormSchema', err, body); } catch (_) {}
          return { success: false, error: 'getFormSchema failed: ' + err.message };
        }
