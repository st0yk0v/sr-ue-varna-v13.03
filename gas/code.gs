      // parsebudgetfile: decodes an uploaded budget file, extracts text,
      // and attempts to match category names + amounts against BT_CATS.
      // Returns rows for the frontend ImportPreviewModal to display.
      function parseBudgetFile(body) {
        try {
          body = body || {};
          var fileBase64 = String(body.fileBase64 || '').trim();
          var fileName   = String(body.fileName || 'budget_file').trim();
          var mimeType   = String(body.mimeType || 'application/octet-stream').trim();
          if (!fileBase64) return { success: false, error: 'Missing file data', rows: [] };
          // Decode base64 → blob → temp Drive file → extract text
          var bytes = Utilities.base64Decode(fileBase64);
          var blob = Utilities.newBlob(bytes, mimeType, fileName);
          var tempFolder = null;
          var tempFile = null;
          var extractedText = '';
          try {
            tempFolder = DriveApp.getFolderById(DRIVE_FOLDER_ID).createFolder('_bt_import_temp_' + Utilities.getUuid().slice(0, 8));
            tempFile = tempFolder.createFile(blob);
            // GAS can only extract text natively from Google Docs formats.
            // For .docx convert via Drive, for .xlsx/ .pdf we extract what we can.
            var mime = tempFile.getMimeType();
            if (mime === 'application/vnd.google-apps.document') {
              extractedText = tempFile.getBlob().getDataAsString('utf8');
            } else if (mime === 'text/plain' || mime === 'text/csv') {
              extractedText = tempFile.getBlob().getDataAsString('utf8');
            } else if (mime === 'application/pdf' || mime.indexOf('spreadsheet') > -1) {
              // Try Drive export to text
              try {
                var exported = Drive.Files.export(tempFile.getId(), 'text/plain');
                if (exported) extractedText = String(exported);
              } catch (_) {
                // Fallback: try getBlob as string
                try { extractedText = tempFile.getBlob().getDataAsString('utf8'); } catch (_) {}
              }
            } else {
              // For .docx etc, try Drive conversion
              try {
                var exported2 = Drive.Files.export(tempFile.getId(), 'text/plain');
                if (exported2) extractedText = String(exported2);
              } catch (_) {
                try { extractedText = tempFile.getBlob().getDataAsString('utf8'); } catch (_) {}
              }
            }
          } catch (_) { /* text extraction best-effort */ }
          // Cleanup temp file
          try { if (tempFile) tempFile.setTrashed(true); } catch (_) {}
          try { if (tempFolder) tempFolder.setTrashed(true); } catch (_) {}

          // Define the 9 known budget category labels for fuzzy matching
          var CAT_LABELS = {
            'salaries':          ['\u0432\u044a\u0437\u043d\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043d\u0438\u044f', '\u0437\u0430\u043f\u043b\u0430\u0442\u0438', '\u0445\u043e\u043d\u043e\u0440\u0430\u0440\u0438', '\u0442\u0440\u0443\u0434', '\u0435\u043a\u0438\u043f'],
            'external_services': ['\u0432\u044a\u043d\u0448\u043d\u0438 \u0443\u0441\u043b\u0443\u0433\u0438', '\u0434\u043e\u0433\u043e\u0432\u043e\u0440\u0438', '\u0438\u0437\u0432\u044a\u043d', '\u0430\u0443\u0442\u0441\u043e\u0440\u0441\u0438\u043d\u0433'],
            'assets':            ['\u0430\u043a\u0442\u0438\u0432\u0438', '\u043e\u0431\u043e\u0440\u0443\u0434\u0432\u0430\u043d\u0435', '\u0430\u043f\u0430\u0440\u0430\u0442\u0443\u0440\u0430', '\u043a\u043e\u043c\u043f\u044e\u0442\u0440\u0438', '\u0434\u044a\u043b\u0433\u043e\u0442\u0440\u0430\u0439\u043d\u0438'],
            'consumables':       ['\u043a\u043e\u043d\u0441\u0443\u043c\u0430\u0442\u0438\u0432\u0438', '\u043a\u0430\u043d\u0446\u0435\u043b\u0430\u0440\u0438\u044f', '\u043c\u0430\u043b\u043e\u0446\u0435\u043d\u0435\u043d', '\u0438\u043d\u0432\u0435\u043d\u0442\u0430\u0440'],
            'literature':        ['\u043b\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u0430', '\u043a\u043d\u0438\u0433\u0438', '\u0431\u0430\u0437\u0438 \u0434\u0430\u043d\u043d\u0438', '\u0436\u0443\u0440\u043d\u0430\u043b\u0438', '\u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0430'],
            'travel':            ['\u043a\u043e\u043c\u0430\u043d\u0434\u0438\u0440\u043e\u0432\u043a\u0438', '\u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442', '\u043f\u044a\u0442\u0443\u0432\u0430\u043d\u0435', '\u0434\u043d\u0435\u0432\u043d\u0438', '\u043d\u043e\u0449\u0443\u0432\u043a\u0438'],
            'publications':      ['\u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438', '\u043f\u0435\u0447\u0430\u0442', '\u0438\u043d\u0434\u0435\u043a\u0441\u0438\u0440\u0430\u043d\u0435', '\u0440\u0435\u0446\u0435\u043d\u0437\u0438\u0440\u0430\u043d\u0435'],
            'reviews':           ['\u0440\u0435\u0446\u0435\u043d\u0437\u0438\u0438', '\u0440\u0435\u0446\u0435\u043d\u0437\u0435\u043d\u0442\u0438', '\u0434\u043e\u043a\u0442\u043e\u0440\u0430\u043d\u0442\u0438', '\u0437\u0430\u0449\u0438\u0442\u0430'],
            'other':             ['\u0434\u0440\u0443\u0433\u0438', '\u0434\u0440', '\u043d\u0435\u043f\u0440\u0435\u0434\u0432\u0438\u0434\u0435\u043d\u0438', '\u0440\u0430\u0437\u043d\u043e']
          };
          // Fuzzy-match a line against known categories
          function _matchLine(line, catLabels) {
            var lc = line.toLowerCase();
            var best = null; var bestScore = 0;
            Object.keys(catLabels).forEach(function (cid) {
              catLabels[cid].forEach(function (kw) {
                if (lc.indexOf(kw) > -1) {
                  var score = kw.length / lc.length;
                  if (score > bestScore) { bestScore = score; best = cid; }
                }
              });
            });
            return best;
          }
          // Extract number from a line (first number found)
          function _extractAmount(line) {
            var match = line.match(/(\d[\d\s,]*\d|\d+)/g);
            if (!match) return 0;
            // Take the last number (usually the amount column) if multiple
            var lastNum = match[match.length - 1].replace(/[\s,]/g, '');
            return parseFloat(lastNum) || 0;
          }
          var rows = [];
          if (extractedText) {
            var lines = extractedText.split(/\r?\n/);
            lines.forEach(function (line) {
              line = line.trim();
              if (!line || line.length < 4) return;
              // Skip header/empty lines
              if (/^[A-Z\s-]+$/.test(line) && line.length > 5) return; // all-caps header
              if (/^\d+[\s.]/.test(line) && line.length < 10) return; // line number
              var catId = _matchLine(line, CAT_LABELS);
              if (!catId) return;
              var amount = _extractAmount(line);
              if (amount <= 0) return;
              // Check if already added (dedup within same category)
              var exists = rows.some(function (r) { return r.categoryId === catId; });
              if (!exists) rows.push({ categoryId: catId, amountEur: amount / _eur_(), originalName: line.slice(0, 60), mapped: true });
            });
          }
          // If no rows found from text, try to parse structure (CSV/TSV style)
          if (rows.length === 0 && extractedText) {
            var csvLines = extractedText.split(/\r?\n/);
            csvLines.forEach(function (line) {
              line = line.trim();
              if (!line) return;
              var parts = line.split(/[,\t;|]/);
              if (parts.length < 2) return;
              var labelCol = parts[0].trim();
              var valCol = parts[parts.length - 1].trim();
              var catId = _matchLine(labelCol, CAT_LABELS);
              if (!catId) return;
              var amount = parseFloat(valCol.replace(/[\s,]/g, '')) || 0;
              if (amount <= 0) return;
              var exists = rows.some(function (r) { return r.categoryId === catId; });
              if (!exists) rows.push({ categoryId: catId, amountEur: amount / _eur_(), originalName: labelCol.slice(0, 60), mapped: true });
            });
          }
          return { success: true, rows: rows };
        } catch (err) {
          try { logError('parseBudgetFile', err, body); } catch (_) {}
          return { success: false, error: 'parseBudgetFile: ' + err.message, rows: [] };
        }
      }

      function getApprovedBudget(body) {
        try {
          body = body || {};
          var formId = String(body.formId || body.id || '').trim();
          if (!formId) return { success: false, error: 'Missing formId' };
          var sheet = getSheet();
          var found = findRowByID(sheet, formId);
          if (!found) return { success: false, error: 'Form not found' };
          var budgetRaw = String(found.rowData[COL.BUDGET - 1] || '{}');
          var budget = safeParseJSON(budgetRaw, {});
          // Calculate total approved budget from the budget object
          var totalApproved = 0;
          Object.keys(budget).forEach(function (gid) {
            if (gid === '_monthlyMode' || gid === '_monthly') return;
            var byYear = budget[gid] || {};
            Object.keys(byYear).forEach(function (yr) { totalApproved += Number(byYear[yr]) || 0; });
          });
          return { success: true, totalBGN: totalApproved, totalEUR: totalApproved / _eur_() };
        } catch (err) {
          try { logError('getApprovedBudget', err, body); } catch (_) {}
          return { success: false, error: 'getApprovedBudget: ' + err.message, totalBGN: 0, totalEUR: 0 };
        }
      }

      function getBudgetSummary(body) {
        try {
          body = body || {};
          var formId = String(body.formId || body.id || '').trim();
          if (!formId) return { success: false, error: 'Missing formId' };
          var sheet = getSheet();
          var found = findRowByID(sheet, formId);
          if (!found) return { success: false, error: 'Form not found' };
          var budgetRaw = String(found.rowData[COL.BUDGET - 1] || '{}');
          var budget = safeParseJSON(budgetRaw, {});
          var expensesRaw = String(found.rowData[COL.APPROVED_EXPENSES - 1] || '[]');
          var expenses = safeParseJSON(expensesRaw, []);
          var totalBudget = 0, totalApproved = 0, totalPending = 0;
          // Sum budget
          Object.keys(budget).forEach(function (gid) {
            if (gid === '_monthlyMode' || gid === '_monthly') return;
            var byYear = budget[gid] || {};
            Object.keys(byYear).forEach(function (yr) { totalBudget += Number(byYear[yr]) || 0; });
          });
          // Sum expenses by status
          expenses.forEach(function (ex) {
            var s = String(ex.status || '').toLowerCase();
            var amt = Number(ex.amount || 0);
            if (s === 'approved') totalApproved += amt;
            else if (s === 'pending') totalPending += amt;
          });
          var remaining = totalBudget - totalApproved;
          return {
            success: true, totalBudget: totalBudget, totalApproved: totalApproved,
            totalPending: totalPending, remaining: remaining,
            pctUsed: totalBudget > 0 ? Math.round((totalApproved / totalBudget) * 100) : 0
          };
        } catch (err) {
          try { logError('getBudgetSummary', err, body); } catch (_) {}
          return { success: false, error: 'getBudgetSummary: ' + err.message };
        }
      }

      function getDocuments(body) {
        try {
          body = body || {};
          var competitionId = String(body.competitionId || '').trim();
          var folderId = OFFICIAL_DOCS_FOLDER_ID;
          if (competitionId && typeof getCompetitionFolderId === 'function') {
            var compFolder = getCompetitionFolderId(competitionId);
            if (compFolder) folderId = compFolder;
          }
          if (!folderId) return { success: false, error: 'No documents folder configured', documents: [] };
          var docs = [];
          try {
            var seenIds = {};
            var fastDocs = null;
            try {
              fastDocs = _listDocsFast_(folderId, docs, seenIds, /*recurse=*/true);
            } catch (_) { fastDocs = null; }
            if (!fastDocs || !docs.length) {
              // DriveApp fallback with per-file metadata cost
              var folder = DriveApp.getFolderById(folderId);
              var files = folder.getFiles();
              while (files.hasNext()) {
                var f = files.next();
                var fid = f.getId();
                var links = buildSecureFileLinks_(fid, { allowPreview: true, allowDownload: true, mimeType: f.getMimeType() });
                docs.push({
                  id: fid, driveId: fid, name: f.getName(), mimeType: f.getMimeType(),
                  size: f.getSize(), sizeLabel: formatFileSize_(f.getSize()),
                  previewLink: links.previewLink, downloadUrl: links.downloadUrl,
                  webViewLink: links.webViewLink || links.previewLink,
                  createdDate: f.getDateCreated().toISOString(),
                  modifiedDate: f.getLastUpdated().toISOString(),
                  folderName: f.getParents().hasNext() ? f.getParents().next().getName() : 'Документи'
                });
              }
            }
          } catch (_) {
            // Folder may not exist — return empty list
          }
          docs.sort(function (a, b) { return a.name.localeCompare(b.name); });
          return { success: true, documents: docs };
        } catch (err) {
          try { logError('getDocuments', err, body); } catch (_) {}
          return { success: false, error: 'getDocuments: ' + err.message, documents: [] };
        }
      }

