          }
          if (!targetFolder) return { success: false, error: 'Не може да се създаде папка' };

          var saved = [];
          var MAX_MYDOCS_FILE_SIZE = 20 * 1024 * 1024; // 20 MB per file for personal uploads

          for (var i = 0; i < files.length; i++) {
            var f = files[i];
            try {
              if (!f || !f.data) continue;
              var comma = f.data.indexOf(',');
              if (comma === -1) continue;

              // Size check before decoding
              var base64Part = f.data.slice(comma + 1);
              var rawBytes = Math.ceil(base64Part.length * 3 / 4);
              if (rawBytes > MAX_MYDOCS_FILE_SIZE) {
                saved.push({ name: f.name || ('file_' + i), error: 'Файлът надвишава 20 MB лимит', skipped: true });
                continue;
              }

              var bytes     = Utilities.base64Decode(base64Part);
              var mimeType  = f.type || 'application/octet-stream';
              var fileName  = _sanitiseFileName_(f.name || ('file_' + i));
              var blob      = Utilities.newBlob(bytes, mimeType, fileName);
              var driveFile = targetFolder.createFile(blob);

              try {
                var descParts = ['ORIGIN=uploaded'];
                if (formId) descParts.push('FORM_ID=' + formId);
                driveFile.setDescription(descParts.join('|'));
              } catch (_) {}
              try { setSecureSharing_(driveFile); } catch (_) {}
              try { _addEditorSilently_(driveFile, auth.userId); } catch (_) {}

              var fid = driveFile.getId();
              var links = buildSecureFileLinks_(fid, { allowDownload: true });
              var folderDisplayName = formId ? SESSION_FOLDER_NAME + '/' + formId : 'Моите документи';
              saved.push({
                id: fid, driveId: fid, name: driveFile.getName(), mimeType: mimeType,
                typeLabel: mimeTypeLabel(mimeType), previewLink: links.previewLink,
                webViewLink: links.previewLink, downloadUrl: links.downloadUrl,
                size: formatFileSize_(driveFile.getSize()), sizeBytes: Number(driveFile.getSize() || 0),
                folderName: folderDisplayName, formId: formId || '', origin: 'uploaded',
                createdDate: driveFile.getDateCreated().toISOString(),
                modifiedDate: driveFile.getLastUpdated().toISOString()
              });
            } catch (err) {
              console.error('uploadMyDocument [' + (f ? f.name : '?') + ']: ' + err.message);
              saved.push({ name: f ? f.name : 'unknown', error: 'Грешка при качване: ' + err.message, skipped: true });
            }
          }

          if (saved.length === 0) {
            return { success: false, error: 'Нито един файл не беше качен успешно' };
          }

          var succeeded = saved.filter(function(s) { return !s.skipped; });
          var skipped   = saved.filter(function(s) { return s.skipped; });

          return {
            success: true,
            files: succeeded,
            skipped: skipped,
            message: 'Качени са ' + succeeded.length + ' файла' + (skipped.length > 0 ? ' (' + skipped.length + ' пропуснати)' : '')
          };
        } catch (err) {
          return { success: false, error: 'uploadMyDocument failed: ' + err.message };
        }
      }

