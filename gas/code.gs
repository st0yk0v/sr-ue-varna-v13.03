          updates['lg:' + actionKey + ':' + role + ':h'] = JSON.stringify({ n: n, ts: Date.now(), len: json.length });
          for (var i = 0; i < n; i++) {
            updates['lg:' + actionKey + ':' + role + ':c' + i] = json.substr(i * _SHADOW_CHUNK, _SHADOW_CHUNK);
          }
