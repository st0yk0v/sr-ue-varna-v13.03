      // ══════════════════════════════════════════════════════════════════════
      //  v12.12.0 — MySQL Health Check
      //  ════════════════════════════════════════════════════════════════════
      //  Returns true if the PHP/MySQL backend is reachable and healthy.
      //  Used to decide whether to delegate reads or fall back to Sheets.
      var _mysqlHealthCache_ = { ok: false, ts: 0, ttl: 30000, failCount: 0 }; // v12.26.1-perf: 15s→30s — warmup primes this
      var _MYSQL_FAST_FAIL_THRESHOLD = 2;

