              logError('fallback_dispatch_' + action, fbErr, body);
            }
          }

          if (result === null) {
            result = buildUnknownActionResult_(action, rawAction, body);
            logError('unknown_action', new Error('Unknown action: ' + action + ' (raw: ' + rawAction + ') [v' + (typeof CODE_VERSION !== 'undefined' ? CODE_VERSION : '?') + ']'), body);
          }

