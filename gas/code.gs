      /**
       * Close competitions whose deadline has passed.
       * Called hourly by a GAS time-based trigger.
       * Moves competition status to 'closed'; marks open proposals as 'expired'.
       */
      function _closeExpiredCompetitions_() {
        try {
          var compSheet = _getOrCreateSheet_('Competitions',
            ['ID','Name','Deadline','Status','Created','Description','FolderId','CallType','Year','Directions','EvaluationCriteria','BudgetByDirection','OpenDate','Templates']
          );
          var compData = compSheet.getDataRange().getValues();
          var now = new Date().getTime();
          var closedCount = 0;
          var expiredProposals = 0;

          for (var i = 1; i < compData.length; i++) {
            var deadlineStr = String(compData[i][2] || '');
            var status = String(compData[i][3] || '').trim().toLowerCase();
            if (status === 'closed' || status === 'archived') continue;
            if (!deadlineStr) continue;
            var deadline = new Date(deadlineStr);
            if (deadline.getTime() < now) {
              // Close the competition
              compSheet.getRange(i + 1, 4).setValue('closed');
              closedCount++;
              // Mark all non-finalized proposals as expired
              try {
                var appSheet = getSheet();
                var appData = appSheet.getDataRange().getValues();
                var compId = String(compData[i][0] || '').trim();
                for (var j = 1; j < appData.length; j++) {
                  var aCompId = String(appData[j][COL.COMPETITION - 1] || '').trim();
                  if (aCompId !== compId) continue;
                  var aStatus = String(appData[j][COL.STATUS - 1] || '').trim().toLowerCase();
                  if (['draft','submitted','returned','completed','admin_review','needs_correction','resubmitted'].indexOf(aStatus) >= 0) {
                    appSheet.getRange(j + 1, COL.STATUS).setValue('expired');
                    expiredProposals++;
                    try { logTransaction('AUTO_EXPIRE_PROPOSAL', 'system', String(appData[j][COL.ID - 1] || ''), { competitionId: compId, deadline: deadlineStr }); } catch (_) {}
                  }
                }
              } catch (_) {}
              try { logTransaction('AUTO_CLOSE_COMPETITION', 'system', String(compData[i][0] || ''), { name: String(compData[i][1] || ''), deadline: deadlineStr }); } catch (_) {}
            }
          }
          return { success: true, closedCompetitions: closedCount, expiredProposals: expiredProposals };
        } catch (err) {
          try { logError('_closeExpiredCompetitions_', err, {}); } catch (_) {}
          return { success: false, error: err.message };
        }
      }

      /**
       * Mark proposals that have been in 'needs_correction' for more than
       * 5 working days as 'ineligible'.
       * Called daily by a GAS time-based trigger.
       */
      function _markCorrectionsExpired_() {
        try {
          var appSheet = getSheet();
          var appData = appSheet.getDataRange().getValues();
          var now = new Date();
          var markedCount = 0;

          for (var i = 1; i < appData.length; i++) {
            var status = String(appData[i][COL.STATUS - 1] || '').trim().toLowerCase();
            if (status !== 'needs_correction') continue;

            // Parse return comment for deadline
            var returnComment = String(appData[i][COL.RETURN_COMMENT - 1] || '');
            var deadlineMatch = returnComment.match(/deadline["'\s:]*(\d{4}-\d{2}-\d{2})/i);
            var deadlineDate;
            if (deadlineMatch) {
              deadlineDate = new Date(deadlineMatch[1]);
            } else {
              // Fallback: add 5 working days from the last status change
              var historyStr = String(appData[i][COL.HISTORY - 1] || '[]');
              var history = [];
              try { history = JSON.parse(historyStr); } catch (_) {}
              var lastChange = now;
              for (var h = history.length - 1; h >= 0; h--) {
                if (String(history[h].status || '') === 'needs_correction') {
                  lastChange = new Date(history[h].ts || now);
                  break;
                }
              }
              // 5 working days ≈ 7 calendar days
              deadlineDate = new Date(lastChange.getTime() + 7 * 24 * 60 * 60 * 1000);
            }

            if (deadlineDate && deadlineDate.getTime() < now.getTime()) {
              appSheet.getRange(i + 1, COL.STATUS).setValue('ineligible');
              markedCount++;
              try { logTransaction('AUTO_CORRECTION_EXPIRED', 'system', String(appData[i][COL.ID - 1] || ''), { deadline: deadlineDate.toISOString() }); } catch (_) {}
            }
          }
          return { success: true, markedIneligible: markedCount };
        } catch (err) {
          try { logError('_markCorrectionsExpired_', err, {}); } catch (_) {}
          return { success: false, error: err.message };
        }
      }

      /**
       * Auto-reject reviews that have been pending for more than 10 days.
       * Called daily by a GAS time-based trigger.
       * Flags overdue reviews as rejected and triggers reassignment flow.
       */
      function _autoRejectOverdueReviews_() {
        try {
          var appSheet = getSheet();
          var appData = appSheet.getDataRange().getValues();
          var now = new Date().getTime();
          var rejectedCount = 0;

          for (var i = 1; i < appData.length; i++) {
            var status = String(appData[i][COL.STATUS - 1] || '').trim().toLowerCase();
            if (status !== 'in_review' && status !== 'reviewer_assignment') continue;

            var reviewers = [];
            try { reviewers = JSON.parse(String(appData[i][COL.REVIEWERS - 1] || '[]')); } catch (_) { continue; }
            if (!reviewers.length) continue;

            var changed = false;
            var formId = String(appData[i][COL.ID - 1] || '');
            var currentReviewers = [];

            for (var r = 0; r < reviewers.length; r++) {
              var rev = reviewers[r];
              if (typeof rev === 'string') {
                // Simple email string — wrap it
                currentReviewers.push({ email: rev, status: 'pending' });
                continue;
              }
              var revStatus = String(rev.status || 'pending').toLowerCase();
              var invitedAt = rev.invitedAt ? new Date(rev.invitedAt).getTime() : now;
              var daysWaiting = (now - invitedAt) / (24 * 60 * 60 * 1000);

              if ((revStatus === 'pending' || revStatus === 'invited') && daysWaiting > 10) {
                rev.status = 'auto_rejected';
                rev.rejectionNote = 'Автоматично отказан след 10-дневен срок';
                rejectedCount++;
                changed = true;
                try { logTransaction('AUTO_REJECT_REVIEWER', 'system', formId, { reviewerEmail: rev.email, daysWaiting: Math.round(daysWaiting) }); } catch (_) {}
              }
              currentReviewers.push(rev);
            }

            if (changed) {
              appSheet.getRange(i + 1, COL.REVIEWERS).setValue(JSON.stringify(currentReviewers));
            }
          }
          return { success: true, autoRejected: rejectedCount };
        } catch (err) {
          try { logError('_autoRejectOverdueReviews_', err, {}); } catch (_) {}
          return { success: false, error: err.message };
        }
      }

      /**
       * Remind reviewers approaching their 10-day deadline.
       * Sends notification on days 7 and 9 after invitation.
       * Called daily by a GAS time-based trigger.
       */
      function _remindReviewers_() {
        try {
          var appSheet = getSheet();
          var appData = appSheet.getDataRange().getValues();
          var now = new Date().getTime();
          var reminded = 0;

          for (var i = 1; i < appData.length; i++) {
            var status = String(appData[i][COL.STATUS - 1] || '').trim().toLowerCase();
            if (status !== 'in_review' && status !== 'reviewer_assignment') continue;

            var reviewers = [];
            try { reviewers = JSON.parse(String(appData[i][COL.REVIEWERS - 1] || '[]')); } catch (_) { continue; }
            var formId = String(appData[i][COL.ID - 1] || '');

            for (var r = 0; r < reviewers.length; r++) {
              var rev = typeof reviewers[r] === 'string' ? { email: reviewers[r], status: 'pending', reminderSentDays: 0 } : reviewers[r];
              var revStatus = String(rev.status || 'pending').toLowerCase();
              if (revStatus !== 'pending' && revStatus !== 'invited') continue;
              var invitedAt = rev.invitedAt ? new Date(rev.invitedAt).getTime() : now;
              var daysWaiting = Math.round((now - invitedAt) / (24 * 60 * 60 * 1000));
              var lastReminder = Number(rev.reminderSentDays) || 0;

              // Send reminders on days 7 and 9
              var reminderDays = [7, 9];
              for (var d = 0; d < reminderDays.length; d++) {
                if (daysWaiting >= reminderDays[d] && lastReminder < reminderDays[d]) {
                  var emailBody = 'Уважаеми колега, напомняме Ви, че имате ' + daysWaiting + ' дни от поканата за рецензиране на проект ' + formId + '. Моля, възползвайте се от оставащото време в 10-дневния срок.';
                  try {
                    _queueDeferredEmail_(rev.email, 'Напомняне за рецензиране на проект', emailBody, { formId: formId, daysWaiting: daysWaiting });
                  } catch (_) {}
                  rev.reminderSentDays = reminderDays[d];
                  reminded++;
                  break;
                }
              }
            }
          }
          return { success: true, remindersSent: reminded };
        } catch (err) {
          try { logError('_remindReviewers_', err, {}); } catch (_) {}
          return { success: false, error: err.message };
        }
      }

      /**
       * Trigger all deadline automation tasks (for use by a single GAS trigger).
       * Calls _closeExpiredCompetitions_, _markCorrectionsExpired_,
       * _autoRejectOverdueReviews_, and _remindReviewers_ in sequence.
       */
      function runDeadlineAutomation(body) {
        try {
          var results = {
            closedCompetitions: null,
            markedIneligible: null,
            autoRejected: null,
            remindersSent: null
          };
          try {
            var compRes = _closeExpiredCompetitions_();
            results.closedCompetitions = compRes.success ? compRes.closedCompetitions : 0;
          } catch (_) {}
          try {
