      /**
       * Attempt to read data from MySQL (PHP backend) instead of Sheets.
       * Falls back silently to null so the caller can use the authoritative Sheets read.
       * @param {string} action  The API action name
       * @param {Object} body    Request body
       * @param {Object} [opts]  { timeout?: number, skipCache?: boolean }
       * @returns {Object|null}  The API result, or null if MySQL unavailable/timed out
       */
      // v12.28.2-perf: Reduced default timeout for MySQL reads — faster fallback to Sheets.
      var _MYSQL_READ_TIMEOUT_FAST = 6;   // seconds — normal reads (increased from 4 for cold starts)
      var _MYSQL_READ_TIMEOUT_SLOW = 10;  // seconds — large/slow reads (initialdata, search)

      function _readFromMySQL_(action, body, opts) {
        try {
          var _readUrl = _getHostingerUrl_();
          if (!_readUrl) return null;
          if (!_MYSQL_READ_ACTIONS[action]) return null;

          // v12.28.2-perf: Shorter default timeout — 4s vs 10s.
          // Slow actions (initialdata, search, batchapi) get 8s.
          var timeout = (opts && opts.timeout) || _MYSQL_READ_TIMEOUT_FAST;
          if ((action === 'getinitialdata' || action === 'batchapi' || action === 'sqlsearch' ||
               action === 'sqlgetforms' || action === 'sqlgetcompetitions') && !opts) {
            timeout = _MYSQL_READ_TIMEOUT_SLOW;
          }
          var payload = Object.assign({}, body || {}, { action: action });
          var options = {
            method: 'post',
            contentType: 'application/json',
            payload: JSON.stringify(payload),
            muteHttpExceptions: true,
            timeout: timeout
          };

          // v12.17.1: Try each URL in the pool
          var _pool = HOSTINGER_URL_POOL.length ? HOSTINGER_URL_POOL : [_readUrl];
          for (var _pi = 0; _pi < _pool.length; _pi++) {
            var _tryUrl = _pool[_pi];
            try {
              var resp = UrlFetchApp.fetch(_tryUrl, options);
              var code = resp.getResponseCode();
              if (code < 200 || code >= 500) continue;

              var text = resp.getContentText();
              if (!text) continue;

              var result = JSON.parse(text);
              if (result && result.success) {
                _markHostingerHealthy_(_tryUrl);
                if (result._version && !_isMySQLVersionCurrent_(action, result._version)) {
                  return null; // MySQL data is stale — fall back to Sheets
                }
                result._fromMySQL = true;
                result._source = 'mysql';
                return result;
              }
            } catch (e) { /* try next URL */ }
          }
          return null;
        } catch (e) { return null; }
      }

