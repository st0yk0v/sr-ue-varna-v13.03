          if (st !== MON_STATUS.SUBMITTED) return { success: false, error: 'Само подаден отчет може да бъде отхвърлен.' };

          var historyArr = _monParseJson_(found.rowData[MON_COL.HISTORY - 1], []);
          historyArr = _monAppendHistory_(historyArr, { status: MON_STATUS.REJECTED_BY_MINISTRY, ts: nowISO(), by: auth.userId, role: auth.role, note: reason });
          found.sheet.getRange(found.rowIndex, MON_COL.STATUS).setValue(MON_STATUS.REJECTED_BY_MINISTRY);
          found.sheet.getRange(found.rowIndex, MON_COL.HISTORY).setValue(JSON.stringify(historyArr));

