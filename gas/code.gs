      // ── v9.44.1-perfboost: Pre-built O(1) lookup sets for status transitions ──
      // Array.indexOf is O(n) per check; Set has O(1) for the ~50-state map.
      var _STATUS_TRANSITION_SETS_ = {};
      (function _buildTransitionSets_() {
        var keys = Object.keys(ALLOWED_STATUS_TRANSITIONS);
        for (var i = 0; i < keys.length; i++) {
          var arr = ALLOWED_STATUS_TRANSITIONS[keys[i]];
          var set = {};
          for (var j = 0; j < arr.length; j++) { set[arr[j]] = true; }
          _STATUS_TRANSITION_SETS_[keys[i]] = set;
        }
      })();

      function _validateStatusTransition_(currentStatus, newStatus) {
        if (!currentStatus || !newStatus) return true; // allow if undefined
        if (currentStatus === newStatus) return true;   // no change is always OK
        var set = _STATUS_TRANSITION_SETS_[currentStatus];
        if (!set) return false; // unknown status → reject
        return !!set[newStatus];
      }

      // ═══════════════════════════════════════════════════════════════════
      //  v9.37.0-regulatory — COMPETITION DEADLINE ENFORCEMENT
      // ═══════════════════════════════════════════════════════════════════

      function _checkCompetitionDeadline_(competitionId) {
        if (!competitionId) return { ok: true, reason: '' };
        try {
          var comp = getCompetitionById_(competitionId, true);
          if (!comp) return { ok: true, reason: '' }; // comp not found — allow (fail elsewhere)
          var status = String(comp.status || '').toLowerCase().trim();
          // Closed competitions cannot accept submissions
          if (status === 'closed' || status === 'archived' || status === 'closed_for_submission') {
            return { ok: false, reason: 'Конкурсната сесия е затворена за подаване на проектни предложения.' };
          }
          // Check deadline date
          var deadline = comp.deadline || comp.dateEnd;
          if (deadline) {
            var dl = new Date(deadline);
            var now = new Date();
            if (!isNaN(dl.getTime()) && now > dl) {
              return { ok: false, reason: 'Крайният срок за подаване е изтекъл на ' + dl.toLocaleDateString('bg-BG') + '.' };
            }
          }
          // Check if competition has opened yet
          var openDate = comp.openDate;
          if (openDate) {
            var od = new Date(openDate);
            var now2 = new Date();
            if (!isNaN(od.getTime()) && now2 < od) {
              return { ok: false, reason: 'Конкурсната сесия все още не е отворена за подаване.' };
            }
          }
          return { ok: true, reason: '' };
        } catch (_) {
          return { ok: true, reason: '' }; // fail open — let other checks catch issues
        }
      }

      // ═══════════════════════════════════════════════════════════════════
      //  v9.37.0-regulatory — REQUIRED DOCUMENTS PER PROJECT TYPE
      // ═══════════════════════════════════════════════════════════════════

      // Required template IDs per project type — must match REQUIRED_APPLICATION_TEMPLATES
      // and the actual template keys used by generateApplicationDocument on the frontend.
      // Abstract types (cv_leader, work_program…) are replaced with real template IDs so
      // that generated filenames like "fnisections35_F1234567" are recognised directly.
      var REQUIRED_DOCUMENTS_BY_TYPE = {
        'ФНИ': ['fnipdf', 'fniteamextra', 'fniextra', 'fnibudget'],
        'ПНИ': ['pnipdf', 'pniteamextra', 'pniextra', 'pnibudget'],
        'ДНП': ['dnppdf', 'dnpextra', 'dnpcv', 'dnpbudget'],
        'НПФ': ['npfpdf', 'npfextra', 'npfbudget']
