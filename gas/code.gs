      // ============================================================
      //  DEFERRED EMAIL QUEUE
      //  MailApp.sendEmail is synchronous and adds 1\u20133s of latency to every
      //  request that notifies a user. By queuing the payload + scheduling a
      //  one-shot time-based trigger we return to the client immediately while
      //  the email is sent in a background execution.
      // ============================================================
      var _EMAIL_QUEUE_PROP = '_DEFERRED_EMAIL_QUEUE';
      var _EMAIL_TRIGGER_FLAG = '_DEFERRED_EMAIL_TRIGGER_PENDING';

      // ── Deferred Drive-copy queue (v9.44.0-timeout-fix) ──────────────────
      // Heavy Drive operations (copying app-folder files to the applicant's
      // session folder after submission) are moved off the critical path by
      // writing a job descriptor to ScriptProperties and scheduling a 1-second
      // time-based trigger.  submitForm returns immediately after writing the
      // sheet row; the Drive work happens in a background execution.
      var _DRIVE_COPY_QUEUE_PROP  = '_DEFERRED_DRIVE_COPY_QUEUE';
      var _DRIVE_COPY_TRIGGER_FLAG = '_DEFERRED_DRIVE_COPY_TRIGGER_PENDING';

      /**
       * Queue a Drive-copy job for deferred (background) execution.
       * Supported kinds:
       *   • 'copyAppFiles' — { kind, formId, userEmail } →
       *       calls _copyAppFilesToSessionFolder_(formId, userEmail)
       * Falls back to synchronous execution if trigger scheduling fails.
       */
      function _queueDeferredDriveCopy_(payload) {
        try {
          if (!payload || !payload.kind) return false;
          var props = _scriptProps_();
          var queue;
          try { queue = JSON.parse(props.getProperty(_DRIVE_COPY_QUEUE_PROP) || '[]'); }
          catch (_) { queue = []; }
          // Cap at 20 jobs — each entry is small but ScriptProperties values
          // are capped at 9 KB total.
          if (queue.length >= 20) queue.shift();
          queue.push(payload);
          props.setProperty(_DRIVE_COPY_QUEUE_PROP, JSON.stringify(queue));
          // Only schedule a new trigger if one isn't already pending.
          if (!props.getProperty(_DRIVE_COPY_TRIGGER_FLAG)) {
            try {
              ScriptApp.newTrigger('_processDeferredDriveCopyQueue_').timeBased().after(2000).create();
              props.setProperty(_DRIVE_COPY_TRIGGER_FLAG, String(Date.now()));
            } catch (trigErr) {
              // Trigger quota exhausted or auth error — run synchronously so
              // the job is never silently dropped.
              console.warn('_queueDeferredDriveCopy_: trigger failed (' + trigErr.message + '), running inline');
              _processDeferredDriveCopyQueue_();
            }
          }
          return true;
        } catch (err) {
          console.warn('_queueDeferredDriveCopy_: ' + err.message);
          return false;
        }
      }

      /**
       * Background trigger target: drain the deferred Drive-copy queue.
       * Registered automatically by _queueDeferredDriveCopy_.
       */
      function _processDeferredDriveCopyQueue_() {
        var props = _scriptProps_();
        var queue = [];
        try { queue = JSON.parse(props.getProperty(_DRIVE_COPY_QUEUE_PROP) || '[]'); } catch (_) {}
        props.deleteProperty(_DRIVE_COPY_QUEUE_PROP);
        props.deleteProperty(_DRIVE_COPY_TRIGGER_FLAG);
        // Remove any lingering one-shot triggers for this handler.
        try {
          var trigs = ScriptApp.getProjectTriggers();
          for (var t = 0; t < trigs.length; t++) {
            if (trigs[t].getHandlerFunction() === '_processDeferredDriveCopyQueue_') {
              try { ScriptApp.deleteTrigger(trigs[t]); } catch (_) {}
            }
          }
        } catch (_) {}
        for (var j = 0; j < queue.length; j++) {
          var job = queue[j] || {};
          try {
            if (job.kind === 'copyAppFiles') {
              _copyAppFilesToSessionFolder_(job.formId, job.userEmail);
            }
          } catch (jobErr) {
            try { logError('_processDeferredDriveCopyQueue_', jobErr, { kind: job.kind, formId: job.formId }); } catch (_) {}
          }
        }
      }

      function _queueDeferredEmail_(payload) {
        try {
          if (!payload || !payload.kind) return false;
          var props = _scriptProps_();
          var queue;
          try { queue = JSON.parse(props.getProperty(_EMAIL_QUEUE_PROP) || '[]'); }
          catch (_) { queue = []; }
          // Cap queue size to protect PropertiesService quota (9KB per value).
          if (queue.length >= 50) queue.shift();
          queue.push(payload);
          props.setProperty(_EMAIL_QUEUE_PROP, JSON.stringify(queue));
          // One-shot trigger \u2014 only schedule if not already pending.
          if (!props.getProperty(_EMAIL_TRIGGER_FLAG)) {
            try {
              ScriptApp.newTrigger('_processDeferredEmailQueue_').timeBased().after(1000).create();
              props.setProperty(_EMAIL_TRIGGER_FLAG, String(Date.now()));
            } catch (trigErr) {
              // Trigger quota or auth error \u2014 fall back to synchronous send so the
              // notification isn't lost. Worst case we re-add the latency we tried to skip.
              console.warn('_queueDeferredEmail_: trigger schedule failed (' + trigErr.message + '), processing inline');
              _processDeferredEmailQueue_();
            }
          }
          return true;
        } catch (err) {
          console.warn('_queueDeferredEmail_: ' + err.message);
          return false;
        }
      }

      function _processDeferredEmailQueue_() {
        var props = _scriptProps_();
        // Drain the queue atomically: snapshot, clear, then send.
        var queue = [];
        try { queue = JSON.parse(props.getProperty(_EMAIL_QUEUE_PROP) || '[]'); } catch (_) {}
        props.deleteProperty(_EMAIL_QUEUE_PROP);
        props.deleteProperty(_EMAIL_TRIGGER_FLAG);
        // Clean up any lingering one-shot triggers for this handler.
        try {
          var triggers = ScriptApp.getProjectTriggers();
          for (var i = 0; i < triggers.length; i++) {
            if (triggers[i].getHandlerFunction() === '_processDeferredEmailQueue_') {
              try { ScriptApp.deleteTrigger(triggers[i]); } catch (_) {}
            }
          }
        } catch (_) {}
        for (var j = 0; j < queue.length; j++) {
          var msg = queue[j] || {};
          try {
            switch (msg.kind) {
              case 'submission':
                notifySubmissionSuccess_(msg.email, msg.userName, msg.formId, msg.title, msg.competitionId, msg.competitionName);
                break;
              case 'raw':
                if (msg.email && msg.subject && msg.htmlBody) {
                  notifyApplicant_(msg.email, msg.subject, msg.htmlBody, msg.notifyType || '');
                }
                break;
            }
          } catch (sendErr) {
            try { logError('_processDeferredEmailQueue_', sendErr, { kind: msg.kind, email: msg.email }); } catch (_) {}
          }
        }
      }

