      function getDocumentVisuals(body) {
        try {
          body = body || {};
          var docId = String(body.id || body.documentId || '').trim();
          if (!docId) return { success: false, error: 'Missing documentId' };
          // v12.49.86-gasdocfix: a trashed/deleted file must NOT yield a generic
          // file icon that downstream code turns into a Google /preview iframe
          // (which renders Google's own "file deleted" dead page — JS can never
          // read/intercept cross-origin iframe content). Detect it up front and
          // return a clean DELETED signal so the modal shows our styled card.
          var file = null;
          try { file = DriveApp.getFileById(docId); } catch (_) {}
          if (!file) {
            // Not found — treat as deleted so the caller does NOT embed Google's
            // dead page. (Same shape as driveFileMeta's NOT_FOUND path.)
            return { success: true, deleted: true, reason: 'NOT_FOUND',
                     icon: 'fa-file-excel', color: 'var(--ink-4)', docId: docId };
          }
          try { if (file.isTrashed()) {
            // Trashed → gone from the owner's view. Return DELETED explicitly.
            var _name = file.getName(), _mime = file.getMimeType();
            return { success: true, deleted: true, reason: 'TRASHED',
                     name: _name, mimeType: _mime, docId: docId,
                     icon: 'fa-file-excel', color: 'var(--ink-4)' };
          } } catch (_) {}
          var name = file.getName();
          var mime = file.getMimeType();
          var icon = 'fa-file-alt';
          var color = 'var(--ink-4)';
          if (/\.pdf$/i.test(name)) { icon = 'fa-file-pdf'; color = 'var(--err)'; }
          else if (/\.docx?$/i.test(name)) { icon = 'fa-file-word'; color = '#2b579a'; }
          else if (/\.xlsx?$/i.test(name)) { icon = 'fa-file-excel'; color = '#217346'; }
          else if (/\.pptx?$/i.test(name)) { icon = 'fa-file-powerpoint'; color = '#d24726'; }
          else if (/\.(jpg|jpeg|png|gif|webp)$/i.test(name)) { icon = 'fa-file-image'; color = '#e91e63'; }
          else if (/\.(zip|rar|7z)$/i.test(name)) { icon = 'fa-file-archive'; color = '#795548'; }
          else if (/\.txt$/i.test(name)) { icon = 'fa-file-lines'; color = '#607d8b'; }
          else if (/\.html?$/i.test(name)) { icon = 'fa-file-code'; color = '#ff5722'; }
          return { success: true, icon: icon, color: color, name: name, mimeType: mime, docId: docId };
        } catch (err) {
          try { logError('getDocumentVisuals', err, body); } catch (_) {}
          return { success: false, error: 'getDocumentVisuals: ' + err.message, icon: 'fa-file-alt', color: 'var(--ink-4)' };
        }
      }

      function getProjectTypeLabel(body) {
