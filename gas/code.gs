            getcontestboard: 1, getpubliccompetitions: 1,
            // UC-23 — public results page is anonymous-friendly
            getpublicresults: 1, getprivacypolicy: 1,
            // v10.8.0 — Hostinger DB bridge (server-to-server, bypass domain check)
            _fullmirror: 1, fullmirror: 1, gassetcache: 1, gasgetcache: 1,
            gassync: 1, warmusercache: 1, mirrortohostinger: 1
          };
          if (!DOMAIN_EXEMPT_ACTIONS[action]) {
            var _reqEmail = extractUserId(body);
            if (_reqEmail && !isAllowedSignInEmail_(_reqEmail) && !isAdminUser(_reqEmail)) {
              return jsonResponse_({
                success: false,
                code: 'DOMAIN_NOT_ALLOWED',
                error: 'Достъпът е разрешен само за институционални акаунти на ИУ – Варна (@ue-varna.bg). | Access is restricted to institutional University of Economics – Varna accounts (@ue-varna.bg).'
