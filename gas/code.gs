// ═══════════════════════════════════════════════════════════════════════════
//  SECTION 17: WEBHOOK INTEGRATION (Laravel ↔ GAS bridge) — v12.41.2
//  Allows the live Laravel app at sr-ue-varna.com to trigger GAS actions
//  via authenticated webhooks. Run setupWebhook('<token>') once after deploy.
// ═══════════════════════════════════════════════════════════════════════════

/**
 * Receive webhook from Laravel app.
 * POST /exec (with action=webhook)
 * body: { webhookToken, event, payload }
 */
function handleWebhook(body) {
  body = body || {};
  var token = String(body.webhookToken || '').trim();
  var expected = String(_scriptProps_().getProperty('WEBHOOK_TOKEN') || '').trim();

  if (!token || token !== expected) {
    return { success: false, error: 'Invalid webhook token' };
  }

  var event = String(body.event || '').trim();
  var payload = body.payload || {};

  switch (event) {
    case 'competition.created':
      return _webhookCompetitionCreated_(payload);
    case 'competition.closed':
      return _webhookCompetitionClosed_(payload);
    case 'document.generated':
      return _webhookDocumentGenerated_(payload);
    case 'report.submitted':
      return _webhookReportSubmitted_(payload);
    case 'report.due_reminder':
      return sendDeadlineReminders({ horizonDays: payload.horizonDays || 7, dryRun: false });
    case 'cache.invalidate':
      return _webhookCacheInvalidate_(payload);
    default:
      return { success: false, error: 'Unknown webhook event: ' + event };
  }
}

function _webhookCompetitionCreated_(payload) {
  try {
    var compId = String(payload.competitionId || payload.id || '').trim();
    if (!compId) return { success: false, error: 'Missing competitionId' };

    var folderId = _ensureCompetitionFolder_(compId, payload.name || compId);
    _invalidateCompetitionsCache_();

    return { success: true, competitionId: compId, driveFolderId: folderId };
  } catch (err) {
    return { success: false, error: err.message };
  }
}

function _webhookCompetitionClosed_(payload) {
  try {
    var compId = String(payload.competitionId || payload.id || '').trim();
    if (!compId) return { success: false, error: 'Missing competitionId' };

    _closeExpiredCompetitions_();

    return { success: true, competitionId: compId, action: 'closed' };
  } catch (err) {
    return { success: false, error: err.message };
  }
}

function _webhookDocumentGenerated_(payload) {
  try {
    var docId = String(payload.documentId || payload.id || '').trim();
    if (!docId) return { success: false, error: 'Missing documentId' };

    if (payload.notifyEmail) {
      notifyApplicant_(
        payload.notifyEmail,
        'Документ е генериран – ' + (payload.name || docId),
        buildNotificationHtml_('Документ е генериран', [
          { label: 'Документ:', value: payload.name || docId },
          { label: 'Тип:', value: payload.type || '—' }
        ], 'Документът е достъпен в системата.'),
        'document_ready'
      );
    }

    return { success: true, documentId: docId };
  } catch (err) {
    return { success: false, error: err.message };
  }
}

function _webhookReportSubmitted_(payload) {
  try {
    var projectId = String(payload.projectId || payload.project_id || '').trim();
    var reportType = String(payload.reportType || payload.report_type || 'unknown');

    var adminEmails = _ADMIN_EMAILS_SERVER || [];
    for (var i = 0; i < adminEmails.length; i++) {
      try {
        notifyApplicant_(
          adminEmails[i],
          'Поданен отчет – ' + (payload.projectTitle || projectId),
          buildNotificationHtml_('Поданен отчет', [
            { label: 'Проект:', value: payload.projectTitle || projectId },
            { label: 'Тип отчет:', value: reportType },
            { label: 'Период:', value: payload.period || '—' }
          ], 'Отчетът е получен и чака преглед.'),
          'report_submitted'
        );
      } catch (_) {}
    }

    return { success: true, projectId: projectId, reportType: reportType };
  } catch (err) {
    return { success: false, error: err.message };
  }
}

function _webhookCacheInvalidate_(payload) {
  try {
    var patterns = Array.isArray(payload.patterns) ? payload.patterns : ['*'];
    if (patterns.indexOf('*') >= 0) {
      _scriptProps_().setProperty('CACHE_VERSION', String(Date.now()));
    }
    return { success: true, patterns: patterns };
  } catch (err) {
    return { success: false, error: err.message };
  }
}

