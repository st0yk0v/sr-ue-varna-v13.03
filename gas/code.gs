      // Per-key blob cache so each logo is fetched at most once per execution,
      // backed by a cross-execution CacheService entry (6h TTL) so subsequent
      // Apps Script invocations skip the DriveApp/UrlFetch round-trip entirely.
      // Major win for OTP and notification email latency (each cold fetch was
      // ~300–800 ms; with 2 logos that's 0.6–1.6 s per request shaved off).
      var _logoBlobCacheByKey = {};
      var _LOGO_CACHE_TTL_SEC_ = 6 * 60 * 60;          // 6 hours
      var _LOGO_CACHE_KEY_PREFIX_ = 'LOGO_BLOB::v1::';
      function _logoCacheKey_(propKey){ return _LOGO_CACHE_KEY_PREFIX_ + String(propKey); }
      function _logoBlobFromCache_(propKey){
        try {
          var raw = _scriptCache_().get(_logoCacheKey_(propKey));
          if (!raw) return null;
          var rec = JSON.parse(raw);
          if (!rec || !rec.b64 || !rec.ct) return null;
          var bytes = Utilities.base64Decode(rec.b64);
          var b = Utilities.newBlob(bytes, rec.ct, rec.name || ('logo-' + propKey));
          return b;
        } catch (_) { return null; }
      }
      function _logoBlobToCache_(propKey, blob){
        try {
          var bytes = blob.getBytes();
          // CacheService values are limited to 100 KB. Skip persisting oversized
          // logos rather than throwing — per-execution memo still covers them.
          if (!bytes || bytes.length > 90 * 1024) return;
          var rec = {
            b64: Utilities.base64Encode(bytes),
            ct:  String(blob.getContentType() || 'image/png'),
            name: String(blob.getName() || ('logo-' + propKey))
          };
          _scriptCache_().put(_logoCacheKey_(propKey), JSON.stringify(rec), _LOGO_CACHE_TTL_SEC_);
        } catch (_) { /* non-fatal */ }
      }
      function _getLogoBlobByPropKey_(propKey, fallbackKey){
        if (_logoBlobCacheByKey.hasOwnProperty(propKey)) return _logoBlobCacheByKey[propKey] || null;
        // ── Cross-execution cache hit ──
        var cached = _logoBlobFromCache_(propKey);
        if (cached) { _logoBlobCacheByKey[propKey] = cached; return cached; }
        try {
          var props = _scriptProps_();
          var fid = String(props.getProperty(propKey) || '').trim();
          if (!fid && fallbackKey) fid = String(props.getProperty(fallbackKey) || '').trim();
          if (fid) {
            try {
              var blob = DriveApp.getFileById(fid).getBlob();
              blob.setName('logo-' + propKey + (blob.getContentType()==='image/jpeg'?'.jpg':'.png'));
              _logoBlobCacheByKey[propKey] = blob;
              _logoBlobToCache_(propKey, blob);
              return blob;
            } catch (eDrive) {
              console.warn('Logo Drive load failed (' + propKey + '): ' + eDrive.message + ' — trying URL fallback');
            }
          }
          // ── URL fallback ──
          // Same property name suffixed with _URL, then a generic MAIN/SCIENCE
          // _LOGO_URL fallback. Lets admins skip Drive entirely by pointing at
          // the public asset URL on the static host (Hostinger / institutional
          // website). Cached for the rest of this execution.
          var urlKey = propKey + '_URL';
          var url = String(props.getProperty(urlKey) || '').trim();
          if (!url && fallbackKey) url = String(props.getProperty(fallbackKey + '_URL') || '').trim();
          if (!url) {
            // Convention-over-config defaults: when admin set EMAIL_LOGO_BASE_URL
            // (e.g. https://erp.ue-varna.bg/assets) we resolve well-known names.
            var baseUrl = String(props.getProperty('EMAIL_LOGO_BASE_URL') || '').trim().replace(/\/+$/,'');
            if (baseUrl) {
              if (propKey === INSTITUTION.mainLogoPropKey)         url = baseUrl + '/uev-social-logo.png';
              else if (propKey === INSTITUTION.scienceLogoPropKey) url = baseUrl + '/science-logo.png';
              else                                                 url = baseUrl + '/uev-logo.jpg';
            }
          }
          if (url) {
            try {
              var resp = UrlFetchApp.fetch(url, { muteHttpExceptions: true, followRedirects: true, validateHttpsCertificates: true });
              var status = resp.getResponseCode();
              if (status >= 200 && status < 300) {
                var ub = resp.getBlob();
                var ct = String(ub.getContentType() || 'image/png').toLowerCase();
                var ext = ct.indexOf('jpeg') >= 0 ? '.jpg' : (ct.indexOf('svg') >= 0 ? '.svg' : '.png');
                ub.setName('logo-' + propKey + ext);
                _logoBlobCacheByKey[propKey] = ub;
                _logoBlobToCache_(propKey, ub);
                return ub;
              }
              console.warn('Logo URL fetch ' + url + ' returned HTTP ' + status);
            } catch (eUrl) {
              console.warn('Logo URL fetch failed (' + propKey + '): ' + eUrl.message);
            }
          }
          _logoBlobCacheByKey[propKey] = false;
          return null;
        } catch (e) {
          console.warn('Logo load failed (' + propKey + '): ' + e.message);
          _logoBlobCacheByKey[propKey] = false;
          return null;
        }
      }
      // Главно лого на ИУ – Варна. Ако MON_MAIN_LOGO_FILE_ID не е зададено,
      // връща наследения единичен лого blob (за обратна съвместимост).
