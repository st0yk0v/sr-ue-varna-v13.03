      /**
       * Data Change Detection - Track what changed and notify frontend
       */
      function getDataChangeStream(body) {
        try {
          body = body || {};
          var clientVersions = body.versions || {};
          var currentVersions = getDataVersions_();
          var appChanged = Number(clientVersions.applications || 0) < Number(currentVersions.applications || 0);
          var compChanged = Number(clientVersions.competitions || 0) < Number(currentVersions.competitions || 0);
          var reviewerChanged = Number(clientVersions.reviewers || 0) < Number(currentVersions.reviewers || 0);
          var messagesChanged = Number(clientVersions.messages || 0) < Number(currentVersions.messages || 0);
          var hasChanges = appChanged || compChanged || reviewerChanged || messagesChanged;

          if (body.includeDetails !== true) {
            return {
              success: true,
              changes: {
                applicationsChanged: appChanged,
                competitionsChanged: compChanged,
                reviewersChanged: reviewerChanged,
                messagesChanged: messagesChanged,
                hasChanges: hasChanges,
                versions: currentVersions,
                lastCheck: nowISO()
              }
            };
          }

          var lastCheck = body.lastCheck || Utilities.formatDate(new Date(0), 'Europe/Sofia', "yyyy-MM-dd'T'HH:mm:ss.SSSXXX");
          var changes = {
            applications: [],
            competitions: [],
            reviewers: [],
            applicationsChanged: appChanged,
            competitionsChanged: compChanged,
            reviewersChanged: reviewerChanged,
            hasChanges: hasChanges,
            versions: currentVersions,
            lastCheck: nowISO()
          };

          // PERF: short-circuit when nothing changed since the last poll. Prevents
          // 3 full-sheet reads per polling interval (20–30s × N concurrent users)
          // when the data is steady-state — by far the most common case.
          if (!hasChanges) {
            return { success: true, changes: changes };
          }

          // PERF: only read sheets whose version actually bumped.
          if (appChanged) {
          var appSheet = getSheet();
          var appData = appSheet.getDataRange().getValues();
          for (var i = 1; i < appData.length; i++) {
            var row = appData[i];
            var created = String(row[COL.CREATED - 1]);
            if (created > lastCheck) {
              changes.applications.push({
                id: String(row[COL.ID - 1]),
                email: String(row[COL.USER_EMAIL - 1]),
                title: String(row[COL.TITLE - 1]),
                status: String(row[COL.STATUS - 1]),
                created: created
              });
            }
          }
          }

          if (compChanged) {
          var compSheet = getCompetitionsSheet();
          var compData = compSheet.getDataRange().getValues();
          for (var i = 1; i < compData.length; i++) {
            var row = compData[i];
            var created = String(row[COMP_COL.CREATED - 1]);
            if (created > lastCheck) {
              changes.competitions.push({
                id: String(row[COMP_COL.ID - 1]),
                name: String(row[COMP_COL.NAME - 1]),
                created: created
              });
            }
          }
          }

          if (reviewerChanged) {
          var revSheet = getReviewersSheet();
          var revData = revSheet.getDataRange().getValues();
          for (var i = 1; i < revData.length; i++) {
            var row = revData[i];
            var created = String(row[REV_COL.CREATED - 1]);
            if (created > lastCheck) {
              changes.reviewers.push({
                id: String(row[REV_COL.ID - 1]),
                name: String(row[REV_COL.NAME - 1]),
                status: String(row[REV_COL.STATUS - 1]),
                created: created
              });
            }
          }
          }

          return { success: true, changes: changes };
        } catch (err) {
          return { success: false, error: 'getDataChangeStream failed: ' + err.message };
        }
      }

