        PROPOSED_REVIEWERS:6, JUSTIFICATION:7, STATUS:8,
        CONFIRMED_BY:9, CONFIRMED_AT:10, FINAL_REVIEWERS:11,
        MODIFICATIONS_NOTE:12, HISTORY:13
      };
