            if (st === 'drafts') st = 'draft';
            if (st !== 'draft') return { success: false, error: 'Само чернова може да се изтрива.' };
            if (owner !== caller) return { success: false, error: 'Нямате право да изтриете тази чернова.' };
            rowIdx = r;
            rowData = data[r];
            break;
          }
          if (rowIdx < 0) return { success: false, error: 'Формулярът не е намерен.' };

          // ── Collect Drive file IDs that were attached to this draft ──────
          // These include both uploaded blobs (fileIds) and library/generated
          // copies stored in AttachedDocs. We'll attempt to trash each one.
          var driveIdsToTrash = [];
          try {
            var _fileIds = (fidIdx >= 0) ? safeParseJSON(String(rowData[fidIdx] || ''), []) : [];
            if (Array.isArray(_fileIds)) { _fileIds.forEach(function(fid){ if (fid && typeof fid === 'string') driveIdsToTrash.push(fid); }); }
          } catch (_) {}
          try {
            var _adocs = (adIdx >= 0) ? safeParseJSON(String(rowData[adIdx] || ''), []) : [];
            if (Array.isArray(_adocs)) {
              _adocs.forEach(function(doc) {
                if (!doc) return;
                if (doc.id && typeof doc.id === 'string') driveIdsToTrash.push(doc.id);
                if (doc.driveId && typeof doc.driveId === 'string') driveIdsToTrash.push(doc.driveId);
              });
            }
          } catch (_) {}

          // ── 1. Delete the Drive app folder and all its contents ──────────
          var fidKey = _APP_FOLDER_PROP_PREFIX + id;
          var folderDeleted = false;
          try {
            var appFolder = getOrCreateAppFolder(id);
            if (appFolder) {
              try {
                var allFiles = appFolder.getFiles();
                while (allFiles.hasNext()) { try { allFiles.next().setTrashed(true); } catch (_) {} }
              } catch (_) {}
              try {
                var allSubFolders = appFolder.getFolders();
                while (allSubFolders.hasNext()) { try { allSubFolders.next().setTrashed(true); } catch (_) {} }
              } catch (_) {}
              try { appFolder.setTrashed(true); folderDeleted = true; } catch (_) {}
            }
          } catch (_) { /* folder cleanup is best-effort */ }

          // ── 2. Trash individual Drive files from fileIds + attachedDocs ──
          // Deduped; only trashes files the applicant owns or that are
          // in their personal session folder (not library originals).
          var _trashedIds = {};
          driveIdsToTrash.forEach(function(fid) {
            if (!fid || _trashedIds[fid]) return;
            _trashedIds[fid] = true;
            try {
              var f = DriveApp.getFileById(fid);
              // Safety: do NOT trash files inside the official library folders
              if (isFileInPublicDownloadFolder_(fid)) return;
              f.setTrashed(true);
            } catch (_) {}
          });

          // ── 3. Trash applicant session-folder copies ─────────────────────
          // generateApplicationDocument copies templates into
          // My Documents / SESSION_FOLDER_NAME. Those copies have no direct
          // reference in the sheet (only the system copy's id is recorded in
          // attachedDocs). We scan the session folder for files whose name
