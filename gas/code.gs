        if (!auth.userId) return { success: false, error: 'Необходима е автентикация' };

        var files = body.files;
        if (!Array.isArray(files) || files.length === 0) {
          return { success: false, error: 'Няма избрани файлове за качване' };
        }

        // v10.0.0-mydocs-folders: if formId is provided, upload to the per-proposal
        // folder instead of the root "My Documents" folder.
        var formId = String(body.formId || '').trim();
        var targetFolder = null;

        try {
          if (formId) {
            // v10.2.0-restructure: use root-level per-form session folder
