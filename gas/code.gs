      // ============================================================
      //  LIBRARY DEPOSIT TRACKER — UC-41
      //  Правилник 11.04.2024 чл. 22: минимум 3 екземпляра или
      //  електронен екземпляр в библиотеката в срок до 1 месец след
      //  публикуването на монография/статия/сборник.
      // ============================================================
      var LIBRARY_DEPOSITS_SHEET_NAME = 'LibraryDeposits';
      var LIB_COL = {
        ID:1, PROJECT_ID:2, PUBLICATION_TYPE:3, TITLE:4, AUTHORS:5,
        PUBLISHED_AT:6, DEADLINE:7, COPIES_PROMISED:8, COPIES_DELIVERED:9,
        ELECTRONIC_COPY:10, STATUS:11, EVIDENCE_FILE_ID:12, NOTES:13,
        CREATED_BY:14, CREATED_AT:15, CONFIRMED_BY:16, CONFIRMED_AT:17
      };
      var LIB_TOTAL_COLS = 17;
      var LIB_HEADERS = ['ID','ProjectId','PublicationType','Title','Authors','PublishedAt','Deadline','CopiesPromised','CopiesDelivered','ElectronicCopy','Status','EvidenceFileId','Notes','CreatedBy','CreatedAt','ConfirmedBy','ConfirmedAt'];

      function getLibraryDepositsSheet() {
        if (_sheetCache[LIBRARY_DEPOSITS_SHEET_NAME]) return _sheetCache[LIBRARY_DEPOSITS_SHEET_NAME];
        var ss = _getCachedSpreadsheet();
        var sh = ss.getSheetByName(LIBRARY_DEPOSITS_SHEET_NAME);
        if (!sh) {
          sh = ss.insertSheet(LIBRARY_DEPOSITS_SHEET_NAME);
          sh.getRange(1, 1, 1, LIB_TOTAL_COLS).setValues([LIB_HEADERS]);
          sh.setFrozenRows(1);
          sh.getRange(1, 1, 1, LIB_TOTAL_COLS).setBackground('#1F4E78').setFontColor('#ffffff').setFontWeight('bold');
        } else {
          try { repairSheetHeaders_(sh, LIB_HEADERS, LIB_TOTAL_COLS); } catch (_) {}
        }
        try { protectManagedSheet_(sh, 'ERP Library Deposits — редакция само през системата'); } catch (_) {}
        _sheetCache[LIBRARY_DEPOSITS_SHEET_NAME] = sh;
        return sh;
      }

      /**
       * Parse the EVIDENCE_FILE_ID column.
       * Backwards compatible: legacy rows store a single Drive file ID as a
       * plain string; new rows store a JSON array of file metadata
       * `[{ fileId, name, size, type, previewLink, uploadedBy, uploadedAt }]`.
       */
      function _libParseFiles_(raw) {
        if (!raw) return [];
        var s = String(raw).trim();
        if (!s) return [];
        if (s.charAt(0) === '[') {
          try {
            var arr = JSON.parse(s);
            return Array.isArray(arr) ? arr : [];
          } catch (_) { return []; }
        }
        // Legacy single-id string → wrap as one synthetic file record
        return [{
          fileId      : s,
          name        : '(архив)',
          size        : '',
          type        : 'application/octet-stream',
          previewLink : 'https://drive.google.com/file/d/' + s + '/preview?rm=minimal',
          uploadedBy  : '',
          uploadedAt  : ''
        }];
      }
      function _libSerializeFiles_(arr) {
        return JSON.stringify(Array.isArray(arr) ? arr : []);
      }
      /** Per-deposit Drive subfolder under root: LibraryDeposits/<projectId>/<depositId> */
      function _libGetDepositFolder_(projectId, depositId) {
        var root;
        try { root = DriveApp.getFolderById(DRIVE_FOLDER_ID); }
        catch (_) { root = DriveApp.getRootFolder(); }
        var libIt = root.getFoldersByName('LibraryDeposits');
        var libF  = libIt.hasNext() ? libIt.next() : root.createFolder('LibraryDeposits');
        var pIt   = libF.getFoldersByName(String(projectId || 'misc'));
        var pF    = pIt.hasNext() ? pIt.next() : libF.createFolder(String(projectId || 'misc'));
        var dIt   = pF.getFoldersByName(String(depositId));
        return dIt.hasNext() ? dIt.next() : pF.createFolder(String(depositId));
      }
      /**
       * Upload an array of base64 file payloads `[{ name, type, data }]`
       * into the per-deposit folder and return a normalized metadata array.
       */
      function _libUploadFilesToDrive_(files, projectId, depositId, uploaderEmail) {
        if (!Array.isArray(files) || !files.length) return [];
        var folder = _libGetDepositFolder_(projectId, depositId);
        var nowIso = new Date().toISOString();
        var saved  = [];
        for (var i = 0; i < files.length; i++) {
          var f = files[i];
          try {
            if (!f || !f.data) continue;
            var dataStr = String(f.data);
            var comma   = dataStr.indexOf(',');
            var b64     = comma === -1 ? dataStr : dataStr.slice(comma + 1);
            var bytes   = Utilities.base64Decode(b64);
            var blob    = Utilities.newBlob(bytes, f.type || 'application/octet-stream', f.name || ('deposit_' + (i + 1)));
            var dFile   = folder.createFile(blob);
            try { setSecureSharing_(dFile); } catch (_) {}
            var fid = dFile.getId();
            saved.push({
              fileId      : fid,
              name        : f.name || ('deposit_' + (i + 1)),
              size        : f.size || (Math.round(bytes.length / 1024) + ' KB'),
              type        : f.type || 'application/octet-stream',
              previewLink : 'https://drive.google.com/file/d/' + fid + '/preview?rm=minimal',
              uploadedBy  : uploaderEmail || '',
              uploadedAt  : nowIso
            });
          } catch (err) {
            console.warn('LibraryDeposit upload error [' + (f && f.name) + ']: ' + err.message);
          }
        }
        return saved;
      }
      /** Compute deposit status from files count + electronic flag + promised. */
      function _libDeriveStatus_(filesLen, electronicCopy, promised, deadlineMs) {
        var needed = Math.max(3, Number(promised || 3));
        if (electronicCopy && filesLen >= 1) return 'confirmed';
        if (filesLen >= needed) return 'confirmed';
        if (filesLen > 0) return 'partial';
        if (deadlineMs && deadlineMs < Date.now()) return 'overdue';
        return 'pending';
      }
      /** Best-effort notify the LIBRARY_EMAIL property recipient. */
      function _libNotifyLibrary_(subject, heading, lines, notifyType) {
        try {
          var email = '';
          try { email = _scriptProps_().getProperty('LIBRARY_EMAIL') || ''; } catch (_) {}
          if (!email) return;
          var html = buildNotificationHtml_(heading, lines || [], 'UEV-ERP — Библиотечни депозити');
          notifyApplicant_(email, subject, html, notifyType || 'report_due');
        } catch (e) { console.warn('_libNotifyLibrary_ failed: ' + e.message); }
      }

      /** UC-41 step 1: leader registers a publication for library deposit. */
      function addLibraryDeposit(body) {
        try {
          var auth = resolveAuthContext(body);
          var projectId = String(body.projectId || '').trim();
          var title     = String(body.title     || '').trim();
          if (!projectId) return { success:false, error:'Липсва projectId.' };
          if (!title)     return { success:false, error:'Заглавието е задължително.' };

          var pubType = String(body.publicationType || 'monograph').trim();
          var publishedAt = body.publishedAt ? new Date(body.publishedAt) : new Date();
          if (isNaN(publishedAt.getTime())) publishedAt = new Date();
          // Деадлайн: 1 месец след публикуването (правилник чл. 22)
          var deadline = new Date(publishedAt.getTime());
          deadline.setMonth(deadline.getMonth() + 1);

          var copiesPromised = Number(body.copiesPromised || 3);
          var electronicCopy = !!body.electronicCopy;
          var incoming       = Array.isArray(body.files) ? body.files : [];

          // Quota invariant — Правилник чл. 22:
          //   • Брой качени файлове трябва да съответства на обещаните екземпляри
          //     (всеки файл = един дигитализиран екземпляр), ИЛИ
          //   • При „електронен екземпляр" е достатъчен поне 1 файл.
          if (incoming.length > 0) {
            if (electronicCopy) {
              if (incoming.length < 1)
                return { success:false, error:'При електронен екземпляр е необходим поне 1 файл.' };
            } else if (incoming.length !== copiesPromised) {
              return { success:false, error:'Броят прикачени файлове (' + incoming.length + ') трябва да съответства на броя обещани екземпляри (' + copiesPromised + ').' };
            }
          }

          var sh = getLibraryDepositsSheet();
          var id = 'LD-' + Date.now() + '-' + Math.floor(Math.random() * 9000 + 1000);
          var nowIso = new Date().toISOString();

          // Upload files (if any) BEFORE row append so we can persist metadata atomically.
          var savedFiles = [];
          if (incoming.length) {
            savedFiles = _libUploadFilesToDrive_(incoming, projectId, id, auth.userId || '');
          }

          var copiesDelivered = savedFiles.length;
          var status = _libDeriveStatus_(copiesDelivered, electronicCopy, copiesPromised, deadline.getTime());

          var row = new Array(LIB_TOTAL_COLS);
          row[LIB_COL.ID-1]                = id;
          row[LIB_COL.PROJECT_ID-1]        = projectId;
          row[LIB_COL.PUBLICATION_TYPE-1]  = pubType;
          row[LIB_COL.TITLE-1]             = title;
          row[LIB_COL.AUTHORS-1]           = String(body.authors || '');
          row[LIB_COL.PUBLISHED_AT-1]      = publishedAt.toISOString();
          row[LIB_COL.DEADLINE-1]          = deadline.toISOString();
          row[LIB_COL.COPIES_PROMISED-1]   = copiesPromised;
          row[LIB_COL.COPIES_DELIVERED-1]  = copiesDelivered;
          row[LIB_COL.ELECTRONIC_COPY-1]   = electronicCopy;
          row[LIB_COL.STATUS-1]            = status;
          row[LIB_COL.EVIDENCE_FILE_ID-1]  = _libSerializeFiles_(savedFiles);
          row[LIB_COL.NOTES-1]             = String(body.notes || '');
          row[LIB_COL.CREATED_BY-1]        = auth.userId || '';
          row[LIB_COL.CREATED_AT-1]        = nowIso;
          row[LIB_COL.CONFIRMED_BY-1]      = '';
          row[LIB_COL.CONFIRMED_AT-1]      = '';
          sh.appendRow(row);

          try { touchDataVersion_('library_deposits'); } catch (_) {}
          try { auditAppendChainRow_('library_deposit_added', auth.userId, { id:id, projectId:projectId, title:title, files:savedFiles.length, deadline:deadline.toISOString() }); } catch (_) {}

          // Notify Библиотека (за приемане на публикации/екземпляри)
          try {
            _libNotifyLibrary_(
              '📚 Нов библиотечен депозит — ' + title,
              'Регистриран е нов библиотечен депозит',
              [
                { label:'Заглавие:',         value: title },
                { label:'Автори:',           value: String(body.authors || '') || '—' },
                { label:'Тип публикация:',   value: pubType },
                { label:'Проект:',           value: projectId },
                { label:'Обещани екземпляри:', value: String(copiesPromised) },
                { label:'Качени файлове:',   value: String(savedFiles.length) },
                { label:'Електронен екземпляр:', value: electronicCopy ? 'Да' : 'Не' },
                { label:'Срок за депозит:',  value: deadline.toISOString().substring(0,10) },
                { label:'Текущ статус:',     value: status }
              ]
            );
          } catch (_) {}

          return { success:true, id:id, deadline:deadline.toISOString(), status:status, files:savedFiles };
        } catch (e) {
          try { logError('addLibraryDeposit', e, body); } catch (_) {}
          return { success:false, error:e.message };
        }
      }

      /** UC-41 — append additional files to an existing deposit (leader / library / admin). */
      function addLibraryDepositFile(body) {
        try {
          var auth = resolveAuthContext(body);
          var id = String(body.id || '').trim();
          if (!id) return { success:false, error:'Липсва id на депозит.' };
          var incoming = Array.isArray(body.files) ? body.files : [];
          if (!incoming.length) return { success:false, error:'Няма прикачени файлове.' };

          var sh = getLibraryDepositsSheet();
          var data = sh.getDataRange().getValues();
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][LIB_COL.ID-1]) !== id) continue;

            var role = (auth.role || '').toLowerCase();
            var createdBy = String(data[i][LIB_COL.CREATED_BY-1] || '').toLowerCase();
            var canAdd = auth.isAdmin
                      || role === 'library' || role === 'nidd'
                      || (auth.userId || '').toLowerCase() === createdBy;
            if (!canAdd) return { success:false, error:'Нямате право да добавяте файлове към този депозит.' };

            var existing = _libParseFiles_(data[i][LIB_COL.EVIDENCE_FILE_ID-1]);
            var promised = Number(data[i][LIB_COL.COPIES_PROMISED-1] || 3);
            var electronicCopy = !!data[i][LIB_COL.ELECTRONIC_COPY-1];
            if (!electronicCopy && existing.length + incoming.length > promised) {
              return { success:false, error:'Общият брой файлове (' + (existing.length + incoming.length) + ') надхвърля обещаните екземпляри (' + promised + ').' };
            }

            var projectId = String(data[i][LIB_COL.PROJECT_ID-1] || '');
            var added = _libUploadFilesToDrive_(incoming, projectId, id, auth.userId || '');
            var combined = existing.concat(added);
            var deadlineMs = data[i][LIB_COL.DEADLINE-1] ? new Date(data[i][LIB_COL.DEADLINE-1]).getTime() : 0;
            var status = _libDeriveStatus_(combined.length, electronicCopy, promised, deadlineMs);

            // Batch: 3 cell writes → 1 setValues round-trip.
            var _row = data[i].slice();
            _row[LIB_COL.EVIDENCE_FILE_ID - 1] = _libSerializeFiles_(combined);
            _row[LIB_COL.COPIES_DELIVERED  - 1] = combined.length;
            _row[LIB_COL.STATUS            - 1] = status;
            sh.getRange(i+1, 1, 1, LIB_TOTAL_COLS).setValues([_row]);

            try { touchDataVersion_('library_deposits'); } catch (_) {}
            try { auditAppendChainRow_('library_deposit_file_added', auth.userId, { id:id, added:added.length, total:combined.length }); } catch (_) {}
            return { success:true, files:combined, status:status };
          }
          return { success:false, error:'Депозитът не е намерен.' };
        } catch (e) {
          try { logError('addLibraryDepositFile', e, body); } catch (_) {}
          return { success:false, error:e.message };
        }
      }

      /** UC-41 — remove a single file from a deposit (revokes Drive access). */
      function removeLibraryDepositFile(body) {
        try {
          var auth = resolveAuthContext(body);
          var id = String(body.id || '').trim();
          var fileId = String(body.fileId || '').trim();
          if (!id || !fileId) return { success:false, error:'Липсват id / fileId.' };

          var sh = getLibraryDepositsSheet();
          var data = sh.getDataRange().getValues();
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][LIB_COL.ID-1]) !== id) continue;
            var role = (auth.role || '').toLowerCase();
            var createdBy = String(data[i][LIB_COL.CREATED_BY-1] || '').toLowerCase();
            var canDel = auth.isAdmin
                      || role === 'library' || role === 'nidd'
                      || (auth.userId || '').toLowerCase() === createdBy;
            if (!canDel) return { success:false, error:'Нямате право да изтривате файлове от този депозит.' };

            var existing = _libParseFiles_(data[i][LIB_COL.EVIDENCE_FILE_ID-1]);
            var remaining = existing.filter(function (f) { return f && String(f.fileId) !== fileId; });
            if (remaining.length === existing.length)
              return { success:false, error:'Файлът не е намерен в депозита.' };

            // Best-effort trash the Drive file
            try { DriveApp.getFileById(fileId).setTrashed(true); } catch (_) {}

            var promised = Number(data[i][LIB_COL.COPIES_PROMISED-1] || 3);
            var electronicCopy = !!data[i][LIB_COL.ELECTRONIC_COPY-1];
            var deadlineMs = data[i][LIB_COL.DEADLINE-1] ? new Date(data[i][LIB_COL.DEADLINE-1]).getTime() : 0;
            var status = _libDeriveStatus_(remaining.length, electronicCopy, promised, deadlineMs);

            // Batch: 3 cell writes → 1 setValues round-trip.
            var _row = data[i].slice();
            _row[LIB_COL.EVIDENCE_FILE_ID - 1] = _libSerializeFiles_(remaining);
            _row[LIB_COL.COPIES_DELIVERED  - 1] = remaining.length;
            _row[LIB_COL.STATUS            - 1] = status;
            sh.getRange(i+1, 1, 1, LIB_TOTAL_COLS).setValues([_row]);

            try { touchDataVersion_('library_deposits'); } catch (_) {}
            try { auditAppendChainRow_('library_deposit_file_removed', auth.userId, { id:id, fileId:fileId, total:remaining.length }); } catch (_) {}
            return { success:true, files:remaining, status:status };
          }
          return { success:false, error:'Депозитът не е намерен.' };
        } catch (e) {
          try { logError('removeLibraryDepositFile', e, body); } catch (_) {}
          return { success:false, error:e.message };
        }
      }

      /** UC-41 step 2: librarian confirms physical/electronic delivery. */
      function confirmLibraryDeposit(body) {
        try {
          var auth = resolveAuthContext(body);
          var role = (auth.role || '').toLowerCase();
          if (!auth.isAdmin && role !== 'library' && role !== 'nidd')
            return { success:false, error:'Само библиотеката, НИДД или администратор може да потвърди депозит.' };
          var id = String(body.id || '').trim();
          if (!id) return { success:false, error:'Липсва id на депозит.' };
          var sh = getLibraryDepositsSheet();
          var data = sh.getDataRange().getValues();
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][LIB_COL.ID-1]) === id) {
              // Files = source of truth for delivered count when present
              var existingFiles = _libParseFiles_(data[i][LIB_COL.EVIDENCE_FILE_ID-1]);
              var copiesDelivered;
              if (existingFiles.length > 0) {
                copiesDelivered = existingFiles.length;
              } else {
                copiesDelivered = Number(body.copiesDelivered != null ? body.copiesDelivered : data[i][LIB_COL.COPIES_PROMISED-1]);
              }
              var electronicCopy = body.electronicCopy != null ? !!body.electronicCopy : !!data[i][LIB_COL.ELECTRONIC_COPY-1];
              var promised       = Number(data[i][LIB_COL.COPIES_PROMISED-1] || 3);
              var deadlineMs     = data[i][LIB_COL.DEADLINE-1] ? new Date(data[i][LIB_COL.DEADLINE-1]).getTime() : 0;
              // Правилник чл. 22 — 3+ копия ИЛИ електронно копие
              var fullyMet = electronicCopy || copiesDelivered >= Math.max(3, promised);
              var status = fullyMet ? 'confirmed' : (copiesDelivered > 0 ? 'partial' : 'pending');
              // If still not met but past deadline, mark overdue (admin override)
              if (!fullyMet && deadlineMs && deadlineMs < Date.now() && copiesDelivered === 0) status = 'overdue';
              // Batch: 5–6 cell writes → 1 setValues round-trip.
              var _row = data[i].slice();
              _row[LIB_COL.COPIES_DELIVERED - 1] = copiesDelivered;
              _row[LIB_COL.ELECTRONIC_COPY  - 1] = electronicCopy;
              _row[LIB_COL.STATUS           - 1] = status;
              _row[LIB_COL.CONFIRMED_BY     - 1] = auth.userId || '';
              _row[LIB_COL.CONFIRMED_AT     - 1] = new Date().toISOString();
              if (body.notes) _row[LIB_COL.NOTES - 1] = String(body.notes);
              sh.getRange(i+1, 1, 1, LIB_TOTAL_COLS).setValues([_row]);
              try { touchDataVersion_('library_deposits'); } catch (_) {}
              try { auditAppendChainRow_('library_deposit_confirmed', auth.userId, { id:id, status:status, copiesDelivered:copiesDelivered, files:existingFiles.length }); } catch (_) {}
              return { success:true, status:status };
            }
          }
          return { success:false, error:'Депозитът не е намерен.' };
        } catch (e) {
          try { logError('confirmLibraryDeposit', e, body); } catch (_) {}
          return { success:false, error:e.message };
        }
      }

      /** UC-41 listing — filterable by projectId / status / overdue. */
      function getLibraryDeposits(body) {
        try {
          body = body || {};
          var sh = getLibraryDepositsSheet();
          var data = sh.getDataRange().getValues();
          var out = [];
          var now = Date.now();
          var fProj = body.projectId ? String(body.projectId) : '';
          var fStatus = body.status ? String(body.status) : '';
          for (var i = 1; i < data.length; i++) {
            var row = data[i];
            if (!row[LIB_COL.ID-1]) continue;
            var deadlineIso = row[LIB_COL.DEADLINE-1];
            var deadlineMs = deadlineIso ? new Date(deadlineIso).getTime() : 0;
            var status = String(row[LIB_COL.STATUS-1] || 'pending');
            // Auto-derive overdue without writing back (cheap read-time computation)
            if (status !== 'confirmed' && deadlineMs && deadlineMs < now) status = 'overdue';
            if (fProj && String(row[LIB_COL.PROJECT_ID-1]) !== fProj) continue;
            if (fStatus && status !== fStatus) continue;
            out.push({
              id:               row[LIB_COL.ID-1],
              projectId:        row[LIB_COL.PROJECT_ID-1],
              publicationType:  row[LIB_COL.PUBLICATION_TYPE-1],
              title:            row[LIB_COL.TITLE-1],
              authors:          row[LIB_COL.AUTHORS-1],
              publishedAt:      row[LIB_COL.PUBLISHED_AT-1],
              deadline:         deadlineIso,
              copiesPromised:   Number(row[LIB_COL.COPIES_PROMISED-1] || 0),
              copiesDelivered:  Number(row[LIB_COL.COPIES_DELIVERED-1] || 0),
              electronicCopy:   !!row[LIB_COL.ELECTRONIC_COPY-1],
              status:           status,
              files:            _libParseFiles_(row[LIB_COL.EVIDENCE_FILE_ID-1]),
              notes:            row[LIB_COL.NOTES-1] || '',
              createdBy:        row[LIB_COL.CREATED_BY-1],
              createdAt:        row[LIB_COL.CREATED_AT-1],
              confirmedBy:      row[LIB_COL.CONFIRMED_BY-1] || '',
              confirmedAt:      row[LIB_COL.CONFIRMED_AT-1] || ''
            });
          }
          // Newest first
          out.sort(function (a, b) { return String(b.createdAt).localeCompare(String(a.createdAt)); });
          return { success:true, deposits:out };
        } catch (e) {
          try { logError('getLibraryDeposits', e, body); } catch (_) {}
          return { success:false, error:e.message };
        }
      }

      // ============================================================
      //  UC-23 PUBLIC RESULTS — anonymous-safe ranking publication
      //  Правилник чл. 14: резултатите се обявяват на сайта на ИУ.
      // ============================================================
      function getPublicResults(body) {
        try {
          body = body || {};
          var compId = body.competitionId ? String(body.competitionId).trim() : '';
          var ss = _getCachedSpreadsheet();
          var formsSh = ss.getSheetByName(SHEET_NAME);
          if (!formsSh) return { success:true, competitions:[], note:'Няма публикувани резултати.' };
          var data = formsSh.getDataRange().getValues();
          var byComp = {};
          for (var i = 1; i < data.length; i++) {
            var row = data[i];
            var status = String(row[COL.STATUS-1] || '').toLowerCase();
            // Only published / approved-for-funding states are public
            if (['approved','approved_for_funding','contracted','active','funded','published','accepted'].indexOf(status) === -1) continue;
            var cId = String(row[COL.COMPETITION-1] || '');
            if (compId && cId !== compId) continue;
            if (!byComp[cId]) byComp[cId] = [];
            // Anonymisation: no email, no team, no notes — only public-safe fields
            var evalRaw = row[COL.EVALUATION-1];
            var score = 0;
            try { var ev = (typeof evalRaw === 'string') ? JSON.parse(evalRaw || '{}') : (evalRaw || {}); score = Number(ev.totalScore || ev.total || 0); } catch (_) { score = 0; }
            byComp[cId].push({
              id:           String(row[COL.ID-1] || ''),
              title:        String(row[COL.TITLE-1] || ''),
              projectCode:  String(row[COL.PROJECT_CODE-1] || ''),
              area:         String(row[COL.AREA-1] || ''),
              status:       status,
              score:        score
            });
          }
          // Build per-competition ranked lists
          var compsSh = ss.getSheetByName(COMPETITIONS_SHEET_NAME);
          var compMeta = {};
          if (compsSh) {
            var cd = compsSh.getDataRange().getValues();
            for (var k = 1; k < cd.length; k++) {
              compMeta[String(cd[k][0])] = { name:String(cd[k][1]||''), year:cd[k][6]||'', deadline:cd[k][2]||'' };
            }
          }
          var results = Object.keys(byComp).map(function (cId) {
            var rows = byComp[cId].sort(function (a, b) { return b.score - a.score; });
            rows.forEach(function (r, idx) { r.rank = idx + 1; });
            return Object.assign({ competitionId:cId, total:rows.length, items:rows }, compMeta[cId] || {});
          }).sort(function (a, b) { return String(b.year).localeCompare(String(a.year)); });
          return { success:true, competitions:results };
        } catch (e) {
          try { logError('getPublicResults', e, body); } catch (_) {}
          return { success:false, error:e.message };
        }
      }


      // ============================================================
      //  EXPENSE MANAGEMENT  — Financial CRUD + rules engine
      // ============================================================

      /**
       * Submit an expense request for a project.
       * Validates cost group, budget limits, and financial rules.
       */
      function createExpense(body) {
        try {
          var auth = resolveAuthContext(body);
          var projectId = String(body.projectId || '').trim();
          if (!projectId) return { success: false, error: 'Липсва projectId.' };

          // Verify user is project leader or admin
          var projSheet = getProjectsSheet();
          var projData = projSheet.getDataRange().getValues();
          var projRow = null;  var projRowIdx = -1;
          for (var i = 1; i < projData.length; i++) {
            if (String(projData[i][PROJ_COL.ID - 1]).trim() === projectId) { projRow = projData[i]; projRowIdx = i; break; }
          }
          if (!projRow) return { success: false, error: 'Проектът не е намерен.' };
          var leaderEmail = String(projRow[PROJ_COL.LEADER_EMAIL - 1]).toLowerCase();
          if (!auth.isAdmin && auth.role !== ROLE_FINANCIAL && leaderEmail !== (auth.userId || '').toLowerCase())
            return { success: false, error: 'Нямате право да създавате разходи за този проект.' };

          var costGroup = String(body.costGroup || '').trim();
          if (!VALID_COST_GROUPS.includes(costGroup))
            return { success: false, error: 'Невалидна разходна група. Допустими: ' + VALID_COST_GROUPS.join(', ') };

          var amount = parseFloat(body.amount);
          if (isNaN(amount) || amount <= 0) return { success: false, error: 'Невалидна сума.' };

          // ── Budget rules engine ──────────────────────────────────────
          var budget = {};
          try { budget = JSON.parse(String(projRow[PROJ_COL.BUDGET - 1] || '{}')); } catch (_) {}
          var budgetExec = {};
          try { budgetExec = JSON.parse(String(projRow[PROJ_COL.BUDGET_EXECUTION - 1] || '{}')); } catch (_) {}

          var expYear = String(body.year || new Date().getFullYear());

          // Rule: external_services ≤ 20% of salaries budget
          if (costGroup === 'external_services') {
            var salariesBudget = parseFloat(budget.salaries || budget.wages || 0) || 0;
            var extSpent = parseFloat((budgetExec.external_services || {})[expYear] || 0) || 0;
            var extLimit = salariesBudget * 0.20;
            if (extSpent + amount > extLimit) {
              return { success: false, error: 'Разходите за външни услуги не могат да надвишат 20% от възнагражденията (' + (extLimit / 1.95583).toFixed(2) + ' €).' };
            }
          }

          // Rule: no cross-year budget transfer
          var yearBudget = parseFloat(budget[expYear] || budget.total || 0) || 0;
          var yearSpent  = 0;
          Object.keys(budgetExec).forEach(function(grp) {
            yearSpent += parseFloat((budgetExec[grp] || {})[expYear] || 0) || 0;
          });

          // Enforce budget ceiling — block expense if it would exceed yearly budget
          if (yearBudget > 0 && yearSpent + amount > yearBudget) {
            return { success: false, error: 'Разходът надвишава годишния бюджет за ' + expYear + '. Наличен остатък: ' + ((yearBudget - yearSpent) / 1.95583).toFixed(2) + ' € от ' + (yearBudget / 1.95583).toFixed(2) + ' €.' };
          }

          var expSheet = getExpensesSheet();
          var id = 'EXP-' + Utilities.getUuid().replace(/-/g, '').substring(0, 12).toUpperCase();
          var now = new Date().toISOString();
          var expRow = new Array(EXP_TOTAL_COLS).fill('');
          expRow[EXP_COL.ID - 1] = id;
          expRow[EXP_COL.PROJECT_ID - 1] = projectId;
          expRow[EXP_COL.BUDGET_LINE - 1] = String(body.budgetLine || '');
          expRow[EXP_COL.DESCRIPTION - 1] = String(body.description || '');
          expRow[EXP_COL.AMOUNT - 1] = amount;
          expRow[EXP_COL.DATE - 1] = body.date || now.substring(0, 10);
          expRow[EXP_COL.STATUS - 1] = 'pending';
          expRow[EXP_COL.REQUESTED_BY - 1] = auth.userId || '';
          expRow[EXP_COL.REQUESTED_AT - 1] = now;
          expRow[EXP_COL.COST_GROUP - 1] = costGroup;
          expRow[EXP_COL.YEAR - 1] = expYear;
          expRow[EXP_COL.NOTES - 1] = String(body.notes || '');
          expSheet.appendRow(expRow);

          logTransaction('CREATE_EXPENSE', auth.userId, id, { projectId: projectId, amount: amount, costGroup: costGroup });
          return { success: true, expenseId: id };
        } catch (err) {
          logError('createExpense', err, body);
          return { success: false, error: 'createExpense failed: ' + err.message };
        }
      }

      /**
       * Get expenses for a project.
       */
      function getExpenses(body) {
        try {
          var auth = resolveAuthContext(body);
          var projectId = String(body.projectId || '').trim();
          // Version-keyed CacheService cache (30s TTL)
          var sc = _scriptCache_();
          var dv = getDataVersions_();
          var cacheKey = 'gExp:' + projectId + ':' + (body.costGroup || '') + ':' + (body.status || '') + ':' + dv.projects;
          if (!body.forceRefresh) {
            try { var cv = sc.get(cacheKey); if (cv) return JSON.parse(cv); } catch (_) {}
          }
          var expSheet = getExpensesSheet();
          var data = expSheet.getDataRange().getValues();
          var expenses = [];
          for (var i = 1; i < data.length; i++) {
            var r = data[i];
            if (!String(r[EXP_COL.ID - 1]).trim()) continue;
            if (projectId && String(r[EXP_COL.PROJECT_ID - 1]).trim() !== projectId) continue;
            expenses.push({
              id: String(r[EXP_COL.ID - 1]),
              projectId: String(r[EXP_COL.PROJECT_ID - 1]),
              budgetLine: String(r[EXP_COL.BUDGET_LINE - 1]),
              description: String(r[EXP_COL.DESCRIPTION - 1]),
              amount: parseFloat(r[EXP_COL.AMOUNT - 1]) || 0,
              date: String(r[EXP_COL.DATE - 1]),
              status: String(r[EXP_COL.STATUS - 1]),
              requestedBy: String(r[EXP_COL.REQUESTED_BY - 1]),
              costGroup: String(r[EXP_COL.COST_GROUP - 1]),
              year: String(r[EXP_COL.YEAR - 1]),
              approvedBy: String(r[EXP_COL.APPROVED_BY - 1]),
              approvedAt: String(r[EXP_COL.APPROVED_AT - 1]),
              notes: String(r[EXP_COL.NOTES - 1])
            });
          }
          if (body.costGroup) expenses = expenses.filter(function(ex) { return ex.costGroup === body.costGroup; });
          if (body.status) expenses = expenses.filter(function(ex) { return ex.status === body.status; });

          // Compute summary
          var summary = { total: 0, byGroup: {}, byYear: {}, byStatus: {} };
          expenses.forEach(function(ex) {
            summary.total += ex.amount;
            summary.byGroup[ex.costGroup] = (summary.byGroup[ex.costGroup] || 0) + ex.amount;
            summary.byYear[ex.year] = (summary.byYear[ex.year] || 0) + ex.amount;
            summary.byStatus[ex.status] = (summary.byStatus[ex.status] || 0) + ex.amount;
          });

          var result = { success: true, expenses: expenses, summary: summary };
          try { var rj = JSON.stringify(result); if (rj.length < 95000) sc.put(cacheKey, rj, 3600); } catch (_) {}
          return result;
        } catch (err) {
          logError('getExpenses', err, body);
          return { success: false, error: 'getExpenses failed: ' + err.message };
        }
      }

      /**
       * Approve or reject an expense request.
       * Only financial control / admin / CKK can approve.
       */
      function approveExpense(body) {
        try {
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin && auth.role !== ROLE_FINANCIAL && auth.role !== ROLE_CKK)
            return { success: false, error: 'Нямате право да одобрявате разходи.' };
          var expenseId = String(body.expenseId || '').trim();
          var decision = String(body.decision || '').trim(); // 'approved' | 'rejected'
          if (!expenseId) return { success: false, error: 'Липсва expenseId.' };
          if (!['approved', 'rejected'].includes(decision))
            return { success: false, error: 'Решението трябва да е approved или rejected.' };

          var expSheet = getExpensesSheet();
          var data = expSheet.getDataRange().getValues();
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][EXP_COL.ID - 1]).trim() !== expenseId) continue;
            var now = new Date().toISOString();
            // Batch all status/audit fields into one row write
            var updatedExpRow = data[i].slice();
            updatedExpRow[EXP_COL.STATUS - 1]      = decision;
            updatedExpRow[EXP_COL.APPROVED_BY - 1] = auth.userId || '';
            updatedExpRow[EXP_COL.APPROVED_AT - 1] = now;
            if (body.notes) updatedExpRow[EXP_COL.NOTES - 1] = body.notes;
            expSheet.getRange(i + 1, 1, 1, EXP_TOTAL_COLS).setValues([updatedExpRow]);

            // Update budget execution on approval
            if (decision === 'approved') {
              var projId = String(data[i][EXP_COL.PROJECT_ID - 1]).trim();
              var costGrp = String(data[i][EXP_COL.COST_GROUP - 1]).trim();
              var amount = parseFloat(data[i][EXP_COL.AMOUNT - 1]) || 0;
              var yr = String(data[i][EXP_COL.YEAR - 1]).trim();
              updateBudgetExecution_(projId, costGrp, yr, amount);
            }

            logTransaction('APPROVE_EXPENSE', auth.userId, expenseId, { decision: decision });
            return { success: true };
          }
          return { success: false, error: 'Разходът не е намерен.' };
        } catch (err) {
          logError('approveExpense', err, body);
          return { success: false, error: 'approveExpense failed: ' + err.message };
        }
      }

      /** Helper: update project budget execution after expense approval */
      function updateBudgetExecution_(projectId, costGroup, year, amount) {
        try {
          var projSheet = getProjectsSheet();
          var data = projSheet.getDataRange().getValues();
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][PROJ_COL.ID - 1]).trim() !== projectId) continue;
            var exec = {};
            try { exec = JSON.parse(String(data[i][PROJ_COL.BUDGET_EXECUTION - 1] || '{}')); } catch (_) {}
            if (!exec[costGroup]) exec[costGroup] = {};
            var oldVal = parseFloat(exec[costGroup][year] || 0) || 0;
            var newVal = oldVal + amount;
            exec[costGroup][year] = newVal;
            projSheet.getRange(i + 1, PROJ_COL.BUDGET_EXECUTION).setValue(JSON.stringify(exec));
            // Financial audit — every budget mutation gets logged with old/new values.
            try {
              logTransaction('UPDATE_BUDGET_EXEC', 'project', projectId, {
                costGroup: costGroup, year: year, delta: amount, oldValue: oldVal, newValue: newVal
              });
            } catch (_) {}
            return;
          }
        } catch (err) {
          console.warn('Budget execution update failed: ' + err.message);
        }
      }

      /**
       * Get financial summary for a project — budget vs. actuals.
       */
      function getFinancialSummary(body) {
        try {
          var auth = resolveAuthContext(body);
          var projectId = String(body.projectId || '').trim();
          if (!projectId) return { success: false, error: 'Липсва projectId.' };

          var projSheet = getProjectsSheet();
          var projData = projSheet.getDataRange().getValues();
          var budget = {}; var budgetExec = {};
          for (var i = 1; i < projData.length; i++) {
            if (String(projData[i][PROJ_COL.ID - 1]).trim() !== projectId) continue;
            try { budget = JSON.parse(String(projData[i][PROJ_COL.BUDGET - 1] || '{}')); } catch (_) {}
            try { budgetExec = JSON.parse(String(projData[i][PROJ_COL.BUDGET_EXECUTION - 1] || '{}')); } catch (_) {}
            break;
          }

          // Get approved expenses
          var expRes = getExpenses({ projectId: projectId, status: 'approved', userId: auth.userId });
          var expenses = expRes.success ? expRes.expenses : [];

          // Calculate remaining by cost group
          var remaining = {};
          VALID_COST_GROUPS.forEach(function(grp) {
            var allocated = parseFloat(budget[grp] || 0) || 0;
            var spent = 0;
            Object.keys(budgetExec[grp] || {}).forEach(function(yr) {
              spent += parseFloat(budgetExec[grp][yr] || 0) || 0;
            });
            remaining[grp] = { allocated: allocated, spent: spent, remaining: allocated - spent };
          });

          return {
            success: true,
            budget: budget,
            budgetExecution: budgetExec,
            expenses: expenses,
            remaining: remaining,
            totalAllocated: Object.keys(remaining).reduce(function(s, k) { return s + remaining[k].allocated; }, 0),
            totalSpent: Object.keys(remaining).reduce(function(s, k) { return s + remaining[k].spent; }, 0)
          };
        } catch (err) {
          logError('getFinancialSummary', err, body);
          return { success: false, error: 'getFinancialSummary failed: ' + err.message };
        }
      }

      // ============================================================
      //  DELIVERABLES MANAGEMENT  — Publications, TRL, indicators
      // ============================================================

      /**
       * Add a deliverable to a project.
       */
      function addDeliverable(body) {
        try {
          var auth = resolveAuthContext(body);
          var projectId = String(body.projectId || '').trim();
          if (!projectId) return { success: false, error: 'Липсва projectId.' };
          var dtype = String(body.type || '').trim();
          if (!VALID_DELIVERABLE_TYPES.includes(dtype))
            return { success: false, error: 'Невалиден тип резултат. Допустими: ' + VALID_DELIVERABLE_TYPES.join(', ') };

          // Verify user belongs to project
          var projSheet = getProjectsSheet();
          var projData = projSheet.getDataRange().getValues();
          var found = false;
          for (var i = 1; i < projData.length; i++) {
            if (String(projData[i][PROJ_COL.ID - 1]).trim() === projectId) {
              found = true;
              var leader = String(projData[i][PROJ_COL.LEADER_EMAIL - 1]).toLowerCase();
              if (!auth.isAdmin && leader !== (auth.userId || '').toLowerCase()) {
                var tm = [];
                try { tm = JSON.parse(String(projData[i][PROJ_COL.TEAM_MEMBERS - 1] || '[]')); } catch (_) {}
                var isMem = tm.some(function(m) { return String(m.email || '').toLowerCase() === (auth.userId || '').toLowerCase(); });
                if (!isMem) return { success: false, error: 'Нямате достъп до този проект.' };
              }
              break;
            }
          }
          if (!found) return { success: false, error: 'Проектът не е намерен.' };

          var delSheet = getDeliverablesSheet();
          var id = 'DEL-' + Utilities.getUuid().replace(/-/g, '').substring(0, 12).toUpperCase();
          var now = new Date().toISOString();
          var delRow = new Array(DEL_TOTAL_COLS).fill('');
          delRow[DEL_COL.ID - 1] = id;
          delRow[DEL_COL.PROJECT_ID - 1] = projectId;
          delRow[DEL_COL.TYPE - 1] = dtype;
          delRow[DEL_COL.TITLE - 1] = String(body.title || '');
          delRow[DEL_COL.DESCRIPTION - 1] = String(body.description || '');
          delRow[DEL_COL.STATUS - 1] = body.status || 'planned';
          delRow[DEL_COL.DUE_DATE - 1] = String(body.dueDate || '');
          delRow[DEL_COL.COMPLETED_DATE - 1] = String(body.completedDate || '');
          delRow[DEL_COL.EVIDENCE_FILE_ID - 1] = String(body.evidenceFileId || '');
          delRow[DEL_COL.URL - 1] = String(body.url || '');
          delRow[DEL_COL.METADATA - 1] = typeof body.metadata === 'object' ? JSON.stringify(body.metadata) : String(body.metadata || '');
          delRow[DEL_COL.CREATED_BY - 1] = auth.userId || '';
          delRow[DEL_COL.CREATED_AT - 1] = now;
          delSheet.appendRow(delRow);

          logTransaction('ADD_DELIVERABLE', auth.userId, id, { projectId: projectId, type: dtype });
          return { success: true, deliverableId: id };
        } catch (err) {
          logError('addDeliverable', err, body);
          return { success: false, error: 'addDeliverable failed: ' + err.message };
        }
      }

      /**
       * Get deliverables for a project.
       */
      function getDeliverables(body) {
        try {
          var auth = resolveAuthContext(body);
          var projectId = String(body.projectId || '').trim();
          // Version-keyed CacheService cache (30s TTL)
          var sc = _scriptCache_();
          var dv = getDataVersions_();
          var cacheKey = 'gDel:' + projectId + ':' + (body.type || '') + ':' + dv.projects;
          if (!body.forceRefresh) {
            try { var cv = sc.get(cacheKey); if (cv) return JSON.parse(cv); } catch (_) {}
          }
          var delSheet = getDeliverablesSheet();
          var data = delSheet.getDataRange().getValues();
          var deliverables = [];
          for (var i = 1; i < data.length; i++) {
            var r = data[i];
            if (!String(r[DEL_COL.ID - 1]).trim()) continue;
            if (projectId && String(r[DEL_COL.PROJECT_ID - 1]).trim() !== projectId) continue;
            deliverables.push({
              id: String(r[DEL_COL.ID - 1]),
              projectId: String(r[DEL_COL.PROJECT_ID - 1]),
              type: String(r[DEL_COL.TYPE - 1]),
              title: String(r[DEL_COL.TITLE - 1]),
              description: String(r[DEL_COL.DESCRIPTION - 1]),
              status: String(r[DEL_COL.STATUS - 1]),
              dueDate: String(r[DEL_COL.DUE_DATE - 1]),
              completedDate: String(r[DEL_COL.COMPLETED_DATE - 1]),
              evidenceFileId: String(r[DEL_COL.EVIDENCE_FILE_ID - 1]),
              url: String(r[DEL_COL.URL - 1]),
              createdBy: String(r[DEL_COL.CREATED_BY - 1]),
              createdAt: String(r[DEL_COL.CREATED_AT - 1])
            });
          }
          if (body.type) deliverables = deliverables.filter(function(d) { return d.type === body.type; });

          // Summary by type
          var byType = {};
          deliverables.forEach(function(d) {
            if (!byType[d.type]) byType[d.type] = { total: 0, completed: 0 };
            byType[d.type].total++;
            if (d.status === 'completed') byType[d.type].completed++;
          });

          var result = { success: true, deliverables: deliverables, summary: byType };
          try { var rj = JSON.stringify(result); if (rj.length < 95000) sc.put(cacheKey, rj, 3600); } catch (_) {}
          return result;
        } catch (err) {
          logError('getDeliverables', err, body);
          return { success: false, error: 'getDeliverables failed: ' + err.message };
        }
      }

      /**
       * Update a deliverable (mark completed, add evidence, etc.)
       */
      function updateDeliverable(body) {
        try {
          var auth = resolveAuthContext(body);
          var deliverableId = String(body.deliverableId || '').trim();
          if (!deliverableId) return { success: false, error: 'Липсва deliverableId.' };
          var delSheet = getDeliverablesSheet();
          var data = delSheet.getDataRange().getValues();
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][DEL_COL.ID - 1]).trim() !== deliverableId) continue;
            // Batch all field updates into a single row write
            var updatedDelRow = data[i].slice();
            if (body.status)        updatedDelRow[DEL_COL.STATUS - 1]         = body.status;
            if (body.completedDate) updatedDelRow[DEL_COL.COMPLETED_DATE - 1] = body.completedDate;
            if (body.evidenceFileId)updatedDelRow[DEL_COL.EVIDENCE_FILE_ID - 1]= body.evidenceFileId;
            if (body.url)           updatedDelRow[DEL_COL.URL - 1]            = body.url;
            if (body.title)         updatedDelRow[DEL_COL.TITLE - 1]          = body.title;
            if (body.description)   updatedDelRow[DEL_COL.DESCRIPTION - 1]    = body.description;
            delSheet.getRange(i + 1, 1, 1, DEL_TOTAL_COLS).setValues([updatedDelRow]);
            logTransaction('UPDATE_DELIVERABLE', auth.userId, deliverableId, { status: body.status || 'updated' });
            return { success: true };
          }
          return { success: false, error: 'Резултатът не е намерен.' };
        } catch (err) {
          logError('updateDeliverable', err, body);
          return { success: false, error: 'updateDeliverable failed: ' + err.message };
        }
      }

      // ============================================================
      //  PROJECT LIFECYCLE TRANSITIONS
      //  State machine: active → in_execution → semiannual_reporting →
      //    annual_reporting → interim_review → final_reporting →
      //    final_review → closed | closed_with_sanction
      // ============================================================

      var VALID_PROJECT_STATUSES = [
        'active', 'in_execution',
        'semiannual_reporting', 'annual_reporting', 'interim_review',
        'final_reporting', 'final_review',
        'accepted_closed', 'partially_completed_closed', 'closed_with_sanction', 'suspended', 'terminated',
        'report_overdue'
      ];

      var PROJECT_TRANSITIONS = {
        active:               ['in_execution', 'suspended', 'terminated'],
        in_execution:         ['semiannual_reporting', 'annual_reporting', 'interim_review', 'final_reporting', 'suspended', 'terminated'],
        semiannual_reporting: ['in_execution', 'report_overdue'],
        annual_reporting:     ['in_execution', 'report_overdue'],
        interim_review:       ['in_execution', 'report_overdue'],
        final_reporting:      ['final_review', 'report_overdue'],
        final_review:         ['accepted_closed', 'partially_completed_closed', 'closed_with_sanction'],
        suspended:            ['in_execution', 'terminated'],
        accepted_closed:      [],
        partially_completed_closed: [],
        closed_with_sanction: [],
        terminated:           [],
        // report_overdue is a recoverable state set by the scheduled job;
        // submitting the missing report returns the project to in_execution
        // (or whichever reporting cycle was due). Escalation paths remain.
        report_overdue:       ['in_execution', 'semiannual_reporting', 'annual_reporting', 'interim_review', 'final_reporting', 'closed_with_sanction', 'terminated']
      };

      /**
       * Transition a project to a new status.
       * Enforces state machine rules.
       */
      function transitionProjectStatus(body) {
        try {
          var auth = resolveAuthContext(body);
          var isPrivileged = auth.isAdmin || auth.role === ROLE_CKK || auth.role === ROLE_NIDD;
          if (!isPrivileged) return { success: false, error: 'Нямате право да променяте статуса на проект.' };
          var projectId = String(body.projectId || '').trim();
          var newStatus = String(body.newStatus || '').trim();
          if (!projectId) return { success: false, error: 'Липсва projectId.' };
          if (!VALID_PROJECT_STATUSES.includes(newStatus))
            return { success: false, error: 'Невалиден статус: ' + newStatus };

          var projSheet = getProjectsSheet();
          var lastRow   = projSheet.getLastRow();
          if (lastRow < 2) return { success: false, error: 'Проектът не е намерен.' };

          // PERFORMANCE: slim ID-only scan instead of full-sheet read. The
          // projects sheet has BUDGET, BUDGET_EXECUTION, ACTIVITIES,
          // INDICATORS, PUBLICATIONS — all JSON blobs that can each be tens
          // of KB per row. Pulling the whole sheet to flip one status flag
          // wastes Apps Script execution time on every transition.
          var n = lastRow - 1;
          var idCol = projSheet.getRange(2, PROJ_COL.ID, n, 1).getValues();
          var rIdx = -1;
          for (var i = 0; i < n; i++) {
            if (String(idCol[i][0]).trim() === projectId) { rIdx = i + 2; break; }
          }
          if (rIdx === -1) return { success: false, error: 'Проектът не е намерен.' };

          // Read only the columns we actually need to validate + decide
          // (STATUS for transition guard; LEADER_*/TITLE/DIRECTION/PROJECT_CODE
          // for the conditional auto-sanction branch). One single-row read.
          var rowSlim = projSheet.getRange(rIdx, 1, 1, PROJ_TOTAL_COLS).getValues()[0];
          var currentStatus = String(rowSlim[PROJ_COL.STATUS - 1]).trim();
          var allowed = PROJECT_TRANSITIONS[currentStatus] || [];
          if (!allowed.includes(newStatus)) {
            return { success: false, error: 'Преходът ' + currentStatus + ' → ' + newStatus + ' не е допустим.' };
          }

          // Single-cell write — never touches the JSON blob columns.
          projSheet.getRange(rIdx, PROJ_COL.STATUS).setValue(newStatus);

          // If closed with sanction, auto-create sanction record
          if (newStatus === 'closed_with_sanction') {
            try {
              addSanction({
                userEmail   : String(rowSlim[PROJ_COL.LEADER_EMAIL - 1]).trim(),
                userName    : String(rowSlim[PROJ_COL.LEADER_NAME  - 1]).trim(),
                projectId   : projectId,
                projectTitle: String(rowSlim[PROJ_COL.TITLE        - 1]),
                direction   : String(rowSlim[PROJ_COL.DIRECTION    - 1]),
                projectCode : String(rowSlim[PROJ_COL.PROJECT_CODE - 1]),
                sanctionType: 'unsatisfactory_execution',
                notes       : 'Автоматична санкция при незадоволително изпълнение.',
                userId      : auth.userId
              });
            } catch (se) { console.warn('Auto-sanction failed: ' + se.message); }
          }

          // Invalidate downstream caches that key off projects data version
          try { touchDataVersion_('projects'); } catch (_) {}
          try { auditAppendChainRow_('project_status_transition', auth.userId,
                { id: projectId, from: currentStatus, to: newStatus }); } catch (_) {}
          logTransaction('TRANSITION_PROJECT', auth.userId, projectId, { from: currentStatus, to: newStatus });
          return { success: true, previousStatus: currentStatus, newStatus: newStatus };
        } catch (err) {
          logError('transitionProjectStatus', err, body);
          return { success: false, error: 'transitionProjectStatus failed: ' + err.message };
        }
      }

      // ============================================================
      //  REPORT DEADLINE RULES — Automated deadline checking
      //  Per regulation: semiannual by 10th of month after period,
      //  annual by Dec 10, interim by Dec 10 for multi-year projects.
      // ============================================================

      /**
       * Get overdue & upcoming report deadlines across all active projects.
       * Returns structured data for the admin dashboard.
       */
      function getReportDeadlines(body) {
        try {
          var auth = resolveAuthContext(body);
          // Cache for 60s — report deadlines change slowly
          var sc = _scriptCache_();
          var dv = getDataVersions_();
          var cacheKey = 'gRptDL:' + dv.projects;
          if (!body.forceRefresh) {
            try { var cv = sc.get(cacheKey); if (cv) return JSON.parse(cv); } catch (_) {}
          }
          var projSheet = getProjectsSheet();
          var projData = projSheet.getDataRange().getValues();
          var rptSheet = getReportsSheet();
          var rptData = rptSheet.getDataRange().getValues();

          // Index submitted reports by projectId → reportType
          var submittedReports = {};
          for (var r = 1; r < rptData.length; r++) {
            var rRow = rptData[r];
            var rProjId = String(rRow[RPT_COL.PROJECT_ID - 1]).trim();
            var rType = String(rRow[RPT_COL.REPORT_TYPE - 1]).trim();
            var rPeriod = String(rRow[RPT_COL.PERIOD - 1]).trim();
            if (!submittedReports[rProjId]) submittedReports[rProjId] = {};
            if (!submittedReports[rProjId][rType]) submittedReports[rProjId][rType] = [];
            submittedReports[rProjId][rType].push({ period: rPeriod, status: String(rRow[RPT_COL.STATUS - 1]).trim() });
          }

          var now = new Date();
          var currentYear = now.getFullYear();
          var currentMonth = now.getMonth() + 1;
          var deadlines = [];

          for (var p = 1; p < projData.length; p++) {
            var pRow = projData[p];
            var pId = String(pRow[PROJ_COL.ID - 1]).trim();
            if (!pId) continue;
            var pStatus = String(pRow[PROJ_COL.STATUS - 1]).trim();
            if (!['active', 'in_execution'].includes(pStatus)) continue;

            var startDate = new Date(String(pRow[PROJ_COL.START_DATE - 1]));
            var endDateStr = String(pRow[PROJ_COL.END_DATE - 1]).trim();
            var isMultiYear = endDateStr && (new Date(endDateStr).getFullYear() > startDate.getFullYear());
            var pReports = submittedReports[pId] || {};
            var pTitle = String(pRow[PROJ_COL.TITLE - 1]).trim();
            var pLeader = String(pRow[PROJ_COL.LEADER_EMAIL - 1]).trim();

            // Semiannual: H1 due Jul 10, H2 due Jan 10
            var semiH1Due = new Date(currentYear, 6, 10); // Jul 10
            var semiH2Due = new Date(currentYear, 0, 10); // Jan 10
            var semiReports = pReports.semiannual || [];

            if (currentMonth >= 7 && currentMonth <= 12) {
              var h1Submitted = semiReports.some(function(sr) { return sr.period && sr.period.includes('H1') && sr.period.includes(String(currentYear)); });
              if (!h1Submitted) {
                deadlines.push({ projectId: pId, projectTitle: pTitle, leaderEmail: pLeader, type: 'semiannual', period: currentYear + '-H1', dueDate: semiH1Due.toISOString().substring(0, 10), overdue: now > semiH1Due });
              }
            }

            // Annual: due Dec 10
            var annualDue = new Date(currentYear, 11, 10);
            var annualReports = pReports.annual || [];
            var annualSubmitted = annualReports.some(function(ar) { return ar.period && ar.period.includes(String(currentYear)); });
            if (!annualSubmitted && currentMonth >= 10) {
              deadlines.push({ projectId: pId, projectTitle: pTitle, leaderEmail: pLeader, type: 'annual', period: String(currentYear), dueDate: annualDue.toISOString().substring(0, 10), overdue: now > annualDue });
            }

            // Interim: for multi-year projects, due Dec 10
            if (isMultiYear) {
              var interimReports = pReports.interim || [];
              var interimSubmitted = interimReports.some(function(ir) { return ir.period && ir.period.includes(String(currentYear)); });
              if (!interimSubmitted && currentMonth >= 10) {
                deadlines.push({ projectId: pId, projectTitle: pTitle, leaderEmail: pLeader, type: 'interim', period: String(currentYear), dueDate: annualDue.toISOString().substring(0, 10), overdue: now > annualDue });
              }
            }
          }

          deadlines.sort(function(a, b) {
            if (a.overdue && !b.overdue) return -1;
            if (!a.overdue && b.overdue) return 1;
            return a.dueDate < b.dueDate ? -1 : 1;
          });

          var result = { success: true, deadlines: deadlines, overdueCount: deadlines.filter(function(d) { return d.overdue; }).length };
          try { var rj = JSON.stringify(result); if (rj.length < 95000) sc.put(cacheKey, rj, 3600); } catch (_) {}
          return result;
        } catch (err) {
          logError('getReportDeadlines', err, body);
          return { success: false, error: 'getReportDeadlines failed: ' + err.message };
        }
      }
      //  Per regulation: final reports reviewed within 10 days by
      //  habilitated reviewer from IU-Varna, chosen by CKK.
      // ============================================================

      /**
       * Assign a final report reviewer.
       */
      function assignFinalReportReviewer(body) {
        try {
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin && auth.role !== ROLE_CKK)
            return { success: false, error: 'Само ЦКК може да назначи рецензент за окончателен отчет.' };
          var reportId = String(body.reportId || '').trim();
          var reviewerId = String(body.reviewerId || body.reviewerEmail || '').trim();
          if (!reportId || !reviewerId) return { success: false, error: 'Липсва reportId или reviewerId.' };

          var rptSheet = getReportsSheet();
          var data = rptSheet.getDataRange().getValues();
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][RPT_COL.ID - 1]).trim() !== reportId) continue;
            if (String(data[i][RPT_COL.REPORT_TYPE - 1]).trim() !== 'final')
              return { success: false, error: 'Само окончателни отчети подлежат на рецензиране.' };
            var hist = [];
            try { hist = JSON.parse(String(data[i][RPT_COL.HISTORY - 1] || '[]')); } catch (_) {}
            hist.push({ status: 'under_review', ts: new Date().toISOString(), by: auth.userId, reviewer: reviewerId });
            // Batch: 3 cell writes → 1 setValues round-trip.
            var _row = data[i].slice();
            _row[RPT_COL.REVIEWER_ID - 1] = reviewerId;
            _row[RPT_COL.STATUS      - 1] = 'under_review';
            _row[RPT_COL.HISTORY     - 1] = JSON.stringify(hist);
            rptSheet.getRange(i + 1, 1, 1, RPT_TOTAL_COLS).setValues([_row]);
            logTransaction('ASSIGN_FINAL_REVIEWER', auth.userId, reportId, { reviewerId: reviewerId });
            return { success: true };
          }
          return { success: false, error: 'Отчетът не е намерен.' };
        } catch (err) {
          logError('assignFinalReportReviewer', err, body);
          return { success: false, error: 'assignFinalReportReviewer failed: ' + err.message };
        }
      }

      /**
       * Submit final report review with evaluation.
       * Result: 'satisfactory', 'partially_satisfactory', 'unsatisfactory'
       */
      function submitFinalReportReview(body) {
        try {
          var auth = resolveAuthContext(body);
          var reportId = String(body.reportId || '').trim();
          var evaluation = String(body.evaluation || '').trim();
          var validEvals = ['satisfactory', 'partially_satisfactory', 'unsatisfactory'];
          if (!reportId) return { success: false, error: 'Липсва reportId.' };
          if (!validEvals.includes(evaluation))
            return { success: false, error: 'Невалидна оценка. Допустими: ' + validEvals.join(', ') };

          var rptSheet = getReportsSheet();
          var data = rptSheet.getDataRange().getValues();
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][RPT_COL.ID - 1]).trim() !== reportId) continue;
            var now = new Date().toISOString();
            var hist = [];
            try { hist = JSON.parse(String(data[i][RPT_COL.HISTORY - 1] || '[]')); } catch (_) {}
            hist.push({ status: 'reviewed', ts: now, by: auth.userId, evaluation: evaluation });
            // Batch: 4–5 cell writes → 1 setValues round-trip.
            var _row = data[i].slice();
            _row[RPT_COL.STATUS         - 1] = 'reviewed';
            _row[RPT_COL.REVIEWER_SCORE - 1] = evaluation;
            _row[RPT_COL.REVIEWED_AT    - 1] = now;
            if (body.comment) _row[RPT_COL.RETURN_COMMENT - 1] = body.comment;
            _row[RPT_COL.HISTORY        - 1] = JSON.stringify(hist);
            rptSheet.getRange(i + 1, 1, 1, RPT_TOTAL_COLS).setValues([_row]);
            logTransaction('SUBMIT_FINAL_REVIEW', auth.userId, reportId, { evaluation: evaluation });
            return { success: true };
          }
          return { success: false, error: 'Отчетът не е намерен.' };
        } catch (err) {
          logError('submitFinalReportReview', err, body);
          return { success: false, error: 'submitFinalReportReview failed: ' + err.message };
        }
      }

      /**
       * CKK accepts final report after review.
       * If unsatisfactory, triggers sanction automatically.
       */
      function acceptFinalReport(body) {
        try {
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin && auth.role !== ROLE_CKK)
            return { success: false, error: 'Само ЦКК може да приема окончателни отчети.' };
          var reportId = String(body.reportId || '').trim();
          var decision = String(body.decision || '').trim(); // 'accepted' | 'partially_completed' | 'unsatisfactory'
          if (!reportId) return { success: false, error: 'Липсва reportId.' };
          // BPMN Process 10 step 58 — 3-way decision: успешно / частично / незадоволително
          if (!['accepted', 'partially_completed', 'unsatisfactory'].includes(decision))
            return { success: false, error: 'Решението трябва да е accepted, partially_completed или unsatisfactory.' };

          var rptSheet = getReportsSheet();
          var rptData = rptSheet.getDataRange().getValues();
          for (var i = 1; i < rptData.length; i++) {
            if (String(rptData[i][RPT_COL.ID - 1]).trim() !== reportId) continue;
            var now = new Date().toISOString();
            var hist = [];
            try { hist = JSON.parse(String(rptData[i][RPT_COL.HISTORY - 1] || '[]')); } catch (_) {}
            hist.push({ status: decision, ts: now, by: auth.userId });
            // Batch: 3 cell writes → 1 setValues round-trip.
            var _row = rptData[i].slice();
            _row[RPT_COL.STATUS      - 1] = decision;
            _row[RPT_COL.ACCEPTED_AT - 1] = now;
            _row[RPT_COL.HISTORY     - 1] = JSON.stringify(hist);
            rptSheet.getRange(i + 1, 1, 1, RPT_TOTAL_COLS).setValues([_row]);

            // If unsatisfactory → close project with sanction AND record
            // a 3-year sanction in Sanctions sheet (UC-40). Without the
            // Sanctions row, checkEligibility/checkSanctions would not see
            // the ban during the next session and the leader could re-apply.
            var projId = String(rptData[i][RPT_COL.PROJECT_ID - 1]).trim();
            if (decision === 'unsatisfactory' && projId) {
              try {
                transitionProjectStatus({ projectId: projId, newStatus: 'closed_with_sanction', userId: auth.userId });
              } catch (se) {
                console.warn('Auto-sanction transition failed: ' + se.message);
              }
              try {
                var pSheetS = getProjectsSheet();
                var pDataS  = pSheetS.getDataRange().getValues();
                for (var ps = 1; ps < pDataS.length; ps++) {
                  if (String(pDataS[ps][PROJ_COL.ID - 1]).trim() !== projId) continue;
                  addSanction({
                    userEmail   : String(pDataS[ps][PROJ_COL.LEADER_EMAIL - 1] || '').trim(),
                    userName    : String(pDataS[ps][PROJ_COL.LEADER_NAME  - 1] || '').trim(),
                    projectId   : projId,
                    projectTitle: String(pDataS[ps][PROJ_COL.TITLE - 1] || '').trim(),
                    direction   : String(pDataS[ps][PROJ_COL.DIRECTION - 1] || '').trim(),
                    projectCode : String(pDataS[ps][PROJ_COL.PROJECT_CODE - 1] || '').trim(),
                    sanctionType: 'unsatisfactory_execution',
                    notes       : 'Автоматично наложена санкция след окончателна оценка „незадоволително изпълнение" (3 г. в същото направление). Отчет: ' + reportId,
                    userId      : auth.userId
                  });
                }
              } catch (sanErr) {
                console.warn('Auto-sanction insert failed: ' + sanErr.message);
              }
            } else if (decision === 'accepted' && projId) {
              try {
                transitionProjectStatus({ projectId: projId, newStatus: 'accepted_closed', userId: auth.userId });
              } catch (_) {}
            } else if (decision === 'partially_completed' && projId) {
              // BPMN Process 10 step 58 → "Partially Completed" (no sanction,
              // but project closes with the partial-completion marker so MES
              // statistics and future-eligibility checks can distinguish it).
              try {
                transitionProjectStatus({ projectId: projId, newStatus: 'partially_completed_closed', userId: auth.userId });
              } catch (_) {}
            }

            logTransaction('ACCEPT_FINAL_REPORT', auth.userId, reportId, { decision: decision, projectId: projId });
            return { success: true };
          }
          return { success: false, error: 'Отчетът не е намерен.' };
        } catch (err) {
          logError('acceptFinalReport', err, body);
          return { success: false, error: 'acceptFinalReport failed: ' + err.message };
        }
      }

      // ============================================================
      //  MON REPORTS — Ministry of Education statistics
      // ============================================================

      /**
       * Generate comprehensive statistics report for MON.
       */
      function generateMONReport(body) {
        try {
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin && auth.role !== ROLE_RECTOR && auth.role !== ROLE_VICE_RECTOR && auth.role !== ROLE_NIDD)
            return { success: false, error: 'Нямате право да генерирате отчети за МОН.' };

          var year = String(body.year || new Date().getFullYear());
          var projSheet = getProjectsSheet();
          var projData = projSheet.getDataRange().getValues();
          var rptSheet = getReportsSheet();
          var rptData = rptSheet.getDataRange().getValues();
          var expSheet = getExpensesSheet();
          var expData = expSheet.getDataRange().getValues();
          var delSheet = getDeliverablesSheet();
          var delData = delSheet.getDataRange().getValues();
          var compSheet = getCompetitionsSheet();
          var compData = compSheet.getDataRange().getValues();

          // Competition stats
          var competitionStats = { total: 0, byType: {}, byYear: {} };
          for (var ci = 1; ci < compData.length; ci++) {
            var cYear = String(compData[ci][COMP_COL.YEAR - 1]).trim();
            if (year && cYear !== year) continue;
            competitionStats.total++;
            var cType = String(compData[ci][COMP_COL.CALL_TYPE - 1]).trim() || 'general';
            competitionStats.byType[cType] = (competitionStats.byType[cType] || 0) + 1;
          }

          // Project stats
          var projectStats = { total: 0, active: 0, closed: 0, withSanction: 0, byDirection: {}, byCode: {} };
          var projectIds = {};
          for (var pi = 1; pi < projData.length; pi++) {
            // Skip orphan/mock rows so МОН snapshot never lists projects that
            // are no longer in the system or were created for testing.
            if (_isOrphanProjectRow_(projData[pi])) continue;
            var pYear = String(projData[pi][PROJ_COL.YEAR - 1]).trim();
            if (year && pYear !== year) continue;
            var pId = String(projData[pi][PROJ_COL.ID - 1]).trim();
            if (!pId) continue;
            projectIds[pId] = true;
            projectStats.total++;
            var pSt = String(projData[pi][PROJ_COL.STATUS - 1]).trim();
            if (['active', 'in_execution'].includes(pSt)) projectStats.active++;
            else if (pSt === 'accepted_closed') projectStats.closed++;
            else if (pSt === 'closed_with_sanction') projectStats.withSanction++;
            var dir = String(projData[pi][PROJ_COL.DIRECTION - 1]).trim() || 'Без направление';
            projectStats.byDirection[dir] = (projectStats.byDirection[dir] || 0) + 1;
            var code = String(projData[pi][PROJ_COL.PROJECT_CODE - 1]).trim() || 'Без код';
            projectStats.byCode[code] = (projectStats.byCode[code] || 0) + 1;
          }

          // Financial stats
          var financialStats = { totalSpent: 0, byGroup: {}, byProject: {} };
          for (var ei = 1; ei < expData.length; ei++) {
            var eProjId = String(expData[ei][EXP_COL.PROJECT_ID - 1]).trim();
            if (!projectIds[eProjId]) continue;
            if (String(expData[ei][EXP_COL.STATUS - 1]).trim() !== 'approved') continue;
            var eAmt = parseFloat(expData[ei][EXP_COL.AMOUNT - 1]) || 0;
            var eGrp = String(expData[ei][EXP_COL.COST_GROUP - 1]).trim() || 'other';
            financialStats.totalSpent += eAmt;
            financialStats.byGroup[eGrp] = (financialStats.byGroup[eGrp] || 0) + eAmt;
            financialStats.byProject[eProjId] = (financialStats.byProject[eProjId] || 0) + eAmt;
          }

          // Deliverables / results stats
          var resultStats = { total: 0, publications: 0, monographs: 0, trlProducts: 0, conferences: 0, patents: 0, byType: {} };
          for (var di = 1; di < delData.length; di++) {
            var dProjId = String(delData[di][DEL_COL.PROJECT_ID - 1]).trim();
            if (!projectIds[dProjId]) continue;
            resultStats.total++;
            var dType = String(delData[di][DEL_COL.TYPE - 1]).trim();
            resultStats.byType[dType] = (resultStats.byType[dType] || 0) + 1;
            if (dType.startsWith('publication_')) resultStats.publications++;
            if (dType === 'monograph') resultStats.monographs++;
            if (dType === 'trl_product') resultStats.trlProducts++;
            if (dType === 'conference') resultStats.conferences++;
            if (dType === 'patent') resultStats.patents++;
          }

          // Report stats
          var reportStats = { submitted: 0, accepted: 0, returned: 0, byType: {} };
          for (var ri = 1; ri < rptData.length; ri++) {
            var rProjId = String(rptData[ri][RPT_COL.PROJECT_ID - 1]).trim();
            if (!projectIds[rProjId]) continue;
            reportStats.submitted++;
            var rSt = String(rptData[ri][RPT_COL.STATUS - 1]).trim();
            if (rSt === 'accepted') reportStats.accepted++;
            if (rSt === 'returned') reportStats.returned++;
            var rType = String(rptData[ri][RPT_COL.REPORT_TYPE - 1]).trim();
            if (!reportStats.byType[rType]) reportStats.byType[rType] = { submitted: 0, accepted: 0 };
            reportStats.byType[rType].submitted++;
            if (rSt === 'accepted') reportStats.byType[rType].accepted++;
          }

          return {
            success: true,
            year: year,
            generatedAt: new Date().toISOString(),
            generatedBy: auth.userId,
            competitions: competitionStats,
            projects: projectStats,
            financials: financialStats,
            results: resultStats,
            reports: reportStats,
            // Full institutional 8-section snapshot per chl. 92, al. 3 ZVO
            // (legally compliant self-audit, financial + non-financial).
            institutional: _monAggregateInstitutional_({
              year: year,
              periodStart: body.periodStart || '',
              periodEnd: body.periodEnd || '',
              reportType: body.reportType || ''
            })
          };
        } catch (err) {
          logError('generateMONReport', err, body);
          return { success: false, error: 'generateMONReport failed: ' + err.message };
        }
      }

      // ============================================================
      //  PROJECT RESULTS VALIDATION  — Per regulation per project type
      //  fundamental: monograph OR min 3 Scopus/WoS articles
      //  applied: TRL 4+ product
      //  international: submitted proposal evidence
      // ============================================================

      /**
       * Validate project results meet minimum requirements per type.
       */
      function validateProjectResults(body) {
        try {
          var auth = resolveAuthContext(body);
          var projectId = String(body.projectId || '').trim();
          if (!projectId) return { success: false, error: 'Липсва projectId.' };

          var projSheet = getProjectsSheet();
          var projData = projSheet.getDataRange().getValues();
          var projRow = null;
          for (var i = 1; i < projData.length; i++) {
            if (String(projData[i][PROJ_COL.ID - 1]).trim() === projectId) { projRow = projData[i]; break; }
          }
          if (!projRow) return { success: false, error: 'Проектът не е намерен.' };

          var projectCode = String(projRow[PROJ_COL.PROJECT_CODE - 1]).trim();
          var delRes = getDeliverables({ projectId: projectId, userId: auth.userId });
          var deliverables = delRes.success ? delRes.deliverables : [];
          var completedDels = deliverables.filter(function(d) { return d.status === 'completed'; });

          var issues = [];
          var requirements = [];

          if (projectCode === 'ФНИ' || projectCode === 'fundamental') {
            requirements.push('Монография ИЛИ минимум 3 статии в Scopus/WoS');
            var hasMonograph = completedDels.some(function(d) { return d.type === 'monograph'; });
            var scopusWos = completedDels.filter(function(d) { return d.type === 'publication_scopus' || d.type === 'publication_wos'; });
            if (!hasMonograph && scopusWos.length < 3) {
              issues.push({ code: 'INSUFFICIENT_PUBLICATIONS', message: 'Необходима е монография или минимум 3 статии в Scopus/WoS. Налични: ' + scopusWos.length + ' статии.' });
            }
          }

          if (projectCode === 'ПНИ' || projectCode === 'applied') {
            requirements.push('Научен продукт с TRL минимум 4');
            var trlProducts = completedDels.filter(function(d) { return d.type === 'trl_product'; });
            var hasTrl4 = trlProducts.some(function(d) {
              try { var meta = JSON.parse(d.metadata || '{}'); return (parseInt(meta.trl || 0) >= 4); } catch (_) { return false; }
            });
            if (!hasTrl4) {
              issues.push({ code: 'INSUFFICIENT_TRL', message: 'Необходим е научен продукт с TRL ≥ 4.' });
            }
          }

          if (projectCode === 'МП' || projectCode === 'international_prep') {
            requirements.push('Доказано подадено международно проектно предложение');
            var intProposals = completedDels.filter(function(d) { return d.type === 'international_proposal'; });
            if (intProposals.length === 0) {
              issues.push({ code: 'NO_INTERNATIONAL_PROPOSAL', message: 'Необходимо е доказване на подадено международно проектно предложение.' });
            }
          }

          return {
            success: true,
            projectId: projectId,
            projectCode: projectCode,
            requirements: requirements,
            valid: issues.length === 0,
            issues: issues,
            deliverables: { total: deliverables.length, completed: completedDels.length }
          };
        } catch (err) {
          logError('validateProjectResults', err, body);
          return { success: false, error: 'validateProjectResults failed: ' + err.message };
        }
      }

      // ============================================================
      //  NOTIFICATION AUTOMATIONS — Deadline reminders, overdue alerts
      // ============================================================

      /**
       * Send deadline reminder notifications.
       * Called via time-based trigger (daily) or manually by admin.
       *
       * Body params (all optional):
       *   horizonDays  : Number   (default 7)   – send if daysUntil ≤ horizonDays OR overdue
       *   projectIds   : String[] (optional)    – restrict to selected projects
       *   types        : String[] (optional)    – restrict by report type (semiannual/annual/interim/final)
       *   customNote   : String   (optional)    – appended to the email footer
       *   dryRun       : Boolean  (default false) – returns recipient list without sending
       */
      function sendDeadlineReminders(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin) return { success: false, error: 'Нямате право.' };

          var horizonDays = Math.max(1, Math.min(365, Number(body.horizonDays) || 7));
          var projectFilter = Array.isArray(body.projectIds) && body.projectIds.length
            ? body.projectIds.reduce(function(m, id){ m[String(id)] = true; return m; }, {})
            : null;
          var typeFilter = Array.isArray(body.types) && body.types.length
            ? body.types.reduce(function(m, t){ m[String(t).toLowerCase()] = true; return m; }, {})
            : null;
          var customNote = String(body.customNote || '').trim().slice(0, 1500);
          var dryRun = body.dryRun === true || body.dryRun === 'true';

          var deadlinesRes = getReportDeadlines({ userId: auth.userId, forceRefresh: true });
          if (!deadlinesRes.success) return deadlinesRes;

          var deadlines = deadlinesRes.deadlines || [];
          var now = new Date();
          var typeLabels = { semiannual: 'Шестмесечен', annual: 'Годишен', interim: 'Междинен', final: 'Окончателен' };
          var recipients = [];

          deadlines.forEach(function(dl) {
            var dueDate = new Date(dl.dueDate);
            var daysUntil = Math.ceil((dueDate - now) / (24 * 60 * 60 * 1000));
            if (!(daysUntil <= horizonDays || dl.overdue)) return;
            if (projectFilter && !projectFilter[String(dl.projectId)]) return;
            if (typeFilter && !typeFilter[String(dl.type).toLowerCase()]) return;
            recipients.push({
              projectId: dl.projectId,
              projectTitle: dl.projectTitle || dl.projectId,
              leaderEmail: dl.leaderEmail || '',
              type: dl.type,
              typeLabel: typeLabels[dl.type] || dl.type,
              period: dl.period,
              dueDate: dl.dueDate,
              overdue: !!dl.overdue,
              daysUntil: daysUntil
            });
          });

          if (dryRun) {
            return { success: true, dryRun: true, recipients: recipients, totalDeadlines: deadlines.length };
          }

          var sent = 0, failed = 0, skipped = 0;
          recipients.forEach(function(rcp) {
            if (!rcp.leaderEmail) { skipped++; return; }
            var heading = rcp.overdue ? '⚠️ Просрочен отчет' : '📅 Наближава краен срок за отчет';
            var lines = [
              { label: 'Проект:',     value: rcp.projectTitle },
              { label: 'Вид отчет:',  value: rcp.typeLabel },
              { label: 'Период:',     value: rcp.period },
              { label: 'Краен срок:', value: rcp.dueDate },
              { label: 'Статус:',     value: rcp.overdue ? 'ПРОСРОЧЕН' : 'Остават ' + rcp.daysUntil + ' дни' }
            ];
            var baseFooter = rcp.overdue
              ? 'Отчетът е просрочен. Моля, подайте го възможно най-скоро за да избегнете допълнителни последствия.'
              : 'Моля, подайте отчета преди изтичане на крайния срок.';
            var footer = customNote
              ? (baseFooter + '\n\nДопълнителен коментар от администратор:\n' + customNote)
              : baseFooter;
            try {
              notifyApplicant_(rcp.leaderEmail, heading + ' – ' + rcp.projectTitle, buildNotificationHtml_(heading, lines, footer), rcp.overdue ? 'report_overdue' : 'report_due');
              sent++;
            } catch (_) { failed++; }
          });

          return {
            success: true,
            sent: sent,
            failed: failed,
            skipped: skipped,
            totalDeadlines: deadlines.length,
            totalCandidates: recipients.length,
            horizonDays: horizonDays
          };
        } catch (err) {
          logError('sendDeadlineReminders', err, body);
          return { success: false, error: 'sendDeadlineReminders failed: ' + err.message };
        }
      }

      // ═══════════════════════════════════════════════════════════════════
      //  v6.9.0 — DEADLINE AUTOMATION (Cron-like scheduled tasks)
      //  These functions are designed to be called from a GAS time-based
      //  trigger (hourly/daily), or manually by an admin.
