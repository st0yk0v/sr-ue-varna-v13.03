          var baseName = src.getName();
          var copyName = baseName;
          var _b = baseName.replace(/(\.[^.]+)$/, '');
          var _e = baseName.match(/(\.[^.]+)$/);
          var _ext = _e ? _e[0] : '';
          var ex = userFolder.getFilesByName(copyName);
          if (ex.hasNext()) {
            var i = 1;
            do { copyName = _b + ' (копие ' + (++i) + ')' + _ext; } while (userFolder.getFilesByName(copyName).hasNext() && i < 50);
          }
          var copy = src.makeCopy(copyName, userFolder);
          var copyId = copy.getId();
          try { shareGeneratedFile_(copy); } catch (_) {}
          try { _addEditorSilently_(copy, auth.userId || ''); } catch (_) {}
          var mt = copy.getMimeType();
          var links = buildSecureFileLinks_(copyId, { allowDownload: true, mimeType: mt });
          var editLink = (mt === 'application/vnd.google-apps.document')
            ? 'https://docs.google.com/document/d/' + copyId + '/edit'
            : (mt === 'application/vnd.google-apps.spreadsheet'
              ? 'https://docs.google.com/spreadsheets/d/' + copyId + '/edit'
              : 'https://drive.google.com/file/d/' + copyId + '/view');
          return {
            success: true,
            file: {
              id: copyId, driveId: copyId, name: copy.getName(), mimeType: mt,
