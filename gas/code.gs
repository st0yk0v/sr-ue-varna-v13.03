                    _typeDupId = String(_tr[COL.ID - 1] || '');
                    break;
                  }
                }
              } catch (_) { /* best-effort; skip block on error */ }
            }
            if (_typeDupFound) {
              return {
                success: false,
                error: 'Вече имате активно проектно предложение от тип „' + _newProjType + '". Един потребител може да кандидатства с не повече от едно предложение от същия тип. Прегледайте или оттеглете съществуващото преди да подадете ново.',
                existingFormId: _typeDupId,
                errorCode: 'DUPLICATE_PROJECT_TYPE'
              };
            }
          }

          if (!canSelectCompetition_(competitionId, authCtx, true)) {
            // Drafts must not be blocked by competition lifecycle (e.g. competition
            // is currently in "draft" / "configured" state, or its public window
            // hasn't opened yet). Applicants frequently need to save work-in-
            // progress for upcoming sessions. Only enforce the eligibility gate
            // when the user is actually submitting (status='submitted').
            if (!isDraft) {
              var comp = getCompetitionById_(competitionId, true);
              var debugInfo = comp
                ? 'status=' + comp.status + ', deadline=' + comp.deadline
                : 'NOT_FOUND (competitionId=' + competitionId + ')';
              return { success: false, error: 'Избраният конкурс не е достъпен за кандидатстване. [' + debugInfo + ']' };
            }
          }

          // ── Budget validation (source: 01 Бюджет/ docs, May 2026) ──
          var projectType = String(f.projectType || f.type || f.projectCode || '').trim().toUpperCase();
          if (projectType && !isDraft) {
            // v9.37.0-regulatory: Comprehensive submission validation
            var _valErr = _validateSubmission_(f, projectType, competitionId);
            if (_valErr) return { success: false, error: _valErr };

            // Compute total budget EUR from the nested {group: {year: amount}} structure
            var budgetRaw = f.budget;
            var budgetEUR = _computeBudgetTotalEUR_(budgetRaw);
            if (budgetEUR > 0) {
              var budgetCheck = _validateBudgetForType_(projectType, budgetEUR);
              if (!budgetCheck.ok) {
                return { success: false, error: budgetCheck.error };
              }
              // v9.37.0-regulatory: Extract budget rows from actual budget structure
              // Budget is stored as { categoryKey: { year: amount } } or { categoryKey: amount }
              var budgetRows = [];
              if (typeof budgetRaw === 'object' && budgetRaw !== null) {
                Object.keys(budgetRaw).forEach(function(catKey) {
                  if (catKey === '_monthlyMode' || catKey === '_monthly' || catKey === '_npfTier') return;
                  var catVal = budgetRaw[catKey];
                  if (typeof catVal === 'object' && catVal !== null && !Array.isArray(catVal)) {
                    // { year: amount } format — sum all years
                    var catSum = 0;
                    Object.keys(catVal).forEach(function(yr) { catSum += Number(catVal[yr]) || 0; });
                    if (catSum > 0) budgetRows.push({ categoryId: catKey, amount: catSum });
                  } else if (typeof catVal === 'number' && catVal > 0) {
                    budgetRows.push({ categoryId: catKey, amount: catVal });
                  }
                });
              }
              if (budgetRows.length > 0) {
                var hasDoctoralYoung = _teamHasDoctoralOrYoung_(f.teamMembers);
                var catCheck = _validateBudgetCategories_(projectType, budgetRows, {
                  totalBudget: budgetEUR,
                  hasDoctoralYoung: hasDoctoralYoung
                });
                if (!catCheck.ok) {
                  return { success: false, error: catCheck.errors.map(function(e) { return e.message; }).join('; ') };
                }
              }
            }
          }

          // Resolve the competition Drive folder so application files are stored there.
          // compObj is reused at the end to retrieve the competition name — avoiding a
          // duplicate getCompetitionById_ call that previously added ~50–150 ms.
          var competitionFolderId = '';
          var compObj = null;
          try {
            compObj = getCompetitionById_(competitionId, true);
            if (compObj && compObj.folderId) competitionFolderId = compObj.folderId;
          } catch (_) {}

          // ── Determine Drive operation requirements BEFORE creating any folder ──
          // This lets us skip the 3–4-round-trip getOrCreateAppFolder call for
          // draft saves that have no uploaded files and no hand-drawn signature.
          var hasFileUploads = f.files && Array.isArray(f.files) && f.files.length > 0;
          var signatureType = String(f.signatureType || '').toLowerCase();
          var hasAttachedSig = signatureType === 'attached' && f.attachedFileId;
          var hasDrawSig = !!f.signature;

          // PERF: Only create the Drive app-folder when we actually need it.
          // Drafts with no uploads and no drawn-signature skip 3–4 Drive round-trips,
          // saving ~1.5–3 s on auto-draft creation and incremental draft saves.
          var appFolder = null;
          if (hasFileUploads || hasDrawSig) {
            appFolder = getOrCreateAppFolder(id, competitionFolderId);
          }

          var fileIds = [];
          if (hasFileUploads) {
            fileIds = saveFilesToDrive(f.files, id, f.userId || f.email || '');
          }

          var applicantSignatureValue = '';
          var historyItems = [{
            action: isDraft ? 'Създадено като чернова' : 'Създадено и изпратено',
            date  : now,
            user  : actor
          }];

          if (!isDraft && !hasAttachedSig && !hasDrawSig) {
            return { success: false, error: 'Изпращането на заявление изисква подпис (екранен или прикачен документ).' };
          }

          if (hasAttachedSig) {
            applicantSignatureValue = ATTACHED_DOC_MARKER_PREFIX + JSON.stringify({
              fileId: String(f.attachedFileId || ''),
              fileName: String(f.attachedFileName || 'Подписан документ'),
              attachedAt: now,
              attachedBy: actor
            });
            historyItems.push({
              action: 'Заявление с прикачен подписан документ',
              date: now, user: actor, fileId: String(f.attachedFileId || '')
            });
          } else if (hasDrawSig) {
            applicantSignatureValue = f.signature;
            saveSignatureToDrive(appFolder, f.signature, 'Подпис – Кандидат (' + actor + ')');
            historyItems.push({
              action: 'Ръчен подпис на заявление',
              date: now, user: actor
            });
          }

          var attachedDocs = Array.isArray(f.attachedDocs) ? f.attachedDocs : [];
          // PERF: Skip Drive folder sync for drafts — copying attached docs is archival-only
          // and is not needed until final submission. Each doc copy = 3 Drive API calls,
          // so skipping for drafts saves N × 3 round-trips (~0.5–1 s per doc).
          if (!isDraft && attachedDocs.length > 0) {
            if (!appFolder) appFolder = getOrCreateAppFolder(id, competitionFolderId);
            attachedDocs.forEach(function(d) {
              copyDocToAppFolder(appFolder, d.id, d.name || 'Документ');
            });
          }

          var row = new Array(TOTAL_COLS).fill('');
          row[COL.ID - 1]              = id;
          row[COL.USER_EMAIL - 1]      = String(uId).toLowerCase().trim();
          row[COL.USER_NAME - 1]       = f.userName      || '';
          row[COL.COMPETITION - 1]     = competitionId;
          row[COL.PROJECT_CODE - 1]    = f.projectCode   || '';
          row[COL.TITLE - 1]           = (f.title        || '').trim();
          row[COL.AREA - 1]            = f.area          || '';
          row[COL.DESCRIPTION - 1]     = (f.description  || '').trim();
          row[COL.STATUS - 1]          = status;
          row[COL.SUBMITTED - 1]       = isDraft ? '' : now;
          row[COL.RETURN_COMMENT - 1]  = '';
          row[COL.FILE_IDS - 1]        = JSON.stringify(fileIds);
          row[COL.ATTACHED_DOCS - 1]   = JSON.stringify(attachedDocs);
          row[COL.HISTORY - 1]         = JSON.stringify(historyItems);
          row[COL.CREATED - 1]         = now;
          row[COL.SIGNATURE - 1]       = applicantSignatureValue;
          row[COL.SIGNATURE_ADMIN - 1] = '';
          row[COL.TEAM_MEMBERS - 1]    = JSON.stringify(Array.isArray(f.teamMembers) ? f.teamMembers : []);
          // ── UC-06 / UC-07 persistence: budget + objectives at proposal stage ──
          if (typeof COL.BUDGET === 'number') {
            var _budgetObj = (f.budget != null) ? (typeof f.budget === 'string' ? safeParseJSON(f.budget,{}) : f.budget) : {};
            // v9.37.0-regulatory: persist НПФ tier inside budget metadata
            if (String(f.projectCode||'').toUpperCase()==='НПФ' && f.npfTier) {
              _budgetObj._npfTier = String(f.npfTier);
            }
            row[COL.BUDGET - 1] = JSON.stringify(_budgetObj);
          }
          if (typeof COL.DURATION_MONTHS === 'number' && f.durationMonths != null) {
            row[COL.DURATION_MONTHS - 1] = Number(f.durationMonths) || '';
          }
          if (typeof COL.OBJECTIVES === 'number' && f.objectives != null) {
            row[COL.OBJECTIVES - 1] = String(f.objectives || '').trim();
          }
          if (typeof COL.EXPECTED_RESULTS === 'number' && f.expectedResults != null) {
            row[COL.EXPECTED_RESULTS - 1] = String(f.expectedResults || '').trim();
          }
          // v4.3.1 — new form fields
          if (typeof COL.PROFESSIONAL_FIELD === 'number' && f.professionalField != null) {
            row[COL.PROFESSIONAL_FIELD - 1] = String(f.professionalField || '').trim();
          }
          if (typeof COL.TITLE_EN === 'number' && f.titleEn != null) {
            row[COL.TITLE_EN - 1] = String(f.titleEn || '').trim();
          }
          if (typeof COL.ACRONYM === 'number' && f.acronym != null) {
            row[COL.ACRONYM - 1] = String(f.acronym || '').trim().toUpperCase();
          }
          // v4.4.0 — English short description
          if (typeof COL.DESCRIPTION_EN === 'number' && f.descriptionEn != null) {
            row[COL.DESCRIPTION_EN - 1] = String(f.descriptionEn || '').trim();
          }
          // v9.46.0-rules — self-assessment score
          if (typeof COL.SELF_ASSESSMENT_SCORE === 'number') {
            row[COL.SELF_ASSESSMENT_SCORE - 1] = Number(f.selfAssessmentScore) || 0;
          }

          ensureSheetWidth_(sheet, TOTAL_COLS);

          // committed tracks whether the row was written to the sheet.
          // Once true, post-commit failures must NOT return success:false —
          // the data is already persisted and the user should see success.
          var committed = false;
          sheet.appendRow(row);
          committed = true;

          // ── Post-commit housekeeping (failures here must not overwrite success) ──
          try { applyRowColor(sheet, sheet.getLastRow(), status); } catch (_) {}

          // Invalidate per-user sheet cache so a subsequent getForms call
          // in the SAME execution sees the new draft (RACE-005 fix).
          if (isDraft) {
            try {
              var _cacheKey = 'fm:u:' + String(uId).toLowerCase().trim();
              if (_sheetReadCache_[_cacheKey]) delete _sheetReadCache_[_cacheKey];
              if (_sheetReadCache_['fm:a']) delete _sheetReadCache_['fm:a'];
            } catch (_) {}
          }

          // Release the dedup lock now that the row is committed (RACE-003 fix).
          try { if (typeof _draftLock !== 'undefined' && _draftLock) _draftLock.releaseLock(); } catch (_) {}

          // Notify applicant if submitted (not draft) — queued so the user-facing
          // request returns without waiting on MailApp (1–3s sync send).
          var emailSent = false;
          if (!isDraft) {
            try {
              emailSent = _queueDeferredEmail_({
                kind: 'submission',
                email: String(uId).toLowerCase().trim(),
                userName: actor,
                formId: id,
                title: (f.title || '').trim(),
                competitionId: competitionId
              });
            } catch (mailErr) {
              console.error('createForm email queue failed: ' + mailErr.message);
              try { logError('createForm_notify', mailErr, { email: String(uId).toLowerCase().trim(), formId: id }); } catch (_) {}
            }
            // v9.46.0-rules: Save reviewer proposals (§11) to ExternalReviewerProposals sheet
            // For ФНИ/ПНИ projects only. Best-effort — failures must not block form commit.
            try {
              var _pt2 = String(f.projectCode || f.projectType || '').toUpperCase();
              if ((_pt2 === 'ФНИ' || _pt2 === 'ПНИ') && Array.isArray(f.reviewerProposal) && f.reviewerProposal.length > 0) {
                var _rps = f.reviewerProposal.filter(function(r) { return String(r.name || '').trim() && String(r.email || '').trim(); });
                if (_rps.length > 0) {
                  proposeExternalReviewers({
                    proposalId: id,
                    candidateEmail: String(uId).toLowerCase().trim(),
                    reviewers: _rps.map(function(r) {
                      return {
                        reviewerName: String(r.name || '').trim(),
                        reviewerEmail: String(r.email || '').trim(),
                        affiliation: String(r.org || '').trim(),
                        phone: String(r.phone || '').trim(),
                        motivation: r.consent ? 'Дал предварително съгласие' : ''
                      };
                    })
                  });
                }
              }
            } catch (_) { /* reviewer proposal save is non-blocking */ }
          }

          var compNameResult = (compObj && compObj.name) ? compObj.name : '';

          return {
            success : true,
            id      : id,
            message : isDraft ? 'Черновата е запазена успешно' : 'Заявлението е изпратено успешно',
            competitionName: compNameResult || competitionId,
            emailSent: emailSent
          };
        } catch (err) {
          // Release dedup lock on any error path so we don't strand
          // future draft creations behind a held lock (v9.40.1).
          try { if (typeof _draftLock !== 'undefined' && _draftLock) _draftLock.releaseLock(); } catch (_) {}
          // If the row was already appended, post-commit housekeeping threw —
          // the submission is saved; return success so the UI is not misled.
          if (committed) {
            try { logError('createForm_post_commit', err, { formId: id }); } catch (_) {}
            return {
              success : true,
              id      : id,
              message : isDraft ? 'Черновата е запазена успешно' : 'Заявлението е изпратено успешно',
              competitionName: (compObj && compObj.name) ? compObj.name : (competitionId || ''),
              emailSent: false
            };
          }
          return { success: false, error: 'createForm failed: ' + err.message };
        }
      }

      function updateForm(body) {
        try {
          body = body || {};
          var sheet = getSheet();
          var found = findRowByID(sheet, body.id);
          if (!found) return { success: false, error: 'Form not found: ' + body.id };

          var rowIndex = found.rowIndex;
          var rowData  = found.rowData;
          var u        = body.updates || {};
          var now      = nowISO();
          var actor    = u.userName || extractUserId(body) || 'Unknown';

          // ── Auth context (resolve EARLY so subsequent checks can use it) ──
          var authCtx = resolveAuthContext({
            userId: extractUserId(body) || String(rowData[COL.USER_EMAIL - 1] || ''),
            isAdmin: body ? body.isAdmin : false,
            username: body ? body.username : '',
            password: body ? body.password : ''
          });

          // v9.39.6-no-edit-admin: ADMINS ARE VIEW-ONLY — no form-field or
          // document mutations via updateForm. Status transitions go through
          // the dedicated updateStatus endpoint.
          // NOTE (frontend contract): because of this guard, owner-document
          // mutation flows (attach/copy → updateForm) MUST send isAdmin:false
          // even when the signed-in user is an admin — otherwise the whole
          // save chain fails here after the Drive copy already succeeded.
          if (authCtx.isAdmin) {
            return { success: false, error: 'Администраторите нямат право да редактират заявления. Използвайте „Промяна на статус" за административни действия.' };
          }

          // v9.37.0-regulatory: HARDEN — block status changes via updateForm.
          // Status transitions MUST go through dedicated endpoints (submitForm,
          // returnForCorrection, etc.) that enforce validation gates.
          if (u.status !== undefined) {
            return { success: false, error: 'Статусът не може да се променя през updateForm. Използвайте специализирания endpoint.' };
          }
          var ownerEmail = String(rowData[COL.USER_EMAIL - 1] || '').toLowerCase().trim();
          var currentStatus = String(rowData[COL.STATUS - 1] || '').toLowerCase();
          if (!authCtx.isAdmin && authCtx.userId && ownerEmail && authCtx.userId !== ownerEmail) {
            return { success: false, error: 'Нямате права да редактирате това заявление.' };
          }
          // ── PERF FAST-PATH: when the update is docs-only (no budget, no title, etc.),
          //    skip the expensive row-copy + validation chain. Just diff-attach and return.
          //    Computed BEFORE the status gate below: a docs-only update only supplements
          //    the proposal's attached documents (library / Drive files) and does NOT alter
          //    any proposal field or status, so the owner may do it at ANY status
          //    (incl. already-submitted proposals) — see v12.31.3-attachrestore.
          var isDocsOnlyUpdate = (u.attachedDocs != null) &&
            (u.competitionId == null && u.title == null && u.description == null &&
             u.area == null && u.projectCode == null && u.teamMembers == null &&
             u.budget == null && u.durationMonths == null && u.objectives == null &&
             u.expectedResults == null && u.professionalField == null &&
             u.titleEn == null && u.acronym == null && u.descriptionEn == null &&
             u.newFiles == null);

          // Non-admin users can only edit (full-form) drafts, returned, or needs_correction forms.
          // BUT a docs-only attachment supplement (library / Drive file) is allowed for the
          // owner at ANY status — it never changes proposal fields or status, only adds refs.
          // v12.31.3-attachrestore: gate relaxed for isDocsOnlyUpdate so the creator can
          // attach official library / Drive documents to already-created proposals.
          if (!authCtx.isAdmin && !isDocsOnlyUpdate && currentStatus !== 'draft' && currentStatus !== 'returned' && currentStatus !== 'needs_correction') {
            return { success: false, error: 'Заявлението не може да се редактира в текущия статус (' + currentStatus + '). Само чернови и върнати за корекция заявления могат да се редактират.' };
          }

          if (isDocsOnlyUpdate) {
            // ── v12.30.1-perf: Check if doc IDs actually changed before resolving ──
            // Use the already-parsed existing attachedDocs if we have them, otherwise
            // read from the row. Comparing sorted ID strings is O(N log N) and avoids
            // all Drive API calls when the doc list is unchanged (common on debounced autosave).
            var fastExisting = safeParseJSON(rowData[COL.ATTACHED_DOCS - 1], []);
            var fastIncomingIds = (u.attachedDocs || []).map(function(d){ return String(d.id||''); }).sort().join('|');
            var fastExistingIds = fastExisting.map(function(d){ return String(d.id||''); }).sort().join('|');
            if (fastIncomingIds === fastExistingIds && u.attachedDocs.length === fastExisting.length) {
              // IDs unchanged — just merge metadata, skip ALL Drive API calls
              var fastMerged = u.attachedDocs.map(function(ud) {
                var od = fastExisting.filter(function(x){ return x.id === ud.id; })[0] || {};
                return Object.assign({}, od, ud);
              });
              sheet.getRange(rowIndex, COL.ATTACHED_DOCS, 1, 1).setValue(JSON.stringify(fastMerged));
              return { success: true, message: 'Документите са обновени (metadata)', fastPath: true, cached: true };
            }
            // ── Resolve library-doc IDs to app-folder copies (v9.41.1-owncopy) ──
            // Use per-execution cached version to avoid redundant Drive API calls
            // within the same GAS execution (e.g. updateForm → submitForm chain).
            var fastDocs = _cachedResolveAttachedDocs_(body.id, u.attachedDocs, ownerEmail);
            var fastHistory = safeParseJSON(rowData[COL.HISTORY - 1], []);
            var fastAdded = fastDocs.filter(function(d) { return !fastExisting.some(function(o) { return o.id === d.id; }); });
            var fastRemoved = fastExisting.filter(function(d) { return !fastDocs.some(function(n) { return n.id === d.id; }); });
            if (fastAdded.length === 0 && fastRemoved.length === 0) {
              return { success: true, message: 'Няма промени в документите', unchanged: true };
            }
            fastAdded.forEach(function(d) { fastHistory.push({ action: 'Прикачен официален документ: ' + (d.name || 'Документ'), date: now, user: actor }); });
            fastRemoved.forEach(function(d) { fastHistory.push({ action: 'Премахнат официален документ: ' + (d.name || 'Документ'), date: now, user: actor }); });
            fastHistory.push({ action: 'Редактирано (документи)', date: now, user: actor });
            // Direct column writes — avoid full row copy + setValues call
            sheet.getRange(rowIndex, COL.ATTACHED_DOCS, 1, 1).setValue(JSON.stringify(fastDocs));
            sheet.getRange(rowIndex, COL.HISTORY, 1, 1).setValue(JSON.stringify(fastHistory));
            try { logTransaction('EDIT_FORM', actor || extractUserId(body) || 'applicant', body.id, { docsChanged: true, fastPath: true }); } catch (_) {}
            return { success: true, message: 'Документите са обновени', fastPath: true };
          }

          var fileIds      = safeParseJSON(rowData[COL.FILE_IDS - 1],      []);
          var attachedDocs = safeParseJSON(rowData[COL.ATTACHED_DOCS - 1], []);
          var history      = safeParseJSON(rowData[COL.HISTORY - 1],       []);
          var newRow       = rowData.slice();

          while (newRow.length < TOTAL_COLS) newRow.push('');

          if (u.competitionId != null) {
            var nextCompetitionId = String(u.competitionId || '').trim();
            if (!nextCompetitionId) return { success: false, error: 'Missing competitionId' };
            if (!canSelectCompetition_(nextCompetitionId, authCtx, true)) {
              var comp = getCompetitionById_(nextCompetitionId, true);
              var dbg = comp ? 'status=' + comp.status : 'NOT_FOUND';
              return { success: false, error: 'Избраният конкурс не е достъпен за кандидатстване. [' + dbg + ', id=' + nextCompetitionId + ']' };
            }
            newRow[COL.COMPETITION - 1] = nextCompetitionId;
          }
          if (u.title        != null) newRow[COL.TITLE - 1]        = String(u.title).trim();
          if (u.description  != null) newRow[COL.DESCRIPTION - 1]  = String(u.description).trim();
          if (u.area         != null) newRow[COL.AREA - 1]         = u.area;
          if (u.projectCode  != null) newRow[COL.PROJECT_CODE - 1] = String(u.projectCode).trim();
          if (u.teamMembers  != null && Array.isArray(u.teamMembers)) newRow[COL.TEAM_MEMBERS - 1] = JSON.stringify(u.teamMembers);
          // ── UC-06 persistence: budget + objectives editable until submission ──
          if (u.budget != null && typeof COL.BUDGET === 'number') {
            var _budgetUpd = typeof u.budget === 'string' ? safeParseJSON(u.budget,{}) : u.budget;
            // v9.37.0-regulatory: persist НПФ tier inside budget metadata
            if (u.npfTier) { _budgetUpd._npfTier = String(u.npfTier); }
            var budgetStr = JSON.stringify(_budgetUpd);
            // Validate budget before persisting — reject obviously malformed data
            try {
              var budgetParsed = JSON.parse(budgetStr);
              if (budgetParsed && typeof budgetParsed === 'object' && !Array.isArray(budgetParsed)) {
                var budgetEUR = _computeBudgetTotalEUR_(budgetParsed);
                var projectCode = String(u.projectCode || newRow[COL.PROJECT_CODE - 1] || '').trim().toUpperCase();
                if (projectCode && budgetEUR > 0) {
                  var budgetCheck = _validateBudgetForType_(projectCode, budgetEUR);
                  if (!budgetCheck.ok) {
                    return { success: false, error: budgetCheck.error };
                  }
                }
              }
            } catch (_) { /* parse failed — store as-is, backend will reject on submit */ }
            newRow[COL.BUDGET - 1] = budgetStr;
          }
          if (u.durationMonths != null && typeof COL.DURATION_MONTHS === 'number') {
            newRow[COL.DURATION_MONTHS - 1] = Number(u.durationMonths) || '';
          }
          if (u.objectives != null && typeof COL.OBJECTIVES === 'number') {
            newRow[COL.OBJECTIVES - 1] = String(u.objectives || '').trim();
          }
          if (u.expectedResults != null && typeof COL.EXPECTED_RESULTS === 'number') {
            newRow[COL.EXPECTED_RESULTS - 1] = String(u.expectedResults || '').trim();
          }
          // v4.3.1 — new form fields
          if (u.professionalField != null && typeof COL.PROFESSIONAL_FIELD === 'number') {
            newRow[COL.PROFESSIONAL_FIELD - 1] = String(u.professionalField || '').trim();
          }
          if (u.titleEn != null && typeof COL.TITLE_EN === 'number') {
            newRow[COL.TITLE_EN - 1] = String(u.titleEn || '').trim();
          }
          if (u.acronym != null && typeof COL.ACRONYM === 'number') {
            newRow[COL.ACRONYM - 1] = String(u.acronym || '').trim().toUpperCase();
          }
          // v4.4.0 — English short description
          if (u.descriptionEn != null && typeof COL.DESCRIPTION_EN === 'number') {
            newRow[COL.DESCRIPTION_EN - 1] = String(u.descriptionEn || '').trim();
          }
          // v9.46.0-rules — self-assessment score
          if (u.selfAssessmentScore != null && typeof COL.SELF_ASSESSMENT_SCORE === 'number') {
            newRow[COL.SELF_ASSESSMENT_SCORE - 1] = Number(u.selfAssessmentScore) || 0;
          }

          var appFolder   = null;
          var filesAdded  = false;
          var docsChanged = false;

          if (u.newFiles && Array.isArray(u.newFiles) && u.newFiles.length > 0) {
            var uploaded = saveFilesToDrive(u.newFiles, body.id, ownerEmail);
            uploaded.forEach(function(uf) {
              history.push({ action: 'Качен файл: ' + uf.name, date: now, user: actor });
            });
            fileIds  = fileIds.concat(uploaded);
            newRow[COL.FILE_IDS - 1] = JSON.stringify(fileIds);
            filesAdded = true;
          }

          if (u.attachedDocs != null && Array.isArray(u.attachedDocs)) {
            // ── Resolve library-doc IDs to app-folder copies (v9.41.1-owncopy) ──
            // v9.43.0-docdetect: fast-path — when doc IDs are unchanged (typical on
            // debounced autosave), skip ALL Drive API calls and just merge incoming
            // metadata (docType, _generated, etc.) over the existing stored entries.
            var _inIds = u.attachedDocs.map(function(d){return String(d.id||'');}).sort().join('|');
            var _exIds = attachedDocs.map(function(d){return String(d.id||'');}).sort().join('|');
            var newDocs;
            if (_inIds === _exIds && u.attachedDocs.length === attachedDocs.length) {
              newDocs = u.attachedDocs.map(function(ud) {
                var od = attachedDocs.filter(function(x){ return x.id === ud.id; })[0] || {};
                return Object.assign({}, od, ud);
              });
            } else {
              // v12.30.1-perf: Use cached resolver to avoid redundant Drive API calls
              newDocs = _cachedResolveAttachedDocs_(body.id, u.attachedDocs, ownerEmail);
            }
            var added    = newDocs.filter(function(d) { return !attachedDocs.some(function(o) { return o.id === d.id; }); });
            var removed  = attachedDocs.filter(function(d) { return !newDocs.some(function(n) { return n.id === d.id; }); });
            added.forEach(function(d)   { history.push({ action: 'Прикачен официален документ: ' + d.name,  date: now, user: actor }); });
            removed.forEach(function(d) { history.push({ action: 'Премахнат официален документ: ' + d.name, date: now, user: actor }); });

            if (added.length || removed.length) {
              docsChanged = true;
              // v9.39.6-no-edit-admin: always copy attached templates to the app
              // folder so the applicant gets immediately-editable copies instead
              // of referencing the read-only originals in OFFICIAL_DOCS_FOLDER_ID.
              // copyDocToAppFolder is idempotent (skips if name exists).
              try {
                if (!appFolder) appFolder = getOrCreateAppFolder(body.id);
                syncAttachedDocsInFolder(appFolder, newDocs, attachedDocs);
              } catch (_) {}
            }

            attachedDocs = newDocs;
            newRow[COL.ATTACHED_DOCS - 1] = JSON.stringify(newDocs);
          }

          // Always record the edit event itself — file/doc entries are supplementary.
          // Previously this was gated on (!filesAdded && !docsChanged), which meant
          // a user who edited fields AND uploaded a file saw only "Качен файл" with
          // no "Редактирано" entry — the edit itself was invisible in the diary.
          history.push({ action: 'Редактирано', date: now, user: actor });

          newRow[COL.HISTORY - 1] = JSON.stringify(history);
          safeSetRow_(sheet, rowIndex, newRow, TOTAL_COLS);

          applyRowColor(sheet, rowIndex, newRow[COL.STATUS - 1]);

          try { logTransaction('EDIT_FORM', actor || extractUserId(body) || 'applicant', body.id, { filesAdded: filesAdded, docsChanged: docsChanged }); } catch (_) {}

          return { success: true, message: 'Заявлението е обновено успешно' };
        } catch (err) {
          return { success: false, error: 'updateForm failed: ' + err.message };
        }
      }

      // ============================================================
      //  ADMIN EDIT FORM — tracks admin edits in applicant history
      //  v12.15.0-adminhistory: Allows authorised admins to edit
      //  applicant form fields with FULL audit trail. Every edit is
      //  recorded in COL.HISTORY with the admin's identity, and the
      //  applicant receives an in-app notification about the change.
      //  Restricted to non-sensitive fields (no status transitions,
      //  no project code changes, no email swaps).
      // ============================================================
      function adminEditForm(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin) {
            return { success: false, error: 'Отказан достъп: Само администратори.' };
          }
          var sheet = getSheet();
          var found = findRowByID(sheet, body.id);
          if (!found) return { success: false, error: 'Заявлението не е намерено: ' + body.id };

          var rowIndex = found.rowIndex;
          var rowData  = found.rowData;
          var u        = body.updates || {};
          var now      = nowISO();
          var actor    = body.userName || auth.userId || 'Администратор';

          // Only allow editing specific non-sensitive fields
          var ALLOWED_ADMIN_FIELDS = [
            'title', 'description', 'area', 'objectives', 'expectedResults',
            'professionalField', 'titleEn', 'acronym', 'descriptionEn',
            'durationMonths', 'budget', 'teamMembers', 'attachedDocs'
          ];
          for (var _k in u) {
            if (u.hasOwnProperty && !u.hasOwnProperty(_k)) continue;
            if (_k === 'status' || _k === 'userEmail' || _k === 'userName' ||
                _k === 'projectCode' || _k === 'competitionId' || _k === 'id') {
              return { success: false, error: 'Полето "' + _k + '" не може да бъде променяно от администратор.' };
            }
          }

          var history = safeParseJSON(rowData[COL.HISTORY - 1], []);
          var newRow  = rowData.slice();
          while (newRow.length < TOTAL_COLS) newRow.push('');

          var changedFields = [];

          if (u.title != null) {
            newRow[COL.TITLE - 1] = String(u.title).trim();
            changedFields.push('заглавие');
          }
          if (u.description != null) {
            newRow[COL.DESCRIPTION - 1] = String(u.description).trim();
            changedFields.push('описание');
          }
          if (u.area != null) {
            newRow[COL.AREA - 1] = u.area;
            changedFields.push('направление');
          }
          if (u.objectives != null && typeof COL.OBJECTIVES === 'number') {
            newRow[COL.OBJECTIVES - 1] = String(u.objectives || '').trim();
            changedFields.push('цели');
          }
          if (u.expectedResults != null && typeof COL.EXPECTED_RESULTS === 'number') {
            newRow[COL.EXPECTED_RESULTS - 1] = String(u.expectedResults || '').trim();
            changedFields.push('очаквани резултати');
          }
          if (u.durationMonths != null && typeof COL.DURATION_MONTHS === 'number') {
            newRow[COL.DURATION_MONTHS - 1] = Number(u.durationMonths) || '';
            changedFields.push('продължителност');
          }
          if (u.budget != null && typeof COL.BUDGET === 'number') {
            var _budgetUpd = typeof u.budget === 'string' ? safeParseJSON(u.budget,{}) : u.budget;
            if (u.npfTier) _budgetUpd._npfTier = String(u.npfTier);
            newRow[COL.BUDGET - 1] = JSON.stringify(_budgetUpd);
            changedFields.push('бюджет');
          }
          if (u.teamMembers != null && Array.isArray(u.teamMembers)) {
            newRow[COL.TEAM_MEMBERS - 1] = JSON.stringify(u.teamMembers);
            changedFields.push('екип');
          }
          if (u.attachedDocs != null && Array.isArray(u.attachedDocs)) {
            // Resolve library-doc copies for admin too
            try {
              var ownerEmail = String(rowData[COL.USER_EMAIL - 1] || '').toLowerCase().trim();
              // v12.30.1-perf: Use cached resolver — avoids redundant Drive API calls
              // when updateForm already resolved the same docs in the same execution.
              u.attachedDocs = _cachedResolveAttachedDocs_(body.id, u.attachedDocs, ownerEmail);
            } catch (_) {}
            newRow[COL.ATTACHED_DOCS - 1] = JSON.stringify(u.attachedDocs);
            changedFields.push('документи');
          }
          // v4.3.1 fields
          if (u.professionalField != null && typeof COL.PROFESSIONAL_FIELD === 'number') {
            newRow[COL.PROFESSIONAL_FIELD - 1] = String(u.professionalField || '').trim();
            changedFields.push('професионално направление');
          }
          if (u.titleEn != null && typeof COL.TITLE_EN === 'number') {
            newRow[COL.TITLE_EN - 1] = String(u.titleEn || '').trim();
            changedFields.push('заглавие (англ.)');
          }
          if (u.acronym != null && typeof COL.ACRONYM === 'number') {
            newRow[COL.ACRONYM - 1] = String(u.acronym || '').trim().toUpperCase();
            changedFields.push('акроним');
          }
          if (u.descriptionEn != null && typeof COL.DESCRIPTION_EN === 'number') {
            newRow[COL.DESCRIPTION_EN - 1] = String(u.descriptionEn || '').trim();
            changedFields.push('описание (англ.)');
          }

          if (changedFields.length === 0) {
            return { success: false, error: 'Няма промени за записване.' };
          }

          // Record the admin edit in history with full audit info
          history.push({
            action: 'Редактирано от администратор: ' + changedFields.join(', '),
            date: now,
            user: actor,
            role: 'admin',
            adminId: auth.userId || '',
            fields: changedFields
          });
          newRow[COL.HISTORY - 1] = JSON.stringify(history);

          safeSetRow_(sheet, rowIndex, newRow, TOTAL_COLS);
          applyRowColor(sheet, rowIndex, newRow[COL.STATUS - 1]);

          try { logTransaction('ADMIN_EDIT_FORM', actor || 'admin', body.id, { changedFields: changedFields }); } catch (_) {}

          // Notify applicant about the admin edit
          try {
            var applicantEmail = String(rowData[COL.USER_EMAIL - 1] || '').toLowerCase().trim();
            if (applicantEmail) {
              var applicantName = String(rowData[COL.USER_NAME - 1] || '');
              var formTitle = String(rowData[COL.TITLE - 1] || '');
              notifyAdminEdit_(applicantEmail, applicantName, body.id, formTitle, changedFields, actor);
            }
          } catch (_) {}

          return { success: true, message: 'Заявлението е редактирано от администратор', changedFields: changedFields };
        } catch (err) {
          try { logError('adminEditForm', err, body); } catch (_) {}
          return { success: false, error: 'adminEditForm failed: ' + err.message };
        }
      }

      /** Notify applicant that an admin edited their form */
      function notifyAdminEdit_(email, userName, formId, title, changedFields, adminName) {
        try {
          var heading = '✏️ Администраторът редактира вашето заявление';
          var lines = [
            { label: 'Заявление:', value: formId },
            { label: 'Заглавие:', value: title || '(без заглавие)' },
            { label: 'Кандидат:', value: userName || email },
            { label: 'Променени полета:', value: changedFields.join(', ') },
            { label: 'Администратор:', value: adminName || 'администратор' },
            { label: 'Дата:', value: new Date().toLocaleString('bg-BG', { timeZone: 'Europe/Sofia' }) }
          ];
          var footer = 'Промените са направени от администратор. Ако имате въпроси, моля свържете се с администратора.';
          var html = buildNotificationHtml_(heading, lines, footer, { status: 'returned', preheader: 'Администратор редактира заявление ' + formId });

          // Store as in-app notification (Messages sheet) for the notification tab
          try {
            var msh = _getMessagesSheet_();
            var msgId = 'admin-edit:' + formId + ':' + Date.now();
            var ts = new Date().toISOString();
            msh.appendRow([msgId, formId, 'admin', 'admin',
              'Администраторът редактира вашето заявление. Променени полета: ' + changedFields.join(', '),
              ts, false]);
            try { touchDataVersion_('messages'); } catch (_) {}
          } catch (_) {}

          // Send email notification
          return notifyApplicant_(email, 'Редакция на заявление ' + formId, html, 'status_change');
        } catch (err) {
          try { logError('notifyAdminEdit_', err, { formId: formId, email: email }); } catch (_) {}
          return { ok: false };
        }
      }

      function submitForm(body) {
        try {
          var sheet = getSheet();
          var found = findRowByID(sheet, body.id);
          if (!found) return { success: false, error: 'Form not found: ' + body.id };

          var rowIndex = found.rowIndex;
          var rowData  = found.rowData;

          var currentStatus = String(rowData[COL.STATUS - 1] || '');
          if (currentStatus !== 'draft' && currentStatus !== 'returned' && currentStatus !== 'needs_correction') {
            // Idempotent retry guard: if the OTP code was provided and the form is already
            // submitted/resubmitted, the most likely cause is a network timeout — the backend
            // processed the first request successfully but the response was lost, so the client
            // retried. Return success instead of a confusing error.
            var _retryOtp = String(body.otpCode || body.otp || '').trim();
            if (_retryOtp && (currentStatus === 'submitted' || currentStatus === 'resubmitted')) {
              return { success: true, idempotent: true, message: 'Заявлението вече е подадено успешно.' };
            }
            return { success: false, error: 'Заявлението не може да бъде изпратено (статус: ' + currentStatus + ')' };
          }

          var auth = resolveAuthContext(body || {});
          var ownerEmail = String(rowData[COL.USER_EMAIL - 1] || '').toLowerCase().trim();

          // ── CKK member block (v9.37.0-regulatory) ──
          // Per Бележки и коментари.docx: "Членовете на ЦКК не участват в проектни предложения"
          if (isCKKMember_(ownerEmail)) {
            return { success: false, error: 'Членовете на ЦКК не могат да подават проектни предложения съгласно правилника на конкурсната сесия.' };
          }

          if (!auth.isAdmin && auth.userId && ownerEmail && auth.userId !== ownerEmail) {
            return { success: false, error: 'Нямате права да изпратите това заявление.' };
          }

          // ── Minimum content guard: submission must have title + description ──
          var subTitle = String(rowData[COL.TITLE - 1] || '').trim();
          var subDesc  = String(rowData[COL.DESCRIPTION - 1] || '').trim();
          if (!subTitle) {
            return { success: false, error: 'Заявлението няма наименование. Попълнете задължителните полета преди подаване.' };
          }
          if (!subDesc) {
            return { success: false, error: 'Заявлението няма описание. Попълнете задължителните полета преди подаване.' };
          }

          // ── v9.37.0-regulatory: Comprehensive submission validation ──
          try {
            var _subProjType = String(rowData[COL.PROJECT_CODE - 1] || '').trim().toUpperCase();
            var _subCompId   = String(rowData[COL.COMPETITION - 1] || '').trim();
            var _subBudget   = safeParseJSON(String(rowData[COL.BUDGET - 1] || '{}'), {});
            var _subTeam     = safeParseJSON(String(rowData[COL.TEAM_MEMBERS - 1] || '[]'), []);
            var _subAttached = safeParseJSON(String(rowData[COL.ATTACHED_DOCS - 1] || '[]'), []);
            var _rl = rowData.length;
            var _subFormData = {
              title:             subTitle,
              description:       subDesc,
              titleEn:           (_rl >= COL.TITLE_EN       ? String(rowData[COL.TITLE_EN - 1]       || '') : ''),
              descriptionEn:     (_rl >= COL.DESCRIPTION_EN ? String(rowData[COL.DESCRIPTION_EN - 1] || '') : ''),
              objectives:        (_rl >= COL.OBJECTIVES      ? String(rowData[COL.OBJECTIVES - 1]      || '') : ''),
              expectedResults:   (_rl >= COL.EXPECTED_RESULTS? String(rowData[COL.EXPECTED_RESULTS - 1]|| '') : ''),
              durationMonths:    Number(rowData[COL.DURATION_MONTHS - 1]) || 0,
              area:              String(rowData[COL.AREA - 1] || ''),
              professionalField: String(rowData[COL.PROFESSIONAL_FIELD - 1] || ''),
              acronym:           String(rowData[COL.ACRONYM - 1] || ''),
              teamMembers:       _subTeam,
              budget:            _subBudget,
              attachedDocs:      _subAttached,
              npfTier:           _subBudget._npfTier || '',
              userId:            ownerEmail,
              trlLevel:          0
            };
            var _subValErr = _validateSubmission_(_subFormData, _subProjType, _subCompId);
            if (_subValErr) return { success: false, error: _subValErr };
          } catch (_valEx) { /* validation failed to construct — let the existing guards catch issues */ }

          // ── Budget guard: must be populated with a non-zero total. ──
          try {
            var _budgetRaw = String(rowData[COL.BUDGET - 1] || '').trim();
            var _budgetObj = null;
            if (_budgetRaw) { try { _budgetObj = JSON.parse(_budgetRaw); } catch (_) { _budgetObj = null; } }
            var _budgetTotal = 0;
            if (_budgetObj && typeof _budgetObj === 'object') {
              Object.keys(_budgetObj).forEach(function (k) {
                if (k === '_monthlyMode' || k === '_monthly') return;
                var v = _budgetObj[k];
                if (v && typeof v === 'object') {
                  Object.keys(v).forEach(function (p) { var n = Number(v[p]); if (!isNaN(n)) _budgetTotal += n; });
                } else {
                  var n = Number(v); if (!isNaN(n)) _budgetTotal += n;
                }
              });
            }
            if (_budgetTotal <= 0) {
              return { success: false, error: 'Бюджетът е празен. Попълнете разходните групи преди подаване.' };
            }
          } catch (_) { /* fall through — fail open on parse error */ }

          // ── Attachments guard: at least one attached document or uploaded file. ──
          try {
            var _attachedJson = String(rowData[COL.ATTACHED_DOCS - 1] || '').trim();
            var _fileIdsJson  = String(rowData[COL.FILE_IDS - 1]      || '').trim();
            var _attached = []; var _fileIds = [];
            try { _attached = JSON.parse(_attachedJson || '[]'); } catch (_) { _attached = []; }
            try { _fileIds  = JSON.parse(_fileIdsJson  || '[]'); } catch (_) { _fileIds  = []; }
            if (!Array.isArray(_attached)) _attached = [];
            if (!Array.isArray(_fileIds))  _fileIds  = [];
            if (_attached.length + _fileIds.length < 2) {
              return { success: false, error: 'Заявлението изисква поне 2 прикачени документа (напр. формуляр за кандидатстване, биография на ръководителя). Прикачете липсващите документи преди подаване.' };
            }
          } catch (_) { /* fall through */ }

          // ── Google-style 2FA verification step (skipped for admins) ──
          // Flow:
          //   1. Client first calls submitForm WITHOUT otpCode → server issues
          //      a 6-digit code, emails it, returns { require2fa: true }.
          //   2. Client re-calls submitForm with the same payload + otpCode →
          //      server verifies and proceeds with the actual submission.
          if (!auth.isAdmin) {
            var otpEmail = ownerEmail || String(body.email || body.userId || '').toLowerCase().trim();
            var otpRef   = String(body.id || '');
            var otpCode  = String(body.otpCode || body.otp || '').trim();
            if (!otpCode) {
              if (String(body.resend2fa || '') === '1') {
                // Force-issue a new code on explicit resend (still subject to cooldown)
              }
              var issued = _2faIssue_('submitform', otpEmail, otpRef);
              if (!issued.success) {
                return { success: false, error: issued.error || 'Не може да се изпрати код за потвърждение.' };
              }
              return {
                success: false,
                require2fa: true,
                twoFactor: {
                  channel: 'email',
                  mode: 'email',
                  email: otpEmail,
                  scope: 'submitform',
                  ref: otpRef,
                  expiresIn: issued.expiresIn,
                  cooldown: issued.cooldown,
                  throttled: !!issued.throttled,
                  codeSent: !!issued.codeSent
                },
                message: issued.codeSent
                  ? 'Изпратен е 6-цифрен код за потвърждение на ' + otpEmail + '.'
                  : 'Има активен код. Проверете имейла си.'
              };
            }
            var verify = _2faVerify_('submitform', otpEmail, otpRef, otpCode);
            if (!verify.success) {
              return {
                success: false,
                require2fa: true,
                otpError: verify.error || 'Грешен код.',
                attemptsLeft: verify.attemptsLeft,
                expired: !!verify.expired,
                locked: !!verify.locked,
                twoFactor: { channel: verify.mode || 'email', mode: verify.mode || 'email', email: otpEmail, scope: 'submitform', ref: otpRef }
              };
            }
          }

          // ── Competition deadline enforcement (per regulation: 1 month from announcement) ──
          var competitionId = String(rowData[COL.COMPETITION - 1] || '').trim();
          if (competitionId) {
            try {
              // PERF: use cached competitions lookup instead of full sheet scan.
              var compObj = getCompetitionById_(competitionId, false);
              if (compObj) {
                var deadlineStr = String(compObj.deadline || compObj.dateEnd || '').trim();
                var compStatus = String(compObj.status || '').trim().toLowerCase();
                if (deadlineStr) {
                  var deadlineDate = new Date(deadlineStr);
                  if (!isNaN(deadlineDate.getTime()) && new Date() > deadlineDate) {
                    return { success: false, error: 'Срокът за подаване е изтекъл (' + deadlineDate.toLocaleDateString('bg-BG') + '). Подаването е невъзможно.' };
                  }
                }
                if (compStatus === 'closed' || compStatus === 'closed_for_submission' || compStatus === 'archived') {
                  return { success: false, error: 'Конкурсът е затворен за подаване на предложения.' };
                }
              }
            } catch (compErr) { console.warn('submitForm competition deadline check failed: ' + compErr.message); }
          }

          // ── 5-business-day correction deadline enforcement on resubmission ──
          // UC-12/13 (Workflow spec): applies to both 'returned' and
          // 'needs_correction' statuses since both set RETURN_COMMENT.deadline.
          if (currentStatus === 'returned' || currentStatus === 'needs_correction') {
            try {
              var returnComment = String(rowData[COL.RETURN_COMMENT - 1] || '');
              var parsedRC = null;
              try { parsedRC = JSON.parse(returnComment); } catch (_) {}
              if (parsedRC && parsedRC.deadline) {
                var corrDeadline = new Date(parsedRC.deadline);
                if (!isNaN(corrDeadline.getTime()) && new Date() > corrDeadline) {
                  return { success: false, error: 'Срокът за корекция (5 работни дни) е изтекъл (' + corrDeadline.toLocaleDateString('bg-BG') + '). Подаването е невъзможно. Свържете се с администратор за извънреден прозорец.' };
                }
              }
            } catch (_) {}
          }

          // ── Pre-submission budget validation (source: 01 Бюджет/ docs) ──
          var projectCode = String(rowData[COL.PROJECT_CODE - 1] || '').trim().toUpperCase();
          if (projectCode) {
            var budgetRaw = rowData[COL.BUDGET - 1];
            // Parse budget if it's a JSON string
            if (typeof budgetRaw === 'string') {
              try { budgetRaw = JSON.parse(budgetRaw); } catch (_) { budgetRaw = null; }
            }
            var budgetEUR = _computeBudgetTotalEUR_(budgetRaw);
            if (budgetEUR > 0) {
              var budgetCheck2 = _validateBudgetForType_(projectCode, budgetEUR);
              if (!budgetCheck2.ok) {
                return { success: false, error: budgetCheck2.error };
              }
              // v6.8.0 — Category-level budget validation on submission
              var budgetRows = [];
              if (typeof budgetRaw === 'object' && budgetRaw.categories) {
                budgetRows = budgetRaw.categories;
              } else if (typeof budgetRaw === 'string' && budgetRaw.charAt(0) === '{') {
                try { var bp3 = JSON.parse(budgetRaw); if (bp3.categories) budgetRows = bp3.categories; } catch (_) {}
              }
              if (budgetRows.length > 0) {
                var hasDoctoralYoung = false;
                try { var teamCheck = JSON.parse(String(rowData[COL.TEAM_MEMBERS - 1] || '[]')); hasDoctoralYoung = teamCheck.some(function(m) { return String(m.isDoctoralYoung || '').toUpperCase() === 'YES' || String(m.isYoungResearcher || '').toUpperCase() === 'YES'; }); } catch (_) {}
