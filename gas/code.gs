      var _DOC_LABELS_ = {
        'fnipdf':         'Пълно проектно предложение (PDF)',
        'fniteamextra':   'Допълнителна информация — екип (DOCX)',
        'fniextra':       'Допълнителна информация — програма (DOCX)',
        'fnibudget':      'Бюджетна таблица (XLSX)',
        'pnipdf':         'Пълно проектно предложение (PDF)',
        'pniteamextra':   'Допълнителна информация — екип (DOCX)',
        'pniextra':       'Допълнителна информация — програма (DOCX)',
        'pnibudget':      'Бюджетна таблица (XLSX)',
        'dnppdf':         'Пълно проектно предложение (PDF)',
        'dnpextra':       'Допълнителна информация (DOCX)',
        'dnpcv':          'Автобиография (DOCX)',
        'dnpbudget':      'Бюджетна таблица (XLSX)',
        'npfpdf':         'Пълно проектно предложение (PDF)',
        'npfextra':       'Допълнителна информация (DOCX)',
        'npfbudget':      'Бюджетна таблица (XLSX)'
      };

      function _checkRequiredDocuments_(projectType, attachedDocs, fileIds) {
        var req = REQUIRED_DOCUMENTS_BY_TYPE[projectType];
        if (!req || req.length === 0) return { ok: true, missing: [] };
        // Build a search corpus once: join names + IDs into a single lowercase string
        var parts = [];
        var ads = Array.isArray(attachedDocs) ? attachedDocs : [];
        var fids = Array.isArray(fileIds) ? fileIds : [];
        // Pre-allocate capacity
        for (var ai = 0; ai < ads.length; ai++) {
          var d = ads[ai];
          if (d.name) parts.push(String(d.name).toLowerCase());
          if (d.id)   parts.push(String(d.id).toLowerCase());
          if (d.docType) parts.push(String(d.docType).toLowerCase());
        }
        for (var fi = 0; fi < fids.length; fi++) {
          var f = fids[fi];
          if (f.name) parts.push(String(f.name).toLowerCase());
          if (f.id)   parts.push(String(f.id).toLowerCase());
        }
        var corpus = ' ' + parts.join(' ') + ' '; // pad for word-boundary check
        var missing = [];
        for (var ri = 0; ri < req.length; ri++) {
          var tplId = req[ri];
          var tplLc = tplId.toLowerCase();
          // Primary: check for tplId as a substring (padded)
          var found = corpus.indexOf(' ' + tplLc) !== -1 || corpus.indexOf(tplLc + ' ') !== -1;
          // Fallback: any attached doc whose name starts with tplId + '_'
          if (!found) {
            for (var ai2 = 0; ai2 < ads.length; ai2++) {
              if (String(ads[ai2].name || '').toLowerCase().indexOf(tplLc + '_') === 0) { found = true; break; }
            }
          }
          if (!found) missing.push(tplId);
        }
        return { ok: missing.length === 0, missing: missing };
      }

      // _computeBudgetTotalBGN_ is defined later (line ~1228) — this duplicate
      // was dead code that leaked EUR instead of BGN. Removed in v9.39.3.

      function _validateBudgetForType_(projectType, budgetEUR) {
        var key = _normalizeProjectType_(projectType);
        if (!key) return { ok: true, maxBudget: null, error: '' };
        var max = _getMaxBudgetForType_(key);
        if (max === null) return { ok: true, maxBudget: null, error: '' };
        if (Number(budgetEUR) > max) {
          return { ok: false, maxBudget: max, error: 'Бюджетът (' + Number(budgetEUR).toFixed(0) + ' €) надвишава максимума за ' + key + ' (' + max + ' €).' };
        }
        return { ok: true, maxBudget: max, error: '' };
      }

      // ═══════════════════════════════════════════════════════════════════
      //  v9.37.0-regulatory — COMPREHENSIVE SUBMISSION VALIDATION
      //  Single gate that enforces ALL regulatory rules before a project
      //  proposal can be submitted. Called from createForm (non-draft) and
      //  submitForm.
      // ═══════════════════════════════════════════════════════════════════

      /**
       * Check whether any team member is a doctoral student or young scientist.
       */
      function _teamHasDoctoralOrYoung_(teamMembers) {
        if (!Array.isArray(teamMembers)) return false;
        return teamMembers.some(function(m) {
          return (m.role === 'young' || m.role === 'doctoral' || m.youngScientist || m.doctoral);
        });
      }

      /**
       * Validate a submission against all regulatory rules.
       * Returns an error string if validation fails, or null if it passes.
       */
      function _validateSubmission_(formData, projectType, competitionId) {
        var f = formData || {};
        var pt = String(projectType || '').toUpperCase();
        var rules = PROJECT_TYPE_RULES[pt];
        if (!rules) return 'Невалиден тип проект: ' + pt;

        // ── 1. Duration enforcement (чл.10 Правилник: ≥ 12 месеца) ──
        // Only block if a value was explicitly provided and is below the minimum.
        // 0 / missing → old draft row pre-dating this column; skip the check.
        var dur = Number(f.durationMonths) || 0;
        if (dur > 0 && dur < (rules.minDurationMonths || 12)) {
          return 'Срокът на изпълнение (' + dur + ' мес.) е под минимума от ' + (rules.minDurationMonths || 12) + ' месеца съгласно чл. 10 от Правилника.';
        }
        if (rules.maxDurationMonths && dur > rules.maxDurationMonths) {
          return 'Срокът на изпълнение (' + dur + ' мес.) надвишава максимума от ' + rules.maxDurationMonths + ' месеца.';
        }

        // ── 2. Team size enforcement (чл.4 Правилник: макс. 5 души + 3 студенти) ──
        var team = Array.isArray(f.teamMembers) ? f.teamMembers : [];
        var maxTeam = rules.maxTeamMembers || 5;
        if (pt === 'ФНИ' || pt === 'ПНИ') {
          if (team.length > maxTeam) {
            return 'Екипът надвишава максималния брой от ' + maxTeam + ' души (текущо: ' + team.length + ').';
          }
          var students = Array.isArray(f.studentCollaborators) ? f.studentCollaborators : [];
          var maxStudents = rules.maxStudentCollaborators || 3;
          if (students.length > maxStudents) {
            return 'Броят студенти-сътрудници (' + students.length + ') надвишава максимума от ' + maxStudents + '.';
          }
        }

        // ── 3. Title enforcement ──
        var title = String(f.title || '').trim();
        if (!title || title === '.') {
          return 'Липсва наименование на проектното предложение.';
        }

        // ── 3b. Title EN — advisory only; frontend already enforces this ──
        // (Removing hard block here prevents false positives when state/network
        //  timing delivers an empty string despite the UI field being filled.)

        // ── 4. Description enforcement (presence + word-count) ──
        // Presence check kept only for BG description — it is always stored in the
        // sheet (COL.DESCRIPTION) and sent by every frontend path.
        var desc = String(f.description || '').trim();
        if (!desc) {
          return 'Липсва кратко описание на проектното предложение.';
        }
        var wordCount = desc.split(/\s+/).filter(Boolean).length;
        if (wordCount > 200) {
          return 'Краткото описание надвишава 200 думи (текущо: ' + wordCount + ').';
        }

        // ── 4b. Description EN — advisory only; frontend enforces this ──
        // Presence block removed: COL.DESCRIPTION_EN (col 34) was added later than
        // COL.DESCRIPTION (col 8); old draft rows may have an empty cell even when
        // the user filled the field, causing a false positive. Word-count is still
        // enforced when text is present.
        var descEn = String(f.descriptionEn || '').trim();
        if (descEn) {
          var wordCountEn = descEn.split(/\s+/).filter(Boolean).length;
          if (wordCountEn > 200) {
            return 'Краткото описание на английски надвишава 200 думи (текущо: ' + wordCountEn + ').';
          }
        }

        // ── 4c. Objectives — advisory only; frontend enforces this ──
        // Same rationale as 4b: COL.OBJECTIVES (col 24) may be empty in older rows.
        // Frontend validate() already blocks submission when objectives is empty.

        // ── 5. Area / Priority direction enforcement ──
        var area = String(f.area || '').trim();
        if (!area) {
          return 'Не е избрано приоритетно направление.';
        }

        // ── 6. Professional field enforcement (multi-select, ;;‑delimited) ──
        var profField = String(f.professionalField || '').trim();
        if (!profField) {
          return 'Не е избрано професионално направление.';
        }
        // Validate each ;;‑delimited value against the known professional field codes
        var VALID_PROF_FIELDS = ['3.7','3.8','3.9','4.6'];
        var pfParts = profField.split(';;').filter(Boolean);
        if (pfParts.length > 0) {
          for (var pfi = 0; pfi < pfParts.length; pfi++) {
            if (VALID_PROF_FIELDS.indexOf(pfParts[pfi].trim()) === -1) {
              console.warn('_validateSubmission_: unrecognised professionalField part=' + pfParts[pfi]);
            }
          }
        }

        // ── 7. Acronym enforcement ──
        var acronym = String(f.acronym || '').trim();
        if (acronym && !/^[A-Za-z0-9]{1,10}$/.test(acronym)) {
          return 'Акронимът трябва да съдържа само латински букви и цифри (макс. 10 символа).';
        }

        // ── 8. ДНП: no team remuneration ──
        if (pt === 'ДНП' && rules.noTeamRemuneration) {
          var budgetRaw2 = f.budget;
          if (budgetRaw2 && typeof budgetRaw2 === 'object') {
            var salVal = Number(budgetRaw2.salaries || budgetRaw2.team_remuneration || 0);
            if (salVal > 0) {
              return 'Проекти от тип ДНП не могат да включват възнаграждения на екипа.';
            }
          }
        }

        // ── 9. НПФ: tier budget enforcement ──
        if (pt === 'НПФ' && rules.npfTiers) {
          var tierKey = String(f.npfTier || 'university').toLowerCase();
          var tier = rules.npfTiers[tierKey] || rules.npfTiers.university;
          var budgetEUR = _computeBudgetTotalEUR_(f.budget);
          var maxEUR = tier.maxEUR || 6000;
          if (budgetEUR > maxEUR) {
            return 'Бюджетът (' + budgetEUR.toFixed(0) + ' €) надвишава лимита за ниво „' + (tier.label || tierKey) + '" (' + maxEUR + ' €).';
          }
        }

        // ── 10. НПФ: tier selection required ──
        if (pt === 'НПФ' && !f.npfTier) {
          return 'Не е избрано ниво на форума (катедра/факултет/университет).';
        }

        // ── 11. CKK member block ──
        var leaderEmail = String(f.userId || f.email || '').toLowerCase().trim();
        if (leaderEmail && isCKKMember_(leaderEmail)) {
          return 'Членовете на ЦКК не могат да подават проектни предложения съгласно правилника на конкурсната сесия.';
        }

        // ── 12. ПНИ: TRL requirement ──
        // Only block if the applicant has explicitly entered a TRL level that is
        // too low. If no TRL level is provided (undefined / 0), skip the check —
        // the form UI does not currently expose a TRL field and blocking on 0
        // would prevent every ПНИ submission.
        if (pt === 'ПНИ' && rules.requiresTRL) {
          var trl = Number(f.trlLevel) || 0;
          if (trl > 0 && trl < 4) {
            return 'Проектите от тип ПНИ изискват ниво на технологична готовност (TRL) ≥ 4 (въведено: ' + trl + ').';
          }
        }

        // ── 13. ПНИ: support letters check ──
        if (pt === 'ПНИ' && rules.requiresSupportLetters) {
          var sDocs = (Array.isArray(f.attachedDocs) ? f.attachedDocs : []).concat(Array.isArray(f.files) ? f.files : []);
          var hasSupportLetter = sDocs.some(function(d){
            var dName = String(d.name || d.label || '').toLowerCase();
            return dName.indexOf('support') !== -1 || dName.indexOf('подкрепа') !== -1 || dName.indexOf('pismo') !== -1 || dName.indexOf('писмо') !== -1;
          });
          if (!hasSupportLetter) {
            return 'За проекти от тип ПНИ са задължителни писма за подкрепа (до 2 от бизнес + до 2 от научни организации).';
          }
        }

        // ── 14. Competition deadline enforcement ──
        var deadlineCheck = _checkCompetitionDeadline_(competitionId);
        if (!deadlineCheck.ok) return deadlineCheck.reason;

        // ── 15. Required documents per project type ──
        var docCheck = _checkRequiredDocuments_(pt, f.attachedDocs, f.files);
        if (!docCheck.ok) {
          var _missingNames = docCheck.missing.map(function(m) { return _DOC_LABELS_[m] || m; });
          return 'Липсват задължителни документи за ' + pt + ': ' + _missingNames.join(', ') + '.';
        }

        // ── 15б. Budget spreadsheet per project type (v9.69.2) ──
        if (typeof PROJECT_BUDGET_TEMPLATES !== 'undefined' && PROJECT_BUDGET_TEMPLATES[pt]) {
          var _bDocs = (Array.isArray(f.attachedDocs) ? f.attachedDocs : []);
          var _hasBudgetSheet = _bDocs.some(function(d){
            if (!d) return false;
            if (String(d.docType || '').toLowerCase() === 'budget' || d._budget === true) return true;
            var bn = String(d.name || '').toLowerCase();
            return bn.indexOf('бюджетна таблица') !== -1;
          });
          if (!_hasBudgetSheet) {
            return 'Липсва бюджетната таблица за ' + pt + '. Генерирайте я в стъпка „Документи" и опитайте отново.';
          }
        }

        // ── 16. Declaration of consent — UI removed per user request (v10.10.3) ──
        // No longer validated. Правилник embed is shown in Step 3 for reference.

        // ── 17. Self-assessment minimum score (≥ 51 от 100 т.) ──
        if (pt === 'ФНИ' || pt === 'ПНИ' || pt === 'ДНП') {
          var saScore = Number(f.selfAssessmentScore) || 0;
          if (saScore > 0 && saScore < 51) {
            return 'Самооценката (' + saScore + ' т.) е под минималния праг от 51 точки (50%+1).';
          }
        }

        // ── 18. M1 (December) zero-expense rule for ФНИ/ПНИ ──
        if ((pt === 'ФНИ' || pt === 'ПНИ') && rules.noExpensesFirstMonth) {
          var budgetObj = f.budget;
          if (budgetObj && typeof budgetObj === 'object') {
            // Check if any category has expenses in month M1 or year "2026" with December
            // The budget stores {category: {year: amount}}; M1 restriction means
            // the first month (December of start year) should have zero expenses.
            // We check if there's a _monthly entry for M1
            var monthly = budgetObj._monthly || {};
            var m1Expenses = 0;
            Object.keys(monthly).forEach(function(gid) {
              var m1val = Number(monthly[gid] && monthly[gid]['M1']) || 0;
              m1Expenses += m1val;
            });
            if (m1Expenses > 0) {
              return 'През първия месец (M1) не се допускат разходи съгласно правилата за ' + pt + '.';
            }
          }
        }

        // ── 18. Budget must have at least one category with non-zero amount ──
        // v10.4.0: skip when budget spreadsheet is already attached (it IS the budget)
        var _hasBudgetSheet = (Array.isArray(f.attachedDocs) ? f.attachedDocs : []).some(function(d){
          if (!d) return false;
          return String(d.docType || '').toLowerCase() === 'budget' || d._budget === true;
        });
        if (!_hasBudgetSheet) {
          var budgetTotalBGN = _computeBudgetTotalBGN_(f.budget);
          if (budgetTotalBGN <= 0) {
            return 'Бюджетът е празен. Попълнете поне една разходна категория или генерирайте бюджетната таблица.';
          }
        }

        return null; // All checks passed
      }

      function _computeBudgetTotalBGN_(budgetRaw) {
        if (!budgetRaw || typeof budgetRaw !== 'object') return 0;
        var total = 0;
        var keys = Object.keys(budgetRaw);
        for (var ki = 0; ki < keys.length; ki++) {
          var k = keys[ki];
          if (k === '_monthlyMode' || k === '_npfTier') continue;
          var v = budgetRaw[k];
          if (k === '_monthly') {
            if (typeof v === 'object' && v !== null) {
              var gkeys = Object.keys(v);
              for (var gi = 0; gi < gkeys.length; gi++) {
                var mp = v[gkeys[gi]];
                if (mp && typeof mp === 'object') {
                  var pkeys = Object.keys(mp);
                  for (var pi = 0; pi < pkeys.length; pi++) { total += Number(mp[pkeys[pi]]) || 0; }
                } else {
                  total += Number(mp) || 0;
                }
              }
            }
            continue;
          }
          if (typeof v === 'object' && v !== null && !Array.isArray(v)) {
            var ykeys = Object.keys(v);
            for (var yi = 0; yi < ykeys.length; yi++) { total += Number(v[ykeys[yi]]) || 0; }
          } else {
            total += Number(v) || 0;
          }
        }
        return total;
      }

      /**
       * Compute total budget in EUR by dividing the BGN total by the fixed
       * EUR/BGN exchange rate (_eur_() returns 1.95583 if not overridden).
       * This function was missing, causing "_computeBudgetTotalEUR_ is not defined"
       * at createForm / submitForm time.
       */
      function _computeBudgetTotalEUR_(budgetRaw) {
        return _computeBudgetTotalBGN_(budgetRaw) / _eur_();
      }

      function _eur_() {
        return (typeof EUR_BGN !== 'undefined' && isFinite(Number(EUR_BGN)) && Number(EUR_BGN) > 0) ? Number(EUR_BGN) : 1.95583;
      }

      // ═══════════════════════════════════════════════════════════════════
      //  v6.8.0 — BUDGET CATEGORY LIMIT VALIDATION
      //  Validates each expense line against the regulatory percentage
      //  limits defined in PROJECT_TYPE_RULES[type].expenseLimits.
      // ═══════════════════════════════════════════════════════════════════

      /**
       * Validate a full budget breakdown against category-level limits.
       * @param {string} projectType — e.g. 'ФНИ', 'ПНИ', 'ДНП', 'НФ'
       * @param {Array} budgetRows — [{ categoryId, amount, label }]
       * @param {Object} opts — { hasDoctoralYoung: bool, totalBudget: number }
       * @returns {{ ok: boolean, errors: Array<{categoryId, rule, message}> }}
       */
      function _validateBudgetCategories_(projectType, budgetRows, opts) {
        var key = _normalizeProjectType_(projectType);
        if (!key) return { ok: true, errors: [] };
        var rules = PROJECT_TYPE_RULES[key];
        if (!rules || !rules.expenseLimits) return { ok: true, errors: [] };
        var limits = rules.expenseLimits;
        var total = Number(opts && opts.totalBudget) || 0;
        if (total <= 0) return { ok: true, errors: [] };
        var errors = [];
        var hasDoctoralYoung = !!(opts && opts.hasDoctoralYoung);

        // Build lookup: categoryId → amount
        var amountByCat = {};
        (budgetRows || []).forEach(function(row) {
          var cat = String(row.categoryId || row.id || '');
          amountByCat[cat] = (amountByCat[cat] || 0) + Number(row.amount || 0);
        });

        // Helper: check percentage limit
        function _chkPct(catId, ruleName, maxPct, label) {
          var amt = amountByCat[catId] || 0;
          if (amt > 0 && maxPct > 0) {
            var pct = (amt / total) * 100;
            if (pct > maxPct) {
              errors.push({
                categoryId: catId,
                rule: ruleName,
                message: (label || catId) + ': ' + pct.toFixed(1) + '% надвишава максимум ' + maxPct + '% от бюджета (' + amt.toFixed(0) + ' / ' + total.toFixed(0) + ' €).'
              });
            }
          }
        }

        // ── ФНИ / ПНИ validations ──
        if (limits.literature_pct)           _chkPct('literature', 'literature_pct', limits.literature_pct, 'Литература');
        if (limits.datasets_pct)             _chkPct('datasets', 'datasets_pct', limits.datasets_pct, 'Бази данни');
        if (limits.office_supplies_pct)      _chkPct('office_supplies', 'office_supplies_pct', limits.office_supplies_pct, 'Канцеларски материали');
        if (limits.typesetting_pct)          _chkPct('typesetting', 'typesetting_pct', limits.typesetting_pct, 'Компютърен набор');
        if (limits.external_services_pct)    _chkPct('external_services', 'external_services_pct', limits.external_services_pct, 'Външни услуги');
        if (limits.domestic_travel_pct)      _chkPct('domestic_travel', 'domestic_travel_pct', limits.domestic_travel_pct, 'Командировки в страната');
        if (limits.international_travel_pct) _chkPct('international_travel', 'international_travel_pct', limits.international_travel_pct, 'Международни командировки');
        if (limits.empirical_research_pct)   _chkPct('empirical_research', 'empirical_research_pct', limits.empirical_research_pct, 'Емпирични изследвания');

        // Team remuneration — different limits with/without PhDs/young scientists
        if (limits.team_remuneration_pct) {
          var teamPay = amountByCat['team_remuneration'] || 0;
          var maxPct = hasDoctoralYoung ? limits.team_remuneration_pct : (limits.team_remuneration_no_phd_pct || limits.team_remuneration_pct);
          if (teamPay > 0) {
            var pctTP = (teamPay / total) * 100;
            if (pctTP > maxPct) {
              errors.push({
                categoryId: 'team_remuneration',
                rule: 'team_remuneration_pct',
                message: 'Възнаграждения на екип: ' + pctTP.toFixed(1) + '% надвишава максимум ' + maxPct + '%' +
                  (hasDoctoralYoung ? ' (с докторанти/млади учени)' : ' (без докторанти/млади учени)') +
                  ' (' + teamPay.toFixed(0) + ' / ' + total.toFixed(0) + ' €).'
              });
            }
          }
        }

        // Doctoral/young scientists minimum share of team pay
        if (limits.doctoral_young_min_pct && hasDoctoralYoung) {
          var teamPay2 = amountByCat['team_remuneration'] || 0;
          var docYoungPay = amountByCat['doctoral_young'] || 0;
          if (teamPay2 > 0 && docYoungPay > 0) {
            var share = (docYoungPay / teamPay2) * 100;
            if (share < limits.doctoral_young_min_pct) {
              errors.push({
                categoryId: 'doctoral_young',
                rule: 'doctoral_young_min_pct',
                message: 'Дял на докторанти/млади учени: ' + share.toFixed(1) + '% под минимум ' + limits.doctoral_young_min_pct + '% от възнагражденията.'
              });
            }
          }
        }

        // External team max share
        if (limits.external_team_max_pct) {
          var teamPay3 = amountByCat['team_remuneration'] || 0;
          var extPay = amountByCat['external_team'] || 0;
          if (teamPay3 > 0 && extPay > 0) {
            var shareExt = (extPay / teamPay3) * 100;
            if (shareExt > limits.external_team_max_pct) {
              errors.push({
                categoryId: 'external_team',
                rule: 'external_team_max_pct',
                message: 'Дял на външни членове: ' + shareExt.toFixed(1) + '% надвишава максимум ' + limits.external_team_max_pct + '% от възнагражденията.'
              });
            }
          }
        }

        // ── НПФ validations ──
        if (limits.visual_identity_pct)     _chkPct('visual_identity', 'visual_identity_pct', limits.visual_identity_pct, 'Визуална идентичност');
        if (limits.event_portfolio_pct)      _chkPct('event_portfolio', 'event_portfolio_pct', limits.event_portfolio_pct, 'Портфолио на събитието');
        if (limits.technical_services_pct)   _chkPct('technical_services', 'technical_services_pct', limits.technical_services_pct, 'Техническо обслужване');
        // ── НПФ: proceedings publication check ──
        if (limits.proceedings_print_pct)    _chkPct('proceedings_print', 'proceedings_print_pct', limits.proceedings_print_pct, 'Публикуване на сборник (печат)');
        if (limits.proceedings_digital_pct)  _chkPct('proceedings_digital', 'proceedings_digital_pct', limits.proceedings_digital_pct, 'Публикуване на сборник (дигитален)');
        // ── НПФ: dissemination check ──
        if (limits.dissemination_pct)        _chkPct('dissemination', 'dissemination_pct', limits.dissemination_pct, 'Разпространение/реклама');

        // ── НПФ: guest lecturer limit ──
        if (limits.guest_lecturer_max_eur) {
          var guestAmt = amountByCat['guest_lecturer'] || 0;
          if (guestAmt > 0 && guestAmt > limits.guest_lecturer_max_eur) {
            errors.push({
              categoryId: 'guest_lecturer',
              rule: 'guest_lecturer_max_eur',
              message: 'Хонорар за външен лектор: ' + guestAmt.toFixed(0) + ' € надвишава максимум ' + limits.guest_lecturer_max_eur + ' €.'
            });
          }
        }

        // ── НПФ: DOI & metadata fees ──
        if (limits.doi_per_unit_eur) {
          var doiAmt = amountByCat['doi_fees'] || 0;
          if (doiAmt > 0) {
            var maxDoiEur = 0;
            // DOI fee structure: 1 €/DOI + sliding scale surcharge (in EUR)
            var doiCount = Number(opts && opts.doiCount) || 0;
            var doiBase = doiCount * limits.doi_per_unit_eur;
            var doiSurcharge = 0;
            if (doiCount > 0 && doiCount <= 20) doiSurcharge = 10;
            else if (doiCount <= 40) doiSurcharge = 26;
            else if (doiCount <= 60) doiSurcharge = 41;
            else if (doiCount > 60) doiSurcharge = 77;
            maxDoiEur = doiBase + doiSurcharge;
            if (doiAmt > maxDoiEur + 0.01) {
              errors.push({
                categoryId: 'doi_fees',
                rule: 'doi_per_unit_eur',
                message: 'Таксите за DOI надвишават лимита (' + doiAmt.toFixed(0) + ' € > ' + maxDoiEur.toFixed(0) + ' €).'
              });
            }
          }
        }
        if (limits.metadata_db_eur) {
          var metaAmt = amountByCat['metadata_db_fees'] || 0;
          if (metaAmt > 0) {
            var dbCount = Number(opts && opts.metadataDbCount) || 0;
            var bposPortions = Number(opts && opts.bposPortions) || 0;
            var maxMetaEur = dbCount * limits.metadata_db_eur + bposPortions * (limits.metadata_bpos_eur || 26);
            if (metaAmt > maxMetaEur + 0.01) {
              errors.push({
                categoryId: 'metadata_db_fees',
                rule: 'metadata_db_eur',
                message: 'Таксите за метаданни надвишават лимита (' + metaAmt.toFixed(0) + ' € > ' + maxMetaEur.toFixed(0) + ' €).'
              });
            }
          }
        }

        // ── Event portfolio per-participant limit for НПФ ──
        if (limits.event_portfolio_max_eur_per_person) {
          var epAmt = amountByCat['event_portfolio'] || 0;
          var participants = Number(opts && opts.participants) || 0;
          if (epAmt > 0 && participants > 0) {
            var maxEpEur = limits.event_portfolio_max_eur_per_person * participants;
            if (epAmt > maxEpEur + 0.01) {
              errors.push({
                categoryId: 'event_portfolio',
                rule: 'event_portfolio_max_eur_per_person',
                message: 'Портфолио на събитието надвишава лимита от ' + limits.event_portfolio_max_eur_per_person + ' €/участник (' + (epAmt / participants).toFixed(0) + ' €/участник).'
              });
            }
          }
        }

        // ── ДНП: no team remuneration ──
        if (limits.no_team_remuneration) {
          var tpDNP = amountByCat['team_remuneration'] || 0;
          if (tpDNP > 0) {
            errors.push({
              categoryId: 'team_remuneration',
              rule: 'no_team_remuneration',
              message: 'ДНП проектите не допускат възнаграждения на екип.'
            });
          }
        }

        return { ok: errors.length === 0, errors: errors };
      }

      /**
       * Validate a reviewer budget line against the max fee for the project type.
       * @param {string} projectType
       * @param {string} categoryId — 'project_reviewer', 'monograph_reviewer', 'annual_report_reviewer', 'forum_reviewer'
       * @param {number} amount — in the project's currency
       * @returns {{ ok: boolean, maxAmount: number, currency: string, error: string }}
       */
      function _validateReviewerBudgetLine_(projectType, categoryId, amount) {
        var rules = PROJECT_TYPE_RULES[String(projectType || '').toUpperCase()];
        if (!rules) return { ok: true, maxAmount: null, currency: 'EUR', error: '' };
        var amt = Number(amount || 0);
        var maxAmt, currency;

        switch (String(categoryId || '')) {
          case 'project_reviewer':
            maxAmt = rules.reviewerFeeEUR;
            currency = 'EUR';
            break;
          case 'monograph_reviewer':
            maxAmt = rules.monographReviewerFeeEUR;
            currency = 'EUR';
            break;
          case 'annual_report_reviewer':
            maxAmt = rules.annualReportReviewerFeeEUR;
            currency = 'EUR';
            break;
          case 'forum_reviewer':
            maxAmt = rules.reviewerFeeEUR;
            currency = 'EUR';
            break;
          default:
            return { ok: true, maxAmount: null, currency: 'EUR', error: '' };
        }

        if (maxAmt && amt > maxAmt) {
          return {
            ok: false,
            maxAmount: maxAmt,
            currency: currency,
            error: 'Хонорарът за рецензент (' + amt.toFixed(0) + ' ' + currency + ') надвишава максимума ' + maxAmt + ' ' + currency + ' за ' + rules.label + '.'
          };
        }
        return { ok: true, maxAmount: maxAmt, currency: currency, error: '' };
      }

      /**
       * Validate that the first month (M1 = December for ФНИ/ПНИ) has no planned expenses.
       * @param {string} projectType
       * @param {Array} monthlyBreakdown — [{ month: 1, amount: X }, ...]
       * @returns {{ ok: boolean, error: string }}
       */
      function _validateFirstMonthNoExpenses_(projectType, monthlyBreakdown) {
        var rules = PROJECT_TYPE_RULES[String(projectType || '').toUpperCase()];
        if (!rules || !rules.noExpensesFirstMonth) return { ok: true, error: '' };
        var m1 = (monthlyBreakdown || []).find(function(m) { return Number(m.month) === 1; });
        if (m1 && Number(m1.amount || 0) > 0) {
          return { ok: false, error: 'За ' + rules.label + ' не се допускат разходи през първия месец (M1/Декември). Моля, премахнете разходите за M1.' };
        }
        return { ok: true, error: '' };
      }

      /**
       * Validate TRL (Technology Readiness Level) for ПНИ projects.
       * @param {string} projectType
       * @param {number} trlLevel
       * @returns {{ ok: boolean, error: string }}
       */
      function _validateTRLRequirement_(projectType, trlLevel) {
        var rules = PROJECT_TYPE_RULES[String(projectType || '').toUpperCase()];
        if (!rules || !rules.requiresTRL) return { ok: true, error: '' };
        if (!trlLevel || Number(trlLevel) < 4) {
          return { ok: false, error: 'За ПНИ проекти се изисква TRL ниво ≥ 4. Моля, посочете ниво на технологична готовност.' };
        }
        return { ok: true, error: '' };
      }

      // ═══════════════════════════════════════════════════════════════════
      //  v6.8.0 — SELF-ASSESSMENT MODULE
      //  Stores and calculates self-assessment scores for proposals.
      // ═══════════════════════════════════════════════════════════════════

      /**
       * Self-assessment scoring weights by project type.
       * Maximum 100 points for all types. Threshold: 50% + 1 = 51 points.
       */
      var SELF_ASSESSMENT_SCHEMA = {
        'ФНИ': {
          maxPoints: 100,
          thresholdPct: 50,
          thresholdPoints: 51,
          categories: [
            { id: 'publications', label: 'Публикации (Scopus/WoS)', maxPoints: 30 },
            { id: 'habilitated', label: 'Хабилитирани лица в екипа', maxPoints: 20 },
            { id: 'prior_projects', label: 'Участия в предходни проекти', maxPoints: 15 },
            { id: 'expertise', label: 'Експертиза и квалификация', maxPoints: 15 },
            { id: 'priority_match', label: 'Съответствие с приоритети', maxPoints: 10 },
            { id: 'international', label: 'Международно сътрудничество', maxPoints: 10 }
          ]
        },
        'ПНИ': {
          maxPoints: 100,
          thresholdPct: 50,
          thresholdPoints: 51,
          categories: [
            { id: 'publications_patents', label: 'Публикации и патенти', maxPoints: 25 },
            { id: 'habilitated', label: 'Хабилитирани лица', maxPoints: 15 },
            { id: 'prior_projects', label: 'Участия в проекти', maxPoints: 15 },
            { id: 'expertise', label: 'Експертиза', maxPoints: 10 },
            { id: 'market_trl', label: 'Пазарна привлекателност / TRL', maxPoints: 15 },
            { id: 'support_letters', label: 'Писма за подкрепа', maxPoints: 10 },
            { id: 'priority_match', label: 'Съответствие с приоритети', maxPoints: 10 }
          ]
        },
        'ДНП': {
          maxPoints: 100,
          thresholdPct: 50,
          thresholdPoints: 51,
          categories: [
            { id: 'doctorant_publications', label: 'Публикации на докторанта', maxPoints: 25 },
            { id: 'prior_projects', label: 'Участие в проекти', maxPoints: 20 },
            { id: 'supervisor', label: 'Научен ръководител (хабилитиран)', maxPoints: 20 },
            { id: 'topic_match', label: 'Съответствие с темата', maxPoints: 15 },
            { id: 'expertise', label: 'Експертиза', maxPoints: 10 },
            { id: 'international', label: 'Международна активност', maxPoints: 10 }
          ]
        }
      };

      /**
       * Calculate self-assessment points server-side.
       * @param {string} projectType
       * @param {Object} scores — { categoryId: points, ... }
       * @returns {{ totalPoints: number, maxPoints: number, thresholdMet: boolean, thresholdPoints: number, breakdown: Array }}
       */
      function _calculateSelfAssessmentPoints_(projectType, scores) {
        var schema = SELF_ASSESSMENT_SCHEMA[String(projectType || '').toUpperCase()];
        if (!schema) return { totalPoints: 0, maxPoints: 0, thresholdMet: false, thresholdPoints: 0, breakdown: [], error: 'Непознат тип проект: ' + projectType };
        var total = 0;
        var breakdown = [];
        schema.categories.forEach(function(cat) {
          var pts = Math.min(Number(scores && scores[cat.id]) || 0, cat.maxPoints);
          total += pts;
          breakdown.push({ id: cat.id, label: cat.label, awarded: pts, max: cat.maxPoints });
        });
        return {
          totalPoints: Math.min(total, schema.maxPoints),
          maxPoints: schema.maxPoints,
          thresholdPoints: schema.thresholdPoints,
          thresholdMet: total >= schema.thresholdPoints,
          breakdown: breakdown
        };
      }

      /**
       * Store self-assessment in the SelfAssessments sheet.
       * @param {Object} body — { proposalId, projectType, scores, applicantEmail }
       * @returns {{ success: boolean, id: string, result: Object }}
       */
      function saveSelfAssessment(body) {
        try {
          var proposalId = String(body.proposalId || '').trim();
          var projectType = String(body.projectType || '').trim();
          var applicantEmail = String(body.applicantEmail || '').trim();
          var scores = body.scores || {};

          if (!proposalId || !projectType || !applicantEmail) {
            return { success: false, error: 'Липсват задължителни полета (proposalId, projectType, applicantEmail).' };
          }

          var result = _calculateSelfAssessmentPoints_(projectType, scores);
          if (result.error) return { success: false, error: result.error };

          var ss = _getOrCreateSheet_('SelfAssessments',
            ['id', 'proposalId', 'applicantEmail', 'projectType', 'data', 'totalPoints', 'maxPoints', 'thresholdMet', 'submittedAt']
          );
          var id = _uuid_();

          ss.appendRow([
            id,
            proposalId,
            applicantEmail,
            projectType,
            JSON.stringify(scores),
            result.totalPoints,
            result.maxPoints,
            result.thresholdMet ? 'YES' : 'NO',
            new Date().toISOString()
          ]);

          try { logTransaction('SAVE_SELF_ASSESSMENT', applicantEmail, proposalId, { totalPoints: result.totalPoints, thresholdMet: result.thresholdMet }); } catch (_) {}

          return { success: true, id: id, result: result };
        } catch (err) {
          try { logError('saveSelfAssessment', err, body); } catch (_) {}
          return { success: false, error: 'saveSelfAssessment failed: ' + err.message };
        }
      }

      /**
       * Retrieve self-assessment for a proposal.
       * @param {Object} body — { proposalId }
       * @returns {{ success: boolean, assessment: Object|null }}
       */
      function getSelfAssessment(body) {
        try {
