          }

          safeSetRow_(sheet, rowIndex, newRow, Math.max(TOTAL_COLS, newRow.length, EXPECTED_HEADERS.length));
          applyRowColor(sheet, rowIndex, newStatus);

          // Notify applicant about status change
          var applicantEmail = String(rowData[COL.USER_EMAIL - 1] || '').toLowerCase().trim();
          var applicantName  = String(rowData[COL.USER_NAME - 1] || '');
          var formTitle      = String(rowData[COL.TITLE - 1] || '');
          var oldStatus      = String(rowData[COL.STATUS - 1] || '');
          var emailSent = false;
          try { emailSent = !!notifyStatusChange_(applicantEmail, applicantName, body.id, formTitle, oldStatus, newStatus, body.comment || ''); } catch (mailErr) {
            console.error('updateStatus email notification failed: ' + mailErr.message);
            try { logError('updateStatus_notify', mailErr, { email: applicantEmail, formId: body.id, newStatus: newStatus }); } catch (_) {}
          }

          // ── Auto-activation: when contract is fully executed, materialize an active Project
          //    with seeded financial markers (planned/committed/spent per cost group). ──
          var autoProjectId = null;
          if (newStatus === 'contracted') {
            try {
              var autoRes = createProject({
                applicationId: body.id,
                userId: userId,
                isAdmin: true,
                role: auth.role,
                sessionToken: body.sessionToken,
                userName: actor,
                _autoTriggered: true
