      /**
       * Copies every file from the project-type template folder into the
       * candidate's project folder. Idempotent — files already copied are skipped.
       * Structure:  CANDIDATE_DOCS_STORAGE_ID / {competitionName} / {formId} /
       *
       * Body: { formId, projectType, competitionName? }
       * Returns: { success, files:[{id,name,mimeType,editUrl,previewUrl}], folderId }
       */
      function copyTypeTemplatesForForm(body) {
        body = body || {};
        var auth = resolveAuthContext(body);
        if (!auth.userId) return { success: false, error: 'Необходима е автентикация' };

        var formId = String(body.formId || '').trim();
        if (!formId || formId.length > 64 || !/^[a-zA-Z0-9_\-]+$/.test(formId)) {
          return { success: false, error: 'Невалиден идентификатор на заявление.' };
        }

        var sheet = getSheet();
        var found = findRowByID(sheet, formId);
        if (!found) return { success: false, error: 'Заявлението не е намерено' };
        var row = found.rowData;

        var ownerEmail = String(row[COL.USER_EMAIL - 1] || '').toLowerCase().trim();
        if (!auth.isAdmin && auth.userId && ownerEmail &&
            auth.userId.toLowerCase().trim() !== ownerEmail) {
          return { success: false, error: 'Нямате права за това заявление.' };
        }

        var projectType = String(body.projectType || row[COL.PROJECT_CODE - 1] || '').toUpperCase().trim();
        if (!projectType || projectType === 'TBD') {
          return { success: false, error: 'Изберете тип проект преди да продължите.' };
        }

        var userEmail = ownerEmail || auth.userId;
        var competitionName = String(body.competitionName || row[COL.COMPETITION - 1] || 'Конкурсна сесия 2026').trim();

        // ── Fast path: result already cached (same formId + type) ──────────────
        // v2 suffix: invalidates entries from before setSecureSharing_ was restored.
        var _resCacheKey = 'CTF_R2_' + formId + '_' + projectType;
        try {
          var _resCached = _scriptCache_().get(_resCacheKey);
          if (_resCached) {
            var _resParsed = JSON.parse(_resCached);
            if (_resParsed && _resParsed.files && _resParsed.files.length) {
              return { success: true, files: _resParsed.files,
                       folderName: _resParsed.folderName, folderId: _resParsed.folderId,
                       _cached: true };
            }
          }
        } catch (_) {}

        var typeFolderIds = _getTemplateFolderIds_();
        var typeFolderId = typeFolderIds[projectType];
        if (!typeFolderId) return { success: false, error: 'Няма шаблонна папка за тип ' + projectType };

        var targetFolder = getOrCreateCandidateProjectFolder_(formId, competitionName, userEmail);
        if (!targetFolder) return { success: false, error: 'Неуспешно създаване на папка за проекта.' };

        // ── Load source-folder file list (cached 6 h) ───────────────────────────
        var _tplCacheKey = 'CTF_T_' + projectType;
        var tplFiles = null;
        try {
          var _tplRaw = _scriptCache_().get(_tplCacheKey);
          if (_tplRaw) tplFiles = JSON.parse(_tplRaw);
        } catch (_) {}
        if (!tplFiles || !tplFiles.length) {
          tplFiles = [];
          try {
            var typeFolder = DriveApp.getFolderById(typeFolderId);
            var _fi = typeFolder.getFiles();
            while (_fi.hasNext()) {
              var _sf = _fi.next();
              tplFiles.push({ id: _sf.getId(), name: _sf.getName(), mime: _sf.getMimeType() });
            }
            if (tplFiles.length) {
              try { _scriptCache_().put(_tplCacheKey, JSON.stringify(tplFiles), 21600); } catch (_) {}
            }
          } catch (e) {
            return { success: false, error: 'Грешка при достъп до шаблонната папка: ' + e.message };
          }
        }
        if (!tplFiles.length) return { success: false, error: 'Шаблонната папка за ' + projectType + ' е празна.' };

        // ── Build index of already-copied files (by name) ────────────────────────
        var existingByName = {};
        try {
          var _ei = targetFolder.getFiles();
          while (_ei.hasNext()) {
            var _ef = _ei.next();
            existingByName[_ef.getName()] = { id: _ef.getId(), mime: _ef.getMimeType() };
          }
        } catch (_) {}

        // ── Copy missing files; reuse existing ones ──────────────────────────────
        var copiedFiles = [];
        try {
          for (var fi = 0; fi < tplFiles.length; fi++) {
            var tpl = tplFiles[fi];
            var cId, cMime = tpl.mime;
            if (existingByName[tpl.name]) {
              // Already copied — reuse
              cId   = existingByName[tpl.name].id;
              cMime = existingByName[tpl.name].mime || tpl.mime;
            } else {
              // Make a copy. Drive files do NOT inherit parent-folder sharing,
              // so we must explicitly share each new copy and grant editor access.
              var newCopy = DriveApp.getFileById(tpl.id).makeCopy(tpl.name, targetFolder);
              cId = newCopy.getId();
              try { shareGeneratedFile_(newCopy); } catch (_) {}  // ANYONE_WITH_LINK + admin viewers
              try { _addEditorSilently_(newCopy, userEmail); } catch (_) {}
            }
            // Build edit/preview URLs from ID + mime (no extra API calls)
            var editUrl = '', previewUrl = 'https://drive.google.com/file/d/' + cId + '/preview';
            if (cMime === 'application/vnd.google-apps.document') {
              editUrl    = 'https://docs.google.com/document/d/'     + cId + '/edit';
              previewUrl = 'https://docs.google.com/document/d/'     + cId + '/preview';
            } else if (cMime === 'application/vnd.google-apps.spreadsheet') {
              editUrl    = 'https://docs.google.com/spreadsheets/d/' + cId + '/edit';
              previewUrl = 'https://docs.google.com/spreadsheets/d/' + cId + '/preview';
            } else if (cMime === 'application/vnd.google-apps.presentation') {
              editUrl    = 'https://docs.google.com/presentation/d/' + cId + '/edit';
              previewUrl = 'https://docs.google.com/presentation/d/' + cId + '/preview';
            } else {
              editUrl = 'https://drive.google.com/file/d/' + cId + '/view';
            }
            copiedFiles.push({ id: cId, name: tpl.name, mimeType: cMime,
                               editUrl: editUrl, previewUrl: previewUrl,
                               srcId: tpl.id, folderName: competitionName + '/' + formId });
          }
        } catch (err) {
          return { success: false, error: 'Грешка при копиране на шаблони: ' + err.message };
        }

        var result = { success: true, files: copiedFiles,
                       folderName: competitionName + '/' + formId,
                       folderId: targetFolder.getId() };

        // ── Cache result for 1 h (subsequent calls are instant) ──────────────────
        if (copiedFiles.length) {
          try {
            _scriptCache_().put(_resCacheKey,
              JSON.stringify({ files: copiedFiles, folderName: result.folderName, folderId: result.folderId }),
              3600);
          } catch (_) {}
        }
        return result;
      }

      /**
       * Copies every file inside the per-form app folder into a dated
       * submission subfolder under the applicant's session folder so the
       * applicant retains an independent, permanent copy of all attached
       * files after submitting.  Called by submitForm.
       * @param {string} formId     The form's ID (app-folder key).
       * @param {string} userEmail  Applicant email (session-folder owner).
       * @return {boolean}          True if at least one file was copied.
       */
      function _copyAppFilesToSessionFolder_(formId, userEmail) {
        try {
          var appFolder = getOrCreateAppFolder(formId);
          if (!appFolder) return false;
          // v10.2.0-restructure: use root-level per-form session folder
          var formSessionFolder = getOrCreateFormSessionFolder_(formId, userEmail);
          if (!formSessionFolder) return false;
          // Create a dated submission subfolder to avoid name collisions
          // when the same form is resubmitted after corrections.
          var dateStr = new Date().toISOString().slice(0, 10);
          var subName = 'Подаване ' + String(formId).trim() + ' - ' + dateStr;
          var subfolder;
          try {
            var existing = formSessionFolder.getFoldersByName(subName);
            if (existing.hasNext()) { subfolder = existing.next(); }
            else { subfolder = formSessionFolder.createFolder(subName); }
          } catch (_) {
            subfolder = formSessionFolder.createFolder(subName);
          }
          if (!subfolder) return false;
          // Grant the applicant editor access on the submission folder.
          // _addEditorSilently_ suppresses the automated Drive notification email.
          try { _addEditorSilently_(subfolder, userEmail); } catch (_) {}
          // Copy every file from the app folder into the submission folder.
          var files = appFolder.getFiles();
          var count = 0;
          while (files.hasNext()) {
            var file = files.next();
            try {
              file.makeCopy(file.getName(), subfolder);
              count++;
            } catch (_) {}
          }
          return count > 0;
        } catch (_) {
          return false;
        }
      }

      function saveFilesToDrive(files, formId, ownerEmail) {
        if (!Array.isArray(files) || !formId || files.length === 0) return [];
        var appFolder = getOrCreateAppFolder(formId);
        var saved = [];
        for (var i = 0; i < files.length; i++) {
          var f = files[i];
          try {
            if (!f || !f.data) continue;
            var comma = f.data.indexOf(',');
            if (comma === -1) continue;
            var bytes     = Utilities.base64Decode(f.data.slice(comma + 1));
            var blob      = Utilities.newBlob(bytes, f.type || 'application/octet-stream', f.name || 'file_' + i);
            var driveFile = appFolder.createFile(blob);
            // Tighten sharing: prefer DOMAIN_WITH_LINK so only ue-varna.bg accounts
            // can resolve the file even if the ID leaks. Falls back gracefully.
            setSecureSharing_(driveFile);
            // Grant editor access to the applicant so they can edit the file
            if (ownerEmail) { try { _addEditorSilently_(driveFile, ownerEmail); } catch (_) {} }
            var newFileId = driveFile.getId();
            // NOTE: do NOT persist a downloadUrl in the sheet for application
            // uploads. sanitizeFileRecordsForCaller_() decides per-request whether
            // to surface a download link based on caller role + folder allowlist.
            saved.push({
              fileId     : newFileId,
              name       : f.name || 'file_' + i,
              size       : f.size || Math.round(bytes.length / 1024) + ' KB',
              type       : f.type || 'application/octet-stream',
              previewLink: 'https://drive.google.com/file/d/' + newFileId + '/preview?rm=minimal',
              created    : nowISO()
            });
          } catch (err) {
            console.error('Upload error [' + (f ? f.name : '?') + ']: ' + err.message);
          }
        }
        return saved;
      }

      function saveSignatureToDrive(appFolder, base64Data, label) {
        if (!base64Data || !base64Data.trim()) return null;
        try {
          var comma = base64Data.indexOf(',');
          var bytes = Utilities.base64Decode(comma !== -1 ? base64Data.slice(comma + 1) : base64Data);
          var blob  = Utilities.newBlob(bytes, 'image/png', label + '.png');
          var file  = appFolder.createFile(blob);
          setSecureSharing_(file);
          return file.getId();
        } catch (e) {
          console.error('saveSignatureToDrive [' + label + ']: ' + e.message);
          return null;
        }
      }

      function copyDocToAppFolder(appFolder, docId, docName) {
        try {
          var existing = appFolder.getFilesByName(docName);
          if (existing.hasNext()) return;
          var original = DriveApp.getFileById(docId);
          var copy = original.makeCopy(docName, appFolder);
          // v9.46.1-mydocs-enhance: tag for provenance in MyDocumentsView
          try {
            copy.setDescription('TEMPLATE_SOURCE=' + docId + '|TEMPLATE_NAME=' + original.getName() + '|ORIGIN=attached');
          } catch (_) {}
        } catch (e) {
          console.warn('copyDocToAppFolder [' + docName + ']: ' + e.message);
        }
      }

      /**
       * Ensures every document in attachedDocs is a COPY inside the app folder,
       * not a reference to the shared library. Library-origin IDs are replaced
       * with the local copy's ID so each applicant owns their own instance.
       * @param {string} formId       Form ID (app-folder key).
       * @param {Array}  attachedDocs Current attachedDocs array.
       * @return {Array} New attachedDocs array with library IDs resolved to copies.
       */
      // ── Per-execution cache for _resolveAttachedDocsCopies_ ─────────
      // Avoids redundant Drive API calls when the same form+docs are resolved
      // multiple times within one GAS execution (e.g. updateForm fast-path
      // followed by submitForm). Keyed by formId + sorted doc IDs.
      // v12.30.1-perf: Introduced to eliminate N Drive API calls per save.
      var _resolveDocsMemo_ = null;
      function _resolveDocsCacheKey_(formId, attachedDocs) {
        var ids = (attachedDocs || []).map(function(d){ return String(d.id||''); }).sort().join(',');
        return formId + '::' + ids;
      }
      function _cachedResolveAttachedDocs_(formId, attachedDocs, ownerEmail) {
        var key = _resolveDocsCacheKey_(formId, attachedDocs);
        if (_resolveDocsMemo_ && _resolveDocsMemo_.key === key) return _resolveDocsMemo_.result;
        var result = _resolveAttachedDocsCopies_(formId, attachedDocs, ownerEmail);
        _resolveDocsMemo_ = { key: key, result: result };
        return result;
      }

      /**
       * Ensures every document in attachedDocs is a COPY inside the app folder,
       * not a reference to the shared library. Library-origin IDs are replaced
       * with the local copy's ID so each applicant owns their own instance.
       * Uses per-execution memoization to avoid redundant Drive API calls.
       * @param {string} formId       Form ID (app-folder key).
       * @param {Array}  attachedDocs Current attachedDocs array.
       * @return {Array} New attachedDocs array with library IDs resolved to copies.
       */
      function _resolveAttachedDocsCopies_(formId, attachedDocs, ownerEmail) {
        if (!Array.isArray(attachedDocs) || !attachedDocs.length) return attachedDocs || [];
        var appFolder = getOrCreateAppFolder(formId);
        if (!appFolder) return attachedDocs;
        var resolved = [];
        // v12.30.1-perf: Pre-resolve app folder ID once (avoids getParents() loop per doc)
        var appFolderId = appFolder.getId();
        for (var i = 0; i < attachedDocs.length; i++) {
          var d = attachedDocs[i];
          if (!d || !d.id) { resolved.push(d); continue; }
          var docId = sanitizeFileId_(String(d.id));
          if (!docId) { resolved.push(d); continue; }
          // v12.30.1-perf: Quick ID pattern check — if the doc ID looks like an
          // app-folder copy (long alphanumeric Google Drive ID), skip the expensive
          // Drive parent-chain walk. Only do the full check for short/known IDs.
          var _isLongId = docId.length >= 25 && !/^(s_|doc_|up_|f_|copied_)/.test(docId);
          // v9.43.0: short-circuit — generated docs (explicit flag or matching
          // the <docType>_<formId8> name pattern) are already in the app folder.
          // Skips the costly Drive parent-check and restores _generated:true
          // if it was stripped by older autosave paths.
          var _nlc  = String(d.name || '').toLowerCase().replace(/\.docx$/i, '');
          var _sfid = formId.substring(0, 8).toLowerCase();
          var _GTYPES = ['fniteam','fnisections35','cvtemplate','pniteam','pnisections35',
                         'dnpachievements','dnpsections35','npfform'];
          if (d._generated || _GTYPES.some(function(dt){ return _nlc === dt + '_' + _sfid; })) {
            resolved.push(Object.assign({}, d, { _generated: true }));
            continue;
          }
          // If this file already lives inside the app folder, keep it as-is.
          // v12.30.1-perf: Skip Drive parent-check for long IDs (likely already in app folder).
          // Only do the full Drive ancestry check for short or prefixed IDs.
          if (_isLongId) {
            // Assume long IDs are already Drive copies in the app folder.
            // If they weren't, submitForm's _resolveAttachedDocsCopies_ will fix it.
            resolved.push(d);
            continue;
          }
          try {
            var file = DriveApp.getFileById(docId);
            var parents = file.getParents();
            var alreadyInApp = false;
            while (parents.hasNext()) {
              if (parents.next().getId() === appFolderId) { alreadyInApp = true; break; }
            }
            if (alreadyInApp) { resolved.push(d); continue; }
          } catch (_) { /* file may be inaccessible — fall through to copy */ }
          // Check if we already have a copy in the app folder by name.
          var docName = String(d.name || 'Документ').trim();
          try {
            var existing = appFolder.getFilesByName(docName);
            if (existing.hasNext()) {
              var ef = existing.next();
              var efMime = ef.getMimeType();
              var efId = ef.getId();
              var efLinks = buildSecureFileLinks_(efId, { allowDownload: true, mimeType: efMime });
              var efEditLink = '';
              if (efMime === 'application/vnd.google-apps.document') {
                efEditLink = 'https://docs.google.com/document/d/' + efId + '/edit';
              } else if (efMime === 'application/vnd.google-apps.spreadsheet') {
                efEditLink = 'https://docs.google.com/spreadsheets/d/' + efId + '/edit';
              }
              // Grant editor access to the owner if not already granted
              if (ownerEmail) { try { _addEditorSilently_(ef, ownerEmail); } catch (_) {} }
              resolved.push(Object.assign({}, d, {
                id: efId, driveId: efId, name: ef.getName(), mimeType: efMime,
                previewLink: efLinks.previewLink, downloadUrl: efLinks.downloadUrl,
                googleDocEditLink: efEditLink
              }));
              continue;
            }
          } catch (_) {}
          // Make a copy in the app folder.
          // v9.44.0-timeout-fix: skip if we are close to the GAS 30-second hard
          // limit to prevent "Заявката отне твърде дълго" on multi-doc saves.
          // Keep the original reference so the attachment is never silently lost.
          if (_checkDeadline_('_resolveAttachedDocsCopies_')) {
            console.warn('_resolveAttachedDocsCopies_: deadline budget exhausted — keeping original ref for ' + docId);
            resolved.push(d);
            continue;
          }
          try {
            var original = DriveApp.getFileById(docId);
            var copy = original.makeCopy(docName, appFolder);
            // v12.30.1-fix: Use shareGeneratedFile_ instead of setSecureSharing_ alone
            // so admin viewers are also added (prevents "file does not exist" for admins)
            shareGeneratedFile_(copy);
            // Grant editor access to the applicant
            if (ownerEmail) { try { _addEditorSilently_(copy, ownerEmail); } catch (_) {} }
            var copyMime = copy.getMimeType();
            var cid = copy.getId();
            var clinks = buildSecureFileLinks_(cid, { allowDownload: true, mimeType: copyMime });
            var ceditLink = '';
            if (copyMime === 'application/vnd.google-apps.document') {
              ceditLink = 'https://docs.google.com/document/d/' + cid + '/edit';
            } else if (copyMime === 'application/vnd.google-apps.spreadsheet') {
              ceditLink = 'https://docs.google.com/spreadsheets/d/' + cid + '/edit';
            }
            // Preserve all original fields plus the new copy's Drive metadata
            resolved.push(Object.assign({}, d, {
              id: cid, driveId: cid, name: copy.getName(), mimeType: copyMime,
              previewLink: clinks.previewLink, downloadUrl: clinks.downloadUrl,
              googleDocEditLink: ceditLink
            }));
          } catch (copyErr) {
            console.warn('_resolveAttachedDocsCopies_: copy failed for ' + docId + ': ' + copyErr.message);
            resolved.push(d);
          }
        }
        return resolved;
      }

      // ============================================================
      //  ADMIN ASSETS — system-wide attachment & Drive enumeration
      //  Surfaces every file the system knows about (per-application
      //  uploads, attached library docs, signatures stored in Drive,
      //  and contents of the root upload + library folders) in a
      //  single admin-only call. Used by the "Активи" admin tab.
      // ============================================================

      /** Flat list of every attachment referenced from the Applications sheet. */
      function listAllAttachments(body) {
        body = body || {};
        var auth = resolveAuthContext(body);
        if (!auth.isAdmin) return { success: false, error: 'Admin access required.' };

        var sc = null, cacheKey = '';
        try {
          sc = _scriptCache_();
          var dv = getDataVersions_();
          cacheKey = 'allatt:v2:' + dv.applications;
          if (!body.forceRefresh) {
            var cached = sc.get(cacheKey);
            if (cached) {
              try { var p = JSON.parse(cached); if (p && p.success) { p.cached = true; return p; } } catch (_) {}
            }
          }
        } catch (_) {}

        try {
          // PERFORMANCE: instead of pulling all 30 columns (incl. ~50–500 KB
          // JSON blobs in EVALUATION/HISTORY/BUDGET/INDICATORS/WORK_PROGRAM/
          // CONTRACT_ID/SIGNATURE/SIGNATURE_ADMIN), read only the 9 columns
          // we actually surface. On a 200-row sheet this can drop the
          // attachment-listing read from ~30 MB to <500 KB.
          //
          // The 9 needed columns (ID, USER_EMAIL, USER_NAME, COMPETITION,
          // PROJECT_CODE, TITLE, STATUS, FILE_IDS, ATTACHED_DOCS) are not
          // contiguous — we issue 3 contiguous-range reads to balance call
          // count vs payload size.
          var sheet = getSheet();
          var lastRow = sheet.getLastRow();
          if (lastRow < 2) return { success: true, attachments: [], total: 0 };
          var n = lastRow - 1;
          // Slice 1: cols 1..6 (ID, USER_EMAIL, USER_NAME, COMPETITION, PROJECT_CODE, TITLE)
          var s1 = sheet.getRange(2, COL.ID, n, COL.TITLE - COL.ID + 1).getValues();
          // Slice 2: col 9 (STATUS) only
          var s2 = sheet.getRange(2, COL.STATUS, n, 1).getValues();
          // Slice 3: cols 12..13 (FILE_IDS, ATTACHED_DOCS)
          var s3 = sheet.getRange(2, COL.FILE_IDS, n, COL.ATTACHED_DOCS - COL.FILE_IDS + 1).getValues();

          var out = [];
          for (var i = 0; i < n; i++) {
            var formId = String(s1[i][0] || '').trim();
            if (!formId) continue;
            var ctx = {
              formId      : formId,
              owner       : String(s1[i][1] || ''),
              ownerName   : String(s1[i][2] || ''),
              title       : String(s1[i][5] || ''),
              status      : String(s2[i][0] || ''),
              competitionId: String(s1[i][3] || ''),
              projectCode : String(s1[i][4] || '')
            };
            var fileIds = safeParseJSON(s3[i][0], []);
            var attached = safeParseJSON(s3[i][1], []);
            for (var fi = 0; fi < fileIds.length; fi++) {
              var f = fileIds[fi] || {};
              var fid = f.id || f.fileId || '';
              out.push({
                source     : 'upload',
                fileId     : fid,
                name       : f.name || f.fileName || '',
                mimeType   : f.mimeType || f.mime || '',
                size       : f.size || '',
                sizeBytes  : Number(f.sizeBytes || 0),
                uploadedAt : f.uploadedAt || f.created || '',
                previewLink: f.previewLink || (fid ? 'https://drive.google.com/file/d/' + fid + '/preview?rm=minimal' : ''),
                downloadUrl: f.downloadUrl || (fid ? 'https://drive.google.com/uc?export=download&id=' + fid : ''),
                form       : ctx
              });
            }
            for (var ai = 0; ai < attached.length; ai++) {
              var a = attached[ai] || {};
              var aid = a.id || a.docId || '';
              out.push({
                source     : 'library',
                fileId     : aid,
                name       : a.name || a.title || '',
                mimeType   : a.mimeType || '',
                size       : a.size || '',
                sizeBytes  : Number(a.sizeBytes || 0),
                uploadedAt : a.attachedAt || a.added || '',
                previewLink: a.previewLink || (aid ? 'https://drive.google.com/file/d/' + aid + '/preview?rm=minimal' : ''),
                downloadUrl: a.downloadUrl || (aid ? 'https://drive.google.com/uc?export=download&id=' + aid : ''),
                form       : ctx
              });
            }
          }
          var result = { success: true, attachments: out, total: out.length };
          if (cacheKey && sc) {
            try { var json = JSON.stringify(result); if (json.length < 95000) sc.put(cacheKey, json, 3600); } catch (_) {}
          }
          return result;
        } catch (err) {
          return { success: false, error: 'listAllAttachments failed: ' + err.message, attachments: [] };
        }
      }

      /** Direct Drive enumeration of root upload + library folders (admin only). */
      function listDriveAssets(body) {
        body = body || {};
        var auth = resolveAuthContext(body);
        if (!auth.isAdmin) return { success: false, error: 'Admin access required.' };

        var sc = null, cacheKey = '';
        try {
          sc = _scriptCache_();
          var dv = getDataVersions_();
          cacheKey = 'driveassets:v1:' + dv.system;
          if (!body.forceRefresh) {
            var cached = sc.get(cacheKey);
            if (cached) {
              try { var p = JSON.parse(cached); if (p && p.success) { p.cached = true; return p; } } catch (_) {}
            }
          }
        } catch (_) {}

        try {
          var assets = [];
          var seen = {};
          // Library folder (recursive — typically small)
          try { _listDocsFast_(OFFICIAL_DOCS_FOLDER_ID, assets, seen, true); } catch (e) { console.warn('library scan: ' + e.message); }
          var libraryCount = assets.length;
          // Mark library entries
          for (var i = 0; i < libraryCount; i++) assets[i].zone = 'library';
          // Upload root (recursive but bounded — competitions / Applications / formId)
          var uploadStart = assets.length;
          try { _listDocsFast_(DRIVE_FOLDER_ID, assets, seen, true); } catch (e) { console.warn('upload scan: ' + e.message); }
          for (var u = uploadStart; u < assets.length; u++) assets[u].zone = 'uploads';

          var result = {
            success: true,
            assets: assets,
            total: assets.length,
            libraryTotal: libraryCount,
            uploadsTotal: assets.length - libraryCount
          };
          if (cacheKey && sc) {
            try { var json = JSON.stringify(result); if (json.length < 95000) sc.put(cacheKey, json, 3600); } catch (_) {}
          }
          return result;
        } catch (err) {
          return { success: false, error: 'listDriveAssets failed: ' + err.message, assets: [] };
        }
      }

      /** Unified one-shot endpoint: forms + sheet attachments + Drive scan + summary. */
      function adminAssets(body) {
        body = body || {};
        var auth = resolveAuthContext(body);
        if (!auth.isAdmin) return { success: false, error: 'Admin access required.' };

        var includeForms       = body.includeForms       !== false;
        var includeAttachments = body.includeAttachments !== false;
        var includeDrive       = body.includeDrive       !== false;
        var forceRefresh       = !!body.forceRefresh;

        // ── Unified cache key keyed on data versions + include flags ───────────
        // Avoids the 3 sub-call cache lookups on the hot path. The full unified
        // payload is typically <90 KB JSON for medium tenants — safe to cache.
        var sc = null, cacheKey = '';
        try {
          sc = _scriptCache_();
          var dv = getDataVersions_();
          cacheKey = 'adminassets:v2:' + dv.applications + ':' + dv.system +
            ':' + (includeForms?'F':'-') + (includeAttachments?'A':'-') + (includeDrive?'D':'-');
          if (!forceRefresh) {
            var cached = sc.get(cacheKey);
            if (cached) {
              try { var p = JSON.parse(cached); if (p && p.success) { p.cached = true; return p; } } catch (_) {}
            }
          }
        } catch (_) {}

        var subAuth = { userId: auth.userId, isAdmin: true, forceRefresh: forceRefresh };
        var formsRes  = includeForms       ? getForms(Object.assign({ lean: false, role: ROLE_ADMIN }, subAuth)) : { forms: [] };
        var attachRes = includeAttachments ? listAllAttachments(subAuth) : { attachments: [] };
        var driveRes  = includeDrive       ? listDriveAssets(subAuth)    : { assets: [] };

        var attachments = attachRes.attachments || [];
        var driveAssets = driveRes.assets || [];

        // Aggregate bytes from sheet attachments + drive list (deduped by id).
        // Map outperforms plain {} for large dedupe sets and avoids prototype
        // collisions on file IDs that look like reserved names (__proto__ etc.).
        var byteSeen = new Map();
        var bytesTotal = 0;
        for (var i = 0; i < attachments.length; i++) {
          var aId = attachments[i].fileId;
          if (aId && !byteSeen.has(aId)) { byteSeen.set(aId, 1); bytesTotal += Number(attachments[i].sizeBytes || 0); }
        }
        for (var j = 0; j < driveAssets.length; j++) {
          var dId = driveAssets[j].id;
          if (dId && !byteSeen.has(dId)) { byteSeen.set(dId, 1); bytesTotal += Number(driveAssets[j].sizeBytes || 0); }
        }

        var result = {
          success     : true,
          forms       : formsRes.forms || [],
          attachments : attachments,
          driveAssets : driveAssets,
          summary     : {
            forms       : (formsRes.forms || []).length,
            attachments : attachments.length,
            driveFiles  : driveAssets.length,
            uploads     : driveRes.uploadsTotal || 0,
            library     : driveRes.libraryTotal || 0,
            bytesTotal  : bytesTotal
          }
        };
        if (cacheKey && sc) {
          try { var json = JSON.stringify(result); if (json.length < 95000) sc.put(cacheKey, json, 3600); } catch (_) {}
        }
        return result;
      }

      // ============================================================
      //  COPY DOCUMENT – creates an editable copy in the app folder
      // ============================================================
      function copyDocument(body) {
        body = body || {};
        var auth = resolveAuthContext(body);
        if (!auth.userId) return { success: false, error: 'Необходима е автентикация' };

        var docId  = String(body.docId  || '').trim();
        var formId = String(body.formId || '').trim();
        if (!docId || !formId) return { success: false, error: 'Липсват необходими параметри (docId, formId)' };

        // v12.31.1-fix: recover the canonical Drive file ID if the client sent a
        // Docs/Sheets URL or a value with a /d/<ID>/ segment. Library docs can
        // arrive as full edit links; getFileById needs the bare ID. This
        // prevents "N документа не можаха да бъдат копирани" for such docs.
        if (docId.indexOf('/') !== -1 || docId.length > 60) {
          var _mId = docId.match(/\/d\/([A-Za-z0-9_-]{25,})/) || docId.match(/([A-Za-z0-9_-]{25,})/);
          if (_mId && _mId[1]) docId = _mId[1];
        }

        // ── Ownership check: only the form owner or an admin may copy ──
        var sheet = getSheet();
        var found = findRowByID(sheet, formId);
        if (!found) return { success: false, error: 'Заявлението не е намерено' };
        var ownerEmail = String(found.rowData[COL.USER_EMAIL - 1] || '').toLowerCase().trim();
        var caller     = String(auth.userId || '').toLowerCase().trim();
        if (!auth.isAdmin && ownerEmail && caller !== ownerEmail) {
          return { success: false, error: 'Нямате права да копирате документи в това заявление.' };
        }
        // v12.31.4-attachowner: an admin may attach on behalf of the applicant.
        // The Drive copy + all editor grants MUST be attributed to the target
        // form's owner, never the admin caller. The form row is authoritative;
        // body.ownerEmail (sent by the PHP replica / admin picker) is only an
        // override for edge cases where the row lookup is empty, and must match
        // the form owner when both are present. This keeps GAS + PHP in agreement.
        var bodyOwner = String(body.ownerEmail || '').toLowerCase().trim();
        if (!ownerEmail && bodyOwner) ownerEmail = bodyOwner;

        // NOTE (owner-doc mutation convention): unlike updateForm — which hard-
        // REJECTS isAdmin:true (admins are view-only there, v9.39.6) — copyDocument
        // itself allows admin callers for support scenarios. However, the frontend
        // MUST still send isAdmin:false for owner document flows, because the
        // follow-up updateForm call (attaching the copy to the form) rejects
        // admins and the flow would fail halfway otherwise.
        try {
          var appFolder = getOrCreateAppFolder(formId);
          // v12.30.2-defensive: verify the source file exists BEFORE copying so the
          // user gets a clear Bulgarian error instead of a dead Drive URL later.
          var original = null;
          try { original = DriveApp.getFileById(docId); }
          catch (eSrc) {
            return { success: false, error: 'Изходният файл не е намерен в Google Drive (възможно е да е изтрит или преместен). Моля, опреснете списъка с документи и опитайте отново.' };
          }
          var copyName  = original.getName();

          // Reuse existing copy if present
          var existing = appFolder.getFilesByName(copyName);
          var copy;
          if (existing.hasNext()) {
            copy = existing.next();
          } else {
            copy = original.makeCopy(copyName, appFolder);
          }

          var copyId   = copy.getId();
          var mimeType = copy.getMimeType();

          // v12.30.1-fix: Use shareGeneratedFile_ which calls BOTH setSecureSharing_
          // (ANYONE_WITH_LINK) AND _addAdminViewers_ (explicit admin grants).
          // Previously only setSecureSharing_ was called, so admins with non-ue-varna.bg
          // accounts got "file does not exist" when previewing attached documents.
          shareGeneratedFile_(copy);

          // Grant the applicant editor access so they can actually edit the copy
          try { _addEditorSilently_(copy, ownerEmail); } catch (_) {}

          var links = buildSecureFileLinks_(copyId, { allowDownload: true, mimeType: mimeType });
          var googleDocEditLink = '';
          if (mimeType === 'application/vnd.google-apps.document') {
            googleDocEditLink = 'https://docs.google.com/document/d/' + copyId + '/edit';
          } else if (mimeType === 'application/vnd.google-apps.spreadsheet') {
            googleDocEditLink = 'https://docs.google.com/spreadsheets/d/' + copyId + '/edit';
          }

          // ── v10.2.0-restructure: Also copy into the root-level competition
          //     session folder so the file is stored in:
          //     APPLICANT_DOCS_FOLDER_ID / Конкурсна сесия 2026 документи / {formId} /
          var myDocsFileInfo = null;
          try {
            var formSessionFolder = getOrCreateFormSessionFolder_(formId, ownerEmail);
            if (formSessionFolder) {
              var myCopyName = copy.getName();
              var myIdx = 1;
              // v12.26.0-perf: Cache getName() + regex match result to avoid duplicate DriveApp bridge calls
              var _myCopyBaseName = myCopyName.replace(/(\.[^.]+)$/, '');
              var _myCopyExt = myCopyName.match(/(\.[^.]+)$/);
              var _myCopyExtStr = _myCopyExt ? _myCopyExt[0] : '';
              while (formSessionFolder.getFilesByName(myCopyName).hasNext() && myIdx < 50) {
                myIdx++;
                myCopyName = _myCopyBaseName + ' (копие ' + myIdx + ')' + _myCopyExtStr;
              }
              var myCopy = original.makeCopy(myCopyName, formSessionFolder);
              try {
                myCopy.setDescription('TEMPLATE_SOURCE=' + docId + '|TEMPLATE_NAME=' + original.getName() + '|FORM_ID=' + formId + '|ORIGIN=copied');
              } catch (_) {}
              try { _addEditorSilently_(myCopy, ownerEmail); } catch (_) {}
              // v12.30.1-fix: Use shareGeneratedFile_ to also add admin viewers
              try { shareGeneratedFile_(myCopy); } catch (_) {}
              var myLinks = buildSecureFileLinks_(myCopy.getId(), { allowDownload: true, mimeType: myCopy.getMimeType() });
              myDocsFileInfo = {
                id: myCopy.getId(), driveId: myCopy.getId(), name: myCopy.getName(),
                mimeType: myCopy.getMimeType(), typeLabel: mimeTypeLabel(myCopy.getMimeType()),
                previewLink: myLinks.previewLink, webViewLink: myLinks.previewLink,
                downloadUrl: myLinks.downloadUrl,
                googleDocEditLink: myCopy.getMimeType() === 'application/vnd.google-apps.document' ? 'https://docs.google.com/document/d/' + myCopy.getId() + '/edit' : '',
                size: formatFileSize_(myCopy.getSize()), sizeBytes: Number(myCopy.getSize() || 0),
                folderName: SESSION_FOLDER_NAME + '/' + formId,
                formId: formId, origin: 'copied'
              };
            }
          } catch (_) { /* myDocs copy is best-effort */ }

          var result = {
            success: true,
            file: {
              id: copyId, driveId: copyId, name: copy.getName(), mimeType: mimeType,
              typeLabel: mimeTypeLabel(mimeType), previewLink: links.previewLink,
              webViewLink: links.previewLink, downloadUrl: links.downloadUrl,
              googleDocEditLink: googleDocEditLink, size: formatFileSize_(copy.getSize()),
              sizeBytes: Number(copy.getSize() || 0), folderName: formId
            }
          };
          if (myDocsFileInfo) {
            result.myDocsFile = myDocsFileInfo;
          }
          return result;
        } catch (err) {
          return { success: false, error: 'Копирането на документа не бе успешно: ' + err.message };
        }
      }

      // ── v12.32.35-templates: copy a Drive-source template into the user's
      //    applicant folder (APPLICANT_DOCS_FOLDER_ID / {email}) so they own an
      //    editable copy. Best-effort — the PHP replica already stored the
      //    base64 content as a fallback, so a Drive failure does NOT break the
      //    applicant's "create my copy" flow.
      function copyTemplateToDrive(body) {
        try {
          body = body || {};
          var docId = String(body.docId || '').trim();
          var email = String(body.email || body.userId || '').toLowerCase().trim();
          if (!docId || !email) return { success: false, error: 'Missing docId/email' };
          // normalise URL/ID forms
          if (docId.indexOf('/') !== -1) {
            var _m = docId.match(/\/d\/([A-Za-z0-9_-]{25,})/) || docId.match(/([A-Za-z0-9_-]{25,})/);
            if (_m && _m[1]) docId = _m[1];
          }
          var original;
          try { original = DriveApp.getFileById(docId); }
          catch (e) { return { success: false, error: 'Изходният шаблон не е намерен в Google Drive.' }; }
          var root = DriveApp.getFolderById(APPLICANT_DOCS_FOLDER_ID);
          if (!root) return { success: false, error: 'Папката на кандидатите не е достъпна.' };
          var userFolder;
          try {
            var iter = root.getFoldersByName(email);
            userFolder = iter.hasNext() ? iter.next() : root.createFolder(email);
          } catch (_) { userFolder = root; }
          // reuse existing copy by name
          var copyName = original.getName();
          var existing = userFolder.getFilesByName(copyName);
          var copy = existing.hasNext() ? existing.next() : original.makeCopy(copyName, userFolder);
          try { _addEditorSilently_(copy, email); } catch (_) {}
          try { shareGeneratedFile_(copy); } catch (_) {}
          return { success: true, driveId: copy.getId(), name: copy.getName(),
                   previewLink: 'https://drive.google.com/file/d/' + copy.getId() + '/preview?rm=minimal' };
        } catch (err) {
          return { success: false, error: 'copyTemplateToDrive failed: ' + err.message };
        }
      }

      // ============================================================
      //  DOWNLOAD DOCUMENT — byte-accurate proxy that bypasses the flaky
      //  drive.usercontent.google.com redirect (which returns HTTP 500 for
      //  binary blobs owned by the script account, because the end-user's
      //  browser session is not authorised to read them directly).
      //
      //  For BINARY files (PDF, uploaded .docx/.xlsx, images, …) we read the
      //  bytes server-side (where the script IS authorised) and hand them to
      //  the frontend as base64; the browser rebuilds a Blob and triggers a
      //  local <a download> — no Drive redirect involved.
      //
      //  For GOOGLE-NATIVE files (Docs/Sheets/Slides) we return the
      //  docs.google.com /export URL, which downloads correctly and never 500s.
      //
      //  Access: admin OR file in the public-download folder OR file in the
      //  caller's personal "My Documents" folder OR the caller owns the form
      //  (formId) the file is attached to.
      // ============================================================
      function downloadDocument(body) {
        body = body || {};
        var auth = resolveAuthContext(body);
        if (!auth.userId) return { success: false, error: 'Необходима е автентикация' };

        var docId  = String(body.docId || body.fileId || body.id || '').trim();
        var formId = String(body.formId || '').trim();
        var fid    = sanitizeFileId_(docId);
        if (!fid) return { success: false, error: 'Липсва валиден идентификатор на документа' };

        var caller = String(auth.userId || '').toLowerCase().trim();

        // ── Authorisation ──
        var allowed = !!auth.isAdmin;
        if (!allowed) { try { allowed = isFileInPublicDownloadFolder_(fid); } catch (_) {} }

        var file = null;
        try { file = DriveApp.getFileById(fid); } catch (_) {}
        if (!file) return { success: false, error: 'Документът не е намерен', code: 'NOT_FOUND' };
        // v12.49.68-gasdocfix: a trashed/deleted file is genuinely gone. Report
        // it distinctly so the caller (stream-doc.php) does NOT embed Google's
        // "/preview" URL — which renders the "file has been deleted" page in the
        // modal — and instead shows a clean missing-doc card with an Open-in-Google link.
        try { if (file.isTrashed()) return { success: false, error: 'Файлът е изтрит.', code: 'DELETED' }; } catch (_) {}

        if (!allowed) {
          // Caller's personal My Documents folder?
          try {
            var myDocs = getOrCreateMyDocsFolder_(caller);
            if (myDocs) {
              var myId = myDocs.getId();
              var ps = file.getParents();
              while (ps.hasNext()) { if (ps.next().getId() === myId) { allowed = true; break; } }
            }
          } catch (_) {}
        }
        // v10.2.0-restructure: also check root-level session folder
        if (!allowed) {
          try {
            var rootSess = getOrCreateSessionRootFolder_();
            if (rootSess) {
              var ps = file.getParents();
              while (ps.hasNext()) {
                var pId = ps.next().getId();
                try {
                  var gp = DriveApp.getFolderById(pId).getParents();
                  while (gp.hasNext()) {
                    if (gp.next().getId() === rootSess.getId()) { allowed = true; break; }
                  }
                } catch (_) {}
                if (allowed) break;
              }
            }
          } catch (_) {}
        }
        if (!allowed && formId) {
          // Caller owns the form this file is attached to?
          try {
            var sheet = getSheet();
            var found = findRowByID(sheet, formId);
            if (found) {
              var ownerEmail = String(found.rowData[COL.USER_EMAIL - 1] || '').toLowerCase().trim();
              if (ownerEmail && ownerEmail === caller) allowed = true;
            }
          } catch (_) {}
        }
        if (!allowed) {
          return { success: false, error: 'Нямате права да изтеглите този документ.', code: 'PREVIEW_ONLY' };
        }

        try {
          var mime = String(file.getMimeType() || '').toLowerCase();

          // Google-native types: return the working export URL (never 500s).
          if (mime.indexOf('google-apps.document') >= 0) {
            return { success: true, kind: 'url', name: file.getName() + '.docx',
                     url: 'https://docs.google.com/document/d/' + fid + '/export?format=docx' };
          }
          if (mime.indexOf('google-apps.spreadsheet') >= 0) {
            return { success: true, kind: 'url', name: file.getName() + '.xlsx',
                     url: 'https://docs.google.com/spreadsheets/d/' + fid + '/export?format=xlsx' };
          }
          if (mime.indexOf('google-apps.presentation') >= 0) {
            return { success: true, kind: 'url', name: file.getName() + '.pptx',
                     url: 'https://docs.google.com/presentation/d/' + fid + '/export?format=pptx' };
          }

          // Binary blob: stream bytes as base64. Guard against oversized files —
          // base64 inflates ~33% and the Apps Script response cap is ~50 MB.
          var sizeBytes = Number(file.getSize() || 0);
          if (sizeBytes > 35 * 1024 * 1024) {
            return { success: false, error: 'Файлът е твърде голям за директно изтегляне (' +
                     formatFileSize_(sizeBytes) + '). Моля, използвайте Google Drive.' };
          }

          var blob = file.getBlob();
          return {
            success : true,
            kind    : 'blob',
            name    : file.getName(),
            mimeType: blob.getContentType() || file.getMimeType() || 'application/octet-stream',
            size    : formatFileSize_(sizeBytes),
            sizeBytes: sizeBytes,
            b64     : Utilities.base64Encode(blob.getBytes())
          };
        } catch (err) {
          return { success: false, error: 'Изтеглянето на документа не бе успешно: ' + err.message };
        }
      }

      // v12.49.78-drivefilemeta: Drive-file EXISTENCE preflight. Returns ONLY
      // lightweight metadata (no bytes) so the preview modal can detect a
      // deleted/trashed file BEFORE embedding Google's cross-origin
      // "file has been deleted" page (which JS can never read/intercept). The
      // frontend (DocumentPreviewModal / InlineDocEditorModal) calls
      // api('drivefilemeta',{driveId}) and, on exists===false, shows a clean
      // "Документът е премахнат" card instead of dead-ending on Google's page.
      // This handler was referenced by the frontend since v12.47.0 but had NOT
      // been registered in GAS — so every trashed Drive doc silently fell back
      // to embedding Google's dead page. Mirrors downloadDocument's auth + trashed
      // detection exactly, but skips the byte/blob export entirely.
      function driveFileMeta(body) {
        body = body || {};
        var auth = resolveAuthContext(body);
        if (!auth.userId) return { success: false, error: 'Необходима е автентикация', code: 'AUTH_REQUIRED' };

        var docId = String(body.docId || body.fileId || body.driveId || body.id || '').trim();
        var fid = sanitizeFileId_(docId);
        if (!fid) return { success: false, error: 'Липсва валиден идентификатор на документа', code: 'BAD_ID' };

        var caller = String(auth.userId || '').toLowerCase().trim();

        // Authorisation: admin, public-download folder, caller's My Documents,
        // session root, or form owner — same gates as downloadDocument.
        var allowed = !!auth.isAdmin;
        if (!allowed) { try { allowed = isFileInPublicDownloadFolder_(fid); } catch (_) {} }

        var file = null;
        try { file = DriveApp.getFileById(fid); } catch (_) {}
        if (!file) {
          // Not found (wrong id, or removed from Drive entirely). Fail OPEN so a
          // genuinely gone file still gets embedded-and-detected by the modal's
          // own fallback — but flag it so a deliberate "exists:false" can still
          // be honoured. We return exists:false + uncertain:true so the modal
          // does NOT show the "removed" card on a mere 404 (could be a transient
          // id glitch); it keeps the Google embed attempt as a last resort.
          return { success: true, exists: false, uncertain: true, reason: 'NOT_FOUND',
                   driveId: fid, code: 'NOT_FOUND' };
        }
        // v12.49.78: a trashed file is GONE from the owner's view. Report it
        // explicitly (exists:false, not uncertain) so the modal shows the clean
        // "removed" card instead of Google's dead page.
        try { if (file.isTrashed()) {
          return { success: true, exists: false, reason: 'TRASHED',
                   name: file.getName(), mimeType: file.getMimeType(),
                   webViewLink: file.getUrl(), driveId: fid, code: 'DELETED' };
        } } catch (_) {}

        if (!allowed) {
          try {
            var myDocs = getOrCreateMyDocsFolder_(caller);
            if (myDocs) {
              var ps = file.getParents();
              while (ps.hasNext()) { if (ps.next().getId() === myDocs.getId()) { allowed = true; break; } }
            }
          } catch (_) {}
        }
        if (!allowed) {
          try {
            var rootSess = getOrCreateSessionRootFolder_();
            if (rootSess) {
              var ps2 = file.getParents();
              while (ps2.hasNext()) {
                var pId = ps2.next().getId();
                try {
                  var gp = DriveApp.getFolderById(pId).getParents();
                  while (gp.hasNext()) { if (gp.next().getId() === rootSess.getId()) { allowed = true; break; } }
                } catch (_) {}
                if (allowed) break;
              }
            }
          } catch (_) {}
        }
        if (!allowed && body.formId) {
          try {
            var sheet = getSheet();
            var found = findRowByID(sheet, String(body.formId));
            if (found) {
              var ownerEmail = String(found.rowData[COL.USER_EMAIL - 1] || '').toLowerCase().trim();
              if (ownerEmail && ownerEmail === caller) allowed = true;
            }
          } catch (_) {}
        }
        if (!allowed) {
          // File exists but caller lacks access. Fail OPEN (exists:true without
          // granular metadata) so the modal still attempts the viewer; we do not
          // leak name/mime to an unauthorized caller.
          return { success: true, exists: true, driveId: fid };
        }

        // Authorized + present + not trashed → return rich metadata for the modal.
        try {
          return {
            success: true,
            exists: true,
            name: file.getName(),
            mimeType: String(file.getMimeType() || ''),
            trashed: false,
            explicitlyTrashed: false,
            webViewLink: (typeof file.getUrl === 'function') ? file.getUrl() : '',
            driveId: fid
          };
        } catch (err) {
          return { success: true, exists: true, driveId: fid };
        }
      }

      // v12.49.68-gasdocfix: raw-bytes fetch via the Drive Advanced Service
      // (Files.get with alt=media). Used by stream-doc.php as its SECOND GAS
      // fallback tier (action=driveapimedia). This is the most reliable byte
      // source: it bypasses DriveApp.getBlob() throttling and returns the exact
      // file bytes for any file the service account can read. A trashed/deleted
      // file is detected up front and reported as code:'DELETED' so the caller
      // never falls through to embedding Google's "file has been deleted" page.
      function downloadDocumentMedia(body) {
        body = body || {};
        var auth = resolveAuthContext(body);
        if (!auth.userId) return { success: false, error: 'Необходима е автентикация' };

        var docId  = String(body.docId || body.fileId || body.id || '').trim();
        var fid    = sanitizeFileId_(docId);
        if (!fid) return { success: false, error: 'Липсва валиден идентификатор на документа' };

        var caller = String(auth.userId || '').toLowerCase().trim();

        // Authorisation (mirrors downloadDocument): admin, public-download
        // folder, caller's My Documents, session root, or form owner.
        var allowed = !!auth.isAdmin;
        if (!allowed) { try { allowed = isFileInPublicDownloadFolder_(fid); } catch (_) {} }
        var file = null;
        try { file = DriveApp.getFileById(fid); } catch (_) {}
        if (!file) return { success: false, error: 'Документът не е намерен', code: 'NOT_FOUND' };
        // v12.49.68-gasdocfix: a trashed file is GONE from the owner's view.
        // Detect it explicitly so we return a clean DELETED signal instead of
        // throwing into the ambiguous not-found path.
        try { if (file.isTrashed()) return { success: false, error: 'Файлът е изтрит.', code: 'DELETED' }; } catch (_) {}

        if (!allowed) {
          try {
            var myDocs = getOrCreateMyDocsFolder_(caller);
            if (myDocs) {
              var ps = file.getParents();
              while (ps.hasNext()) { if (ps.next().getId() === myDocs.getId()) { allowed = true; break; } }
            }
          } catch (_) {}
        }
        if (!allowed) {
          try {
            var rootSess = getOrCreateSessionRootFolder_();
            if (rootSess) {
              var ps2 = file.getParents();
              while (ps2.hasNext()) {
                var pId = ps2.next().getId();
                try {
                  var gp = DriveApp.getFolderById(pId).getParents();
                  while (gp.hasNext()) { if (gp.next().getId() === rootSess.getId()) { allowed = true; break; } }
                } catch (_) {}
                if (allowed) break;
              }
            }
          } catch (_) {}
        }
        if (!allowed) {
          return { success: false, error: 'Нямате права да изтеглите този документ.', code: 'PREVIEW_ONLY' };
        }

        try {
          var sizeBytes = Number(file.getSize() || 0);
          if (sizeBytes > 35 * 1024 * 1024) {
            return { success: false, error: 'Файлът е твърде голям за директно изтегляне (' +
                     formatFileSize_(sizeBytes) + '). Моля, използвайте Google Drive.' };
          }
          // Drive Advanced Service gives direct media bytes (no export/render step).
          var bytes = null;
          if (typeof Drive !== 'undefined' && Drive.Files && typeof Drive.Files.get === 'function') {
            try {
              bytes = Drive.Files.get(fid, { alt: 'media' });
            } catch (eDrive) {
              // Fall back to DriveApp bytes if the Advanced Service is unavailable.
              try { bytes = file.getBlob().getBytes(); } catch (_) { bytes = null; }
            }
          } else {
            try { bytes = file.getBlob().getBytes(); } catch (_) { bytes = null; }
          }
          if (!bytes) return { success: false, error: 'Неуспешно извличане на байтовете на файла.' };
          return {
            success  : true,
            kind     : 'blob',
            name     : file.getName(),
            mimeType : String(file.getMimeType() || 'application/octet-stream'),
            sizeBytes: sizeBytes,
            b64      : Utilities.base64Encode(bytes)
          };
        } catch (err) {
          return { success: false, error: 'Изтеглянето на документа не бе успешно: ' + err.message };
        }
      }

      // ============================================================
      //  COPY DOCUMENT FOR USER — any authenticated user can copy an
      //  official-docs-folder document into their personal "My Documents"
      //  folder.  The copy is editable (Google Docs) or downloadable.
      //  Used by the "Моите документи" feature — users fill and store
      //  personal copies of templates / regulations.
      // ============================================================
      /**
       * Grant admin + CKK members read-only oversight on an applicant-owned file.
       * Silent (no email notifications). Best-effort: any per-grantee failure
       * is logged but doesn't break the parent operation. Returns the list of
       * emails for which the grant succeeded.
       */
      function _grantOversightAccess_(file) {
        var granted = [];
        if (!file) return granted;
        try {
          var watchers = {};
          // Admins
          if (typeof _ADMIN_EMAILS_SERVER !== 'undefined' && _ADMIN_EMAILS_SERVER) {
            for (var i = 0; i < _ADMIN_EMAILS_SERVER.length; i++) {
              var a = String(_ADMIN_EMAILS_SERVER[i] || '').toLowerCase().trim();
              if (a) watchers[a] = true;
            }
          }
          // CKK members
          try {
            var ckk = _readCkkMembers_();
            for (var j = 0; j < ckk.length; j++) {
              var c = String(ckk[j] || '').toLowerCase().trim();
              if (c) watchers[c] = true;
            }
          } catch (_) {}
          var fileId = file.getId();
          Object.keys(watchers).forEach(function(em) {
            try {
              if (typeof Drive !== 'undefined' && Drive.Permissions) {
                if (typeof Drive.Permissions.create === 'function') {
                  Drive.Permissions.create(
                    { role: 'reader', type: 'user', emailAddress: em },
                    fileId,
                    { sendNotificationEmail: false, supportsAllDrives: true, fields: 'id' }
                  );
                } else if (typeof Drive.Permissions.insert === 'function') {
                  Drive.Permissions.insert(
                    { role: 'reader', type: 'user', value: em },
                    fileId,
                    { sendNotificationEmails: false, supportsAllDrives: true }
                  );
                } else {
                  return; // Advanced Service missing — skip silently
                }
                granted.push(em);
              }
            } catch (e1) {
              try { logError && logError('_grantOversightAccess_', e1, { email: em, fileId: fileId }); } catch (_) {}
            }
          });
        } catch (err) {
          try { logError && logError('_grantOversightAccess_', err); } catch (_) {}
        }
        return granted;
      }

      // v19.0.0-refactor: Per-execution cache for isFileInPublicDownloadFolder_ results
      var _publicDownloadCache_ = {};
      function _cachedIsPublicDownload_(fileId) {
        if (_publicDownloadCache_.hasOwnProperty(fileId)) return _publicDownloadCache_[fileId];
        var result = isFileInPublicDownloadFolder_(fileId);
        _publicDownloadCache_[fileId] = result;
        return result;
      }

      function copyDocForUser(body) {
        body = body || {};
        var auth = resolveAuthContext(body);
        if (!auth.userId) return { success: false, error: 'Необходима е автентикация' };

        var docId = sanitizeFileId_(String(body.docId || '').trim());
        if (!docId) return { success: false, error: 'Невалиден или липсващ docId' };

        // Accept optional formId to store in the per-form session folder
        var formId = String(body.formId || '').trim();

        // Only allow copying files that live inside OFFICIAL_DOCS_FOLDER_ID
        // (the shared document library).  Users cannot copy arbitrary Drive files.
        // v19.0.0-refactor: Use cached version to avoid repeated Drive API calls
        if (!_cachedIsPublicDownload_(docId)) {
          return { success: false, error: 'Документът не е от официалната библиотека' };
        }

        try {
          // v10.2.0-restructure: use root-level session folder when formId provided,
          // otherwise fall back to per-user My Documents folder.
          var targetFolder = null;
          if (formId) {
            targetFolder = getOrCreateFormSessionFolder_(formId, auth.userId || '');
          }
          if (!targetFolder) {
            targetFolder = getOrCreateMyDocsFolder_(auth.userId);
          }
          if (!targetFolder) return { success: false, error: 'Не може да се създаде целева папка' };
          var folderDisplayName = formId ? (SESSION_FOLDER_NAME + '/' + formId) : 'Моите документи';

          // v12.30.2-defensive: explicit existence check so a deleted/moved library
          // file yields a clear Bulgarian error instead of a generic exception text.
          var original = null;
          try { original = DriveApp.getFileById(docId); }
          catch (eSrc) {
            return { success: false, error: 'Файлът от библиотеката не е намерен в Google Drive (възможно е да е изтрит или преместен). Моля, опреснете списъка и опитайте отново.' };
          }
          var baseName = original.getName();
          var copyName = baseName;

          // If a copy with the same name already exists, add a "(копие N)" suffix
          // v12.26.0-perf: Cache regex match to avoid duplicate .match() calls
          var _cpBaseName = baseName.replace(/(\.[^.]+)$/, '');
          var _cpExtMatch = baseName.match(/(\.[^.]+)$/);
          var _cpExt = _cpExtMatch ? _cpExtMatch[0] : '';
          var existing = targetFolder.getFilesByName(copyName);
          if (existing.hasNext()) {
            var idx = 1;
            do {
              copyName = _cpBaseName + ' (копие ' + (++idx) + ')' + _cpExt;
            } while (targetFolder.getFilesByName(copyName).hasNext() && idx < 50);
          }

          var copy = original.makeCopy(copyName, targetFolder);
          var copyId = copy.getId();

          // ── Tag the copy with source template info in file description ──
          var descParts = [
            'TEMPLATE_SOURCE=' + docId,
            'TEMPLATE_NAME=' + baseName,
            'ORIGIN=copied'
          ];
          try { copy.setDescription(descParts.join('|')); } catch (_) {}

          // v12.30.1-fix: Set ANYONE_WITH_LINK sharing so the preview/embed iframes
          // work for all users (not just Google-authenticated ones).
          // _grantOversightAccess_ only adds specific admin/CKK viewers — it does
          // NOT set link-sharing, so embedded iframes fail with "file does not exist"
          // for anyone whose Google account isn't explicitly in the access list.
          try { shareGeneratedFile_(copy); } catch (_) {}
          // Grant the applicant editor access on their own copy so they can
          // keep redacting it. Owner of the copy is the script; this explicit
          // grant is what lets the signed-in applicant open it in /edit.
          try { _addEditorSilently_(copy, auth.userId); } catch (_) {}

          var mimeType = copy.getMimeType();

          // User-owned copies get full access links (the user owns the copy).
          // Pass mimeType so Google-native copies (Docs/Sheets/Slides) get a
          // working export download URL instead of the uc?export endpoint
          // (which 500s for native files).
          var links = buildSecureFileLinks_(copyId, { allowDownload: true, mimeType: mimeType });
          return {
            success: true,
            file: {
              id: copyId,
              driveId: copyId,
              name        : copy.getName(),
              mimeType    : mimeType,
              typeLabel   : mimeTypeLabel(mimeType),
              previewLink : links.previewLink,
              webViewLink : links.previewLink,
              editLink    : mimeType === 'application/vnd.google-apps.document'
                            ? 'https://docs.google.com/document/d/' + copyId + '/edit'
                            : (mimeType === 'application/vnd.google-apps.spreadsheet'
                              ? 'https://docs.google.com/spreadsheets/d/' + copyId + '/edit'
                              : links.previewLink),
              googleDocEditLink: mimeType === 'application/vnd.google-apps.document'
                            ? 'https://docs.google.com/document/d/' + copyId + '/edit'
                            : (mimeType === 'application/vnd.google-apps.spreadsheet'
                              ? 'https://docs.google.com/spreadsheets/d/' + copyId + '/edit'
                              : ''),
              downloadUrl : links.downloadUrl,
              size        : formatFileSize_(copy.getSize()),
              sizeBytes   : Number(copy.getSize() || 0),
              folderName  : folderDisplayName,
              formId      : formId || '',
              createdDate : copy.getDateCreated().toISOString(),
              modifiedDate: copy.getLastUpdated().toISOString(),
              origin      : 'copied',
              templateSourceId  : docId,
              templateSourceName: baseName,
              isGoogleDoc : !!mimeType.match(/google\.(document|spreadsheet|presentation|drawing|form)/i)
            }
          };
        } catch (err) {
          return { success: false, error: 'Копирането на документа не бе успешно: ' + err.message };
        }
      }

      /* ============================================================================
       * CKK MEMBERSHIP MANAGEMENT (v9.57.0-community)
       * Replaces the prior "edit ScriptProperties by hand" workflow with an
       * OTP-verified admin flow: admin enters target email -> backend emails a
       * 6-digit code to that email -> CKK candidate forwards the code to admin
       * -> admin submits code -> email added to CKK_MEMBERS list.
       * Cache invalidation: _ckkEmailsCache is reset on every mutation.
       * ============================================================================ */
      function _readCkkMembers_() {
        try {
          var raw = _scriptProps_().getProperty('CKK_MEMBERS') || '';
          return raw.split(',').map(function (e) { return String(e).trim().toLowerCase(); }).filter(Boolean);
        } catch (_) { return []; }
      }
      function _writeCkkMembers_(list) {
        var uniq = []; var seen = {};
        for (var i = 0; i < list.length; i++) {
          var v = String(list[i] || '').trim().toLowerCase();
          if (!v || seen[v]) continue;
          seen[v] = true; uniq.push(v);
        }
        _scriptProps_().setProperty('CKK_MEMBERS', uniq.join(','));
        _ckkEmailsCache = null;
        return uniq;
      }
      function _looksLikeInstitutionalEmail_(email) {
        var s = String(email || '').toLowerCase().trim();
        // Match a single @-bearing token. Domain gate is performed by the
        // frontend (isAllowedSignInEmail) and again at sign-in time; here we
        // only require well-formed shape so backend doesn't refuse a valid
        // address admin already vetted.
        return /^[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$/.test(s);
      }

      /**
       * assignCkkRequest({email})  — admin asks the system to email an OTP to
       * a candidate CKK member. Returns the same { success, codeSent, expiresIn,
       * cooldown } envelope as initiate2fa so the frontend can reuse OTP UI bits.
       */
      function assignCkkRequest(body) {
        try {
          body = body || {};
          var ctx = resolveAuthContext(body);
          if (!ctx.authenticated) return { success: false, error: 'Not authenticated' };
          if (!ctx.isAdmin) return { success: false, error: 'Admin only' };
          var email = String(body.email || '').toLowerCase().trim();
          if (!_looksLikeInstitutionalEmail_(email)) {
            return { success: false, error: 'Невалиден имейл адрес.' };
          }
          var already = _readCkkMembers_();
          if (already.indexOf(email) !== -1) {
            return { success: false, error: email + ' вече е член на ЦКК.' };
          }
          // Issue OTP under a dedicated scope so it cannot be reused for sign-in.
          var r = _2faIssue_('ckk_assign', email, 'ckk-' + Utilities.getUuid().slice(0, 8));
          if (!r || !r.success) return r || { success: false, error: 'OTP не може да бъде издаден.' };
          try {
            logTransaction('CKK_ASSIGN_REQUEST', 'user', email, { by: ctx.email });
          } catch (_) {}
          return { success: true, codeSent: true, expiresIn: r.expiresIn, cooldown: r.cooldown, ref: r.ref || null, email: email };
        } catch (err) {
          try { logError('assignCkkRequest', err, body); } catch (_) {}
          return { success: false, error: 'assignCkkRequest: ' + err.message };
        }
      }

      /**
       * assignCkkConfirm({email, code})  — verifies the OTP code (issued by
       * assignCkkRequest) and, on success, appends the email to CKK_MEMBERS.
       */
      function assignCkkConfirm(body) {
        try {
          body = body || {};
          var ctx = resolveAuthContext(body);
          if (!ctx.authenticated) return { success: false, error: 'Not authenticated' };
          if (!ctx.isAdmin) return { success: false, error: 'Admin only' };
          var email = String(body.email || '').toLowerCase().trim();
          var code  = String(body.code || body.otp || '').trim();
          if (!email || !code) return { success: false, error: 'email и code са задължителни.' };
          var v = _2faVerify_('ckk_assign', email, String(body.ref || ''), code);
          if (!v || !v.success) {
            return Object.assign({ success: false }, v || {}, { error: (v && v.error) || 'Невалиден код.' });
          }
          var list = _readCkkMembers_();
          if (list.indexOf(email) === -1) list.push(email);
          var written = _writeCkkMembers_(list);
          try {
            logTransaction('CKK_ASSIGN_CONFIRM', 'user', email, { by: ctx.email, total: written.length });
          } catch (_) {}
          try { touchDataVersion_('reviewers'); } catch (_) {}
          return { success: true, email: email, members: written };
        } catch (err) {
          try { logError('assignCkkConfirm', err, body); } catch (_) {}
          return { success: false, error: 'assignCkkConfirm: ' + err.message };
        }
      }

      /**
       * removeCkkMember({email}) — admin revokes CKK membership.
       */
      function removeCkkMember(body) {
        try {
          body = body || {};
          var ctx = resolveAuthContext(body);
          if (!ctx.authenticated) return { success: false, error: 'Not authenticated' };
          if (!ctx.isAdmin) return { success: false, error: 'Admin only' };
          var email = String(body.email || '').toLowerCase().trim();
          if (!email) return { success: false, error: 'Липсва email.' };
          var list = _readCkkMembers_();
          var idx = list.indexOf(email);
          if (idx === -1) return { success: false, error: email + ' не е член на ЦКК.' };
          list.splice(idx, 1);
          var written = _writeCkkMembers_(list);
          try { logTransaction('CKK_REMOVE', 'user', email, { by: ctx.email, total: written.length }); } catch (_) {}
          try { touchDataVersion_('reviewers'); } catch (_) {}
          return { success: true, email: email, members: written };
        } catch (err) {
          try { logError('removeCkkMember', err, body); } catch (_) {}
          return { success: false, error: 'removeCkkMember: ' + err.message };
        }
      }

      /**
       * listCkkMembers() — admin/CKK get the current CKK roster.
       */
      function listCkkMembers(body) {
        try {
          body = body || {};
          var ctx = resolveAuthContext(body);
          if (!ctx.authenticated) return { success: false, error: 'Not authenticated' };
          if (!ctx.isAdmin && !isCKKMember_(ctx.email)) return { success: false, error: 'Admin or CKK only' };
          return { success: true, members: _readCkkMembers_() };
        } catch (err) {
          return { success: false, error: 'listCkkMembers: ' + err.message };
        }
      }

      // ═══════════════════════════════════════════════════════════════════════════
      //  v10.4.1-hostingerdb: listParticipants — извлича ВСИЧКИ участници в
      //  системата от TransactionLog, Applications, Reviewers и AdminEmails.
      //  Връща уникален списък с { email, name, lastActive, role, formCount }.
      //  Използва се от таб "Общност" → "Участници" за admin преглед.
      // ═══════════════════════════════════════════════════════════════════════════
      function listParticipants(body) {
        try {
          body = body || {};
          var ctx = resolveAuthContext(body);
          if (!ctx.authenticated) return { success: false, error: 'Not authenticated' };
          if (!ctx.isAdmin) return { success: false, error: 'Само администратори' };

          var participants = {}; // keyed by email lowercase
          var ss = _getCachedSpreadsheet();

          // 1. From TransactionLog — всички имейли, които някога са влезли
          try {
            var tlSheet = ss.getSheetByName('TransactionLog');
            if (tlSheet) {
              var tlData = tlSheet.getDataRange().getValues();
              for (var ti = 1; ti < tlData.length; ti++) { // skip header
                var tlRow = tlData[ti];
                var tlAction = String(tlRow[1] || '').trim();
                var tlEntity = String(tlRow[2] || '').trim();
                var tlEntityId = String(tlRow[3] || '').trim();
                var tlTimestamp = String(tlRow[0] || '');
                if (tlEntity === 'user' && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(tlEntityId)) {
                  var email = tlEntityId.toLowerCase();
                  if (!participants[email]) {
                    participants[email] = { email: email, name: '', lastActive: tlTimestamp, role: 'applicant', formCount: 0, reviewerCount: 0, source: 'log' };
                  } else {
                    if (tlTimestamp > participants[email].lastActive) participants[email].lastActive = tlTimestamp;
                  }
                }
                // Also capture from Details JSON if it contains user info
                try {
                  var tlDetails = JSON.parse(tlRow[4] || '{}');
                  if (tlDetails.email && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(tlDetails.email)) {
                    var detEmail = String(tlDetails.email).toLowerCase();
                    if (!participants[detEmail]) {
                      participants[detEmail] = { email: detEmail, name: tlDetails.name || '', lastActive: tlTimestamp, role: 'applicant', formCount: 0, reviewerCount: 0, source: 'log' };
                    }
                  }
                  if (tlDetails.by && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(tlDetails.by)) {
                    var byEmail = String(tlDetails.by).toLowerCase();
                    if (!participants[byEmail]) {
                      participants[byEmail] = { email: byEmail, name: '', lastActive: tlTimestamp, role: 'admin', formCount: 0, reviewerCount: 0, source: 'log' };
                    }
                  }
                } catch (_) {}
              }
            }
          } catch (_) {}

          // 2. From Applications sheet — всички кандидати
          try {
            var appSheet = ss.getSheetByName(SHEET_NAME);
            if (appSheet) {
              var appData = appSheet.getDataRange().getValues();
              for (var ai = 1; ai < appData.length; ai++) {
                var appEmail = String(appData[ai][1] || '').toLowerCase().trim(); // COL.USER_EMAIL
                var appName = String(appData[ai][2] || '').trim(); // COL.USER_NAME
                if (appEmail && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(appEmail)) {
                  if (!participants[appEmail]) {
                    participants[appEmail] = { email: appEmail, name: appName, lastActive: String(appData[ai][14] || ''), role: 'applicant', formCount: 1, reviewerCount: 0, source: 'application' };
                  } else {
                    participants[appEmail].formCount = (participants[appEmail].formCount || 0) + 1;
                    if (!participants[appEmail].name && appName) participants[appEmail].name = appName;
                    if (participants[appEmail].role !== 'admin') participants[appEmail].role = 'applicant';
                  }
                }
              }
            }
          } catch (_) {}

          // 3. From Reviewers sheet
          try {
            var revSheet = ss.getSheetByName(REVIEWERS_SHEET_NAME);
            if (revSheet) {
              var revData = revSheet.getDataRange().getValues();
              for (var ri = 1; ri < revData.length; ri++) {
                var revEmail = String(revData[ri][1] || '').toLowerCase().trim();
                var revName = String(revData[ri][2] || '').trim();
                if (revEmail && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(revEmail)) {
                  if (!participants[revEmail]) {
                    participants[revEmail] = { email: revEmail, name: revName, lastActive: '', role: 'reviewer', formCount: 0, reviewerCount: 1, source: 'reviewer' };
                  } else {
                    participants[revEmail].reviewerCount = (participants[revEmail].reviewerCount || 0) + 1;
                    if (!participants[revEmail].name && revName) participants[revEmail].name = revName;
                    if (participants[revEmail].role === 'applicant') participants[revEmail].role = 'applicant+reviewer';
                  }
                }
              }
            }
          } catch (_) {}

          // 4. AdminEmails
          try {
            var adminRaw = _scriptProps_().getProperty('ADMIN_EMAILS') || '';
            var adminList = adminRaw.split(',').map(function(e){return String(e).trim().toLowerCase();}).filter(Boolean);
            for (var adi = 0; adi < adminList.length; adi++) {
              if (!participants[adminList[adi]]) {
                participants[adminList[adi]] = { email: adminList[adi], name: '', lastActive: '', role: 'admin', formCount: 0, reviewerCount: 0, source: 'admin' };
              } else {
                participants[adminList[adi]].role = 'admin';
              }
            }
          } catch (_) {}

          // Convert to array, sort by lastActive desc
          var result = [];
          for (var key in participants) {
            if (participants.hasOwnProperty(key)) result.push(participants[key]);
          }
          result.sort(function(a, b) {
            return (b.lastActive || '').localeCompare(a.lastActive || '');
          });

          return {
            success: true,
            participants: result,
            total: result.length,
            admins: result.filter(function(p){return p.role === 'admin';}).length,
            reviewers: result.filter(function(p){return p.reviewerCount > 0;}).length,
            applicants: result.filter(function(p){return p.formCount > 0;}).length
          };
        } catch (err) {
          return { success: false, error: 'listParticipants: ' + err.message };
        }
      }

      // ═══════════════════════════════════════════════════════════════════════════
      //  v10.4.1-hostingerdb: batchAddReviewers — добавя множество участници
      //  наведнъж в пула рецензенти за даден конкурс.
      //  POST: { competitionId, participants: [ { email, name }, ... ], reviewerFee?, reviewerFeeCurrency? }
      // ═══════════════════════════════════════════════════════════════════════════
      function batchAddReviewers(body) {
        try {
          body = body || {};
          var ctx = resolveAuthContext(body);
          if (!ctx.isAdmin) return { success: false, error: 'Само администратори' };

          var competitionId = String(body.competitionId || '').trim();
          if (!competitionId) return { success: false, error: 'Изберете конкурс' };

          var participants = body.participants || [];
          if (!Array.isArray(participants) || !participants.length) {
            return { success: false, error: 'Няма избрани участници' };
          }

          var added = [];
          var errors = [];

          for (var bi = 0; bi < participants.length; bi++) {
            var p = participants[bi];
            var email = String(p.email || '').toLowerCase().trim();
            var name = String(p.name || email.split('@')[0] || '').trim();
            if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
              errors.push({ email: email, error: 'Невалиден имейл' });
              continue;
            }
            try {
              var result = addReviewer({
                email: email,
                name: name,
                competitionId: competitionId,
                userId: ctx.userId,
                email: ctx.email,
                __skipReauth: true,
                reviewerFee: body.reviewerFee,
                reviewerFeeCurrency: body.reviewerFeeCurrency
              });
              if (result && result.success) {
                added.push({ email: email, name: name, id: result.id });
              } else {
                errors.push({ email: email, error: (result && result.error) || 'Грешка' });
              }
            } catch (e) {
              errors.push({ email: email, error: e.message });
            }
          }

          var msg = 'Добавени ' + added.length + ' от ' + participants.length + ' рецензенти';
          if (errors.length) msg += ' (' + errors.length + ' грешки)';

          return {
            success: true,
            added: added,
            errors: errors,
            addedCount: added.length,
            errorCount: errors.length,
            message: msg
          };
        } catch (err) {
          return { success: false, error: 'batchAddReviewers: ' + err.message };
        }
      }

      /* ============================================================================
       * listFolderTemplates({folderId, projectType})
       * Applicant-facing: enumerate the Google-Doc/Sheets templates in a funding
       * program's shared Drive folder so the wizard "Шаблони" section can list
       * and offer them for one-click copy. Auth required (mirrors copyTemplateForUser).
       * If folderId is omitted, resolves via the per-program folder map.
       * Returns { success, templates:[{id,name,mimeType,url,templateKey}], folderUrl }.
       * ============================================================================ */
      function listFolderTemplates(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.authenticated) return { success: false, error: 'Необходима е автентикация.' };
          var folderId = String(body.folderId || body.folder_id || '').trim();
          var projectType = String(body.projectType || '').trim();
          if (!folderId) {
            var fmap = _getTemplateFolderIds_();
            folderId = (fmap && fmap[projectType]) ? fmap[projectType] : '';
          }
          if (!folderId) return { success: false, error: 'Липсва папка с шаблони за „' + projectType + '“' };
          var folder;
          try { folder = DriveApp.getFolderById(folderId); }
          catch (eF) { return { success: false, error: 'Папката не е намерена в Google Drive: ' + eF.message, templates: [] }; }
          if (!folder) return { success: false, error: 'Папката не е намерена.', templates: [] };
          var out = [], seen = {}, files = folder.getFiles();
          while (files.hasNext()) {
            var f = files.next();
            var id = f.getId();
            if (seen[id]) continue;
            seen[id] = true;
            var mt = f.getMimeType();
            out.push({
              id: id,
              name: f.getName(),
              mimeType: mt,
              url: 'https://drive.google.com/file/d/' + id + '/view',
              templateKey: id
            });
          }
          return {
            success: true,
            templates: out,
            folderUrl: 'https://drive.google.com/drive/folders/' + folderId,
            _source: 'gas'
          };
        } catch (err) {
          return { success: false, error: 'Неуспешно четене на папката с шаблони: ' + err.message, templates: [] };
        }
      }

      /* ============================================================================
       * copyFolderTemplate({projectType, templateId, userId})
       * Direct copy-from-folder path used by the wizard "Шаблони" section. Copies
       * a specific template file (by drive id) into the user's My Documents folder
       * and returns the new file's metadata. Distinct from copyTemplateForUser
       * (which resolves templates from the REQUIRED_APPLICATION_TEMPLATES registry
       * by key) so the folder-listing flow stays decoupled from that registry.
       * ============================================================================ */
      function copyFolderTemplate(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.authenticated) return { success: false, error: 'Необходима е автентикация.' };
          var templateId = String(body.templateId || body.template_id || '').trim();
          if (!templateId) return { success: false, error: 'templateId е задължителен.' };
          var userFolder = getOrCreateMyDocsFolder_(auth.userId || '');
