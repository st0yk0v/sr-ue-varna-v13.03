      // ============================================================
      //  CHANGE REQUESTS
      // ============================================================

      function createChangeRequest(body) {
        try {
          var auth = resolveAuthContext(body);
          var projectId  = String(body.projectId || '').trim();
          var changeType = String(body.changeType || '').trim();
          var description = String(body.description || '').trim();
          if (!projectId) return { success: false, error: 'Липсва projectId.' };
          var validTypes = ['team_change', 'leader_change', 'budget_change', 'plan_update', 'suspension', 'termination', 'addendum'];
          if (!validTypes.includes(changeType)) return { success: false, error: 'Невалиден тип промяна.' };
          // Validate user is project leader or admin
          var projSheet = getProjectsSheet();
          var projData  = projSheet.getDataRange().getValues();
          var projRow   = null;
          for (var i = 1; i < projData.length; i++) {
            if (String(projData[i][PROJ_COL.ID - 1]).trim() === projectId) { projRow = projData[i]; break; }
          }
          if (!projRow) return { success: false, error: 'Проектът не е намерен.' };
          if (!auth.isAdmin && String(projRow[PROJ_COL.LEADER_EMAIL - 1]).toLowerCase() !== (auth.userId || '').toLowerCase()) return { success: false, error: 'Само ръководителят може да подава искания за промяна.' };

          // ── UC-34 (Workflow spec) — Plan-smetka business rules ──
          // (a) No more than ONE plan-smetka change per 12-month window per project.
          // (b) Salary lines (заплати на постоянни членове) cannot be changed via
          //     this flow — only via documented exception by the rector.
          if (changeType === 'budget_change' || changeType === 'plan_update') {
            try {
              var newDataObj = {};
              if (body.newData) {
                try { newDataObj = (typeof body.newData === 'string') ? JSON.parse(body.newData) : body.newData; } catch (_) { newDataObj = {}; }
              }
              var oldDataObj = {};
              if (body.oldData) {
                try { oldDataObj = (typeof body.oldData === 'string') ? JSON.parse(body.oldData) : body.oldData; } catch (_) { oldDataObj = {}; }
              }
              // (b) Salary block: detect change in any salary-related cost group.
              var salaryGroups = ['salaries', 'salary', 'wages', 'remuneration', 'заплати'];
              var newCat = (newDataObj && newDataObj.byCategory) ? newDataObj.byCategory : newDataObj;
              var oldCat = (oldDataObj && oldDataObj.byCategory) ? oldDataObj.byCategory : oldDataObj;
              if (newCat && oldCat) {
                for (var sgi = 0; sgi < salaryGroups.length; sgi++) {
                  var sg = salaryGroups[sgi];
                  if ((sg in newCat) && Number(newCat[sg] || 0) !== Number(oldCat[sg] || 0)) {
                    if (!auth.isAdmin || !String(body.rectorWaiverRef || '').trim()) {
                      return { success: false, error: 'Промяна на разходи за заплати не е допустима по този ред. Изисква се извънредно решение на Ректора (rectorWaiverRef).' };
                    }
                  }
                }
              }
              // (a) 12-month window check.
              var crSheetCheck = getChangeRequestsSheet();
              var crDataCheck  = crSheetCheck.getDataRange().getValues();
              var TWELVE_MO_MS = 365 * 24 * 60 * 60 * 1000;
              var nowMs = Date.now();
              var lastApproved = null;
              for (var ci = 1; ci < crDataCheck.length; ci++) {
                var crR = crDataCheck[ci];
                if (String(crR[CR_COL.PROJECT_ID - 1]).trim() !== projectId) continue;
                var crType = String(crR[CR_COL.CHANGE_TYPE - 1]).trim();
                if (crType !== 'budget_change' && crType !== 'plan_update') continue;
                var crStat = String(crR[CR_COL.STATUS - 1]).trim();
                if (crStat !== 'approved' && crStat !== 'implemented') continue;
                var crTs = new Date(String(crR[CR_COL.REQUESTED_AT - 1] || '')).getTime();
                if (!isNaN(crTs) && (lastApproved === null || crTs > lastApproved)) lastApproved = crTs;
              }
              if (lastApproved !== null && (nowMs - lastApproved) < TWELVE_MO_MS) {
                if (!auth.isAdmin || !String(body.rectorWaiverRef || '').trim()) {
                  var nextOk = new Date(lastApproved + TWELVE_MO_MS).toISOString().substring(0, 10);
                  return { success: false, error: 'Промяна на план-сметка вече е извършена в последните 12 месеца. Следващата е допустима след ' + nextOk + '.' };
                }
              }
            } catch (uc34Err) {
              console.warn('UC-34 plan-smetka check failed: ' + uc34Err.message);
            }
          }

          var crSheet = getChangeRequestsSheet();
          var id = 'CR-' + Utilities.getUuid().replace(/-/g, '').substring(0, 12).toUpperCase();
          var now = new Date().toISOString();
          var crRow = new Array(CR_TOTAL_COLS).fill('');
          crRow[CR_COL.ID - 1] = id;
          crRow[CR_COL.PROJECT_ID - 1] = projectId;
          crRow[CR_COL.CHANGE_TYPE - 1] = changeType;
          crRow[CR_COL.REQUESTED_BY - 1] = auth.userId || '';
          crRow[CR_COL.REQUESTED_AT - 1] = now;
          crRow[CR_COL.STATUS - 1] = 'submitted';
          crRow[CR_COL.DESCRIPTION - 1] = description;
          crRow[CR_COL.OLD_DATA - 1] = typeof body.oldData === 'object' ? JSON.stringify(body.oldData) : String(body.oldData || '');
          crRow[CR_COL.NEW_DATA - 1] = typeof body.newData === 'object' ? JSON.stringify(body.newData) : String(body.newData || '');
          crRow[CR_COL.NOTES - 1] = body.notes || '';
          crSheet.appendRow(crRow);

          // ── Notify project leader of the new change request ──
          // Especially important when the admin (NIDD/CKK/Rector) raises the
          // request on behalf of the project — without this email, the
          // applicant has no signal that a change is pending until they
          // happen to open the project. Skip self-notify when the leader
          // initiates it themselves.
          try {
            var leaderEmail = String(projRow[PROJ_COL.LEADER_EMAIL - 1] || '').trim();
            var leaderName  = String(projRow[PROJ_COL.LEADER_NAME  - 1] || '').trim();
            var projTitle   = String(projRow[PROJ_COL.TITLE        - 1] || '').trim();
            var projCode    = String(projRow[PROJ_COL.PROJECT_CODE - 1] || '').trim();
            var requestedBy = String(auth.userId || '').toLowerCase();
            var typeLabels  = {
              budget_change: 'Промяна в план-сметка',
              leader_change: 'Смяна на ръководител',
              team_change  : 'Промяна в екипа',
              plan_update  : 'Актуализация на плана',
              suspension   : 'Спиране',
              termination  : 'Прекратяване',
              addendum     : 'Анекс'
            };
            var typeLabel = typeLabels[changeType] || changeType;

            if (leaderEmail && isValidEmail(leaderEmail) && leaderEmail.toLowerCase() !== requestedBy) {
              var actorLabel = auth.isAdmin ? 'Администратор' : (auth.role || 'Потребител');
              var heading    = '📝 Ново искане за промяна по Вашия проект';
              var lines = [
                { label: 'Проект:',       value: projTitle || '(без заглавие)' },
                { label: 'Код:',          value: projCode  || projectId },
                { label: 'Вид промяна:',  value: typeLabel },
                { label: 'Заявил:',       value: (auth.userId || '—') + ' (' + actorLabel + ')' },
                { label: 'Идентификатор:',value: id },
                { label: 'Статус:',       value: 'Подадено за разглеждане' },
                { label: 'Дата:',         value: new Date().toLocaleString('bg-BG', { timeZone: 'Europe/Sofia' }) }
              ];
              if (description) lines.push({ label: 'Описание:', value: description });
              var footer = 'Искането ще бъде разгледано от Централната конкурсна комисия. Ще получите ново писмо с решението.';
              notifyApplicant_(leaderEmail,
                'Ново искане за промяна – ' + (projTitle || projCode || projectId),
                buildNotificationHtml_(heading, lines, footer), 'status_change'
              );
            }

            // Also notify NIDD/admin queue when the request is raised by the leader
            // so administrators see incoming change requests without polling.
            if (leaderEmail && leaderEmail.toLowerCase() === requestedBy) {
              try {
                var adminEmail = (typeof getNotifyAdminEmail_ === 'function') ? getNotifyAdminEmail_() : '';
                if (adminEmail && isValidEmail(adminEmail)) {
                  notifyApplicant_(adminEmail,
                    'Ново искане за промяна – ' + (projTitle || projCode || projectId),
                    buildNotificationHtml_(
                      '📥 Ново искане за промяна (за разглеждане)',
                      [
                        { label: 'Проект:',      value: projTitle || '(без заглавие)' },
                        { label: 'Код:',         value: projCode  || projectId },
                        { label: 'Вид промяна:', value: typeLabel },
                        { label: 'Заявил:',      value: (leaderName || '') + ' <' + leaderEmail + '>' },
                        { label: 'Идентификатор:', value: id },
                        { label: 'Дата:',        value: new Date().toLocaleString('bg-BG', { timeZone: 'Europe/Sofia' }) }
                      ],
                      description || 'Моля, прегледайте искането в системата ERP.'
                    ),
                    'change_request'
                  );
                }
              } catch (admErr) { console.warn('createChangeRequest admin notify failed: ' + admErr.message); }
            }
          } catch (notifyErr) {
            console.warn('createChangeRequest notify failed: ' + notifyErr.message);
          }

          console.log('[AUDIT] createChangeRequest', auth.userId, { crId: id, projectId: projectId, changeType: changeType });
          return { success: true, changeRequestId: id };
        } catch (err) {
          logError('createChangeRequest', err, body);
          return { success: false, error: 'createChangeRequest failed: ' + err.message };
        }
      }

      function getChangeRequests(body) {
        try {
          var auth = resolveAuthContext(body);
          var projectId = String(body.projectId || '').trim();
          var dv = getDataVersions_();
          var sc = _scriptCache_();
          var cacheKey = 'gCR:' + projectId + ':' + dv.projects;
          if (!body.forceRefresh) {
            try { var cv = sc.get(cacheKey); if (cv) return JSON.parse(cv); } catch (_) {}
          }
          var crSheet = getChangeRequestsSheet();
          var data = crSheet.getDataRange().getValues();
          var requests = [];
          for (var i = 1; i < data.length; i++) {
            var r = data[i];
            if (!String(r[CR_COL.ID - 1]).trim()) continue;
            if (projectId && String(r[CR_COL.PROJECT_ID - 1]).trim() !== projectId) continue;
            requests.push({
              id: String(r[CR_COL.ID - 1]),
              projectId: String(r[CR_COL.PROJECT_ID - 1]),
              changeType: String(r[CR_COL.CHANGE_TYPE - 1]),
              requestedBy: String(r[CR_COL.REQUESTED_BY - 1]),
              requestedAt: String(r[CR_COL.REQUESTED_AT - 1]),
              status: String(r[CR_COL.STATUS - 1]),
              description: String(r[CR_COL.DESCRIPTION - 1]),
              decision: String(r[CR_COL.DECISION - 1]),
              reviewedBy: String(r[CR_COL.REVIEWED_BY - 1]),
              reviewedAt: String(r[CR_COL.REVIEWED_AT - 1])
            });
          }
          var result = { success: true, changeRequests: requests };
          try { var rj = JSON.stringify(result); if (rj.length < 95000) sc.put(cacheKey, rj, 3600); } catch (_) {}
          return result;
        } catch (err) {
          logError('getChangeRequests', err, body);
          return { success: false, error: 'getChangeRequests failed: ' + err.message };
        }
      }

      function approveChangeRequest(body) {
        try {
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin && auth.role !== ROLE_CKK && auth.role !== ROLE_NIDD) return { success: false, error: 'Нямате право.' };
          var crId = String(body.changeRequestId || '').trim();
          var decision = String(body.decision || '').trim(); // 'approved' | 'rejected'
          if (!crId) return { success: false, error: 'Липсва changeRequestId.' };
          if (!['approved', 'rejected'].includes(decision)) return { success: false, error: 'Решението трябва да е approved или rejected.' };
          var crSheet = getChangeRequestsSheet();
          var data = crSheet.getDataRange().getValues();
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][CR_COL.ID - 1]).trim() !== crId) continue;
            var changeType = String(data[i][CR_COL.CHANGE_TYPE - 1]).trim();
            var projectId  = String(data[i][CR_COL.PROJECT_ID - 1]).trim();

            // ── Business rule: budget_change allowed only once per 12 months ──
            if (decision === 'approved' && changeType === 'budget_change' && projectId) {
              var twelveMonthsAgo = new Date(Date.now() - 365.25 * 24 * 60 * 60 * 1000).toISOString();
              for (var bc = 1; bc < data.length; bc++) {
                if (String(data[bc][CR_COL.ID - 1]).trim() === crId) continue;
                if (String(data[bc][CR_COL.PROJECT_ID - 1]).trim() !== projectId) continue;
                if (String(data[bc][CR_COL.CHANGE_TYPE - 1]).trim() !== 'budget_change') continue;
                if (String(data[bc][CR_COL.STATUS - 1]).trim() !== 'approved') continue;
                var approvedAt = String(data[bc][CR_COL.REVIEWED_AT - 1]).trim();
                if (approvedAt >= twelveMonthsAgo) {
                  return { success: false, error: 'Промяна в план-сметката е допустима само веднъж на 12 месеца. Последна одобрена промяна: ' + approvedAt.substring(0, 10) };
                }
              }
              // ── Business rule (UC-34): salary lines cannot be modified ──
              try {
                var oldBudget = JSON.parse(String(data[i][CR_COL.OLD_DATA - 1] || '{}')) || {};
                var newBudget = JSON.parse(String(data[i][CR_COL.NEW_DATA - 1] || '{}')) || {};
                var SALARY_KEYS = ['salary','salaries','wages','remuneration','wage','възнаграждения','възнаграждение','заплати','заплата'];
                function _flat(o, prefix, out) {
                  out = out || {};
                  if (!o || typeof o !== 'object') return out;
                  Object.keys(o).forEach(function(k) {
                    var v = o[k]; var key = (prefix ? prefix + '.' : '') + String(k).toLowerCase();
                    if (v && typeof v === 'object' && !Array.isArray(v)) _flat(v, key, out);
                    else out[key] = (typeof v === 'number') ? v : (Array.isArray(v) ? v.reduce(function(s,x){ return s + (Number(x)||0); }, 0) : Number(v) || 0);
                  });
                  return out;
                }
                var oldFlat = _flat(oldBudget, '', {});
                var newFlat = _flat(newBudget, '', {});
                var allKeys = Object.keys(oldFlat).concat(Object.keys(newFlat));
                for (var ki = 0; ki < allKeys.length; ki++) {
                  var k = allKeys[ki];
                  var isSalary = SALARY_KEYS.some(function(sk) { return k.indexOf(sk) !== -1; });
                  if (!isSalary) continue;
                  var ov = Number(oldFlat[k] || 0); var nv = Number(newFlat[k] || 0);
                  if (Math.abs(ov - nv) > 0.005) {
                    return { success: false, error: 'Промяна на възнагражденията е недопустима съгласно правилника. Засегнато перо: ' + k };
                  }
                }
              } catch (salErr) {
                console.warn('budget_change salary lock check failed: ' + salErr.message);
              }
            }

            // ── Business rule: leader_change — update project record on approval ──
            if (decision === 'approved' && changeType === 'leader_change' && projectId) {
              try {
                var newData = {};
                try { newData = JSON.parse(String(data[i][CR_COL.NEW_DATA - 1] || '{}')); } catch (_) {}
                if (newData.newLeaderEmail) {
                  var projSheet = getProjectsSheet();
                  var projRows = projSheet.getDataRange().getValues();
                  for (var pi = 1; pi < projRows.length; pi++) {
                    if (String(projRows[pi][PROJ_COL.ID - 1]).trim() === projectId) {
                      // Batch: up to 2 cell writes → 1 setValues round-trip.
                      var _prow = projRows[pi].slice();
                      _prow[PROJ_COL.LEADER_EMAIL - 1] = String(newData.newLeaderEmail).trim();
                      if (newData.newLeaderName) _prow[PROJ_COL.LEADER_NAME - 1] = String(newData.newLeaderName).trim();
                      projSheet.getRange(pi + 1, 1, 1, PROJ_TOTAL_COLS).setValues([_prow]);
                      console.log('[AUDIT] leaderChange applied', auth.userId, { projectId: projectId, newLeader: newData.newLeaderEmail });
                      break;
                    }
                  }
                }
              } catch (lcErr) { console.warn('Leader change apply failed: ' + lcErr.message); }
            }

            // ── Business rule: team_change — update team members on approval ──
            if (decision === 'approved' && changeType === 'team_change' && projectId) {
              try {
                var teamData = {};
                try { teamData = JSON.parse(String(data[i][CR_COL.NEW_DATA - 1] || '{}')); } catch (_) {}
                if (teamData.teamMembers) {
                  var projSheet2 = getProjectsSheet();
                  var projRows2 = projSheet2.getDataRange().getValues();
                  for (var pi2 = 1; pi2 < projRows2.length; pi2++) {
                    if (String(projRows2[pi2][PROJ_COL.ID - 1]).trim() === projectId) {
                      projSheet2.getRange(pi2 + 1, PROJ_COL.TEAM_MEMBERS).setValue(typeof teamData.teamMembers === 'string' ? teamData.teamMembers : JSON.stringify(teamData.teamMembers));
                      break;
                    }
                  }
                }
              } catch (tcErr) { console.warn('Team change apply failed: ' + tcErr.message); }
            }

            // ── App-level team / leader change (v9.52.0-teamchange) ─────────
            // PROJECT_ID in the CR is prefixed with "APP:" followed by the
            // form (application) ID. On approval we write directly to the
            // Applications sheet (getSheet()), not to Projects.
            if (decision === 'approved' && projectId && projectId.indexOf('APP:') === 0) {
              var _appFormId = projectId.slice('APP:'.length);
              try {
                var appSheet   = getSheet();
                var appFound   = findRowByID(appSheet, _appFormId);
                if (appFound) {
                  var _appRow  = appFound.rowData.slice();
                  var _appNewD = {};
                  try { _appNewD = JSON.parse(String(data[i][CR_COL.NEW_DATA - 1] || '{}')); } catch (_) {}
                  if (changeType === 'app_team_change' && _appNewD.teamMembers) {
                    _appRow[COL.TEAM_MEMBERS - 1] = typeof _appNewD.teamMembers === 'string' ? _appNewD.teamMembers : JSON.stringify(_appNewD.teamMembers);
                    safeSetRow_(appSheet, appFound.rowIndex, _appRow, TOTAL_COLS);
                    console.log('[AUDIT] app_team_change applied', auth.userId, { formId: _appFormId });
                  } else if (changeType === 'app_leader_change' && _appNewD.newLeaderEmail) {
                    _appRow[COL.USER_EMAIL - 1] = String(_appNewD.newLeaderEmail).trim().toLowerCase();
                    if (_appNewD.newLeaderName) _appRow[COL.USER_NAME - 1] = String(_appNewD.newLeaderName).trim();
                    safeSetRow_(appSheet, appFound.rowIndex, _appRow, TOTAL_COLS);
                    console.log('[AUDIT] app_leader_change applied', auth.userId, { formId: _appFormId, newLeader: _appNewD.newLeaderEmail });
                  }
                  // Invalidate caches
                  try {
                    var _ac = CacheService.getScriptCache();
                    _ac.remove('getforms:all');
                    _ac.remove('getinitialdata');
                    _ac.remove('getforms:u:' + String(appFound.rowData[COL.USER_EMAIL - 1] || '').toLowerCase().trim());
                  } catch (_) {}
                }
              } catch (_appErr) { console.warn('App team/leader change apply failed: ' + _appErr.message); }
            }

            var now = new Date().toISOString();
            // Batch all CR field updates into a single row write
            var updatedCRRow = data[i].slice();
            updatedCRRow[CR_COL.STATUS - 1] = decision;
            updatedCRRow[CR_COL.DECISION - 1] = body.notes || decision;
            updatedCRRow[CR_COL.REVIEWED_BY - 1] = auth.userId || '';
            updatedCRRow[CR_COL.REVIEWED_AT - 1] = now;
            if (body.notes) updatedCRRow[CR_COL.NOTES - 1] = body.notes;
            crSheet.getRange(i + 1, 1, 1, CR_TOTAL_COLS).setValues([updatedCRRow]);

            // Notify project leader of decision
            try {
              var pSheet = getProjectsSheet();
              var pData = pSheet.getDataRange().getValues();
              for (var pn = 1; pn < pData.length; pn++) {
                if (String(pData[pn][PROJ_COL.ID - 1]).trim() !== projectId) continue;
                var leaderMail = String(pData[pn][PROJ_COL.LEADER_EMAIL - 1]).trim();
                if (leaderMail) {
                  var typeLabels = { budget_change: 'Промяна в план-сметка', leader_change: 'Смяна на ръководител', team_change: 'Промяна в екипа', plan_update: 'Актуализация на плана', suspension: 'Спиране', termination: 'Прекратяване', addendum: 'Анекс' };
                  notifyApplicant_(leaderMail,
                    (decision === 'approved' ? '✅ Одобрено: ' : '❌ Отхвърлено: ') + (typeLabels[changeType] || changeType),
                    buildNotificationHtml_(
                      decision === 'approved' ? 'Искането за промяна е одобрено' : 'Искането за промяна е отхвърлено',
                      [{ label: 'Проект:', value: String(pData[pn][PROJ_COL.TITLE - 1]) }, { label: 'Вид:', value: typeLabels[changeType] || changeType }, { label: 'Решение:', value: decision === 'approved' ? 'Одобрено' : 'Отхвърлено' }, { label: 'Дата:', value: now.substring(0, 10) }],
                      body.notes || ''
                    ), 'status_change'
                  );
                }
                break;
              }
            } catch (_) {}

            console.log('[AUDIT] approveChangeRequest', auth.userId, { crId: crId, decision: decision, changeType: changeType });
            return { success: true };
          }
          return { success: false, error: 'Искането за промяна не е намерено.' };
        } catch (err) {
          logError('approveChangeRequest', err, body);
          return { success: false, error: 'approveChangeRequest failed: ' + err.message };
        }
      }

      // ============================================================
      //  SANCTIONS  (3-year restriction per regulation)
      // ============================================================

      function addSanction(body) {
        try {
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin && auth.role !== ROLE_CKK && auth.role !== ROLE_RECTOR) return { success: false, error: 'Нямате право да налагате санкции.' };
          var userEmail = String(body.userEmail || '').trim().toLowerCase();
          if (!userEmail || !isValidEmail(userEmail)) return { success: false, error: 'Невалиден имейл на санкционирания.' };
          var projectId = String(body.projectId || '').trim();
          var sanSheet = getSanctionsSheet();
          var id = 'SAN-' + Utilities.getUuid().replace(/-/g, '').substring(0, 12).toUpperCase();
          var now = new Date().toISOString();
          var nowDate = new Date();
          var endDate = new Date(nowDate.getFullYear() + 3, nowDate.getMonth(), nowDate.getDate()).toISOString().substring(0, 10);
          var sanRow = new Array(SAN_TOTAL_COLS).fill('');
          sanRow[SAN_COL.ID - 1] = id;
          sanRow[SAN_COL.USER_EMAIL - 1] = userEmail;
          sanRow[SAN_COL.USER_NAME - 1] = String(body.userName || '');
          sanRow[SAN_COL.PROJECT_ID - 1] = projectId;
          sanRow[SAN_COL.PROJECT_TITLE - 1] = String(body.projectTitle || '');
          sanRow[SAN_COL.DIRECTION - 1] = String(body.direction || '');
          sanRow[SAN_COL.PROJECT_CODE - 1] = String(body.projectCode || '');
          sanRow[SAN_COL.SANCTION_TYPE - 1] = body.sanctionType || 'unsatisfactory_execution';
          sanRow[SAN_COL.START_DATE - 1] = now.substring(0, 10);
          sanRow[SAN_COL.END_DATE - 1] = endDate;
          sanRow[SAN_COL.NOTES - 1] = String(body.notes || '');
          sanRow[SAN_COL.RECORDED_BY - 1] = auth.userId || '';
          sanRow[SAN_COL.RECORDED_AT - 1] = now;
          sanSheet.appendRow(sanRow);
          console.log('[AUDIT] addSanction', auth.userId, { sanctionId: id, userEmail: userEmail, projectId: projectId });
          // Financial audit trail — sanctions are a financial mutation (3y bar on funding).
          try {
            logTransaction('ADD_SANCTION', auth.userId, id, {
              userEmail: maskEmail_(userEmail), projectId: projectId,
              sanctionType: sanRow[SAN_COL.SANCTION_TYPE - 1], endDate: endDate
            });
          } catch (_) {}
          // ── Notify the sanctioned user (email_sanction toggle) ──
          var sanTypeLabel = String(body.sanctionType||'unsatisfactory_execution');
          var sanTypeMap = { unsatisfactory_execution:'Незадоволително изпълнение', breach_of_contract:'Нарушение на договор', misconduct:'Нарушение на етични норми', other:'Друго' };
          var sanLabel = sanTypeMap[sanTypeLabel] || sanTypeLabel;
          var sanProjectTitle = String(body.projectTitle||projectId||'—');
          try {
            notifyApplicant_(userEmail,
              'Наложена санкция – ' + sanProjectTitle + ' | ИУ Варна',
              buildNotificationHtml_(
                'Наложена санкция',
                [
                  { label: 'Санкция:', value: sanLabel },
                  { label: 'Проект:', value: sanProjectTitle },
                  { label: 'В сила до:', value: endDate },
                  { label: 'Последствия:', value: '3-годишна забрана за ръководство на проекти' }
                ],
                (body.notes ? 'Забележка: ' + String(body.notes).substring(0, 500) : 'Свържете се с НИДД за повече информация.')
              ),
              'sanction'
            );
          } catch (_) {}
          return { success: true, sanctionId: id, endDate: endDate };
        } catch (err) {
          logError('addSanction', err, body);
          return { success: false, error: 'addSanction failed: ' + err.message };
        }
      }

      function checkSanctions(body) {
        try {
          var auth = resolveAuthContext(body);
          var userEmail = String(body.userEmail || body.email || auth.userId || '').trim().toLowerCase();
          if (!userEmail) return { success: false, error: 'Липсва имейл за проверка.' };
          var direction = String(body.direction || '').trim();
          var projectCode = String(body.projectCode || '').trim();
          var sanSheet = getSanctionsSheet();
          var data = sanSheet.getDataRange().getValues();
          var today = new Date().toISOString().substring(0, 10);
          var activeSanctions = [];
          for (var i = 1; i < data.length; i++) {
            var r = data[i];
            if (!String(r[SAN_COL.ID - 1]).trim()) continue;
            if (String(r[SAN_COL.USER_EMAIL - 1]).trim().toLowerCase() !== userEmail) continue;
            var endDate = String(r[SAN_COL.END_DATE - 1]).trim().substring(0, 10);
            if (endDate && endDate < today) continue; // sanction expired
            var sanDirection = String(r[SAN_COL.DIRECTION - 1]).trim();
            var sanCode = String(r[SAN_COL.PROJECT_CODE - 1]).trim();
            // Direction/code filter if specified
            if (direction && sanDirection && sanDirection !== direction) continue;
            if (projectCode && sanCode && sanCode !== projectCode) continue;
            activeSanctions.push({
              id: String(r[SAN_COL.ID - 1]),
              projectId: String(r[SAN_COL.PROJECT_ID - 1]),
              projectTitle: String(r[SAN_COL.PROJECT_TITLE - 1]),
              direction: sanDirection,
              projectCode: sanCode,
              sanctionType: String(r[SAN_COL.SANCTION_TYPE - 1]),
              startDate: String(r[SAN_COL.START_DATE - 1]),
              endDate: endDate
            });
          }
          return { success: true, hasSanction: activeSanctions.length > 0, sanctions: activeSanctions };
        } catch (err) {
          logError('checkSanctions', err, body);
          return { success: false, error: 'checkSanctions failed: ' + err.message };
        }
      }

      // ============================================================
      //  ELIGIBILITY CHECK  (business rules per regulation)
      // ============================================================

      function checkEligibility(body) {
        try {
          var auth = resolveAuthContext(body);
          var leaderEmail = String(body.leaderEmail || body.email || '').trim().toLowerCase();
          var memberEmails = Array.isArray(body.memberEmails) ? body.memberEmails.map(function(e) { return String(e).trim().toLowerCase(); }) : [];
          var projectCode = String(body.projectCode || '').trim(); // ФНИ | ПНИ | etc.
          var competitionId = String(body.competitionId || '').trim();
          var currentFormId = String(body.formId || '').trim(); // exclude current form to avoid double-counting
          var proposalPriority = String(body.proposalPriority || '').trim();
          var trlLevel = Number(body.trlLevel) || 0;
          var issues = [];

          // ── 0. CKK member block (v9.37.0-regulatory) ──
          // Per Бележки и коментари.docx: "Членовете на ЦКК не участват в проектни предложения"
          if (leaderEmail && isCKKMember_(leaderEmail)) {
            issues.push({ field: 'leader', code: 'CKK_MEMBER', message: 'Членовете на ЦКК не могат да участват в проектни предложения съгласно правилника на конкурсната сесия.' });
          }
          // Also check all team members for CKK membership
          memberEmails.forEach(function(me){
            if (isCKKMember_(me)) {
              issues.push({ field: 'team', code: 'CKK_MEMBER', member: me, message: 'Членът ' + me + ' е член на ЦКК и не може да участва в проектни предложения.' });
            }
          });

          // ── 1. Leader qualification check (v6.8.0) — REMOVED (v4.9.2-informer) ──
          // Previously enforced @ue-varna.bg domain + academic title requirement.
          // Now advisory only — applicants can submit regardless of domain/title.

          // ── 2. Active sanctions check (v6.8.0) ──
          if (leaderEmail) {
            try {
              var sanCheck = checkSanctions({ userEmail: leaderEmail, projectCode: projectCode });
              if (sanCheck && sanCheck.hasSanction) {
                issues.push({ field: 'leader', code: 'SANCTION', message: 'Ръководителят е под 3-годишна санкция за незадоволително изпълнение.' });
              }
            } catch (_) {}
            // Also check direction-specific sanctions (multi-area aware)
            try {
              var dirSanctions = _checkActiveSanctions_(leaderEmail, body.direction || body.proposalPriority || '');
              if (dirSanctions && dirSanctions.hasActiveSanction) {
                issues.push({ field: 'leader', code: 'DIRECTION_SANCTION', message: 'Ръководителят има активна санкция в посоченото направление.' });
              }
            } catch (_) {}
          }

          // ── 3. Priority match check (v6.8.0 — multi-area aware) ──
          if (proposalPriority && competitionId) {
            try {
              var comp = getCompetitionById_(competitionId);
              if (comp && comp.priorityAreas) {
                var prioCheck = _checkPriorityMatch_(proposalPriority, comp.priorityAreas);
                if (prioCheck && !prioCheck.matches) {
                  issues.push({ field: 'priority', code: 'PRIORITY_MISMATCH', message: prioCheck.reason || 'Нито едно направление не съответства на приоритетите на конкурса.' });
                }
              }
            } catch (_) {}
          }

          // ── 4. TRL check for ПНИ (v6.8.0) — REMOVED (v4.9.2-informer) ──
          // Previously required TRL ≥ 4 for ПНИ projects.
          // Now advisory only.

          // ── 5. Self-assessment threshold check (v6.8.0) — REMOVED (v4.9.2-informer) ──
          // Previously blocked submission if self-assessment missing or below threshold.
          // Now advisory only.

          // ── 6. R.7/R.8 — Cross-competition project limits (existing) ──
          if ((projectCode === 'ФНИ' || projectCode === 'ПНИ') && leaderEmail) {
            try {
            var appSheet = getSheet();
            var appData = appSheet.getDataRange().getValues();
            var leaderProjects = 0;
            var memberCounts = {};
            memberEmails.forEach(function(me) { memberCounts[me] = 0; });
            var activeStatuses = ['submitted','completed','resubmitted','admin_review','admin_passed','eligible','reviewers_proposed','reviewer_assignment','reviewer_invited','reviewer_accepted','in_review','review_submitted','reviewed','scored','ranked','proposed_for_funding','approved','approved_for_funding','contract_draft','contract_package_ready','contracting','contracted','contract_signed','active','in_execution','progress_updated','expense_requested','change_requested','change_under_review','change_approved','reporting_due','report_submitted','report_under_review','report_accepted','report_returned_for_correction','final_report_prepared','final_review_submitted','final_evaluation'];
            for (var i = 1; i < appData.length; i++) {
              var r = appData[i];
              var rId = String(r[COL.ID - 1] || '').trim();
              if (currentFormId && rId === currentFormId) continue;
              var rStatus = String(r[COL.STATUS - 1]).trim();
              var rCode = String(r[COL.PROJECT_CODE - 1]).trim();
              if (rCode !== 'ФНИ' && rCode !== 'ПНИ') continue;
              if (activeStatuses.indexOf(rStatus) === -1) continue;
              if (String(r[COL.USER_EMAIL - 1]).toLowerCase() === leaderEmail) leaderProjects++;
              var team = [];
              try { team = JSON.parse(String(r[COL.TEAM_MEMBERS - 1] || '[]')); } catch (_) {}
              memberEmails.forEach(function(me) {
                if (team.some(function(m) { return String(m.email || '').toLowerCase().trim() === me; })) {
                  memberCounts[me] = (memberCounts[me] || 0) + 1;
                }
              });
            }
            if (leaderProjects >= 1) {
              issues.push({ field: 'leader', code: 'DUPLICATE_LEADER', message: 'Ръководителят вече ръководи активен проект от тип ФНИ/ПНИ (правило R.7 — само 1 проект в текущия период, независимо от конкурса).' });
            }
            memberEmails.forEach(function(me) {
              if ((memberCounts[me] || 0) >= 2) {
                issues.push({ field: 'team', code: 'TOO_MANY_PROJECTS', member: me, message: 'Членът ' + me + ' участва в 2 или повече активни проекта ФНИ/ПНИ (правило R.8 — макс. 2 в периода, независимо от конкурса).' });
              }
            });
            } catch (r78Err) { console.warn('R.7/R.8 check failed: ' + r78Err.message); }
          }

          // ── 7. Cross-validation: students cannot also be team members (v6.9.0) ──
          var studentEmails = Array.isArray(body.studentEmails) ? body.studentEmails.map(function(e) { return String(e).trim().toLowerCase(); }) : [];
          if (studentEmails.length > 0 && memberEmails.length > 0) {
            var overlaps = studentEmails.filter(function(se) { return memberEmails.indexOf(se) >= 0; });
            if (overlaps.length > 0) {
              issues.push({ field: 'team', code: 'STUDENT_IS_MEMBER', message: 'Студенти-сътрудници не могат да бъдат едновременно членове на екипа: ' + overlaps.join(', ') + '.' });
            }
          }

          return { success: true, eligible: issues.length === 0, issues: issues };
        } catch (err) {
          logError('checkEligibility', err, body);
          return { success: false, error: 'checkEligibility failed: ' + err.message };
        }
      }

      // ============================================================
      //  RANKING & RESULTS APPROVAL
      // ============================================================

      // ─────────────────────────────────────────────────────────────────────
      //  Auto-ranking trigger: invoked from submitReview after a proposal
      //  transitions to 'scored'. Ranks the entire competition only when every
      //  eligible candidate has reached 'scored' (≥ 2 reviews each); otherwise
      //  it is a no-op so administrators still see partial progress.
      // ─────────────────────────────────────────────────────────────────────
      function _maybeAutoRankCompetition_(competitionId, auth) {
        if (!competitionId) return;
        try {
          var sh = getSheet();
          var rows = sh.getDataRange().getValues();
          var totalEligible = 0;
          var totalScored = 0;
          // Statuses that count toward "still in the scoring funnel" — anything
          // that is past 'eligible' but not yet 'scored' blocks ranking.
          var BLOCKING = ['eligible','reviewer_assignment','reviewers_proposed','reviewer_invited','reviewer_accepted','in_review','reviewed'];
          for (var i = 1; i < rows.length; i++) {
            if (String(rows[i][COL.COMPETITION - 1] || '').trim() !== competitionId) continue;
            var st = String(rows[i][COL.STATUS - 1] || '').trim();
            if (st === 'scored' || BLOCKING.indexOf(st) !== -1) {
              totalEligible++;
              if (st === 'scored') totalScored++;
            }
          }
          if (totalEligible === 0 || totalScored < totalEligible) return;
          // All eligible candidates are scored → trigger ranking with elevated rights
          var rankRes = generateRanking({
            competitionId: competitionId,
            userId: (auth && auth.userId) || _SYSTEM_ADMIN_USER,
            isAdmin: true,
            role: (auth && auth.role) || ROLE_CKK,
            _autoTriggered: true
          });
          console.log('[AUDIT] _maybeAutoRankCompetition_', { competitionId: competitionId, scored: totalScored, total: totalEligible, rankRes: rankRes && rankRes.success });
        } catch (err) {
          console.warn('_maybeAutoRankCompetition_ failed: ' + err.message);
          try { logError('_maybeAutoRankCompetition_', err, { competitionId: competitionId }); } catch (_) {}
        }
      }

      function generateRanking(body) {
        try {
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin && auth.role !== ROLE_CKK) return { success: false, error: 'Нямате право.' };
          var competitionId = String(body.competitionId || '').trim();
          if (!competitionId) return { success: false, error: 'Липсва competitionId.' };
          var maxScore = Number(body.maxScore || 100);
          var threshold = maxScore / 2 + 1; // 50% + 1 per regulation

          // ── Multi-reviewer score aggregation: average scores from Reviewers sheet ──
          var revSheet = getReviewersSheet();
          var revData = revSheet.getDataRange().getValues();
          var reviewScores = {}; // formId → [score1, score2, ...]
          for (var ri = 1; ri < revData.length; ri++) {
            var revRow = revData[ri];
            var revFormId = String(revRow[REV_COL.FORM_ID - 1] || '').trim();
            var revStatus = String(revRow[REV_COL.STATUS - 1] || '').trim();
            var revComp = String(revRow[REV_COL.COMPETITION - 1] || '').trim();
            if (revComp !== competitionId) continue;
            if (revStatus !== 'reviewed') continue;
            var revScore = parseFloat(String(revRow[REV_COL.SCORE - 1] || '0')) || 0;
            if (!reviewScores[revFormId]) reviewScores[revFormId] = [];
            reviewScores[revFormId].push(revScore);
          }

          var appSheet = getSheet();
          var data = appSheet.getDataRange().getValues();
          var candidates = [];
          var unreviewed = [];
          for (var i = 1; i < data.length; i++) {
            var r = data[i];
            if (String(r[COL.COMPETITION - 1]).trim() !== competitionId) continue;
            var appStatus = String(r[COL.STATUS - 1]).trim();
            if (!['scored', 'reviewed', 'eligible'].includes(appStatus)) continue;
            var formId = String(r[COL.ID - 1]);
            // Use aggregated reviewer scores if available, else fall back to COL.SCORE
            var scores = reviewScores[formId];
            var avgScore;
            if (scores && scores.length > 0) {
              avgScore = Math.round((scores.reduce(function(a, b) { return a + b; }, 0) / scores.length) * 100) / 100;
            } else {
              avgScore = parseFloat(String(r[COL.SCORE - 1]).trim() || '0') || 0;
            }
            // Write aggregated score back to sheet
            appSheet.getRange(i + 1, COL.SCORE).setValue(avgScore);
            candidates.push({
              rowIndex: i + 1,
              id: formId,
              score: avgScore,
              area: String(r[COL.AREA - 1]).trim(),
              projectCode: String(r[COL.PROJECT_CODE - 1]).trim(),
              reviewCount: scores ? scores.length : 0,
              // Capture applicant identity here so we can email after the
              // ranking is committed without re-reading the sheet.
              email: String(r[COL.USER_EMAIL - 1] || '').trim(),
              userName: String(r[COL.USER_NAME - 1] || '').trim(),
              title: String(r[COL.TITLE - 1] || '').trim(),
              previousStatus: appStatus
            });
          }

          // Enforce 2-reviewer minimum per regulation — exclude under-reviewed candidates from ranking
          candidates.forEach(function(c) {
            if (c.reviewCount < 2) {
              unreviewed.push({ id: c.id, reviewCount: c.reviewCount });
            }
          });
          // Remove candidates with insufficient reviews from ranking pool
          candidates = candidates.filter(function(c) { return c.reviewCount >= 2; });
          if (candidates.length === 0 && unreviewed.length > 0) {
            return { success: false, error: 'Няма кандидати с поне 2 рецензии. Класиране невъзможно. Назначете рецензенти за: ' + unreviewed.map(function(u) { return u.id; }).join(', ') };
          }

          // Sort descending by score per direction AND project type.
          // Multi-area proposals (;;‑delimited) are ranked in EVERY applicable
          // group; the best rank wins. Single-area proposals fall through
          // to the existing path.
          var byGroup = {};
          candidates.forEach(function(c) {
            var areas = _getAreasArray_(c.area);
            if (!areas.length) areas = ['Без направление'];
            var code = c.projectCode || 'Без тип';
            // Register in each of the proposal's areas
            areas.forEach(function(a) {
              var groupKey = a + '::' + code;
              if (!byGroup[groupKey]) byGroup[groupKey] = [];
              // Tag with all group keys so we can pick the best rank later
              if (!c._groups) c._groups = [];
              c._groups.push(groupKey);
              byGroup[groupKey].push(c);
            });
          });
          var ranked = [];
          // Dedup map: per candidate (by id), track the best rank across all groups
          var bestByCandidate = {};
          Object.keys(byGroup).forEach(function(groupKey) {
            var sorted = byGroup[groupKey].sort(function(a, b) { return b.score - a.score; });
            sorted.forEach(function(c, idx) {
              var aboveThreshold = c.score >= threshold;
              var rank = aboveThreshold ? idx + 1 : null;
              var newStatus = aboveThreshold ? 'ranked' : 'rejected';
              // For multi-group candidates, keep the BEST rank (lowest number) across groups
              var existing = bestByCandidate[c.id];
              if (!existing) {
                bestByCandidate[c.id] = {
                  id: c.id, score: c.score, rank: rank, group: groupKey,
                  status: newStatus, aboveThreshold: aboveThreshold,
                  reviewCount: c.reviewCount, email: c.email,
                  userName: c.userName, title: c.title,
                  previousStatus: c.previousStatus, rowIndex: c.rowIndex
                };
              } else {
                // Keep the best (lowest numeric) rank; if same rank, keep first group
                if (rank != null && (existing.rank == null || rank < existing.rank)) {
                  existing.rank = rank;
                  existing.group = groupKey;
                  existing.status = newStatus;
                  existing.aboveThreshold = aboveThreshold;
                } else if (rank != null && existing.rank == null) {
                  existing.rank = rank;
                  existing.group = groupKey;
                  existing.status = newStatus;
                  existing.aboveThreshold = aboveThreshold;
                }
              }
            });
          });
          // Write final best rank/status once per candidate
          Object.keys(bestByCandidate).forEach(function(cid) {
            var c = bestByCandidate[cid];
            appSheet.getRange(c.rowIndex, COL.RANK).setValue(c.aboveThreshold ? c.rank : 'below_threshold');
            appSheet.getRange(c.rowIndex, COL.STATUS).setValue(c.status);
            ranked.push({
              id: c.id, score: c.score, rank: c.rank,
              group: c.group, status: c.status,
              aboveThreshold: c.aboveThreshold, reviewCount: c.reviewCount,
              email: c.email, userName: c.userName, title: c.title,
              previousStatus: c.previousStatus
            });
          });

          // ── Resolve competition name once for use in all email subjects ──
          var _compName = '';
          try {
            var _compSheet = getCompetitionsSheet();
            var _compData  = _compSheet.getDataRange().getValues();
            for (var _ci = 1; _ci < _compData.length; _ci++) {
              if (String(_compData[_ci][COMP_COL.ID - 1]).trim() === competitionId) {
                _compName = String(_compData[_ci][COMP_COL.NAME - 1] || '').trim();
                break;
              }
            }
          } catch (_) {}

          // ── Notify each applicant of their ranking outcome ──
          // Sent best-effort: a single failure must NOT abort the ranking.
          // Emails are guarded by isValidEmail() and MailApp daily quota inside
          // notifyStatusChange_/notifyApplicant_, so quota exhaustion logs
          // a warning and continues.
          ranked.forEach(function(it) {
            if (!it.email || !isValidEmail(it.email)) return;
            try {
              if (it.aboveThreshold) {
                var heading = '🏆 Вашият проект е класиран';
                var lines = [
                  { label: 'Заявление:',     value: it.id },
                  { label: 'Заглавие:',      value: it.title || '(без заглавие)' },
                  { label: 'Конкурс:',       value: _compName || competitionId },
                  { label: 'Оценка:',        value: it.score + ' т. (праг ' + threshold + ' т.)' },
                  { label: 'Класиране:',     value: '#' + it.rank + ' в направление ' + (it.group ? it.group.replace(/::/g, ' / ') : '—') },
                  { label: 'Статус:',        value: 'Класирано' },
                  { label: 'Брой рецензии:', value: String(it.reviewCount) },
                  { label: 'Дата:',          value: new Date().toLocaleString('bg-BG', { timeZone: 'Europe/Sofia' }) }
                ];
                var footer = 'Поздравления! Вашият проект е класиран над прага и предстои разглеждане за финансиране от Академичния съвет. Ще получите ново писмо при одобрение.';
                notifyApplicant_(it.email, 'Конкурс ' + (_compName || competitionId) + ' – класиране #' + it.rank, buildNotificationHtml_(heading, lines, footer), 'status_change');
              } else {
                var hdr2 = '📋 Резултат от оценяване';
                var l2 = [
                  { label: 'Заявление:',     value: it.id },
                  { label: 'Заглавие:',      value: it.title || '(без заглавие)' },
                  { label: 'Конкурс:',       value: _compName || competitionId },
                  { label: 'Оценка:',        value: it.score + ' т. (праг ' + threshold + ' т.)' },
                  { label: 'Статус:',        value: 'Под прага за класиране' },
                  { label: 'Брой рецензии:', value: String(it.reviewCount) },
                  { label: 'Дата:',          value: new Date().toLocaleString('bg-BG', { timeZone: 'Europe/Sofia' }) }
                ];
                var f2 = 'Благодарим Ви за подаденото предложение. За съжаление оценката е под минималния праг за класиране в този конкурс. За допълнителна информация можете да се обърнете към администратора.';
                notifyApplicant_(it.email, 'Конкурс ' + (_compName || competitionId) + ' – резултат', buildNotificationHtml_(hdr2, l2, f2), 'status_change');
              }
            } catch (notifyErr) {
              console.warn('generateRanking notify failed for ' + it.id + ': ' + notifyErr.message);
            }
          });

          console.log('[AUDIT] generateRanking', auth.userId, { competitionId: competitionId, ranked: ranked.length, unreviewedWarnings: unreviewed.length });
          return { success: true, ranked: ranked, threshold: threshold, unreviewedWarnings: unreviewed, competitionName: _compName };
        } catch (err) {
          logError('generateRanking', err, body);
          return { success: false, error: 'generateRanking failed: ' + err.message };
        }
      }

      function approveResults(body) {
        try {
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin && auth.role !== ROLE_CKK && auth.role !== ROLE_RECTOR && auth.role !== ROLE_ACADEMIC_COUNCIL) return { success: false, error: 'Нямате право.' };
          var competitionId = String(body.competitionId || '').trim();
          if (!competitionId) return { success: false, error: 'Липсва competitionId.' };
          var appSheet = getSheet();
          var data = appSheet.getDataRange().getValues();

          // Resolve competition name once for email subjects
          var _compName = '';
          try {
            var _compSheet = getCompetitionsSheet();
            var _compData  = _compSheet.getDataRange().getValues();
            for (var _ci = 1; _ci < _compData.length; _ci++) {
              if (String(_compData[_ci][COMP_COL.ID - 1]).trim() === competitionId) {
                _compName = String(_compData[_ci][COMP_COL.NAME - 1] || '').trim();
                break;
              }
            }
          } catch (_) {}

          var updated = 0;
          var _toNotify = [];
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][COL.COMPETITION - 1]).trim() !== competitionId) continue;
            if (String(data[i][COL.STATUS - 1]).trim() !== 'ranked') continue;
            appSheet.getRange(i + 1, COL.STATUS).setValue('approved_for_funding');
            updated++;
            _toNotify.push({
              id      : String(data[i][COL.ID - 1]),
              email   : String(data[i][COL.USER_EMAIL - 1] || '').trim(),
              userName: String(data[i][COL.USER_NAME - 1] || '').trim(),
              title   : String(data[i][COL.TITLE - 1] || '').trim(),
              score   : Number(data[i][COL.SCORE - 1]) || 0,
              rank    : data[i][COL.RANK - 1]
            });
          }

          // Email each newly-approved applicant. Best-effort, errors logged.
          _toNotify.forEach(function(it) {
            if (!it.email || !isValidEmail(it.email)) return;
            try {
              var heading = '✅ Вашият проект е одобрен за финансиране';
              var lines = [
                { label: 'Заявление:', value: it.id },
                { label: 'Заглавие:',  value: it.title || '(без заглавие)' },
                { label: 'Конкурс:',   value: _compName || competitionId },
                { label: 'Оценка:',    value: (it.score || '—') + ' т.' },
                { label: 'Класиране:', value: it.rank ? '#' + it.rank : '—' },
                { label: 'Статус:',    value: 'Одобрено за финансиране' },
                { label: 'Дата:',      value: new Date().toLocaleString('bg-BG', { timeZone: 'Europe/Sofia' }) }
              ];
              var footer = 'Поздравления! Академичният съвет одобри Вашия проект за финансиране. Предстои генериране и подписване на договор. Ще получите ново писмо с инструкции в системата.';
              notifyApplicant_(it.email, 'Конкурс ' + (_compName || competitionId) + ' – одобрено за финансиране', buildNotificationHtml_(heading, lines, footer), 'status_change');
            } catch (notifyErr) {
              console.warn('approveResults notify failed for ' + it.id + ': ' + notifyErr.message);
            }
          });

          console.log('[AUDIT] approveResults', auth.userId, { competitionId: competitionId, approvedCount: updated });
          return { success: true, approvedCount: updated, notified: _toNotify.filter(function(x){return x.email && isValidEmail(x.email);}).length };
        } catch (err) {
          logError('approveResults', err, body);
          return { success: false, error: 'approveResults failed: ' + err.message };
        }
      }

      /**
       * UC-22 (Workflow spec, Stage 7) — Academic Council ratifies the contest
       * ranking before public broadcast. Required by the regulation: "Резултатите
       * се докладват на зам.-ректора, след което се приемат от Академичния съвет
       * и се публикуват." Flips competition status from 'closed' (CKK ranking
       * finalised) to 'results_approved_by_ac'. After this, publishResults can
       * proceed (now strictly gated by COMP_TRANSITIONS).
       *
       * Body: { competitionId, sessionMinutesId?, decisionRef?, signature? }
       * Roles: Rector, Admin (AC sessions are recorded by Rector's office).
       */
      function acceptContestResultsByAC(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin && auth.role !== ROLE_RECTOR && auth.role !== ROLE_VICE_RECTOR) {
            return { success: false, error: 'Нямате право. Само Ректор/Зам.-ректор/Администратор могат да отбелязват решението на АС.' };
          }
          var competitionId = String(body.competitionId || '').trim();
          if (!competitionId) return { success: false, error: 'Липсва competitionId.' };
          var compSheet = getCompetitionsSheet();
          var compData = compSheet.getDataRange().getValues();
          for (var i = 1; i < compData.length; i++) {
            if (String(compData[i][COMP_COL.ID - 1]).trim() !== competitionId) continue;
            var currentStatus = normalizeCompetitionStatus_(compData[i][COMP_COL.STATUS - 1]);
            if (!validateCompTransition_(currentStatus, 'results_approved_by_ac')) {
              return { success: false, error: 'Невалиден преход: ' + currentStatus + ' → results_approved_by_ac. Допустими: ' + (COMP_TRANSITIONS[currentStatus] || []).join(', ') };
            }
            compSheet.getRange(i + 1, COMP_COL.STATUS).setValue('results_approved_by_ac');
            var meta = {
              decisionRef: String(body.decisionRef || '').trim(),
              sessionMinutesId: String(body.sessionMinutesId || '').trim(),
              ratifiedAt: new Date().toISOString(),
              ratifiedBy: auth.userId
            };
            logTransaction('AC_ACCEPT_CONTEST_RESULTS', auth.userId, competitionId, meta);
            try { publishCompetitionsFeed_(); } catch (_) {}
            return { success: true, status: 'results_approved_by_ac', meta: meta };
          }
          return { success: false, error: 'Конкурсът не е намерен.' };
        } catch (err) {
          logError('acceptContestResultsByAC', err, body);
          return { success: false, error: 'acceptContestResultsByAC failed: ' + err.message };
        }
      }

      function publishResults(body) {
        try {
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin && auth.role !== ROLE_RECTOR && auth.role !== ROLE_CKK) return { success: false, error: 'Нямате право.' };
          var competitionId = String(body.competitionId || '').trim();
          if (!competitionId) return { success: false, error: 'Липсва competitionId.' };
          var compSheet = getCompetitionsSheet();
          var compData = compSheet.getDataRange().getValues();
          var compName = '';
          var publishedRow = -1;
          for (var i = 1; i < compData.length; i++) {
            if (String(compData[i][COMP_COL.ID - 1]).trim() === competitionId) {
              var currentStatus = normalizeCompetitionStatus_(compData[i][COMP_COL.STATUS - 1]);
              if (!validateCompTransition_(currentStatus, 'results_published')) {
                return { success: false, error: 'Невалиден преход: ' + currentStatus + ' → results_published. Допустими: ' + (COMP_TRANSITIONS[currentStatus] || []).join(', ') };
              }
              compSheet.getRange(i + 1, COMP_COL.STATUS).setValue('results_published');
              compName = String(compData[i][COMP_COL.NAME - 1] || '').trim();
              publishedRow = i + 1;
              break;
            }
          }
          if (publishedRow < 0) return { success: false, error: 'Конкурсът не е намерен.' };

          // ── Notify all applicants in this competition that results are public ──
          // Each recipient gets a tailored line ("Класиране #N – Одобрен" /
          // "Под прага" / "В процес"), so the same broadcast doubles as the
          // personal status notice. Best-effort with per-row try/catch.
          var notified = 0;
          try {
            var appSheet = getSheet();
            var data = appSheet.getDataRange().getValues();
            var nowStr = new Date().toLocaleString('bg-BG', { timeZone: 'Europe/Sofia' });
            for (var ai = 1; ai < data.length; ai++) {
              if (String(data[ai][COL.COMPETITION - 1]).trim() !== competitionId) continue;
              var email = String(data[ai][COL.USER_EMAIL - 1] || '').trim();
              if (!email || !isValidEmail(email)) continue;
              var fid    = String(data[ai][COL.ID - 1]);
              var title  = String(data[ai][COL.TITLE - 1] || '').trim();
              var status = String(data[ai][COL.STATUS - 1] || '').trim();
              var score  = Number(data[ai][COL.SCORE - 1]) || 0;
              var rank   = data[ai][COL.RANK - 1];
              var verdict;
              if (status === 'approved_for_funding' || status === 'approved') verdict = '✅ Одобрено за финансиране';
              else if (status === 'ranked') verdict = '🏆 Класирано (предстои одобрение)';
              else if (status === 'rejected') verdict = '❌ Под прага за класиране';
              else verdict = NOTIFY_STATUS_LABELS_[status] || status || '—';
              try {
                var lines = [
                  { label: 'Заявление:', value: fid },
                  { label: 'Заглавие:',  value: title || '(без заглавие)' },
                  { label: 'Конкурс:',   value: compName || competitionId },
                  { label: 'Оценка:',    value: score ? (score + ' т.') : '—' },
                  { label: 'Класиране:', value: (rank && rank !== 'below_threshold') ? '#' + rank : (rank === 'below_threshold' ? 'под прага' : '—') },
                  { label: 'Резултат:',  value: verdict },
                  { label: 'Дата:',      value: nowStr }
                ];
                var heading = '📢 Резултатите от конкурса са публикувани';
                var footer  = 'Резултатите са официално публикувани. Можете да проверите детайли в системата ERP.';
                notifyApplicant_(email, 'Конкурс ' + (compName || competitionId) + ' – публикувани резултати', buildNotificationHtml_(heading, lines, footer), 'status_change');
                notified++;
              } catch (notifyErr) {
                console.warn('publishResults notify failed for ' + fid + ': ' + notifyErr.message);
              }
            }
          } catch (broadcastErr) {
            console.warn('publishResults broadcast loop failed: ' + broadcastErr.message);
          }

          // Refresh public competitions feed so external mirrors pick up the
          // new "results_published" status immediately.
          try { publishCompetitionsFeed_(); } catch (_) {}

          console.log('[AUDIT] publishResults', auth.userId, { competitionId: competitionId, notified: notified });
          return { success: true, notified: notified };
        } catch (err) {
          logError('publishResults', err, body);
          return { success: false, error: 'publishResults failed: ' + err.message };
        }
      }

