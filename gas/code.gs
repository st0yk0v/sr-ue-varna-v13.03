        var elapsed = Date.now() - startTime;
        return {
          success: errors.length === 0,
          mirrored: results,
          totalRecords: Object.keys(results).reduce(function(sum, k) { return sum + (results[k] || 0); }, 0),
          elapsedMs: elapsed,
          errors: errors.length ? errors : undefined
