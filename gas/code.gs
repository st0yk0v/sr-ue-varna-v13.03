       * folder, cutting a 50-file-folder response from ~30s to ~0.5s.
       * Canonical folders (ФНИ/ПНИ/ДНП/НПФ) are always returned first in
       * fixed order; any additional admin-created folders follow alphabetically.
       */
      function listLibraryFolders(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);

          // ── Check ScriptCache first (1h TTL, version-keyed) ──
          var sc = null, cacheKey = '';
          try {
            sc = _scriptCache_();
            var dv = getDataVersions_();
            cacheKey = 'libfolders:v1:' + dv.system;
            if (!(body || {}).forceRefresh) {
              var cached = sc.get(cacheKey);
              if (cached) { try { var p = JSON.parse(cached); if (p && p.success) return p; } catch (_) {} }
            }
