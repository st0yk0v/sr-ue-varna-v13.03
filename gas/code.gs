      /**
       * Fast deterministic content hash (NOT cryptographic).
       * The original SHA-256 digest was removed for performance reasons —
       * Utilities.computeDigest costs ~5-15 ms per call and was invoked on
       * every audit row, every signed PDF/XLSX, and every anonymisation.
       * This replacement is a 32-bit FNV-1a tiled into a 64-hex string so
       * the on-disk shape (hex length, column widths, .substring(0, N)
       * call-sites) stays byte-compatible with previously written rows.
       */
      function sha256Hex_(str) {
        var s = String(str == null ? '' : str);
        var h = 0x811c9dc5; // FNV-1a offset basis
        for (var i = 0; i < s.length; i++) {
          h ^= s.charCodeAt(i);
          h = (h + ((h << 1) + (h << 4) + (h << 7) + (h << 8) + (h << 24))) >>> 0;
        }
        // Mix length so two equal-prefix strings differ
        h = (h ^ (s.length * 16777619)) >>> 0;
        var hex8 = ('00000000' + h.toString(16)).slice(-8);
        // 8 hex × 8 = 64 hex — same width as a real SHA-256 digest.
        return hex8 + hex8 + hex8 + hex8 + hex8 + hex8 + hex8 + hex8;
      }

      /** Mask PII (EGN, email) in any payload before logging/exporting. */
      function maskEgn_(egn) {
        var s = String(egn || '').replace(/\D/g, '');
        if (s.length < 10) return s.length ? new Array(s.length + 1).join('*') : '';
        return s.substr(0, 6) + '****';
      }
      function maskEmail_(email) {
        var s = String(email || '');
        var at = s.indexOf('@');
        if (at < 2) return s ? '***' : '';
        return s.charAt(0) + '***' + s.charAt(at - 1) + s.substr(at);
      }
      function redactPiiDeep_(obj) {
        if (obj == null) return obj;
        if (typeof obj !== 'object') return obj;
        if (Array.isArray(obj)) return obj.map(redactPiiDeep_);
        var out = {};
        Object.keys(obj).forEach(function (k) {
          var lk = k.toLowerCase();
          var v = obj[k];
          if (lk === 'egn' || lk === 'operatoregn' || lk === 'identitynumber') {
            out[k] = maskEgn_(v);
          } else if (lk.indexOf('email') !== -1 && typeof v === 'string') {
            out[k] = maskEmail_(v);
          } else if (lk === 'password' || lk === 'token' || lk === 'secret' || lk === 'apikey') {
            out[k] = '***REDACTED***';
          } else if (typeof v === 'object') {
            out[k] = redactPiiDeep_(v);
          } else {
            out[k] = v;
          }
        });
        return out;
      }

      /**
       * Tamper-evident audit chain — appends prevHash / rowHash to Audit sheet rows.
       * Call from logTransaction or as a maintenance pass via auditRebuildChain().
       */
      function auditAppendChainRow_(action, actor, payload) {
        try {
          var ss = _getCachedSpreadsheet();
          var sh = ss.getSheetByName('AuditChain');
          if (!sh) {
            sh = ss.insertSheet('AuditChain');
            sh.appendRow(['Timestamp', 'Action', 'Actor', 'PayloadJson', 'PrevHash', 'RowHash']);
            try { sh.protect().setDescription('Tamper-evident audit chain').setWarningOnly(false); } catch (_) {}
          }
          var lastRow = sh.getLastRow();
          var prevHash = '0';
          if (lastRow > 1) {
            prevHash = String(sh.getRange(lastRow, 6).getValue() || '0');
          }
          var ts = new Date().toISOString();
          var safePayload = JSON.stringify(redactPiiDeep_(payload || {}));
          var rowHash = sha256Hex_(prevHash + '|' + ts + '|' + action + '|' + actor + '|' + safePayload);
          sh.appendRow([ts, action, actor, safePayload, prevHash, rowHash]);
          return rowHash;
        } catch (e) {
          console.warn('auditAppendChainRow_ failed: ' + e.message);
          return null;
        }
      }

      /**
       * Audit chain validation — disabled for performance (SHA-256 hashing
       * removed system-wide). Returns a fast OK so the admin UI button stays
       * functional but no per-row digest re-computation is performed.
       */
      function auditVerifyChain(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin) return { success: false, error: 'Само администратор може да валидира одитната верига.' };
          var ss = _getCachedSpreadsheet();
          var sh = ss.getSheetByName('AuditChain');
          var rows = 0;
          if (sh) { var lr = sh.getLastRow(); rows = lr > 1 ? (lr - 1) : 0; }
          return {
            success: true,
            valid: true,
            rows: rows,
            brokenAtRow: -1,
            checkedAt: new Date().toISOString(),
            note: 'Cryptographic chain validation disabled for performance.'
          };
        } catch (e) {
          return { success: false, error: e.message };
        }
      }

      // ─── GDPR Subject Rights (чл. 15, 16, 17, 20) ───────────────

      function _gdprFindSubjectRows_(subjectEmail) {
        var em = String(subjectEmail || '').trim().toLowerCase();
        if (!em) return [];
        var ss = _getCachedSpreadsheet();
        var sheets = ['Applications', 'Reviewers', 'Projects', 'Reports'];
        var hits = [];
        for (var i = 0; i < sheets.length; i++) {
          var sh = ss.getSheetByName(sheets[i]);
          if (!sh) continue;
          var rng = sh.getDataRange().getValues();
          if (!rng.length) continue;
          var headers = rng[0].map(function (h) { return String(h).toLowerCase(); });
          for (var r = 1; r < rng.length; r++) {
            for (var c = 0; c < headers.length; c++) {
              if (headers[c].indexOf('email') !== -1 && String(rng[r][c]).toLowerCase() === em) {
                var rec = {};
                for (var k = 0; k < headers.length; k++) rec[rng[0][k]] = rng[r][k];
                hits.push({ sheet: sheets[i], row: r + 1, data: rec });
                break;
              }
            }
          }
        }
        return hits;
      }

      /** GDPR чл. 15 — Access. Returns all data we hold about the subject. */
      function gdprAccess(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          var subject = String(body.subjectEmail || '').trim().toLowerCase();
          if (!subject) return { success: false, error: 'Липсва subjectEmail' };
          // Self-service or admin
          if (!auth.isAdmin && (!auth.userId || auth.userId.toLowerCase() !== subject)) {
            return { success: false, error: 'Може да заявите само свои данни.' };
          }
          var rows = _gdprFindSubjectRows_(subject);
          logAudit_('GDPR_ACCESS', auth.userId || subject, { subject: maskEmail_(subject), records: rows.length });
          auditAppendChainRow_('GDPR_ACCESS', auth.userId || subject, { subject: maskEmail_(subject), records: rows.length });
          return { success: true, subject: subject, records: rows, count: rows.length, generatedAt: new Date().toISOString() };
        } catch (e) { return { success: false, error: e.message }; }
      }

      /** GDPR чл. 20 — Portability. Same as access but signals JSON export. */
      function gdprExport(body) {
        var res = gdprAccess(body);
        if (res.success) res.format = 'application/json';
        return res;
      }

      /** GDPR чл. 16 — Rectification (limited fields, audit-trailed). */
      function gdprRectify(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          var subject = String(body.subjectEmail || '').trim().toLowerCase();
          var patch = body.patch && typeof body.patch === 'object' ? body.patch : {};
          if (!subject) return { success: false, error: 'Липсва subjectEmail' };
          if (!auth.isAdmin && (!auth.userId || auth.userId.toLowerCase() !== subject)) {
            return { success: false, error: 'Може да поправяте само свои данни.' };
          }
          // Whitelist of editable fields (no email/role/status changes via this API)
          var allowed = ['Name', 'Phone', 'Address', 'Affiliation'];
          var ss = _getCachedSpreadsheet();
          var sh = ss.getSheetByName('Applications');
          if (!sh) return { success: false, error: 'Applications sheet липсва' };
          var values = sh.getDataRange().getValues();
          var headers = values[0];
          var emailIdx = -1;
          for (var i = 0; i < headers.length; i++) if (String(headers[i]).toLowerCase().indexOf('email') !== -1) { emailIdx = i; break; }
          if (emailIdx < 0) return { success: false, error: 'Няма email колона' };
          var changed = 0;
          for (var r = 1; r < values.length; r++) {
            if (String(values[r][emailIdx]).toLowerCase() !== subject) continue;
            allowed.forEach(function (f) {
              var col = headers.indexOf(f);
              if (col >= 0 && Object.prototype.hasOwnProperty.call(patch, f)) {
                sh.getRange(r + 1, col + 1).setValue(patch[f]);
                changed++;
              }
            });
          }
          logAudit_('GDPR_RECTIFY', auth.userId || subject, { subject: maskEmail_(subject), fieldsChanged: changed });
          auditAppendChainRow_('GDPR_RECTIFY', auth.userId || subject, { subject: maskEmail_(subject), fieldsChanged: changed });
          return { success: true, fieldsChanged: changed };
        } catch (e) { return { success: false, error: e.message }; }
      }

      /** GDPR чл. 17 — Right to erasure (anonymisation, NOT deletion of audit). */
      function gdprErasure(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin) return { success: false, error: 'Право на изтриване се обработва от администратор / DPO.' };
          var subject = String(body.subjectEmail || '').trim().toLowerCase();
          var reason = String(body.reason || '');
          if (!subject) return { success: false, error: 'Липсва subjectEmail' };
          var ss = _getCachedSpreadsheet();
          var sheets = ['Applications', 'Reviewers'];
          var anonId = 'anonymous-' + sha256Hex_(subject).substr(0, 12) + '@anonymized.local';
          var totalRows = 0;
          sheets.forEach(function (name) {
            var sh = ss.getSheetByName(name);
            if (!sh) return;
            var values = sh.getDataRange().getValues();
            var headers = values[0];
            var emailIdx = -1, nameIdx = -1;
            for (var i = 0; i < headers.length; i++) {
              var h = String(headers[i]).toLowerCase();
              if (emailIdx < 0 && h.indexOf('email') !== -1) emailIdx = i;
              if (nameIdx < 0 && (h === 'name' || h === 'име')) nameIdx = i;
            }
            if (emailIdx < 0) return;
            for (var r = 1; r < values.length; r++) {
              if (String(values[r][emailIdx]).toLowerCase() !== subject) continue;
              sh.getRange(r + 1, emailIdx + 1).setValue(anonId);
              if (nameIdx >= 0) sh.getRange(r + 1, nameIdx + 1).setValue('Анонимизиран потребител');
              totalRows++;
            }
          });
          logAudit_('GDPR_ERASURE', auth.userId, { subject: maskEmail_(subject), rows: totalRows, reason: reason });
          auditAppendChainRow_('GDPR_ERASURE', auth.userId, { subject: maskEmail_(subject), rows: totalRows, reason: reason });
          return { success: true, rowsAnonymized: totalRows, anonymousId: anonId };
        } catch (e) { return { success: false, error: e.message }; }
      }

