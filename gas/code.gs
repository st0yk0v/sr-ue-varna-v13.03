      /**
       * Master sync — refreshes all three derived sheets.
       * Called after every mutation via postProcessMutation_.
       */
      function syncAllDerivedSheets_(force) {
        // Throttle: derived sheets (Табло, Активни Конкурси, Участия) are
        // human-readable mirrors only — никой код не чете от тях. PERF_MODE
        // удължава прозореца до 15 мин (от 3 мин) така че мутациите не плащат
        // 3-sheet refresh latency. Ръчният sync чрез менюто игнорира throttle.
        var props = _scriptProps_();
        var mustForce = force === true || force === 'true';
        var lastSync = Number(props.getProperty('TS_LAST_DERIVED_SYNC') || 0);
        var throttleMs = PERF_MODE ? 900000 : 180000;
        if (!mustForce && Date.now() - lastSync < throttleMs) return;
        props.setProperty('TS_LAST_DERIVED_SYNC', String(Date.now()));

        try { syncDashboardSheet_(); } catch (e) { console.warn('Dashboard sync: ' + e.message); }
        try { syncActiveContestsSheet_(); } catch (e) { console.warn('ActiveContests sync: ' + e.message); }
        try { syncParticipationSheet_(); } catch (e) { console.warn('Participation sync: ' + e.message); }
      }

      /**
       * Manual endpoint for admin to trigger derived sheet sync.
       * Also available from Sheets menu.
       */
      function manualSyncDerivedSheets(body) {
        try {
          var auth = resolveAuthContext(body || {});
          if (!auth.isAdmin) return { success: false, error: 'Само администратори могат да синхронизират таблата.' };
          syncAllDerivedSheets_(true);
          return { success: true, message: 'Таблата са обновени успешно (Табло, Активни Конкурси, Участия).' };
        } catch (err) {
          return { success: false, error: 'syncDerivedSheets failed: ' + err.message };
        }
      }

      /**
       * Public API: getContestBoard — returns active contests with applicant counts.
       * Applicants call this to browse available contests to apply to.
       */
      function getContestBoard(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          var userId = auth.userId;
          var forceRefresh = body.forceRefresh === true || body.forceRefresh === 'true';

          // Version-based cache key — survives across requests until either
          // Competitions or Applications actually changes. 5 min TTL.
          var cacheKey = '';
          var sc = _scriptCache_();
          try {
            var dv = getDataVersions_();
            cacheKey = 'cb:v2:' + (userId || 'anon') + ':' + dv.competitions + ':' + dv.applications;
            if (!forceRefresh) {
              var cached = sc.get(cacheKey);
              if (cached) {
                var cachedBoard = JSON.parse(cached);
                if (cachedBoard && cachedBoard.success) {
                  cachedBoard.cached = true;
                  return cachedBoard;
                }
              }
            }
          } catch (_) {}

          var competitions = getOrCacheCompetitions(forceRefresh);
          var now = Date.now();

          // Count applications per competition. Only read the columns we need
          // (COMPETITION, USER_EMAIL, ID, TITLE, STATUS) instead of the full row.
          var sheet = getSheet();
          var lastRow = sheet.getLastRow();
          var appCounts = {};
          var userApplied = {}; // track which contests this user already applied to
          if (lastRow > 1) {
            // Determine the maximum column index we need
            var minCol = Math.min(COL.COMPETITION, COL.USER_EMAIL, COL.ID, COL.TITLE, COL.STATUS);
            var maxCol = Math.max(COL.COMPETITION, COL.USER_EMAIL, COL.ID, COL.TITLE, COL.STATUS);
            var data = sheet.getRange(2, minCol, lastRow - 1, maxCol - minCol + 1).getValues();
            var iComp  = COL.COMPETITION - minCol;
            var iEmail = COL.USER_EMAIL  - minCol;
            var iId    = COL.ID          - minCol;
            var iTitle = COL.TITLE       - minCol;
            var iStat  = COL.STATUS      - minCol;
            for (var i = 0; i < data.length; i++) {
              var row = data[i];
              var cid = String(row[iComp] || '').trim();
              if (!cid) continue;
              appCounts[cid] = (appCounts[cid] || 0) + 1;
              if (userId && String(row[iEmail] || '').toLowerCase().trim() === userId) {
                if (!userApplied[cid]) userApplied[cid] = [];
                userApplied[cid].push({
                  id: String(row[iId]),
                  title: String(row[iTitle] || ''),
                  status: String(row[iStat] || 'draft')
                });
              }
            }
          }

          var board = [];
          for (var c = 0; c < competitions.length; c++) {
            var comp = competitions[c];
            if (!shouldExposeCompetitionToApplicant_(comp)) continue;
            var dl = String(comp.deadline || comp.dateEnd || '').trim();
            var daysLeft = null;
            var canApply = true;
            if (dl) {
              var dlDate = new Date(dl);
              if (!isNaN(dlDate.getTime())) {
                if (/^\d{4}-\d{2}-\d{2}$/.test(dl)) dlDate.setHours(23, 59, 59, 999);
                daysLeft = Math.max(0, Math.ceil((dlDate.getTime() - now) / 86400000));
                if (dlDate.getTime() < now) canApply = false;
              }
            }
            var norm = normalizeCompetitionStatus_(comp.status);
            if (norm === 'closed' || norm === 'results_published' || norm === 'archived') canApply = false;

            board.push({
              id: String(comp.id || ''),
              name: String(comp.name || ''),
              deadline: dl,
              daysRemaining: daysLeft,
              description: String(comp.description || ''),
              status: norm,
              applicantCount: appCounts[comp.id] || 0,
              canApply: canApply,
              myApplications: userApplied[comp.id] || []
            });
          }

          board.sort(function(a, b) {
            if (a.canApply !== b.canApply) return a.canApply ? -1 : 1;
            return (a.daysRemaining || 9999) - (b.daysRemaining || 9999);
          });

          var result = { success: true, board: board, total: board.length };
          if (cacheKey) {
            try {
              var json = JSON.stringify(result);
              if (json.length < 95000) sc.put(cacheKey, json, 3600);
            } catch (_) {}
          }
          return result;
        } catch (err) {
          logError('getContestBoard', err, body);
          return { success: false, error: 'getContestBoard failed: ' + err.message };
        }
      }

