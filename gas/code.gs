            }
          }

          var history = safeParseJSON(rowData[COL.HISTORY - 1], []);
          var now     = nowISO();
          var actor   = body.userName || (userId === _SYSTEM_ADMIN_USER ? 'Администратор' : userId);

          // ── 5-business-day correction deadline (per regulation) ──
          var correctionDeadline = null;
          if (newStatus === 'returned' || newStatus === 'needs_correction') {
            var corrDate = new Date();
            var bizDays = 0;
            while (bizDays < 5) {
