      function testEmailNotification(body) {
        try {
          var auth = resolveAuthContext(body || {});
          if (!auth.isAdmin) return { success: false, error: 'Admin access required for email test.' };

          var targetEmail = String(body.email || body.targetEmail || auth.userId || '').toLowerCase().trim();
          if (!targetEmail || !isValidEmail(targetEmail)) {
            return { success: false, error: 'Provide a valid email in body.email or body.targetEmail. Received: "' + targetEmail + '"' };
          }

          var quota = -1;
          try { quota = MailApp.getRemainingDailyQuota(); } catch (qErr) {
            return { success: false, error: 'MailApp.getRemainingDailyQuota() failed: ' + qErr.message, hint: 'The MailApp service may not be authorized. Re-deploy and authorize the "https://www.googleapis.com/auth/script.send_mail" scope.' };
          }

          if (quota <= 0) {
            return { success: false, error: 'Daily email quota exhausted (remaining: ' + quota + '). Wait until quota resets (midnight Pacific Time).' };
          }

          var heading = '✅ Тестово съобщение от ERP';
          var lines = [
            { label: 'До:', value: targetEmail },
            { label: 'Дата:', value: new Date().toLocaleString('bg-BG', { timeZone: 'Europe/Sofia' }) },
            { label: 'Квота:', value: quota + ' имейла оставащи днес' }
          ];
          var footer = 'Ако виждате това съобщение, имейл нотификациите работят коректно.';
          var html = buildNotificationHtml_(heading, lines, footer);

          try {
            // ── Inline SVG logos (v3.33.0) — already embedded in the HTML ──
            var sendOpts = {
              to: targetEmail,
              subject: 'ERP Тест за имейл нотификации',
              htmlBody: html,
              noReply: true,
              name: 'ERP Научни проекти – ИУ Варна',
              replyTo: 'science@ue-varna.bg'
            };
            MailApp.sendEmail(sendOpts);
          } catch (sendErr) {
            return { success: false, error: 'MailApp.sendEmail failed: ' + sendErr.message, quota: quota, hint: 'Check OAuth scopes. Required: https://www.googleapis.com/auth/script.send_mail' };
          }

          return { success: true, message: 'Test email sent to ' + targetEmail, quota: quota - 1, email: targetEmail };
        } catch (err) {
          return { success: false, error: 'testEmailNotification failed: ' + err.message };
        }
      }

