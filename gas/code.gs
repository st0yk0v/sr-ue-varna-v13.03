              ckkData.push({ email: ckkList[ci], name: '', added_by: 'system', added_at: nowISO(), is_active: 1 });
            }
            if (ckkData.length) {
              var ckkRes = _pushToHostinger_('ckk_members', ckkData);
              results.ckk_members = ckkRes.success ? ckkData.length : 0;
              if (!ckkRes.success) errors.push('ckk_members: ' + (ckkRes.error || 'unknown'));
            } else { results.ckk_members = 0; }
          } catch (e) { errors.push('ckk_members: ' + e.message); }
