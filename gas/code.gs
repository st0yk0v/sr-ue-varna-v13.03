        } catch (_) { /* silent */ }
      }

      /**
       * v10.4.1-hostingerdb: Export current data to Applications.xlsx-compatible
       * format in Drive for download/backup. Also syncs the XLSX metadata to MySQL.
       * @param {string} [userEmail] — optional user filter
       * @returns {Object} — { success, fileId, fileName }
       */
      function _exportApplicationsXLSX_(userEmail) {
        try {
          var formsData = userEmail
            ? getForms({ userId: userEmail, isAdmin: false, lean: false,
                forceRefresh: true, __skipReauth: true })
            : getForms({ isAdmin: true, lean: false, forceRefresh: true,
                __skipReauth: true });
          if (!formsData || !formsData.success || !formsData.forms) {
            return { success: false, error: 'No data to export' };
          }

          // Build CSV-compatible rows from the sheet data (simulates XLSX export)
          var headers = EXPECTED_HEADERS;
          var rows = [headers];
          for (var ri = 0; ri < formsData.forms.length; ri++) {
            var f = formsData.forms[ri];
            var row = [];
            for (var ci = 0; ci < headers.length; ci++) {
              var val = f[headers[ci]] !== undefined ? f[headers[ci]] : '';
              row.push(String(val));
            }
            rows.push(row);
          }

          // Convert to CSV (Google Sheets compatible, opens as XLSX in Drive)
          var csv = '';
          for (var rri = 0; rri < rows.length; rri++) {
            var csvRow = rows[rri].map(function(cell) {
              if (cell.indexOf(',') >= 0 || cell.indexOf('"') >= 0 || cell.indexOf('\n') >= 0) {
                return '"' + cell.replace(/"/g, '""') + '"';
              }
              return cell;
            }).join(',');
            csv += csvRow + '\n';
          }

          // Create file in the application Drive folder
          var folder = DriveApp.getFolderById(DRIVE_FOLDER_ID);
          var timestamp = Utilities.formatDate(new Date(), 'Europe/Sofia', 'yyyyMMdd_HHmmss');
          var fileName = 'Applications_Export_' + timestamp + '.csv';
          var blob = Utilities.newBlob(csv, 'text/csv', fileName);
          var file = folder.createFile(blob);
          file.setSharing(DriveApp.Access.DOMAIN_WITH_LINK, DriveApp.Permission.VIEW);

          // Mirror to MySQL
          _syncDriveFileToMySQL_({
            fileId: file.getId(),
            name: fileName,
            mimeType: 'text/csv',
            size: csv.length,
            parentFolder: DRIVE_FOLDER_ID
          });

          return { success: true, fileId: file.getId(), fileName: fileName };
        } catch (err) {
          return { success: false, error: err.message };
        }
      }

      /**
       * v10.4.1-hostingerdb: Warm the user's cache in PHP by pre-syncing all
       * critical data sets after login / form submission.
       * ENHANCED: now syncs full data sets instead of just pulling cache markers,
       * and covers projects, reviewers, and documents in addition to basic types.
       * Called once per session start so subsequent page loads read from PHP/MySQL
       * (200ms) instead of GAS (1-10s).
       * @param {string} userEmail — the authenticated user's email
       * @param {boolean} [fullSync] — if true, syncs ALL data (not just user-scoped)
       */
      function _warmUserCache_(userEmail, fullSync) {
        try {
          var _warmUrl = _getHostingerUrl_();
          if (!_warmUrl || !userEmail) return;

          // Phase 1: Pull critical data from GAS and push into MySQL cache
          // (fire-and-forget so the response is not blocked)
          var warmActions = fullSync
            ? ['getforms', 'getcompetitions', 'getpubliccompetitions', 'listdocuments',
               'getprojects', 'getreviewers', 'getnotifications', 'getadminnotifications', 'getmessages',
               'getsanctions', 'checkeligibility', 'getexpenses', 'getdeliverables']
            : ['getforms', 'getcompetitions', 'getpubliccompetitions', 'listdocuments'];

          // Phase 2: Send warmup requests in parallel (each independent)
          for (var wi = 0; wi < warmActions.length; wi++) {
            try {
              var warmPayload = {
                action: 'warmusercache',
                userEmail: userEmail,
                actions: [warmActions[wi]],
                _gasSync: true
              };
              var opts = {
                method: 'post',
                contentType: 'application/json',
                payload: JSON.stringify(warmPayload),
                muteHttpExceptions: true,
                timeout: 15
              };
              UrlFetchApp.fetch(_warmUrl, opts);
            } catch (_) { /* per-item warm failure is non-fatal */ }
          }

          // Phase 3: If fullSync requested, push complete data sets too
          if (fullSync) {
            // Schedule delayed sync to avoid competing with warmup requests
            try {
              Utilities.sleep(200);
              _syncFullDataSetToMySQL_('all', userEmail);
            } catch (_) {}
          }
        } catch (_) { /* silent */ }
      }

      // Direct-dispatch fallback map for critical mutation actions.
      // Used only when the primary handler-map lookup returns null.
      // v12.19.1-perf: Removed inline _syncToMySQL_ calls — doPost's
      // centralized post-processing (line ~8251) already handles sync.
      // This eliminates a redundant HTTP round-trip per mutation.
