          // ── Download each file as a blob ──
          var blobs = [];
          var zipName = 'Проектно_предложение_' + projectType + '_' + formId.replace(/[^a-zA-Z0-9]/g, '_') + '.zip';

          for (var fi = 0; fi < files.length; fi++) {
            var f = files[fi];
            if (!f.id) continue;
            try {
              var driveFile = DriveApp.getFileById(f.id);
              var fileName = String(f.name || driveFile.getName() || 'file_' + fi).trim();
              // Normalize the file extension in the ZIP to match the naming convention:
              // PDF → .pdf, DOCX → .docx, XLSX → .xlsx
              var ext = '';
              var mime = String(f.mimeType || driveFile.getMimeType() || '');
              if (mime.indexOf('spreadsheet') >= 0) ext = '.xlsx';
              else if (mime.indexOf('presentation') >= 0) ext = '.pptx';
              else if (mime.indexOf('pdf') >= 0) ext = '.pdf';
              else if (mime.indexOf('wordprocessingml') >= 0 || mime.indexOf('document') >= 0) ext = '.docx';
              else ext = '.bin';

              // Normalize name: strip existing extension, add correct one
              var baseName = fileName.replace(/\.[^.]+$/, '');
              var cleanName = baseName.replace(/[^a-zA-Z0-9_\-\u0400-\u04FF\u0500-\u052F]/g, '_') + ext;

              // For Google native formats, export to their Office format
              var blob;
              if (mime === 'application/vnd.google-apps.spreadsheet') {
                blob = driveFile.getAs('application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
                cleanName = cleanName.replace(/\.xlsx$/i, '') + '.xlsx';
              } else if (mime === 'application/vnd.google-apps.document') {
                // Export Google Docs as PDF or DOCX based on the template type
                if (f.docType && f.docType.indexOf('pdf') >= 0) {
                  blob = driveFile.getAs('application/pdf');
                  cleanName = cleanName.replace(/\.docx$/i, '') + '.pdf';
                } else {
                  blob = driveFile.getAs('application/vnd.openxmlformats-officedocument.wordprocessingml.document');
                  cleanName = cleanName.replace(/\.pdf$/i, '') + '.docx';
                }
              } else {
                blob = driveFile.getBlob();
              }

              // Set the name on the blob for ZIP entry
              blob.setName(cleanName);
              blobs.push(blob);
            } catch (fErr) {
              console.warn('_generateProposalZip_: skipped file ' + (f.id || '?') + ': ' + fErr.message);
            }
          }

          if (blobs.length === 0) return { success: false, error: 'Неуспешно изтегляне на файлове за пакетиране' };

          // ── Create ZIP using Google Apps Script's built-in utility ──
          var zipBlob = Utilities.zip(blobs, zipName);
          var zipFile = appFolder.createFile(zipBlob);

          // ── Return ZIP file info ──
          return {
            success: true,
            file: {
              id: zipFile.getId(),
              driveId: zipFile.getId(),
              name: zipFile.getName(),
              mimeType: 'application/zip',
              size: zipFile.getSize(),
              downloadUrl: 'https://drive.google.com/uc?export=download&id=' + zipFile.getId(),
              previewLink: 'https://drive.google.com/file/d/' + zipFile.getId() + '/view',
              folderName: 'Моите документи'
            },
            filesInZip: blobs.length,
            zipName: zipName
          };
        } catch (err) {
          logError('_generateProposalZip_', err, body);
          return { success: false, error: '_generateProposalZip_ failed: ' + err.message };
        }
      }

      // ═══════════════════════════════════════════════════════════════════════
      //  v12.3.0-perf: PREDICTIVE multi-type batch generation.
      //  Generates documents for ALL valid project types in a single call so
      //  the applicant has ready-to-edit copies regardless of which type they
      //  ultimately select. The frontend calls this when the wizard opens and
      //  a competition is selected — before the user even picks a type.
      //
      //  POST body: { formId, projectTypes: ['ФНИ','ПНИ','ДНП','НПФ'], metadata }
      //  If projectTypes is empty, generates for ALL known types automatically.
      //  Returns: { success, results: { ФНИ: {files,errors}, ПНИ: {...}, ... } }
      // ═══════════════════════════════════════════════════════════════════════
      // ============================================================
      //  INSTANT AUTO-GENERATE FOR TYPE (v10.5.0)
      //  Called immediately when the applicant selects a project type.
      //  Generates ALL required templates for that single type and returns
      //  them in one call — no batch, no predictive gen for all types.
      //  Pre-fills templates with the form metadata provided by the frontend.
      // ============================================================
      function autoGenerateForType(body) {
        body = body || {};
        var auth = resolveAuthContext(body);
        if (!auth.userId) return { success: false, error: 'Auth required' };
        var formId = String(body.formId || '').trim();
        var projectType = String(body.projectType || '').trim().toUpperCase();
        if (!formId) return { success: false, error: 'Missing formId' };
        if (!projectType || !REQUIRED_APPLICATION_TEMPLATES[projectType]) {
          return { success: false, error: 'Invalid project type: ' + projectType };
        }

        var metadata = body.metadata || {};
        var files = [];
        var errors = [];

        // Generate each required template for this project type
        var typeTemplates = REQUIRED_APPLICATION_TEMPLATES[projectType];
        var docKeys = Object.keys(typeTemplates);
        for (var di = 0; di < docKeys.length; di++) {
          try {
            var docResult = generateApplicationDocument({
              formId: formId, projectType: projectType, docType: docKeys[di],
              userId: auth.userId, email: auth.userId,
              title: metadata.title || '', titleEn: metadata.titleEn || '',
              acronym: metadata.acronym || '', description: metadata.description || '',
              descriptionEn: metadata.descriptionEn || '',
              objectives: metadata.objectives || '',
              expectedResults: metadata.expectedResults || '',
              area: metadata.area || '', professionalField: metadata.professionalField || '',
              durationMonths: metadata.durationMonths || 12,
              applicantName: metadata.applicantName || auth.userName || '',
              teamMembers: metadata.teamMembers || [],
              budget: metadata.budget || {},
              __skipReauth: true, _silent: true
            });
            if (docResult && docResult.success) {
              var f = docResult.applicantFile || docResult.file || {};
              files.push({
                id: f.id || '', driveId: f.driveId || f.id || '', name: f.name || '',
                mimeType: f.mimeType || '', editLink: docResult.googleDocEditLink || f.editLink || '',
                previewLink: f.previewLink || '', downloadUrl: f.downloadUrl || '',
                docType: docKeys[di], isBudget: !!(typeTemplates[docKeys[di]] && typeTemplates[docKeys[di]].isBudget),
                folderName: f.folderName || ''
              });
            } else {
              errors.push({ docType: docKeys[di], error: (docResult && docResult.error) || 'Generation failed' });
            }
          } catch (e) { errors.push({ docType: docKeys[di], error: e.message }); }
        }

        // Sync to MySQL
        if (files.length > 0) {
          try { _syncToMySQL_('autogeneratefortype', { formId: formId, projectType: projectType, files: files }); } catch (_) {}
        }

        return { success: true, projectType: projectType, files: files, count: files.length, errors: errors.length ? errors : undefined };
      }

      /**
       * getGeneratedDocs — returns the list of already-generated documents
       * for a form (from its attachedDocs in the sheet). The frontend calls
       * this on wizard mount to restore previously generated docs without
       * re-generating them.
       */
      function getGeneratedDocs(body) {
        body = body || {};
        var auth = resolveAuthContext(body);
        var formId = String(body.formId || '').trim();
        if (!formId) return { success: false, error: 'Missing formId' };
        var sheet = getSheet();
        var found = findRowByID(sheet, formId);
        if (!found) return { success: false, error: 'Form not found' };
        var attachedRaw = found.rowData[COL.ATTACHED_DOCS - 1];
        var attached = [];
        try { attached = JSON.parse(String(attachedRaw || '[]')); } catch (_) {}
        if (!Array.isArray(attached)) attached = [];
        // Filter to only generated/predictive docs
        var generated = attached.filter(function(d) { return d._generated || d._predictive || d._pregen; });
        return { success: true, formId: formId, files: generated, count: generated.length };
      }

      function _predictiveBatchGenerate_(body) {
        body = body || {};
        var auth = resolveAuthContext(body);
        if (!auth.userId) return { success: false, error: 'Необходима е автентикация' };
        var formId = String(body.formId || '').trim();
        if (!formId) return { success: false, error: 'Липсва formId' };

        var projectTypes = Array.isArray(body.projectTypes) && body.projectTypes.length > 0
          ? body.projectTypes
          : Object.keys(REQUIRED_APPLICATION_TEMPLATES); // all known types

        var metadata = body.metadata || {};
        var allResults = {};
        var totalFiles = 0;
        var totalErrors = 0;

        // Generate for each project type sequentially (GAS is single-threaded)
        // but batch-sync ALL files to MySQL in ONE call at the end
        var allFilesForSync = [];

        for (var pti = 0; pti < projectTypes.length; pti++) {
          var pt = String(projectTypes[pti] || '').trim().toUpperCase();
          if (!pt || !REQUIRED_APPLICATION_TEMPLATES[pt]) {
            allResults[pt || ('unknown_' + pti)] = { files: [], errors: [{ error: 'Невалиден тип проект: ' + pt }] };
            totalErrors++;
            continue;
          }

          // Use the existing batch generator for each type (internal, silent)
          var typeResult = _batchGenerateDocuments_({
            formId: formId,
            projectType: pt,
            metadata: metadata,
            __skipReauth: true,
            _silent: true,
            _batchSync: true  // suppress individual MySQL sync; we batch at end
          });

          if (typeResult && typeResult.success) {
            allResults[pt] = { files: typeResult.files || [], errors: typeResult.errors || [] };
            totalFiles += (typeResult.files || []).length;
            if (typeResult.errors) totalErrors += typeResult.errors.length;
            // Collect files for batch MySQL sync
            (typeResult.files || []).forEach(function(f) {
              allFilesForSync.push({
                fileId: f.id, name: f.name, mimeType: f.mimeType,
                size: 0, parentFolder: '', formId: formId,
                projectType: pt, userEmail: auth.userId
              });
            });
          } else {
            allResults[pt] = { files: [], errors: [{ error: (typeResult && typeResult.error) || 'Грешка при генериране за ' + pt }] };
            totalErrors++;
          }
        }

        // Batch-sync ALL generated files to MySQL in a single transaction
        if (allFilesForSync.length > 0) {
          try {
            _syncToMySQL_('syncdrivefilesbatch', {
              action: 'syncdrivefilesbatch',
              files: allFilesForSync,
              _gasSync: true
            });
          } catch (_) {}
        }

        try { _warmUserCache_(auth.userId, false); } catch (_) {}
        return {
          success: true,
          predictive: true,
          totalFiles: totalFiles,
          totalErrors: totalErrors,
          typesGenerated: Object.keys(allResults).length,
          results: allResults
        };
      }

      // ============================================================
      //  GENERATE APPLICATION DOCUMENT (ФНИ team experience sheet)
      //  Copies a template from OFFICIAL_DOCS_FOLDER_ID, fills in
      //  placeholders with form data (team, publications, experience),
      //  and stores the generated document in the app's Drive folder.
      // ============================================================
      function generateApplicationDocument(body) {
        body = body || {};
        var auth = resolveAuthContext(body);
        if (!auth.userId) return { success: false, error: 'Необходима е автентикация' };

        var formId   = String(body.formId || '').trim();
        var docType  = String(body.docType || '').trim(); // e.g. 'fniteam', 'fnisections35'
        if (!formId || !docType) return { success: false, error: 'Липсват formId/docType' };

        // ── Input hardening: formId should be a sane alphanumeric ID ──
        // Reject suspiciously long or non-alphanumeric IDs before touching the sheet.
        if (formId.length > 64 || !/^[a-zA-Z0-9_\-]+$/.test(formId)) {
          return { success: false, error: 'Невалиден идентификатор на заявление.' };
        }

        // ── Resolve template from the REQUIRED_DOCUMENTS lookup ──
        var projectCode = '';
        var row = null;
        var sheet = getSheet();
        var found = findRowByID(sheet, formId);
        if (!found) return { success: false, error: 'Заявлението не е намерено' };
        row = found.rowData;

        // ── Ownership / admin check ──
        // Only the form owner or an admin can generate documents from a form.
        // This prevents cross-user document generation and information leakage.
        var ownerEmail = String(row[COL.USER_EMAIL - 1] || '').toLowerCase().trim();
        if (!auth.isAdmin && auth.userId && ownerEmail && auth.userId.toLowerCase().trim() !== ownerEmail) {
          return { success: false, error: 'Нямате права да генерирате документи за това заявление.' };
        }

        projectCode = String(row[COL.PROJECT_CODE - 1] || '').toUpperCase().trim();

        // v8.6.0 — caller may supply the authoritative live projectCode (e.g. when
        // the draft was created before the applicant chose a type). Prefer that
        // and keep the sheet row in sync so downstream consumers see one truth.
        var livePC = String(body.projectCode || '').toUpperCase().trim();
        if (livePC && livePC !== 'TBD' && livePC !== projectCode) {
          try {
            sheet.getRange(found.rowIndex, COL.PROJECT_CODE).setValue(livePC);
            row[COL.PROJECT_CODE - 1] = livePC;
          } catch (_) {}
          projectCode = livePC;
        }
        // Friendlier failure when the type is genuinely missing — never leak the
        // internal 'TBD' sentinel back to the UI.
        if (!projectCode || projectCode === 'TBD') {
          return { success: false, error: 'Моля, изберете тип проект преди да генерирате документ.' };
        }

        // Build the template-map lookup from the single source of truth
        var typeMap = REQUIRED_APPLICATION_TEMPLATES[projectCode];
        if (!typeMap) {
          var validTypes = Object.keys(REQUIRED_APPLICATION_TEMPLATES).sort().join(', ');
          return { success: false, error: 'Няма шаблони за тип "' + projectCode + '". Налични типове: ' + validTypes };
        }

        // ── v12.14.0-pregen: use pre-generated template ID if supplied by frontend ──
        // The frontend sends templateDocId from the instant-embed flow. Skip the
        // library search and use the master template directly for the copy.
        var pregenTemplateId = String(body.templateDocId || '').trim();
        if (pregenTemplateId && pregenTemplateId.length > 10) {
          try {
            var _pregenFile = DriveApp.getFileById(pregenTemplateId);
            var _appFolder = getOrCreateAppFolder(formId);
            var _outputName = docType + '_' + formId.substring(0,8) + '.docx';
            // Delete any previous copy
            var _existing = _appFolder.getFilesByName(_outputName);
            while (_existing.hasNext()) { try { _existing.next().setTrashed(true); } catch(_) {} }
            // Make a copy in the user's app folder
            var _copy = _pregenFile.makeCopy(_outputName, _appFolder);
            // Grant editor access to the applicant — EDIT (not VIEW) so they can
            // edit directly without seeing "заявка за редактиране".
            try { _copy.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.EDIT); } catch(_) {}
            // v12.21.0: Robust fallback — guarantee the authenticated user can always access their copy
            // Use ownerEmail (from sheet row) as primary, fall back to auth.userId
            _ensureUserAccess_(_copy, ownerEmail || auth.userId, 'writer');
            var _copyEditUrl = 'https://docs.google.com/document/d/' + _copy.getId() + '/edit';
            // v12.30.2-defensive: MIME-aware preview/download links. The old
            // hardcoded drive.google.com/file/d/{id}/preview URL fails in
            // iframes for Google-native Docs with "За съжаление файлът... не
            // съществува" (see buildSecureFileLinks_ v18.0.3 note).
            var _pregenLinks = buildSecureFileLinks_(_copy.getId(), { allowDownload: true, mimeType: _copy.getMimeType() });
            return {
              success: true,
              message: 'Копие на формуляра е създадено.',
              file: {
                id: _copy.getId(),
                name: _copy.getName(),
                mimeType: _copy.getMimeType(),
                url: _copy.getUrl()
              },
              applicantFile: {
                id: _copy.getId(),
                driveId: _copy.getId(),
                name: _copy.getName(),
                mimeType: _copy.getMimeType(),
                previewLink: _pregenLinks.previewLink,
                downloadUrl: _pregenLinks.downloadUrl || ('https://docs.google.com/document/d/' + _copy.getId() + '/export?format=docx'),
                folderName: _appFolder.getName()
              },
              googleDocEditLink: _copyEditUrl,
              pregenCopied: true,
              templateDocId: pregenTemplateId
            };
          } catch (ePregen) {
            console.warn('Pregen template copy failed (' + pregenTemplateId + '): ' + ePregen.message + ' — falling back to library search');
            // Fall through to the normal library search path
          }
        }

        var tplSpec = typeMap[docType];
        if (!tplSpec) {
          var validDocs = Object.keys(typeMap).sort().join(', ');
          return { success: false, error: 'Непознат тип документ: "' + docType + '" за тип ' + projectCode + '. Налични: ' + validDocs };
        }

        // ── Input validation: docType must match a known key for this projectCode ──
        // Whitelist check — rejects arbitrary/unknown docType values before any
        // Drive operation. Already enforced implicitly by the lookup above, but
        // the explicit check is a defense-in-depth measure.
        var validDocTypes = Object.keys(typeMap);
        if (validDocTypes.indexOf(docType) === -1) {
          return { success: false, error: 'Непознат тип документ: ' + docType + '. Очаквани: ' + validDocTypes.join(', ') };
        }

        try {
          // ── Find the template file anywhere inside OFFICIAL_DOCS_FOLDER_ID ──
          // v8.6.0 — recursive + fuzzy resolver: templates live in subfolders
          // (e.g. "Шаблони/ФНИ/…"), so a flat getFilesByName at the root used
          // to fail. _findTemplateFileInLibrary_ walks the tree, matches by
          // exact name first, then case-insensitive, then by normalised slug.
          //
          // v12.2.0-perf: Cache resolved template file IDs in script properties
          // with a 6-hour TTL. _findTemplateFileInLibrary_ does a recursive
          // folder walk that costs ~0.3–1.2s per call. Caching the resolved ID
          // cuts this to ~0.01s (a single getProperty call). Cache is versioned
          // so bulk template updates invalidate it.
          var _tplCacheKey = 'TPL_ID_' + projectCode + '_' + docType;
          var templateFile = null;
          try {
            var _tplCacheVer = _scriptProps_().getProperty('TPL_CACHE_VER') || '1';
            var _tplCached = _scriptCache_().get(_tplCacheKey + '_v' + _tplCacheVer);
            if (_tplCached) {
              try { templateFile = DriveApp.getFileById(_tplCached); } catch(_) {
                // Stale cache entry — file was deleted/moved; clear and re-resolve
                _scriptCache_().remove(_tplCacheKey + '_v' + _tplCacheVer);
              }
            }
          } catch(_) {}
          if (!templateFile) {
            templateFile = _findTemplateFileInLibrary_(tplSpec.name, projectCode);
            // Cache the resolved ID for future calls (6-hour TTL via script cache)
            if (templateFile) {
              try { _scriptCache_().put(_tplCacheKey + '_v' + (_scriptProps_().getProperty('TPL_CACHE_VER')||'1'), templateFile.getId(), 21600); } catch(_) {}
            }
          }
          if (!templateFile) {
            var candidates = [];
            try { candidates = _getTemplateCandidates_(tplSpec.name, 5) || []; } catch (_) {}
            // Check whether the library folder itself is accessible so we can
            // give a more actionable error (wrong folder ID vs missing file).
            var libraryAccessible = false;
            try { DriveApp.getFolderById(OFFICIAL_DOCS_FOLDER_ID); libraryAccessible = true; } catch (_) {}
            var hint = '';
            if (!libraryAccessible) {
              hint = '\nПапката с официалните документи не е достъпна (ID: ' + OFFICIAL_DOCS_FOLDER_ID + '). Моля, проверете настройките на системата.';
            } else if (candidates.length) {
              hint = '\nНай-близки файлове в библиотеката: ' + candidates.join('; ');
            }
            return {
              success: false,
              error: 'Шаблонът „' + tplSpec.name + '" не е намерен в библиотеката („Официални документи" или нейна подпапка). Свържете се с администратор — той може да го качи или преименува.' + hint,
              missingTemplate: tplSpec.name,
              libraryAccessible: libraryAccessible,
              candidates: candidates,
              docType: docType,
              projectCode: projectCode
            };
          }
          var appFolder = getOrCreateAppFolder(formId);

          // Build output name: <docType>_<formId>.docx
          var outputName = docType + '_' + formId.substring(0,8);
          if (tplSpec.name.toLowerCase().indexOf('.docx') >= 0) outputName += '.docx';

          // Delete previous generated copy if it exists
          var existing = appFolder.getFilesByName(outputName);
          while (existing.hasNext()) { try { existing.next().setTrashed(true); } catch(_) {} }

          // v8.6.1 — if the template is a .docx (not a native Google Doc),
          // DocumentApp.openById() can't open it and the placeholder pass is
          // silently skipped — the applicant ends up with an unfilled copy.
          // Use the Drive Advanced Service to copy WITH conversion so the
          // generated file is a Google Doc that we can populate. The frontend
          // preview/download links handle Google Docs transparently and the
          // user can still export to .docx from the Doc UI if needed.
          var copyFile;
          var copyId;
          var templateIsDocx = (tplSpec.mime || '').indexOf('wordprocessingml') >= 0;
          if (templateIsDocx) {
            // Strip .docx from the title \u2014 the converted file is a native
            // Google Doc, the suffix would be misleading inside Drive UI.
            var nativeTitle = outputName.replace(/\.docx$/i, '');
            try {
              var converted = Drive.Files.copy(
                { title: nativeTitle, parents: [{ id: appFolder.getId() }], mimeType: 'application/vnd.google-apps.document' },
                templateFile.getId(),
                { convert: true, supportsAllDrives: true }
              );
              outputName = nativeTitle;
              copyId = converted.id;
              copyFile = DriveApp.getFileById(copyId);
            } catch (convErr) {
              // Fallback to plain makeCopy — placeholders won't be filled but
              // the applicant at least gets the template to edit by hand.
              console.warn('generateApplicationDocument: Drive.Files.copy(convert) failed (' + convErr.message + ') — falling back to raw makeCopy');
              copyFile = templateFile.makeCopy(outputName, appFolder);
              copyId   = copyFile.getId();
            }
          } else {
            copyFile = templateFile.makeCopy(outputName, appFolder);
            copyId   = copyFile.getId();
          }

          // ── Populate placeholders ──
          // Extract data from the application row, BUT prefer live data passed
          // from the frontend (body.title etc.) so the document is filled with
          // the applicant's latest unsaved changes, not just what's in the sheet.
          var title       = String(body.title       || row[COL.TITLE - 1]       || '').trim();
          var titleEn     = String(body.titleEn     || row[COL.TITLE_EN - 1]    || '').trim();
          var userName    = String(body.applicantName || row[COL.USER_NAME - 1] || '').trim();
          var userEmail   = String(row[COL.USER_EMAIL - 1]  || '').trim();
          var area        = String(body.area        || row[COL.AREA - 1]        || '').trim();
          var description = String(body.description || row[COL.DESCRIPTION - 1] || '').trim();
          var descriptionEn = String(body.descriptionEn || row[COL.DESCRIPTION_EN - 1] || '').trim();
          var objectives  = String(body.objectives  || row[COL.OBJECTIVES - 1]  || '').trim();
          var results     = String(body.expectedResults || row[COL.EXPECTED_RESULTS - 1] || '').trim();
          var acronym     = String(body.acronym     || row[COL.ACRONYM - 1]     || '').trim();
          var profField   = String(body.professionalField || row[COL.PROFESSIONAL_FIELD - 1] || '').trim();
          var budget      = String(row[COL.BUDGET - 1]      || '').trim();
          var teamJson    = String(row[COL.TEAM_MEMBERS - 1] || '').trim();
          var signature   = String(row[COL.SIGNATURE - 1]   || '').trim(); // applicant signature (base64 PNG)
          var competition = String(row[COL.COMPETITION - 1] || '').trim();
          var workProgram = String(row[COL.WORK_PROGRAM - 1] || '').trim();
          var indicatorsJ = String(row[COL.INDICATORS - 1] || '').trim();
          var createdRaw  = row[COL.CREATED - 1];
          var submittedRaw= row[COL.SUBMITTED - 1];
          var createdStr  = createdRaw  ? (createdRaw  instanceof Date  ? createdRaw.toLocaleDateString('bg-BG')  : String(createdRaw))  : '';
          var submittedStr= submittedRaw? (submittedRaw instanceof Date ? submittedRaw.toLocaleDateString('bg-BG'): String(submittedRaw)) : '';

          // Indicators — flatten JSON array into bullet list for the template
          var indicatorsList = '';
          try {
            var indArr = JSON.parse(indicatorsJ);
            if (Array.isArray(indArr) && indArr.length) {
              indicatorsList = indArr.map(function(it, i) {
                if (!it || typeof it !== 'object') return (i+1) + '. ' + String(it || '');
                var nm = String(it.name || it.indicator || it.label || '').trim();
                var tg = String(it.target || it.value || '').trim();
                var un = String(it.unit || '').trim();
                return (i+1) + '. ' + nm + (tg ? ' — ' + tg + (un ? ' ' + un : '') : '');
              }).join('\n');
            }
          } catch (_) { indicatorsList = indicatorsJ; }

          // Parse team members — prefer live data from frontend, fall back to sheet JSON
          var teamArr = [];
          if (body.teamMembers && Array.isArray(body.teamMembers)) {
            teamArr = body.teamMembers;
          } else {
            try { teamArr = JSON.parse(teamJson); } catch(_) { teamArr = []; }
            if (!Array.isArray(teamArr)) teamArr = [];
          }

          var teamList = teamArr.map(function(m, i) {
            var name  = String(m.name  || '').trim();
            var email = String(m.email || '').trim();
            var role  = String(m.role  || 'member');
            var roleLabel = (role === 'leader' ? 'Ръководител' : role === 'member' ? 'Член' : role === 'young' ? 'Млад учен' : role === 'doctoral' ? 'Докторант' : role === 'external' ? 'Външен' : role);
            return (i+1) + '. ' + (name || email) + (name && email ? ' (' + email + ')' : '') + ' — ' + roleLabel;
          }).join('\n');

          if (!teamList && userName) teamList = '1. ' + userName + ' (' + userEmail + ') — Ръководител';

          // Build a budget summary string
          var budgetTotal = '';
          try {
            var budgetObj = JSON.parse(budget);
            if (budgetObj && typeof budgetObj === 'object') {
              var sum = 0;
              var budgetLines = [];
              var costLabels = {
                salaries: 'Възнаграждения', external_services: 'Външни услуги',
                assets: 'ДМА', consumables: 'Консумативи', literature: 'Литература',
                travel: 'Командировки', publications: 'Публикации', reviews: 'Рецензии', other: 'Други'
              };
              Object.keys(budgetObj).forEach(function(gid) {
                if (gid === '_monthlyMode' || gid === '_monthly') return;
                var byYear = budgetObj[gid] || {};
                var catSum = 0;
                Object.keys(byYear).forEach(function(yr) { catSum += Number(byYear[yr]) || 0; });
                if (catSum > 0) {
                  sum += catSum;
                  budgetLines.push((costLabels[gid] || gid) + ': ' + (catSum / 1.95583).toFixed(2) + ' €');
                }
              });
              if (sum > 0) {
                budgetTotal = 'Общ бюджет: ' + (sum / 1.95583).toFixed(2) + ' €\n' + budgetLines.join('\n');
              }
            }
          } catch (_) {}
          if (!budgetTotal) budgetTotal = budget;

          // Compute duration — prefer live from frontend, fall back to sheet
          var durationMonths = Number(body.durationMonths || row[COL.DURATION_MONTHS - 1]) || 12;
          var durationStr = durationMonths + ' месеца / ' + Math.ceil(durationMonths/12) + ' год.';

          // ── Perform replacement on Google Doc ──
          try {
            var doc = DocumentApp.openById(copyId);
            var bodyDoc = doc.getBody();
            bodyDoc.replaceText('{{TITLE}}', title);
            bodyDoc.replaceText('{{PROJECT_TITLE}}', title);
            bodyDoc.replaceText('{{TITLE_EN}}', titleEn);
            bodyDoc.replaceText('{{PROJECT_TITLE_EN}}', titleEn);
            bodyDoc.replaceText('{{LEADER}}', userName);
            bodyDoc.replaceText('{{LEADER_NAME}}', userName);
            bodyDoc.replaceText('{{LEADER_EMAIL}}', userEmail);
            bodyDoc.replaceText('{{ACRONYM}}', acronym);
            bodyDoc.replaceText('{{AREA}}', area);
            bodyDoc.replaceText('{{PRIORITY_AREA}}', area);
            bodyDoc.replaceText('{{DESCRIPTION}}', description);
            bodyDoc.replaceText('{{DESCRIPTION_EN}}', descriptionEn);
            bodyDoc.replaceText('{{ABSTRACT}}', description);
            bodyDoc.replaceText('{{OBJECTIVES}}', objectives);
            bodyDoc.replaceText('{{EXPECTED_RESULTS}}', results);
            bodyDoc.replaceText('{{RESULTS}}', results);
            bodyDoc.replaceText('{{PROFESSIONAL_FIELD}}', profField);
            bodyDoc.replaceText('{{DURATION}}', durationStr);
            bodyDoc.replaceText('{{DURATION_MONTHS}}', String(durationMonths));
            bodyDoc.replaceText('{{TEAM_MEMBERS}}', teamList);
            bodyDoc.replaceText('{{TEAM}}', teamList);
            bodyDoc.replaceText('{{BUDGET}}', budgetTotal);
            bodyDoc.replaceText('{{BUDGET_TOTAL}}', budgetTotal);
            bodyDoc.replaceText('{{DATE}}', new Date().toLocaleDateString('bg-BG'));
            bodyDoc.replaceText('{{GENERATED_DATE}}', new Date().toLocaleDateString('bg-BG'));
            bodyDoc.replaceText('{{TODAY}}', new Date().toLocaleDateString('bg-BG'));
            bodyDoc.replaceText('{{PROJECT_CODE}}', projectCode);
            bodyDoc.replaceText('{{PROJECT_TYPE}}', projectCode);
            bodyDoc.replaceText('{{FORM_ID}}', formId);
            bodyDoc.replaceText('{{PROJECT_ID}}', formId);
            bodyDoc.replaceText('{{COMPETITION}}', competition);
            bodyDoc.replaceText('{{COMPETITION_CYCLE}}', competition);
            bodyDoc.replaceText('{{INDICATORS}}', indicatorsList);
            bodyDoc.replaceText('{{WORK_PROGRAM}}', workProgram);
            bodyDoc.replaceText('{{CREATED_DATE}}', createdStr);
            bodyDoc.replaceText('{{SUBMITTED_DATE}}', submittedStr);
            bodyDoc.replaceText('{{INSTITUTION}}', (typeof INSTITUTION !== 'undefined' && INSTITUTION && INSTITUTION.name) ? INSTITUTION.name : 'Икономически университет – Варна');
            // ── Applicant name placeholder ──
            bodyDoc.replaceText('{{APPLICANT_NAME}}', userName);
            bodyDoc.replaceText('{{APPLICANT_EMAIL}}', userEmail);

            // ── Insert applicant signature image from sheet data ──
            try {
              if (signature && signature.indexOf('data:image') === 0) {
                // Decode base64 signature and insert as inline image
                var sigComma = signature.indexOf(',');
                if (sigComma > 0) {
                  var sigB64 = signature.substring(sigComma + 1);
                  var sigBytes = Utilities.base64Decode(sigB64);
                  var sigBlob = Utilities.newBlob(sigBytes, 'image/png', 'signature.png');
                  // Insert the signature image at the end of the document body
                  // after a newline to separate it from preceding content
                  bodyDoc.appendParagraph('');
                  var sigImg = bodyDoc.appendImage(sigBlob);
                  if (sigImg) {
                    // Size the signature to a reasonable width while preserving aspect ratio
                    sigImg.setWidth(180);
                    sigImg.setHeight(60);
                  }
                  // Also try to replace a {{SIGNATURE}} placeholder if it exists in the template
                  // (Google Docs replaceText cannot replace with an image, so we insert inline)
                  bodyDoc.replaceText('{{SIGNATURE}}', '');
                }
              }
            } catch (sigErr) {
              console.warn('generateApplicationDocument: signature insert failed: ' + sigErr.message);
            }

            doc.saveAndClose();
          } catch (docErr) {
            // If it's a .docx that hasn't been converted to Google Doc format yet,
            // the file is still returned as-is — placeholders will be in the raw document
            // and the user fills them manually in Word or after Drive conversion.
            console.warn('generateApplicationDocument: could not open as Google Doc (' + docErr.message + ') — returning raw copy');
          }

          // Set sharing
          setSecureSharing_(copyFile);
          // v12.21.0: Also explicitly grant the generating user access
          // so non-@ue-varna.bg accounts never see "file does not exist".
          _ensureUserAccess_(copyFile, userEmail, 'reader');

          // ── APPLICANT-OWNED EDITABLE COPY (v10.2.0-restructure) ──
          // The system copy above lives in DRIVE_FOLDER_ID/Applications/{formId}
          // and is read-only for the applicant (script-owner-owned). To let
          // applicants actually edit the generated document, we ALSO copy it
          // into the root-level competition session folder, organized by formId:
          //   APPLICANT_DOCS_FOLDER_ID / Конкурсна сесия 2026 документи / {formId} /
          // and grant Editor access. The `googleDocEditLink` we return points at
          // the editable copy. The system copy stays as the authoritative record.
          var applicantFileInfo = null;
          var applicantEditLink = '';
          try {
            // ── v10.2.0-restructure: store in root-level per-form session folder ──
            // Structure: APPLICANT_DOCS_FOLDER_ID / Конкурсна сесия 2026 документи / {formId} /
            var formSessionFolder = getOrCreateFormSessionFolder_(formId, userEmail);
            if (formSessionFolder) {
              // Use a friendly name: docType prefix so multiple types are identifiable
              var friendlyName = docType + '_' + formId.substring(0, 8) + (outputName.indexOf('.') > 0 ? '' : '.docx');
              // Avoid name collisions — add (копие N) suffix
              var apName = friendlyName;
              var apIdx = 1;
              // v12.26.0-perf: Cache regex match
              var _apBaseName = friendlyName.replace(/(\.[^.]+)$/, '');
              var _apExt = friendlyName.match(/(\.[^.]+)$/);
              var _apExtStr = _apExt ? _apExt[0] : '';
              while (formSessionFolder.getFilesByName(apName).hasNext() && apIdx < 50) {
                apIdx++;
                apName = _apBaseName + ' (копие ' + apIdx + ')' + _apExtStr;
              }
              var apCopy = copyFile.makeCopy(apName, formSessionFolder);
              // Tag for provenance
              try {
                apCopy.setDescription('TEMPLATE_SOURCE=' + (body.templateId || copyFile.getId()) + '|TEMPLATE_NAME=' + outputName + '|FORM_ID=' + formId + '|ORIGIN=generated|DOC_TYPE=' + docType + '|PROJECT_TITLE=' + (title || '') + '|PROJECT_CODE=' + (projectCode || ''));
              } catch (_) {}
              // Grant editor access — v12.21.0: robust fallback for non-domain users
              _ensureUserAccess_(apCopy, userEmail, 'writer');
              // v18.0.2: ALSO set global ANYONE_WITH_LINK + add admin viewers on the
              // applicant copy, so non-@ue-varna.bg admins and shared-drive previews work.
              // Previous code only called _ensureUserAccess_ which adds a single user —
              // if that Drive API call fails or the GAS identity doesn't match the browser
              // session, Google shows "file does not exist" in the iframe.
              shareGeneratedFile_(apCopy);
              var apId = apCopy.getId();
              var apMime = apCopy.getMimeType();
              var apLinks = buildSecureFileLinks_(apId, { allowDownload: true, mimeType: apMime });
              var folderDisplayName = SESSION_FOLDER_NAME + '/' + formId;
              applicantFileInfo = {
                id          : apId,
                name        : apCopy.getName(),
                mimeType    : apMime,
                typeLabel   : mimeTypeLabel(apCopy.getMimeType()),
                previewLink : apLinks.previewLink,
                webViewLink : apLinks.previewLink,
                downloadUrl : apLinks.downloadUrl,
                size        : formatFileSize_(apCopy.getSize()),
                sizeBytes   : Number(apCopy.getSize() || 0),
                folderName  : folderDisplayName,
                formId      : formId,
                origin      : 'generated',
                docType     : docType,
                createdDate : apCopy.getDateCreated().toISOString(),
                modifiedDate: apCopy.getLastUpdated().toISOString()
              };
              if (apCopy.getMimeType() === 'application/vnd.google-apps.document') {
                applicantEditLink = 'https://docs.google.com/document/d/' + apId + '/edit';
              }
            } else {
              // Fallback to per-user session folder if root-level fails
              var sessionFolder = getOrCreateSessionFolder_(userEmail);
              if (sessionFolder) {
                var sessionName = (title ? title.substring(0, 40) + ' — ' : '') + outputName;
                var sIdx = 1;
                while (sessionFolder.getFilesByName(sessionName).hasNext() && sIdx < 50) {
                  sIdx++;
                  sessionName = (title ? title.substring(0, 40) + ' — ' : '') + outputName + ' (копие ' + sIdx + ')';
                }
                var sCopy = copyFile.makeCopy(sessionName, sessionFolder);
                try { sCopy.setDescription('TEMPLATE_SOURCE=' + (body.templateId || copyFile.getId()) + '|TEMPLATE_NAME=' + outputName + '|FORM_ID=' + formId + '|ORIGIN=generated|DOC_TYPE=' + docType + '|PROJECT_CODE=' + (projectCode || '')); } catch (_) {}
                _ensureUserAccess_(sCopy, userEmail, 'writer');
                // v18.0.2: Also share the session-folder copy globally
                shareGeneratedFile_(sCopy);
                var sId = sCopy.getId();
                var sMime = sCopy.getMimeType();
                var sLinks = buildSecureFileLinks_(sId, { allowDownload: true, mimeType: sMime });
                applicantFileInfo = {
                  id: sId, name: sCopy.getName(), mimeType: sMime, typeLabel: mimeTypeLabel(sMime),
                  previewLink: sLinks.previewLink, webViewLink: sLinks.previewLink, downloadUrl: sLinks.downloadUrl,
                  size: formatFileSize_(sCopy.getSize()), sizeBytes: Number(sCopy.getSize() || 0),
                  folderName: SESSION_FOLDER_NAME, formId: formId, origin: 'generated', docType: docType,
                  createdDate: sCopy.getDateCreated().toISOString(), modifiedDate: sCopy.getLastUpdated().toISOString()
                };
                if (sCopy.getMimeType() === 'application/vnd.google-apps.document') {
                  applicantEditLink = 'https://docs.google.com/document/d/' + sId + '/edit';
                }
              }
            }
          } catch (apErr) {
            console.warn('generateApplicationDocument: applicant copy failed: ' + apErr.message);
          }

          var links = buildSecureFileLinks_(copyId, { allowDownload: true, mimeType: copyFile.getMimeType() });
          return {
            success: true,
            message: 'Документът е генериран: ' + outputName,
            file: {
              id: copyId,
              driveId: copyId,
              name        : outputName,
              mimeType    : copyFile.getMimeType(),
              typeLabel   : mimeTypeLabel(copyFile.getMimeType()),
              previewLink : links.previewLink,
              webViewLink : links.previewLink,
              downloadUrl : links.downloadUrl,
              size        : formatFileSize_(copyFile.getSize()),
              sizeBytes   : Number(copyFile.getSize() || 0),
              folderName  : formId
            },
            // Editable copy in applicant's session folder (when available);
            // frontend opens this one when the user clicks "Редактирай".
            applicantFile: applicantFileInfo,
            myDocsFile: applicantFileInfo, // alias for backward compatibility
            googleDocEditLink: applicantEditLink || ('https://docs.google.com/document/d/' + copyId + '/edit')
          };
        } catch (err) {
          return { success: false, error: 'Генерирането на документа не бе успешно: ' + err.message };
        }
      }

      // ============================================================
      //  DELETE MY DOCUMENT — removes a file from the caller's
      //  personal "My Documents" folder.
      // ============================================================
      function deleteMyDocument(body) {
        body = body || {};
        var auth = resolveAuthContext(body);
        if (!auth.userId) return { success: false, error: 'Необходима е автентикация' };

        var docId = sanitizeFileId_(String(body.docId || '').trim());
        if (!docId) return { success: false, error: 'Невалиден или липсващ docId' };

        // Accept optional formId so we can also delete files from the
        // per-form app folder (not just "My Documents").
        var formId = String(body.formId || '').trim();

        try {
          // v12.30.2-defensive: explicit existence check → clear Bulgarian error
          // when the file was already deleted/moved (instead of raw exception text).
          var file = null;
          try { file = DriveApp.getFileById(docId); }
          catch (eSrc) {
            return { success: false, error: 'За съжаление файлът, който сте заявили, не съществува или вече е изтрит.' };
          }
          var caller = String(auth.userId || '').toLowerCase().trim();

          // ── Safety check: the file must be owned/allowed for deletion ──
          var allowed = false;

          // 1) Check if the file is in the user's "My Documents" folder tree
          var userFolder = getOrCreateMyDocsFolder_(caller);
          if (userFolder) {
            var parents = file.getParents();
            while (parents.hasNext()) {
              var parentId = parents.next().getId();
              if (parentId === userFolder.getId()) { allowed = true; break; }
              // Also check if a grandparent is the user folder (for session
              // folder "Конкурсна сесия 2026 документи" / submission folders)
              try {
                var gp = DriveApp.getFolderById(parentId).getParents();
                while (gp.hasNext()) {
                  if (gp.next().getId() === userFolder.getId()) { allowed = true; break; }
                }
              } catch (_) {}
              if (allowed) break;
            }
          }

          // 2) Check if the file is in the root-level session folder tree
          //     (APPLICANT_DOCS_FOLDER_ID / Конкурсна сесия 2026 документи / {formId}).
          //     These are the applicant's generated/uploaded/copied documents.
          if (!allowed) {
            try {
              var rootSession = getOrCreateSessionRootFolder_();
              if (rootSession) {
                var parents = file.getParents();
                while (parents.hasNext()) {
                  var pId = parents.next().getId();
                  // Check if the immediate parent is a subfolder of rootSession
                  try {
                    var gp = DriveApp.getFolderById(pId).getParents();
                    while (gp.hasNext()) {
                      if (gp.next().getId() === rootSession.getId()) {
                        // Found in root session tree — verify the caller is the
                        // file's editor (they were granted editor access when
                        // the file was created). Or check via formId.
                        allowed = true;
                        break;
                      }
                    }
                  } catch (_) {}
                  if (allowed) break;
                }
              }
            } catch (_) {}
          }

          // 3) If not in My Documents / session tree, check the per-form app
          //    folder (when formId is provided and the caller owns that form).
          if (!allowed && formId) {
            try {
              var appFolder = getOrCreateAppFolder(formId);
              if (appFolder) {
                var fParents = file.getParents();
                while (fParents.hasNext()) {
                  if (fParents.next().getId() === appFolder.getId()) {
                    // Verify the caller owns this form
                    var sheet = getSheet();
                    var found = findRowByID(sheet, formId);
                    if (found) {
                      var ownerEmail = String(found.rowData[COL.USER_EMAIL - 1] || '').toLowerCase().trim();
                      if (ownerEmail && ownerEmail === caller) { allowed = true; }
                    }
                    break;
                  }
                }
              }
            } catch (_) {}
          }

          // 4) Admin override
          if (!allowed && auth.isAdmin) { allowed = true; }

          if (!allowed) {
            return { success: false, error: 'Файлът не е във Вашата лична папка или нямате права за изтриване.' };
          }

          file.setTrashed(true);
          return { success: true, message: 'Документът е изтрит' };
        } catch (err) {
          return { success: false, error: 'Изтриването на документа не бе успешно: ' + err.message };
        }
      }

      // ============================================================
      //  RENAME MY DOCUMENT — renames a file in the user's personal
      //  Drive folder. Uses the same ownership checks as deleteMyDocument.
      //  body: { docId, newName, formId? }
      //  Returns the updated file metadata on success.
      // ============================================================
      function renameMyDocument(body) {
        body = body || {};
        var auth = resolveAuthContext(body);
        if (!auth.userId) return { success: false, error: 'Необходима е автентикация' };

        var docId = sanitizeFileId_(String(body.docId || '').trim());
        if (!docId) return { success: false, error: 'Невалиден или липсващ docId' };

        var newName = String(body.newName || '').trim();
        if (!newName) return { success: false, error: 'Невалидно или липсващо име' };
        newName = _sanitiseFileName_(newName, 180);
        if (!newName) return { success: false, error: 'Името е празно след нормализиране' };

        var formId = String(body.formId || '').trim();

        try {
          // v12.30.2-defensive: explicit existence check → clear Bulgarian error
          var file = null;
          try { file = DriveApp.getFileById(docId); }
          catch (eSrc) {
            return { success: false, error: 'За съжаление файлът, който сте заявили, не съществува или вече е изтрит.' };
          }
          var caller = String(auth.userId || '').toLowerCase().trim();

          // ── Safety check: the file must be owned/allowed for rename ──
          var allowed = false;

          // 1) Check if the file is in the user's "My Documents" folder tree
          var userFolder = getOrCreateMyDocsFolder_(caller);
          if (userFolder) {
            var parents = file.getParents();
            while (parents.hasNext()) {
              var parentId = parents.next().getId();
              if (parentId === userFolder.getId()) { allowed = true; break; }
              try {
                var gp = DriveApp.getFolderById(parentId).getParents();
                while (gp.hasNext()) {
                  if (gp.next().getId() === userFolder.getId()) { allowed = true; break; }
                }
              } catch (_) {}
              if (allowed) break;
            }
          }

          // 2) Check root-level session folder tree
          if (!allowed) {
            try {
              var rootSession = getOrCreateSessionRootFolder_();
              if (rootSession) {
                var rParents = file.getParents();
                while (rParents.hasNext()) {
                  var rpId = rParents.next().getId();
                  try {
                    var rgp = DriveApp.getFolderById(rpId).getParents();
                    while (rgp.hasNext()) {
                      if (rgp.next().getId() === rootSession.getId()) { allowed = true; break; }
                    }
                  } catch (_) {}
                  if (allowed) break;
                }
              }
            } catch (_) {}
          }

          // 3) Admin override
          if (!allowed && auth.isAdmin) { allowed = true; }

          if (!allowed) {
            return { success: false, error: 'Файлът не е във Вашата лична папка или нямате права за преименуване.' };
          }

          var oldName = file.getName();
          file.setName(newName);

          // ── Update description to reflect rename ──
          try {
            var desc = String(file.getDescription() || '');
            if (desc) {
              var newDesc = desc.replace(/RENAMED_FROM=[^|]*/g, '').replace(/\|\|/g, '|').replace(/^\||\|$/g, '');
              newDesc = (newDesc ? newDesc + '|' : '') + 'RENAMED_FROM=' + encodeURIComponent(oldName);
              file.setDescription(newDesc);
            }
          } catch (_) {}

          var mime = file.getMimeType();
          var links = buildSecureFileLinks_(docId, { allowDownload: true, mimeType: mime });

          return {
            success: true,
            file: {
              id: docId, driveId: docId, name: newName, mimeType: mime,
              typeLabel: mimeTypeLabel(mime),
              previewLink: links.previewLink, webViewLink: links.previewLink,
              editLink: mime === 'application/vnd.google-apps.document'
                ? 'https://docs.google.com/document/d/' + docId + '/edit'
                : (mime === 'application/vnd.google-apps.spreadsheet'
                  ? 'https://docs.google.com/spreadsheets/d/' + docId + '/edit'
                  : links.previewLink),
              downloadUrl: links.downloadUrl,
              size: formatFileSize_(file.getSize()),
              sizeBytes: Number(file.getSize() || 0),
              modifiedDate: file.getLastUpdated().toISOString(),
              isGoogleDoc: !!mime.match(/google\.(document|spreadsheet|presentation|drawing|form)/i)
            },
            oldName: oldName, newName: newName
          };
        } catch (err) {
          return { success: false, error: 'Преименуването на документа не бе успешно: ' + err.message };
        }
      }

      // ============================================================
      //  UPLOAD MY DOCUMENT CHUNK — chunked upload for large files.
      //  Client splits a file into 6 MB chunks and POSTs each chunk
      //  separately. The last chunk triggers reassembly and returns
      //  the final file descriptor.
      //
      //  body: { uploadId, chunkIndex, totalChunks, chunkData,
      //          fileName, mimeType }
      //  Returns { success, complete, file? }
      // ============================================================
      function uploadMyDocumentChunk(body) {
        body = body || {};
        var auth = resolveAuthContext(body);
        if (!auth.userId) return { success: false, error: 'Необходима е автентикация' };

        var uploadId    = String(body.uploadId || '').replace(/[^a-zA-Z0-9_\-]/g, '').slice(0, 80);
        var chunkIndex  = Number(body.chunkIndex) || 0;
        var totalChunks = Math.max(1, Number(body.totalChunks) || 1);
        var fileName    = _sanitiseFileName_(body.fileName || 'file');
        var mimeType    = String(body.mimeType || 'application/octet-stream').slice(0, 120);
        var chunkData   = body.chunkData || ''; // raw base64 (no data:… prefix)
        // v10.0.0-mydocs-folders: support per-proposal upload
        var formId      = String(body.formId || '').trim();

        if (!uploadId) return { success: false, error: 'Липсва uploadId' };
        if (!chunkData) return { success: false, error: 'Липсват данни на чанка' };

        // Size guard: a 6 MB raw chunk is ~8 MB base64; reject obvious overshoots
        if (chunkData.length > 12 * 1024 * 1024) {
