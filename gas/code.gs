          var allowDl = !!isAdmin || !!isOwner;
          if (!allowDl && fid) {
            try { allowDl = _memoIsFileInPublicDownload_(fid); } catch (_) { allowDl = false; }
          }
          if (!allowDl) {
            delete copy.downloadUrl;
            delete copy.url;
            delete copy.webViewLink;
          } else if (fid) {
            // Even when download is allowed, keep the legacy webViewLink field
            // pointing at /preview so the frontend never opens a /view URL that
            // can be flipped to /edit in the address bar.
            copy.webViewLink = copy.previewLink;
            if (!copy.downloadUrl) {
              copy.downloadUrl = 'https://drive.google.com/uc?export=download&id=' + fid;
            }
          }
          return copy;
        });
      }

      // Tighten Drive sharing on newly-created files. ANYONE_WITH_LINK ensures
      // everyone with the link can view (including admins with non-@ue-varna.bg
      // accounts). DOMAIN_WITH_LINK is the fallback for when domain-wide sharing
      // is the only option permitted by the Google Workspace admin.
      // v12.20.0: swapped order — ANYONE_WITH_LINK first (fixes "file does not exist").
      function setSecureSharing_(file) {
        // PERF_MODE fast path: Drive Advanced Service issues a single
        // Permissions call (sendNotificationEmail:false) which is ~5× faster
        // than DriveApp.setSharing(). Supports Drive API v3 (Permissions.create)
        // with automatic fallback to v2 (Permissions.insert).
        if (PERF_MODE) {
          try {
            if (typeof Drive !== 'undefined' && Drive.Permissions) {
              var fid = (typeof file.getId === 'function') ? file.getId() : String(file);
              // ── Drive API v3 (preferred when "Drive API" v3 is enabled) ──
              if (typeof Drive.Permissions.create === 'function') {
                try {
                  Drive.Permissions.create(
                    { role: 'reader', type: 'anyone' },
                    fid,
                    { sendNotificationEmail: false, supportsAllDrives: true }
                  );
                  return 'anyone';
                } catch (_) {
                  try {
                    Drive.Permissions.create(
                      { role: 'reader', type: 'domain', domain: 'ue-varna.bg' },
                      fid,
                      { sendNotificationEmail: false, supportsAllDrives: true }
                    );
                    return 'domain';
                  } catch (_) {}
                }
              // ── Drive API v2 fallback ──
              } else if (typeof Drive.Permissions.insert === 'function') {
                try {
                  Drive.Permissions.insert(
                    { role: 'reader', type: 'anyone', withLink: true },
                    fid,
                    { sendNotificationEmails: false, supportsAllDrives: true }
                  );
                  return 'anyone';
                } catch (_) {
                  try {
                    Drive.Permissions.insert(
                      { role: 'reader', type: 'domain', value: 'ue-varna.bg', withLink: true },
                      fid,
                      { sendNotificationEmails: false, supportsAllDrives: true }
                    );
                    return 'domain';
                  } catch (_) {}
                }
              }
            }
          } catch (_) {}
          // fall through to DriveApp path on any failure
        }
        try {
          file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
          return 'anyone';
        } catch (_) {}
        try {
          file.setSharing(DriveApp.Access.DOMAIN_WITH_LINK, DriveApp.Permission.VIEW);
          return 'domain';
        } catch (_) {}
        return 'none';
      }

      /**
       * v12.20.0: Explicitly grant VIEW access to all admin emails.
       * Safety net — even if setSecureSharing_ falls back to DOMAIN_WITH_LINK,
       * admins with non-ue-varna.bg accounts can still access the file.
       * Fire-and-forget, errors are logged but never thrown.
       * @param {string|GoogleAppsScript.Drive.File} fileOrId
       */
      function _addAdminViewers_(fileOrId) {
        try {
          var file = (typeof fileOrId === 'string') ? DriveApp.getFileById(fileOrId) : fileOrId;
          if (!file) return;
          // v12.30.1-fix: Use the GAS spreadsheet singleton instead of bare 'ss'
          // which was undefined (ReferenceError), causing the entire function to
          // silently fail — admin viewers were NEVER added to any file.
          try {
            var adminEmails = [];
            try {
              var adminSheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('AdminSettings');
              if (adminSheet) {
                var ad = adminSheet.getDataRange().getValues();
                for (var ai = 0; ai < ad.length; ai++) {
                  if (ad[ai][0] && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(ad[ai][0])))
                    adminEmails.push(String(ad[ai][0]).trim().toLowerCase());
                }
              }
            } catch (_) {}
            if (!adminEmails.length) {
              // Fallback: read admin emails from globally cached admin list
              try {
                loadAdminCredentials_();
                if (typeof _ADMIN_EMAILS_SERVER !== 'undefined' && _ADMIN_EMAILS_SERVER && _ADMIN_EMAILS_SERVER.length) {
                  adminEmails = _ADMIN_EMAILS_SERVER.slice();
                }
              } catch (_) {}
            }
            adminEmails.forEach(function(email) {
              try { file.addViewer(email); } catch (_) {}
            });
          } catch (_) {}
        } catch (_) {}
      }

      /**
       * v12.20.0: Unified file-sharing — sets ANYONE_WITH_LINK + adds admin viewers.
       * Call this after every file copy operation.
       * @param {string|GoogleAppsScript.Drive.File} fileOrId
       */
      function shareGeneratedFile_(fileOrId) {
        setSecureSharing_(fileOrId);
        _addAdminViewers_(fileOrId);
      }

      /**
       * Grants a user editor access on a Drive file/folder WITHOUT sending
       * Google Drive's automatic "shared with you" notification email
       * (drive-shares-dm-noreply@google.com).
       * Uses Drive Advanced Service (Drive.Permissions.insert) with
       * sendNotificationEmails:false.
       * NOTE: The DriveApp.addEditor() fallback has been intentionally removed
       * because it cannot suppress Drive notification emails.  If Drive Advanced
       * Service is not enabled in the Apps Script project, access is NOT granted
       * and a warning is logged instead. Enable "Drive API" under Services in the
       * Apps Script editor to restore write-access grants without email spam.
       * @param {GoogleAppsScript.Drive.File|Folder} fileOrFolder
       * @param {string} email
       */
      function _addEditorSilently_(fileOrFolder, email) {
        var em = String(email || '').trim();
        if (!em || !fileOrFolder) return;
        if (typeof Drive === 'undefined' || !Drive.Permissions) {
          // Drive Advanced Service not enabled — skip addEditor entirely to
          // avoid sending drive-shares-dm-noreply@google.com emails.
          console.warn('_addEditorSilently_: Drive Advanced Service unavailable — skipping editor grant for ' + em + '. Enable "Drive API" v3 under Services in the Apps Script editor.');
          return;
        }
        var fid = (typeof fileOrFolder.getId === 'function') ? fileOrFolder.getId() : String(fileOrFolder);
        // ── Drive API v3 (preferred) ──
        if (typeof Drive.Permissions.create === 'function') {
          try {
            Drive.Permissions.create(
              { role: 'writer', type: 'user', emailAddress: em },
              fid,
              { sendNotificationEmail: false, supportsAllDrives: true, fields: 'id' }
            );
            return;
          } catch (permErr) {
            console.warn('_addEditorSilently_: v3 Permissions.create failed for ' + em + ': ' + permErr.message);
          }
        }
        // ── Drive API v2 fallback ──
        if (typeof Drive.Permissions.insert === 'function') {
          try {
            Drive.Permissions.insert(
              { role: 'writer', type: 'user', value: em },
              fid,
              { sendNotificationEmails: false, supportsAllDrives: true }
            );
            return;
          } catch (permErr) {
            console.warn('_addEditorSilently_: v2 Permissions.insert failed for ' + em + ': ' + permErr.message);
          }
        }
      }

      /**
       * v12.21.0: Robust user access grant — guarantees the specific user can
       * view/edit the file even when ANYONE_WITH_LINK is blocked by Workspace
       * policy. Uses DriveApp.addViewer() as a last-resort fallback (sends
       * a notification email, but ensures the user is never locked out).
       * @param {GoogleAppsScript.Drive.File} file
       * @param {string} userEmail
       * @param {string} role — 'reader' (default) or 'writer'
       */
      function _ensureUserAccess_(file, userEmail, role) {
        var em = String(userEmail || '').trim().toLowerCase();
        role = (role === 'writer' || role === 'editor') ? 'writer' : 'reader';
        if (!em || !file) return;

        // 1. Try Drive Advanced Service (silent, no email)
        if (typeof Drive !== 'undefined' && Drive.Permissions) {
          var fid = (typeof file.getId === 'function') ? file.getId() : String(file);
          try {
            if (typeof Drive.Permissions.create === 'function') {
              Drive.Permissions.create(
                { role: role, type: 'user', emailAddress: em },
                fid,
                { sendNotificationEmail: false, supportsAllDrives: true }
              );
              return;
            }
          } catch (_) {}
          try {
            if (typeof Drive.Permissions.insert === 'function') {
              Drive.Permissions.insert(
                { role: role, type: 'user', value: em },
                fid,
                { sendNotificationEmails: false, supportsAllDrives: true }
              );
              return;
            }
          } catch (_) {}
        }

        // 2. Last resort: DriveApp (works always, but sends notification email)
        // Better to send an email than block the user from their own document.
        try {
          if (role === 'writer') {
            try { file.addEditor(em); } catch(_) { file.addViewer(em); }
          } else {
            file.addViewer(em);
          }
        } catch (_) {}
      }

      /**
       * Returns (or creates) the Drive folder for a specific application.
       * Target path:  DRIVE_FOLDER_ID / {competitionFolderId} / Applications / {formId}
       * If competitionFolderId is unknown or invalid, falls back to:
       *              DRIVE_FOLDER_ID / Applications / {formId}
       */
      function getOrCreateAppFolder(formId, competitionFolderId) {
        // PERF_MODE: memoize resolved folder id by formId in ScriptProperties.
        // Folder ids are immutable for the life of the application, so a hit
        // collapses 3-4 Drive round-trips (DRIVE_FOLDER_ID → comp → Applications
        // → {formId}) into a single getFolderById call. Cache miss falls through
        // to the original walk-and-create logic and primes the cache on success.
        var fidKey = _APP_FOLDER_PROP_PREFIX + String(formId || '');
        var props = null;
        if (PERF_MODE && formId) {
          try {
            props = _scriptProps_();
            var cachedId = props.getProperty(fidKey);
            if (cachedId) {
              try { return DriveApp.getFolderById(cachedId); } catch (_) { /* stale id; fall through */ }
            }
          } catch (_) {}
        }
        var appFolder;
        try {
          var compFolder;
          if (competitionFolderId) {
            try {
              compFolder = DriveApp.getFolderById(competitionFolderId);
            } catch (_) {
              compFolder = null;
            }
          }
          if (!compFolder) {
            // Fallback: use or create an "Applications" folder directly under DRIVE_FOLDER_ID
            var mainFolder = DriveApp.getFolderById(DRIVE_FOLDER_ID);
            var appsIt = mainFolder.getFoldersByName('Applications');
            compFolder = appsIt.hasNext() ? appsIt.next() : mainFolder.createFolder('Applications');
          } else {
            // Inside the competition folder, use its "Applications" subfolder
            var subIt = compFolder.getFoldersByName('Applications');
            compFolder = subIt.hasNext() ? subIt.next() : compFolder.createFolder('Applications');
          }
          var it = compFolder.getFoldersByName(String(formId));
          appFolder = it.hasNext() ? it.next() : compFolder.createFolder(String(formId));
        } catch (e) {
          // Last resort: root of DRIVE_FOLDER_ID
          try {
            var root = DriveApp.getFolderById(DRIVE_FOLDER_ID);
            var it2  = root.getFoldersByName(String(formId));
            appFolder = it2.hasNext() ? it2.next() : root.createFolder(String(formId));
          } catch (_) {
            appFolder = DriveApp.getRootFolder();
          }
        }
        if (PERF_MODE && props && appFolder) {
          try { props.setProperty(fidKey, appFolder.getId()); } catch (_) {}
        }
        return appFolder;
      }

      /**
       * Returns (or creates) the per-user applicant document folder.
       * Path:  APPLICANT_DOCS_FOLDER_ID / {google-auth-email}
       * Each authenticated user gets their own private folder for personal
       * document copies and uploads.  Non-admin users never see each other's
       * folders because listMyDocuments scopes to the caller's email.
       */
      function getOrCreateMyDocsFolder_(userEmail) {
        var folderName = _sanitiseUserFolderName_(userEmail);
        if (!folderName) return null;
        try {
          // Per-user applicant folder lives DIRECTLY under the dedicated
          // APPLICANT_DOCS_FOLDER_ID (not under DRIVE_FOLDER_ID/My Documents)
          // so every applicant's populated templates are gathered in one place
          // an admin can browse. Path: APPLICANT_DOCS_FOLDER_ID / {email}
          var root = DriveApp.getFolderById(APPLICANT_DOCS_FOLDER_ID);
          var userIt = root.getFoldersByName(folderName);
          if (userIt.hasNext()) {
