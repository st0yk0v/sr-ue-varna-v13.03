      /**
       * Check if a leader has the required academic qualification.
       * @param {string} email
       * @returns {{ qualified: boolean, position: string, reason: string }}
       */
      function _checkLeaderQualification_(email) {
        var normalizedEmail = String(email || '').toLowerCase().trim();
        if (!normalizedEmail) return { qualified: false, position: '', reason: 'Липсва имейл на ръководител.' };
        // Must be @ue-varna.bg
        if (normalizedEmail.indexOf('@ue-varna.bg') < 0) {
          return { qualified: false, position: '', reason: 'Ръководителят трябва да е от ИУ-Варна (@ue-varna.bg).' };
        }
        // Query Reviewers sheet for academic position
        try {
          var reviewersSheet = _getOrCreateSheet_('Reviewers',
            ['id', 'email', 'name', 'title', 'specialty', 'institution', 'phone', 'status', 'createdAt']
          );
          var data = reviewersSheet.getDataRange().getValues();
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][1] || '').toLowerCase().trim() === normalizedEmail) {
              var title = String(data[i][3] || '').toLowerCase();
              var positions = ['професор', 'доцент', 'доктор', 'professor', 'associate professor', 'phd'];
              for (var j = 0; j < positions.length; j++) {
                if (title.indexOf(positions[j]) >= 0) {
                  return { qualified: true, position: String(data[i][3] || ''), reason: '' };
                }
              }
              return { qualified: false, position: String(data[i][3] || ''), reason: 'Ръководителят трябва да е професор, доцент или доктор (ОНС).' };
            }
          }
        } catch (_) {}
        return { qualified: false, position: '', reason: 'Не е открит запис за ръководителя в регистъра на рецензентите.' };
      }

      /**
       * Check if a leader has active sanctions preventing new project leadership.
       * Supports multi-area proposals: sanction matches if its direction appears
       * in ANY of the proposal's areas (;;‑delimited), or if the sanction has no
       * direction scope (global sanction).
       * @param {string} leaderEmail
       * @param {string} direction — ;;‑delimited multi-area string (or single value, optional)
       * @returns {{ hasActiveSanction: boolean, details: Array }}
       */
      function _checkActiveSanctions_(leaderEmail, direction) {
        var normalizedEmail = String(leaderEmail || '').toLowerCase().trim();
        var proposalAreas = direction ? _getAreasArray_(direction).map(function(a) { return a.toLowerCase(); }) : [];
        var details = [];
        try {
          var sanctionsSheet = _getOrCreateSheet_('Sanctions',
            ['id', 'email', 'reason', 'type', 'direction', 'startDate', 'endDate', 'active', 'projectId']
          );
          var data = sanctionsSheet.getDataRange().getValues();
          var now = new Date();
          for (var i = 1; i < data.length; i++) {
            var rowEmail = String(data[i][1] || '').toLowerCase().trim();
            // Auto-expire: if endDate has passed, mark as inactive and skip
            var endDateStr = String(data[i][6] || '').trim();
            if (endDateStr) {
              var endDate = new Date(endDateStr);
              if (!isNaN(endDate.getTime()) && endDate.getTime() < now.getTime()) {
                try { sanctionsSheet.getRange(i + 1, 8).setValue('NO'); } catch (_) {}
                continue;
              }
            }
            var active = String(data[i][7] || '').toUpperCase() === 'YES' || String(data[i][7] || '').toUpperCase() === 'TRUE';
            if (!active) continue;
            if (rowEmail !== normalizedEmail) continue;
            var sanDirection = String(data[i][4] || '').trim();
            // Global sanction (no direction scope) → always matches
            if (!sanDirection) {
              details.push({
                id: data[i][0], reason: data[i][2], type: data[i][3],
                direction: sanDirection, startDate: data[i][5], endDate: data[i][6],
                projectId: data[i][8], activeUntil: endDateStr
              });
              continue;
            }
            // Direction-scoped sanction: match if ANY proposal area overlaps
            if (direction && proposalAreas.length > 0) {
              var sanDirLower = sanDirection.toLowerCase();
              // Also check if the sanction direction itself is multi-area (;;‑delimited)
              var sanAreas = _getAreasArray_(sanDirection).map(function(a) { return a.toLowerCase(); });
              var overlap = false;
              for (var pa = 0; pa < proposalAreas.length && !overlap; pa++) {
                for (var sa = 0; sa < sanAreas.length && !overlap; sa++) {
                  if (proposalAreas[pa] === sanAreas[sa]) { overlap = true; }
                }
              }
              if (!overlap) continue;
            } else if (direction && proposalAreas.length === 0 && sanDirection !== direction) {
              continue; // backward compat: single-value direction mismatch
            }
            details.push({
              id: data[i][0], reason: data[i][2], type: data[i][3],
              direction: sanDirection, startDate: data[i][5], endDate: data[i][6],
              projectId: data[i][8], activeUntil: endDateStr
            });
          }
        } catch (_) {}
        return { hasActiveSanction: details.length > 0, details: details };
      }

      /**
       * Split a multi-area string (;;-delimited) into a cleaned array.
       * Single-value legacy rows are returned as a 1-element array.
       * Results are memoized per unique input string for the lifetime of
       * the current request — critical for ranking hot-paths.
       * @param {string} areaStr — raw cell value (may be ";;" separated)
       * @returns {Array<string>}
       */
      var _areasArrayCache_ = {};
      function _getAreasArray_(areaStr) {
        var raw = String(areaStr || '').trim();
        if (!raw) return [];
        if (_areasArrayCache_.hasOwnProperty(raw)) return _areasArrayCache_[raw];
        var result = raw.split(';;').map(function(s) { return s.trim(); }).filter(Boolean);
        _areasArrayCache_[raw] = result;
        // Prevent unbounded growth — cap cache at 200 entries (covers any realistic ranking run)
        var keys = Object.keys(_areasArrayCache_);
        if (keys.length > 200) { _areasArrayCache_ = {}; }
        return result;
      }

      /**
       * Check if a proposal's priority matches the competition's approved priority list.
       * Supports multi-area proposals: matches if ANY of the proposal's areas is in the list.
       * @param {string} proposalPriority — ;;‑delimited multi-area string (or single value)
       * @param {Array} competitionPriorities
       * @returns {{ matches: boolean, reason: string }}
       */
      function _checkPriorityMatch_(proposalPriority, competitionPriorities) {
        if (!Array.isArray(competitionPriorities) || !competitionPriorities.length) {
          return { matches: true, reason: '' }; // No priority constraint set
        }
        var areas = _getAreasArray_(proposalPriority);
        if (!areas.length) return { matches: false, reason: 'Не е посочено приоритетно направление.' };
        // Build a lowercase set of competition priorities for O(1) lookup
        var compSet = {};
        for (var i = 0; i < competitionPriorities.length; i++) {
          compSet[String(competitionPriorities[i] || '').trim().toLowerCase()] = true;
        }
        for (var j = 0; j < areas.length; j++) {
          if (compSet[areas[j].toLowerCase()]) {
            return { matches: true, reason: '' };
          }
        }
        return { matches: false, reason: 'Нито едно от посочените направления не съответства на утвърдените приоритети на конкурса.' };
      }

