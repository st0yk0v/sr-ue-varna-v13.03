      /**
       * pushSingleToHostinger — Push a single record change to MySQL.
       * Called automatically from postProcessMutation_ for instant mirror.
       * POST body: { table, record: {...}, action: 'upsert'|'delete' }
       */
      function pushSingleToHostinger(body) {
        var table = String(body.table || '').trim();
        var record = body.record;
        var action = String(body.action || 'upsert').trim();
        if (!table || !record) return { success: false, error: 'Missing table or record' };
        var result = _pushToHostinger_(table, [record]);
        return result;
      }

      /**
       * v12.21.0: syncAllToMySQL — Public function for manual or scheduled full sync.
       * Call from GAS Editor: syncAllToMySQL()
       * Or from menu:  ERP → Sync → Full mirror to MySQL
       * Or via time-based trigger every 15 minutes.
       */
      function syncAllToMySQL() {
        console.log('syncAllToMySQL: starting full mirror...');
        var start = Date.now();
        var result = mirrorAllToHostinger({ _internal: true });
        var elapsed = Date.now() - start;
        console.log('syncAllToMySQL: done in ' + elapsed + 'ms. Total records: ' + (result.totalRecords || 0));
        if (result.errors && result.errors.length) {
          console.warn('syncAllToMySQL errors: ' + JSON.stringify(result.errors));
        }
        return result;
      }

      // ── GAS↔MySQL Cache Bridge Handlers (v10.8.0) ──────────────────────
      // These enable the frontend data-layer to use Hostinger MariaDB as a
      // read cache. The PHP backend calls these GAS endpoints to populate
      // and refresh the MySQL `gas_cache` table.

      /** Handle gasSetCache — PHP wants to store a GAS response in MySQL */
      function _handleGasSetCache_(body) {
        try {
          body = body || {};
          var cacheKey = String(body.cacheKey || body.cache_key || '').trim();
          var action = String(body.action || '').trim();
          var data = body.data || body.response_data || null;
          var userEmail = String(body.userEmail || body.user_email || '').trim();
          var ttl = Number(body.ttl || 3600);
          if (!cacheKey || !data) return { success: false, error: 'Missing cacheKey or data' };
          // Delegate to PHP via Hostinger API
          var result = _pushToHostinger_('gas_cache', [{
            cache_key: cacheKey, action: action, response_data: typeof data === 'string' ? data : JSON.stringify(data),
            user_email: userEmail, ttl: ttl
          }]);
          return { success: true, cached: true, key: cacheKey, result: result };
        } catch (e) { return { success: false, error: e.message }; }
      }

      /** Handle gasGetCache — PHP asks GAS for fresh data to cache */
      function _handleGasGetCache_(body) {
        try {
          body = body || {};
          var action = String(body.action || '').trim();
          var userEmail = String(body.userEmail || body.user_email || '').trim();
          if (!action) return { success: false, error: 'Missing action' };
          // Re-dispatch the original action to get fresh data
          var result = executeApiAction_(action, body, { readOnlyOnly: true });
          return { success: true, data: result, action: action };
        } catch (e) { return { success: false, error: e.message }; }
      }

      /** Handle gasSync — PHP pulls fresh data from GAS and caches it */
      function _handleGasSync_(body) {
        try {
          body = body || {};
          var syncAction = String(body.syncAction || body.action || '').trim();
          if (!syncAction) return { success: false, error: 'Missing syncAction' };
          var freshData = executeApiAction_(syncAction, body, { readOnlyOnly: true });
          return { success: true, synced: syncAction, data: freshData };
        } catch (e) { return { success: false, error: e.message }; }
      }

      /** Handle warmUserCache — pre-populate MySQL cache after login */
      function _handleWarmUserCache_(body) {
        try {
          body = body || {};
          var userEmail = String(body.userEmail || body.email || body.userId || '').trim();
          var results = [];
          // Pre-warm critical data: competitions, forms, projects
          var actions = ['getcompetitions', 'getforms', 'getprojects'];
          for (var i = 0; i < actions.length; i++) {
            try {
              var data = executeApiAction_(actions[i], { userId: userEmail, isAdmin: !!body.isAdmin, lean: true }, { readOnlyOnly: true });
              results.push({ action: actions[i], ok: true });
            } catch (_) { results.push({ action: actions[i], ok: false }); }
          }
          return { success: true, warmed: results, userEmail: userEmail };
        } catch (e) { return { success: false, error: e.message }; }
      }

      /** Handle _fullmirror — complete data set mirroring */
      function _handleFullMirror_(body) {
        try {
          body = body || {};
          // This is a server-to-server endpoint, auth is via _gasSync flag
          if (!body._gasSync && !body._internal) {
            var auth = resolveAuthContext(body);
            if (!auth.isAdmin) return { success: false, error: 'Admin access required for full mirror.' };
          }
          return mirrorAllToHostinger(body);
        } catch (e) { return { success: false, error: e.message }; }
      }

      // ── Application-level team change requests (v9.52.0-teamchange) ─────
      // Allows applicants in draft / submitted / admin_review stages to
      // request changes to team members or the leader without reopening the
      // full edit form. Requests go through the existing ChangeRequests sheet
      // (PROJECT_ID prefixed with "APP:" to distinguish from project-level CRs).
      // On admin approval the Applications sheet (COL.TEAM_MEMBERS /
      // COL.USER_EMAIL / COL.USER_NAME) is updated atomically.
      // Allowed statuses for submitting a request:
      var _APP_CR_ALLOWED_STATUSES = {
        draft: true, submitted: true,
        admin_review: true, returned: true, needs_correction: true
      };
      var _APP_CR_PREFIX = 'APP:';

      function createAppTeamChangeRequest(body) {
        try {
          body = body || {};
          var formId  = String(body.formId || body.id || '').trim();
          var change  = String(body.changeType || '').trim(); // 'app_team_change' | 'app_leader_change'
          var desc    = String(body.description || '').trim();
          if (!formId) return { success: false, error: 'Missing formId.' };
          if (change !== 'app_team_change' && change !== 'app_leader_change')
            return { success: false, error: 'Невалиден тип промяна. Допустими: app_team_change, app_leader_change.' };
          var auth    = resolveAuthContext(body);
          var userId  = (auth.userId || '').toLowerCase().trim();
          var sheet   = getSheet();
          var found   = findRowByID(sheet, formId);
          if (!found) return { success: false, error: 'Формулярът не е намерен.' };
          var row     = found.rowData;
          var ownerEmail = String(row[COL.USER_EMAIL - 1] || '').toLowerCase().trim();
          // Auth: only the form owner or an admin can create a request
          if (!auth.isAdmin && userId !== ownerEmail)
            return { success: false, error: 'Само кандидатът или администраторът може да заявява промени.' };
          var curStatus = String(row[COL.STATUS - 1] || '').toLowerCase().trim();
          if (!auth.isAdmin && !_APP_CR_ALLOWED_STATUSES[curStatus])
            return { success: false, error: 'Промени в екипа могат да се заявяват само при статус: чернова, изпратено за проверка или административна проверка. Текущ статус: ' + curStatus };
          // Prevent duplicate pending requests for the same type+form
          var crSheet = getChangeRequestsSheet();
          var crData  = crSheet.getDataRange().getValues();
          var projKey = _APP_CR_PREFIX + formId;
          for (var ci = 1; ci < crData.length; ci++) {
            if (String(crData[ci][CR_COL.PROJECT_ID - 1]).trim() !== projKey) continue;
            if (String(crData[ci][CR_COL.CHANGE_TYPE - 1]).trim() !== change) continue;
            if (String(crData[ci][CR_COL.STATUS - 1]).trim() === 'submitted') {
              return { success: false, error: 'Вече имате активна заявка за тази промяна. Изчакайте решение на администратора.' };
            }
          }
          // Collect old + new data from request body
          var oldData = {};
          var newData = {};
          if (change === 'app_team_change') {
            oldData.teamMembers = safeParseJSON(String(row[COL.TEAM_MEMBERS - 1] || '[]'), []);
            newData.teamMembers = Array.isArray(body.newTeamMembers) ? body.newTeamMembers : safeParseJSON(String(body.newTeamMembers || '[]'), []);
            if (!Array.isArray(newData.teamMembers) || newData.teamMembers.length === 0)
              return { success: false, error: 'Липсват данни за новите членове на екипа (newTeamMembers).' };
          } else {
            oldData.leaderEmail = String(row[COL.USER_EMAIL - 1] || '');
            oldData.leaderName  = String(row[COL.USER_NAME - 1] || '');
            newData.newLeaderEmail = String(body.newLeaderEmail || '').trim().toLowerCase();
            newData.newLeaderName  = String(body.newLeaderName || '').trim();
            if (!newData.newLeaderEmail)
              return { success: false, error: 'Липсва newLeaderEmail.' };
          }
          var crId  = 'CR-' + Utilities.getUuid().replace(/-/g, '').substring(0, 12).toUpperCase();
          var now   = nowISO();
          var crRow = new Array(CR_TOTAL_COLS).fill('');
          crRow[CR_COL.ID           - 1] = crId;
          crRow[CR_COL.PROJECT_ID   - 1] = projKey;
          crRow[CR_COL.CHANGE_TYPE  - 1] = change;
          crRow[CR_COL.REQUESTED_BY - 1] = auth.userId || userId;
          crRow[CR_COL.REQUESTED_AT - 1] = now;
          crRow[CR_COL.STATUS       - 1] = 'submitted';
          crRow[CR_COL.DESCRIPTION  - 1] = desc || (change === 'app_team_change' ? 'Промяна в членовете на екипа' : 'Промяна на ръководител');
          crRow[CR_COL.OLD_DATA     - 1] = JSON.stringify(oldData);
          crRow[CR_COL.NEW_DATA     - 1] = JSON.stringify(newData);
          crRow[CR_COL.NOTES        - 1] = String(body.notes || '');
          crSheet.appendRow(crRow);
          // Append history entry on the application
          var appRow   = found.rowData.slice();
          var appHist  = safeParseJSON(String(appRow[COL.HISTORY - 1] || '[]'), []);
          appHist.push({
            action: change === 'app_team_change' ? 'Заявена промяна в екипа — чака одобрение' : 'Заявена промяна на ръководител — чака одобрение',
            date: now,
            user: auth.userId || userId,
            crId: crId
          });
          appRow[COL.HISTORY - 1] = JSON.stringify(appHist);
          safeSetRow_(sheet, found.rowIndex, appRow, TOTAL_COLS);
          try { logError('createAppTeamChangeRequest', { changeRequestId: crId, formId: formId, changeType: change }, body); } catch (_) {}
          return { success: true, changeRequestId: crId };
        } catch (err) {
          try { logError('createAppTeamChangeRequest', err, body); } catch (_) {}
          return { success: false, error: 'createAppTeamChangeRequest: ' + err.message };
        }
      }

      function getAppTeamChangeRequests(body) {
        try {
          body = body || {};
          var formId = String(body.formId || body.id || '').trim();
          if (!formId) return { success: false, error: 'Missing formId.', requests: [] };
          var auth   = resolveAuthContext(body);
          var userId = (auth.userId || '').toLowerCase().trim();
          var sheet  = getSheet();
          var found  = findRowByID(sheet, formId);
          if (!found) return { success: false, error: 'Формулярът не е намерен.', requests: [] };
          var ownerEmail = String(found.rowData[COL.USER_EMAIL - 1] || '').toLowerCase().trim();
          if (!auth.isAdmin && userId !== ownerEmail)
            return { success: false, error: 'Нямате достъп до тази заявка.', requests: [] };
          var crSheet = getChangeRequestsSheet();
          var crData  = crSheet.getDataRange().getValues();
          var projKey = _APP_CR_PREFIX + formId;
          var requests = [];
          for (var i = 1; i < crData.length; i++) {
            if (String(crData[i][CR_COL.PROJECT_ID - 1]).trim() !== projKey) continue;
            requests.push({
              id:          String(crData[i][CR_COL.ID - 1]),
              changeType:  String(crData[i][CR_COL.CHANGE_TYPE - 1]),
              requestedBy: String(crData[i][CR_COL.REQUESTED_BY - 1]),
              requestedAt: String(crData[i][CR_COL.REQUESTED_AT - 1]),
              status:      String(crData[i][CR_COL.STATUS - 1]),
              description: String(crData[i][CR_COL.DESCRIPTION - 1]),
              oldData:     safeParseJSON(String(crData[i][CR_COL.OLD_DATA - 1] || '{}'), {}),
              newData:     safeParseJSON(String(crData[i][CR_COL.NEW_DATA - 1] || '{}'), {}),
              reviewedBy:  String(crData[i][CR_COL.REVIEWED_BY - 1] || ''),
              reviewedAt:  String(crData[i][CR_COL.REVIEWED_AT - 1] || ''),
              decision:    String(crData[i][CR_COL.DECISION - 1] || ''),
              notes:       String(crData[i][CR_COL.NOTES - 1] || '')
            });
          }
          return { success: true, requests: requests };
        } catch (err) {
          try { logError('getAppTeamChangeRequests', err, body); } catch (_) {}
          return { success: false, error: 'getAppTeamChangeRequests: ' + err.message, requests: [] };
        }
      }

      // ═══════════════════════════════════════════════════════════════════
      //  Budget Tracker (v9.51.0-budgettracker)
      // updatebudget: called by BudgetTrackerView inline edit & import confirm.
      // Writes the full budget JSON to PROJ_COL.BUDGET and appends a history
      // entry inside PROJ_COL.BUDGET_EXECUTION so both are persisted atomically.
      function updateBudget(body) {
        try {
          body = body || {};
          var projectId = String(body.projectId || '').trim();
          if (!projectId) return { success: false, error: 'Missing projectId' };
          var updBudget = body.budget; // full budget object {catId: {year: bgn, ...}, ...}
          if (!updBudget || typeof updBudget !== 'object') return { success: false, error: 'Missing or invalid budget' };
          var sheet = getProjectsSheet();
          var found = findRowByID(sheet, projectId);
          if (!found) return { success: false, error: 'Project not found' };
          var row = found.rowData.slice(); // clone
          // Write budget JSON to PROJ_COL.BUDGET (col 13)
          row[PROJ_COL.BUDGET - 1] = JSON.stringify(updBudget);
          // Append history entry into BUDGET_EXECUTION (col 14)
          var execRaw = safeParseJSON(String(row[PROJ_COL.BUDGET_EXECUTION - 1] || '{}'), {});
          if (!execRaw.history || !Array.isArray(execRaw.history)) execRaw.history = [];
          var histEntry = {
            type: 'UPDATE_BUDGET',
            at: nowISO(),
            by: String(body.userId || body.userName || ''),
            category: String(body.changedCategory || ''),
            prevAmount: Number(body.prevAmount) || 0,
            newAmount: Number(body.newAmount) || 0,
            note: String(body.note || '')
          };
          execRaw.history.unshift(histEntry);
          // Keep max 50 entries to avoid column bloat
          if (execRaw.history.length > 50) execRaw.history = execRaw.history.slice(0, 50);
          row[PROJ_COL.BUDGET_EXECUTION - 1] = JSON.stringify(execRaw);
          safeSetRow_(sheet, found.rowIndex, row, PROJ_TOTAL_COLS);
          // Server-side budget validation (2026 Правилник)
          var _bwEur = 1.95583;
          var _bwType = String(row[PROJ_COL.PROJECT_CODE - 1] || '').replace(/[-_\s].*/, '').toUpperCase();
          var _bwTot = 0; var _bwCat = {};
          Object.keys(updBudget).forEach(function(k) {
            if (k === '_monthlyMode' || k === '_monthly') return;
            var s = 0; Object.keys(updBudget[k] || {}).forEach(function(yr){ s += Number((updBudget[k] || {})[yr]) || 0; });
            _bwCat[k] = s; _bwTot += s;
          });
          var _bwP = function(k) { return _bwTot > 0 ? (_bwCat[k] || 0) / _bwTot * 100 : 0; };
          var bwW = [];
          if (_bwType === 'ФНИ' || _bwType === 'ПНИ') {
            if (_bwTot / _bwEur > 12000.5) bwW.push('Общият бюджет надвишава 12 000 €');
            if (_bwP('literature') > 10.5) bwW.push('Литература ' + _bwP('literature').toFixed(1) + '% > 10%');
            if (_bwP('consumables') > 5.5) bwW.push('Консумативи ' + _bwP('consumables').toFixed(1) + '% > 5%');
            if (_bwP('salaries') > 35.5) bwW.push('Възнаграждения ' + _bwP('salaries').toFixed(1) + '% > 35%');
            var extLim = _bwType === 'ФНИ' ? 25 : 20;
            if (_bwP('external_services') > extLim + 0.5) bwW.push('Външни услуги ' + _bwP('external_services').toFixed(1) + '% > ' + extLim + '%');
            var travLim = _bwType === 'ФНИ' ? 20 : 15;
            if (_bwP('travel') > travLim + 0.5) bwW.push('Командировки ' + _bwP('travel').toFixed(1) + '% > ' + travLim + '%');
          }
          if (_bwType === 'ДНП') {
            if (_bwTot / _bwEur > 5000.5) bwW.push('Общият бюджет надвишава 5 000 €');
            if ((_bwCat['salaries'] || 0) > 0.01) bwW.push('Заплатите са ЗАБРАНЕНИ за ДНП');
          }
          if (_bwType === 'НПФ') {
            if (_bwTot / _bwEur > 6000.5) bwW.push('Общият бюджет надвишава 6 000 €');
            if ((_bwCat['salaries'] || 0) / _bwEur > 511.5) bwW.push('Гост-лектор > 511 €');
          }
          return { success: true, warnings: bwW };
        } catch (err) {
          try { logError('updateBudget', err, body); } catch (_) {}
          return { success: false, error: 'updateBudget: ' + err.message };
        }
      }

