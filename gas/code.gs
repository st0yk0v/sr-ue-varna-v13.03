/**
 * Bulk sync competitions to MySQL. Called by Laravel after batch operations.
 * @param {Object} body - { competitionIds?: string[] }
 * @returns {{ok: boolean, synced: number, errors?: Array<string>}}
 */
function bulkSyncCompetitionsToMySQL(body) {
  try {
    body = body || {};
    var ids = body.competitionIds;
    var competitions = getOrCacheCompetitions(true);
    var toSync = ids ? competitions.filter(function(c) { return ids.indexOf(c.id) !== -1; }) : competitions;
    var synced = 0;
    var errors = [];
    for (var i = 0; i < toSync.length; i++) {
      try {
        _syncToMySQL_('createcompetition', toSync[i]);
        synced++;
      } catch (e) {
        errors.push(toSync[i].id + ': ' + e.message);
      }
    }
    return { ok: errors.length === 0, synced: synced, errors: errors.length ? errors : undefined };
  } catch (e) {
    return { ok: false, error: e.message };
  }
}

/**
 * Get applications with full details for Laravel sync.
 * @param {Object} body - { competitionId?: string, status?: string, limit?: number }
 * @returns {{ok: boolean, applications: Array, total: number}}
 */
function getApplicationsForSync(body) {
  try {
    body = body || {};
    var auth = resolveAuthContext(body);
    if (!auth.isAdmin) return { ok: false, error: 'Admin required.' };
    var filterComp = body.competitionId ? String(body.competitionId).trim() : '';
    var filterStatus = body.status ? String(body.status).trim() : '';
    var limit = Math.min(500, Math.max(1, Number(body.limit) || 200));

    var sheet = getSheet();
    var data = sheet.getDataRange().getValues();
    var apps = [];
    for (var i = 1; i < data.length && apps.length < limit; i++) {
      var row = data[i];
      var comp = String(row[COL.COMPETITION - 1] || '').trim();
      var status = String(row[COL.STATUS - 1] || '').trim();
      if (filterComp && comp !== filterComp) continue;
      if (filterStatus && status !== filterStatus) continue;
      apps.push(rowToObject(row));
    }
    return { ok: true, applications: apps, total: apps.length };
  } catch (e) {
    return { ok: false, error: e.message };
  }
}

/**
 * Laravel-triggered cache invalidation.
 * @param {Object} body - { secret: string, scopes?: string[] }
 * @returns {{ok: boolean, invalidated: Array<string>}}
 */
function invalidateCacheRemote(body) {
  try {
    body = body || {};
    var secret = String(body.secret || '').trim();
    var storedToken = '';
    try { storedToken = _scriptProps_().getProperty('GAS_WEBHOOK_TOKEN') || ''; } catch (_) {}
    if (!storedToken || secret !== storedToken) {
      return { ok: false, error: 'Invalid secret.' };
    }
    var scopes = Array.isArray(body.scopes) ? body.scopes : ['COMPETITIONS', 'REVIEWERS_ALL'];
    var invalidated = [];
    for (var i = 0; i < scopes.length; i++) {
      var scope = scopes[i].toUpperCase();
      if (scope === 'COMPETITIONS') {
        _invalidateCompetitionsCache_();
        invalidated.push('COMPETITIONS');
      }
      if (scope === 'REVIEWERS_ALL') {
        invalidated.push('REVIEWERS_ALL');
      }
      if (scope === '*') {
        _scriptProps_().setProperty('CACHE_VERSION', String(Date.now()));
        invalidated.push('*');
        break;
      }
    }
    return { ok: true, invalidated: invalidated };
  } catch (e) {
    return { ok: false, error: e.message };
  }
}

