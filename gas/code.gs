          logError('rejectMONByMinistry', err, body);
          return { success: false, error: 'rejectMONByMinistry failed: ' + err.message };
        }
      }

      function archiveMONReport(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin) return { success: false, error: 'Само Администратор може да архивира.' };
          var reportId = String(body.reportId || '').trim();
          var force = body.force === true || body.force === 'true';
          var found = _monFindById_(reportId);
          if (!found) return { success: false, error: 'Отчетът не е намерен.' };
          var st = String(found.rowData[MON_COL.STATUS - 1]).toLowerCase();
          if (st !== MON_STATUS.ACKNOWLEDGED) return { success: false, error: 'Само потвърден отчет може да бъде архивиран.' };
          if (!force) {
            var ackAt = new Date(String(found.rowData[MON_COL.ACKNOWLEDGED_AT - 1] || ''));
            if (isNaN(ackAt.getTime()) || ((Date.now() - ackAt.getTime()) < 30 * 24 * 60 * 60 * 1000)) {
              return { success: false, error: 'Може да се архивира само 30 дни след потвърждение (или с force=true).' };
            }
          }
          var historyArr = _monParseJson_(found.rowData[MON_COL.HISTORY - 1], []);
          historyArr = _monAppendHistory_(historyArr, { status: MON_STATUS.ARCHIVED, ts: nowISO(), by: auth.userId, role: auth.role });
          found.sheet.getRange(found.rowIndex, MON_COL.STATUS).setValue(MON_STATUS.ARCHIVED);
          found.sheet.getRange(found.rowIndex, MON_COL.HISTORY).setValue(JSON.stringify(historyArr));
          try { logTransaction('ARCHIVE_MON_REPORT', auth.userId, reportId, {}); } catch (_) {}
          return { success: true };
        } catch (err) {
          logError('archiveMONReport', err, body);
          return { success: false, error: 'archiveMONReport failed: ' + err.message };
        }
      }

      function cancelMONReport(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!_monIsAuthorized_(auth, MON_ROLES.FINALIZER)) {
            return { success: false, error: 'Само Зам.-ректор или Администратор може да отмени.' };
          }
          var reportId = String(body.reportId || '').trim();
          var reason = String(body.reason || '').trim();
          var found = _monFindById_(reportId);
          if (!found) return { success: false, error: 'Отчетът не е намерен.' };
          var st = String(found.rowData[MON_COL.STATUS - 1]).toLowerCase();
          if ([MON_STATUS.CREATED, MON_STATUS.UNDER_EDITORIAL_REVIEW, MON_STATUS.FINALIZED].indexOf(st) === -1) {
            return { success: false, error: 'Не може да се отмени отчет в статус „' + st + '".' };
          }
          var historyArr = _monParseJson_(found.rowData[MON_COL.HISTORY - 1], []);
          historyArr = _monAppendHistory_(historyArr, { status: MON_STATUS.CANCELLED, ts: nowISO(), by: auth.userId, role: auth.role, note: reason });
          found.sheet.getRange(found.rowIndex, MON_COL.STATUS).setValue(MON_STATUS.CANCELLED);
          found.sheet.getRange(found.rowIndex, MON_COL.HISTORY).setValue(JSON.stringify(historyArr));
          _monNotify_(_monNidds_(), 'МОН отчет ' + found.rowData[MON_COL.PERIOD - 1] + ' отменен', 'ℹ Отчет към МОН отменен',
            [{ label: 'ID', value: reportId }, { label: 'Причина', value: reason || '(няма)' }]);
          try { logTransaction('CANCEL_MON_REPORT', auth.userId, reportId, { reason: reason }); } catch (_) {}
          return { success: true };
        } catch (err) {
          logError('cancelMONReport', err, body);
          return { success: false, error: 'cancelMONReport failed: ' + err.message };
        }
      }

      function exportMONReportFile(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!_monIsAuthorized_(auth, MON_ROLES.READER)) {
            return { success: false, error: 'Нямате право.' };
          }
          var reportId = String(body.reportId || '').trim();
          var format = String(body.format || 'pdf').toLowerCase();
          if (['pdf','xlsx'].indexOf(format) === -1) return { success: false, error: 'Невалиден формат.' };
          var found = _monFindById_(reportId);
          if (!found) return { success: false, error: 'Отчетът не е намерен.' };
          var fileId = format === 'pdf' ?
            String(found.rowData[MON_COL.EXPORT_FILE_ID - 1] || '').trim() :
            String(found.rowData[MON_COL.EXPORT_XLSX_ID - 1] || '').trim();
          // Verify file is still in Drive (not trashed/deleted out-of-band).
          var live = false;
          if (fileId) { try { var fchk = DriveApp.getFileById(fileId); live = !!fchk && !fchk.isTrashed(); } catch (_) { live = false; } }
          var generated = false;
          if (!live) {
            try {
              fileId = format === 'pdf' ? _generateMONReportPdf_(reportId) : _generateMONReportXlsx_(reportId);
              generated = true;
            } catch (gErr) { return { success: false, error: 'Неуспешно генериране: ' + gErr.message }; }
          }
          return { success: true, fileUrl: 'https://drive.google.com/file/d/' + fileId + '/view', fileId: fileId, format: format, generated: generated };
        } catch (err) {
          logError('exportMONReportFile', err, body);
          return { success: false, error: 'exportMONReportFile failed: ' + err.message };
        }
      }

