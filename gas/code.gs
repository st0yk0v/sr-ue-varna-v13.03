          }
        },
        'ПНИ': {
          sections: [
            { id: 'info',        label: 'Обща информация',           required: true,  fields: ['title','description','area','objectives','expectedResults','trl'] },
            { id: 'team',        label: 'Екип',                      required: true,  fields: ['leader','members'] },
            { id: 'budget',      label: 'Бюджет',                    required: true,  fields: ['budgetCategories','total','monthlyBreakdown'] },
            { id: 'workProgram', label: 'Работна програма',          required: true,  fields: ['activities'] },
            { id: 'selfAssessment', label: 'Самооценка',             required: true,  fields: ['scores'] },
            { id: 'supportLetters', label: 'Писма за подкрепа',      required: false, fields: ['letters'], maxItems: 2 },
            { id: 'collaborators', label: 'Сътрудници-студенти',     required: false, fields: ['students'], maxItems: 3 },
            { id: 'documents',   label: 'Документи',                 required: true,  fields: ['cv','declarations','attachments'] }
          ],
          rules: {
            noExpensesFirstMonth: true,
            requiresSelfAssessment: true,
            requiresTRL: true,
