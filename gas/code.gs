        }
      }

      /**
       * _prefillBudgetMetadata_ — write form metadata (project type, ID, acronym, etc.)
       * into the budget spreadsheet so the generated doc is fully self-contained.
       * Scans the first few rows for labelled cells (e.g. "Тип проект:", "Акроним:")
       * and writes the corresponding value into the adjacent cell.
       */
      function _prefillBudgetMetadata_(ssId, gid, meta) {
        if (!meta || !meta.projectType) return;
        try {
          var ss = SpreadsheetApp.openById(ssId);
          var sheet = null;
          var sheets = ss.getSheets();
          for (var i = 0; i < sheets.length; i++) {
            if (String(sheets[i].getSheetId()) === String(gid)) { sheet = sheets[i]; break; }
          }
          if (!sheet) sheet = sheets[0];
          if (!sheet) return;

          // Scan first 30 rows × first 4 columns for label → value pairs
          var range = sheet.getRange(1, 1, 30, 4);
          var values = range.getValues();
          var labelMap = {
            'тип проект':        meta.projectType,
            'project type':      meta.projectType,
            'акроним':           meta.acronym,
            'acronym':           meta.acronym,
            'id на заявление':   meta.formId,
            'form id':           meta.formId,
            'проект id':         meta.formId,
            'име на кандидат':   meta.applicantName,
            'applicant':         meta.applicantName,
            'заглавие':          meta.projectTitle,
            'project title':     meta.projectTitle,
            'ръководител':       meta.applicantName,
            'leader':            meta.applicantName
          };

          for (var r = 0; r < values.length; r++) {
            var cellText = String(values[r][0] || '').toLowerCase().replace(/[\s:*]/g, '').trim();
            if (!cellText) continue;
            // Find matching label key (flexible: label can be embedded in the cell text)
            for (var lk in labelMap) {
              var lkClean = lk.replace(/[\s:*]/g, '');
              if (cellText.indexOf(lkClean) !== -1) {
                var val = labelMap[lk];
                if (!val) continue;
                // Look for the first EMPTY cell to the right (col B, C, D) to write into
                for (var c = 1; c < 4; c++) {
                  var targetVal = String(values[r][c] || '').trim();
                  if (!targetVal) {
                    sheet.getRange(r + 1, c + 1).setValue(val);
                    break;
                  }
                }
              }
            }
          }
        } catch (_) {}
      }

      // Conservative budget-cell pre-fill: scans the target worksheet for a row
      // whose first columns mention a known cost-group keyword and writes the
      // group total into the first EMPTY, non-formula cell to its right (so the
      // template's own formulas/labels are never clobbered). Returns # of cells
      // written. Wrapped by callers in try/catch — never throws fatally.
      function _prefillBudgetSheet_(ssId, gid, budget) {
        var written = 0;
        try {
          if (!budget || typeof budget !== 'object') return 0;
          // v12.12.0-budgetflow: Expanded keyword map covering ALL Bulgarian cost
          // group labels from the official budget spreadsheets per project type.
          // Uses longest-match-first to avoid ambiguity (e.g. "външни услуги"
          // vs "възнаграждения"). Each entry is an array of Bulgarian substrings.
          var KEYWORDS = {
            'salaries':          ['възнагражд','заплат','хонорар','труд'],
            'external_services': ['външни услуги','външна услуга','услуги'],
            'assets':            ['дълготрайни активи','дма','оборудване','активи'],
            'consumables':       ['консумат','материали','офис консумативи'],
            'literature':        ['литература','книги','абонамент'],
            'travel':            ['командиров','пътува','пътни','travel'],
            'publications':      ['публикац','издател','печат','такса публикац'],
            'reviews':           ['рецензи','рецензент','review'],
            'other':             ['други','непредвидени','резерв'],
            // v12.12.0: Additional Bulgarian cost groups from official templates
            'visual_identity':   ['визуална идентичност','бранд','лого','уеб дизайн'],
            'event_portfolio':   ['портфолио','папки','баджове','материали за участници'],
            'guest_lecturer':    ['гост-лектор','keynote','поканен лектор'],
            'technical_services':['техническо','озвучаване','заснемане','превод'],
            'dissemination':     ['разпространение','реклама','медийно'],
            'proceedings_print': ['печатен сборник','сборник печат','университетско издателство'],
            'proceedings_digital':['дигитален сборник','електронен сборник'],
            'doi':               ['doi','идентификатор'],
            'metadata':          ['метаданни','bpos','база данни'],
            'team_remuneration': ['екип','членове на екипа','докторанти','млади учени'],
            'office_supplies':   ['офис','канцеларски'],
            'datasets':          ['данни','бази данни','datasets'],
            'typesetting':       ['предпечат','оформление','графичен дизайн'],
            'translation':       ['превод','езикова редакция'],
            'conference_fees':   ['конферентна такса','такса участие','регистрационна такса'],
            'empirical_research':['емпирично','теренно','анкети','интервюта'],
            'utility_model':     ['полезен модел','патент','защита на интелектуална'],
            'monograph_publication':['монография','публикуване на монография'],
            'monograph_review':  ['рецензия на монография','рецензент на монография']
          };
          // Sum each cost group across years/periods (yearly + monthly modes).
          var totals = {};
          Object.keys(budget).forEach(function(gidKey) {
            if (gidKey === '_monthlyMode' || gidKey === '_monthly') return;
            var byYear = budget[gidKey] || {};
            var sum = 0;
            if (byYear && typeof byYear === 'object') {
              Object.keys(byYear).forEach(function(yr) { var n = Number(byYear[yr]); if (!isNaN(n)) sum += n; });
            }
            if (sum) totals[gidKey] = (totals[gidKey] || 0) + sum;
          });
          var md = budget._monthly;
          if (md && typeof md === 'object') {
            Object.keys(md).forEach(function(mgid) {
              var mp = md[mgid] || {};
              var s = 0;
              if (mp && typeof mp === 'object') { Object.keys(mp).forEach(function(p) { var n = Number(mp[p]); if (!isNaN(n)) s += n; }); }
              if (s) totals[mgid] = (totals[mgid] || 0) + s;
            });
          }
          if (!Object.keys(totals).length) return 0;

          var ss = SpreadsheetApp.openById(ssId);
          var sheet = null;
          var sheets = ss.getSheets();
          for (var i = 0; i < sheets.length; i++) {
            if (String(sheets[i].getSheetId()) === String(gid)) { sheet = sheets[i]; break; }
          }
          if (!sheet) sheet = sheets[0];
          if (!sheet) return 0;

          var rng = sheet.getDataRange();
          var values = rng.getValues();
          var formulas = rng.getFormulas();
          var nRows = values.length;
          var nCols = values[0] ? values[0].length : 0;

          for (var r = 0; r < nRows; r++) {
            var labelText = '';
            for (var c = 0; c < Math.min(3, nCols); c++) { labelText += ' ' + String(values[r][c] || '').toLowerCase(); }
            if (!labelText.trim()) continue;
            // Pick the MOST SPECIFIC match: the longest keyword that occurs in the
            // label wins. This prevents rows like "Външни услуги (≤ 20% от
            // възнагражденията)" — which contain both 'външни услуги' and
            // 'възнагражд' — from being mis-assigned to the salaries group.
            var matchedGid = null, bestLen = 0;
            Object.keys(KEYWORDS).forEach(function(g) {
              KEYWORDS[g].forEach(function(kw) {
                if (labelText.indexOf(kw) >= 0 && kw.length > bestLen) { bestLen = kw.length; matchedGid = g; }
              });
            });
            if (!matchedGid || !totals[matchedGid]) continue;
            for (var cc = 1; cc < nCols; cc++) {
              var cur = values[r][cc];
              var fx = formulas[r][cc];
              if ((cur === '' || cur === null) && !fx) {
                sheet.getRange(r + 1, cc + 1).setValue(totals[matchedGid]);
                written++;
                delete totals[matchedGid]; // write each group once
                break;
              }
            }
          }
          SpreadsheetApp.flush();
        } catch (e) { /* best-effort: never block the copy */ }
        return written;
      }

      // ============================================================
      //  LIST MY DOCUMENTS — returns all files in the caller's
      //  personal "My Documents" folder.
      // ============================================================
      function listMyDocuments(body) {
        body = body || {};
        var auth = resolveAuthContext(body);
        if (!auth.userId) return { success: false, error: 'Необходима е автентикация' };

        // Admin / CKK can list a specific user's documents when targetUserId is provided.
        // Other roles are silently restricted to their own folder.
        var requestedTarget = body.targetUserId ? String(body.targetUserId).trim().toLowerCase() : '';
        var canCrossView = auth.isAdmin || isCKKMember_(auth.userId);
        var targetEmail = (requestedTarget && canCrossView) ? requestedTarget : auth.userId;
        if (!targetEmail) return { success: true, documents: [], message: 'Няма потребител' };

        try {
          var userFolder = getOrCreateMyDocsFolder_(targetEmail);
          if (!userFolder) return { success: true, documents: [], message: 'Все още нямате лични документи' };

          var documents = [];
          var seenIds = {};

          // ── 1. Scan user's own My Documents folder ──
          var files = userFolder.getFiles();
          while (files.hasNext()) {
            var f = files.next();
            var fid = f.getId();
            if (seenIds[fid]) continue;
            seenIds[fid] = true;
            var mime = f.getMimeType();
            var links = buildSecureFileLinks_(fid, { allowDownload: true, mimeType: mime });
            // Read description to extract source template info (set by copyDocForUser)
            var desc = '';
            try { desc = String(f.getDescription() || ''); } catch (_) {}
            var templateSourceId = '';
            var templateSourceName = '';
            var origin = 'uploaded';
            var formId = '';
            if (desc) {
              // Description format: "TEMPLATE_SOURCE=<id>|TEMPLATE_NAME=<name>|FORM_ID=<formId>|ORIGIN=<origin>"
              var parts = desc.split('|');
              parts.forEach(function(p) {
                var kv = p.split('=');
                if (kv.length === 2) {
                  var k = String(kv[0]).trim();
                  var v = String(kv[1]).trim();
                  if (k === 'TEMPLATE_SOURCE') templateSourceId = v;
                  else if (k === 'TEMPLATE_NAME') templateSourceName = v;
                  else if (k === 'FORM_ID') formId = v;
                  else if (k === 'ORIGIN') origin = v;
                }
              });
            }
            documents.push({
              id: fid,
              driveId: fid,
              name              : f.getName(),
              mimeType          : mime,
              typeLabel         : mimeTypeLabel(mime),
              previewLink       : links.previewLink,
              webViewLink       : links.previewLink,
              editLink          : mime === 'application/vnd.google-apps.document'
                                  ? 'https://docs.google.com/document/d/' + fid + '/edit'
                                  : (mime === 'application/vnd.google-apps.spreadsheet'
                                    ? 'https://docs.google.com/spreadsheets/d/' + fid + '/edit'
                                    : links.previewLink),
              downloadUrl       : links.downloadUrl,
              size              : formatFileSize_(f.getSize()),
              sizeBytes         : Number(f.getSize() || 0),
              folderName        : 'Моите документи',
              createdDate       : f.getDateCreated().toISOString(),
              modifiedDate      : f.getLastUpdated().toISOString(),
              origin            : origin,
              templateSourceId  : templateSourceId,
              templateSourceName: templateSourceName,
              formId            : formId,
              isGoogleDoc       : !!mime.match(/google\.(document|spreadsheet|presentation|drawing|form)/i)
            });
          }

          // ── 2. Also scan the session folder (Конкурсна сесия 2026 документи) ──
          try {
            var sessionIt = userFolder.getFoldersByName(SESSION_FOLDER_NAME);
            if (sessionIt.hasNext()) {
              var sessionFolder = sessionIt.next();
              var sessionFiles = sessionFolder.getFiles();
              while (sessionFiles.hasNext()) {
                var sf = sessionFiles.next();
                var sfid = sf.getId();
                if (seenIds[sfid]) continue;
                seenIds[sfid] = true;
                var smime = sf.getMimeType();
                var slinks = buildSecureFileLinks_(sfid, { allowDownload: true, mimeType: smime });
                var sdesc = '';
                try { sdesc = String(sf.getDescription() || ''); } catch (_) {}
                var sTemplateSourceId = '';
                var sTemplateSourceName = '';
                var sOrigin = 'uploaded';
                var sFormId = '';
                if (sdesc) {
                  var sparts = sdesc.split('|');
                  sparts.forEach(function(p) {
                    var kv = p.split('=');
                    if (kv.length === 2) {
                      var k = String(kv[0]).trim();
                      var v = String(kv[1]).trim();
                      if (k === 'TEMPLATE_SOURCE') sTemplateSourceId = v;
                      else if (k === 'TEMPLATE_NAME') sTemplateSourceName = v;
                      else if (k === 'FORM_ID') sFormId = v;
                      else if (k === 'ORIGIN') sOrigin = v;
                    }
                  });
                }
                documents.push({
                  id: sfid,
              driveId: sfid,
                  name              : sf.getName(),
                  mimeType          : smime,
                  typeLabel         : mimeTypeLabel(smime),
                  previewLink       : slinks.previewLink,
                  webViewLink       : slinks.previewLink,
                  editLink          : smime === 'application/vnd.google-apps.document'
                                      ? 'https://docs.google.com/document/d/' + sfid + '/edit'
                                      : (smime === 'application/vnd.google-apps.spreadsheet'
                                        ? 'https://docs.google.com/spreadsheets/d/' + sfid + '/edit'
                                        : slinks.previewLink),
                  downloadUrl       : slinks.downloadUrl,
                  size              : formatFileSize_(sf.getSize()),
                  sizeBytes         : Number(sf.getSize() || 0),
                  folderName        : SESSION_FOLDER_NAME,
                  createdDate       : sf.getDateCreated().toISOString(),
                  modifiedDate      : sf.getLastUpdated().toISOString(),
                  origin            : sOrigin,
                  templateSourceId  : sTemplateSourceId,
                  templateSourceName: sTemplateSourceName,
                  formId            : sFormId,
                  isGoogleDoc       : !!smime.match(/google\.(document|spreadsheet|presentation|drawing|form)/i)
                });
              }
            }
          } catch (_) { /* session folder scan is best-effort */ }

          // ── 3. Scan the root-level session folder (Конкурсна сесия 2026 документи)
          //     and its per-form subfolders. This is the v10.2.0-restructure location
          //     where generated/copied documents are stored.
          try {
            var rootSessionFolder = getOrCreateSessionRootFolder_();
            if (rootSessionFolder) {
              var formFolders = rootSessionFolder.getFolders();
              while (formFolders.hasNext()) {
                var ff = formFolders.next();
                var ffName = ff.getName();
                // Each subfolder is named by formId
                var ffFormId = ffName;

                try {
                  var ffFiles = ff.getFiles();
                  while (ffFiles.hasNext()) {
                    var fff = ffFiles.next();
                    var fffid = fff.getId();
                    if (seenIds[fffid]) continue;
                    seenIds[fffid] = true;
                    var ffmime = fff.getMimeType();
                    var fflinks = buildSecureFileLinks_(fffid, { allowDownload: true, mimeType: ffmime });
                    var ffdesc = '';
                    try { ffdesc = String(fff.getDescription() || ''); } catch (_) {}
                    var ffOrigin = 'generated';
                    var ffTemplateSourceId = '';
                    var ffTemplateSourceName = '';
                    var ffFormId = ffFormId;
                    var ffDocType = '';
                    var ffProjectCode = '';
                    if (ffdesc) {
                      var ffparts = ffdesc.split('|');
                      ffparts.forEach(function(p) {
                        var kv = p.split('=');
                        if (kv.length === 2) {
                          var k = String(kv[0]).trim();
                          var v = String(kv[1]).trim();
                          if (k === 'TEMPLATE_SOURCE') ffTemplateSourceId = v;
                          else if (k === 'TEMPLATE_NAME') ffTemplateSourceName = v;
                          else if (k === 'FORM_ID') ffFormId = v || ffFormId;
                          else if (k === 'ORIGIN') ffOrigin = v;
                          else if (k === 'DOC_TYPE') ffDocType = v;
                          else if (k === 'PROJECT_CODE') ffProjectCode = v;
                        }
                      });
                    }
                    documents.push({
                      id: fffid, driveId: fffid, name: fff.getName(), mimeType: ffmime,
                      typeLabel: mimeTypeLabel(ffmime), previewLink: fflinks.previewLink,
                      webViewLink: fflinks.previewLink,
                      editLink: ffmime === 'application/vnd.google-apps.document' ? 'https://docs.google.com/document/d/' + fffid + '/edit' : (ffmime === 'application/vnd.google-apps.spreadsheet' ? 'https://docs.google.com/spreadsheets/d/' + fffid + '/edit' : fflinks.previewLink),
                      downloadUrl: fflinks.downloadUrl, size: formatFileSize_(fff.getSize()),
                      sizeBytes: Number(fff.getSize() || 0), folderName: SESSION_FOLDER_NAME + '/' + ffFormId,
                      createdDate: fff.getDateCreated().toISOString(), modifiedDate: fff.getLastUpdated().toISOString(),
                      origin: ffOrigin, templateSourceId: ffTemplateSourceId,
                      templateSourceName: ffTemplateSourceName, formId: ffFormId,
                      docType: ffDocType, projectCode: ffProjectCode,
                      isGoogleDoc: !!ffmime.match(/google\.(document|spreadsheet|presentation|drawing|form)/i)
                    });
                  }
                } catch (_) { /* per-form folder scan best-effort */ }
              }
            }
          } catch (_) { /* root session folder enum best-effort */ }

          // ── 4. Scan the "Проектни предложения" folder and its per-proposal subfolders ──
          //     Each subfolder is named "{formId} - {title}" and contains generated docs.
          try {
            var ppIt = userFolder.getFoldersByName('Проектни предложения');
            if (ppIt.hasNext()) {
              var ppFolder = ppIt.next();
              var proposalFolders = ppFolder.getFolders();
              while (proposalFolders.hasNext()) {
                var pf = proposalFolders.next();
                var pfName = pf.getName();
                // Derive formId from folder name "{fid} - {title}"
                var pfFormId = '';
                var pfMatch = pfName.match(/^([a-zA-Z0-9_\-]+)/);
                if (pfMatch) pfFormId = pfMatch[1];
                var pfDisplayName = 'Проектни предложения/' + pfName;

                try {
                  var pfFiles = pf.getFiles();
                  while (pfFiles.hasNext()) {
                    var pff = pfFiles.next();
                    var pffid = pff.getId();
                    if (seenIds[pffid]) continue;
                    seenIds[pffid] = true;
                    var pfmime = pff.getMimeType();
                    var pflinks = buildSecureFileLinks_(pffid, { allowDownload: true, mimeType: pfmime });
                    var pfdesc = '';
                    try { pfdesc = String(pff.getDescription() || ''); } catch (_) {}
                    var pfOrigin = 'uploaded';
                    var pfTemplateSourceId = '';
                    var pfTemplateSourceName = '';
                    var pfFormId = pfFormId;
                    if (pfdesc) {
                      var pfparts = pfdesc.split('|');
                      pfparts.forEach(function(p) {
                        var kv = p.split('=');
                        if (kv.length === 2) {
                          var k = String(kv[0]).trim();
                          var v = String(kv[1]).trim();
                          if (k === 'TEMPLATE_SOURCE') pfTemplateSourceId = v;
                          else if (k === 'TEMPLATE_NAME') pfTemplateSourceName = v;
                          else if (k === 'FORM_ID') pfFormId = v || pfFormId;
                          else if (k === 'ORIGIN') pfOrigin = v;
                        }
                      });
                    }
                    documents.push({
                      id: pffid, driveId: pffid, name: pff.getName(), mimeType: pfmime,
                      typeLabel: mimeTypeLabel(pfmime), previewLink: pflinks.previewLink,
                      webViewLink: pflinks.previewLink,
                      editLink: pfmime === 'application/vnd.google-apps.document' ? 'https://docs.google.com/document/d/' + pffid + '/edit' : (pfmime === 'application/vnd.google-apps.spreadsheet' ? 'https://docs.google.com/spreadsheets/d/' + pffid + '/edit' : pflinks.previewLink),
                      downloadUrl: pflinks.downloadUrl, size: formatFileSize_(pff.getSize()),
                      sizeBytes: Number(pff.getSize() || 0), folderName: pfDisplayName,
                      createdDate: pff.getDateCreated().toISOString(), modifiedDate: pff.getLastUpdated().toISOString(),
                      origin: pfOrigin, templateSourceId: pfTemplateSourceId,
                      templateSourceName: pfTemplateSourceName, formId: pfFormId,
                      isGoogleDoc: !!pfmime.match(/google\.(document|spreadsheet|presentation|drawing|form)/i)
                    });
                  }
                } catch (_) { /* per-proposal-folder scan is best-effort */ }
              }
            }
          } catch (_) { /* proposal folder enumeration is best-effort */ }

          // ── 5. Scan ALL other subfolders (e.g. "Подаване {formId} - {date}")
          //       created when the applicant submits a form. Skip the session
          //       folder, proposal folder (already scanned above), and the
          //       temp-uploads folder.
          try {
            var subFolderIt = userFolder.getFolders();
            var SKIP_FOLDERS = [SESSION_FOLDER_NAME, '_tmp_uploads', 'Проектни предложения'];
            while (subFolderIt.hasNext()) {
              var sub = subFolderIt.next();
              var subName = sub.getName();
              if (SKIP_FOLDERS.indexOf(subName) >= 0) continue;
              // Derive formId from folder name "Подаване {fid} - {date}" if possible
              var subFormId = '';
              var subMatch = subName.match(/Подаване\s+([a-zA-Z0-9_\-]+)/);
              if (subMatch) subFormId = subMatch[1];

              try {
                var subFiles = sub.getFiles();
                while (subFiles.hasNext()) {
                  var xf = subFiles.next();
                  var xfid = xf.getId();
                  if (seenIds[xfid]) continue;
                  seenIds[xfid] = true;
                  var xmime = xf.getMimeType();
                  var xlinks = buildSecureFileLinks_(xfid, { allowDownload: true, mimeType: xmime });
                  var xdesc = '';
                  try { xdesc = String(xf.getDescription() || ''); } catch (_) {}
                  var xOrigin = 'attached';
                  var xTemplateSourceId = '';
                  var xTemplateSourceName = '';
                  var xFormId = subFormId;
                  if (xdesc) {
                    var xparts = xdesc.split('|');
                    xparts.forEach(function(p) {
                      var kv = p.split('=');
                      if (kv.length === 2) {
                        var k = String(kv[0]).trim();
                        var v = String(kv[1]).trim();
                        if (k === 'TEMPLATE_SOURCE') xTemplateSourceId = v;
                        else if (k === 'TEMPLATE_NAME') xTemplateSourceName = v;
                        else if (k === 'FORM_ID') xFormId = v || subFormId;
                        else if (k === 'ORIGIN') xOrigin = v;
                      }
                    });
                  }
                  documents.push({
                    id                : xfid,
                    name              : xf.getName(),
                    mimeType          : xmime,
                    typeLabel         : mimeTypeLabel(xmime),
                    previewLink       : xlinks.previewLink,
                    webViewLink       : xlinks.previewLink,
                    editLink          : xmime === 'application/vnd.google-apps.document'
                                        ? 'https://docs.google.com/document/d/' + xfid + '/edit'
                                        : (xmime === 'application/vnd.google-apps.spreadsheet'
                                          ? 'https://docs.google.com/spreadsheets/d/' + xfid + '/edit'
                                          : xlinks.previewLink),
                    downloadUrl       : xlinks.downloadUrl,
                    size              : formatFileSize_(xf.getSize()),
                    sizeBytes         : Number(xf.getSize() || 0),
                    folderName        : subName,
                    createdDate       : xf.getDateCreated().toISOString(),
                    modifiedDate      : xf.getLastUpdated().toISOString(),
                    origin            : xOrigin,
                    templateSourceId  : xTemplateSourceId,
                    templateSourceName: xTemplateSourceName,
                    formId            : xFormId,
                    isGoogleDoc       : !!xmime.match(/google\.(document|spreadsheet|presentation|drawing|form)/i)
                  });
                }
              } catch (_) { /* per-subfolder scan is best-effort */ }
            }
          } catch (_) { /* subfolder enumeration is best-effort */ }

          // Sort by modified date descending
          documents.sort(function(a, b) {
            return (b.modifiedDate || '').localeCompare(a.modifiedDate || '');
          });
          return { success: true, documents: documents, sessionFolderName: SESSION_FOLDER_NAME };
        } catch (err) {
          return { success: false, error: 'listMyDocuments failed: ' + err.message, documents: [] };
        }
      }

      // ============================================================
      //  TEMPLATE FILE RESOLVER (v8.6.0)
      //  Walks OFFICIAL_DOCS_FOLDER_ID + every subfolder and returns the
      //  first File whose name matches `targetName` under one of three
      //  progressively-looser rules:
      //    1. Exact match (case-sensitive).
      //    2. Case-insensitive match after trimming whitespace + NBSP.
      //    3. Slug match — alphanumerics + Cyrillic letters only, lowercase.
      //       Catches accidental rename drift (extra spaces, punctuation,
      //       missing dash, ".docx" vs ".DOCX", etc.).
      //  Results are memoised per-execution to keep repeated calls O(1).
      // ============================================================
      // ── Template resolution cache (per-execution) ──
      // v12.15.2-fix: Safety-checked — if the variable is somehow not set
      // (e.g. due to a redeploy race), the cache-initialisation guard
      // `if(!_tplResolverCache_)` in _findTemplateFileInLibrary_ silently
      // rebuilds it instead of throwing "is not defined".
      var _tplResolverCache_ = null;
      function _tplNormalise_(s) {
        return String(s || '')
          .replace(/\u00A0/g, ' ')
          .replace(/\s+/g, ' ')
          .trim()
          .toLowerCase();
      }
      function _tplSlug_(s) {
        return _tplNormalise_(s).replace(/[^a-z0-9а-я]+/gi, '');
      }
      // Strip leading numeric/dash/space prefix admins sometimes drop when
      // re-uploading ("01-01 Капацитет…" ↔ "Капацитет…"). Also strips a
      // trailing ".docx"/".doc" so Google-Docs-converted files still match.
      function _tplCoreSlug_(s) {
        var n = _tplNormalise_(s)
          .replace(/^[\s\-_\.\d]+/, '')              // leading numbers/dashes
          .replace(/\.(docx?|pdf|odt|gdoc)$/i, '');  // trailing extension
        return n.replace(/[^a-z0-9а-я]+/gi, '');
      }

      // ── Template cache key helper — maps (docType, projectType) → cache key ──
      function _tplCacheKeys_(docType, projectType) {
        return 'TPL::' + (projectType || 'any') + '::' + (docType || 'unknown');
      }
      function _buildTemplateCache_() {
        var byExact = {}, byCi = {}, bySlug = {}, byCore = {}, allFiles = [];
        var queue = [];
        var seen = {};
        // v9.42.3: Add folders INDEPENDENTLY so a failure on one folder never
        // prevents the others from being indexed. Previously all additions were
        // inside one try{} block — if OFFICIAL_DOCS_FOLDER_ID threw (e.g. wrong
        // ID or access denied), the type-specific folders were also skipped.
        // Main library folder
        try { queue.push(DriveApp.getFolderById(OFFICIAL_DOCS_FOLDER_ID)); }
        catch (e) { console.warn('_buildTemplateCache_: main library folder not accessible (' + OFFICIAL_DOCS_FOLDER_ID + '): ' + e.message); }
        // Type-specific template folders (each added independently)
        try {
          var typeIds = _getTemplateFolderIds_();
          var _typeKeys = Object.keys(typeIds);
          for (var _tk = 0; _tk < _typeKeys.length; _tk++) {
            var _tid = typeIds[_typeKeys[_tk]];
            if (_tid && _tid.length > 10) { try { queue.push(DriveApp.getFolderById(_tid)); } catch (_) {} }
          }
        } catch (_) {}
        var depth = 0;
        while (queue.length && depth++ < 5000) {
          var f = queue.shift();
          var fid;
          try { fid = f.getId(); } catch (_) { continue; }
          if (seen[fid]) continue;
          seen[fid] = true;
          // Files in this folder
          try {
            var fi = f.getFiles();
            while (fi.hasNext()) {
              var file = fi.next();
              var nm;
              try { nm = file.getName(); } catch (_) { continue; }
              if (!byExact[nm]) byExact[nm] = file;
              var ci = _tplNormalise_(nm);
              if (!byCi[ci]) byCi[ci] = file;
              var sl = _tplSlug_(nm);
              if (sl && !bySlug[sl]) bySlug[sl] = file;
              var co = _tplCoreSlug_(nm);
              if (co && !byCore[co]) byCore[co] = file;
              if (co) allFiles.push({ file: file, core: co });
            }
          } catch (_) {}
          // Recurse into subfolders
          try {
            var sub = f.getFolders();
            while (sub.hasNext()) queue.push(sub.next());
          } catch (_) {}
        }
        return { byExact: byExact, byCi: byCi, bySlug: bySlug, byCore: byCore, all: allFiles };
      }

      // ═══════════════════════════════════════════════════════════════════════
      //  exportTemplateFilesToHostinger — export all template metadata to MySQL
      //  v10.5.0-templatefix: Scans library, resolves Drive file IDs, and
      //  returns structured data for sync_worker.php → document_templates.
      // ═══════════════════════════════════════════════════════════════════════
      function exportTemplateFilesToHostinger(body) {
        body = body || {};
        var results = [];
        var errors = [];
        var startTime = Date.now();
        var cache;
        try { cache = _buildTemplateCache_(); } catch (e) {
          return { success: false, error: 'Failed to build template cache: ' + e.message };
        }
        var typeKeys = Object.keys(REQUIRED_APPLICATION_TEMPLATES);
        var labels = {
          'fnipdf':{l:'Пълно проектно предложение (PDF)',d:'Генериран PDF с цялата информация, бюджет и подпис',e:'.pdf'},
          'fniteamextra':{l:'Допълнителна информация — екип (DOCX)',d:'Капацитет и опит на екипа',e:'.docx'},
          'fniextra':{l:'Допълнителна информация — програма (DOCX)',d:'Работна програма и очаквани резултати',e:'.docx'},
          'fnibudget':{l:'Бюджетна таблица (XLSX)',d:'Автоматично попълнена бюджетна таблица',e:'.xlsx'},
          'pnipdf':{l:'Пълно проектно предложение (PDF)',d:'Генериран PDF с цялата информация, бюджет и подпис',e:'.pdf'},
          'pniteamextra':{l:'Допълнителна информация — екип (DOCX)',d:'Капацитет и опит на екипа',e:'.docx'},
          'pniextra':{l:'Допълнителна информация — програма (DOCX)',d:'Работна програма и очаквани резултати',e:'.docx'},
          'pnibudget':{l:'Бюджетна таблица (XLSX)',d:'Автоматично попълнена бюджетна таблица',e:'.xlsx'},
          'dnppdf':{l:'Пълно проектно предложение (PDF)',d:'Генериран PDF с цялата информация, бюджет и подпис',e:'.pdf'},
          'dnpextra':{l:'Допълнителна информация (DOCX)',d:'Научни постижения, работна програма',e:'.docx'},
          'dnpcv':{l:'Автобиография (DOCX)',d:'Образец на автобиография на докторанта',e:'.docx'},
          'dnpbudget':{l:'Бюджетна таблица (XLSX)',d:'Автоматично попълнена бюджетна таблица',e:'.xlsx'},
          'npfpdf':{l:'Пълно проектно предложение (PDF)',d:'Генериран PDF с цялата информация и подпис',e:'.pdf'},
          'npfextra':{l:'Допълнителна информация (DOCX)',d:'Формуляр за кандидатстване за научен форум',e:'.docx'},
          'npfbudget':{l:'Бюджетна таблица (XLSX)',d:'Автоматично попълнена бюджетна таблица',e:'.xlsx'}
        };
        for (var ti = 0; ti < typeKeys.length; ti++) {
          var pType = typeKeys[ti];
          var typeMap = REQUIRED_APPLICATION_TEMPLATES[pType];
          var docKeys = Object.keys(typeMap);
          for (var di = 0; di < docKeys.length; di++) {
            var dType = docKeys[di];
            var spec = typeMap[dType];
            var record = {
              project_type: pType, doc_type: dType, template_name: spec.name,
              mime_type: spec.mime || '', is_budget: spec.isBudget ? 1 : 0,
              output_pdf: spec.outputPdf ? 1 : 0,
              embed_signature: spec.embedSignature ? 1 : 0,
              is_required: 1, sort_order: di * 10, drive_file_id: ''
            };
            if (labels[dType]) { record.label = labels[dType].l; record.description = labels[dType].d || ''; record.accept_ext = labels[dType].e || ''; }
            if (spec.name && cache) {
              try { var h = _findTemplateFileInLibrary_(spec.name, pType); if (h) { try { record.drive_file_id = h.getId(); } catch (_) {} } } catch (e) { errors.push({docType:dType, error:e.message}); }
            }
            results.push(record);
          }
        }
        return { success: true, templates: results, totalCount: results.length, resolvedCount: results.filter(function(r){return !!r.drive_file_id;}).length, errors: errors.length ? errors : undefined, elapsedMs: Date.now() - startTime };
      }

      function _findTemplateFileInLibrary_(targetName, projectCode) {
        if (!targetName) return null;
        // Try type-specific folder first when projectCode is known
        if (projectCode) {
          try {
            var typeIds = _getTemplateFolderIds_();
            var folderId = typeIds[projectCode];
            if (folderId && folderId.length > 10) {
