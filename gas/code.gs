              userId: _SYSTEM_RECADMIN_USER,
              picture: null
            },
            isAdmin: true,
            role: ROLE_RECTOR
          };
        }

        return { success: false, error: 'Грешно потребителско име или парола.' };
      }

      function checkAdmin(body) {
        var email = String(body.email || body.userId || '').toLowerCase().trim();
        if (!email) return { success: true, isAdmin: false, role: ROLE_APPLICANT };
        // ── Domain allowlist for Google Sign-In ──
        // Only institutional accounts (@ue-varna.bg, incl. subdomains like
        // @stud.ue-varna.bg) may authenticate via Google. The username/password
        // adminLogin path is unaffected because it doesn't use email at all.
        if (!isAllowedSignInEmail_(email)) {
          return {
            success: false,
            error: 'Достъпът е разрешен само за институционални акаунти на ИУ – Варна (@ue-varna.bg). | Access is restricted to institutional University of Economics – Varna accounts (@ue-varna.bg).',
            code: 'DOMAIN_NOT_ALLOWED'
          };
        }
        loadAdminCredentials_();
        var admin = isAdminUser(email);
        var role = resolveUserRole_(email, admin);
        // ── Log Google Sign-In event (deduped: skip if logged in last 5 min) ──
        try {
          var _nowTs = Date.now();
          var _lastLoginKey = '__last_login_' + email;
          var _lastLogin = _scriptCache_().get(_lastLoginKey);
          if (!_lastLogin || (_nowTs - Number(_lastLogin)) > 300000) {
            _scriptCache_().put(_lastLoginKey, String(_nowTs), 600);
            logTransaction('LOGIN', 'user', email, {
              method: 'google_signin',
              role: role,
              isAdmin: admin,
              ip: String((body && body._clientIP) || ''),
              ua: String((body && body._clientUA) || '').slice(0, 120)
            });
          }
        } catch (_) {}
        return { success: true, isAdmin: admin, role: role };
      }

      // Whitelist for Google Sign-In. Accepts the primary domain and any
      // subdomain (e.g. stud.ue-varna.bg, alumni.ue-varna.bg). To extend the
      // policy, append more suffixes to ALLOWED_SIGNIN_DOMAINS.
      var ALLOWED_SIGNIN_DOMAINS = ['ue-varna.bg'];
      function isAllowedSignInEmail_(email) {
        var at = String(email || '').lastIndexOf('@');
        if (at < 0) return false;
        var domain = email.slice(at + 1).toLowerCase();
        for (var i = 0; i < ALLOWED_SIGNIN_DOMAINS.length; i++) {
          var allowed = ALLOWED_SIGNIN_DOMAINS[i];
          if (domain === allowed || domain.endsWith('.' + allowed)) return true;
        }
        return false;
      }

      // ============================================================
      //  SHEET HELPERS
      // ============================================================
      var _sheetCache = {};
