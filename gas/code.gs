      // ============================================================
      //  FULL CSV EXPORT — ALL SHEETS → CSV (Supabase-compatible)
      // ============================================================
      /**
       * exportAllDataCSV(body)
       *
       * Admin-only endpoint. Exports EVERY sheet in the spreadsheet as a
       * structured CSV payload where each sheet becomes a CSV table with
       * headers. Returns a JSON envelope with per-sheet CSV text ready for
       * download or direct import into Supabase / PostgreSQL.
       *
       * Sheets exported (and their Supabase table mapping):
       *   Applications → applications
       *   Competitions → competitions
       *   Reviewers    → reviewers
       *   Projects     → projects
       *   Reports      → reports
       *   ChangeRequests → change_requests
       *   Sanctions    → sanctions
       *   UserPreferences → user_preferences
       *   SelfAssessments → self_assessments (if exists)
       *
       * Output envelope:
       *   { success: true,
       *     csv: { applications: "header1,header2\nval1,val2\n...",
       *            competitions: "...",
       *            ... },
       *     summary: { applications: 45, competitions: 3, ... },
       *     exportedAt: "2026-05-17T..." }
       *
       * CSV dialect: RFC 4180 — commas, double-quote escaping, CRLF line ends.
       * All values are stringified; JSON columns (budget, team, history) are
       * serialised as compact JSON so they remain valid CSV cells.
       */

      // ── CSV cell escaper (RFC 4180) ──────────────────────────────
      function _csvEscape_(val) {
        var s = (val === null || val === undefined) ? '' : String(val);
        // If the value contains a comma, double-quote, or newline, wrap in quotes
        if (s.indexOf(',') >= 0 || s.indexOf('"') >= 0 || s.indexOf('\n') >= 0 || s.indexOf('\r') >= 0) {
          return '"' + s.replace(/"/g, '""') + '"';
        }
        return s;
      }

      // ── Convert a 2D array (with header row) to CSV string ───────
      function _sheetDataToCSV_(headers, dataRows) {
        var lines = [];
        // Header row
        lines.push(headers.map(_csvEscape_).join(','));
        // Data rows
        for (var i = 0; i < dataRows.length; i++) {
          var row = dataRows[i];
          var cells = [];
          for (var j = 0; j < headers.length; j++) {
            var raw = (j < row.length) ? row[j] : '';
            // Stringify objects/arrays so they survive CSV round-trip
            if (typeof raw === 'object' && raw !== null) {
              try { raw = JSON.stringify(raw); } catch (_) { raw = ''; }
            }
            cells.push(_csvEscape_(raw));
          }
          lines.push(cells.join(','));
        }
        return lines.join('\r\n');
      }

      function exportAllDataCSV(body) {
        try {
          body = body || {};
          var authCtx = resolveAuthContext(body);
          if (!authCtx.isAdmin) {
            return { success: false, error: 'Администраторски достъп е необходим за CSV експорт.' };
          }

          var csvPayload = {};
          var summary = {};
          var ss = _getCachedSpreadsheet();

          // ── Helper: read sheet by name, return {headers, dataRows} ──
          function _readSheet_(sheetName) {
            var sheet = ss.getSheetByName(sheetName);
            if (!sheet) return { headers: [], dataRows: [] };
            var raw = sheet.getDataRange().getValues();
            if (raw.length === 0) return { headers: [], dataRows: [] };
            var headers = raw[0].map(function(h) { return String(h || '').trim(); });
            var dataRows = raw.slice(1).filter(function(r) {
              // Skip completely empty rows
              return r.some(function(c) { return String(c || '').trim() !== ''; });
            });
            return { headers: headers, dataRows: dataRows };
          }

          // ── 1. Applications ─────────────────────────────────────
          var appSh = _readSheet_(SHEET_NAME);
          csvPayload.applications = _sheetDataToCSV_(appSh.headers, appSh.dataRows);
          summary.applications = appSh.dataRows.length;

          // ── 2. Competitions ─────────────────────────────────────
          var compSh = _readSheet_(COMPETITIONS_SHEET_NAME);
          csvPayload.competitions = _sheetDataToCSV_(compSh.headers, compSh.dataRows);
          summary.competitions = compSh.dataRows.length;

          // ── 3. Reviewers ────────────────────────────────────────
          var revSh = _readSheet_(REVIEWERS_SHEET_NAME);
          csvPayload.reviewers = _sheetDataToCSV_(revSh.headers, revSh.dataRows);
          summary.reviewers = revSh.dataRows.length;

          // ── 4. Projects ─────────────────────────────────────────
          var projSh = _readSheet_(PROJECTS_SHEET_NAME);
          csvPayload.projects = _sheetDataToCSV_(projSh.headers, projSh.dataRows);
          summary.projects = projSh.dataRows.length;

          // ── 5. Reports ──────────────────────────────────────────
          var rptSh = _readSheet_(REPORTS_SHEET_NAME);
          csvPayload.reports = _sheetDataToCSV_(rptSh.headers, rptSh.dataRows);
          summary.reports = rptSh.dataRows.length;

          // ── 6. ChangeRequests ───────────────────────────────────
          var crSh = _readSheet_(CHANGE_REQ_SHEET_NAME);
          csvPayload.change_requests = _sheetDataToCSV_(crSh.headers, crSh.dataRows);
          summary.change_requests = crSh.dataRows.length;

          // ── 7. Sanctions ────────────────────────────────────────
          var sanSh = _readSheet_(SANCTIONS_SHEET_NAME);
          csvPayload.sanctions = _sheetDataToCSV_(sanSh.headers, sanSh.dataRows);
          summary.sanctions = sanSh.dataRows.length;

          // ── 8. UserPreferences ──────────────────────────────────
          var upSh = _readSheet_('UserPreferences');
          if (upSh.headers.length > 0) {
            csvPayload.user_preferences = _sheetDataToCSV_(upSh.headers, upSh.dataRows);
            summary.user_preferences = upSh.dataRows.length;
          }

          // ── 9. SelfAssessments (if exists) ──────────────────────
          var saSh = _readSheet_('SelfAssessments');
          if (saSh.headers.length > 0 && saSh.dataRows.length > 0) {
            csvPayload.self_assessments = _sheetDataToCSV_(saSh.headers, saSh.dataRows);
            summary.self_assessments = saSh.dataRows.length;
          }

          // ── 10. Collaborators (if exists) ───────────────────────
          var collSh = _readSheet_('Collaborators');
          if (collSh.headers.length > 0 && collSh.dataRows.length > 0) {
            csvPayload.collaborators = _sheetDataToCSV_(collSh.headers, collSh.dataRows);
            summary.collaborators = collSh.dataRows.length;
          }

          // ── 11. Активни Конкурси (derived sheet) ─────────────────
          var acSh = _readSheet_(ACTIVE_CONTESTS_SHEET);
          if (acSh.headers.length > 0 && acSh.dataRows.length > 0) {
            csvPayload.active_contests = _sheetDataToCSV_(acSh.headers, acSh.dataRows);
            summary.active_contests = acSh.dataRows.length;
          }

          // ── 12. Участия (derived sheet) ─────────────────────────
          var partSh = _readSheet_(PARTICIPATION_SHEET);
          if (partSh.headers.length > 0 && partSh.dataRows.length > 0) {
            csvPayload.participation = _sheetDataToCSV_(partSh.headers, partSh.dataRows);
            summary.participation = partSh.dataRows.length;
          }

          var totalRows = Object.values(summary).reduce(function(a, b) { return a + b; }, 0);

          try {
            logTransaction('EXPORT_CSV', authCtx.userId || 'admin', 'system',
              { sheets: Object.keys(csvPayload).length, totalRows: totalRows });
          } catch (_) {}

          return {
            success: true,
            csv: csvPayload,
            summary: summary,
            totalRows: totalRows,
            exportedAt: nowISO(),
            exportedBy: authCtx.userId || 'admin'
          };
        } catch (err) {
          try { logError('exportAllDataCSV', err, body); } catch (_) {}
          return { success: false, error: 'exportAllDataCSV failed: ' + err.message };
        }
      }

      // ============================================================
      //  COMPLIANCE RULES ENGINE - Bulgarian Academic Requirements
      // ============================================================

      /**
       * Rule (7): One leader can lead only 1 project per FNI/PНИ per competition session
       */
      function checkComplianceRule7(competitionId, leaderId, excludeFormId) {
        try {
          var sheet = getSheet();
          var data = sheet.getDataRange().getValues();
          var violations = [];

          for (var i = 1; i < data.length; i++) {
            var row = data[i];
            var formId = String(row[COL.ID - 1] || '').trim();
            if (excludeFormId && formId === excludeFormId) continue;

            var rowCompId = String(row[COL.COMPETITION - 1] || '').trim();
            if (rowCompId !== competitionId) continue;

            var email = String(row[COL.USER_EMAIL - 1] || '').trim();
            if (email.toLowerCase() !== leaderId.toLowerCase()) continue;

            var projCode = String(row[COL.PROJECT_CODE - 1] || '').trim();
            var status = String(row[COL.STATUS - 1] || '').trim();
            var activeStatuses = ['submitted','completed','resubmitted','admin_review','admin_passed','eligible','reviewers_proposed','reviewer_assignment','reviewer_invited','reviewer_accepted','in_review','review_submitted','reviewed','scored','ranked','proposed_for_funding','approved','approved_for_funding','contract_draft','contract_package_ready','contracting','contracted','contract_signed','active','in_execution','progress_updated','expense_requested','change_requested','change_under_review','change_approved','reporting_due','report_submitted','report_under_review','report_accepted','report_returned_for_correction','final_report_prepared','final_review_submitted','final_evaluation'];

            if ((projCode === 'ФНИ' || projCode === 'ПНИ') && activeStatuses.indexOf(status) !== -1) {
              violations.push({
                rule: 7,
                message: 'Ръководител ' + leaderId + ' вече ръководи ' + projCode + ' проект',
                projectId: formId,
                projectArea: projCode,
                status: status
              });
            }
          }

          return { compliant: violations.length === 0, violations: violations };
        } catch (err) {
          return { compliant: true, violations: [], error: err.message };
        }
      }

      /**
       * Rule (8): Team members can't participate in more than 2 FНИ/ПНИ projects in same period
       */
      function checkComplianceRule8(competitionId, teamMembers) {
        try {
          if (!Array.isArray(teamMembers) || teamMembers.length === 0) {
            return { compliant: true, violations: [] };
          }

          var sheet = getSheet();
          var data = sheet.getDataRange().getValues();
          var violations = [];

          for (var t = 0; t < teamMembers.length; t++) {
            var memberEmail = String(teamMembers[t] || '').trim().toLowerCase();
            if (!memberEmail) continue;

            var memberProjects = [];

            var activeStatuses8 = ['submitted','completed','resubmitted','admin_review','admin_passed','eligible','reviewers_proposed','reviewer_assignment','reviewer_invited','reviewer_accepted','in_review','review_submitted','reviewed','scored','ranked','proposed_for_funding','approved','approved_for_funding','contract_draft','contract_package_ready','contracting','contracted','contract_signed','active','in_execution','progress_updated','expense_requested','change_requested','change_under_review','change_approved','reporting_due','report_submitted','report_under_review','report_accepted','report_returned_for_correction','final_report_prepared','final_review_submitted','final_evaluation'];
            for (var i = 1; i < data.length; i++) {
              var row = data[i];
              var projCode8 = String(row[COL.PROJECT_CODE - 1] || '').trim();
              var status = String(row[COL.STATUS - 1] || '').trim();

              if ((projCode8 !== 'ФНИ' && projCode8 !== 'ПНИ') || activeStatuses8.indexOf(status) === -1) {
                continue;
              }

              var teamArr8 = [];
              try { teamArr8 = JSON.parse(String(row[COL.TEAM_MEMBERS - 1] || '[]')); } catch (_) {}
              var hasMatch = teamArr8.some(function(m) { return String(m.email || '').toLowerCase().trim() === memberEmail; });
              if (hasMatch) {
                memberProjects.push(String(row[COL.ID - 1]));
              }
            }

            if (memberProjects.length > 2) {
              violations.push({
                rule: 8,
                message: 'Екип член ' + memberEmail + ' участва в ' + memberProjects.length + ' проекта (макс 2)',
                memberEmail: memberEmail,
                projectCount: memberProjects.length,
                projects: memberProjects
              });
            }
          }

          return { compliant: violations.length === 0, violations: violations };
        } catch (err) {
          return { compliant: true, violations: [], error: err.message };
        }
      }

      /**
       * Comprehensive Compliance Check
       */
      function performFullComplianceCheck(body) {
        try {
          var formId = body.formId;
          var competitionId = body.competitionId;
          var leaderId = body.userEmail;
          var teamMembers = Array.isArray(body.teamMembers) ? body.teamMembers : [];

          var allViolations = [];

          var rule7 = checkComplianceRule7(competitionId, leaderId, formId);
          allViolations = allViolations.concat(rule7.violations);

          var rule8 = checkComplianceRule8(competitionId, teamMembers);
          allViolations = allViolations.concat(rule8.violations);

          var result = {
            success: true,
            formId: formId,
            compliant: allViolations.length === 0,
            violations: allViolations,
            rulesChecked: ['7', '8'],
            timestamp: nowISO(),
            correctionDeadline: allViolations.length > 0 ? (function() {
              var cd = new Date(); var bd = 0;
              while (bd < 5) { cd.setDate(cd.getDate() + 1); var dow = cd.getDay(); if (dow !== 0 && dow !== 6) bd++; }
              return Utilities.formatDate(cd, 'Europe/Sofia', "yyyy-MM-dd'T'HH:mm:ss.SSSXXX");
            })() : null
          };

          logTransaction('COMPLIANCE_CHECK', 'Application', formId, result);
          return result;
        } catch (err) {
          return { success: false, error: err.message };
        }
      }

      /**
       * Compliance Audit Report
       */
      function getComplianceAudit(body) {
        try {
          var isAdmin = resolveAuthContext(body).isAdmin;
          if (!isAdmin) return { success: false, error: 'Admin only' };

          var competitionId = body.competitionId;
          var sheet = getSheet();
          var data = sheet.getDataRange().getValues();

          var auditReport = {
            competitionId: competitionId,
            reportDate: nowISO(),
            statistics: {
              totalSubmissions: 0,
              compliant: 0,
              withViolations: 0,
              violationDetails: []
            }
          };

          for (var i = 1; i < data.length; i++) {
            var row = data[i];
            var rowCompId = String(row[COL.COMPETITION - 1] || '').trim();
            if (rowCompId !== competitionId) continue;

            var status = String(row[COL.STATUS - 1] || '').trim();
            if (status !== 'submitted' && status !== 'approved') continue;

            auditReport.statistics.totalSubmissions++;

            var formId = String(row[COL.ID - 1]);
            var result = performFullComplianceCheck({
              formId: formId,
              competitionId: competitionId,
              userEmail: String(row[COL.USER_EMAIL - 1]),
              teamMembers: safeParseJSON(row[COL.TEAM_MEMBERS - 1], [])
            });

            if (result.compliant) {
              auditReport.statistics.compliant++;
            } else {
              auditReport.statistics.withViolations++;
              auditReport.statistics.violationDetails.push({
                formId: formId,
                title: String(row[COL.TITLE - 1]),
                violations: result.violations
              });
            }
          }

          return { success: true, audit: auditReport };
        } catch (err) {
          return { success: false, error: err.message };
        }
      }

      /**
       * Get Calendar Events - Deadlines and important dates
       */
      function getCalendarEvents(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          var isAdmin = auth.isAdmin;
          var forceRefresh = body.forceRefresh === true || body.forceRefresh === 'true';

          // Data-version keyed cache — survives across polls until Competitions
          // or Applications actually changes. 10 min TTL.
          var cacheKey = '';
          var sc = _scriptCache_();
          try {
            var dv = getDataVersions_();
            cacheKey = 'cal:v2:' + (isAdmin ? 'a' : 'p') + ':' + dv.competitions + ':' + dv.applications;
            if (!forceRefresh) {
              var cached = sc.get(cacheKey);
              if (cached) {
                var cachedEvents = JSON.parse(cached);
                if (cachedEvents && cachedEvents.success) {
                  cachedEvents.cached = true;
                  return cachedEvents;
                }
              }
            }
          } catch (_) {}

          var events = [];

          // Get visible competitions for the current user role. Don't propagate
          // forceRefresh into the competitions cache — we already gate by data
          // version above, and a cold hit there is expensive.
          var competitionsResponse = isAdmin
            ? getCompetitions({ isAdmin: true })
            : getPublicCompetitions({});
          if (!competitionsResponse || competitionsResponse.success !== true) {
            return { success: false, error: 'Неуспешно зареждане на конкурси за календар.' };
          }

          var competitions = Array.isArray(competitionsResponse.competitions) ? competitionsResponse.competitions : [];
          var visibleCompetitionIds = {};

          competitions.forEach(function(comp) {
            var compId = String(comp.id || '').trim();
            if (!compId) return;
            visibleCompetitionIds[compId] = true;

            if (comp.deadline) {
              events.push({
                id: 'comp_deadline_' + compId,
                competitionId: compId,
                title: 'Краен срок: ' + comp.name,
                description: comp.description || '',
                date: comp.deadline,
                type: 'deadline',
                status: comp.status || 'active',
                color: '#7B1B1B'
              });
            }
            if (comp.created) {
              events.push({
                id: 'comp_created_' + compId,
                competitionId: compId,
                title: 'Обявен конкурс: ' + comp.name,
                description: comp.description || '',
                date: comp.created,
                type: 'created',
                status: comp.status || 'active',
                color: '#1A5C38'
              });
            }
          });

          // Submission events are admin-only, because they contain internal applicant activity.
          if (!isAdmin) {
            var publicResult = { success: true, events: events };
            if (cacheKey) {
              try {
                var publicJson = JSON.stringify(publicResult);
                if (publicJson.length < 95000) sc.put(cacheKey, publicJson, 1800);
              } catch (_) {}
            }
            return publicResult;
          }

          // Admin: read only the columns we actually need from Applications.
          var sheet = getSheet();
          var appLastRow = sheet.getLastRow();
          if (appLastRow > 1) {
            var minCol = Math.min(COL.COMPETITION, COL.SUBMITTED, COL.ID, COL.TITLE);
            var maxCol = Math.max(COL.COMPETITION, COL.SUBMITTED, COL.ID, COL.TITLE);
            var data = sheet.getRange(2, minCol, appLastRow - 1, maxCol - minCol + 1).getValues();
            var iComp  = COL.COMPETITION - minCol;
            var iSub   = COL.SUBMITTED   - minCol;
            var iId    = COL.ID          - minCol;
            var iTitle = COL.TITLE       - minCol;
            for (var i = 0; i < data.length; i++) {
              var row = data[i];
              var rowComp = String(row[iComp] || '').trim();
              if (rowComp && !visibleCompetitionIds[rowComp]) continue;
              var submitted = String(row[iSub] || '').trim();
              if (!submitted) continue;
              var title = String(row[iTitle] || 'Заявление').slice(0, 30);
              events.push({
                id: 'app_' + String(row[iId]),
                competitionId: rowComp,
                title: 'Подадено: ' + title,
                date: submitted,
                type: 'submission',
                color: '#C8A84B'
              });
            }
          }

          var result = { success: true, events: events };
          if (cacheKey) {
            try {
              var json = JSON.stringify(result);
              if (json.length < 95000) sc.put(cacheKey, json, 3600);
            } catch (_) {}
          }
          return result;
        } catch (err) {
          return { success: false, error: 'getCalendarEvents failed: ' + err.message };
        }
      }

      // ============================================================
      //  ACTIVE PROJECT MANAGEMENT
      // ============================================================

      function createProject(body) {
        try {
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin && auth.role !== ROLE_CKK && auth.role !== ROLE_NIDD) return { success: false, error: 'Нямате право да създавате проекти.' };
          var appId     = String(body.applicationId || '').trim();
          if (!appId) return { success: false, error: 'Липсва applicationId.' };
          var sheet     = getSheet();
          var data      = sheet.getDataRange().getValues();
          var row       = null;
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][COL.ID - 1]).trim() === appId) { row = data[i]; break; }
          }
          if (!row) return { success: false, error: 'Заявлението не е намерено.' };
          var curStatus = String(row[COL.STATUS - 1]).trim();
          // Active project is materialized only after a fully executed contract.
          // 'approved_for_funding' is no longer a shortcut — funding approval must be
          // followed by signing before the proposal becomes an active project.
          if (curStatus !== 'contracted' && curStatus !== 'contract_signed') {
            return { success: false, error: 'Заявлението трябва да е с подписан договор (статус „contracted" или „contract_signed"). Текущ: ' + curStatus };
          }
          var projSheet = getProjectsSheet();
          var id = 'PROJ-' + Utilities.getUuid().replace(/-/g, '').substring(0, 12).toUpperCase();
          var now = new Date().toISOString();
          var teamMembers = row[COL.TEAM_MEMBERS - 1] || '[]';
          var budget = row[COL.BUDGET - 1] || '{}';
          var contractId = String(row[COL.CONTRACT_ID - 1] || '').trim();
          var compId = String(row[COL.COMPETITION - 1] || '').trim();
          var startDate = body.startDate || now.substring(0, 10);
          var endDate = body.endDate || '';
          var projRow = new Array(PROJ_TOTAL_COLS).fill('');
          projRow[PROJ_COL.ID - 1] = id;
          projRow[PROJ_COL.APPLICATION_ID - 1] = appId;
          projRow[PROJ_COL.COMPETITION_ID - 1] = compId;
          projRow[PROJ_COL.LEADER_EMAIL - 1] = String(row[COL.USER_EMAIL - 1] || '');
          projRow[PROJ_COL.LEADER_NAME - 1] = String(row[COL.USER_NAME - 1] || '');
          projRow[PROJ_COL.TEAM_MEMBERS - 1] = JSON.stringify(typeof teamMembers === 'string' ? JSON.parse(teamMembers || '[]') : teamMembers);
          projRow[PROJ_COL.TITLE - 1] = String(row[COL.TITLE - 1] || '');
          projRow[PROJ_COL.PROJECT_CODE - 1] = String(row[COL.PROJECT_CODE - 1] || '');
          projRow[PROJ_COL.DIRECTION - 1] = String(row[COL.AREA - 1] || ''); // multi-area ;;‑delimited
          projRow[PROJ_COL.STATUS - 1] = 'active';
          projRow[PROJ_COL.START_DATE - 1] = startDate;
          projRow[PROJ_COL.END_DATE - 1] = endDate;
          projRow[PROJ_COL.BUDGET - 1] = typeof budget === 'string' ? budget : JSON.stringify(budget);
          // ── Financial markers: seed BudgetExecution from the planned budget so that
          //    interim/final reporting can compare planned vs committed vs spent per
          //    regulated cost group (assets, salaries, external_services, literature,
          //    travel, publications, reviews, consumables, other). ──
          var _plannedRaw = {};
          try { _plannedRaw = JSON.parse(typeof budget === 'string' ? (budget || '{}') : JSON.stringify(budget || {})); }
          catch (_) { _plannedRaw = {}; }
          if (!_plannedRaw || typeof _plannedRaw !== 'object' || Array.isArray(_plannedRaw)) _plannedRaw = {};
          var _byCat = (_plannedRaw.byCategory && typeof _plannedRaw.byCategory === 'object') ? _plannedRaw.byCategory : _plannedRaw;
          var _execMarkers = {};
          var _grandPlanned = 0;
          VALID_COST_GROUPS.forEach(function(grp) {
            var v = Number(_byCat[grp]) || 0;
            if (v < 0) v = 0;
            _execMarkers[grp] = { planned: v, committed: 0, spent: 0, remaining: v };
            _grandPlanned += v;
          });
          _execMarkers._meta = {
            initializedAt: now,
            initializedBy: auth.userId || 'system',
            source: body._autoTriggered ? 'auto-on-contracted' : 'manual',
            currency: 'BGN',
            totalPlanned: _grandPlanned,
            totalCommitted: 0,
            totalSpent: 0,
            totalRemaining: _grandPlanned,
            reportingPeriods: []
          };
          projRow[PROJ_COL.BUDGET_EXECUTION - 1] = JSON.stringify(_execMarkers);
          projRow[PROJ_COL.ACTIVITIES - 1] = '[]';
          projRow[PROJ_COL.INDICATORS - 1] = row[COL.INDICATORS - 1] || '[]';
          projRow[PROJ_COL.PUBLICATIONS - 1] = '[]';
          projRow[PROJ_COL.CONTRACT_ID - 1] = contractId;
          projRow[PROJ_COL.YEAR - 1] = body.year || new Date().getFullYear();
          projRow[PROJ_COL.NOTES - 1] = body.notes || '';
          projSheet.appendRow(projRow);
          // Update application status to 'active'
          for (var r = 1; r < data.length; r++) {
            if (String(data[r][COL.ID - 1]).trim() === appId) {
              var hist = [];
              try { hist = JSON.parse(String(row[COL.HISTORY - 1] || '[]')); } catch (_) {}
              hist.push({ status: 'active', ts: now, by: auth.userId || 'system', projectId: id });
              // Batch: 2 cell writes → 1 setValues round-trip.
              var _arow = data[r].slice();
              _arow[COL.STATUS  - 1] = 'active';
              _arow[COL.HISTORY - 1] = JSON.stringify(hist);
              sheet.getRange(r + 1, 1, 1, TOTAL_COLS).setValues([_arow]);
              break;
            }
          }
          console.log('[AUDIT] createProject', auth.userId, { projectId: id, applicationId: appId });
          return { success: true, projectId: id };
        } catch (err) {
          logError('createProject', err, body);
          return { success: false, error: 'createProject failed: ' + err.message };
        }
      }

      function getProjects(body) {
        try {
          var auth = resolveAuthContext(body);
          var userEmail = (auth.userId || '').toLowerCase();
          var isPrivileged = auth.isAdmin || auth.role === ROLE_CKK || auth.role === ROLE_NIDD || auth.role === ROLE_RECTOR || auth.role === ROLE_VICE_RECTOR;
          // Version-keyed CacheService cache (30s TTL)
          var sc = _scriptCache_();
          var dv = getDataVersions_();
          var cacheKey = 'gProjects:' + (isPrivileged ? 'adm' : userEmail) + ':' + (body.status || '') + ':' + dv.projects + ':' + dv.applications;
          if (!body.forceRefresh) {
            try { var cv = sc.get(cacheKey); if (cv) return JSON.parse(cv); } catch (_) {}
          }
          var sheet = getProjectsSheet();
          var data = sheet.getDataRange().getValues();
          // Build appId → {score, rank, evaluation} index from Applications sheet
          // so the project board can echo the live evaluation joined from the
          // source-of-truth row, without forcing every render to re-query.
          var _scoreIndex = {};
          try {
            var appSheet = getSheet();
            var appData = appSheet.getDataRange().getValues();
            for (var ai = 1; ai < appData.length; ai++) {
              var ar = appData[ai];
              var aid = String(ar[COL.ID - 1] || '').trim();
              if (!aid) continue;
              _scoreIndex[aid] = {
                score: ar.length >= COL.SCORE ? (Number(ar[COL.SCORE - 1]) || 0) : 0,
                rank : ar.length >= COL.RANK  ? (Number(ar[COL.RANK  - 1]) || 0) : 0,
                evaluation: safeParseJSON(ar.length >= COL.EVALUATION ? ar[COL.EVALUATION - 1] : '', {}),
                reviewers : safeParseJSON(ar.length >= COL.REVIEWERS  ? ar[COL.REVIEWERS  - 1] : '', [])
              };
            }
          } catch (_) { _scoreIndex = {}; }
          var projects = [];
          for (var i = 1; i < data.length; i++) {
            var r = data[i];
            if (!String(r[PROJ_COL.ID - 1]).trim()) continue;
            // Non-privileged users see only their own projects
            if (!isPrivileged && String(r[PROJ_COL.LEADER_EMAIL - 1]).toLowerCase() !== userEmail) {
              var members = [];
              try { members = JSON.parse(String(r[PROJ_COL.TEAM_MEMBERS - 1] || '[]')); } catch (_) {}
              var isMember = members.some(function(m) { return String(m.email || '').toLowerCase() === userEmail; });
              if (!isMember) continue;
            }
            var bRaw = null;
            try { bRaw = JSON.parse(String(r[PROJ_COL.BUDGET - 1] || '{}')); } catch (_) { bRaw = {}; }
            var bTotal = 0;
            if (bRaw && typeof bRaw === 'object' && !Array.isArray(bRaw)) {
              Object.keys(bRaw).forEach(function(k) {
                if (k === '_monthlyMode' || k === '_monthly') return;
                var val = bRaw[k];
                if (typeof val === 'object' && val !== null && !Array.isArray(val)) {
                  Object.keys(val).forEach(function(yr) { bTotal += Number(val[yr]) || 0; });
                } else {
                  bTotal += Number(val) || 0;
                }
              });
            } else if (typeof bRaw === 'number') { bTotal = bRaw; }
            projects.push({
              id: String(r[PROJ_COL.ID - 1]),
              applicationId: String(r[PROJ_COL.APPLICATION_ID - 1]),
              competitionId: String(r[PROJ_COL.COMPETITION_ID - 1]),
              leaderEmail: String(r[PROJ_COL.LEADER_EMAIL - 1]),
              leaderName: String(r[PROJ_COL.LEADER_NAME - 1]),
              title: String(r[PROJ_COL.TITLE - 1]),
              projectCode: String(r[PROJ_COL.PROJECT_CODE - 1]),
              projectType: String(r[PROJ_COL.PROJECT_CODE - 1]).replace(/[-_\s].*/, '').toUpperCase(),
              direction: String(r[PROJ_COL.DIRECTION - 1]),
              status: String(r[PROJ_COL.STATUS - 1]),
              startDate: String(r[PROJ_COL.START_DATE - 1]),
              endDate: String(r[PROJ_COL.END_DATE - 1]),
              year: String(r[PROJ_COL.YEAR - 1]),
              budget: bTotal,
              totalBudget: bTotal,
              contractId: String(r[PROJ_COL.CONTRACT_ID - 1]),
              // Real-time evaluation echo — joined from Applications sheet so
              // the project board shows up-to-date "Оценка / Класиране" the
              // moment reviewers submit. Empty when the project pre-dates
              // scoring or sits outside the scored lifecycle phases.
              score      : (_scoreIndex[String(r[PROJ_COL.APPLICATION_ID - 1])] || {}).score      || 0,
              rank       : (_scoreIndex[String(r[PROJ_COL.APPLICATION_ID - 1])] || {}).rank       || 0,
              evaluation : (_scoreIndex[String(r[PROJ_COL.APPLICATION_ID - 1])] || {}).evaluation || {},
              reviewers  : (_scoreIndex[String(r[PROJ_COL.APPLICATION_ID - 1])] || {}).reviewers  || []
            });
          }
          if (body.status) projects = projects.filter(function(p) { return p.status === body.status; });
          var result = { success: true, projects: projects };
          try { var rj = JSON.stringify(result); if (rj.length < 95000) sc.put(cacheKey, rj, 3600); } catch (_) {}
          return result;
        } catch (err) {
          logError('getProjects', err, body);
          return { success: false, error: 'getProjects failed: ' + err.message };
        }
      }

      function getProject(body) {
        try {
          var auth = resolveAuthContext(body);
          var projectId = String(body.projectId || '').trim();
          if (!projectId) return { success: false, error: 'Липсва projectId.' };
          // Version-keyed cache (30s TTL)
          var sc = _scriptCache_();
          var dv = getDataVersions_();
          var cacheKey = 'gProject:' + projectId + ':' + dv.projects;
          if (!body.forceRefresh) {
            try { var cv = sc.get(cacheKey); if (cv) return JSON.parse(cv); } catch (_) {}
          }
          var sheet = getProjectsSheet();
          var data = sheet.getDataRange().getValues();
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][PROJ_COL.ID - 1]).trim() !== projectId) continue;
            var r = data[i];
            var leaderEmail = String(r[PROJ_COL.LEADER_EMAIL - 1]).toLowerCase();
            var userEmail = (auth.userId || '').toLowerCase();
            var isPrivileged = auth.isAdmin || auth.role === ROLE_CKK || auth.role === ROLE_NIDD || auth.role === ROLE_RECTOR || auth.role === ROLE_VICE_RECTOR;
            if (!isPrivileged && leaderEmail !== userEmail) {
              var members = [];
              try { members = JSON.parse(String(r[PROJ_COL.TEAM_MEMBERS - 1] || '[]')); } catch (_) {}
              var isMember = members.some(function(m) { return String(m.email || '').toLowerCase() === userEmail; });
              if (!isMember) return { success: false, error: 'Нямате достъп до този проект.' };
            }
            var activities = [];
            try { activities = JSON.parse(String(r[PROJ_COL.ACTIVITIES - 1] || '[]')); } catch (_) {}
            // Fetch change requests for this project
            var changeRequests = [];
            try {
              var crSheet = getChangeRequestsSheet();
              var crData = crSheet.getDataRange().getValues();
              for (var ci = 1; ci < crData.length; ci++) {
                if (String(crData[ci][CR_COL.PROJECT_ID - 1]).trim() !== projectId) continue;
                changeRequests.push({
                  id: String(crData[ci][CR_COL.ID - 1]),
                  changeType: String(crData[ci][CR_COL.CHANGE_TYPE - 1]),
                  requestedBy: String(crData[ci][CR_COL.REQUESTED_BY - 1]),
                  submittedAt: String(crData[ci][CR_COL.REQUESTED_AT - 1]),
                  status: String(crData[ci][CR_COL.STATUS - 1]),
                  description: String(crData[ci][CR_COL.DESCRIPTION - 1]),
                  reviewedBy: String(crData[ci][CR_COL.REVIEWED_BY - 1] || ''),
                  reviewedAt: String(crData[ci][CR_COL.REVIEWED_AT - 1] || ''),
                  decision: String(crData[ci][CR_COL.DECISION - 1] || ''),
                  notes: String(crData[ci][CR_COL.NOTES - 1] || '')
                });
              }
            } catch (_) {}
            // Budget: surface as numeric total for UI display
            // Supports both flat {catId: amount} and hierarchical {catId: {year: amount}} formats
            var budgetRaw = null;
            try { budgetRaw = JSON.parse(String(r[PROJ_COL.BUDGET - 1] || '{}')); } catch (_) { budgetRaw = {}; }
            var budgetTotal = 0;
            if (budgetRaw && typeof budgetRaw === 'object' && !Array.isArray(budgetRaw)) {
              Object.keys(budgetRaw).forEach(function(k) {
                if (k === '_monthlyMode' || k === '_monthly') return;
                var val = budgetRaw[k];
                if (typeof val === 'object' && val !== null && !Array.isArray(val)) {
                  // Hierarchical format: {year: amount}
                  Object.keys(val).forEach(function(yr) { budgetTotal += Number(val[yr]) || 0; });
                } else {
                  // Flat format: numeric amount
                  budgetTotal += Number(val) || 0;
                }
              });
            } else if (typeof budgetRaw === 'number') {
              budgetTotal = budgetRaw;
            }
            // Fetch objectives/expectedResults from linked application if available
            var objectives = '';
            var expectedResults = '';
            var appId = String(r[PROJ_COL.APPLICATION_ID - 1]).trim();
            if (appId) {
              try {
                var appSheet = getSheet();
                var appData = appSheet.getDataRange().getValues();
                for (var ai = 1; ai < appData.length; ai++) {
                  if (String(appData[ai][COL.ID - 1]).trim() === appId) {
                    objectives = String(appData[ai][COL.OBJECTIVES - 1] || '');
                    expectedResults = String(appData[ai][COL.EXPECTED_RESULTS - 1] || '');
                    break;
                  }
                }
              } catch (_) {}
            }
            var result = {
              success: true,
              project: {
                id: String(r[PROJ_COL.ID - 1]),
                applicationId: appId,
                competitionId: String(r[PROJ_COL.COMPETITION_ID - 1]),
                leaderEmail: String(r[PROJ_COL.LEADER_EMAIL - 1]),
                leaderName: String(r[PROJ_COL.LEADER_NAME - 1]),
                teamMembers: (function() { try { return JSON.parse(String(r[PROJ_COL.TEAM_MEMBERS - 1] || '[]')); } catch (_) { return []; } })(),
                title: String(r[PROJ_COL.TITLE - 1]),
                projectCode: String(r[PROJ_COL.PROJECT_CODE - 1]),
                direction: String(r[PROJ_COL.DIRECTION - 1]),
                status: String(r[PROJ_COL.STATUS - 1]),
                startDate: String(r[PROJ_COL.START_DATE - 1]),
                endDate: String(r[PROJ_COL.END_DATE - 1]),
                budget: budgetTotal,
                budgetDetail: budgetRaw,
                totalBudget: budgetTotal,
                budgetExecution: (function() { try { return JSON.parse(String(r[PROJ_COL.BUDGET_EXECUTION - 1] || '{}')); } catch (_) { return {}; } })(),
                activities: activities,
                indicators: (function() { try { return JSON.parse(String(r[PROJ_COL.INDICATORS - 1] || '[]')); } catch (_) { return []; } })(),
                publications: (function() { try { return JSON.parse(String(r[PROJ_COL.PUBLICATIONS - 1] || '[]')); } catch (_) { return []; } })(),
                contractId: String(r[PROJ_COL.CONTRACT_ID - 1]),
                year: String(r[PROJ_COL.YEAR - 1]),
                notes: String(r[PROJ_COL.NOTES - 1]),
                objectives: objectives,
                expectedResults: expectedResults,
                changeRequests: changeRequests
              }
            };
            try { var rj = JSON.stringify(result); if (rj.length < 95000) sc.put(cacheKey, rj, 3600); } catch (_) {}
            return result;
          }
          return { success: false, error: 'Проектът не е намерен.' };
        } catch (err) {
          logError('getProject', err, body);
          return { success: false, error: 'getProject failed: ' + err.message };
        }
      }

      function updateProject(body) {
        try {
          var auth = resolveAuthContext(body);
          var projectId = String(body.projectId || '').trim();
          if (!projectId) return { success: false, error: 'Липсва projectId.' };
          var sheet = getProjectsSheet();
          var data = sheet.getDataRange().getValues();
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][PROJ_COL.ID - 1]).trim() !== projectId) continue;
            var leaderEmail = String(data[i][PROJ_COL.LEADER_EMAIL - 1]).toLowerCase();
            var isPrivileged = auth.isAdmin || auth.role === ROLE_CKK || auth.role === ROLE_NIDD;
            if (!isPrivileged && leaderEmail !== (auth.userId || '').toLowerCase()) return { success: false, error: 'Нямате право да редактирате.' };
            var allowed = ['activities', 'indicators', 'publications', 'notes', 'endDate', 'budgetExecution'];
            if (isPrivileged) allowed = allowed.concat(['status', 'budget', 'teamMembers']);
            var fieldMap = {
              activities: PROJ_COL.ACTIVITIES, indicators: PROJ_COL.INDICATORS,
              publications: PROJ_COL.PUBLICATIONS, notes: PROJ_COL.NOTES,
              endDate: PROJ_COL.END_DATE, budgetExecution: PROJ_COL.BUDGET_EXECUTION,
              status: PROJ_COL.STATUS, budget: PROJ_COL.BUDGET, teamMembers: PROJ_COL.TEAM_MEMBERS
            };
            // Batch all field updates into a single row write instead of N separate setValue() calls
            var updatedRow = data[i].slice();
            var changed = false;
            allowed.forEach(function(f) {
              if (body[f] !== undefined && fieldMap[f]) {
                var val = body[f];
                if (typeof val === 'object') val = JSON.stringify(val);
                updatedRow[fieldMap[f] - 1] = val;
                changed = true;
              }
            });
            if (changed) sheet.getRange(i + 1, 1, 1, PROJ_TOTAL_COLS).setValues([updatedRow]);
            console.log('[AUDIT] updateProject', auth.userId, { projectId: projectId });
            return { success: true };
          }
          return { success: false, error: 'Проектът не е намерен.' };
        } catch (err) {
          logError('updateProject', err, body);
          return { success: false, error: 'updateProject failed: ' + err.message };
        }
      }

      // ============================================================
      //  REPORTS
      // ============================================================

      function submitReport(body) {
        try {
          var auth = resolveAuthContext(body);
          var projectId = String(body.projectId || '').trim();
          if (!projectId) return { success: false, error: 'Липсва projectId.' };
          var reportType = String(body.reportType || '').trim(); // semiannual|annual|interim|final
          var validTypes = ['semiannual', 'annual', 'interim', 'final'];
          if (!validTypes.includes(reportType)) return { success: false, error: 'Невалиден тип отчет. Допустими: ' + validTypes.join(', ') };
          // Verify user belongs to project
          var projSheet = getProjectsSheet();
          var projData = projSheet.getDataRange().getValues();
          var projRow = null;
          for (var i = 1; i < projData.length; i++) {
            if (String(projData[i][PROJ_COL.ID - 1]).trim() === projectId) { projRow = projData[i]; break; }
          }
          if (!projRow) return { success: false, error: 'Проектът не е намерен.' };
          var leaderEmail = String(projRow[PROJ_COL.LEADER_EMAIL - 1]).toLowerCase();
          var userEmail = (auth.userId || '').toLowerCase();
          if (!auth.isAdmin && leaderEmail !== userEmail) return { success: false, error: 'Само ръководителят може да подава отчети.' };
          var rptSheet = getReportsSheet();
          var rptData = rptSheet.getDataRange().getValues();
          var now = new Date().toISOString();

          // Upload any locally-attached files (base64) to Drive and merge with any pre-uploaded fileIds.
          var uploadedAttachments = [];
          try {
            if (Array.isArray(body.attachments) && body.attachments.length) {
              uploadedAttachments = saveFilesToDrive(body.attachments, projectId, userEmail) || [];
            }
          } catch (upErr) {
            console.error('submitReport attachment upload failed: ' + upErr.message);
          }
          var preFileIds = Array.isArray(body.fileIds) ? body.fileIds : [];
          var mergedFiles = preFileIds.concat(uploadedAttachments);

          // Check for existing returned report for the same project/type/period — update instead of creating duplicate
          var existingRow = -1;
          for (var ri = 1; ri < rptData.length; ri++) {
            var er = rptData[ri];
            if (String(er[RPT_COL.PROJECT_ID - 1]).trim() === projectId &&
                String(er[RPT_COL.REPORT_TYPE - 1]).trim() === reportType &&
                String(er[RPT_COL.PERIOD - 1]).trim() === String(body.period || '').trim() &&
                String(er[RPT_COL.STATUS - 1]).trim() === 'returned') {
              existingRow = ri;
              break;
            }
          }

          if (existingRow >= 0) {
            // Resubmit: update existing returned report
            var exRow = rptData[existingRow];
            var existingId = String(exRow[RPT_COL.ID - 1]);
            var existingHistory = [];
            try { existingHistory = JSON.parse(String(exRow[RPT_COL.HISTORY - 1] || '[]')); } catch (_) {}
            existingHistory.push({ status: 'resubmitted', ts: now, by: userEmail });
            exRow[RPT_COL.STATUS - 1] = 'submitted';
            exRow[RPT_COL.SUBMITTED_BY - 1] = userEmail;
            exRow[RPT_COL.SUBMITTED_AT - 1] = now;
            exRow[RPT_COL.SCIENTIFIC_CONTENT - 1] = typeof body.scientificContent === 'object' ? JSON.stringify(body.scientificContent) : String(body.scientificContent || '');
            exRow[RPT_COL.FINANCIAL_SUMMARY - 1] = typeof body.financialSummary === 'object' ? JSON.stringify(body.financialSummary) : String(body.financialSummary || '');
            exRow[RPT_COL.FILE_IDS - 1] = JSON.stringify(mergedFiles);
            exRow[RPT_COL.HISTORY - 1] = JSON.stringify(existingHistory);
            rptSheet.getRange(existingRow + 1, 1, 1, RPT_TOTAL_COLS).setValues([exRow]);
            console.log('[AUDIT] submitReport (resubmit)', auth.userId, { reportId: existingId, projectId: projectId, reportType: reportType });
            return { success: true, reportId: existingId, resubmitted: true };
          }

          // New report
          var id = 'RPT-' + Utilities.getUuid().replace(/-/g, '').substring(0, 12).toUpperCase();
          var rptRow = new Array(RPT_TOTAL_COLS).fill('');
          rptRow[RPT_COL.ID - 1] = id;
          rptRow[RPT_COL.PROJECT_ID - 1] = projectId;
          rptRow[RPT_COL.REPORT_TYPE - 1] = reportType;
          rptRow[RPT_COL.STATUS - 1] = 'submitted';
          rptRow[RPT_COL.PERIOD - 1] = String(body.period || '');
          rptRow[RPT_COL.SUBMITTED_BY - 1] = userEmail;
          rptRow[RPT_COL.SUBMITTED_AT - 1] = now;
          rptRow[RPT_COL.SCIENTIFIC_CONTENT - 1] = typeof body.scientificContent === 'object' ? JSON.stringify(body.scientificContent) : String(body.scientificContent || '');
          rptRow[RPT_COL.FINANCIAL_SUMMARY - 1] = typeof body.financialSummary === 'object' ? JSON.stringify(body.financialSummary) : String(body.financialSummary || '');
          rptRow[RPT_COL.FILE_IDS - 1] = JSON.stringify(mergedFiles);
          rptRow[RPT_COL.HISTORY - 1] = JSON.stringify([{ status: 'submitted', ts: now, by: userEmail }]);
          rptSheet.appendRow(rptRow);
          console.log('[AUDIT] submitReport', auth.userId, { reportId: id, projectId: projectId, reportType: reportType });
          return { success: true, reportId: id };
        } catch (err) {
          logError('submitReport', err, body);
          return { success: false, error: 'submitReport failed: ' + err.message };
        }
      }

