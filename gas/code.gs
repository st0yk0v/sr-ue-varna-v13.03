      function doPost(e) {
        try {
          var body = parseRequestBody_(e);
          var rawAction = resolveRequestAction_(body);
          var action = normalizeAction_(rawAction);
          // v12.14.1-perf: Pass action hint to warmup so sheet-heavy phases
          // are skipped for auth-only actions (ping, checkadmin, adminlogin).
          _warmup_(action);

