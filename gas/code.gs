          newRow[COL.HISTORY - 1]        = JSON.stringify(history);

          if (newStatus === 'approved' && body.signatureType === 'attached' && body.attachedFileId) {
            var attachedMarker = ATTACHED_DOC_MARKER_PREFIX + JSON.stringify({
              fileId: String(body.attachedFileId || ''),
              fileName: String(body.attachedFileName || 'Подписан документ'),
              attachedAt: nowISO(),
              attachedBy: actor
            });
            newRow[COL.SIGNATURE_ADMIN - 1] = attachedMarker;
            history.push({
              action: 'Одобрение с прикачен подписан документ (Администратор)',
