      function _pushToHostinger_(tableName, records) {
        var url = _getMirrorUrl_();
        if (!url) return { success: false, error: 'HOSTINGER_API_URL not configured' };
        if (!records || !records.length) return { success: true, table: tableName, synced: 0 };

        var payload = {
          action: 'fullmirror',
          table: tableName,
          records: records,
          timestamp: new Date().toISOString(),
          build: typeof CODE_VERSION !== 'undefined' ? CODE_VERSION : '?'
        };

        var maxRetries = 5; // v10.5.0: increased retries for large mirror ops
        var lastError = '';
        // v10.5.0: Split large datasets into chunks to avoid GAS 30s timeout
        var chunkSize = 250;
        if (records.length > chunkSize) {
          var allResults = [];
          var allErrors = [];
          for (var ci = 0; ci < records.length; ci += chunkSize) {
            var chunk = records.slice(ci, ci + chunkSize);
            var chunkPayload = _buildMirrorPayload_(tableName, chunk);
            var chunkRes = _sendMirrorChunk_(url, chunkPayload);
            if (chunkRes && chunkRes.success) allResults.push(chunkRes.synced || 0);
            else allErrors.push('chunk ' + (ci/chunkSize) + ': ' + ((chunkRes && chunkRes.error) || 'fail'));
          }
          var totalSynced = allResults.reduce(function(s, n){ return s + n; }, 0);
          return { success: allErrors.length === 0, table: tableName, synced: totalSynced,
            total: records.length, errors: allErrors.length ? allErrors : undefined, chunked: true };
        }
        for (var r = 0; r < maxRetries; r++) {
          try {
            var options = {
              method: 'post',
              contentType: 'application/json',
              payload: JSON.stringify(payload),
              muteHttpExceptions: true,
              timeout: Math.min(180000, 30000 + records.length * 10) // adaptive timeout
            };
            var response = UrlFetchApp.fetch(url, options);
            var code = response.getResponseCode();
            if (code >= 200 && code < 300) {
              var body = response.getContentText();
              var parsed = JSON.parse(body);
              if (parsed && parsed.success) return parsed;
              lastError = parsed && parsed.error ? parsed.error : 'Unknown mirror error';
            } else {
              lastError = 'HTTP ' + code + ': ' + response.getContentText().substring(0, 200);
            }
          } catch (e) {
            lastError = e.message;
            if (r < maxRetries - 1) Utilities.sleep(1000 * (r + 1)); // exponential backoff
          }
        }
        console.error('[HostingerMirror] Failed to push ' + tableName + ' (' + records.length + ' records): ' + lastError);
        return { success: false, table: tableName, error: lastError };
      }

      /**
