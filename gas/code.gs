              var sfi = sessionFolder.getFiles();
              while (sfi.hasNext()) {
                var sf = sfi.next();
                try {
                  var sfName = sf.getName();
                  // Match generated copies: name contains the short form ID
                  // OR the file was explicitly linked in attachedDocs we already know.
                  if (sfName.indexOf(idPrefix8) >= 0 || _trashedIds[sf.getId()]) {
                    sf.setTrashed(true);
