          }
          var tpl = PROJECT_BUDGET_TEMPLATES[projectType];
          if (!tpl || !tpl.id) return { success: false, error: 'Няма бюджетен шаблон за тип: ' + projectType };

          var original = null;
          try { original = DriveApp.getFileById(tpl.id); }
          catch (e) { return { success: false, error: 'Бюджетният шаблон не е достъпен: ' + e.message }; }

          var userFolder = getOrCreateMyDocsFolder_(auth.userId || '');
          if (!userFolder) return { success: false, error: 'Не може да се създаде лична папка.' };

          var baseName = tpl.label || original.getName();
          var copyName = baseName;
          // v12.26.0-perf: Cache regex match
          var _cpBaseName3 = baseName.replace(/(\.[^.]+)$/, '');
          var _cpExt3 = baseName.match(/(\.[^.]+)$/);
          var _cpExtStr3 = _cpExt3 ? _cpExt3[0] : '';
          var existing = userFolder.getFilesByName(copyName);
          if (existing.hasNext()) {
            var idx = 1;
            do {
              copyName = _cpBaseName3 + ' (копие ' + (++idx) + ')' + _cpExtStr3;
            } while (userFolder.getFilesByName(copyName).hasNext() && idx < 50);
          }
          var copy = original.makeCopy(copyName, userFolder);
          var copyId = copy.getId();

          try {
            copy.setDescription([
              'TEMPLATE_SOURCE=' + tpl.id,
              'TEMPLATE_NAME=' + original.getName(),
              'PROJECT_TYPE=' + projectType,
              'TEMPLATE_KEY=budget',
              'ORIGIN=budget'
            ].join('|'));
          } catch (_) {}

          try { _grantOversightAccess_(copy); } catch (_) {}
          // v12.30.2-defensive: ALSO set link-sharing + admin viewers (same as
          // copyDocForUser/copyDocument since v12.30.1). _grantOversightAccess_
          // alone does NOT set ANYONE_WITH_LINK, so the preview iframe showed
          // "За съжаление файлът... не съществува" for accounts without an
          // explicit grant.
          try { shareGeneratedFile_(copy); } catch (_) {}
          try { _addEditorSilently_(copy, auth.userId || ''); } catch (_) {}

          // Best-effort: write the Step-3 budget totals into the responsible cells.
          // Also populate metadata fields (project type, formId, acronym, applicant name, title)
          // into designated header/annotation cells in the spreadsheet.
          var prefilled = 0;
          try {
            var budgetData = body.budget;
            if (typeof budgetData === 'string') { try { budgetData = JSON.parse(budgetData); } catch (_) { budgetData = null; } }
            if (budgetData) prefilled = _prefillBudgetSheet_(copyId, tpl.gid, budgetData);
          } catch (_) {}
          // ── Write metadata into designated cells ──
          try {
            var metaPayload = {
              formId: String(body.formId || '').trim(),
