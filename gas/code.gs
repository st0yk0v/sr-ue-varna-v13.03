      // ============================================================
      //  SHEET WIDTH GUARD – ensures the sheet has at least numCols
      //  columns before any setValues call.
      // ============================================================
      function ensureSheetWidth_(sheet, numCols) {
        var requiredCols = Math.max(Number(numCols) || 0, EXPECTED_HEADERS.length || 0, TOTAL_COLS || 0);
        var current = Math.max(sheet.getMaxColumns(), sheet.getLastColumn());
        if (current >= requiredCols) return requiredCols;
        sheet.insertColumnsAfter(current, requiredCols - current);
        for (var c = current + 1; c <= requiredCols; c++) {
          sheet.getRange(1, c).setValue(EXPECTED_HEADERS[c - 1] || ('Col' + c));
          sheet.setColumnWidth(c, 120);
        }
        // PERF_MODE: skip explicit flush. Sheets API flushes automatically
        // before the next read in the same execution, and the caller's
        // subsequent setValues() write does not depend on width visibility.
        if (!PERF_MODE) SpreadsheetApp.flush();
        return requiredCols;
      }

      // ── Repair sheet headers after manual cell deletion ────────────────────
      // Validates that row 1 contains the expected headers in the right order.
      // If columns are missing or misplaced, it rebuilds the header row and
      // re-indexes existing data rows so column semantics are preserved.
      function repairSheetHeaders_(sheet, expectedHeaders, totalCols) {
        if (!sheet) return { repaired: false };
        // ── Cross-execution fast-path: skip header check if CacheService says it's OK ──
        var hdrsKey = 'HDRS_OK_' + sheet.getName();
        try { if (_scriptCache_().get(hdrsKey) === '1') return { repaired: false, message: 'Headers OK (cached)' }; } catch (_) {}
        var lock = LockService.getScriptLock();
        var hasLock = false;
        try { lock.waitLock(15000); hasLock = true; } catch (_) {}
        try {
          var maxCols = Math.max(sheet.getMaxColumns(), sheet.getLastColumn(), 1);
          var headerRow = maxCols > 0 ? sheet.getRange(1, 1, 1, maxCols).getValues()[0] : [];
          var headerMap = {};
          for (var h = 0; h < headerRow.length; h++) {
            var hv = String(headerRow[h] || '').trim();
            if (hv) headerMap[hv] = h; // 0-based position in current sheet
          }

          // Check if all expected headers exist in the correct positions
          var needsRepair = false;
          if (maxCols < totalCols) needsRepair = true;
          for (var e = 0; e < expectedHeaders.length; e++) {
            if (String(headerRow[e] || '').trim() !== expectedHeaders[e]) {
              needsRepair = true;
              break;
            }
          }
          if (!needsRepair) {
            // Cache the OK status for 10 minutes to skip future checks
            try { _scriptCache_().put(hdrsKey, '1', 600); } catch (_) {}
            return { repaired: false, message: 'Headers OK' };
          }

          // Build mapping: for each expected header, find its current column index (0-based)
          var colMapping = []; // colMapping[newIndex] = oldIndex or -1
          for (var n = 0; n < expectedHeaders.length; n++) {
            var expectedName = expectedHeaders[n];
            colMapping.push(headerMap.hasOwnProperty(expectedName) ? headerMap[expectedName] : -1);
          }

          // Read all data rows
          var lastRow = sheet.getLastRow();
          var dataRows = lastRow > 1 ? sheet.getRange(2, 1, lastRow - 1, maxCols).getValues() : [];

          // Rebuild data rows with correct column order
          var rebuiltRows = [];
          for (var d = 0; d < dataRows.length; d++) {
            var oldRow = dataRows[d];
            var newRow = [];
            for (var c = 0; c < expectedHeaders.length; c++) {
              newRow.push(colMapping[c] >= 0 ? (oldRow[colMapping[c]] || '') : '');
            }
            rebuiltRows.push(newRow);
          }

          // Ensure sheet has enough columns
          if (sheet.getMaxColumns() < totalCols) {
            sheet.insertColumnsAfter(sheet.getMaxColumns(), totalCols - sheet.getMaxColumns());
          }
          // Remove excess columns if any
          if (sheet.getMaxColumns() > totalCols) {
            try { sheet.deleteColumns(totalCols + 1, sheet.getMaxColumns() - totalCols); } catch (_) {}
          }

          // Write repaired header
          sheet.getRange(1, 1, 1, totalCols).setValues([expectedHeaders]);
          sheet.getRange(1, 1, 1, totalCols)
            .setBackground('#7B0000').setFontColor('#ffffff').setFontWeight('bold');

          // Write repaired data
          if (rebuiltRows.length > 0) {
            sheet.getRange(2, 1, rebuiltRows.length, totalCols).setValues(rebuiltRows);
          }

          // Clear any orphan rows beyond the data
          if (sheet.getLastRow() > rebuiltRows.length + 1) {
            try { sheet.deleteRows(rebuiltRows.length + 2, sheet.getLastRow() - rebuiltRows.length - 1); } catch (_) {}
          }

          SpreadsheetApp.flush();
          // Bust the headers-OK cache so next call re-validates the repaired layout
          try { _scriptCache_().remove(hdrsKey); } catch (_) {}
          return {
            repaired: true,
            message: 'Repaired ' + expectedHeaders.length + ' headers, re-indexed ' + rebuiltRows.length + ' data rows',
            mappings: colMapping
          };
        } finally {
          if (hasLock) {
            try { lock.releaseLock(); } catch (_) {}
          }
        }
      }

      // Safe row write: expands legacy sheets and always aligns range width to the actual row payload.
      function safeSetRow_(sheet, rowIndex, rowArray, numCols) {
        var targetCols = Math.max(
          Number(numCols) || 0,
          Array.isArray(rowArray) ? rowArray.length : 0,
          EXPECTED_HEADERS.length || 0,
          TOTAL_COLS || 0
        );
        ensureSheetWidth_(sheet, targetCols);
        var row = Array.isArray(rowArray) ? rowArray.slice(0, targetCols) : [];
        while (row.length < targetCols) row.push('');
        sheet.getRange(rowIndex, 1, 1, targetCols).setValues([row]);
        // Invalidate the in-execution read cache so any post-write read in
        // the same execution (e.g. syncAllDerivedSheets_) sees fresh data.
        _bustSheetCache_(sheet.getName());
      }

      function protectManagedSheet_(sheet, description) {
        if (!sheet) return;
        var sheetName = sheet.getName();
        // ── Per-execution dedup: skip if we already ran protection for this sheet ──
        if (!_sheetCache._protected) _sheetCache._protected = {};
        if (_sheetCache._protected[sheetName]) return;
        _sheetCache._protected[sheetName] = true;
        // ── Cross-execution dedup: skip getProtections() if done within last 10 min ──
        var protKey = 'PROT_OK_' + sheetName;
        try { if (_scriptCache_().get(protKey) === '1') return; } catch (_) {}
        try {
          var protections = sheet.getProtections(SpreadsheetApp.ProtectionType.SHEET);
          var protection = (protections && protections.length) ? protections[0] : sheet.protect();
          protection.setDescription(description || 'ERP managed sheet — редакция само през системата');
          protection.setWarningOnly(false);

          var myEmail = '';
          try { myEmail = String(Session.getEffectiveUser().getEmail() || '').toLowerCase().trim(); } catch (_) {}

          // Build the set of emails that SHOULD be editors (script owner + admin emails)
          loadAdminCredentials_();
          var allowedEmails = {};
          if (myEmail) allowedEmails[myEmail] = true;
          (_ADMIN_EMAILS_SERVER || ADMIN_EMAILS_SERVER || []).forEach(function(e) {
            var em = String(e || '').toLowerCase().trim();
            if (em) allowedEmails[em] = true;
          });

          try {
            var editors = protection.getEditors ? protection.getEditors() : [];
            var removable = [];
            var existingEmails = {};
            for (var i = 0; i < editors.length; i++) {
              var edEmail = String(editors[i].getEmail() || '').toLowerCase().trim();
              existingEmails[edEmail] = true;
              if (edEmail && !allowedEmails[edEmail]) removable.push(editors[i]);
            }
            if (removable.length) protection.removeEditors(removable);
            // Add missing admin editors
            var toAdd = [];
            Object.keys(allowedEmails).forEach(function(em) {
              if (!existingEmails[em]) toAdd.push(em);
            });
            if (toAdd.length) protection.addEditors(toAdd);
            if (protection.canDomainEdit && protection.canDomainEdit()) protection.setDomainEdit(false);
          } catch (_) {}
          // Mark as done in CacheService for 10 minutes to skip next executions
          try { _scriptCache_().put(protKey, '1', 600); } catch (_) {}
        } catch (err) {
          try {
            var fallbackProtections = sheet.getProtections(SpreadsheetApp.ProtectionType.SHEET);
            var fallback = (fallbackProtections && fallbackProtections.length) ? fallbackProtections[0] : sheet.protect();
            fallback.setDescription(description || 'ERP managed sheet — warning only');
            fallback.setWarningOnly(true);
          } catch (_) {}
        }
      }

      function clearSheetDataRows_(sheet, keepHeaderRows) {
        if (!sheet) return 0;
        var keepRows = Math.max(1, Number(keepHeaderRows) || 1);
        var lastRow = sheet.getLastRow();
        if (lastRow <= keepRows) return 0;
        var rowsToDelete = lastRow - keepRows;
        sheet.deleteRows(keepRows + 1, rowsToDelete);
        return rowsToDelete;
      }

      function isMockOrStaleText_(value) {
        var s = String(value || '').toLowerCase().trim();
        if (!s) return false;
        return /(demo|mock|test|sample|dummy|пробен|пример|фиктив|тест)/i.test(s);
      }

      /**
       * A project row is "orphan" or unusable for institutional reporting if it
       * fails the minimum data-integrity contract: must have an ID, a non-mock
       * Title and a leader email. Rows that fail are excluded from MON
       * aggregations and removed by the export-time repair pass.
       */
      function _isOrphanProjectRow_(row) {
        if (!row) return true;
        var id     = String(row[PROJ_COL.ID - 1]    || '').trim();
        var title  = String(row[PROJ_COL.TITLE - 1] || '').trim();
        var leader = String(row[PROJ_COL.LEADER_EMAIL - 1] || '').trim();
        if (!id) return true;
        if (!title || !leader) return true;
        if (isMockOrStaleText_(id) || isMockOrStaleText_(title) || isMockOrStaleText_(leader)) return true;
        if (isMockOrStaleText_(row[PROJ_COL.LEADER_NAME - 1])) return true;
        if (isMockOrStaleText_(row[PROJ_COL.PROJECT_CODE - 1])) return true;
        return false;
      }

      /**
       * Cascade integrity repair across project-bound sheets. Returns counts of
       * orphan/mock rows removed from each. Called from cleanupExportedData_
       * so any admin "Експорт + почистване" run also leaves the workbook in a
       * canonical state for МОН отчети.
       */
      function repairProjectsDataIntegrity_() {
        var summary = { projectsRemoved: 0, reportsRemoved: 0, expensesRemoved: 0, deliverablesRemoved: 0, libraryRemoved: 0, changeRequestsRemoved: 0 };
        try {
          var projSheet = getProjectsSheet();
          var validIds = {};
          var projData = projSheet.getDataRange().getValues();
          for (var i = 1; i < projData.length; i++) {
            if (!_isOrphanProjectRow_(projData[i])) {
              validIds[String(projData[i][PROJ_COL.ID - 1]).trim()] = true;
            }
          }
          summary.projectsRemoved = purgeRowsByPredicate_(projSheet, function(row) { return _isOrphanProjectRow_(row); });
        } catch (e) { console.warn('repair projects: ' + e.message); validIds = null; }

        var cascade = function(sheetGetter, projectIdCol, label, key) {
          try {
            var sh = sheetGetter();
            summary[key] = purgeRowsByPredicate_(sh, function(row) {
              var pid = String(row[projectIdCol - 1] || '').trim();
              if (!pid) return true;                      // orphan w/o project id
              if (validIds && !validIds[pid]) return true; // dangling reference
              return false;
            });
          } catch (e) { console.warn('repair ' + label + ': ' + e.message); }
        };
        cascade(getReportsSheet,         RPT_COL.PROJECT_ID, 'reports',        'reportsRemoved');
        cascade(getExpensesSheet,        EXP_COL.PROJECT_ID, 'expenses',       'expensesRemoved');
        cascade(getDeliverablesSheet,    DEL_COL.PROJECT_ID, 'deliverables',   'deliverablesRemoved');
        cascade(getLibraryDepositsSheet, LIB_COL.PROJECT_ID, 'library',        'libraryRemoved');
        cascade(getChangeRequestsSheet,  CR_COL.PROJECT_ID,  'changeRequests', 'changeRequestsRemoved');
        return summary;
      }

      function purgeRowsByPredicate_(sheet, predicate) {
        if (!sheet || typeof predicate !== 'function') return 0;
        var data = sheet.getDataRange().getValues();
        var rowsToDelete = [];
        for (var i = 1; i < data.length; i++) {
          if (predicate(data[i], i + 1)) rowsToDelete.push(i + 1);
        }
        for (var r = rowsToDelete.length - 1; r >= 0; r--) {
          sheet.deleteRow(rowsToDelete[r]);
        }
        return rowsToDelete.length;
      }

      function cleanupExportedData_() {
        var summary = {
          applicationsCleared: 0,
          reviewersCleared: 0,
          competitionsRemoved: 0,
          totalTouched: 0
        };

        try { summary.applicationsCleared = clearSheetDataRows_(getSheet(), 1); } catch (e) { console.warn('cleanup applications: ' + e.message); }
        try { summary.reviewersCleared = clearSheetDataRows_(getReviewersSheet(), 1); } catch (e) { console.warn('cleanup reviewers: ' + e.message); }
        try {
          summary.competitionsRemoved = purgeRowsByPredicate_(getCompetitionsSheet(), function(row) {
            var id = String(row[COMP_COL.ID - 1] || '').trim();
            var name = String(row[COMP_COL.NAME - 1] || '').trim();
            var status = normalizeCompetitionStatus_(row[COMP_COL.STATUS - 1]);
            if (!id && !name) return true;
            if (isMockOrStaleText_(id) || isMockOrStaleText_(name)) return true;
            return status === 'archived';
          });
        } catch (e) { console.warn('cleanup competitions: ' + e.message); }

        // ── Project-bound integrity repair (MON отчети consistency) ──
        // Removes orphan/mock project rows AND cascades to dependent sheets so
        // the institutional snapshot never references projects that no longer
        // exist. Surfaced in the export summary.
        try {
          var repair = repairProjectsDataIntegrity_();
          summary.projectsRemoved        = repair.projectsRemoved        || 0;
          summary.reportsRemoved         = repair.reportsRemoved         || 0;
          summary.expensesRemoved        = repair.expensesRemoved        || 0;
          summary.deliverablesRemoved    = repair.deliverablesRemoved    || 0;
          summary.libraryRemoved         = repair.libraryRemoved         || 0;
          summary.changeRequestsRemoved  = repair.changeRequestsRemoved  || 0;
        } catch (e) { console.warn('cleanup projects integrity: ' + e.message); }

        summary.totalTouched = summary.applicationsCleared + summary.reviewersCleared + summary.competitionsRemoved
          + (summary.projectsRemoved||0) + (summary.reportsRemoved||0) + (summary.expensesRemoved||0)
          + (summary.deliverablesRemoved||0) + (summary.libraryRemoved||0) + (summary.changeRequestsRemoved||0);

        try {
          var props = _scriptProps_();
          props.deleteProperty('TS_LAST_DERIVED_SYNC');
          var all = props.getProperties();
          Object.keys(all).forEach(function(k) {
            if (k.indexOf('TS_REVIEWERS_') === 0 ||
                k.indexOf('CACHE_REVIEWERS_') === 0 ||
                k.indexOf('CACHE_') === 0 ||
                k.indexOf('TS_CACHE_') === 0) {
              props.deleteProperty(k);
            }
          });
        } catch (_) {}

        try { invalidateCache('COMPETITIONS'); } catch (_) {}
        try { invalidateCache('REVIEWERS_ALL'); } catch (_) {}
        try {
          touchDataVersion_('applications');
          touchDataVersion_('competitions');
          touchDataVersion_('reviewers');
          touchDataVersion_('system');
        } catch (_) {}

        try { publishCompetitionsFeed_(); } catch (_) {}
        try { syncAllDerivedSheets_(true); } catch (_) {}

        return summary;
      }

      function findRowByID(sheet, id, preloadedData) {
        var sid  = String(id || '').trim();
        if (!sid) return null;
        // Use per-execution cache when no preloaded data is provided —
        // avoids redundant getDataRange().getValues() when the same sheet
        // is searched multiple times within one doPost execution.
        var data = preloadedData || _cachedSheetData_(sheet);
        for (var i = 1; i < data.length; i++) {
          if (String(data[i][COL.ID - 1]).trim() === sid) {
            return { rowIndex: i + 1, rowData: data[i] };
          }
        }
        return null;
      }

      function nowISO()     { return Utilities.formatDate(new Date(), 'Europe/Sofia', "yyyy-MM-dd'T'HH:mm:ss.SSSXXX"); }
      function generateId() { return 'F' + Utilities.getUuid().replace(/-/g,'').slice(0,8).toUpperCase(); }

      function normaliseDate(val) {
        if (!val) return '';
        if (val instanceof Date) return Utilities.formatDate(val, 'Europe/Sofia', "yyyy-MM-dd'T'HH:mm:ss.SSSXXX");
        return String(val);
      }

      // ── PERF (v3.29.0-sec2): fast JSON parse with cached result detection ──
      // safeParseJSON is called ~6 times per row in rowToObject/rowToObjectLean_.
      // For 2000-row sheets that's 12 000 calls per execution. The try/catch in
      // JSON.parse is the dominant cost. This version:
      //   1. Returns already-parsed objects/arrays immediately (no-op).
      //   2. Returns empty-string / null / undefined immediately.
      //   3. Only attempts JSON.parse for actual non-empty strings.
      function safeParseJSON(raw, fallback) {
        // Fast path: already parsed by CacheService or previous call
        if (raw === null || raw === undefined || raw === '') return fallback;
        if (typeof raw === 'object') return raw; // already parsed (Array or Object)
        if (typeof raw !== 'string') return fallback;
        var s = raw;
        // Skip empty/blank strings without trim() when possible
        if (s.charAt(0) === ' ' || s.charAt(s.length - 1) === ' ') s = s.trim();
        if (!s || s === '""') return fallback;
        // Fast heuristic: if first char isn't {, [, or ", it's not JSON
        var c0 = s.charAt(0);
        if (c0 !== '{' && c0 !== '[' && c0 !== '"') return fallback;
        try { return JSON.parse(s); } catch (_) { return fallback; }
      }

      function xmlEscape_(value) {
        return String(value == null ? '' : value).replace(_RE_XML_ENTITY, _xmlEscapeReplacer_);
      }

      // ============================================================
      //  DRIVE – ПОДПИСАНИ ДОКУМЕНТИ
      // ============================================================

      /**
       * Get or create the "Подписани документи" (Signed Docs) folder
       * inside the competition folder or root DRIVE_FOLDER_ID.
