      // ── L3: SWR last-good slot (single overwriting slot per action+role) ──
      // Distinct from the version-keyed shadow cache: this slot is intentionally
      // version-agnostic and always overwrites, so it survives BOTH a CacheService
      // eviction AND a `touchDataVersion_()` bump that would invalidate the shadow.
      // Used to satisfy `_swr:true` callers that prefer "instantly stale" over
      // "spinner during cold compute". The client revalidates in background.
      // Storage: PropertiesService under prefix 'lg:'+actionKey+':'+role+':h/c0..N'.
      function _lastGoodLoad_(actionKey, role) {
        try {
          var props = _scriptProps_().getProperties();
          var headKey = 'lg:' + actionKey + ':' + role + ':h';
          var head = props[headKey];
          if (!head) return null;
          var meta; try { meta = JSON.parse(head); } catch (_) { return null; }
          if (!meta || !meta.n || meta.n > _SHADOW_MAX_CHUNKS) return null;
          var parts = new Array(meta.n);
          for (var i = 0; i < meta.n; i++) {
            var v = props['lg:' + actionKey + ':' + role + ':c' + i];
            if (v == null) return null;
            parts[i] = v;
