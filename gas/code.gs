      // ============================================================
      //  GOOGLE-STYLE 2FA (per-action verification, e.g. submitForm)
      //  Codes are stored in CacheService (5 min TTL), keyed by
      //  scope+email+actionRef. Format mirrors Google SMS:
      //      "G-123456 is your Google verification code."
      // ============================================================
      var OTP_TTL_SECONDS    = 5 * 60;     // 5 minutes
      var OTP_RESEND_COOLDOWN_S = 30;       // throttle resends
      var OTP_MAX_ATTEMPTS   = 5;
      var OTP_CACHE_PREFIX   = '2FA::';

      function _otpKey_(scope, email, ref) {
        return OTP_CACHE_PREFIX + String(scope || 'default') + '::' +
              String(email || '').toLowerCase().trim() + '::' +
              String(ref || '');
      }

      function _otpGenerateCode_() {
        // 6 digit numeric, leading zeros preserved
        var n = Math.floor(Math.random() * 1000000);
        var s = String(n);
        while (s.length < 6) s = '0' + s;
        return s;
      }

      function _otpHash_(code, salt) {
        try {
          var raw = Utilities.computeDigest(
            Utilities.DigestAlgorithm.SHA_256,
            String(salt || '') + '|' + String(code || ''),
            Utilities.Charset.UTF_8
          );
          return raw.map(function (b) {
            var v = (b < 0 ? b + 256 : b).toString(16);
            return v.length === 1 ? '0' + v : v;
          }).join('');
        } catch (_) {
          // Fallback (should never happen on Apps Script)
          return String(salt || '') + ':' + String(code || '');
        }
      }

