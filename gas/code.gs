        var cacheKey = '_gs_' + sheetName;
        if (_sheetCache[cacheKey]) return _sheetCache[cacheKey];
        var ss = _getCachedSpreadsheet();
        var sheet = ss.getSheetByName(sheetName);
        if (!sheet) {
          sheet = ss.insertSheet(sheetName);
          if (headers && Array.isArray(headers) && headers.length > 0) {
            sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
            sheet.setFrozenRows(1);
            sheet.getRange(1, 1, 1, headers.length)
              .setBackground('#7B0000').setFontColor('#ffffff').setFontWeight('bold');
          }
        }
        _sheetCache[cacheKey] = sheet;
        return sheet;
      }

      function getSheet() {
        if (_sheetCache[SHEET_NAME]) return _sheetCache[SHEET_NAME];
        var ss    = _getCachedSpreadsheet();
        var sheet = ss.getSheetByName(SHEET_NAME);

        if (!sheet) {
          sheet = ss.insertSheet(SHEET_NAME);
          sheet.getRange(1, 1, 1, TOTAL_COLS).setValues([EXPECTED_HEADERS]);
          sheet.setFrozenRows(1);
          sheet.getRange(1, 1, 1, TOTAL_COLS)
            .setBackground('#7B0000').setFontColor('#ffffff').setFontWeight('bold');
          sheet.setColumnWidth(COL.ID, 100);
          sheet.setColumnWidth(COL.TITLE, 250);
          sheet.setColumnWidth(COL.DESCRIPTION, 300);
          sheet.setColumnWidth(COL.FILE_IDS, 200);
          sheet.setColumnWidth(COL.ATTACHED_DOCS, 200);
          sheet.setColumnWidth(COL.HISTORY, 300);
          sheet.setColumnWidth(COL.SIGNATURE, 120);
          sheet.setColumnWidth(COL.SIGNATURE_ADMIN, 120);
        } else {
          // Repair headers if columns were manually deleted or reordered
          try { repairSheetHeaders_(sheet, EXPECTED_HEADERS, TOTAL_COLS); } catch (repairErr) {
            console.warn('Applications header repair: ' + repairErr.message);
          }
        }

        if (sheet.getLastColumn() < TOTAL_COLS) {
          var lock = LockService.getScriptLock();
          var hasLock = false;
          try { lock.waitLock(10000); hasLock = true; } catch (_) {}
          try {
            var lastCol = sheet.getLastColumn();
            if (lastCol < TOTAL_COLS) {
              var headerRow = sheet.getRange(1, 1, 1, lastCol).getValues()[0];
              var headerMap = {};
              headerRow.forEach(function(h, i) { if (h) headerMap[String(h).trim()] = i + 1; });

              if (!headerMap['AttachedDocs']) {
                var insertAfter = headerMap['FileIds'] || 12;
                sheet.insertColumnAfter(insertAfter);
                var colPos = insertAfter + 1;
                sheet.getRange(1, colPos).setValue('AttachedDocs');
                sheet.setColumnWidth(colPos, 200);
                var dataRows = sheet.getLastRow() - 1;
                if (dataRows > 0) {
                  var blanks = [];
                  for (var r = 0; r < dataRows; r++) blanks.push(['[]']);
                  sheet.getRange(2, colPos, dataRows, 1).setValues(blanks);
                }
                lastCol = sheet.getLastColumn();
              }

              var currentLast = sheet.getLastColumn();
              var maxCols = sheet.getMaxColumns();
              if (maxCols < TOTAL_COLS) {
                sheet.insertColumnsAfter(maxCols, TOTAL_COLS - maxCols);
              }
              for (var c = currentLast + 1; c <= TOTAL_COLS; c++) {
                sheet.getRange(1, c).setValue(EXPECTED_HEADERS[c - 1] || '');
                sheet.setColumnWidth(c, 120);
              }
            }
          } finally {
            if (hasLock) {
              try { lock.releaseLock(); } catch (_) {}
            }
          }
        }

        protectManagedSheet_(sheet, 'ERP Applications — редакция само през системата');
        _sheetCache[SHEET_NAME] = sheet;
        return sheet;
      }

