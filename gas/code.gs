        if (!_isMySQLHealthy_()) {
          console.debug('[MySQL] Skipping ' + action + ' — MySQL is unhealthy (circuit breaker).');
          return null;
        }
        // v12.26.0: Try SQL service action first (richer data, less processing)
        var sqlAction = _SQL_SERVICE_ACTION_MAP[action] || action;
        var isAdmin = body && (body.isAdmin || body.isadmin);
        // v12.26.1-perf: Reduced timeouts — admin 2s, user 3s
        var timeout = isAdmin ? 2 : 3;
        var result = _readFromMySQL_(sqlAction, body, { timeout: timeout });
        // If SQL service returned data, use it directly
        if (result && result.success && result._source === 'sql') {
