      // ============================================================
      //  КЛЮЧОВ ФИКС ЗА СТАТУСИ (ОДОБРЯВАНЕ / ОТХВЪРЛЯНЕ)
      // ============================================================
      function updateStatus(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          var userId = auth.userId;
          var isAdmin = auth.isAdmin;

          if (!isAdmin) {
            return {
              success: false,
              error: 'Отказан достъп: Изискват се администраторски права. (Получен ID: ' + (userId || 'празно') + ')'
            };
          }

          var sheet = getSheet();
          var found = findRowByID(sheet, body.id);
          if (!found) return { success: false, error: 'Заявлението не е намерено: ' + body.id };

          var rowIndex  = found.rowIndex;
          var rowData   = found.rowData;
          var newStatus = body.status;
          var currentStatus = String(rowData[COL.STATUS - 1] || 'draft').trim();

          // ── Proposal state machine: enforce valid transitions per BPMN workflow ──
          // Canonical pipeline: review → scoring → ranking → AS proposal → AS approval
          //                     → contracting → signing → activation (auto-creates project)
          var PROPOSAL_TRANSITIONS = {
            'draft':                ['submitted'],
            'submitted':            ['admin_review','admin_passed','returned','rejected','needs_correction','eligible','ineligible'],
            'admin_review':         ['admin_passed','returned','needs_correction','eligible','ineligible','rejected'],
            'returned':             ['draft','resubmitted','ineligible'],
            'needs_correction':     ['resubmitted','ineligible'],
            'resubmitted':          ['admin_review','admin_passed','eligible','ineligible','returned','needs_correction','rejected'],
            'admin_passed':         ['eligible','ineligible','in_review','returned'],
            'eligible':             ['in_review','reviewer_assignment','rejected'],
            'ineligible':           ['draft','rejected'],
            'reviewer_assignment':  ['in_review'],
            'in_review':            ['reviewed','returned'],
            'reviewed':             ['scored','returned'],
            'scored':               ['ranked','rejected'],
            // Ranking → ЦКК proposes → AS funding decision → AS final approval (signed)
            'ranked':               ['proposed_for_funding','rejected'],
            'proposed_for_funding': ['approved_for_funding','rejected'],
            'approved_for_funding': ['approved','rejected'],
            // Approved → contracting → signing → contracted (triggers auto-activation)
            'approved':             ['contracting','rejected'],
            'contracting':          ['contract_signed','rejected'],
            'contract_signed':      ['contracted'],
            // 'contracted' auto-creates the active Projects row and flips status to 'active'
            'contracted':           ['active'],
            // Rejected is a TERMINAL state for non-admins. Admins wishing to
            // reset a proposal must use a dedicated admin override (forceTransition=true)
            // so the audit trail explicitly records the unusual reset.
            'rejected':             [],
            'active':               []
          };
          var VALID = Object.keys(PROPOSAL_TRANSITIONS);
          if (VALID.indexOf(newStatus) === -1) return { success: false, error: 'Невалиден статус: ' + newStatus };

          // ── Forward-cascade pipeline (single source of truth for "skip-ahead" requests) ──
          // If the requested newStatus is downstream of currentStatus on this pipeline,
          // walk every intermediate stage so PROPOSAL_TRANSITIONS rules stay intact and
          // every step is recorded in history. Off-pipeline transitions still fall through
          // to the strict allowedNext check below.
          var FORWARD_PIPELINE = [
            'draft','submitted','admin_review','admin_passed','eligible',
            'reviewer_assignment','in_review','reviewed','scored','ranked',
            'proposed_for_funding','approved_for_funding','approved',
            'contracting','contract_signed','contracted','active'
          ];
          var _cascadeChain = [];
          var _curIdx = FORWARD_PIPELINE.indexOf(currentStatus);
          var _tgtIdx = FORWARD_PIPELINE.indexOf(newStatus);
          if (_curIdx >= 0 && _tgtIdx > _curIdx + 1) {
            // Build the intermediate chain; verify each hop is in PROPOSAL_TRANSITIONS
            var _walkOk = true;
            var _prev = currentStatus;
            for (var _w = _curIdx + 1; _w <= _tgtIdx; _w++) {
              var _next = FORWARD_PIPELINE[_w];
              var _allowed = PROPOSAL_TRANSITIONS[_prev] || [];
              if (_allowed.indexOf(_next) === -1) { _walkOk = false; break; }
              _cascadeChain.push(_next);
              _prev = _next;
            }
            if (!_walkOk) _cascadeChain = []; // bail out — fall through to strict check
          }

          // Enforce transition rules (admin can override with body.forceTransition = true for edge cases)
          var allowedNext = PROPOSAL_TRANSITIONS[currentStatus] || [];
          if (_cascadeChain.length === 0 && allowedNext.indexOf(newStatus) === -1 && !body.forceTransition) {
            return { success: false, error: 'Невалиден преход: ' + currentStatus + ' → ' + newStatus + '. Допустими: ' + (allowedNext.join(', ') || 'няма') };
          }

          if (newStatus === 'approved') {
