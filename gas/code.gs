      /**
       * Data Cache System - Uses Properties Service for fast retrieval
       * Cache keys: 'CACHE_COMPETITIONS', 'CACHE_REVIEWERS', 'CACHE_FORMS_META'
       */
      function getCacheTimestamp(key) {
        var props = _scriptProps_();
        var raw = props.getProperty('TS_' + key) || '0';
        var numeric = Number(raw);
        if (!isNaN(numeric) && numeric > 0) return numeric;
        var parsed = new Date(String(raw)).getTime();
        return isNaN(parsed) ? 0 : parsed;
      }

      function setCacheTimestamp(key) {
        var props = _scriptProps_();
        props.setProperty('TS_' + key, String(Date.now()));
      }

      function invalidateCache(key) {
        var props = _scriptProps_();
        props.deleteProperty('TS_' + key);
        props.deleteProperty('CACHE_' + key);
        // Bust per-execution memos when the underlying data changes
        if (key === 'COMPETITIONS') { _bustCompMemo_(); }
      }

      function isCacheFresh_(key, ttlMs) {
        var ts = getCacheTimestamp(key);
        if (!ts) return false;
        return (Date.now() - ts) < (ttlMs || 300000);
      }

      function getDataVersions_() {
        // Per-execution memo (cheapest layer). getDataVersions_ is called from
        // every cached read handler (getInitialData, getForms, listDocuments,
        // getCompetitions, …) plus from getDataChangeStream. In a single
        // batchApi execution that is 5–10 calls — each previously incurring a
        // CacheService bridge crossing + JSON.parse round-trip. Memoised here
        // and busted by touchDataVersion_/_batchTouchDataVersions_.
        if (_dvExecMemo_) return _dvExecMemo_;
        // Hot-path: served by CacheService blob (4s TTL) so high-frequency pollers
        // (getDataChangeStream every 20–30s × N concurrent users) don't hammer the
        // PropertiesService quota with 4 separate getProperty round-trips per call.
        try {
          var sc = _scriptCache_();
          var blob = sc.get('DV_BLOB');
          if (blob) {
            var parsed = JSON.parse(blob);
            if (parsed && typeof parsed === 'object') { _dvExecMemo_ = parsed; return parsed; }
          }
        } catch (_) {}
        // Single getProperties() replaces 5 individual getProperty round-trips
        var _dvAll_ = {};
        try { _dvAll_ = _scriptProps_().getProperties(); } catch (_) {}
        var out = {
          applications: Number(_dvAll_['DATA_VER_APPLICATIONS'] || 0),
          competitions: Number(_dvAll_['DATA_VER_COMPETITIONS'] || 0),
          reviewers: Number(_dvAll_['DATA_VER_REVIEWERS'] || 0),
          projects: Number(_dvAll_['DATA_VER_PROJECTS'] || 0),
          messages: Number(_dvAll_['DATA_VER_MESSAGES'] || 0),
          system: Number(_dvAll_['DATA_VER_SYSTEM'] || 0)
        };
        try { _scriptCache_().put('DV_BLOB', JSON.stringify(out), PERF_MODE ? 3600 : 4); } catch (_) {}
        _dvExecMemo_ = out;
        return out;
      }

      // Per-execution memo for getDataVersions_; busted by any version touch.
      var _dvExecMemo_ = null;

      // ── Conditional-fetch (notModified) helper ─────────────────────────────
      // When the client passes `_dv:{applications,competitions,reviewers,system}`
      // in the request body and EVERY listed scope matches the current server
      // versions, the handler can short-circuit with a tiny payload. The frontend
      // then re-uses its existing in-memory + persisted cache (the SWR layer in
      // js/utils.js drops `notModified:true` responses through to the cached
      // value). Saves 30–90 KB JSON serialisation + transport per polled read
      // in the steady-state case (the dominant load pattern after warm-up).
      function _ifVersionsMatch_(body, scopes) {
        if (!body || !body._dv || typeof body._dv !== 'object') return null;
        var clientDv = body._dv;
        var serverDv = getDataVersions_();
        var checks = scopes && scopes.length ? scopes : ['applications','competitions','reviewers','projects','system'];
        for (var i = 0; i < checks.length; i++) {
          var k = checks[i];
          // If the client doesn't know about a scope it cares about, don't short-circuit.
          if (clientDv[k] === undefined || clientDv[k] === null) return null;
          if (Number(clientDv[k] || 0) !== Number(serverDv[k] || 0)) return null;
        }
        return { success: true, notModified: true, versions: serverDv };
      }

      // ── Batched data-version bump ─────────────────────────────────────────────
      // Replaces N sequential touchDataVersion_() calls with a single
      // setProperties() round-trip.  Called from postProcessMutation_ for
      // any mutation that touches more than one version scope.
      function _batchTouchDataVersions_(scopes) {
        if (!scopes || !scopes.length) return;
        var now = String(Date.now());
        var updates = {};
        for (var _i = 0; _i < scopes.length; _i++) {
          updates['DATA_VER_' + scopes[_i].toUpperCase()] = now;
        }
        try { _scriptProps_().setProperties(updates, false); } catch (_e) {
          // Graceful fallback to individual writes on setProperties failure
          for (var _j = 0; _j < scopes.length; _j++) {
            try { _scriptProps_().setProperty('DATA_VER_' + scopes[_j].toUpperCase(), now); } catch (_) {}
          }
        }
        try { _scriptCache_().remove('DV_BLOB'); } catch (_) {}
        _dvExecMemo_ = null; // bust per-execution memo so next read picks up the bump
        for (var _k = 0; _k < scopes.length; _k++) {
          var _s = scopes[_k].toLowerCase();
          try { _scriptCache_().put('DV_' + _s, now, 600); } catch (_) {}
          if (_s === 'ministry_reports') { try { _MON_LIST_MEM = null; } catch (_) {} }
          // Bust per-execution memos so post-mutation reads see fresh data
          if (_s === 'competitions') { _bustCompMemo_(); }
          if (_s === 'reviewers')    { _reviewersListMemo_ = null; _reviewersListMemoDv_ = 0;
                                        _reviewerEmailsCache = null; _reviewerProposalsMemo_ = null; }
          if (_s === 'applications') { _appByIdMemo_ = null; _appByIdDv_ = 0; }
        }
      }
      function touchDataVersion_(scope) {
        var s = String(scope || '').toLowerCase();
        if (!s) return;
        var props = _scriptProps_();
        var now = Date.now();
        props.setProperty('DATA_VER_' + s.toUpperCase(), String(now));
        // Invalidate the hot blob so next poll picks up the bump immediately
        try { _scriptCache_().remove('DV_BLOB'); } catch (_) {}
        _dvExecMemo_ = null; // bust per-execution memo so post-mutation reads see the bump
        // Per-scope memo busting — keep in-memory caches consistent after writes
        if (s === 'competitions') { _bustCompMemo_(); }
        if (s === 'reviewers')    { _reviewersListMemo_ = null; _reviewersListMemoDv_ = 0;
                                    _reviewerEmailsCache = null; _reviewerProposalsMemo_ = null; }
        if (s === 'applications') { _appByIdMemo_ = null; _appByIdDv_ = 0; }
        // Per-scope CacheService stamp + warm-process memo flush (used by
        // _monLoadAllRowsCached_ and similar list-cache builders).
        try { _scriptCache_().put('DV_' + s, String(now), 600); } catch (_) {}
        if (s === 'ministry_reports') { try { _MON_LIST_MEM = null; } catch (_) {} }
      }

      /**
       * PRIMARY: Sheet → SECONDARY: Drive competition.json → LAST RESORT: stale cache.
       *
       * The Competitions Google Sheet is the canonical source for metadata (always
       * accessible, fast).  Drive subfolders (DRIVE_FOLDER_ID/{id} - {name}/) are
       * used for FILE STORAGE (applications, documents) and optionally carry a
       * competition.json mirror for external tooling – but they are NOT the primary
       * read source.
       *
       * When admin creates a competition via createCompetition(), the Sheet row is
       * written first and the Drive folder is created synchronously.  Users then read
       * from the Sheet and immediately see the new competition.
       */
      // ── Per-execution memo for getOrCacheCompetitions ────────────────────
      // getOrCacheCompetitions is called by getDashboardContext, getCompetitions,
      // getPublicCompetitions, getReviewerForms, and getCompetitionPanel — all
      // potentially within the same GAS execution. Without this memo each call
      // incurs a CacheService bridge crossing even when the result is fresh.
      // Busted by forceRefresh=true (which also overwrites the CacheService blob).
      var _compExecMemo_ = null;

      function getOrCacheCompetitions(forceRefresh) {
        // Per-execution memo — fastest path (<1 ms, zero bridge crossings).
        if (!forceRefresh && _compExecMemo_) return _compExecMemo_;
        // Use CacheService (100KB limit, faster) instead of ScriptProperties (9KB limit)
        var cache = _scriptCache_();
        if (!forceRefresh) {
          try {
            var cached = cache.get('COMPETITIONS_DATA');
            if (cached) {
              var parsed = safeParseJSON(cached, null);
              if (parsed && parsed.length > 0) { _compExecMemo_ = parsed; return parsed; }
            }
          } catch (e) { console.warn('Cache read error: ' + e.message); }
        }

        var competitions = [];
        var sheetReadFailed = false;

        // ── PRIMARY: Competitions Sheet (authoritative source) ───────────────────
        try {
          var sheet = getCompetitionsSheet();
          var data  = _cachedSheetData_(sheet);
          for (var i = 1; i < data.length; i++) {
            var row = data[i];
            var id  = String(row[COMP_COL.ID - 1] || '').trim();
            if (!id) continue;
            var dl = normaliseDate(row[COMP_COL.DEADLINE - 1]);
            competitions.push({
              id             : id,
              name           : String(row[COMP_COL.NAME          - 1] || ''),
              deadline       : dl,
              dateEnd        : dl,
              status         : normalizeCompetitionStatus_(row[COMP_COL.STATUS - 1]),
              created        : normaliseDate(row[COMP_COL.CREATED - 1]),
              description    : String(row[COMP_COL.DESCRIPTION    - 1] || ''),
              folderId       : String(row[COMP_COL.FOLDER_ID      - 1] || ''),
              callType       : String(row[COMP_COL.CALL_TYPE      - 1] || ''),
              year           : String(row[COMP_COL.YEAR           - 1] || ''),
              directions     : String(row[COMP_COL.DIRECTIONS     - 1] || ''),
              evalCriteria   : String(row[COMP_COL.EVAL_CRITERIA  - 1] || ''),
              budgetByDirection: String(row[COMP_COL.BUDGET_BY_DIR - 1] || ''),
              openDate       : normaliseDate(row[COMP_COL.OPEN_DATE - 1]),
              templates      : String(row[COMP_COL.TEMPLATES      - 1] || '')
            });
          }
        } catch (sheetErr) {
          sheetReadFailed = true;
          logError('getOrCacheCompetitions_sheet', sheetErr, {});
          console.warn('Sheet read failed, trying Drive: ' + sheetErr.message);
        }

        // When the Sheet loads successfully, an empty result is authoritative.
        // Do NOT revive deleted rows from Drive mirrors or stale cache.
        if (sheetReadFailed && competitions.length === 0) {
          try {
            var seenIds    = {};
            var mainFolder = DriveApp.getFolderById(DRIVE_FOLDER_ID);
            var subFolders = mainFolder.getFolders();
            while (subFolders.hasNext()) {
              var sub        = subFolders.next();
              var folderName = sub.getName();
              if (!folderName || folderName.startsWith('_')) continue;
              try {
                var jsonFiles = sub.getFilesByName('competition.json');
                if (!jsonFiles.hasNext()) continue;
                var meta = JSON.parse(jsonFiles.next().getBlob().getDataAsString());
                if (!meta || !meta.id || !meta.name || seenIds[meta.id]) continue;
                seenIds[meta.id] = true;
                competitions.push({
                  id         : String(meta.id),
                  name       : String(meta.name        || ''),
                  deadline   : String(meta.deadline    || meta.dateEnd || ''),
                  dateEnd    : String(meta.dateEnd      || meta.deadline || ''),
                  status     : normalizeCompetitionStatus_(meta.status),
                  created    : String(meta.created      || ''),
                  description: String(meta.description  || ''),
                  folderId   : String(meta.folderId     || sub.getId())
                });
              } catch (fe) {
                console.warn('Drive folder ' + folderName + ': ' + fe.message);
              }
            }
          } catch (driveErr) {
            console.warn('Drive scan failed: ' + driveErr.message);
          }
        }

        // ── LAST RESORT: stale cache only when the Sheet itself failed ───────────
        if (sheetReadFailed && competitions.length === 0) {
          try {
            var stale = _scriptProps_().getProperty('CACHE_COMPETITIONS');
            if (stale) {
              var staleParsed = safeParseJSON(stale, null);
              if (staleParsed && staleParsed.length > 0) {
                console.info('Returning stale cache (' + staleParsed.length + ' competitions).');
                return staleParsed;
              }
            }
          } catch (_) {}
        }

        competitions.sort(function(a, b) {
          return (new Date(b.created || 0).getTime() || 0) - (new Date(a.created || 0).getTime() || 0);
        });

        try {
          var jsonStr = JSON.stringify(competitions);
          cache.put('COMPETITIONS_DATA', jsonStr, PERF_MODE ? 3600 : 600); // PERF_MODE: 60 min TTL — version-keyed, safe; reduces CacheService crossings
          // Keep ScriptProperties as stale fallback
          try { _scriptProps_().setProperty('CACHE_COMPETITIONS', jsonStr); } catch (_) {}
          setCacheTimestamp('COMPETITIONS');
        } catch (e) { console.warn('Cache write failed: ' + e.message); }

        // Populate per-execution memo so subsequent calls in the same
        // execution (getDashboardContext, getReviewerForms, …) are free.
        _compExecMemo_ = competitions;
        return competitions;
      }

      /**
       * Backfil a competition that exists only in the Sheet into Drive.
       * Creates a folder with competition.json so it becomes visible in the Drive-based read.
       */
      function backfillCompetitionToDrive_(comp) {
        if (!comp || !comp.id || !comp.name) return;
        try {
          var mainFolder = DriveApp.getFolderById(DRIVE_FOLDER_ID);
          // Check if a folder for this competition already exists
          var existing = mainFolder.getFoldersByName(comp.id + ' - ' + comp.name);
          var compFolder;
          if (existing.hasNext()) {
            compFolder = existing.next();
          } else {
            compFolder = mainFolder.createFolder(comp.id + ' - ' + comp.name);
            compFolder.createFolder('Applications');
            compFolder.createFolder('Reviews');
            compFolder.createFolder('Documents');
          }
          var folderId = compFolder.getId();
          // Write competition.json
          var metadata = {
            id: comp.id,
            name: comp.name,
            deadline: comp.deadline,
            dateEnd: comp.dateEnd || comp.deadline,
            status: comp.status,
            created: comp.created,
            description: comp.description,
            folderId: folderId
          };
          var jsonFiles = compFolder.getFilesByName('competition.json');
          if (jsonFiles.hasNext()) {
            jsonFiles.next().setContent(JSON.stringify(metadata, null, 2));
          } else {
            compFolder.createFile('competition.json', JSON.stringify(metadata, null, 2), MimeType.PLAIN_TEXT);
          }
          // Update Sheet folderId if it was empty
          if (!comp.folderId) {
            try {
              var sheet = getCompetitionsSheet();
              var sheetData = sheet.getDataRange().getValues();
              for (var i = 1; i < sheetData.length; i++) {
                if (String(sheetData[i][COMP_COL.ID - 1]).trim() === comp.id) {
                  sheet.getRange(i + 1, COMP_COL.FOLDER_ID).setValue(folderId);
                  break;
                }
              }
            } catch (sheetUpdateErr) {
              console.warn('Could not update folderId in Sheet: ' + sheetUpdateErr.message);
            }
          }
        } catch (e) {
          console.warn('backfillCompetitionToDrive_ failed for ' + comp.id + ': ' + e.message);
        }
      }

      // ============================================================
      //  DRIVE-BASED COMPETITIONS FEED
      // ============================================================

      /**
       * Publishes a _competitions_feed.json file to the root Drive folder and
       * ensures every competition has an up-to-date competition.json in its folder.
       * Called after any competition mutation (create/update/delete).
       */
      function publishCompetitionsFeed_() {
        try {
          var competitions = getOrCacheCompetitions(true); // force fresh read
          var feed = {
            updated: nowISO(),
            total: competitions.length,
            competitions: competitions
          };
          var feedJson = JSON.stringify(feed, null, 2);
          var folder = DriveApp.getFolderById(DRIVE_FOLDER_ID);

          // Write/overwrite root feed file
          var existing = folder.getFilesByName('_competitions_feed.json');
          if (existing.hasNext()) {
            existing.next().setContent(feedJson);
          } else {
            folder.createFile('_competitions_feed.json', feedJson, MimeType.PLAIN_TEXT);
          }
        } catch (e) {
          console.warn('publishCompetitionsFeed_ failed: ' + e.message);
        }
      }

      /**
       * Public endpoint: reads competitions directly from Drive folder structure.
       * Scans all subfolders of DRIVE_FOLDER_ID for competition.json files.
       * Falls back to Sheet read if Drive is unavailable.
       * No cache reliance — always fresh.
       */
      function getCompetitionsFeed(body) {
        try {
          body = body || {};
          // notModified short-circuit — feed changes when competitions change.
          var _nm = _ifVersionsMatch_(body, ['competitions']);
          if (_nm) return _nm;
          var auth = resolveAuthContext(body);
          var isAdmin = auth.isAdmin;
          var forceRefresh = body.forceRefresh === true || body.forceRefresh === 'true';

          // Per-execution memo: feed is the same as the non-admin filtered subset
          // of getCompetitions. Collapse N calls in one execution into 1 map.
          var _feedDv = getDataVersions_().competitions;
          var _feedKey = 'feed:' + (isAdmin ? 'a' : 'u') + ':' + _feedDv;
          if (!forceRefresh && _compMappedMemo_[_feedKey]) return _compMappedMemo_[_feedKey];

          // Use the shared competitions cache (respects per-execution memo).
          var competitions = getOrCacheCompetitions(forceRefresh);

          // Filter for non-admin users
          var result = [];
          for (var i = 0; i < competitions.length; i++) {
            var c = competitions[i];
            if (!isAdmin && !shouldExposeCompetitionToApplicant_(c)) continue;
            result.push({
              id: String(c.id || ''),
              name: String(c.name || ''),
              deadline: String(c.deadline || c.dateEnd || ''),
              dateEnd: String(c.dateEnd || c.deadline || ''),
              status: normalizeCompetitionStatus_(c.status),
              created: String(c.created || ''),
              description: String(c.description || ''),
              folderId: String(c.folderId || '')
            });
          }

          var response = {
            success: true,
            competitions: result,
            meta: { total: result.length, isAdmin: isAdmin }
          };
          _compMappedMemo_[_feedKey] = response;
          return response;
        } catch (err) {
          logError('getCompetitionsFeed', err, body);
          return { success: false, error: 'getCompetitionsFeed failed: ' + err.message };
        }
      }

      /**
       * Admin endpoint: backfills ALL Sheet competitions into Drive folders.
       * Run this once after upgrade to ensure all existing competitions get Drive folders.
       */
      function syncCompetitionsToDrive(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin) return { success: false, error: 'Отказан достъп: само администратори.' };

          var sheet = getCompetitionsSheet();
          var data = sheet.getDataRange().getValues();
          var synced = 0;
          var errors = [];

          for (var i = 1; i < data.length; i++) {
            var row = data[i];
            var id = String(row[COMP_COL.ID - 1]).trim();
            if (!id) continue;
            var deadlineVal = normaliseDate(row[COMP_COL.DEADLINE - 1]);
            var comp = {
              id: id,
              name: String(row[COMP_COL.NAME - 1] || ''),
              deadline: deadlineVal,
              dateEnd: deadlineVal,
              status: normalizeCompetitionStatus_(row[COMP_COL.STATUS - 1]),
              created: normaliseDate(row[COMP_COL.CREATED - 1]),
              description: String(row[COMP_COL.DESCRIPTION - 1] || ''),
              folderId: String(row[COMP_COL.FOLDER_ID - 1] || '')
            };
            try {
              backfillCompetitionToDrive_(comp);
              synced++;
            } catch (e) {
              errors.push(id + ': ' + e.message);
            }
          }

          // Invalidate cache and publish feed
          try { invalidateCache('COMPETITIONS'); } catch (_) {}
          try { publishCompetitionsFeed_(); } catch (_) {}

          return {
            success: true,
            synced: synced,
            errors: errors,
            message: synced + ' конкурса синхронизирани с Drive.'
          };
        } catch (err) {
          logError('syncCompetitionsToDrive', err, body);
          return { success: false, error: 'syncCompetitionsToDrive failed: ' + err.message };
        }
      }

      function getOrCacheReviewers(competitionId, forceRefresh) {
        var cacheKey = 'REVIEWERS_' + (competitionId || 'ALL');
        if (!forceRefresh && isCacheFresh_(cacheKey, 300000)) {
