          var _CANONICAL = ['ФНИ','ПНИ','ДНП','НПФ'];
          var folders = [];
          var seenNames = {};
          try {
            var rootFolder = DriveApp.getFolderById(OFFICIAL_DOCS_FOLDER_ID);
            var subs = rootFolder.getFolders();
            while (subs.hasNext()) {
              var sub = subs.next();
              var subName = sub.getName();
              // Skip duplicate names (Drive allows same-named folders)
              if (seenNames[subName]) continue;
              seenNames[subName] = true;
              // PERF: skip per-folder file counting — frontend uses listDocuments for counts
              folders.push({
                id: sub.getId(),
                name: subName,
                fileCount: 0
              });
            }
          } catch (e) {
            return { success: false, error: 'Не може да се достъпи библиотеката: ' + e.message, folders: [] };
          }

          // Sort: canonical folders first in fixed order, then others alphabetically
          var canonicals = [];
          var others = [];
          for (var i = 0; i < folders.length; i++) {
            var f = folders[i];
            if (_CANONICAL.indexOf(f.name) !== -1) {
              canonicals.push(f);
            } else {
              others.push(f);
            }
          }
          canonicals.sort(function(a,b){
            return _CANONICAL.indexOf(a.name) - _CANONICAL.indexOf(b.name);
          });
          others.sort(function(a,b){ return a.name.localeCompare(b.name); });
          folders = canonicals.concat(others);

          var result = { success: true, folders: folders, rootFileCount: 0 };
          _libraryFoldersCache_ = result;
          // ── Write to ScriptCache (1h TTL, version-keyed) ──
          try { if (sc && cacheKey) sc.put(cacheKey, JSON.stringify(result), 3600); } catch (_) {}
          return result;
        } catch (err) {
          try { logError('listLibraryFolders', err, body); } catch (_) {}
          return { success: false, error: 'listLibraryFolders: ' + err.message, folders: [] };
        }
      }
      var _libraryFoldersCache_ = null; // per-execution cache

      /**
       * _ensureLibrarySubfolders_()
       * Idempotent — creates ФНИ, ПНИ, ДНП, НПФ subfolders inside
       * OFFICIAL_DOCS_FOLDER_ID if they don't already exist.
       * Called by listDocuments (all users) so the folder structure
       * is always present for non-admin browsing.
       * Guarded by _subfoldersEnsured_ flag — runs at most once per execution
       * to prevent duplicate folder creation when called from warmup +
       * listLibraryFolders + listDocuments in the same request.
       */
      var _subfoldersEnsured_ = false;
      function _ensureLibrarySubfolders_() {
        if (_subfoldersEnsured_) return;
        _subfoldersEnsured_ = true;
        var _wanted = ['ФНИ', 'ПНИ', 'ДНП', 'НПФ'];
        try {
          var root = DriveApp.getFolderById(OFFICIAL_DOCS_FOLDER_ID);
          for (var i = 0; i < _wanted.length; i++) {
            var name = _wanted[i];
            // Robust duplicate check: iterate ALL subfolders with this name,
            // only create if NONE exist.  This handles the edge case where
            // getFoldersByName() misses a just-created folder within the
            // same execution.
            var existing = root.getFoldersByName(name);
            var found = false;
            while (existing.hasNext()) {
              if (existing.next().getName() === name) { found = true; break; }
            }
            if (!found) {
              root.createFolder(name);
            }
          }
        } catch (e) {
          console.warn('_ensureLibrarySubfolders_: ' + e.message);
          // Reset flag on error so next call can retry
          _subfoldersEnsured_ = false;
        }
      }

      /**
       * _isInsideOfficialDocsFolder_(fileOrFolderId)
       * Returns true if the file/folder is inside OFFICIAL_DOCS_FOLDER_ID or a descendant.
       */
      function _isInsideOfficialDocsFolder_(fileOrFolderId) {
        try {
          if (fileOrFolderId === OFFICIAL_DOCS_FOLDER_ID) return true;
          var parents;
          try {
            // Try DriveApp first
            var f = DriveApp.getFileById(fileOrFolderId);
            parents = f.getParents();
          } catch (_) {
            try {
              var folder = DriveApp.getFolderById(fileOrFolderId);
              parents = folder.getParents();
            } catch (__) {
              return false;
            }
          }
          // Walk ancestors recursively until we hit the root or OFFICIAL_DOCS_FOLDER_ID.
          // Guard: maximum 50 levels to prevent infinite loops on corrupted Drive trees.
          var seen = {};
          seen[fileOrFolderId] = true;
          var queue = [];
          while (parents.hasNext()) { queue.push(parents.next()); }
          var depth = 0;
          while (queue.length > 0 && depth < 50) {
            depth++;
            var p = queue.shift();
            var pid = p.getId();
            if (seen[pid]) continue;
            seen[pid] = true;
            if (pid === OFFICIAL_DOCS_FOLDER_ID) return true;
            try {
              var gp = p.getParents();
              while (gp.hasNext()) { queue.push(gp.next()); }
            } catch (_) {}
          }
          return false;
        } catch (_) {
          return false;
        }
      }

      // ============================================================
      //  EXPORT AUDIT – JSON за финансов одит
      // ============================================================
      /**
       * exportAudit(body)
       *
       * Admin-only endpoint.  Returns a structured JSON payload containing
       * every application record with full audit trail, file manifests,
       * attached official documents, and status history — ready for
       * external financial-audit tooling or archival.
       *
       * Optional body parameters:
       *   statusFilter  – string or array: filter by status(es)
       *   dateFrom      – ISO string: include only records created on/after
       *   dateTo        – ISO string: include only records created on/before
       *   competitionId – string: filter by competition
       *
       * Signatures are deliberately EXCLUDED from the export payload
       * (they are base64 images and can be very large).  The export
       * notes whether a signature exists via boolean flags instead.
       */
      function exportAudit(body) {
        try {
          // ── 1. Auth check ──────────────────────────────────────
          var authCtx  = resolveAuthContext(body);
          var userId   = authCtx.userId;
          var isAdmin  = authCtx.isAdmin;
          if (!isAdmin) {
            return {
              success: false,
              error: 'Отказан достъп: Експортът изисква администраторски права.'
            };
          }

          // ── 2. Read all rows ───────────────────────────────────
          var sheet = getSheet();
          var data  = sheet.getDataRange().getValues();

          // ── 3. Build filter predicates ─────────────────────────
          var statusFilter   = body.statusFilter  || null;
          var dateFrom       = body.dateFrom      ? new Date(body.dateFrom) : null;
          var dateTo         = body.dateTo        ? new Date(body.dateTo)   : null;
          var competitionId  = body.competitionId || null;

          if (statusFilter && typeof statusFilter === 'string') {
            statusFilter = [statusFilter.toLowerCase()];
          } else if (Array.isArray(statusFilter)) {
            statusFilter = statusFilter.map(function(s) { return String(s).toLowerCase(); });
          }

          // ── 4. Iterate rows and build records ──────────────────
          var records   = [];
          var totals    = { total: 0, draft: 0, submitted: 0, approved: 0, rejected: 0, returned: 0 };

          for (var i = 1; i < data.length; i++) {
            var row = data[i];
            var id  = String(row[COL.ID - 1]).trim();
            if (!id) continue;

            var status  = String(row[COL.STATUS - 1] || 'draft').toLowerCase();
            var created = normaliseDate(row[COL.CREATED - 1]);

            // Apply filters
            if (statusFilter && statusFilter.indexOf(status) === -1) continue;
            if (competitionId && String(row[COL.COMPETITION - 1]) !== competitionId) continue;
            if (dateFrom || dateTo) {
              var d = created ? new Date(created) : null;
              if (d) {
                if (dateFrom && d < dateFrom) continue;
                if (dateTo   && d > dateTo)   continue;
              }
            }

            var fileIds      = safeParseJSON(row[COL.FILE_IDS - 1],      []);
            var attachedDocs = safeParseJSON(row[COL.ATTACHED_DOCS - 1], []);
            var history      = safeParseJSON(row[COL.HISTORY - 1],       []);

            // Strip base64 data from file entries (keep metadata only)
            var cleanFiles = fileIds.map(function(f) {
              return {
                fileId      : f.fileId   || '',
                name        : f.name     || '',
                size        : f.size     || '',
                type        : f.type     || '',
                downloadUrl : f.downloadUrl || '',
                created     : f.created  || ''
              };
            });

            var cleanDocs = attachedDocs.map(function(d) {
              return {
                id         : d.id   || '',
                name       : d.name || '',
                folderName : d.folderName || ''
              };
            });

            records.push({
              applicationId   : id,
              applicantEmail  : String(row[COL.USER_EMAIL - 1] || ''),
              applicantName   : String(row[COL.USER_NAME - 1]  || ''),
              competitionId   : String(row[COL.COMPETITION - 1] || ''),
              projectCode     : String(row[COL.PROJECT_CODE - 1] || ''),
              title           : String(row[COL.TITLE - 1]       || ''),
              area            : String(row[COL.AREA - 1]        || ''),
              description     : String(row[COL.DESCRIPTION - 1] || ''),
              status          : status,
              submittedAt     : normaliseDate(row[COL.SUBMITTED - 1]),
              createdAt       : created,
              returnComment   : String(row[COL.RETURN_COMMENT - 1] || ''),
              hasSignature      : !!(row.length >= COL.SIGNATURE      && row[COL.SIGNATURE - 1]),
              hasAdminSignature : !!(row.length >= COL.SIGNATURE_ADMIN && row[COL.SIGNATURE_ADMIN - 1]),
              uploadedFiles   : cleanFiles,
              attachedDocs    : cleanDocs,
              auditTrail      : history
            });

            totals.total++;
            totals[status] = (totals[status] || 0) + 1;
          }

          // ── 5. Build export envelope ───────────────────────────
          var exportMeta = {
            exportedAt     : nowISO(),
            exportedBy     : userId === _SYSTEM_ADMIN_USER ? 'Администратор' : userId,
            systemVersion  : '2.4',
            spreadsheetId  : SPREADSHEET_ID,
            sheetName      : SHEET_NAME,
            filtersApplied : {
              statusFilter  : statusFilter  || 'all',
              dateFrom      : dateFrom  ? Utilities.formatDate(dateFrom, 'Europe/Sofia', "yyyy-MM-dd'T'HH:mm:ss.SSSXXX")  : null,
              dateTo        : dateTo    ? Utilities.formatDate(dateTo, 'Europe/Sofia', "yyyy-MM-dd'T'HH:mm:ss.SSSXXX")    : null,
              competitionId : competitionId || null
            },
            summary        : totals
          };

          var shouldCleanup = body.clearAfterExport === true || body.clearAfterExport === 'true';
          var cleanupSummary = null;
          if (shouldCleanup) {
            cleanupSummary = cleanupExportedData_();
            exportMeta.cleanupAfterExport = cleanupSummary;
          }

          return {
            success : true,
            audit   : {
              meta    : exportMeta,
              records : records
            },
            cleanup : cleanupSummary
          };
        } catch (err) {
          return { success: false, error: 'exportAudit failed: ' + err.message };
        }
      }

      // ============================================================
      //  COMPETITION WORKFLOW HELPERS (Sheets + Drive backbone)
      // ============================================================

      /**
       * Get all applications for a specific competition, with summary stats.
       */
      function getApplicationsByCompetition(body) {
        try {
          var competitionId = String(body.competitionId || '').trim();
          if (!competitionId) return { success: false, error: 'Missing competitionId' };

          var auth = resolveAuthContext(body);
          var isAdmin = auth.isAdmin;
          var requestingUserId = auth.userId;

          var sheet = getSheet();
          // _cachedSheetData_ shares the Applications read with getForms /
          // getCompetitionPanel within the same GAS execution.
          var data = _cachedSheetData_(sheet);
          var apps = [];
          var counts = { total: 0, draft: 0, submitted: 0, admin_passed: 0, in_review: 0, reviewed: 0, approved: 0, rejected: 0, returned: 0, contracted: 0 };

          for (var i = 1; i < data.length; i++) {
            var row = data[i];
            var comp = String(row[COL.COMPETITION - 1] || '').trim();
            if (comp !== competitionId) continue;
            counts.total++;
            var st = String(row[COL.STATUS - 1] || 'draft').toLowerCase();
            if (counts.hasOwnProperty(st)) counts[st]++;
            var rowEmail = String(row[COL.USER_EMAIL - 1] || '').toLowerCase().trim();
            if (isAdmin || (requestingUserId && rowEmail === requestingUserId)) {
              apps.push(rowToObject(row));
            }
          }

          return { success: true, applications: apps, counts: counts };
        } catch (err) {
          logError('getApplicationsByCompetition', err, body);
          return { success: false, error: 'getApplicationsByCompetition failed: ' + err.message };
        }
      }

      function checkCompliance(body) {
        try {
          var auth = resolveAuthContext(body || {});
          if (!auth.isAdmin) return { success: false, error: 'Отказан достъп: Само администратори.' };
          var formId = body.formId;
          if (!formId) return { success: false, error: 'Missing formId' };

          var sheet = getSheet();
          var found = findRowByID(sheet, formId);
          if (!found) return { success: false, error: 'Form not found' };

          var row = found.rowData;
          var projectCode = String(row[COL.PROJECT_CODE - 1] || '').toUpperCase();
          var isFNIorPNI = projectCode === 'ФНИ' || projectCode === 'ПНИ';
          var leaderEmail = String(row[COL.USER_EMAIL - 1]).toLowerCase().trim();
          var teamMembers = safeParseJSON(row[COL.TEAM_MEMBERS - 1], []);

          var issues = [];

          if (isFNIorPNI) {
            // Check leader: only one project per session
            // _cachedSheetData_ shares the Applications read with getForms in the same execution
            var data = _cachedSheetData_(sheet);
            var leaderProjects = 0;
            for (var i = 1; i < data.length; i++) {
              var r = data[i];
              if (String(r[COL.USER_EMAIL - 1]).toLowerCase().trim() === leaderEmail &&
                  String(r[COL.PROJECT_CODE - 1]).toUpperCase() === projectCode &&
                  String(r[COL.STATUS - 1]) !== 'rejected') {
                leaderProjects++;
              }
            }
            if (leaderProjects > 1) {
              issues.push('Ръководителят вече има ' + leaderProjects + ' проекта от тип ' + projectCode + ' в тази сесия.');
            }

            // Check team members: max 2 projects
            teamMembers.forEach(function(member) {
              var memEmail = String(member.email || '').toLowerCase().trim();
              if (!memEmail) return;
              var memProjects = 0;
              for (var i = 1; i < data.length; i++) {
                var r = data[i];
                var mems = safeParseJSON(r[COL.TEAM_MEMBERS - 1], []);
                var hasMember = mems.some(function(m) { return String(m.email || '').toLowerCase().trim() === memEmail; });
                if (hasMember && String(r[COL.PROJECT_CODE - 1]).toUpperCase() === projectCode &&
                    String(r[COL.STATUS - 1]) !== 'rejected') {
                  memProjects++;
                }
              }
              if (memProjects >= 2) {
                issues.push('Членът ' + member.name + ' вече участва в ' + memProjects + ' проекта от тип ' + projectCode + '.');
              }
            });
          }

          return {
            success: true,
            compliant: issues.length === 0,
            issues: issues
          };
        } catch (err) {
          return { success: false, error: 'checkCompliance failed: ' + err.message };
        }
      }

      function assignReviewers(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin) {
            return { success: false, error: 'Отказан достъп: Само администратори' };
          }

          // ── Two-step reviewer approval guard (BPMN Process 4) ──
          // If a CKK caller hits this without going through proposeReviewers/
          // confirmReviewers, redirect them to the proposal flow. Rector & Admin
          // (or callers with _bypassTwoStep) keep direct-assign behaviour.
          if (TWO_STEP_REVIEWER_APPROVAL && auth.role === ROLE_CKK && !body._bypassTwoStep) {
            return proposeReviewers({
              formId: body.formId,
              reviewerEmails: body.reviewers,
              reviewerNames: body.reviewerNames,
              justification: String(body.justification || 'Автоматично пренасочено от assignReviewers'),
              userId: auth.userId, email: auth.userId
            });
          }

          var formId = String(body.formId || '').trim();
          var reviewerEmails = normalizeReviewerEmails_(body.reviewers);
          var allowOverride = body.overrideRules === true || body.overrideRules === 'true';
          if (!formId) return { success: false, error: 'Missing formId' };
          if (reviewerEmails.length === 0) return { success: false, error: 'No reviewers provided' };

          // Optional name map for reviewers not yet in the pool. Frontend sends
          // { "email@x": "Иван Петров" } so we don't have to scrape Google.
          var reviewerNames = {};
          if (body.reviewerNames && typeof body.reviewerNames === 'object') {
            Object.keys(body.reviewerNames).forEach(function(k) {
              reviewerNames[String(k).toLowerCase().trim()] = String(body.reviewerNames[k] || '').trim();
            });
          }
          // Also accept { email, name } objects in body.reviewers itself.
          if (Array.isArray(body.reviewers)) {
            body.reviewers.forEach(function(it) {
              if (it && typeof it === 'object' && it.email && it.name) {
                var k = String(it.email).toLowerCase().trim();
                if (k && !reviewerNames[k]) reviewerNames[k] = String(it.name).trim();
              }
            });
          }

          var invalidEmails = reviewerEmails.filter(function(email) {
            return !isValidEmail(email);
          });
          if (invalidEmails.length) {
            return { success: false, error: 'Невалидни имейли на рецензенти: ' + invalidEmails.join(', ') };
          }

          var sheet = getSheet();
          var found = findRowByID(sheet, formId);
          if (!found) return { success: false, error: 'Application not found' };

          // ── UC-15 business rules ─────────────────────────────────────────
          // Per regulation: 2 reviewers per project; at least 1 external
          // (not @ue-varna.bg); no conflict of interest (reviewer cannot be
          // the applicant or a member of the project team).
          var ueDomain = '@ue-varna.bg';
          if (!allowOverride && reviewerEmails.length < 1) {
            return { success: false, error: 'Изисква се поне един рецензент.' };
          }
          var externals = reviewerEmails.filter(function(e) { return e.toLowerCase().indexOf(ueDomain) === -1; });
          // ── Temporarily relaxed: external reviewer requirement lifted (2026-05-09) ──
          // if (!allowOverride && externals.length < 1) {
          //   return { success: false, error: 'Поне един рецензент трябва да е външен (извън @ue-varna.bg).' };
          // }
          try {
            var applicantEmailLc = String(found.rowData[COL.USER_EMAIL - 1] || '').toLowerCase().trim();
            var team = [];
            try { team = JSON.parse(String(found.rowData[COL.TEAM_MEMBERS - 1] || '[]')) || []; } catch (_) {}
            var teamEmails = team.map(function(m) { return String((m && m.email) || '').toLowerCase().trim(); }).filter(Boolean);
            var coiHits = reviewerEmails.filter(function(e) {
              var le = e.toLowerCase();
              return le === applicantEmailLc || teamEmails.indexOf(le) !== -1;
            });
            if (coiHits.length) {
              return { success: false, error: 'Конфликт на интереси: рецензент(и) са кандидат или член на екипа: ' + coiHits.join(', ') };
            }
          } catch (coiErr) {
            console.warn('assignReviewers CoI check failed: ' + coiErr.message);
          }

          var rowIndex = found.rowIndex;
          var rowData = found.rowData;
          var oldStatus = String(rowData[COL.STATUS - 1] || '');
          var competitionId = String(rowData[COL.COMPETITION - 1] || '').trim();
          var projectTitle = String(rowData[COL.TITLE - 1] || '').trim();
          var projectType = String(rowData[COL.PROJECT_TYPE - 1] || '').trim().toUpperCase();
          var history = safeParseJSON(rowData[COL.HISTORY - 1], []);
          var now = nowISO();
          var actor = auth.userId || 'Администратор';

          // ── Reviewer fee calculation (per project type regulation) ──
          var reviewerFee = _getReviewerFeeForType_(projectType);
          var feeAmount = reviewerFee ? reviewerFee.amount : 0;
          var feeCurrency = reviewerFee ? reviewerFee.currency : 'EUR';
          if (!reviewerFee && projectType) {
            console.warn('assignReviewers: no reviewer fee rule for project type ' + projectType + ' — defaulting to 60 EUR');
            feeAmount = 60; feeCurrency = 'EUR';
          }

          // ── Perf: read the Reviewers sheet ONCE and index by
          // (email|competition|formId) so per-reviewer lookups in the loop
          // below become O(1). Without this, findReviewerRow_ does a full
          // scan for every reviewer, which dominates latency when assigning
          // multiple reviewers across many forms.
          var revSheet = getReviewersSheet();
          var revAllData = revSheet.getDataRange().getValues();
          var revIndex = {};      // strict key: email|comp|formId
          var revIndexLoose = {}; // loose key: email|comp|''  (when row has no formId yet)
          for (var rIdx = 1; rIdx < revAllData.length; rIdx++) {
            var rRow = revAllData[rIdx];
            var rEmail = String(rRow[REV_COL.EMAIL - 1] || '').toLowerCase().trim();
            if (!rEmail) continue;
            var rComp  = String(rRow[REV_COL.COMPETITION - 1] || '').trim();
            var rForm  = String(rRow[REV_COL.FORM_ID - 1] || '').trim();
            revIndex[rEmail + '|' + rComp + '|' + rForm] = { rowIndex: rIdx + 1, rowData: rRow.slice() };
            if (!rForm) {
              revIndexLoose[rEmail + '|' + rComp] = { rowIndex: rIdx + 1, rowData: rRow.slice() };
            }
          }

          // Pre-validate every reviewer name BEFORE mutating the application
          // row. Either the reviewer already has a valid name in the pool,
          // OR the admin must have supplied a valid two-word name in
          // reviewerNames[email]. Aborting here keeps state consistent.
          var resolvedNames = {};
          for (var ri = 0; ri < reviewerEmails.length; ri++) {
            var rmEmail = reviewerEmails[ri];
            var lcRm = rmEmail.toLowerCase();
            var poolHit = revIndex[lcRm + '|' + competitionId + '|' + formId]
                      || revIndexLoose[lcRm + '|' + competitionId];
            var existingName = poolHit ? String(poolHit.rowData[REV_COL.NAME - 1] || '').trim() : '';
            if (existingName && validateReviewerName_(existingName).ok) {
              resolvedNames[lcRm] = existingName;
              continue;
            }
            var nv = validateReviewerName_(reviewerNames[lcRm] || existingName);
            if (!nv.ok) {
              return { success: false, error: 'Липсва или невалидно име за рецензент ' + rmEmail + ': ' + nv.error };
            }
            resolvedNames[lcRm] = nv.name;
          }

          history.push({ action: 'Назначени рецензенти: ' + reviewerEmails.join(', ') + ' (възнаграждение: ' + feeAmount + ' ' + feeCurrency + ' на рецензент)', date: now, user: actor, reviewerFee: { amount: feeAmount, currency: feeCurrency, perReviewer: true } });

          var newRow = rowData.slice();
          while (newRow.length < TOTAL_COLS) newRow.push('');
          newRow[COL.REVIEWERS - 1] = JSON.stringify(reviewerEmails);
          newRow[COL.STATUS - 1] = 'in_review';
          newRow[COL.HISTORY - 1] = JSON.stringify(history);

          safeSetRow_(sheet, rowIndex, newRow, TOTAL_COLS);
          applyRowColor(sheet, rowIndex, 'in_review');

          var created = [];

          // Pending row writes batched into a single appendValues call
          var pendingNewRows = [];

          reviewerEmails.forEach(function(email) {
            var lcEmail = email.toLowerCase();
            var existing = revIndex[lcEmail + '|' + competitionId + '|' + formId]
                        || revIndexLoose[lcEmail + '|' + competitionId];
            var revId = existing ? String(existing.rowData[REV_COL.ID - 1] || '').trim() || generateId() : generateId();
            var revRow = existing ? existing.rowData.slice() : new Array(REV_TOTAL_COLS).fill('');
            while (revRow.length < REV_TOTAL_COLS) revRow.push('');

            var reviewerName = resolvedNames[lcEmail];
            var notesPrefix = 'Назначен за проект: ' + (projectTitle || formId);
            var currentNotes = String(revRow[REV_COL.NOTES - 1] || '').trim();

            revRow[REV_COL.ID - 1] = revId;
            revRow[REV_COL.EMAIL - 1] = email;
            revRow[REV_COL.NAME - 1] = reviewerName;
            revRow[REV_COL.COMPETITION - 1] = competitionId;
            revRow[REV_COL.FORM_ID - 1] = formId;
            revRow[REV_COL.CONSENT - 1] = String(revRow[REV_COL.CONSENT - 1] || '');
            revRow[REV_COL.STATUS - 1] = 'pending';
            revRow[REV_COL.CREATED - 1] = String(revRow[REV_COL.CREATED - 1] || now);
            revRow[REV_COL.NOTES - 1] = currentNotes
              ? (currentNotes.indexOf(notesPrefix) === -1 ? currentNotes + ' | ' + notesPrefix : currentNotes)
              : notesPrefix;
            // ── Reviewer fee tracking ──
            revRow[REV_COL.REVIEWER_FEE - 1] = feeAmount;
            revRow[REV_COL.REVIEWER_FEE_CURRENCY - 1] = feeCurrency;

            if (existing) safeSetRow_(revSheet, existing.rowIndex, revRow, REV_TOTAL_COLS);
            else pendingNewRows.push(revRow);

            var mailOk = false;
            try {
              mailOk = !!notifyReviewerAssignment_(email, projectTitle, formId, competitionId);
            } catch (mailErr) {
              console.error('assignReviewers reviewer email failed for ' + email + ': ' + mailErr.message);
              try { logError('assignReviewers_notifyReviewer', mailErr, { email: email, formId: formId }); } catch (_) {}
            }

            created.push({ id: revId, email: email, name: reviewerName, emailSent: mailOk });
          });

          // Batch-append all new reviewer rows in one round-trip
          if (pendingNewRows.length) {
            try {
              var lastRow = revSheet.getLastRow();
              revSheet.getRange(lastRow + 1, 1, pendingNewRows.length, REV_TOTAL_COLS).setValues(pendingNewRows);
            } catch (batchErr) {
              // Fallback: append one by one if the batched write fails
              console.warn('Batched reviewer append failed, falling back: ' + batchErr.message);
              pendingNewRows.forEach(function(rr) { revSheet.appendRow(rr); });
            }
          }

          logTransaction('ASSIGN_REVIEWERS', 'Application', formId, { reviewers: reviewerEmails });

          var applicantEmail = String(rowData[COL.USER_EMAIL - 1] || '').toLowerCase().trim();
          var applicantName = String(rowData[COL.USER_NAME - 1] || '');
          var applicantEmailSent = false;
          try {
            applicantEmailSent = !!notifyStatusChange_(applicantEmail, applicantName, formId, projectTitle, oldStatus, 'in_review', 'Назначени са рецензенти и заявлението е изпратено за оценка.');
          } catch (mailErr) {
            console.error('assignReviewers applicant email failed: ' + mailErr.message);
            try { logError('assignReviewers_notifyApplicant', mailErr, { email: applicantEmail, formId: formId }); } catch (_) {}
          }

          return {
            success: true,
            message: 'Рецензентите са назначени успешно (' + created.length + '). Възнаграждение: ' + feeAmount + ' ' + feeCurrency + ' на рецензент.',
            reviewers: created,
            emailSent: applicantEmailSent,
            reviewerEmailCount: created.filter(function(item) { return item.emailSent; }).length
          };
        } catch (err) {
          logError('assignReviewers', err, body);
          return { success: false, error: 'assignReviewers failed: ' + err.message };
        }
      }

      function evaluateProject(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin) {
            return { success: false, error: 'Отказан достъп: Само администратори' };
          }

          var formId = body.formId;
          var evaluation = body.evaluation || {};
          var status = body.status; // 'approved' or 'rejected'
          if (!formId || !status) return { success: false, error: 'Missing formId or status' };
          if (status !== 'approved' && status !== 'rejected') return { success: false, error: 'Invalid status: must be approved or rejected' };

          var sheet = getSheet();
          var found = findRowByID(sheet, formId);
          if (!found) return { success: false, error: 'Form not found' };

          var rowIndex = found.rowIndex;
          var rowData = found.rowData;
          var oldStatus = String(rowData[COL.STATUS - 1] || '');
          var history = safeParseJSON(rowData[COL.HISTORY - 1], []);
          var now = nowISO();
          var actor = auth.userId || 'Администратор';
          var projectTitle = String(rowData[COL.TITLE - 1] || '').trim();

          // Build rich evaluation object
          var scores = evaluation.scores || {};
          var totalScore = Number(evaluation.totalScore) || 0;
          var maxScore = Number(evaluation.maxScore) || 100;
          var comment = String(evaluation.comment || '');

          var evalRecord = {
            status: status,
            scores: scores,
            totalScore: totalScore,
            maxScore: maxScore,
            comment: comment,
            date: evaluation.date || now,
            evaluator: actor,
            rubricVersion: String(evaluation.rubricVersion || '1.0')
          };

          var actionText = status === 'approved'
            ? 'Проектът е одобрен с ' + totalScore + '/' + maxScore + ' точки'
            : 'Проектът е отхвърлен (' + totalScore + '/' + maxScore + ' точки)';
          if (comment) actionText += '. Мотиви: ' + comment;

          history.push({ action: actionText, date: now, user: actor, evaluation: evalRecord });

          var newRow = rowData.slice();
          while (newRow.length < TOTAL_COLS) newRow.push('');
          newRow[COL.EVALUATION - 1] = JSON.stringify(evalRecord);
          newRow[COL.STATUS - 1] = status;
          newRow[COL.HISTORY - 1] = JSON.stringify(history);

          safeSetRow_(sheet, rowIndex, newRow, TOTAL_COLS);
          applyRowColor(sheet, rowIndex, status);
          logTransaction('EVALUATE_PROJECT', 'Application', formId, { status: status, totalScore: totalScore, maxScore: maxScore });

          // Notify applicant
          var applicantEmail = String(rowData[COL.USER_EMAIL - 1] || '').toLowerCase().trim();
          var applicantName = String(rowData[COL.USER_NAME - 1] || '');
          var emailSent = false;
          try {
            emailSent = !!notifyStatusChange_(applicantEmail, applicantName, formId, projectTitle, oldStatus, status, comment || actionText);
          } catch (mailErr) {
            console.error('evaluateProject email failed: ' + mailErr.message);
          }

          return {
            success: true,
            message: 'Проектът е оценен: ' + totalScore + '/' + maxScore + ' т. → ' + (status === 'approved' ? 'Одобрен' : 'Отхвърлен'),
            emailSent: emailSent
          };
        } catch (err) {
          logError('evaluateProject', err, body);
          return { success: false, error: 'evaluateProject failed: ' + err.message };
        }
      }

      function generateContract(body) {
        try {
          var auth = resolveAuthContext(body || {});
          if (!auth.isAdmin) return { success: false, error: 'Отказан достъп: Само администратори.' };
          var formId = body.formId;
          if (!formId) return { success: false, error: 'Missing formId' };

          var sheet = getSheet();
          var found = findRowByID(sheet, formId);
          if (!found) return { success: false, error: 'Form not found' };

          var row = found.rowData;
          var currentStatus = String(row[COL.STATUS - 1]);
          var contractAllowed = ['approved', 'approved_for_funding', 'contracting'];
          if (contractAllowed.indexOf(currentStatus) === -1) {
            return { success: false, error: 'Договор може да се генерира само за одобрени проекти (текущ статус: ' + currentStatus + ')' };
          }

          // Copy template doc
          var template = DriveApp.getFileById(TEMPLATE_DOC_ID);
          var folder = getOrCreateAppFolder(formId);
          var docFile = template.makeCopy('Договор за ' + row[COL.TITLE - 1], folder);
          var docId = docFile.getId();
          var doc = DocumentApp.openById(docId);
          var bodyDoc = doc.getBody();

          // Parse structured fields for placeholders
          var budgetObj = safeParseJSON(row[COL.BUDGET - 1], {});
          var budgetTotal = '';
          if (budgetObj && typeof budgetObj === 'object') {
            var sum = 0;
            var keys = Object.keys(budgetObj);
            for (var bi = 0; bi < keys.length; bi++) {
              var val = budgetObj[keys[bi]];
              if (typeof val === 'number') sum += val;
              else if (typeof val === 'object' && val !== null) {
                var subKeys = Object.keys(val);
                for (var si = 0; si < subKeys.length; si++) {
                  if (typeof val[subKeys[si]] === 'number') sum += val[subKeys[si]];
                }
              }
            }
            budgetTotal = sum > 0 ? (sum / 1.95583).toLocaleString('bg-BG', {minimumFractionDigits:2,maximumFractionDigits:2}) + ' €' : JSON.stringify(budgetObj);
          }

          var teamArr = safeParseJSON(row[COL.TEAM_MEMBERS - 1], []);
          var teamStr = '';
          if (Array.isArray(teamArr) && teamArr.length > 0) {
            teamStr = teamArr.map(function(m) {
              return typeof m === 'string' ? m : (m.name || m.email || JSON.stringify(m));
            }).join(', ');
          }

          var indicatorsArr = safeParseJSON(row[COL.INDICATORS - 1], []);
          var indicatorsStr = '';
          if (Array.isArray(indicatorsArr) && indicatorsArr.length > 0) {
            indicatorsStr = indicatorsArr.map(function(ind, idx) {
              return typeof ind === 'string' ? (idx + 1) + '. ' + ind : (idx + 1) + '. ' + (ind.name || ind.description || JSON.stringify(ind));
            }).join('\n');
          }

          // Replace all placeholders
          bodyDoc.replaceText('{{TITLE}}', row[COL.TITLE - 1] || '');
          bodyDoc.replaceText('{{LEADER}}', row[COL.USER_NAME - 1] || '');
          bodyDoc.replaceText('{{EMAIL}}', row[COL.USER_EMAIL - 1] || '');
          bodyDoc.replaceText('{{DESCRIPTION}}', row[COL.DESCRIPTION - 1] || '');
          bodyDoc.replaceText('{{DATE}}', new Date().toLocaleDateString('bg-BG'));
          bodyDoc.replaceText('{{PROJECT_CODE}}', row[COL.PROJECT_CODE - 1] || '');
          bodyDoc.replaceText('{{AREA}}', _getAreasArray_(String(row[COL.AREA - 1] || '')).join(', ') || '');
          bodyDoc.replaceText('{{BUDGET}}', budgetTotal || row[COL.BUDGET - 1] || '');
          bodyDoc.replaceText('{{DURATION}}', row[COL.DURATION_MONTHS - 1] ? row[COL.DURATION_MONTHS - 1] + ' месеца' : '');
          bodyDoc.replaceText('{{TEAM_MEMBERS}}', teamStr || '');
          bodyDoc.replaceText('{{OBJECTIVES}}', row[COL.OBJECTIVES - 1] || '');
          bodyDoc.replaceText('{{EXPECTED_RESULTS}}', row[COL.EXPECTED_RESULTS - 1] || '');
          bodyDoc.replaceText('{{INDICATORS}}', indicatorsStr || '');
          bodyDoc.replaceText('{{COMPETITION}}', row[COL.COMPETITION - 1] || '');
          bodyDoc.replaceText('{{SCORE}}', row[COL.SCORE - 1] ? String(row[COL.SCORE - 1]) : '');
          bodyDoc.replaceText('{{RANK}}', row[COL.RANK - 1] ? String(row[COL.RANK - 1]) : '');

          doc.saveAndClose();

          var rowIndex = found.rowIndex;
          var history = safeParseJSON(row[COL.HISTORY - 1], []);
          var now = nowISO();
          var actor = auth.userId || 'Администратор';

          history.push({ action: 'Договор генериран', date: now, user: actor, docId: docId });

          var newRow = row.slice();
          while (newRow.length < TOTAL_COLS) newRow.push('');
          newRow[COL.CONTRACT_ID - 1] = docId;
          newRow[COL.STATUS - 1] = 'contracting';
          newRow[COL.HISTORY - 1] = JSON.stringify(history);

          safeSetRow_(sheet, rowIndex, newRow, TOTAL_COLS);

          return { success: true, contractId: docId, message: 'Договорът е генериран', status: 'contracting', link: 'https://docs.google.com/document/d/' + docId + '/edit' };
        } catch (err) {
          return { success: false, error: 'generateContract failed: ' + err.message };
        }
      }

      /**
       * UC-25 (Workflow spec, Stage 8) — Record signed contract.
       * Per regulation: "Договорът се сключва в 10-дневен срок от обявяването
       * на одобрените за финансиране проекти". Transitions:
       *   contracting → contract_signed
       * Optionally auto-creates the ActiveProject row (UC-26) if body.autoActivate
       * is truthy and the configured policy allows it.
       *
       * Body: {
       *   formId, signatureType: 'attached'|'electronic',
       *   signatureFileId?, signatureFileName?, signedDate?, notes?,
       *   autoActivate?, startDate?, endDate?
       * }
       * Roles: Rector, Vice-Rector, NIDD, Admin (signing is recorded by НИДД or by
       * Ректор's office; the leader does not write here).
       */
      function signProjectContract(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin && auth.role !== ROLE_RECTOR && auth.role !== ROLE_VICE_RECTOR && auth.role !== ROLE_NIDD) {
            return { success: false, error: 'Нямате право. Само НИДД/Ректор/Зам.-ректор/Администратор могат да отбележат подписването.' };
          }
          var formId = String(body.formId || body.id || '').trim();
          if (!formId) return { success: false, error: 'Липсва formId.' };
          var sheet = getSheet();
          var data  = sheet.getDataRange().getValues();
          var rowIndex = -1, row = null;
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][COL.ID - 1]).trim() === formId) { rowIndex = i + 1; row = data[i]; break; }
          }
          if (!row) return { success: false, error: 'Заявлението не е намерено.' };

          var curStatus = String(row[COL.STATUS - 1] || '').trim();
          if (curStatus !== 'contracting' && curStatus !== 'approved_for_funding') {
            return { success: false, error: 'Договорът не може да бъде подписан в текущ статус: ' + curStatus + '. Очакван: contracting.' };
          }
          var contractId = String(row[COL.CONTRACT_ID - 1] || '').trim();
          if (!contractId) {
            return { success: false, error: 'Няма генериран договор. Моля, първо извикайте generateContract.' };
          }

          // ── 10-day window check (informational, NOT blocking by default) ──
          var TEN_DAYS_MS = 10 * 24 * 60 * 60 * 1000;
          var now = new Date();
          var history = [];
          try { history = JSON.parse(String(row[COL.HISTORY - 1] || '[]')); } catch (_) {}
          var approvalDate = null;
          for (var h = history.length - 1; h >= 0; h--) {
            var actL = String(history[h].action || '').toLowerCase();
            if (actL.indexOf('approved_for_funding') >= 0 || actL.indexOf('одобрено за финансиране') >= 0 || history[h].status === 'approved_for_funding') {
              approvalDate = new Date(history[h].date || history[h].ts || '');
              break;
            }
          }
          var deadlineISO = null;
          var overdue = false;
          if (approvalDate && !isNaN(approvalDate.getTime())) {
            var dl = new Date(approvalDate.getTime() + TEN_DAYS_MS);
            deadlineISO = dl.toISOString().substring(0, 10);
            overdue = now > dl;
          }
          // Allow late signatures (regulation permits with rector waiver) but mark in audit.
          if (overdue && body.lateWaiverRef) {
            // recorded below in meta
          }

          var signedDate = String(body.signedDate || '').trim() || now.toISOString();
          var meta = {
            contractDocId: contractId,
            signatureType: String(body.signatureType || 'attached'),
            signatureFileId: String(body.signatureFileId || '').trim(),
            signatureFileName: String(body.signatureFileName || '').trim(),
            signedDate: signedDate,
            signedBy: auth.userId,
            deadline: deadlineISO,
            wasOverdue: overdue,
            lateWaiverRef: String(body.lateWaiverRef || '').trim(),
            notes: String(body.notes || '').trim()
          };

          history.push({ action: 'Договорът е подписан', date: nowISO(), user: auth.userId, status: 'contract_signed', meta: meta });
          var newRow = row.slice();
          while (newRow.length < TOTAL_COLS) newRow.push('');
          newRow[COL.STATUS - 1]  = 'contract_signed';
          newRow[COL.HISTORY - 1] = JSON.stringify(history);
          safeSetRow_(sheet, rowIndex, newRow, TOTAL_COLS);

          logTransaction('SIGN_CONTRACT', auth.userId, formId, meta);

          // ── Auto-archive the signed contract Doc into "Подписани документи" ──
          // BPMN UC-25 step 4: after signing, the original Doc must live in
          // a long-term archival folder so it is not co-mingled with editable
          // application working copies. We COPY (don't move) so the link in the
          // application stays valid; the copy is renamed with the signature
          // metadata for easy auditor lookup.
          var archivedFileId = null;
          try {
            var srcFile = DriveApp.getFileById(contractId);
            var compId = String(row[COL.COMPETITION - 1] || '').trim();
            var compFolderId = '';
            if (compId) {
              try {
                var comp = getCompetitionById_(compId, false);
                if (comp && comp.folderId) compFolderId = comp.folderId;
              } catch (_) {}
            }
            var archiveFolder = getOrCreateSignedDocsFolder_(compFolderId);
            var archivedName = '[ПОДПИСАН ' + signedDate.substring(0, 10) + '] ' + srcFile.getName();
            // Idempotent: if a copy with the same name already exists, reuse it.
            var existIt = archiveFolder.getFilesByName(archivedName);
            var archivedFile = existIt.hasNext() ? existIt.next() : srcFile.makeCopy(archivedName, archiveFolder);
            archivedFileId = archivedFile.getId();
            // Append the archive reference to the history meta so auditors see
            // exactly which Drive file is the legally-binding copy.
            meta.archivedFileId = archivedFileId;
            history[history.length - 1].meta = meta;
            newRow[COL.HISTORY - 1] = JSON.stringify(history);
            safeSetRow_(sheet, rowIndex, newRow, TOTAL_COLS);
            try { logTransaction('ARCHIVE_CONTRACT', auth.userId, formId, { archivedFileId: archivedFileId, folderId: archiveFolder.getId(), name: archivedName }); } catch (_) {}
          } catch (archErr) {
            console.warn('signProjectContract archive step failed: ' + archErr.message);
          }

          // ── UC-26 — auto-create active project ──
          var projectId = null;
          if (body.autoActivate) {
            try {
              // Promote contract_signed → contracted is implicit; createProject
              // accepts both. After creation, application status flips to 'active'.
              var cp = createProject({
                applicationId: formId,
                startDate: body.startDate || signedDate.substring(0, 10),
                endDate: body.endDate || '',
                year: body.year || new Date().getFullYear(),
                userId: auth.userId,
                _autoTriggered: true
              });
              if (cp && cp.success) projectId = cp.projectId;
            } catch (apErr) {
              console.warn('signProjectContract auto-activate failed: ' + apErr.message);
            }
          }

          return {
            success: true,
            status: 'contract_signed',
            formId: formId,
            contractDocId: contractId,
            archivedFileId: archivedFileId,
            deadline: deadlineISO,
            wasOverdue: overdue,
            projectId: projectId
          };
        } catch (err) {
          logError('signProjectContract', err, body);
          return { success: false, error: 'signProjectContract failed: ' + err.message };
        }
      }

      // ============================================================
      //  BATCH OPERATIONS – Reduce N+1 API calls
      // ============================================================

      function batchCheckCompliance(body) {
        try {
          var auth = resolveAuthContext(body || {});
          if (!auth.isAdmin) return { success: false, error: 'Отказан достъп: Само администратори.' };
          var formIds = Array.isArray(body.formIds) ? body.formIds : [];
          if (!formIds.length) return { success: true, results: [] };

          var sheet = getSheet();
          // _cachedSheetData_ shares the sheet read with getForms + checkCompliance in the same execution
          var data = _cachedSheetData_(sheet);
          var results = [];

          formIds.forEach(function(formId) {
            var found = findRowByID(sheet, formId, data);
            if (!found) {
              results.push({ formId: formId, success: false, error: 'Not found' });
              return;
            }

            var row = found.rowData;
            var projectCode = String(row[COL.PROJECT_CODE - 1] || '').toUpperCase();
            var isFNIorPNI = projectCode === 'ФНИ' || projectCode === 'ПНИ';
            var leaderEmail = String(row[COL.USER_EMAIL - 1]).toLowerCase().trim();

            var issues = [];
            if (isFNIorPNI) {
              var leaderCount = 0;
              for (var i = 1; i < data.length; i++) {
                if (String(data[i][COL.USER_EMAIL - 1]).toLowerCase().trim() === leaderEmail &&
                    String(data[i][COL.PROJECT_CODE - 1]).toUpperCase() === projectCode &&
                    String(data[i][COL.STATUS - 1]) !== 'rejected') {
                  leaderCount++;
                }
              }
              if (leaderCount > 1) {
                issues.push('Водачът има ' + leaderCount + ' проекта от тип ' + projectCode);
              }
            }

            results.push({
              formId: formId,
              success: true,
              compliant: issues.length === 0,
              issues: issues
            });
          });

          return { success: true, results: results };
        } catch (err) {
          return { success: false, error: 'batchCheckCompliance failed: ' + err.message };
        }
      }

      function batchEvaluate(body) {
        try {
          var auth = resolveAuthContext(body || {});
          if (!auth.isAdmin) return { success: false, error: 'Отказан достъп: Само администратори.' };
          var competitionId = body.competitionId;
          if (!competitionId) return { success: false, error: 'Missing competitionId' };

          var sheet = getSheet();
          var data = sheet.getDataRange().getValues();
          var results = [];
          var evaluableStatuses = ['submitted', 'admin_passed', 'eligible', 'reviewers_proposed', 'reviewer_assignment', 'reviewer_invited', 'reviewer_accepted', 'in_review', 'review_submitted', 'reviewed'];

          // Also load reviewer data for each project
          var revSheet = null;
          try { revSheet = getReviewersSheet(); } catch (_) {}
          var revData = revSheet ? revSheet.getDataRange().getValues() : [];

          for (var i = 1; i < data.length; i++) {
            var row = data[i];
            var rowCompId = String(row[COL.COMPETITION - 1]);
            var rowStatus = String(row[COL.STATUS - 1]);

            if (rowCompId === competitionId && evaluableStatuses.indexOf(rowStatus) !== -1) {
              var formId = String(row[COL.ID - 1]);
              var existingEval = safeParseJSON(row[COL.EVALUATION - 1], null);

              // Gather reviewers for this project
              var projectReviewers = [];
              if (revData.length > 1) {
                for (var j = 1; j < revData.length; j++) {
                  if (String(revData[j][REV_COL.FORM_ID - 1]) === formId) {
                    projectReviewers.push({
                      email: String(revData[j][REV_COL.EMAIL - 1] || ''),
                      name: String(revData[j][REV_COL.NAME - 1] || ''),
                      status: String(revData[j][REV_COL.STATUS - 1] || 'pending'),
                      score: String(revData[j][REV_COL.SCORE - 1] || ''),
                      review: String(revData[j][REV_COL.REVIEW - 1] || '')
                    });
                  }
                }
              }

              results.push({
                formId: formId,
                title: String(row[COL.TITLE - 1]),
                applicant: String(row[COL.USER_NAME - 1]),
                projectType: String(row[COL.PROJECT_CODE - 1] || ''),
                area: String(row[COL.AREA - 1] || ''),
                currentStatus: rowStatus,
                evaluation: existingEval,
                reviewers: projectReviewers,
                submitted: String(row[COL.SUBMITTED - 1] || '')
              });
            }
          }

          // Sort: reviewed first, then in_review, then admin_passed, then submitted
          var statusOrder = { reviewed: 0, in_review: 1, admin_passed: 2, submitted: 3 };
          results.sort(function(a, b) {
            return (statusOrder[a.currentStatus] || 9) - (statusOrder[b.currentStatus] || 9);
          });

          return { success: true, results: results };
        } catch (err) {
          return { success: false, error: 'batchEvaluate failed: ' + err.message };
        }
      }

      function batchGenerateContracts(body) {
        try {
          var auth = resolveAuthContext(body || {});
          if (!auth.isAdmin) return { success: false, error: 'Отказан достъп: Само администратори.' };
          var competitionId = body.competitionId;
          if (!competitionId) return { success: false, error: 'Missing competitionId' };

          var sheet = getSheet();
          var data = sheet.getDataRange().getValues();
          var results = [];

          for (var i = 1; i < data.length; i++) {
            var row = data[i];
            if (String(row[COL.COMPETITION - 1]) === competitionId &&
                String(row[COL.STATUS - 1]) === 'approved') {
              var formId = String(row[COL.ID - 1]);
              var found = findRowByID(sheet, formId, data);
              if (found && !row[COL.CONTRACT_ID - 1]) {
                var title = String(row[COL.TITLE - 1]);
                var template = DriveApp.getFileById(TEMPLATE_DOC_ID);
                var folder = getOrCreateAppFolder(formId);
                var docFile = template.makeCopy('Договор – ' + title, folder);
                var docId = docFile.getId();

                var newRow = row.slice();
                while (newRow.length < TOTAL_COLS) newRow.push('');
                newRow[COL.CONTRACT_ID - 1] = docId;
                var history = safeParseJSON(row[COL.HISTORY - 1], []);
                history.push({ action: 'Договор генериран', date: nowISO(), user: 'Система' });
                newRow[COL.HISTORY - 1] = JSON.stringify(history);
                safeSetRow_(sheet, found.rowIndex, newRow, TOTAL_COLS);

                results.push({
                  formId: formId,
                  success: true,
                  contractId: docId,
                  link: 'https://docs.google.com/document/d/' + docId + '/edit'
                });
              }
            }
          }

          return { success: true, results: results };
        } catch (err) {
          return { success: false, error: 'batchGenerateContracts failed: ' + err.message };
        }
      }

      function getCompetitionSummary(body) {
        try {
          var competitionId = body.competitionId;
          if (!competitionId) return { success: false, error: 'Missing competitionId' };

          // PERF: dashboard hot path. Version-keyed cache (5 min TTL) so repeat calls
          // across users for the same competition skip the full Applications sheet scan.
          var sc = null;
          var cacheKey = '';
          try {
            sc = _scriptCache_();
            var dv = getDataVersions_();
            cacheKey = 'gcs:v1:' + competitionId + ':' + dv.applications;
            var cached = sc.get(cacheKey);
            if (cached) {
              try {
                var parsed = JSON.parse(cached);
                if (parsed && parsed.success) { parsed.cached = true; return parsed; }
              } catch (_) {}
            }
          } catch (_) {}

          var sheet = getSheet();
          // _cachedSheetData_ shares the Applications read with getForms/getCompetitionPanel
          // if they run in the same GAS execution.
          var data = _cachedSheetData_(sheet);
          var summary = {
            total: 0,
            draft: 0,
            submitted: 0,
            approved: 0,
            rejected: 0,
            returned: 0,
            inReview: 0
          };

          for (var i = 1; i < data.length; i++) {
            var row = data[i];
            if (String(row[COL.COMPETITION - 1]) === competitionId) {
              var status = String(row[COL.STATUS - 1]).toLowerCase();
              summary.total++;
              if (status === 'draft') summary.draft++;
              else if (status === 'submitted') summary.submitted++;
              else if (status === 'approved') summary.approved++;
              else if (status === 'rejected') summary.rejected++;
              else if (status === 'returned') summary.returned++;
              else if (status === 'in_review') summary.inReview++;
            }
          }

          var result = { success: true, summary: summary };
          if (cacheKey && sc) {
            try { sc.put(cacheKey, JSON.stringify(result), 1800); } catch (_) {}
          }
          return result;
        } catch (err) {
          return { success: false, error: 'getCompetitionSummary failed: ' + err.message };
        }
      }

      function createCompetition(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          var userId = auth.userId;
          var isAdmin = auth.isAdmin;
          if (!isAdmin) {
            return { success: false, error: 'Отказан достъп: Само администратори могат да създават конкурси.' };
          }

          var name = String(body.name || '').trim();
          var deadline = body.deadline; // ISO string
          var description = String(body.description || '').trim();
          if (!name || !deadline) return { success: false, error: 'Липсва име или крайна дата на конкурса.' };

          // Validate deadline is a parseable date
          var dlDate = new Date(deadline);
          if (isNaN(dlDate.getTime())) return { success: false, error: 'Невалидна крайна дата: ' + deadline };

          var id = generateId();
          var now = nowISO();
          var status = normalizeCompetitionStatus_(body.status || 'active');
          var folderId = '';

          // Extended fields (cols 8-14)
          var callType       = String(body.callType       || '').trim();
          var year           = String(body.year           || '').trim();
          var directions     = String(body.directions     || '').trim();
          var evalCriteria   = String(body.evalCriteria   || '').trim();
          var budgetByDir    = String(body.budgetByDirection || '').trim();
          var openDate       = body.openDate ? String(body.openDate).trim() : '';
          var templates      = String(body.templates      || '').trim();

          // Create competition folder in Drive with metadata
          try {
            var mainFolder = DriveApp.getFolderById(DRIVE_FOLDER_ID);
            var compFolder = mainFolder.createFolder(id + ' - ' + name);
            folderId = compFolder.getId();
            compFolder.createFolder('Applications');
            compFolder.createFolder('Reviews');
            compFolder.createFolder('Documents');

            // Save competition metadata as JSON inside the folder
            var metadata = {
              id: id,
              name: name,
              deadline: deadline,
              dateEnd: deadline,
              status: status,
              created: now,
              description: description,
              folderId: folderId,
              createdBy: userId
            };
            compFolder.createFile('competition.json', JSON.stringify(metadata, null, 2), MimeType.PLAIN_TEXT);
          } catch (folderErr) {
            console.warn('Could not create competition folder: ' + folderErr.message);
          }

          // Write to Competitions sheet (includes folderId)
          var sheet = getCompetitionsSheet();
          var row = new Array(COMP_TOTAL_COLS).fill('');
          row[COMP_COL.ID - 1]          = id;
          row[COMP_COL.NAME - 1]        = name;
          row[COMP_COL.DEADLINE - 1]    = deadline;
          row[COMP_COL.STATUS - 1]      = status;
          row[COMP_COL.CREATED - 1]     = now;
          row[COMP_COL.DESCRIPTION - 1] = description;
          row[COMP_COL.FOLDER_ID - 1]   = folderId;
          row[COMP_COL.CALL_TYPE  - 1]  = callType;
          row[COMP_COL.YEAR       - 1]  = year;
          row[COMP_COL.DIRECTIONS - 1]  = directions;
          row[COMP_COL.EVAL_CRITERIA - 1] = evalCriteria;
          row[COMP_COL.BUDGET_BY_DIR - 1] = budgetByDir;
          row[COMP_COL.OPEN_DATE  - 1]  = openDate;
          row[COMP_COL.TEMPLATES  - 1]  = templates;
          sheet.appendRow(row);

          // Invalidate cache & publish feed
          try { invalidateCache('COMPETITIONS'); } catch (_) {}
          try { publishCompetitionsFeed_(); } catch (_) {}

          // ── Competition announcement: email notification to admin list ──
          // Per regulation: competition is announced on website and by email
          // to department/unit heads upon opening by rector's order.
          try {
            var announcementRecipients = ADMIN_EMAILS_SERVER.slice();
            if (_ADMIN_EMAILS_SERVER) {
              try {
                var parsedAdmins = typeof _ADMIN_EMAILS_SERVER === 'string' ? JSON.parse(_ADMIN_EMAILS_SERVER) : _ADMIN_EMAILS_SERVER;
                if (Array.isArray(parsedAdmins)) announcementRecipients = parsedAdmins;
              } catch (_) {}
            }
            var deadlineFormatted = new Date(deadline).toLocaleDateString('bg-BG', { year: 'numeric', month: 'long', day: 'numeric' });
            var directionsList = directions ? directions.split(',').map(function(d) { return d.trim(); }).filter(Boolean).join(', ') : 'Всички направления';
            announcementRecipients.forEach(function(recEmail) {
              notifyApplicant_(recEmail.trim(),
                '📢 Нов конкурс: ' + name,
                buildNotificationHtml_(
                  'Открит е нов конкурс за научни проекти',
                  [
                    { label: 'Наименование:', value: name },
                    { label: 'Краен срок:', value: deadlineFormatted },
                    { label: 'Тип:', value: callType || 'Общ' },
                    { label: 'Година:', value: year || String(new Date().getFullYear()) },
                    { label: 'Направления:', value: directionsList },
                    { label: 'Описание:', value: (description || '').substring(0, 200) }
                  ],
                  'Срокът за подаване на проектни предложения е до ' + deadlineFormatted + '. Конкурсът е достъпен в ERP системата.'
                ),
                'broadcast'
              );
            });
          } catch (notifyErr) { console.warn('Competition announcement email failed: ' + notifyErr.message); }
          return {
            success: true,
            data: {
              id: id,
              name: name,
              deadline: deadline,
              dateEnd: deadline,
              status: status,
              created: now,
              description: description,
              folderId: folderId
            },
            message: 'Конкурсът е създаден успешно.'
          };
        } catch (err) {
          logError('createCompetition', err, body);
          return { success: false, error: 'createCompetition failed: ' + err.message };
        }
      }

      // ============================================================
      //  EDIT COMPETITION (Admin-only)
      // ============================================================
      // ── Competition state machine: enforce valid status transitions ──
      // Full lifecycle: draft → active → closed → results_published → archived
      // Admin shortcut: any "live" status can also be archived directly (e.g. to
      // abandon a competition that was opened by mistake or cancelled).
      // ── UC-22 (Workflow spec, Stage 7) ─────────────────────────────────────
      // 'results_approved_by_ac' inserted between 'closed' (ranking finalised by
      // CKK) and 'results_published' (public broadcast). Provides the explicit
      // ratification step required by the regulation: "Академичният съвет приема
      // резултатите от конкурса". The admin override path (closed → results_published)
      // is preserved for legacy/edge cases.
      var COMP_TRANSITIONS = {
        'draft':                   ['active', 'archived'],
        'active':                  ['closed', 'results_published', 'archived'],
        'closed':                  ['results_approved_by_ac', 'results_published', 'archived', 'active'],
        'results_approved_by_ac':  ['results_published', 'closed', 'archived'],
        'results_published':       ['archived', 'closed'],
        'archived':                ['active']
      };

      function validateCompTransition_(currentStatus, newStatus) {
        var from = normalizeCompetitionStatus_(currentStatus);
        var to   = normalizeCompetitionStatus_(newStatus);
        if (from === to) return true; // no-op
        var allowed = COMP_TRANSITIONS[from];
        if (!allowed) return false;
        return allowed.indexOf(to) !== -1;
      }

      function editCompetition(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin) {
            return { success: false, error: 'Отказан достъп: Само администратори могат да разглеждат конкурси.' };
          }

          var competitionId = String(body.id || '').trim();
          if (!competitionId) return { success: false, error: 'Missing competition ID' };

          var name = body.name ? String(body.name).trim() : null;
          var deadline = body.deadline || null;
          var description = body.description ? String(body.description).trim() : null;
          var status = body.status ? normalizeCompetitionStatus_(body.status) : null;

          // Extended fields
          var callType     = body.callType       !== undefined ? String(body.callType).trim()       : null;
          var year         = body.year           !== undefined ? String(body.year).trim()           : null;
          var directions   = body.directions     !== undefined ? String(body.directions).trim()     : null;
          var evalCriteria = body.evalCriteria   !== undefined ? String(body.evalCriteria).trim()   : null;
          var budgetByDir  = body.budgetByDirection !== undefined ? String(body.budgetByDirection).trim() : null;
          var openDate     = body.openDate       !== undefined ? String(body.openDate).trim()       : null;
          var templates    = body.templates      !== undefined ? String(body.templates).trim()      : null;

          // Validate deadline if provided
          if (deadline) {
            var dlCheck = new Date(deadline);
            if (isNaN(dlCheck.getTime())) return { success: false, error: 'Невалидна крайна дата: ' + deadline };
          }

          // Find row in competitions sheet
          var sheet = getCompetitionsSheet();
          var data = sheet.getDataRange().getValues();
          var rowFound = -1;

          for (var i = 1; i < data.length; i++) {
            if (String(data[i][COMP_COL.ID - 1] || '').trim() === competitionId) {
              rowFound = i;
              break;
            }
          }

          if (rowFound === -1) {
            return { success: false, error: 'Конкурсът не е намерен.' };
          }

          var row = data[rowFound];
          var oldData = {
            id: row[COMP_COL.ID - 1],
            name: row[COMP_COL.NAME - 1],
            deadline: row[COMP_COL.DEADLINE - 1],
            status: row[COMP_COL.STATUS - 1],
            description: row[COMP_COL.DESCRIPTION - 1]
          };

          // Update fields if provided
          if (name !== null) row[COMP_COL.NAME - 1] = name;
          if (deadline !== null) row[COMP_COL.DEADLINE - 1] = deadline;
          if (description !== null) row[COMP_COL.DESCRIPTION - 1] = description;
          if (status !== null) {
            var currentCompStatus = normalizeCompetitionStatus_(row[COMP_COL.STATUS - 1]);
            if (!validateCompTransition_(currentCompStatus, status)) {
              return { success: false, error: 'Невалиден преход на статус: ' + currentCompStatus + ' → ' + status + '. Допустими: ' + (COMP_TRANSITIONS[currentCompStatus] || []).join(', ') };
            }
            row[COMP_COL.STATUS - 1] = status;
          }
          if (callType !== null) row[COMP_COL.CALL_TYPE - 1] = callType;
          if (year !== null) row[COMP_COL.YEAR - 1] = year;
          if (directions !== null) row[COMP_COL.DIRECTIONS - 1] = directions;
          if (evalCriteria !== null) row[COMP_COL.EVAL_CRITERIA - 1] = evalCriteria;
          if (budgetByDir !== null) row[COMP_COL.BUDGET_BY_DIR - 1] = budgetByDir;
          if (openDate !== null) row[COMP_COL.OPEN_DATE - 1] = openDate;
          if (templates !== null) row[COMP_COL.TEMPLATES - 1] = templates;

          // Write back to sheet
          sheet.getRange(rowFound + 1, 1, 1, COMP_TOTAL_COLS).setValues([row]);

          // Update competition.json in Drive folder if folderId exists
          var folderId = String(row[COMP_COL.FOLDER_ID - 1] || '').trim();
          if (folderId) {
            try {
              var folder = DriveApp.getFolderById(folderId);
              var files = folder.getFilesByName('competition.json');
              if (files.hasNext()) {
                var metaFile = files.next();
                var metadata = {
                  id: competitionId,
                  name: name || oldData.name,
                  deadline: deadline || oldData.deadline,
                  dateEnd: deadline || oldData.deadline,
                  status: status || oldData.status,
                  description: description || oldData.description,
                  folderId: folderId,
                  createdBy: body.userId || '—',
                  lastModified: nowISO(),
                  modifiedBy: auth.userId
                };
                metaFile.setContent(JSON.stringify(metadata, null, 2));
              }
            } catch (folderErr) {
              console.warn('Could not update competition.json in Drive: ' + folderErr.message);
            }
          }

          // Invalidate cache & publish feed
          try { invalidateCache('COMPETITIONS'); } catch (_) {}
          try { publishCompetitionsFeed_(); } catch (_) {}

          return {
            success: true,
            data: {
              id: competitionId,
              name: name || oldData.name,
              deadline: deadline || oldData.deadline,
              status: status || oldData.status,
              description: description || oldData.description
            },
            message: 'Конкурсът е обновен успешно.',
            changes: {
              before: oldData,
              after: {
                id: competitionId,
                name: name || oldData.name,
                deadline: deadline || oldData.deadline,
                status: status || oldData.status,
                description: description || oldData.description
              }
            }
          };
        } catch (err) {
          logError('editCompetition', err, body);
          return { success: false, error: 'editCompetition failed: ' + err.message };
        }
      }

      // ============================================================
      //  DELETE COMPETITION (Admin-only, soft delete by archiving)
      // ============================================================
      function deleteCompetition(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin) {
            return { success: false, error: 'Отказан достъп: Само администратори могат да изтриват конкурси.' };
          }

          var competitionId = String(body.id || '').trim();
          if (!competitionId) return { success: false, error: 'Missing competition ID' };

          var sheet = getCompetitionsSheet();
          var data = sheet.getDataRange().getValues();
          var rowFound = -1;

          for (var i = 1; i < data.length; i++) {
            if (String(data[i][COMP_COL.ID - 1] || '').trim() === competitionId) {
              rowFound = i;
              break;
            }
          }

          if (rowFound === -1) {
            return { success: false, error: 'Конкурсът не е намерен.' };
          }

          // Soft delete: mark as archived instead of removing
          var row = data[rowFound];
          var curCompStatus = normalizeCompetitionStatus_(row[COMP_COL.STATUS - 1]);
          if (!validateCompTransition_(curCompStatus, 'archived')) {
            return { success: false, error: 'Невалиден преход: ' + curCompStatus + ' → archived. Допустими: ' + (COMP_TRANSITIONS[curCompStatus] || []).join(', ') };
          }
          row[COMP_COL.STATUS - 1] = 'archived';
          sheet.getRange(rowFound + 1, 1, 1, COMP_TOTAL_COLS).setValues([row]);

          // Update competition.json in Drive
          var folderId = String(row[COMP_COL.FOLDER_ID - 1] || '').trim();
          if (folderId) {
            try {
              var folder = DriveApp.getFolderById(folderId);
              var files = folder.getFilesByName('competition.json');
              if (files.hasNext()) {
                var metaFile = files.next();
                var metadata = JSON.parse(metaFile.getBlob().getDataAsString());
                metadata.status = 'archived';
                metadata.lastModified = nowISO();
                metadata.archivedBy = auth.userId;
                metaFile.setContent(JSON.stringify(metadata, null, 2));
              }
            } catch (folderErr) {
              console.warn('Could not update competition.json: ' + folderErr.message);
            }
          }

          // Invalidate cache & publish feed
          try { invalidateCache('COMPETITIONS'); } catch (_) {}
          try { publishCompetitionsFeed_(); } catch (_) {}

          return {
            success: true,
            data: { id: competitionId, status: 'archived' },
            message: 'Конкурсът е архивиран успешно.'
          };
        } catch (err) {
          logError('deleteCompetition', err, body);
          return { success: false, error: 'deleteCompetition failed: ' + err.message };
        }
      }

      // ============================================================
      //  ARCHIVE COMPETITION
      // ============================================================
      function archiveCompetition(body) {
        // Alias to deleteCompetition (soft delete by archiving)
        return deleteCompetition(body);
      }

      // ── Per-execution memo for getCompetitions mapped result ──────────────
      // Building the mapped array (JSON-parsing budgetByDirection, normalizing
      // statuses, sorting) is O(N) per call. Inside a single batchApi execution
      // or getCompetitionPanel call this loop would run 2-3 times. Cache keyed
      // by variant (isAdmin + activeOnly) + competitions data-version.
      var _compMappedMemo_ = {};

      function getCompetitions(body) {
        try {
          body = body || {};
          // notModified short-circuit (see _ifVersionsMatch_).
          var _nm = _ifVersionsMatch_(body, ['competitions']);
          if (_nm) return _nm;
          var auth = resolveAuthContext(body);
          var isAdmin = auth.isAdmin;
          var activeOnly = body.activeOnly === true || body.activeOnly === 'true';
          var forceRefresh = body.forceRefresh === true || body.forceRefresh === 'true';

          // Per-execution memo check: same variant + same competitions version.
          var _cmDv = getDataVersions_().competitions;
          var _cmKey = (isAdmin ? 'a' : 'u') + ':' + (activeOnly ? '1' : '0') + ':' + _cmDv;
          if (!forceRefresh && _compMappedMemo_[_cmKey]) return _compMappedMemo_[_cmKey];

          var source = getOrCacheCompetitions(forceRefresh);
          var competitions = [];

          for (var i = 0; i < source.length; i++) {
            var c = source[i] || {};
            var normalizedStatus = normalizeCompetitionStatus_(c.status);
            if (activeOnly && !isAdmin && !shouldExposeCompetitionToApplicant_(c)) continue;
            // Compute total budget from the per-direction JSON map. Sheet stores
            // {direction: amount, ...} as a JSON string; surface a numeric total
            // so the dashboard briefing can render the budget hero without
            // re-parsing on every render.
            var _bbd = c.budgetByDirection;
            var _budgetTotal = 0;
            try {
              var _parsed = (typeof _bbd === 'string' && _bbd) ? JSON.parse(_bbd) : (_bbd && typeof _bbd === 'object' ? _bbd : null);
              if (_parsed && typeof _parsed === 'object' && !Array.isArray(_parsed)) {
                Object.keys(_parsed).forEach(function(k) { _budgetTotal += Number(_parsed[k]) || 0; });
              } else if (typeof _parsed === 'number') {
                _budgetTotal = _parsed;
              }
            } catch (_) { _budgetTotal = 0; }
            competitions.push({
              id: String(c.id || ''),
              name: String(c.name || ''),
              deadline: String(c.deadline || c.dateEnd || ''),
              dateEnd: String(c.dateEnd || c.deadline || ''),
              status: normalizedStatus,
              created: String(c.created || ''),
              description: String(c.description || ''),
              folderId: String(c.folderId || ''),
              // Surfaced for dashboard briefing context (BPMN / Конкурсна сесия):
              year: String(c.year || ''),
              callType: String(c.callType || ''),
              openDate: String(c.openDate || ''),
              startDate: String(c.openDate || c.created || ''),
              directions: String(c.directions || ''),
              budgetByDirection: String(c.budgetByDirection || ''),
              budget: _budgetTotal,
              totalBudget: _budgetTotal
            });
          }
          competitions.sort(function(a, b) {
            var da = new Date(a.deadline || 0).getTime() || 0;
            var db = new Date(b.deadline || 0).getTime() || 0;
            return da - db;
          });

          var result = {
            success: true,
            competitions: competitions,
            meta: {
              total: competitions.length,
              isAdmin: isAdmin,
              activeOnly: activeOnly
            }
          };
          _compMappedMemo_[_cmKey] = result;
          return result;
        } catch (err) {
          return { success: false, error: 'getCompetitions failed: ' + err.message };
        }
      }

      function getPublicCompetitions(body) {
        try {
          body = body || {};
          // notModified short-circuit — must run BEFORE delegating to
          // getCompetitions so the tiny payload is returned without rebuilding.
          var _nm = _ifVersionsMatch_(body, ['competitions']);
          if (_nm) return _nm;
          var forceRefresh = body.forceRefresh === true || body.forceRefresh === 'true';
          return getCompetitions({
            activeOnly: true,
            forceRefresh: forceRefresh,
            isAdmin: false,
            userId: extractUserId(body) || ''
          });
        } catch (err) {
          return { success: false, error: 'getPublicCompetitions failed: ' + err.message };
        }
      }

      // ============================================================
      //  REVIEWER MANAGEMENT
      // ============================================================

      function normalizeReviewerEmails_(reviewers) {
        var arr = [];
        if (Array.isArray(reviewers)) arr = reviewers;
        else if (reviewers != null) arr = String(reviewers).split(/[\n,;]+/);

        var seen = {};
        var normalized = [];
        arr.forEach(function(item) {
          var raw = item && typeof item === 'object' ? (item.email || item.value || '') : item;
          var email = String(raw || '').toLowerCase().trim();
          if (!email || seen[email]) return;
          seen[email] = true;
          normalized.push(email);
        });
        return normalized;
      }

      function findReviewerRow_(sheet, email, competitionId, formId) {
        var data = sheet.getDataRange().getValues();
        var targetEmail = String(email || '').toLowerCase().trim();
        var targetCompetition = String(competitionId || '').trim();
        var targetFormId = String(formId || '').trim();

        for (var i = 1; i < data.length; i++) {
          var row = data[i];
          var rowEmail = String(row[REV_COL.EMAIL - 1] || '').toLowerCase().trim();
          var rowCompetition = String(row[REV_COL.COMPETITION - 1] || '').trim();
          var rowFormId = String(row[REV_COL.FORM_ID - 1] || '').trim();

          if (rowEmail !== targetEmail) continue;
          if (targetCompetition && rowCompetition && rowCompetition !== targetCompetition) continue;
          if (targetFormId && rowFormId && rowFormId !== targetFormId) continue;

          return { rowIndex: i + 1, rowData: row.slice() };
        }
        return null;
      }

      function findReviewerById_(sheet, reviewerId) {
        var targetId = String(reviewerId || '').trim();
        if (!targetId) return null;
        // PERFORMANCE: read only the ID column to locate the row, then a single
        // targeted row-range read. Mirrors the _monFindById_ optimization \u2014
        // avoids pulling all REV_TOTAL_COLS columns (incl. JSON history blobs)
        // for every lookup. ~10\u201350x faster on warm Reviewers sheets and a
        // hot path for confirm/finalize/assign reviewer flows.
        var lastRow = sheet.getLastRow();
        if (lastRow < 2) return null;
        var idCol = sheet.getRange(2, REV_COL.ID, lastRow - 1, 1).getValues();
        for (var i = 0; i < idCol.length; i++) {
          if (String(idCol[i][0] || '').trim() === targetId) {
            var rIdx = i + 2; // 1-based + header
            var rowData = sheet.getRange(rIdx, 1, 1, REV_TOTAL_COLS).getValues()[0];
            return { rowIndex: rIdx, rowData: rowData };
          }
        }
        return null;
      }

      // ============================================================
      //  validateReviewerName_(raw)
      //  Returns { ok, error?, name? }. Required: ≥2 word parts, each ≥2
      //  chars, Cyrillic or Latin letters (hyphen / apostrophe allowed).
      //  Mirrored on the frontend by `validateFullName` in js/utils.js.
      // ============================================================
      function validateReviewerName_(raw) {
        var v = String(raw || '').trim().replace(/\s+/g, ' ');
        if (!v) return { ok: false, error: 'Името на рецензента е задължително.' };
        var parts = v.split(' ');
        if (parts.length < 2) {
          return { ok: false, error: 'Въведете поне две имена (име и фамилия) за рецензента.' };
        }
        var wordRe = /^[A-Za-z\u0400-\u04FF][A-Za-z\u0400-\u04FF\-’']{1,}$/;
        for (var i = 0; i < parts.length; i++) {
          if (!wordRe.test(parts[i])) {
            return { ok: false, error: 'Невалиден символ в името на рецензента: „' + parts[i] + '".' };
          }
        }
        return { ok: true, name: parts.join(' ') };
      }

      function addReviewer(body) {
        try {
          body = body || {};
          var auth    = resolveAuthContext(body);
          var isAdmin = auth.isAdmin;
          if (!isAdmin) {
            return { success: false, error: 'Отказан достъп: Само администратори' };
          }

          var email = String(body.email || '').toLowerCase().trim();
          var name = String(body.name || '').trim();
          var competitionId = String(body.competitionId || '').trim();
          var notes = String(body.notes || '').trim();

          if (!email || !competitionId) {
            return { success: false, error: 'Необходими са имейл и избран конкурс.' };
          }
          if (!isValidEmail(email)) {
            return { success: false, error: 'Невалиден имейл адрес за рецензент.' };
          }
          // Name required: must be at least two words (име + фамилия).
          var nameCheck = validateReviewerName_(name);
          if (!nameCheck.ok) return { success: false, error: nameCheck.error };
          name = nameCheck.name;

          var sheet = getReviewersSheet();
          var existing = findReviewerRow_(sheet, email, competitionId, '');
          if (existing && !String(existing.rowData[REV_COL.FORM_ID - 1] || '').trim()) {
            var existingRow = existing.rowData.slice();
            while (existingRow.length < REV_TOTAL_COLS) existingRow.push('');
            existingRow[REV_COL.NAME - 1] = name;
            if (notes) existingRow[REV_COL.NOTES - 1] = notes;
            if (body.reviewerFee !== undefined) existingRow[REV_COL.REVIEWER_FEE - 1] = Number(body.reviewerFee || 0);
            if (body.reviewerFeeCurrency !== undefined) existingRow[REV_COL.REVIEWER_FEE_CURRENCY - 1] = String(body.reviewerFeeCurrency || 'EUR');
            safeSetRow_(sheet, existing.rowIndex, existingRow, REV_TOTAL_COLS);
            var existingId = String(existingRow[REV_COL.ID - 1] || '').trim();
            return {
              success: true,
              id: existingId,
              // Phase 5: return the full reviewer object so the frontend can
              // replace its optimistic placeholder without an extra round-trip.
              reviewer: {
                id: existingId,
                email: email,
                name: name,
                competitionId: competitionId,
                notes: notes,
                status: String(existingRow[REV_COL.STATUS - 1] || 'pending'),
                reviewerFee: Number(existingRow[REV_COL.REVIEWER_FEE - 1] || 0),
                reviewerFeeCurrency: String(existingRow[REV_COL.REVIEWER_FEE_CURRENCY - 1] || 'EUR')
              },
              alreadyExisted: true,
              message: 'Рецензентът вече съществува и беше обновен.'
            };
          }

          var id = generateId();
          var now = nowISO();

          var row = new Array(REV_TOTAL_COLS).fill('');
          row[REV_COL.ID - 1] = id;
          row[REV_COL.EMAIL - 1] = email;
          row[REV_COL.NAME - 1] = name;
          row[REV_COL.COMPETITION - 1] = competitionId;
          row[REV_COL.FORM_ID - 1] = '';
          row[REV_COL.CONSENT - 1] = '';
          row[REV_COL.REVIEW - 1] = '';
          row[REV_COL.SCORE - 1] = '';
          row[REV_COL.STATUS - 1] = 'pending';
          row[REV_COL.SUBMITTED - 1] = '';
          row[REV_COL.CREATED - 1] = now;
          row[REV_COL.NOTES - 1] = notes;
          row[REV_COL.REVIEWER_FEE - 1] = Number(body.reviewerFee || 0);
          row[REV_COL.REVIEWER_FEE_CURRENCY - 1] = String(body.reviewerFeeCurrency || 'EUR');

          sheet.appendRow(row);
          try { logTransaction('ADD_REVIEWER', 'Reviewer', id, { email: email, competitionId: competitionId }); } catch (_) {}

          // Send email notification to the newly added reviewer
          var emailSent = false;
          try {
            emailSent = !!notifyReviewerAdded_(email, name, competitionId, notes);
          } catch (mailErr) {
            console.error('addReviewer email notification failed for ' + email + ': ' + mailErr.message);
            try { logError('addReviewer_notifyReviewer', mailErr, { email: email, competitionId: competitionId }); } catch (_) {}
          }

          return {
            success: true,
            id: id,
            reviewer: { id: id, email: email, name: name, competitionId: competitionId, notes: notes, reviewerFee: Number(body.reviewerFee || 0), reviewerFeeCurrency: String(body.reviewerFeeCurrency || 'EUR') },
            message: 'Рецензент добавен успешно' + (emailSent ? ' и е изпратено имейл уведомление.' : '.'),
            emailSent: emailSent
          };
        } catch (err) {
          logError('addReviewer', err, body);
          return { success: false, error: 'addReviewer failed: ' + err.message };
        }
      }

      // ── Per-execution reviewers list memo ──
      // getReviewers is called on every admin page load and on reviewer-tab
      // switches. Without a cache, each call reads the full Reviewers sheet
      // and builds 10+ object fields per row across potentially hundreds of
      // rows. The memo collapses N calls/execution into 1 sheet read.
      var _reviewersListMemo_ = null;
      var _reviewersListMemoDv_ = 0;
      function getReviewers(body) {
        try {
          body = body || {};
          // notModified short-circuit. Reviewer list is bound to dv.reviewers.
          var _nm = _ifVersionsMatch_(body, ['reviewers']);
          if (_nm) return _nm;
          var auth    = resolveAuthContext(body);
          var isAdmin = auth.isAdmin;
          if (!isAdmin) {
            return { success: false, error: 'Отказан достъп', reviewers: [] };
          }

          // CacheService fast-path: version-keyed blob avoids the full sheet
          // read until the Reviewers sheet actually changes.
          var dv = getDataVersions_();
          var cacheKey = 'rv:v2:' + dv.reviewers;
          var sc = _scriptCache_();
          if (!body.forceRefresh) {
            // Per-execution memo — fastest path, no bridge crossing.
            if (_reviewersListMemo_ && _reviewersListMemoDv_ === dv.reviewers) {
              return _reviewersListMemo_;
            }
            try {
              var cached = sc.get(cacheKey);
              if (cached) {
                var parsed = JSON.parse(cached);
                if (parsed && parsed.success) {
                  _reviewersListMemo_ = parsed;
                  _reviewersListMemoDv_ = dv.reviewers;
                  parsed.cached = true;
                  return parsed;
                }
              }
            } catch (_) {}
          }

          var sheet = getReviewersSheet();
          // Use _cachedSheetData_ so the raw sheet data is read at most once
          // per execution, even if called without CacheService primed.
          var data = _cachedSheetData_(sheet);
          var competitionId = String(body.competitionId || '').trim();
          var reviewers = [];

          for (var i = 1; i < data.length; i++) {
            var row = data[i];
            var id = String(row[REV_COL.ID - 1] || '').trim();
            if (!id) continue;

            if (competitionId && String(row[REV_COL.COMPETITION - 1] || '').trim() !== competitionId) continue;

            reviewers.push({
              id: id,
              email: String(row[REV_COL.EMAIL - 1] || ''),
              name: String(row[REV_COL.NAME - 1] || ''),
              competitionId: String(row[REV_COL.COMPETITION - 1] || ''),
              formId: String(row[REV_COL.FORM_ID - 1] || ''),
              consent: String(row[REV_COL.CONSENT - 1] || ''),
              review: String(row[REV_COL.REVIEW - 1] || ''),
              score: String(row[REV_COL.SCORE - 1] || ''),
              status: String(row[REV_COL.STATUS - 1] || ''),
              submitted: String(row[REV_COL.SUBMITTED - 1] || ''),
              created: String(row[REV_COL.CREATED - 1] || ''),
              notes: String(row[REV_COL.NOTES - 1] || ''),
              reviewerFee: Number(row[REV_COL.REVIEWER_FEE - 1] || 0),
              reviewerFeeCurrency: String(row[REV_COL.REVIEWER_FEE_CURRENCY - 1] || 'EUR')
            });
          }

          reviewers.sort(function(a, b) {
            var ad = String(a.created || '');
            var bd = String(b.created || '');
            if (ad === bd) return String(a.name || '').localeCompare(String(b.name || ''));
            return bd.localeCompare(ad);
          });

          var result = { success: true, reviewers: reviewers, count: reviewers.length };
          _reviewersListMemo_ = result;
          _reviewersListMemoDv_ = dv.reviewers;
          try { sc.put(cacheKey, JSON.stringify(result), 1800); } catch (_) {}
          return result;
        } catch (err) {
          logError('getReviewers', err, body);
          return { success: false, error: 'getReviewers failed: ' + err.message, reviewers: [] };
        }
      }

      /**
       * getReviewerBudgetSummary — aggregate reviewer costs per competition.
       * Returns total reviewer fees (EUR + BGN), count of reviewers, and
       * per-competition breakdown. Admin-only.
       */
      function getReviewerBudgetSummary(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin) {
            return { success: false, error: 'Отказан достъп: Само администратори' };
          }

          var sheet = getReviewersSheet();
          var data = _cachedSheetData_(sheet);
          var competitionId = String(body.competitionId || '').trim();

          var summary = {
            totalReviewers: 0,
            totalFeeEUR: 0,
            totalFeeBGN: 0,
            byCompetition: {},
            byStatus: { pending: 0, consented: 0, reviewed: 0, declined: 0, replaced: 0 }
          };

          for (var i = 1; i < data.length; i++) {
            var row = data[i];
            var id = String(row[REV_COL.ID - 1] || '').trim();
            if (!id) continue;

            var compId = String(row[REV_COL.COMPETITION - 1] || '').trim();
            if (competitionId && compId !== competitionId) continue;

            var fee = Number(row[REV_COL.REVIEWER_FEE - 1] || 0);
            var feeCur = String(row[REV_COL.REVIEWER_FEE_CURRENCY - 1] || 'EUR').toUpperCase();
            var status = String(row[REV_COL.STATUS - 1] || '').toLowerCase();

            summary.totalReviewers++;
            if (feeCur === 'EUR') summary.totalFeeEUR += fee;
            else summary.totalFeeBGN += fee;

            // Count by status
            if (summary.byStatus.hasOwnProperty(status)) summary.byStatus[status]++;

            // Per-competition breakdown
            if (compId) {
              if (!summary.byCompetition[compId]) {
                summary.byCompetition[compId] = { reviewerCount: 0, feeEUR: 0, feeBGN: 0 };
              }
              summary.byCompetition[compId].reviewerCount++;
              if (feeCur === 'EUR') summary.byCompetition[compId].feeEUR += fee;
              else summary.byCompetition[compId].feeBGN += fee;
            }
          }

          return { success: true, summary: summary };
        } catch (err) {
          logError('getReviewerBudgetSummary', err, body);
          return { success: false, error: 'getReviewerBudgetSummary failed: ' + err.message };
        }
      }

      function updateReviewer(body) {
        try {
          var auth    = resolveAuthContext(body);
          var isAdmin = auth.isAdmin;
          if (!isAdmin) {
            return { success: false, error: 'Отказан достъп: Само администратори' };
          }

          var sheet = getReviewersSheet();
          var found = findReviewerById_(sheet, body.id);
          if (!found) return { success: false, error: 'Рецензент не намерен' };

          var row = found.rowData.slice();
          while (row.length < REV_TOTAL_COLS) row.push('');

          if (body.email != null) row[REV_COL.EMAIL - 1] = String(body.email).toLowerCase().trim();
          if (body.name != null) row[REV_COL.NAME - 1] = String(body.name).trim();
          if (body.competitionId != null) row[REV_COL.COMPETITION - 1] = String(body.competitionId).trim();
          if (body.status != null) {
            var _newStatus = String(body.status).toLowerCase().trim();
            var VALID_REVIEWER_STATUSES = ['pending','assigned','consented','reviewed','submitted','declined','inactive'];
            if (VALID_REVIEWER_STATUSES.indexOf(_newStatus) === -1) {
              return { success: false, error: 'Невалиден статус: ' + _newStatus + '. Разрешени: ' + VALID_REVIEWER_STATUSES.join(', ') };
            }
            row[REV_COL.STATUS - 1] = _newStatus;
          }
          if (body.notes != null) row[REV_COL.NOTES - 1] = String(body.notes).trim();
          if (body.reviewerFee != null) row[REV_COL.REVIEWER_FEE - 1] = Number(body.reviewerFee || 0);
          if (body.reviewerFeeCurrency != null) row[REV_COL.REVIEWER_FEE_CURRENCY - 1] = String(body.reviewerFeeCurrency || 'EUR');
          if (body.consent != null) row[REV_COL.CONSENT - 1] = String(body.consent).trim();
          if (body.review != null) row[REV_COL.REVIEW - 1] = String(body.review).trim();
          if (body.score != null) row[REV_COL.SCORE - 1] = String(body.score).trim();

          var oldStatus = String(found.rowData[REV_COL.STATUS - 1] || '').trim();
          safeSetRow_(sheet, found.rowIndex, row, REV_TOTAL_COLS);

          // Notify reviewer when status is set to 'consented' for the first time
          var newStatus = row[REV_COL.STATUS - 1];
          if (newStatus === 'consented' && oldStatus !== 'consented') {
            var notifyEmail = row[REV_COL.EMAIL - 1];
            var notifyName  = row[REV_COL.NAME  - 1];
            var notifyComp  = row[REV_COL.COMPETITION - 1];
            var emailSent   = false;
            try {
              emailSent = !!notifyReviewerConsented_(notifyEmail, notifyName, notifyComp);
            } catch (mailErr) {
              try { logError('updateReviewer_notifyConsented', mailErr, { email: notifyEmail }); } catch (_) {}
            }
            return { success: true, message: 'Рецензент обновен успешно', emailSent: emailSent };
          }

          return { success: true, message: 'Рецензент обновен успешно' };
        } catch (err) {
          return { success: false, error: 'updateReviewer failed: ' + err.message };
        }
      }

      function deleteReviewer(body) {
        try {
          var auth    = resolveAuthContext(body);
          var isAdmin = auth.isAdmin;
          if (!isAdmin) {
            return { success: false, error: 'Отказан достъп: Само администратори' };
          }

          var sheet = getReviewersSheet();
          var found = findReviewerById_(sheet, body.id);
          if (!found) return { success: false, error: 'Рецензент не намерен' };

          // Guard: prevent deletion of reviewers with active submitted reviews
          var _delStatus = String(found.rowData[REV_COL.STATUS - 1] || '').toLowerCase().trim();
          if (_delStatus === 'reviewed' || _delStatus === 'submitted') {
            return { success: false, error: 'Не може да изтриете рецензент с подадена рецензия. Първо анулирайте рецензията.' };
          }

          sheet.deleteRow(found.rowIndex);
          return { success: true, message: 'Рецензент изтрит успешно' };
        } catch (err) {
          return { success: false, error: 'deleteReviewer failed: ' + err.message };
        }
      }

      // ─────────────────────────────────────────────────────────────────────
      //  replaceReviewer — BPMN Process 4 / UC-21 (Reviewer Replacement)
      //  Handles the case where an assigned reviewer declines, becomes
      //  unavailable, or has a conflict of interest. Marks the existing row as
      //  'replaced', appends a new reviewer assignment, and logs the swap.
      //  Body: { formId, oldReviewerEmail, newReviewerEmail, newReviewerName?,
      //          reason?, userId, isAdmin }
      //  Returns: { success, oldRowIndex, newRowIndex } or error.
      // ─────────────────────────────────────────────────────────────────────
      function replaceReviewer(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin && auth.role !== ROLE_CKK && auth.role !== ROLE_RECTOR) {
            return { success: false, error: 'Нямате право да преназначавате рецензенти.' };
          }
          var formId = String(body.formId || '').trim();
          var oldEmail = String(body.oldReviewerEmail || '').toLowerCase().trim();
          var newEmail = String(body.newReviewerEmail || '').toLowerCase().trim();
          var newName  = String(body.newReviewerName || '').trim();
          var reason   = String(body.reason || 'Преназначаване').trim().slice(0, 1000);
          if (!formId)   return { success: false, error: 'Липсва formId.' };
          if (!oldEmail) return { success: false, error: 'Липсва имейл на стария рецензент.' };
          if (!newEmail) return { success: false, error: 'Липсва имейл на новия рецензент.' };
          if (!isValidEmail(newEmail)) return { success: false, error: 'Невалиден имейл на новия рецензент.' };
          if (oldEmail === newEmail)   return { success: false, error: 'Новият и старият рецензент са един и същ.' };

          // CoI guard: new reviewer must not be the applicant or a team member.
          try {
            var appSheet = getSheet();
            var appFound = findRowByID(appSheet, formId);
            if (!appFound) return { success: false, error: 'Заявлението не е намерено.' };
            var applicantEmailLc = String(appFound.rowData[COL.USER_EMAIL - 1] || '').toLowerCase().trim();
            if (applicantEmailLc && applicantEmailLc === newEmail) {
              return { success: false, error: 'Новият рецензент не може да е кандидатът.' };
            }
            var team = [];
            try { team = JSON.parse(String(appFound.rowData[COL.TEAM_MEMBERS - 1] || '[]')) || []; } catch (_) {}
            var teamHit = team.some(function(m){ return String((m && m.email) || '').toLowerCase().trim() === newEmail; });
            if (teamHit) return { success: false, error: 'Новият рецензент е член на проектния екип (конфликт на интереси).' };
          } catch (_) {}

          var revSheet = getReviewersSheet();
          var data = revSheet.getDataRange().getValues();
          var oldRowIdx = -1;
          for (var i = 1; i < data.length; i++) {
            var rE = String(data[i][REV_COL.EMAIL - 1] || '').toLowerCase().trim();
            var rF = String(data[i][REV_COL.FORM_ID - 1] || '').trim();
            if (rE === oldEmail && rF === formId) { oldRowIdx = i + 1; break; }
          }
          if (oldRowIdx < 0) return { success: false, error: 'Старият рецензент не е намерен за това заявление.' };

          var oldRow = data[oldRowIdx - 1].slice();
          var oldStatus = String(oldRow[REV_COL.STATUS - 1] || '').toLowerCase().trim();
          if (oldStatus === 'reviewed' || oldStatus === 'submitted') {
            return { success: false, error: 'Не може да преназначите рецензент с вече подадена рецензия.' };
          }

          // Refuse if new reviewer is already assigned to this form.
          for (var j = 1; j < data.length; j++) {
            if (String(data[j][REV_COL.EMAIL - 1] || '').toLowerCase().trim() === newEmail
            && String(data[j][REV_COL.FORM_ID - 1] || '').trim() === formId) {
              return { success: false, error: 'Този рецензент вече е назначен за заявлението.' };
            }
          }

          var now = nowISO();
          // Mark old row as replaced (audit trail preserved).
          oldRow[REV_COL.STATUS - 1] = 'replaced';
          oldRow[REV_COL.SUBMITTED - 1] = now;
          // Stash reason in REVIEW column without clobbering legitimate review text.
          var existingReview = String(oldRow[REV_COL.REVIEW - 1] || '');
          var note = '[REPLACED ' + now + ' by ' + (auth.userId || 'system') + '] ' + reason;
          oldRow[REV_COL.REVIEW - 1] = existingReview ? (existingReview + '\n' + note) : note;
          while (oldRow.length < REV_TOTAL_COLS) oldRow.push('');
          safeSetRow_(revSheet, oldRowIdx, oldRow, REV_TOTAL_COLS);

          // Build new reviewer row (clone competition/area metadata from old row).
          var newRow = new Array(REV_TOTAL_COLS).fill('');
          newRow[REV_COL.ID - 1]          = 'REV-' + Utilities.getUuid().replace(/-/g, '').substring(0, 12).toUpperCase();
          newRow[REV_COL.NAME - 1]        = newName || newEmail;
          newRow[REV_COL.EMAIL - 1]       = newEmail;
          newRow[REV_COL.FORM_ID - 1]     = formId;
          newRow[REV_COL.COMPETITION - 1] = String(oldRow[REV_COL.COMPETITION - 1] || '');
          // Some sheets define an AREA column; preserve if present.
          try { if (REV_COL.AREA) newRow[REV_COL.AREA - 1] = String(oldRow[REV_COL.AREA - 1] || ''); } catch (_) {}
          newRow[REV_COL.STATUS - 1]      = 'pending';
          newRow[REV_COL.ASSIGNED - 1]    = now;
          revSheet.appendRow(newRow);

          try { logTransaction('REPLACE_REVIEWER', 'Application', formId, { oldEmail: maskEmail_(oldEmail), newEmail: maskEmail_(newEmail), reason: reason.slice(0, 200) }); } catch (_) {}

          // Notify the new reviewer (best-effort).
          try {
            if (typeof notifyReviewerAssigned_ === 'function') {
              notifyReviewerAssigned_(newEmail, newName || newEmail, String(oldRow[REV_COL.COMPETITION - 1] || ''), formId);
            }
          } catch (_) {}

          return {
            success: true,
            message: 'Рецензентът е преназначен успешно.',
            oldRowIndex: oldRowIdx,
            newReviewerEmail: newEmail
          };
        } catch (err) {
          try { logError('replaceReviewer', err, body); } catch (_) {}
          return { success: false, error: 'replaceReviewer failed: ' + err.message };
        }
      }

      // Bulk delete: remove many reviewer rows in a single call. Avoids the
      // N round-trips the UI used to make when removing every assignment for
      // one person. Accepts body.ids = [string, ...] OR body.email +
      // body.competitionId (optional) — the latter deletes every assignment
      // for that reviewer (optionally scoped to a competition).
      function bulkDeleteReviewers(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin) return { success: false, error: 'Отказан достъп: Само администратори' };

          var sheet = getReviewersSheet();
          var data  = sheet.getDataRange().getValues();
          var idSet = {};
          if (Array.isArray(body.ids)) {
            body.ids.forEach(function(x) { var s = String(x || '').trim(); if (s) idSet[s] = 1; });
          }
          var byEmail = String(body.email || '').toLowerCase().trim();
          var byComp  = String(body.competitionId || '').trim();

          // Walk bottom-up so deleteRow indices stay valid
          var deleted = 0;
          for (var i = data.length - 1; i >= 1; i--) {
            var row = data[i];
            var id = String(row[REV_COL.ID - 1] || '').trim();
            if (!id) continue;
            var match = false;
            if (idSet[id]) match = true;
            else if (byEmail) {
              var e = String(row[REV_COL.EMAIL - 1] || '').toLowerCase().trim();
              if (e === byEmail) {
                if (!byComp || String(row[REV_COL.COMPETITION - 1] || '').trim() === byComp) match = true;
              }
            }
            if (!match) continue;
            sheet.deleteRow(i + 1);
            deleted++;
          }
          try { logTransaction('BULK_DELETE_REVIEWERS', auth.userId, 'Reviewer', { deleted: deleted, ids: Object.keys(idSet), email: byEmail, competitionId: byComp }); } catch (_) {}
          return { success: true, deleted: deleted };
        } catch (err) {
          logError('bulkDeleteReviewers', err, body);
          return { success: false, error: 'bulkDeleteReviewers failed: ' + err.message };
        }
      }

      // ── Reviewer self-service: submit review + get assigned forms ──

      /**
       * BPMN 20 — Reviewer accepts the assignment (consent + optional CoI declaration).
       * Starts the 10-day clock from this moment (per regulation, art. … "ако е изразил
       * съгласие, започват да текат 10 дни"). Idempotent: re-consenting preserves the
       * original consentDate.
       *
       * Body: { reviewerEmail, formId, coiDeclared?:bool, userId, isAdmin? }
       */
      function consentToReview(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          var reviewerEmail = String(body.reviewerEmail || body.email || '').toLowerCase().trim();
          var formId = String(body.formId || '').trim();
          if (!reviewerEmail) return { success: false, error: 'Missing reviewer email' };
          if (!formId) return { success: false, error: 'Missing formId' };
          if (!auth.isAdmin && auth.userId && auth.userId !== reviewerEmail) {
            return { success: false, error: 'Нямате права да потвърждавате чужда покана.' };
          }

          var revSheet = getReviewersSheet();
          var data = revSheet.getDataRange().getValues();
          var foundIndex = -1;
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][REV_COL.EMAIL - 1] || '').toLowerCase().trim() === reviewerEmail
                && String(data[i][REV_COL.FORM_ID - 1] || '').trim() === formId) {
              foundIndex = i + 1; break;
            }
          }
          if (foundIndex < 0) return { success: false, error: 'Поканата не е намерена.' };

          var row = data[foundIndex - 1].slice();
          while (row.length < REV_TOTAL_COLS) row.push('');
          var curStatus = String(row[REV_COL.STATUS - 1] || '').toLowerCase().trim();
          if (curStatus === 'reviewed' || curStatus === 'submitted') {
            return { success: false, error: 'Рецензията вече е подадена.' };
          }
          if (curStatus === 'declined') {
            return { success: false, error: 'Поканата е отказана и не може да бъде потвърдена.' };
          }
          if (curStatus === 'replaced') {
            return { success: false, error: 'Назначението е заменено.' };
          }

          // Preserve original consentDate on idempotent re-consent.
          var prevConsent = {};
          try { prevConsent = JSON.parse(String(row[REV_COL.CONSENT - 1] || '{}')); } catch (_) {}
          var now = nowISO();
          var consentDate = prevConsent.consentDate || now;
          var consentObj = {
            consented: true,
            consentDate: consentDate,
            coiDeclared: !!body.coiDeclared,
            declaredAt: now
          };
          row[REV_COL.CONSENT - 1] = JSON.stringify(consentObj);
          if (curStatus !== 'consented') row[REV_COL.STATUS - 1] = 'consented';

          safeSetRow_(revSheet, foundIndex, row, REV_TOTAL_COLS);

          try { notifyReviewerConsented_(reviewerEmail,
            String(row[REV_COL.NAME - 1] || ''),
            String(row[REV_COL.COMPETITION - 1] || '')); } catch (_) {}

          try { logTransaction('CONSENT_REVIEW', reviewerEmail, 'Reviewer',
            { formId: formId, consentDate: consentDate, coiDeclared: !!body.coiDeclared }); } catch (_) {}

          // Return derived deadline so the UI shows it instantly without a refetch.
          var deadlineMs = new Date(consentDate).getTime() + 10 * 24 * 60 * 60 * 1000;
          return {
            success: true,
            consentDate: consentDate,
            reviewDeadline: new Date(deadlineMs).toISOString(),
            status: 'consented',
            message: 'Поканата е приета. Срокът за рецензия е 10 дни.'
          };
        } catch (err) {
          logError('consentToReview', err, body);
          return { success: false, error: 'consentToReview failed: ' + err.message };
        }
      }

      /**
       * BPMN 20 (alternate path) — Reviewer declines the invitation BEFORE consenting.
       * Differs from `submitReview` decline only in semantics & log action; both
       * routes set STATUS='declined' so downstream replacement (BPMN 21) can fire.
       *
       * Body: { reviewerEmail, formId, reason, userId, isAdmin? }
       */
      function declineInvitation(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          var reviewerEmail = String(body.reviewerEmail || body.email || '').toLowerCase().trim();
          var formId = String(body.formId || '').trim();
          var reason = String(body.reason || '').trim();
          if (!reviewerEmail) return { success: false, error: 'Missing reviewer email' };
          if (!formId) return { success: false, error: 'Missing formId' };
          if (!reason || reason.length < 10) return { success: false, error: 'Моля, посочете причина (мин. 10 символа).' };
          if (!auth.isAdmin && auth.userId && auth.userId !== reviewerEmail) {
            return { success: false, error: 'Нямате права да отказвате чужда покана.' };
          }

          var revSheet = getReviewersSheet();
          var data = revSheet.getDataRange().getValues();
          var foundIndex = -1;
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][REV_COL.EMAIL - 1] || '').toLowerCase().trim() === reviewerEmail
                && String(data[i][REV_COL.FORM_ID - 1] || '').trim() === formId) {
              foundIndex = i + 1; break;
            }
          }
          if (foundIndex < 0) return { success: false, error: 'Поканата не е намерена.' };

          var row = data[foundIndex - 1].slice();
          while (row.length < REV_TOTAL_COLS) row.push('');
          var curStatus = String(row[REV_COL.STATUS - 1] || '').toLowerCase().trim();
          if (curStatus === 'reviewed' || curStatus === 'submitted') {
            return { success: false, error: 'Рецензията вече е подадена.' };
          }
          var now = nowISO();
          row[REV_COL.STATUS - 1] = 'declined';
          row[REV_COL.SUBMITTED - 1] = now;
          row[REV_COL.SCORE - 1] = '0';
          row[REV_COL.REVIEW - 1] = JSON.stringify({ decline: true, reason: reason, declinedAt: now });
          safeSetRow_(revSheet, foundIndex, row, REV_TOTAL_COLS);

          try { logTransaction('DECLINE_INVITATION', reviewerEmail, 'Reviewer',
            { formId: formId, reason: reason }); } catch (_) {}

          return { success: true, status: 'declined', message: 'Поканата е отказана.' };
        } catch (err) {
          logError('declineInvitation', err, body);
          return { success: false, error: 'declineInvitation failed: ' + err.message };
        }
      }

      function submitReview(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          var reviewerEmail = String(body.reviewerEmail || body.email || '').toLowerCase().trim();
          var formId = String(body.formId || '').trim();
          var review = String(body.review || '').trim();
          var score = body.score != null ? String(body.score) : '';
          var consent = body.consent;

          if (!reviewerEmail) return { success: false, error: 'Missing reviewer email' };
          if (!formId) return { success: false, error: 'Missing formId' };

          // SECURITY: Verify the authenticated user IS the reviewer they claim to be,
          // unless they are an admin (who may act on behalf of reviewers).
          if (!auth.isAdmin && auth.userId && auth.userId !== reviewerEmail) {
            return { success: false, error: 'Нямате права да подавате рецензия от името на друг рецензент.' };
          }

          var revSheet = getReviewersSheet();
          var data = revSheet.getDataRange().getValues();
          var foundIndex = -1;

          for (var i = 1; i < data.length; i++) {
            var rowEmail = String(data[i][REV_COL.EMAIL - 1] || '').toLowerCase().trim();
            var rowFormId = String(data[i][REV_COL.FORM_ID - 1] || '').trim();
            if (rowEmail === reviewerEmail && rowFormId === formId) {
              foundIndex = i + 1;
              break;
            }
          }

          if (foundIndex < 0) return { success: false, error: 'Reviewer assignment not found' };

          var row = data[foundIndex - 1].slice();
          while (row.length < REV_TOTAL_COLS) row.push('');
          var curStatus = String(row[REV_COL.STATUS - 1] || '').toLowerCase().trim();
          var now = nowISO();

          // Block submission for replaced assignments — they can no longer act on this form.
          if (curStatus === 'replaced') {
            return { success: false, error: 'Назначението е заменено и не може да бъде редактирано.' };
          }

          // Handle decline
          if (body.decline === true || body.decline === 'true') {
            row[REV_COL.STATUS - 1] = 'declined';
            row[REV_COL.SUBMITTED - 1] = now;
            if (review) row[REV_COL.REVIEW - 1] = review;
            row[REV_COL.SCORE - 1] = '0';
            safeSetRow_(revSheet, foundIndex, row, REV_TOTAL_COLS);
            logTransaction('DECLINE_REVIEW', 'Reviewer', reviewerEmail, { formId: formId });
            return { success: true, message: 'Рецензията е отказана' };
          }

          // Handle consent update — record consent date for 10-day review deadline tracking
          if (consent === true || consent === 'true') {
            var prevConsent = String(row[REV_COL.CONSENT - 1] || '');
            row[REV_COL.CONSENT - 1] = JSON.stringify({ consented: true, consentDate: now });
            if (String(row[REV_COL.STATUS - 1]) === 'pending') {
              row[REV_COL.STATUS - 1] = 'consented';
            }
            // Notify about consent and 10-day deadline
            var _rvName = String(row[REV_COL.NAME - 1] || '').trim();
            var _rvComp = String(row[REV_COL.COMPETITION - 1] || '').trim();
            try { notifyReviewerConsented_(reviewerEmail, _rvName, _rvComp); } catch (_) {}
          }

          // Handle review submission (supports structured JSON review with rubric scores)
          // ── BPMN 22: reviewer must have consented before submitting a review ──
          if (review) {
            var consentData = {};
            try { consentData = JSON.parse(String(row[REV_COL.CONSENT - 1] || '{}')); } catch (_) {}
            // Enforce: only 'consented' (or already 'reviewed') status can submit a review.
            // 'pending'/'assigned' reviewers who haven't used the BPMN consent flow are blocked.
            if (curStatus !== 'consented' && curStatus !== 'reviewed' && curStatus !== 'submitted' && !consentData.consented) {
              return { success: false, error: 'Рецензентът трябва да приеме поканата преди подаване на рецензия (BPMN стъпка 20).' };
            }
            var consentDateStr = consentData.consentDate || '';
            if (consentDateStr) {
              var consentDate = new Date(consentDateStr);
              var reviewDeadline = new Date(consentDate.getTime() + 10 * 24 * 60 * 60 * 1000);
              if (!isNaN(reviewDeadline.getTime()) && new Date() > reviewDeadline) {
                // Log warning but still allow submission (late review is better than no review)
                console.warn('[REVIEW_DEADLINE] Reviewer ' + reviewerEmail + ' submitted late for ' + formId + '. Deadline was: ' + reviewDeadline.toISOString());
              }
            }
            row[REV_COL.REVIEW - 1] = review;
            row[REV_COL.STATUS - 1] = 'reviewed';
            row[REV_COL.SUBMITTED - 1] = now;
          }
          if (score !== '') {
            row[REV_COL.SCORE - 1] = score;
          }

          safeSetRow_(revSheet, foundIndex, row, REV_TOTAL_COLS);

          // Check if all reviewers for this form have submitted → update form status to 'reviewed'
          // (declined reviewers count as "done" – they won't block the transition)
          // FIXED: process current row status correctly for both review and consent-only paths;
          // the 'review' flag only gates scoring aggregation, not status advance.
          var allReviewed = true;
          var reviewerCount = 0;
          for (var j = 1; j < data.length; j++) {
            if (String(data[j][REV_COL.FORM_ID - 1] || '').trim() === formId) {
              reviewerCount++;
              var rStatus;
              if (j + 1 === foundIndex) {
                // Use the row we just wrote (may be 'consented' or 'reviewed' or 'declined')
                rStatus = String(row[REV_COL.STATUS - 1] || '').toLowerCase().trim();
              } else {
                rStatus = String(data[j][REV_COL.STATUS - 1] || '').toLowerCase().trim();
              }
              if (rStatus !== 'reviewed' && rStatus !== 'submitted' && rStatus !== 'declined') {
                allReviewed = false;
              }
            }
          }

          if (allReviewed && reviewerCount > 0) {
            try {
              var appSheet = getSheet();
              var appFound = findRowByID(appSheet, formId);
              if (appFound && String(appFound.rowData[COL.STATUS - 1]) === 'in_review') {
                // ── Aggregate scores from all submitted reviewers (declined excluded) ──
                var _scores = [];
                for (var sj = 1; sj < data.length; sj++) {
                  if (String(data[sj][REV_COL.FORM_ID - 1] || '').trim() !== formId) continue;
                  var _rs = (sj + 1 === foundIndex) ? row : data[sj];
                  if (String(_rs[REV_COL.STATUS - 1] || '') !== 'reviewed') continue;
                  var _sv = parseFloat(String(_rs[REV_COL.SCORE - 1] || '0')) || 0;
                  _scores.push(_sv);
                }
                var _avg = _scores.length ? Math.round((_scores.reduce(function(a,b){return a+b;},0) / _scores.length) * 100) / 100 : 0;
                // FIXED: require at least 1 valid review (was hardcoded to ≥2, which blocked
                // single-reviewer competitions). Per-competition minReviewers can override this
                // via the competition config; for now the floor is 1 submitted review.
                var _minRequired = 1;
                var appRow = appFound.rowData.slice();
                while (appRow.length < TOTAL_COLS) appRow.push('');
                try {
                  var _compConfig = getCompetitionById_(String(appRow[COL.COMPETITION - 1] || ''), false);
                  if (_compConfig && _compConfig.minReviewers && Number(_compConfig.minReviewers) > 0) {
                    _minRequired = Number(_compConfig.minReviewers);
                  }
                } catch (_) {}
                var _hasMinReviews = _scores.length >= _minRequired;

                var history = safeParseJSON(appRow[COL.HISTORY - 1], []);
                history.push({ action: 'Всички рецензии са получени (' + reviewerCount + ' рецензент' + (reviewerCount === 1 ? '' : 'а') + ')', date: now, user: 'Система' });
                // Auto-advance reviewed → scored when min reviews exist; otherwise stop at reviewed.
                var _newAppStatus = _hasMinReviews ? 'scored' : 'reviewed';
                if (_hasMinReviews) {
                  appRow[COL.SCORE - 1] = _avg;
                  history.push({ action: 'Автоматична средна оценка: ' + _avg + ' (' + _scores.length + ' рецензии)', date: now, user: 'Система' });
                }
                appRow[COL.STATUS - 1] = _newAppStatus;
                appRow[COL.HISTORY - 1] = JSON.stringify(history);
                safeSetRow_(appSheet, appFound.rowIndex, appRow, TOTAL_COLS);
                applyRowColor(appSheet, appFound.rowIndex, _newAppStatus);

                // ── Auto-rank the competition once every eligible application is scored ──
                if (_hasMinReviews) {
                  try {
                    var _compId = String(appRow[COL.COMPETITION - 1] || '').trim();
                    if (_compId) _maybeAutoRankCompetition_(_compId, auth);
                  } catch (rankErr) {
                    console.warn('submitReview auto-rank check failed: ' + rankErr.message);
                  }

                  // ── BPMN 25: Auto threshold check (50%+1 rule, Правилник чл.19) ──
                  // After scoring, immediately determine above/below threshold so CKK
                  // sees the correct status without a manual step.
                  try {
                    var _maxScore = 100; // EVAL_MAX_SCORE
                    var _threshold = Math.floor(_maxScore * 0.5) + 1; // 50%+1 = 51
                    var _thresholdStatus = _avg >= _threshold ? 'above_threshold' : 'below_threshold';
                    if (appRow[COL.STATUS - 1] === 'scored') {
                      appRow[COL.STATUS - 1] = _thresholdStatus;
                      history.push({ action: 'Автоматична проверка на праг (' + _threshold + ' т.): ' + (_avg >= _threshold ? 'над прага' : 'под прага'), date: now, user: 'Система' });
                      appRow[COL.HISTORY - 1] = JSON.stringify(history);
                      safeSetRow_(appSheet, appFound.rowIndex, appRow, TOTAL_COLS);
                      logTransaction('AUTO_THRESHOLD', 'Application', formId, { avgScore: _avg, threshold: _threshold, decision: _thresholdStatus });
                    }
                  } catch (thrErr) {
                    console.warn('submitReview auto-threshold check failed: ' + thrErr.message);
                  }
                }
              }
            } catch (e) { console.warn('submitReview auto-transition failed: ' + e.message); }
          }

          logTransaction('SUBMIT_REVIEW', 'Reviewer', reviewerEmail, { formId: formId, hasReview: !!review, hasConsent: !!consent });

          // Notify admin about review submission
          if (review) {
            try {
              var projectTitle = '';
              try {
                var appSheetN = getSheet();
                var appFoundN = findRowByID(appSheetN, formId);
                if (appFoundN) projectTitle = String(appFoundN.rowData[COL.TITLE - 1] || '');
              } catch (_) {}
              notifyReviewSubmitted_(reviewerEmail, formId, projectTitle, allReviewed && reviewerCount > 0, reviewerCount);
            } catch (notifErr) { console.warn('submitReview notification failed: ' + notifErr.message); }
          }

          return {
            success: true,
            message: review ? 'Рецензията е подадена успешно' : 'Съгласието е записано',
            allReviewed: allReviewed && reviewerCount > 0
          };
        } catch (err) {
          logError('submitReview', err, body);
          return { success: false, error: 'submitReview failed: ' + err.message };
        }
      }

      // ── Per-execution application-by-ID cache ─────────────────────────────
      // getReviewerForms and other functions read the Applications sheet to
      // resolve project metadata by formId. This per-execution Map memo collapses
      // repeated reads (e.g. admin viewing multiple reviewer assignments) into
      // a single sheet read. Busted by _bustSheetCache_ on write operations.
      var _appByIdMemo_ = null;
      var _appByIdDv_ = 0;
      function getReviewerForms(body) {
        try {
          body = body || {};
          // notModified short-circuit. The reviewer-assignments view depends on
          // both the Reviewers sheet (assignment rows + status) and the
          // Applications sheet (project metadata, status). Either bump invalidates.
          var _nm = _ifVersionsMatch_(body, ['reviewers','applications']);
          if (_nm) return _nm;
          var auth = resolveAuthContext(body);
          var reviewerEmail = String(body.reviewerEmail || body.email || body.userId || '').toLowerCase().trim();
          if (!reviewerEmail) return { success: false, error: 'Missing reviewer email' };

          // SECURITY: Verify the authenticated user IS the reviewer they claim to be,
          // unless they are an admin (who may view any reviewer's forms).
          if (!auth.isAdmin && auth.userId && auth.userId !== reviewerEmail) {
            return { success: false, error: 'Нямате права да преглеждате рецензиите на друг рецензент.' };
          }

          // Per-reviewer cache keyed by data versions of reviewers + applications.
          // This makes repeated polls (every ~20s from the UI) effectively free
          // until either sheet actually changes.
          // ── Per-execution memo ──────────────────────────────────────────
          // getReviewerForms is polled aggressively by the reviewer UI.
          // One sheet read per GAS execution is enough; subsequent calls
          // within the same execution get the memo hit (<1 ms).
          var _rfmKey = 'rfm:' + reviewerEmail;
          if (!body.forceRefresh) {
            var _rfmCached = _sheetReadCache_[_rfmKey];
            if (_rfmCached) return _rfmCached;
          }
          var cacheKey = '';
          try {
            var dv = getDataVersions_();
            cacheKey = 'rfv3sec:' + reviewerEmail + ':' + dv.reviewers + ':' + dv.applications + ':' + dv.competitions;
            if (!body.forceRefresh) {
              var sc = _scriptCache_();
              var cached = sc.get(cacheKey);
              if (cached) {
                try {
                  var parsed = JSON.parse(cached);
                  if (parsed && parsed.assignments) {
                    return { success: true, assignments: parsed.assignments, cached: true };
                  }
                } catch (_) { /* fall through */ }
              }
            }
          } catch (_) { /* cache best-effort */ }

          var revSheet = getReviewersSheet();
          // _cachedSheetData_ shares the Reviewers read with getReviewers and
          // getReviewDeadlines if they run in the same execution (batchApi /
          // getCompetitionPanel). Prepend a guard-slot so loop indices match.
          var revData = _cachedSheetData_(revSheet);
          var revLastRow = revData.length;

          // Collect this reviewer's assignment rows first so we only have to
          // index the application IDs we actually need.
          var myRows = [];
          var neededIds = {};
          for (var i = 1; i < revData.length; i++) {
            var rowEmail = String(revData[i][REV_COL.EMAIL - 1] || '').toLowerCase().trim();
            if (rowEmail !== reviewerEmail) continue;
            var fid = String(revData[i][REV_COL.FORM_ID - 1] || '').trim();
            if (!fid) continue;
            myRows.push({ row: revData[i], formId: fid });
            neededIds[fid] = true;
          }

          // Build an O(1) lookup map for applications keyed by ID. Uses a
          // per-execution cache so subsequent getReviewerForms calls within
          // the same execution (e.g. batch, multiple reviewer lookups) share
          // the same app rows without re-reading the Applications sheet.
          var appById = {};
          if (myRows.length) {
            // Per-execution memo: reuse the full app map if version matches
            var appDv = getDataVersions_().applications;
            if (_appByIdMemo_ && _appByIdDv_ === appDv) {
              appById = _appByIdMemo_;
            } else {
              var appSheet = getSheet();
              var appLastRow = appSheet.getLastRow();
              if (appLastRow > 1) {
                var appMaxCol = Math.max(
                  COL.ID, COL.TITLE, COL.USER_NAME, COL.USER_EMAIL, COL.PROJECT_CODE,
                  COL.AREA, COL.DESCRIPTION, COL.STATUS, COL.COMPETITION,
                  COL.SUBMITTED, COL.CREATED, COL.FILE_IDS, COL.ATTACHED_DOCS,
                  COL.TEAM_MEMBERS, COL.HISTORY
                );
                var appData = appSheet.getRange(2, 1, appLastRow - 1, appMaxCol).getValues();
                var _fullMap = {};
                for (var j = 0; j < appData.length; j++) {
                  var aid = String(appData[j][COL.ID - 1] || '');
                  if (aid) _fullMap[aid] = appData[j];
                }
                _appByIdMemo_ = _fullMap;
                _appByIdDv_ = appDv;
                appById = _fullMap;
              }
            }
          }

          // Pre-load competition names for enrichment — uses the already-
          // cached competitions list (CacheService → per-execution memo)
          // instead of re-reading the Competitions sheet on every call.
          var compNames = {};
          if (myRows.length) {
            try {
              var allComps = getOrCacheCompetitions(false);
              for (var c = 0; c < allComps.length; c++) {
                var cid = String((allComps[c] && allComps[c].id) || '').trim();
                if (cid) compNames[cid] = String((allComps[c] && allComps[c].name) || '');
              }
            } catch (_) { /* competitions data may not exist yet */ }
          }

          var assignments = [];
          for (var k = 0; k < myRows.length; k++) {
            var rRow = myRows[k].row;
            var assignFormId = myRows[k].formId;
            var revStatus = String(rRow[REV_COL.STATUS - 1] || 'pending');
            var revReview = String(rRow[REV_COL.REVIEW - 1] || '');
            var revScore = String(rRow[REV_COL.SCORE - 1] || '');
            var revConsent = String(rRow[REV_COL.CONSENT - 1] || '');
            var revSubmitted = String(rRow[REV_COL.SUBMITTED - 1] || '');
            var revCreated = String(rRow[REV_COL.CREATED - 1] || '');
            var competitionId = String(rRow[REV_COL.COMPETITION - 1] || '');

            var appInfo = null;
            var appRow = appById[assignFormId];
            if (appRow) {
              // Reviewers receive PREVIEW-only access to files under evaluation.
              // sanitizeFileRecordsForCaller_ strips downloadUrl/webViewLink and
              // emits a /preview?rm=minimal previewLink so the document viewer
              // cannot be flipped to /edit via URL manipulation.
              var revIsAdmin = !!auth.isAdmin;
              appInfo = {
                title: String(appRow[COL.TITLE - 1] || ''),
                applicant: String(appRow[COL.USER_NAME - 1] || ''),
                applicantEmail: String(appRow[COL.USER_EMAIL - 1] || ''),
                projectType: String(appRow[COL.PROJECT_CODE - 1] || ''),
                area: String(appRow[COL.AREA - 1] || ''),
                description: String(appRow[COL.DESCRIPTION - 1] || ''),
                status: String(appRow[COL.STATUS - 1] || ''),
                competitionId: String(appRow[COL.COMPETITION - 1] || ''),
                submitted: normaliseDate(appRow[COL.SUBMITTED - 1]),
                created: normaliseDate(appRow[COL.CREATED - 1]),
                fileIds: sanitizeFileRecordsForCaller_(safeParseJSON(appRow[COL.FILE_IDS - 1], []), revIsAdmin),
                attachedDocs: sanitizeFileRecordsForCaller_(safeParseJSON(appRow[COL.ATTACHED_DOCS - 1], []), revIsAdmin),
                teamMembers: safeParseJSON(appRow.length >= COL.TEAM_MEMBERS ? appRow[COL.TEAM_MEMBERS - 1] : '', []),
                history: safeParseJSON(appRow[COL.HISTORY - 1], [])
              };
            }

            // Parse consent metadata.
            // Stored as either boolean string ('true'/'false') from legacy rows
            // or as JSON `{consented:true, consentDate:'…', coiDeclared:false}`.
            // Surface both the boolean AND the consent date so the frontend can
            // render a 10-day countdown that runs from CONSENT (BPMN 20→22),
            // not from assignment, per the published regulation.
            var consentedBool = false;
            var consentDateStr = '';
            var coiDeclared = false;
            if (revConsent) {
              if (revConsent === 'true') {
                consentedBool = true;
              } else if (revConsent.charAt(0) === '{') {
                try {
                  var cd = JSON.parse(revConsent);
                  consentedBool = !!cd.consented;
                  consentDateStr = String(cd.consentDate || '');
                  coiDeclared = !!cd.coiDeclared;
                } catch (_) { /* ignore malformed */ }
              }
            }

            assignments.push({
              formId: assignFormId,
              competitionId: competitionId,
              competitionName: compNames[competitionId] || '',
              reviewStatus: revStatus,
              review: revReview,
              score: revScore,
              consent: consentedBool,
              consentDate: consentDateStr,
              coiDeclared: coiDeclared,
              submitted: revSubmitted,
              assigned: revCreated,
              assignedDate: revCreated,        // explicit alias used by getReviewDeadline fallback
              hasProjectData: !!appInfo,       // frontend uses this to show/hide "data missing" warning
              formTitle: appInfo ? appInfo.title : '',  // top-level shortcut so card title works even if project object is stripped
              project: appInfo
            });
          }

          var result = { success: true, assignments: assignments };
          // Per-execution memo: subsequent getReviewerForms calls in the same
          // execution return this object without re-reading the sheet.
          if (!body.forceRefresh) { _sheetReadCache_[_rfmKey] = result; }
          if (cacheKey) {
            try {
              var payload = JSON.stringify({ assignments: assignments });
              // CacheService entry cap is 100KB; skip silently if oversized.
              if (payload.length < 95000) {
                _scriptCache_().put(cacheKey, payload, 300); // 5 min
              }
            } catch (_) { /* best-effort */ }
          }
          return result;
        } catch (err) {
          logError('getReviewerForms', err, body);
          return { success: false, error: 'getReviewerForms failed: ' + err.message };
        }
      }

