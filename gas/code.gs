             'affiliation', 'phone', 'motivation', 'status', 'approvedBy', 'createdAt']
          );
          var data = ss.getDataRange().getValues();
          var _ncols = data[0] ? data[0].length : 11;
          for (var i = 1; i < data.length; i++) {
