                  : 'https://drive.google.com/file/d/' + copyId + '/view'),
              downloadUrl: _tLinks.downloadUrl || copy.getUrl(),
              folderName: 'Моите документи',
              origin: 'template',
              templateSourceId: original.getId(),
              templateSourceName: baseName,
              projectType: projectType,
              templateKey: templateKey
            }
          };
        } catch (err) {
          try { logError('copyTemplateForUser', err, body); } catch (_) {}
          return { success: false, error: 'Копирането на шаблона не бе успешно: ' + err.message };
        }
      }

      // ============================================================
      //  GENERATE BUDGET SPREADSHEET — copies the official per-type
      //  budget table (PROJECT_BUDGET_TEMPLATES) into the applicant's
      //  "Моите документи" folder and best-effort pre-fills the budget
      //  cells from the Step-3 budget UI. (v9.69.0-budgettables)
      //  body: { projectType|projectCode, budget?, formId? }
      // ============================================================
      function generateBudgetSpreadsheet(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.authenticated) return { success: false, error: 'Необходима е автентикация.' };
          var projectType = String(body.projectType || body.projectCode || '').trim().toUpperCase();
          if (!projectType) return { success: false, error: 'Липсва тип проект.' };
          if (typeof PROJECT_BUDGET_TEMPLATES === 'undefined') {
