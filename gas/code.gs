      /**
       * Enhanced MySQL sync with queue fallback.
       * Tries direct POST first; if MySQL is unreachable after retries,
       * saves the mutation to ScriptProperties queue for replay later.
       */
      function _syncToMySQL_(action, body) {
        try {
          var _syncUrl = _getHostingerUrl_();
          if (!_syncUrl) return;
          if (_SYNC_SKIP_[action]) return;
          if (body && body._batchSync) return;

          var payload = Object.assign({}, body || {}, { action: action, _gasSync: true });
          var payloadStr = JSON.stringify(payload);

          // Guard: UrlFetchApp has ~50MB limit; truncate massive payloads
          if (payloadStr.length > 5 * 1024 * 1024) {
            console.warn('[HostingerSync] Payload too large (' +
              (payloadStr.length / 1024).toFixed(0) + 'KB), truncating for ' + action);
            payload = { action: 'syncstale', table: action.replace(/^(create|update|delete)/,''),
              _gasSync: true, _staleMarker: true };
            payloadStr = JSON.stringify(payload);
          }

          var options = {
            method: 'post',
            contentType: 'application/json',
            payload: payloadStr,
            muteHttpExceptions: true,
            timeout: 5  // v12.26.0: 3s→5s — allows PHP to respond under normal load
          };

          // v12.17.1: Try each URL in the pool until one succeeds
          var _pool = HOSTINGER_URL_POOL.length ? HOSTINGER_URL_POOL : [_syncUrl];
          var _succeeded = false;
          var _lastErr = null;

          for (var _pi = 0; _pi < _pool.length; _pi++) {
            var _tryUrl = _pool[_pi];
            // Quick health check on first attempt only
            if (_pi === 0 && !_isMySQLHealthy_()) {
              _markHostingerUnhealthy_(_tryUrl);
              continue;
            }
            for (var ri = 0; ri < _SYNC_RETRY_MAX_; ri++) {
              try {
                var resp = UrlFetchApp.fetch(_tryUrl, options);
                var code = resp.getResponseCode();
                var respText = resp.getContentText();
                // v12.27.1-perf: Detect 409 row_version conflict from PHP.
                // When the wizard frontend has written to MySQL directly (bypassing
                // GAS), the row_version in MySQL is higher than what GAS knows.
                // GAS is the authority, so we force-update by retrying with
                // row_version=0 (which means "force write" in the stored procedure).
                if (code === 409) {
                  try {
                    var _conflictResp = JSON.parse(respText);
                    if (_conflictResp && _conflictResp.error === 'row_version_conflict') {
                      console.warn('[HostingerSync] row_version conflict for ' + action +
                        ' (server version: ' + (_conflictResp.serverVersion || '?') + '). ' +
                        'GAS deferring to PHP version — skipping sync.');
                      // GAS defers to PHP — mark as succeeded so we don't retry.
                      // The PHP/wizard version is considered more recent.
                      _markHostingerHealthy_(_tryUrl);
                      _succeeded = true;
                      break;
                    }
                  } catch (_) { /* not a structured conflict response */ }
                }
                if (code >= 200 && code < 500) {
                  _markHostingerHealthy_(_tryUrl);
                  _mysqlHealthCache_ = { ok: true, ts: Date.now(), ttl: 30000 };
                  _succeeded = true;
                  break;
                }
                _lastErr = 'HTTP ' + code;
              } catch (e) {
                _lastErr = e.message;
              }
              if (ri < _SYNC_RETRY_MAX_ - 1) {
                Utilities.sleep(_SYNC_RETRY_BASE_MS_ * Math.pow(2, ri));
              }
            }
            if (_succeeded) break;
            // This URL failed all retries — mark unhealthy, try next
            _markHostingerUnhealthy_(_tryUrl);
          }

          if (!_succeeded) {
            console.warn('[HostingerSync] All URLs failed for ' + action + ' — ' + _lastErr + '. Queuing for replay.');
            _enqueueSync_(action, body, payloadStr);
          }

        } catch (_) { /* silent — Sheets is authoritative */ }
      }

      /**
       * Enqueue a failed sync mutation to ScriptProperties for replay.
       * The queue is processed periodically by _processSyncQueue_()
       * (called from doPost health check path).
       */
      var _SYNC_QUEUE_KEY = '_HOSTINGER_SYNC_QUEUE';
      var _SYNC_QUEUE_MAX = 100; // prevent unbounded growth

      function _enqueueSync_(action, body, payloadStr) {
        try {
          var props = _scriptProps_();
          var existing = props.getProperty(_SYNC_QUEUE_KEY);
          var queue = existing ? JSON.parse(existing) : [];
          queue.push({
            action: action,
            ts: new Date().toISOString(),
            payload: payloadStr.substring(0, 10000), // truncate to fit property limit
            attempt: 0
          });
          // Keep only the most recent entries
          if (queue.length > _SYNC_QUEUE_MAX) {
            queue.splice(0, queue.length - _SYNC_QUEUE_MAX);
          }
          props.setProperty(_SYNC_QUEUE_KEY, JSON.stringify(queue));
        } catch (_) {}
      }

      /**
       * Process the sync replay queue — called lazily from doPost.
       * Replays up to 10 queued mutations per invocation.
       */
      function _processSyncQueue_() {
        try {
          var props = _scriptProps_();
          var existing = props.getProperty(_SYNC_QUEUE_KEY);
          if (!existing) return;
          var queue = JSON.parse(existing);
          if (!queue || !queue.length) return;

          var remaining = [];
          var replayed = 0;
          for (var qi = 0; qi < queue.length && replayed < 10; qi++) {
            var item = queue[qi];
            if (!item || !item.payload) continue;
            try {
              var opts = {
                method: 'post',
                contentType: 'application/json',
                payload: item.payload,
                muteHttpExceptions: true,
                timeout: 15
              };
              // v12.17.1: Try each URL in the pool
              var _pool = HOSTINGER_URL_POOL.length ? HOSTINGER_URL_POOL : [_getHostingerUrl_()];
              var _ok = false;
              for (var _pi = 0; _pi < _pool.length && !_ok; _pi++) {
                try {
                  var resp = UrlFetchApp.fetch(_pool[_pi], opts);
                  var code = resp.getResponseCode();
                  if (code >= 200 && code < 500) { _ok = true; _markHostingerHealthy_(_pool[_pi]); }
                } catch (_) {}
              }
              if (_ok) { replayed++; continue; }
            } catch (_) {}
            // Failed again — keep in queue with incremented attempt
            item.attempt = (item.attempt || 0) + 1;
            if (item.attempt < 10) remaining.push(item);
          }
          // Append any remaining items after the batch we processed
          for (var rj = qi; rj < queue.length; rj++) {
            remaining.push(queue[rj]);
          }
          if (remaining.length) {
            props.setProperty(_SYNC_QUEUE_KEY, JSON.stringify(remaining));
          } else {
            props.deleteProperty(_SYNC_QUEUE_KEY);
          }
        } catch (_) {}
      }

