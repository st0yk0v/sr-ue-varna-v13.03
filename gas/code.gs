      /**
       * Version-check helper: compares MySQL's data version against GAS's current version.
       * If MySQL is stale (version < GAS version), we skip MySQL and use Sheets.
       * This prevents serving stale data immediately after a GAS mutation.
       */
      function _isMySQLVersionCurrent_(action, mysqlVersion) {
        try {
          var dv = getDataVersions_();
          // Map action → version scope
          var scopeMap = {
            getforms:'applications', getform:'applications', getapplicationsbycompetition:'applications',
            loadmoreforms:'applications', getdashboardcontext:'applications',
            getcompetitions:'competitions', getpubliccompetitions:'competitions',
            loadmorecompetitions:'competitions',
            getcompetitionsummary:'competitions', getcontestboard:'competitions',
            getprojects:'projects', getproject:'projects', getprojectdashboard:'projects',
            getreports:'reports', getreport:'reports',
            getreviewers:'reviewers', getreviewerforms:'reviewers',
            getchangerequests:'changerequests',
            getexpenses:'expenses', getbudgetsummary:'expenses',
            getsanctions:'sanctions', checksanctions:'sanctions',
            getdeliverables:'deliverables',
            getmessages:'messages',
            listdocuments:'documents', listmydocuments:'documents',
            getnotifications:'notifications'
          };
          var scope = scopeMap[action];
          if (!scope) return true; // unknown scope — assume current
          var currentVersion = dv[scope] || 0;
          // Allow 1 version difference (MySQL might be 1 behind due to async sync)
          return mysqlVersion >= (currentVersion - 1);
        } catch (_) {
          return true; // on error, assume current (let MySQL try)
