          return _HOSTINGER_RESOLVED_URL_;
        }
        var pool = HOSTINGER_URL_POOL.length ? HOSTINGER_URL_POOL : _buildHostingerPool_();
        _HOSTINGER_RESOLVED_URL_ = pool[0];
        return _HOSTINGER_RESOLVED_URL_;
