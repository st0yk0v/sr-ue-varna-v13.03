      // ── Competitions sheet — extended columns (AC + Rector order) ──
      // Existing COMP_TOTAL_COLS=14 is const. Use a separate map and
      // a one-time extension helper that grows the sheet on demand.
      var COMP_EXT_COL = {
        AC_APPROVED_BY:15, AC_APPROVED_AT:16, AC_MINUTES_URL:17,
        RECTOR_ORDER_NUMBER:18, RECTOR_ORDER_DATE:19, RECTOR_ORDER_DOC_ID:20
      };
      var COMP_EXT_TOTAL_COLS = 20;
      var COMP_EXT_HEADERS = COMP_EXPECTED_HEADERS.concat([
        'ACApprovedBy','ACApprovedAt','ACMinutesUrl',
        'RectorOrderNumber','RectorOrderDate','RectorOrderDocId'
      ]);

      function _ensureCompetitionExtColumns_() {
        var sheet = getCompetitionsSheet();
        if (sheet.getLastColumn() >= COMP_EXT_TOTAL_COLS) return sheet;
        var lock = LockService.getScriptLock();
        var hasLock = false;
        try { lock.waitLock(10000); hasLock = true; } catch (_) {}
        try {
          var currentLast = sheet.getLastColumn();
          for (var c = currentLast + 1; c <= COMP_EXT_TOTAL_COLS; c++) {
            sheet.getRange(1, c).setValue(COMP_EXT_HEADERS[c - 1] || '');
            sheet.setColumnWidth(c, 140);
          }
        } finally {
          if (hasLock) { try { lock.releaseLock(); } catch (_) {} }
        }
        return sheet;
      }

      // ── Helpers ──────────────────────────────────────────────────
      function _monNewId_(prefix) {
        return (prefix || 'MON') + '-' + Utilities.getUuid().replace(/-/g, '').substring(0, 12).toUpperCase();
      }
      function _monParseJson_(v, fallback) {
        try { return JSON.parse(String(v || '')); } catch (_) { return fallback; }
      }
      function _monAppendHistory_(historyArr, entry) {
        var arr = Array.isArray(historyArr) ? historyArr : [];
        arr.push(entry);
        return arr;
      }
      function _monIsAuthorized_(auth, allowedRoles) {
        if (auth.isAdmin) return true;
        for (var i = 0; i < allowedRoles.length; i++) {
          if (auth.role === allowedRoles[i]) return true;
        }
        return false;
      }
      /**
       * _monFindById_ — fast row lookup.
       *
       * PERFORMANCE OVERHAUL: previously did `getDataRange().getValues()` on
       * every call — that pulled the FULL sheet including the two huge JSON
       * blob columns (DATA_SNAPSHOT + EDITED_DATA can each be ~50–500 KB per
       * row). On a 100-row sheet that's a 50 MB read just to look up one ID.
       *
       * New strategy:
       *   1) Read ONLY column 1 (ID) to find the row index (~few KB).
       *   2) Read the matched row in a single getValues() call (one round-trip).
       * This is ~50–500x faster on warmed sheets and dramatically reduces
       * Apps Script execution time for export, finalize, getMONReport,
       * editMONReport, and the 8 other handlers that call this hot path.
       */
      function _monFindById_(reportId) {
        var sheet = getMinistryReportsSheet();
        var lastRow = sheet.getLastRow();
        if (lastRow < 2) return null;
        var target = String(reportId || '').trim();
        if (!target) return null;
        var idCol = sheet.getRange(2, MON_COL.ID, lastRow - 1, 1).getValues();
        for (var i = 0; i < idCol.length; i++) {
          if (String(idCol[i][0]).trim() === target) {
            var rIdx = i + 2; // 1-based + header
            var rowData = sheet.getRange(rIdx, 1, 1, MON_TOTAL_COLS).getValues()[0];
            return { sheet: sheet, rowIndex: rIdx, rowData: rowData };
          }
        }
        return null;
      }

      // ── Canonical status enum (single source of truth) ──
      // Use MON_STATUS.X anywhere a literal status string appears so typos are
      // caught at parse time and call sites stay searchable.
      var MON_STATUS = {
        CREATED:                  'created',
        UNDER_EDITORIAL_REVIEW:   'under_editorial_review',
        RETURNED_FOR_DATA_REFRESH:'returned_for_data_refresh',
        FINALIZED:                'finalized',
        SUBMITTED:                'submitted',
        REJECTED_BY_MINISTRY:     'rejected_by_ministry',
        ACKNOWLEDGED:             'acknowledged',
        ARCHIVED:                 'archived',
        CANCELLED:                'cancelled'
      };
      var VALID_MON_STATUSES = Object.keys(MON_STATUS).map(function(k){ return MON_STATUS[k]; });

      // ── MON role bundles ──
      // Each MON handler accepts one of these named bundles. Centralizing the
      // arrays prevents drift between handlers (e.g. one forgetting to allow
      // CKK reads). Admin is implicitly allowed by _monIsAuthorized_.
      var MON_ROLES = {
        EDITOR:    [ROLE_NIDD, ROLE_VICE_RECTOR],                          // create/edit/refresh, ack, reject
        READER:    [ROLE_NIDD, ROLE_VICE_RECTOR, ROLE_RECTOR, ROLE_CKK],   // list/get/export
        FINALIZER: [ROLE_VICE_RECTOR],                                     // finalize, cancel
        SUBMITTER: [ROLE_RECTOR]                                           // 2FA-gated submission
      };

      var MON_TRANSITIONS = {
        created: ['under_editorial_review','cancelled'],
        under_editorial_review: ['returned_for_data_refresh','finalized','cancelled'],
        returned_for_data_refresh: ['created'],
        finalized: ['submitted','under_editorial_review','cancelled'],
        submitted: ['acknowledged','rejected_by_ministry'],
        rejected_by_ministry: ['under_editorial_review'],
        acknowledged: ['archived'],
        archived: [],
        cancelled: []
      };
      function _monNidds_() {
        // Best-effort: fetch admin emails (acts as NIDD/admin notification list).
        try {
          loadAdminCredentials_();
          if (Array.isArray(_ADMIN_EMAILS_SERVER) && _ADMIN_EMAILS_SERVER.length) {
            return _ADMIN_EMAILS_SERVER.slice();
          }
        } catch (_) {}
        return [];
      }

      function _monNotify_(emails, subject, heading, lines, notifyType) {
        if (!emails || !emails.length) return;
        try {
          var html = buildNotificationHtml_(heading, lines || [], 'UEV-ERP — Подаване и управление на научни проекти');
          var nt = notifyType || 'report_due';
          for (var i = 0; i < emails.length; i++) {
            try { notifyApplicant_(emails[i], subject, html, nt); } catch (_) {}
          }
        } catch (e) { console.warn('_monNotify_ failed: ' + e.message); }
      }

      // ============================================================
      //  PROCESS 11 — MON Reporting handlers (12 + 4 helpers)
      // ============================================================

      /**
       * createMONReport — fast-path create.
       *
       * PERFORMANCE OVERHAUL (v5.9.10):
       *   1) Dedup check now reads only the 4 columns it needs (REPORT_TYPE,
       *      YEAR, PERIOD, STATUS) instead of the full sheet via getDataRange().
       *      On a 500-row sheet this drops ~80 % of the read cost.
       *   2) Snapshot generation (the expensive aggregation across events,
       *      publications, projects, finances) is DEFERRED by default to a
       *      one-time time-based trigger that fires ~1 s after the response.
       *      The row is written immediately with a `_pending:true` placeholder
       *      snapshot so the UI gets back a `reportId` in well under 1 s and
       *      can navigate to the detail view. The user sees a "Снимката се
       *      обработва…" hint while the trigger backfills DATA_SNAPSHOT and
       *      EDITED_DATA in the background and sends the NIDD notification.
       *   3) Caller can opt out via `deferSnapshot:false` (legacy synchronous
       *      behaviour) — used by Apps Script test harnesses / batch jobs.
       */
      function createMONReport(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!_monIsAuthorized_(auth, MON_ROLES.EDITOR)) {
            return { success: false, error: 'Нямате право да създавате МОН отчет.' };
          }
          var reportType = String(body.reportType || '').toLowerCase().trim();
          var year = parseInt(body.year, 10) || new Date().getFullYear();
          var period = String(body.period || '').trim();
          var deferSnapshot = (body.deferSnapshot !== false); // default ON
          if (['semiannual','annual','adhoc'].indexOf(reportType) === -1) {
            return { success: false, error: 'Невалиден тип отчет.' };
          }
          if (!period) return { success: false, error: 'Липсва период.' };

          var sheet = getMinistryReportsSheet();
          // Slim dedup: REPORT_TYPE..STATUS are contiguous (cols 2..5), so a
          // single getValues() pulls all four with one Apps Script round-trip
          // instead of the previous four separate reads. ~4x faster on the
          // create-modal hot path; avoids touching the heavy JSON blob cols.
          var lastRow = sheet.getLastRow();
          if (lastRow > 1) {
            var n = lastRow - 1;
            var slice = sheet.getRange(2, MON_COL.REPORT_TYPE, n, MON_COL.STATUS - MON_COL.REPORT_TYPE + 1).getValues();
            var IDX_TYPE = 0;
            var IDX_PERIOD = MON_COL.PERIOD - MON_COL.REPORT_TYPE;
            var IDX_YEAR = MON_COL.YEAR - MON_COL.REPORT_TYPE;
            var IDX_STATUS = MON_COL.STATUS - MON_COL.REPORT_TYPE;
            for (var i = 0; i < n; i++) {
              var t = String(slice[i][IDX_TYPE]).toLowerCase();
              var y = parseInt(slice[i][IDX_YEAR], 10);
              var p = String(slice[i][IDX_PERIOD]).trim();
              var st = String(slice[i][IDX_STATUS]).toLowerCase();
              if (t === reportType && y === year && p === period && st !== 'cancelled') {
                return { success: false, error: 'Вече съществува отчет за този период (статус: ' + st + ').' };
              }
            }
          }

          var id = _monNewId_('MON');
          var now = nowISO();
          var historyEntry = { status: MON_STATUS.CREATED, ts: now, by: auth.userId, role: auth.role || (auth.isAdmin ? 'admin' : '') };

          var snapshotJson;
          var snapshotResForReturn = null;
          if (deferSnapshot) {
            // Lightweight placeholder; real snapshot backfilled by trigger.
            snapshotJson = JSON.stringify({
              success: true, _pending: true, year: year, reportType: reportType,
              period: period, periodStart: body.periodStart || '', periodEnd: body.periodEnd || '',
              generatedAt: now, totals: {}, sections: {}
            });
          } else {
            var snapshotRes = generateMONReport({ year: year, reportType: reportType, period: period, periodStart: body.periodStart||'', periodEnd: body.periodEnd||'', userId: auth.userId, isAdmin: auth.isAdmin, email: auth.userId });
            if (!snapshotRes || snapshotRes.success === false) {
              return { success: false, error: 'Неуспешно генериране на снимка: ' + ((snapshotRes && snapshotRes.error) || 'unknown') };
            }
            snapshotJson = JSON.stringify(snapshotRes);
            snapshotResForReturn = snapshotRes;
          }

          var row = new Array(MON_TOTAL_COLS);
          row[MON_COL.ID - 1] = id;
          row[MON_COL.REPORT_TYPE - 1] = reportType;
          row[MON_COL.PERIOD - 1] = period;
          row[MON_COL.YEAR - 1] = year;
          row[MON_COL.STATUS - 1] = MON_STATUS.CREATED;
          row[MON_COL.DATA_SNAPSHOT - 1] = snapshotJson;
          row[MON_COL.EDITED_DATA - 1] = snapshotJson;
          row[MON_COL.EDITORIAL_NOTES - 1] = '';
          row[MON_COL.DRAFT_BY - 1] = auth.userId;
          row[MON_COL.DRAFT_AT - 1] = now;
          row[MON_COL.HISTORY - 1] = JSON.stringify([historyEntry]);
          row[MON_COL.ATTACHMENTS - 1] = '[]';
          row[MON_COL.NOTES - 1] = String(body.notes || '').trim();
          for (var k = 0; k < MON_TOTAL_COLS; k++) if (row[k] === undefined) row[k] = '';
          sheet.appendRow(row);

          if (deferSnapshot) {
            // Schedule background backfill (~1 s later). Notification is sent
            // from the trigger after the snapshot is materialised so reviewers
            // never get an email pointing at an empty report.
            try {
              _scriptProps_().setProperty('MON_PENDING_' + id, JSON.stringify({
                id: id, year: year, reportType: reportType, period: period,
                periodStart: body.periodStart || '', periodEnd: body.periodEnd || '',
                userId: auth.userId, isAdmin: !!auth.isAdmin, role: auth.role || ''
              }));
              ScriptApp.newTrigger('_monBackfillSnapshotTrigger_').timeBased().after(1000).create();
            } catch (trigErr) {
              // Trigger creation can fail in editor preview / quota-exhausted
              // contexts. Fall back to inline generation so we never leave a
              // pending row orphaned.
              console.warn('createMONReport: trigger failed, generating inline — ' + trigErr.message);
              try {
                var inlineRes = generateMONReport({ year: year, reportType: reportType, period: period, periodStart: body.periodStart||'', periodEnd: body.periodEnd||'', userId: auth.userId, isAdmin: auth.isAdmin, email: auth.userId });
                if (inlineRes && inlineRes.success !== false) {
                  var inlineJson = JSON.stringify(inlineRes);
                  sheet.getRange(sheet.getLastRow(), MON_COL.DATA_SNAPSHOT).setValue(inlineJson);
                  sheet.getRange(sheet.getLastRow(), MON_COL.EDITED_DATA).setValue(inlineJson);
                  snapshotResForReturn = inlineRes;
                  deferSnapshot = false;
                }
              } catch (fallbackErr) { console.warn('inline fallback also failed: ' + fallbackErr.message); }
              try {
                _monNotify_(_monNidds_(), 'Нов МОН отчет — готов за редакция (' + period + ')',
                  '📋 Нов МОН отчет за редакция',
                  [{ label: 'ID', value: id }, { label: 'Тип', value: reportType }, { label: 'Период', value: period }, { label: 'Година', value: String(year) }, { label: 'Създаден от', value: auth.userId }]);
              } catch (_) {}
            }
          } else {
            _monNotify_(_monNidds_(), 'Нов МОН отчет — готов за редакция (' + period + ')',
              '📋 Нов МОН отчет за редакция',
              [{ label: 'ID', value: id }, { label: 'Тип', value: reportType }, { label: 'Период', value: period }, { label: 'Година', value: String(year) }, { label: 'Създаден от', value: auth.userId }]);
          }

          try { logTransaction('CREATE_MON_REPORT', auth.userId, id, { reportType: reportType, period: period, year: year, deferred: deferSnapshot }); } catch (_) {}
          console.log('[AUDIT] createMONReport ' + auth.userId + ' ' + id + (deferSnapshot ? ' [deferred]' : ''));
          return { success: true, reportId: id, id: id, pending: !!deferSnapshot, snapshot: snapshotResForReturn };
        } catch (err) {
          logError('createMONReport', err, body);
          return { success: false, error: 'createMONReport failed: ' + err.message };
        }
      }

      /**
       * Time-based trigger handler — backfills snapshot for any MON rows that
       * were created with `deferSnapshot:true` (placeholder `_pending:true`).
       * Pulls the work queue from ScriptProperties (`MON_PENDING_<id>`),
       * regenerates the snapshot, writes DATA_SNAPSHOT + EDITED_DATA, sends
       * the NIDD review-ready notification, and self-deletes its trigger.
       * Safe to call multiple times: each property is removed after handling.
       */
      function _monBackfillSnapshotTrigger_(e) {
        try {
          var props = _scriptProps_();
          var allKeys = props.getKeys() || [];
          var pendingKeys = allKeys.filter(function (k) { return k.indexOf('MON_PENDING_') === 0; });
          for (var i = 0; i < pendingKeys.length; i++) {
            var key = pendingKeys[i];
            var meta = null;
            try { meta = JSON.parse(props.getProperty(key) || '{}'); } catch (_) { meta = null; }
            if (!meta || !meta.id) { try { props.deleteProperty(key); } catch (_) {} continue; }
            try {
              var found = _monFindById_(meta.id);
              if (!found) { props.deleteProperty(key); continue; }
              var snapshotRes = generateMONReport({
                year: meta.year, reportType: meta.reportType, period: meta.period,
                periodStart: meta.periodStart || '', periodEnd: meta.periodEnd || '',
                userId: meta.userId, isAdmin: !!meta.isAdmin, email: meta.userId
              });
              if (snapshotRes && snapshotRes.success !== false) {
                var snapJson = JSON.stringify(snapshotRes);
                // Single round-trip write: the two snapshot columns happen to be
                // adjacent (DATA_SNAPSHOT=6, EDITED_DATA=7), so set both with one
                // setValues call instead of two setValue() calls.
                found.sheet.getRange(found.rowIndex, MON_COL.DATA_SNAPSHOT, 1, 2).setValues([[snapJson, snapJson]]);
                // CRITICAL: bump the list-cache version so the next poll picks
                // up the materialised snapshot instead of serving the stale
                // {_pending:true} placeholder for up to 30 s (CacheService TTL).
                try { touchDataVersion_('ministry_reports'); } catch (_) {}
                try {
                  _monNotify_(_monNidds_(), 'Нов МОН отчет — готов за редакция (' + meta.period + ')',
                    '📋 Нов МОН отчет за редакция',
                    [{ label: 'ID', value: meta.id }, { label: 'Тип', value: meta.reportType }, { label: 'Период', value: meta.period }, { label: 'Година', value: String(meta.year) }, { label: 'Създаден от', value: meta.userId }]);
                } catch (_) {}
                console.log('[AUDIT] _monBackfillSnapshotTrigger_ filled ' + meta.id);
              } else {
                console.warn('_monBackfillSnapshotTrigger_ generate failed for ' + meta.id);
              }
              props.deleteProperty(key);
            } catch (rowErr) {
              console.warn('_monBackfillSnapshotTrigger_ row ' + (meta && meta.id) + ' failed: ' + rowErr.message);
              try { props.deleteProperty(key); } catch (_) {}
            }
          }
        } catch (err) {
          try { logError('_monBackfillSnapshotTrigger_', err, {}); } catch (_) {}
        } finally {
          // Self-cleanup: drop this one-time trigger so it doesn't accumulate.
          try {
            if (e && e.triggerUid) {
              var trigs = ScriptApp.getProjectTriggers();
              for (var t = 0; t < trigs.length; t++) {
                if (trigs[t].getUniqueId() === e.triggerUid) { ScriptApp.deleteTrigger(trigs[t]); break; }
              }
            }
          } catch (_) {}
        }
      }

      /**
       * Lightweight in-memory + CacheService row cache for MinistryReports.
       * Key includes sheet last-row count + a monotonically-bumped data-version
       * stamp so any mutation (createMONReport / editMONReport / submitMONReport
       * / acknowledgeMONReport / archive) automatically invalidates downstream
       * list reads. ~30s TTL keeps live KPI dashboards snappy without staleness.
       *
       * Cache stores the parsed [{id,reportType,...,totals,derived}] array (the
       * expensive part is JSON.parse on EDITED_DATA / DATA_SNAPSHOT — caching
       * AFTER that step gives ~5–10× speedup on repeated dashboard refreshes).
       */
      var _MON_LIST_MEM = null; // { stamp, rows }
      function _monListCacheKey_() {
        var stamp = '';
        try { stamp = _scriptCache_().get('DV_ministry_reports') || ''; } catch (_) {}
        return 'MON_LIST_V2_' + stamp;
      }
      function _monLoadAllRowsCached_() {
        var key = _monListCacheKey_();
        if (_MON_LIST_MEM && _MON_LIST_MEM.key === key) return _MON_LIST_MEM.rows;
        try {
          var c = _scriptCache_().get(key);
          if (c) {
            var parsed = JSON.parse(c);
            _MON_LIST_MEM = { key: key, rows: parsed };
            return parsed;
          }
        } catch (_) {}
        var sheet = getMinistryReportsSheet();
        var data = sheet.getDataRange().getValues();
        var rows = [];
        for (var i = 1; i < data.length; i++) {
          var tot = null, der = null;
          try {
            var ed = _monParseJson_(data[i][MON_COL.EDITED_DATA - 1], null);
            if (ed && ed.institutional) { tot = ed.institutional.totals || null; der = ed.institutional.derived || null; }
            if (!tot || !der) {
              var ds = _monParseJson_(data[i][MON_COL.DATA_SNAPSHOT - 1], null);
              if (ds && ds.institutional) {
                if (!tot) tot = ds.institutional.totals || null;
                if (!der) der = ds.institutional.derived || null;
              }
            }
          } catch (_) {}
          rows.push({
            id: data[i][MON_COL.ID - 1],
            reportType: String(data[i][MON_COL.REPORT_TYPE - 1] || ''),
            period: data[i][MON_COL.PERIOD - 1],
            year: parseInt(data[i][MON_COL.YEAR - 1], 10) || data[i][MON_COL.YEAR - 1],
            status: String(data[i][MON_COL.STATUS - 1] || '').toLowerCase(),
            draftBy: data[i][MON_COL.DRAFT_BY - 1],
            draftAt: data[i][MON_COL.DRAFT_AT - 1],
            createdBy: data[i][MON_COL.DRAFT_BY - 1],
            createdAt: data[i][MON_COL.DRAFT_AT - 1],
            finalizedAt: data[i][MON_COL.FINALIZED_AT - 1],
            submittedAt: data[i][MON_COL.SUBMITTED_AT - 1],
            acknowledgedAt: data[i][MON_COL.ACKNOWLEDGED_AT - 1],
            submissionRef: data[i][MON_COL.SUBMISSION_REF - 1],
            ministryRefNumber: data[i][MON_COL.SUBMISSION_REF - 1],
            totals: tot,
            derived: der
          });
        }
        _MON_LIST_MEM = { key: key, rows: rows };
        try {
          var s = JSON.stringify(rows);
          // CacheService 100KB per-value limit — skip oversized payloads (rare; ~500+ reports)
          if (s.length < 95000) _scriptCache_().put(key, s, 3600);
        } catch (_) {}
        return rows;
      }

      function getMONReports(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!_monIsAuthorized_(auth, MON_ROLES.READER)) {
            return { success: false, error: 'Нямате право.' };
          }
          var includeArchived = body.includeArchived === true || body.includeArchived === 'true';
          var filterYear = body.year ? parseInt(body.year, 10) : null;
          var filterType = body.reportType ? String(body.reportType).toLowerCase() : null;
          var filterStatus = body.status ? String(body.status).toLowerCase() : null;
          var bucket = String(body.bucket || '').toLowerCase();
          var rows = _monLoadAllRowsCached_();
          var out = [];
          for (var i = 0; i < rows.length; i++) {
            var r = rows[i];
            var st = r.status;
            var isArchive = (st === 'archived' || st === 'cancelled');
            if (bucket === 'archive') { if (!isArchive) continue; }
            else if (bucket === 'active') { if (isArchive) continue; }
            else if (!includeArchived && isArchive) continue;
            if (filterYear && parseInt(r.year, 10) !== filterYear) continue;
            if (filterType && String(r.reportType).toLowerCase() !== filterType) continue;
            if (filterStatus && st !== filterStatus) continue;
            out.push(r);
          }
          out.sort(function(a, b) { return String(b.draftAt || '').localeCompare(String(a.draftAt || '')); });
          return { success: true, reports: out };
        } catch (err) {
          logError('getMONReports', err, body);
          return { success: false, error: 'getMONReports failed: ' + err.message };
        }
      }

      /**
       * Batched MON list — returns active + archive buckets in a single round-trip.
       * Cuts dashboard MON-brief latency in half (single GAS cold-start instead of two
       * parallel ones). Backwards-compatible: if `body.buckets` is missing, defaults
       * to ['active','archive'].
       *
       * Response shape: { success, results: { active: {success, reports}, archive: {success, reports} } }
       */
      function getMONReportsBatch(body) {
        try {
          body = body || {};
          var buckets = Array.isArray(body.buckets) && body.buckets.length
            ? body.buckets.map(function(b){ return String(b||'').toLowerCase(); }).filter(Boolean)
            : ['active','archive'];
          // Warm the cache ONCE for the request — every bucket below now hits the
          // in-memory row pool instead of re-reading the sheet per bucket.
          try { _monLoadAllRowsCached_(); } catch (_) {}
          var results = {};
          for (var i = 0; i < buckets.length; i++) {
            var b = buckets[i];
            var sub = Object.assign({}, body, { bucket: b });
            delete sub.buckets;
            results[b] = getMONReports(sub);
          }
          return { success: true, results: results };
        } catch (err) {
          logError('getMONReportsBatch', err, body);
          return { success: false, error: 'getMONReportsBatch failed: ' + err.message };
        }
      }

      function getMONReport(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!_monIsAuthorized_(auth, MON_ROLES.READER)) {
            return { success: false, error: 'Нямате право.' };
          }
          var reportId = String(body.reportId || '').trim();
          if (!reportId) return { success: false, error: 'Липсва reportId.' };
          var found = _monFindById_(reportId);
          if (!found) return { success: false, error: 'Отчетът не е намерен.' };
          var r = found.rowData;
          // Performance toggles — the modal opens with slim:true so the initial
          // round-trip carries only metadata; the heavy JSON blobs (editedData,
          // dataSnapshot, history) are fetched on-demand when their tab is opened.
          var slim    = body.slim === true || String(body.slim||'').toLowerCase() === 'true';
          var include = Array.isArray(body.include) ? body.include.map(function(s){ return String(s||'').toLowerCase(); }) : null;
          var wants = function(field){
            if (include) return include.indexOf(field) >= 0;
            if (slim)    return false;
            return true;
          };
          var rep = {
            id: r[MON_COL.ID - 1],
            reportType: r[MON_COL.REPORT_TYPE - 1],
            period: r[MON_COL.PERIOD - 1],
            year: r[MON_COL.YEAR - 1],
            status: String(r[MON_COL.STATUS - 1]).toLowerCase(),
            editorialNotes: r[MON_COL.EDITORIAL_NOTES - 1],
            draftBy: r[MON_COL.DRAFT_BY - 1],
            draftAt: r[MON_COL.DRAFT_AT - 1],
            editedBy: r[MON_COL.EDITED_BY - 1],
            editedAt: r[MON_COL.EDITED_AT - 1],
            finalizedBy: r[MON_COL.FINALIZED_BY - 1],
            finalizedAt: r[MON_COL.FINALIZED_AT - 1],
            submittedBy: r[MON_COL.SUBMITTED_BY - 1],
            submittedAt: r[MON_COL.SUBMITTED_AT - 1],
            submissionRef: r[MON_COL.SUBMISSION_REF - 1],
            acknowledgedAt: r[MON_COL.ACKNOWLEDGED_AT - 1],
            exportFileId: r[MON_COL.EXPORT_FILE_ID - 1],
            exportXlsxId: r[MON_COL.EXPORT_XLSX_ID - 1],
            signatureHash: r[MON_COL.SIGNATURE_HASH - 1],
            notes: r[MON_COL.NOTES - 1],
            // Always include attachments — small array, used by Files tab and
            // overview links. Heavy snapshots are gated below.
            attachments: _monParseJson_(r[MON_COL.ATTACHMENTS - 1], [])
          };
          if (wants('datasnapshot')) rep.dataSnapshot = _monParseJson_(r[MON_COL.DATA_SNAPSHOT - 1], {});
          if (wants('editeddata'))   rep.editedData   = _monParseJson_(r[MON_COL.EDITED_DATA - 1], {});
          if (wants('history'))      rep.history      = _monParseJson_(r[MON_COL.HISTORY - 1], []);
          return { success: true, report: rep, slim: slim, included: include || (slim ? [] : ['dataSnapshot','editedData','history']) };
        } catch (err) {
          logError('getMONReport', err, body);
          return { success: false, error: 'getMONReport failed: ' + err.message };
        }
      }

      function editMONReport(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!_monIsAuthorized_(auth, MON_ROLES.EDITOR)) {
            return { success: false, error: 'Нямате право.' };
          }
          var reportId = String(body.reportId || '').trim();
          if (!reportId) return { success: false, error: 'Липсва reportId.' };
          var found = _monFindById_(reportId);
          if (!found) return { success: false, error: 'Отчетът не е намерен.' };
          var st = String(found.rowData[MON_COL.STATUS - 1]).toLowerCase();
          if ([MON_STATUS.CREATED, MON_STATUS.UNDER_EDITORIAL_REVIEW].indexOf(st) === -1) {
            return { success: false, error: 'Отчетът не може да се редактира в статус „' + st + '".' };
          }
          var editedData = body.editedData;
          if (typeof editedData !== 'object' || editedData == null) {
            try { editedData = JSON.parse(String(body.editedData || '{}')); } catch (e) {
              return { success: false, error: 'Невалиден JSON в editedData.' };
            }
          }
          var editorialNotes = String(body.editorialNotes || '');
          var now = nowISO();
          var historyArr = _monParseJson_(found.rowData[MON_COL.HISTORY - 1], []);
          var newStatus = st === MON_STATUS.CREATED ? MON_STATUS.UNDER_EDITORIAL_REVIEW : st;
          if (newStatus !== st) {
            historyArr = _monAppendHistory_(historyArr, { status: newStatus, ts: now, by: auth.userId, role: auth.role, note: 'Започната редакция' });
          }
          historyArr = _monAppendHistory_(historyArr, { status: newStatus, ts: now, by: auth.userId, role: auth.role, note: 'Редактирани данни', edited: true });

          found.sheet.getRange(found.rowIndex, MON_COL.EDITED_DATA).setValue(JSON.stringify(editedData));
          found.sheet.getRange(found.rowIndex, MON_COL.EDITORIAL_NOTES).setValue(editorialNotes);
          found.sheet.getRange(found.rowIndex, MON_COL.EDITED_BY).setValue(auth.userId);
          found.sheet.getRange(found.rowIndex, MON_COL.EDITED_AT).setValue(now);
          found.sheet.getRange(found.rowIndex, MON_COL.STATUS).setValue(newStatus);
          found.sheet.getRange(found.rowIndex, MON_COL.HISTORY).setValue(JSON.stringify(historyArr));

          try { logTransaction('EDIT_MON_REPORT', auth.userId, reportId, { newStatus: newStatus }); } catch (_) {}
          return { success: true };
        } catch (err) {
          logError('editMONReport', err, body);
          return { success: false, error: 'editMONReport failed: ' + err.message };
        }
      }

      function refreshMONReportData(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!_monIsAuthorized_(auth, MON_ROLES.EDITOR)) {
            return { success: false, error: 'Нямате право.' };
          }
          var reportId = String(body.reportId || '').trim();
          var found = _monFindById_(reportId);
          if (!found) return { success: false, error: 'Отчетът не е намерен.' };
          var st = String(found.rowData[MON_COL.STATUS - 1]).toLowerCase();
          if ([MON_STATUS.CREATED, MON_STATUS.UNDER_EDITORIAL_REVIEW].indexOf(st) === -1) {
            return { success: false, error: 'Не може да се обнови в статус „' + st + '".' };
          }
          var year = parseInt(found.rowData[MON_COL.YEAR - 1], 10);
          var reportType = String(found.rowData[MON_COL.REPORT_TYPE - 1]);
          var period = String(found.rowData[MON_COL.PERIOD - 1]);
          var snapshotRes = generateMONReport({ year: year, reportType: reportType, period: period, periodStart: body.periodStart||'', periodEnd: body.periodEnd||'', userId: auth.userId, isAdmin: auth.isAdmin, email: auth.userId });
          if (!snapshotRes || snapshotRes.success === false) {
            return { success: false, error: 'Неуспешно генериране на нова снимка.' };
          }
          var now = nowISO();
          var historyArr = _monParseJson_(found.rowData[MON_COL.HISTORY - 1], []);
          historyArr = _monAppendHistory_(historyArr, { status: MON_STATUS.RETURNED_FOR_DATA_REFRESH, ts: now, by: auth.userId, role: auth.role, note: 'Обновени системни данни' });
          historyArr = _monAppendHistory_(historyArr, { status: st, ts: now, by: auth.userId, role: auth.role, note: 'Връщане към ' + st });
          found.sheet.getRange(found.rowIndex, MON_COL.DATA_SNAPSHOT).setValue(JSON.stringify(snapshotRes));
          found.sheet.getRange(found.rowIndex, MON_COL.HISTORY).setValue(JSON.stringify(historyArr));
          try { logTransaction('REFRESH_MON_DATA', auth.userId, reportId, {}); } catch (_) {}
          return { success: true, snapshot: snapshotRes, diffSummary: { refreshedAt: now } };
        } catch (err) {
          logError('refreshMONReportData', err, body);
          return { success: false, error: 'refreshMONReportData failed: ' + err.message };
        }
      }

      function finalizeMONReport(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!_monIsAuthorized_(auth, MON_ROLES.FINALIZER)) {
            return { success: false, error: 'Само Зам.-ректор НИИРК или Администратор може да финализира.' };
          }
          var reportId = String(body.reportId || '').trim();
          var found = _monFindById_(reportId);
          if (!found) return { success: false, error: 'Отчетът не е намерен.' };
          var st = String(found.rowData[MON_COL.STATUS - 1]).toLowerCase();
          if (st !== MON_STATUS.UNDER_EDITORIAL_REVIEW) {
            return { success: false, error: 'Не може да се финализира в статус „' + st + '".' };
          }
          var now = nowISO();
          var historyArr = _monParseJson_(found.rowData[MON_COL.HISTORY - 1], []);
          historyArr = _monAppendHistory_(historyArr, { status: MON_STATUS.FINALIZED, ts: now, by: auth.userId, role: auth.role });

          var pdfId = '';
          var xlsxId = '';
          try { pdfId = _generateMONReportPdf_(reportId); } catch (e1) { console.warn('PDF gen failed: ' + e1.message); }
          try { xlsxId = _generateMONReportXlsx_(reportId); } catch (e2) { console.warn('XLSX gen failed: ' + e2.message); }

          found.sheet.getRange(found.rowIndex, MON_COL.STATUS).setValue(MON_STATUS.FINALIZED);
          found.sheet.getRange(found.rowIndex, MON_COL.FINALIZED_BY).setValue(auth.userId);
          found.sheet.getRange(found.rowIndex, MON_COL.FINALIZED_AT).setValue(now);
          if (pdfId) found.sheet.getRange(found.rowIndex, MON_COL.EXPORT_FILE_ID).setValue(pdfId);
          if (xlsxId) found.sheet.getRange(found.rowIndex, MON_COL.EXPORT_XLSX_ID).setValue(xlsxId);
          found.sheet.getRange(found.rowIndex, MON_COL.HISTORY).setValue(JSON.stringify(historyArr));

          var pdfUrl = pdfId ? ('https://drive.google.com/file/d/' + pdfId + '/view') : '';
          // Notify Rector(s) — admins act as Rector recipients in this build.
          _monNotify_(_monNidds_(), 'МОН отчет ' + found.rowData[MON_COL.PERIOD - 1] + ' готов за подаване',
            '🔒 Отчет към МОН готов за подпис',
            [{ label: 'ID', value: reportId }, { label: 'Период', value: String(found.rowData[MON_COL.PERIOD - 1]) }, { label: 'Финализиран от', value: auth.userId }, { label: 'PDF', value: pdfUrl || '(не е генериран)' }]);

          try { logTransaction('FINALIZE_MON_REPORT', auth.userId, reportId, { pdfId: pdfId, xlsxId: xlsxId }); } catch (_) {}
          return { success: true, exportFileId: pdfId, exportXlsxId: xlsxId, exportFileUrl: pdfUrl };
        } catch (err) {
          logError('finalizeMONReport', err, body);
          return { success: false, error: 'finalizeMONReport failed: ' + err.message };
        }
      }

      function submitMONReport(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!_monIsAuthorized_(auth, MON_ROLES.SUBMITTER)) {
            return { success: false, error: 'Само Ректорът или Администраторът може да подаде отчет към МОН.' };
          }
          var reportId = String(body.reportId || '').trim();
          var found = _monFindById_(reportId);
          if (!found) return { success: false, error: 'Отчетът не е намерен.' };
          var st = String(found.rowData[MON_COL.STATUS - 1]).toLowerCase();
          if (st !== MON_STATUS.FINALIZED) {
            return { success: false, error: 'Може да се подаде само финализиран отчет.' };
          }

          var otpCode = String(body.otpCode || body.code || '').trim();
          var email = String(auth.userId || body.email || '').toLowerCase().trim();
          if (!email) return { success: false, error: 'Липсва имейл за 2FA.' };

          if (!otpCode) {
            var iss = _2faIssue_('submitmonreport', email, reportId);
            return {
              success: false,
              require2fa: true,
              twoFactor: { email: email, cooldown: (iss && iss.cooldown) || 30 },
              message: 'Изпратен е код за потвърждение на ' + email
            };
          }
          var ver = _2faVerify_('submitmonreport', email, reportId, otpCode);
          if (!ver || ver.success !== true) {
            return { success: false, require2fa: true, otpError: (ver && ver.error) || 'Грешен код.' };
          }

          var signatureBase64 = String(body.signatureBase64 || body.signature || '').trim();
          var now = nowISO();
          // Auto-generate institutional digital seal when no manual signature
          // image was uploaded. The seal is a branded SVG containing signer
          // email, ISO timestamp and a content-hash preview — embedded into the
          // generated PDF + XLSX as a visible electronic stamp.
          var contentSnap = JSON.stringify(_monParseJson_(found.rowData[MON_COL.EDITED_DATA - 1], {}));
          var preHash = sha256Hex_(reportId + contentSnap + email + now);
          if (!signatureBase64) {
            signatureBase64 = _monAutoGenerateSeal_(reportId, email, now, preHash);
          }
          var sigPayload = reportId + contentSnap + signatureBase64 + now + email;
          var signatureHash = sha256Hex_(sigPayload);

          var pdfId = String(found.rowData[MON_COL.EXPORT_FILE_ID - 1] || '').trim();
          var xlsxId = String(found.rowData[MON_COL.EXPORT_XLSX_ID - 1] || '').trim();
          // Verify each existing artefact is still alive in Drive; if its file
          // was trashed/deleted out-of-band, regenerate. Avoids creating
          // duplicate copies on every submit attempt.
          function _monIsLiveFile_(fid) {
            if (!fid) return false;
            try { var f = DriveApp.getFileById(fid); return !!f && !f.isTrashed(); }
            catch (_) { return false; }
          }
          if (!_monIsLiveFile_(pdfId))  { try { pdfId  = _generateMONReportPdf_(reportId); } catch (e1) { console.warn('PDF regen: '+e1.message); } }
          if (!_monIsLiveFile_(xlsxId)) { try { xlsxId = _generateMONReportXlsx_(reportId); } catch (e2) { console.warn('XLSX regen: '+e2.message); } }
          // Track signature-append failures so the client can warn the user.
          // Previously these were swallowed silently — the Rector could submit
          // an unsigned PDF to MON without any indication. Now: failures are
          // collected and returned in `signatureWarnings`; if BOTH artefacts
          // fail to receive the signature, the submit aborts with an error.
          var signatureWarnings = [];
          if (pdfId)  { try { _appendSignatureToMONFile_(pdfId,  signatureBase64, email); } catch (sigErr1) { signatureWarnings.push({ kind:'pdf',  fileId:pdfId,  error:sigErr1.message }); console.warn('PDF sign failed: '  + sigErr1.message); } }
          if (xlsxId) { try { _appendSignatureToMONFile_(xlsxId, signatureBase64, email); } catch (sigErr2) { signatureWarnings.push({ kind:'xlsx', fileId:xlsxId, error:sigErr2.message }); console.warn('XLSX sign failed: ' + sigErr2.message); } }
          if (signatureWarnings.length === 2) {
            return { success:false, error:'Не успя да бъде положен електронен подпис върху нито PDF, нито XLSX. Опитайте отново или се обърнете към Администратор.', signatureWarnings:signatureWarnings };
          }
          // Dedicated audit hooks for both signed artifacts
          try { _logMonDocAudit_(reportId, 'MON_REPORT_SUBMITTED_PDF',  pdfId,  email, signatureHash, { period: String(found.rowData[MON_COL.PERIOD - 1]||'') }); } catch (_) {}
          try { _logMonDocAudit_(reportId, 'MON_REPORT_SUBMITTED_XLSX', xlsxId, email, signatureHash, { period: String(found.rowData[MON_COL.PERIOD - 1]||'') }); } catch (_) {}

          var historyArr = _monParseJson_(found.rowData[MON_COL.HISTORY - 1], []);
          historyArr = _monAppendHistory_(historyArr, { status: MON_STATUS.SUBMITTED, ts: now, by: email, role: auth.role, signatureHash: signatureHash, signatureWarnings: signatureWarnings.length ? signatureWarnings : undefined });

          found.sheet.getRange(found.rowIndex, MON_COL.STATUS).setValue(MON_STATUS.SUBMITTED);
          found.sheet.getRange(found.rowIndex, MON_COL.SUBMITTED_BY).setValue(email);
          found.sheet.getRange(found.rowIndex, MON_COL.SUBMITTED_AT).setValue(now);
          found.sheet.getRange(found.rowIndex, MON_COL.SIGNATURE_HASH).setValue(signatureHash);
          found.sheet.getRange(found.rowIndex, MON_COL.SIGNATURE_DATA).setValue(signatureBase64);
          found.sheet.getRange(found.rowIndex, MON_COL.HISTORY).setValue(JSON.stringify(historyArr));

          var signedFileUrl = pdfId ? ('https://drive.google.com/file/d/' + pdfId + '/view') : '';
          _monNotify_(_monNidds_(), 'МОН отчет ' + found.rowData[MON_COL.PERIOD - 1] + ' подаден от Ректора',
            '✅ Отчет към МОН подаден',
            [{ label: 'ID', value: reportId }, { label: 'Подаден от', value: email }, { label: 'Подадено на', value: now }, { label: 'Подпис (хеш)', value: signatureHash.substring(0, 16) + '…' }, { label: 'PDF', value: signedFileUrl }]);

          try { logTransaction('SUBMIT_MON_REPORT', email, reportId, { signatureHash: signatureHash, signatureWarnings: signatureWarnings.length || 0 }); } catch (_) {}
          return { success: true, submittedAt: now, signatureHash: signatureHash, signedFileUrl: signedFileUrl, signatureWarnings: signatureWarnings };
        } catch (err) {
          logError('submitMONReport', err, body);
          return { success: false, error: 'submitMONReport failed: ' + err.message };
        }
      }

      function acknowledgeMONSubmission(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!_monIsAuthorized_(auth, MON_ROLES.EDITOR)) {
            return { success: false, error: 'Нямате право.' };
          }
          var reportId = String(body.reportId || '').trim();
          var found = _monFindById_(reportId);
          if (!found) return { success: false, error: 'Отчетът не е намерен.' };
          var st = String(found.rowData[MON_COL.STATUS - 1]).toLowerCase();
          if (st !== MON_STATUS.SUBMITTED) {
            return { success: false, error: 'Само подаден отчет може да бъде потвърден.' };
          }
          var ministryRef = String(body.ministryRef || '').trim();
          if (!ministryRef) return { success: false, error: 'Липсва входящ номер от МОН.' };
          var ackAt = String(body.acknowledgedAt || '').trim() || nowISO();
          var attachmentDriveId = String(body.attachmentDriveId || '').trim();

          var historyArr = _monParseJson_(found.rowData[MON_COL.HISTORY - 1], []);
          historyArr = _monAppendHistory_(historyArr, { status: MON_STATUS.ACKNOWLEDGED, ts: nowISO(), by: auth.userId, role: auth.role, note: 'МОН вх. № ' + ministryRef });
          var attachments = _monParseJson_(found.rowData[MON_COL.ATTACHMENTS - 1], []);
          if (attachmentDriveId) {
            attachments.push({ name: 'MON-Acknowledgment', driveId: attachmentDriveId, addedAt: nowISO() });
          }

          found.sheet.getRange(found.rowIndex, MON_COL.STATUS).setValue(MON_STATUS.ACKNOWLEDGED);
          found.sheet.getRange(found.rowIndex, MON_COL.ACKNOWLEDGED_AT).setValue(ackAt);
          found.sheet.getRange(found.rowIndex, MON_COL.SUBMISSION_REF).setValue(ministryRef);
          found.sheet.getRange(found.rowIndex, MON_COL.HISTORY).setValue(JSON.stringify(historyArr));
          found.sheet.getRange(found.rowIndex, MON_COL.ATTACHMENTS).setValue(JSON.stringify(attachments));

          _monNotify_(_monNidds_(), 'МОН потвърди отчет ' + found.rowData[MON_COL.PERIOD - 1],
            '📨 МОН потвърди получаване',
            [{ label: 'ID', value: reportId }, { label: 'Вх. № МОН', value: ministryRef }, { label: 'Потвърдено на', value: ackAt }]);

          try { logTransaction('ACK_MON_REPORT', auth.userId, reportId, { ministryRef: ministryRef }); } catch (_) {}
          return { success: true };
        } catch (err) {
          logError('acknowledgeMONSubmission', err, body);
          return { success: false, error: 'acknowledgeMONSubmission failed: ' + err.message };
        }
      }

      function rejectMONByMinistry(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!_monIsAuthorized_(auth, MON_ROLES.EDITOR)) {
            return { success: false, error: 'Нямате право.' };
          }
          var reportId = String(body.reportId || '').trim();
          var reason = String(body.rejectionReason || '').trim();
