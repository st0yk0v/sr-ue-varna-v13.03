      /* ============================================================================
       * copyTemplateForUser({projectType, templateKey})
       * Applicant-facing wrapper. Looks up the template doc id from
       * REQUIRED_APPLICATION_TEMPLATES, then copies it into the user's
       * "My Documents" folder (same target as copyDocForUser). Returns the
       * copy metadata so the frontend can immediately offer an edit link.
       * Admin/CKK callers also work — handy when assisting an applicant.
       * ============================================================================ */
      function copyTemplateForUser(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.authenticated) return { success: false, error: 'Необходима е автентикация.' };
          var projectType = String(body.projectType || '').trim();
          var templateKey = String(body.templateKey || '').trim().toLowerCase();
          if (!projectType || !templateKey) return { success: false, error: 'projectType и templateKey са задължителни.' };
          if (typeof REQUIRED_APPLICATION_TEMPLATES === 'undefined') {
            return { success: false, error: 'Шаблонният регистър не е инициализиран.' };
          }
          var typeMap = REQUIRED_APPLICATION_TEMPLATES[projectType];
          if (!typeMap) return { success: false, error: 'Неизвестен тип проект: ' + projectType };
          var spec = typeMap[templateKey];
          if (!spec || !spec.name) return { success: false, error: 'Неизвестен шаблон: ' + templateKey };
          // Resolve via the smart library finder (folder fallbacks, slug match,
          // lowercase/extension variants). Mirrors the resolver used by
          // getRequiredApplicationTemplates so behaviour stays consistent.
          var original = null;
          try { original = _findTemplateFileInLibrary_(spec.name, projectType); }
          catch (e) { return { success: false, error: 'Не може да се отвори библиотеката с шаблони: ' + e.message }; }
          if (!original) return { success: false, error: 'Шаблонът „' + spec.name + '" не е намерен в библиотеката.' };

          // Copy into the user's My Documents folder.
          var userFolder = getOrCreateMyDocsFolder_(auth.userId || '');
          if (!userFolder) return { success: false, error: 'Не може да се създаде лична папка.' };
          var baseName = original.getName();
          var copyName = baseName;
          // v12.26.0-perf: Cache regex match
          var _cpBaseName2 = baseName.replace(/(\.[^.]+)$/, '');
          var _cpExt2 = baseName.match(/(\.[^.]+)$/);
          var _cpExtStr2 = _cpExt2 ? _cpExt2[0] : '';
          var existing = userFolder.getFilesByName(copyName);
          if (existing.hasNext()) {
            var idx = 1;
            do {
              copyName = _cpBaseName2 + ' (копие ' + (++idx) + ')' + _cpExtStr2;
            } while (userFolder.getFilesByName(copyName).hasNext() && idx < 50);
          }
          var copy = original.makeCopy(copyName, userFolder);
