        try { props = _scriptProps_().getProperties(); } catch (_) { return; }
        var keep = prefix + role + ':' + String(currentVersion) + ':';
        var rolePrefix = prefix + role + ':';
        var stale = [];
        var keys = Object.keys(props);
        for (var i = 0; i < keys.length; i++) {
