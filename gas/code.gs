          } catch (_) {}
          try { logTransaction('DEADLINE_AUTOMATION_RUN', 'system', 'auto', results); } catch (_) {}
          return { success: true, results: results };
        } catch (err) {
          try { logError('runDeadlineAutomation', err, body); } catch (_) {}
          return { success: false, error: err.message };
        }
      }

      /**
       * UC-mission-control: server-authoritative role-aware dashboard context.
       * Returns a small payload (target < 4 KB) consumed by DashboardView for:
       *   - active BPMN phase highlight (the phase the user should act on now)
       *   - role bucket → which KPI tiles to render
       *   - per-role attention count (so the page can render the badge before
       *     the heavier `getCompetitionsFeed` arrives)
       *   - current session (selected competition id + week + budget summary)
       *
       * Client falls back to client-side computation if this endpoint fails or
       * is older than the data version, so the dashboard remains usable.
       */
      function getDashboardContext(body) {
        try {
          body = body || {};
          // PERF: Conditional fetch FIRST — if versions match, return ~120 bytes
          // without ever resolving auth (saves a bridge call on steady-state polls).
          var _nm = _ifVersionsMatch_(body, ['applications','competitions','system']);
          if (_nm) return _nm;

          var auth = resolveAuthContext(body);
          var userId = String(auth.userId || body.userId || '').toLowerCase();
          // v9.37.0-regulatory: use server-authoritative role from resolveUserRole_
          // instead of client-claimed body.role (defense-in-depth)
          var role = String(auth.role || body.role || '').toLowerCase();
          var isAdmin = !!auth.isAdmin;
          var now = new Date();
          var dayMs = 86400000;

          // CacheService version-keyed bundle (role + user aware). Populated on
          // cold-start; subsequent calls within the same 5-min window are served
          // in <5 ms (just a CacheService bridge crossing + JSON.parse).
          var dctxDv = getDataVersions_();
          var dctxKey = 'dctx:v2:' + (isAdmin ? 'a' : 'u:' + userId) + ':' + dctxDv.applications + ':' + dctxDv.competitions + ':' + dctxDv.system;
          var dctxSc = _scriptCache_();
          try {
            var dctxCached = dctxSc.get(dctxKey);
            if (dctxCached) {
              var dctxP = JSON.parse(dctxCached);
              if (dctxP && dctxP.success) { dctxP.cached = true; return dctxP; }
            }
          } catch (_) {}

          // ── Resolve role bucket (mirrors frontend logic) ──
          var bucket = 'applicant';
          if (isAdmin || role === 'ckk' || role === 'nidd' || role === 'rector' ||
              role === 'vice_rector' || role === 'academic_council') bucket = 'privileged';
          else if (role === 'reviewer' || role === 'applicant_reviewer') bucket = 'reviewer';

          // ── Pull data via existing cached helpers (no fresh sheet reads) ──
          var competitions = [];
          try { competitions = getOrCacheCompetitions(false) || []; } catch (_) { competitions = []; }
          var apps = [];
          try {
            var fRes = getForms({ userId: userId, role: role, isAdmin: isAdmin, _adminCreds: body._adminCreds });
            apps = (fRes && fRes.success && Array.isArray(fRes.forms)) ? fRes.forms : [];
          } catch (_) { apps = []; }

          // ── Pick the most relevant active competition (mirrors frontend rule) ──
          var liveStatuses = { active:1, open_for_submission:1, published:1, opened:1, evaluation_in_progress:1 };
          var myCompIds = {};
          for (var i = 0; i < apps.length; i++) {
            var a = apps[i] || {};
            var em = String(a.userEmail || a.email || '').toLowerCase();
            if (em === userId && a.competitionId) myCompIds[String(a.competitionId)] = 1;
          }
          function deadlineKey(c) {
            var d = c.deadline || c.dateEnd; var t = d ? new Date(d).getTime() : NaN;
            return isNaN(t) ? Infinity : t;
          }
          var liveMine = competitions.filter(function(c){return myCompIds[String(c.id)] && liveStatuses[String(c.status||'').toLowerCase()];}).sort(function(a,b){return deadlineKey(a)-deadlineKey(b);});
          var live = competitions.filter(function(c){return liveStatuses[String(c.status||'').toLowerCase()];}).sort(function(a,b){return deadlineKey(a)-deadlineKey(b);});
          var pick = liveMine[0] || live[0] || competitions[0] || null;
          var pickId = pick ? String(pick.id) : '';

          // ── Compute active BPMN phase per role bucket ──
          // Lane priority order (most-actionable first per bucket).
          var lanePriority = {
            privileged: ['screening','review','scoring','approval','contracting','reporting','execution','corrections','intake','closing','configuration'],
            reviewer:   ['review','scoring','reporting','approval','screening','contracting','execution','closing','intake','corrections','configuration'],
            applicant:  ['corrections','intake','review','contracting','execution','reporting','screening','scoring','approval','closing','configuration']
          }[bucket];
          // Status → lane map (subset, mirrors BPMN_PHASES.statuses).
          var statusToLane = {
            configured:'configuration', approved_by_ac:'configuration', published:'configuration', open_for_submission:'configuration',
            draft:'intake', completed:'intake', submitted:'intake',
            admin_review:'screening', admin_passed:'screening', eligible:'screening', ineligible:'screening',
            returned:'corrections', needs_correction:'corrections', resubmitted:'screening',
            reviewers_proposed:'review', reviewer_assignment:'review', reviewer_invited:'review', reviewer_accepted:'review',
            in_review:'review', review_submitted:'review', reviewed:'review',
            scored:'scoring', ranked:'scoring', proposed_for_funding:'scoring', rejected:'scoring',
            approved_for_funding:'approval', approved:'approval',
            contract_draft:'contracting', contract_package_ready:'contracting', contracting:'contracting', contract_signed:'contracting', contracted:'contracting',
            active:'execution', in_execution:'execution', progress_updated:'execution', expense_requested:'execution',
            change_requested:'execution', change_under_review:'execution', change_approved:'execution', change_rejected:'execution',
            reporting_due:'reporting', report_submitted:'reporting', report_under_review:'reporting',
            report_accepted:'reporting', report_returned_for_correction:'reporting',
            final_report_prepared:'reporting', final_review_submitted:'reporting', final_evaluation:'reporting', final_reporting:'reporting',
            successfully_completed:'closing', partially_completed:'closing', unsatisfactory:'closing',
            closed:'closing', closed_with_sanction:'closing', closed_with_restriction:'closing', sanction_3year:'closing', archived:'closing'
          };
          // ── PERF (v3.29.0-sec2): skipItems=true avoids collecting item summaries ──
          // When the frontend only needs lane counts (not the expanded lane table),
          // skip the per-item object creation (~120 bytes × up to 50 items = 6KB).
          var skipItems = body.skipItems === true || body.skipItems === 'true';
          // Count items per lane, scoped to the picked competition when set,
          // and to the user's own forms when bucket=applicant.
          var laneCounts = {};
          var laneItems = {}; // { laneId: [ {id,title,status,userName,userEmail,date,competitionId}, ... ] }
          var totalItemSlots = 0;
          var MAX_LANE_ITEMS = skipItems ? 0 : 50;
          for (var j = 0; j < apps.length; j++) {
            var it = apps[j] || {};
            if (pickId && String(it.competitionId||'') !== pickId) continue;
            if (bucket === 'applicant') {
              var em2 = String(it.userEmail || it.email || '').toLowerCase();
              if (em2 !== userId) continue;
            }
            var lane = statusToLane[String(it.status||'').toLowerCase()];
            if (!lane) continue;
            laneCounts[lane] = (laneCounts[lane]||0) + 1;
            // Collect item summary only when requested (compact — ~120 bytes each)
            if (!skipItems && totalItemSlots < MAX_LANE_ITEMS) {
              if (!laneItems[lane]) laneItems[lane] = [];
              laneItems[lane].push({
                id: String(it.id||''),
                title: String(it.title||it.Title||'').slice(0,120),
                status: String(it.status||''),
                userName: String(it.userName||it.UserName||''),
                userEmail: String(it.userEmail||it.email||''),
                date: String(it.submitted||it.created||it.Submitted||it.Created||''),
                competitionId: String(it.competitionId||'')
              });
              totalItemSlots++;
            }
          }
          // Pick the highest-priority lane that has items; if none, pick the
          // first lane in priority order regardless (so the BPMN strip still
          // highlights *something* meaningful for the role).
          var activePhase = null;
          for (var k = 0; k < lanePriority.length; k++) {
            if (laneCounts[lanePriority[k]] > 0) { activePhase = lanePriority[k]; break; }
          }
          if (!activePhase) activePhase = lanePriority[0];

          // ── Session week relative to picked competition's openDate ──
          var sessionWeek = null; var sessionWeekIsCalendar = false;
          var startRaw = pick && (pick.openDate || pick.startDate || pick.created);
          if (startRaw) {
            var t = new Date(startRaw).getTime();
            if (!isNaN(t) && t <= now.getTime()) sessionWeek = Math.max(1, Math.ceil((now.getTime()-t)/(7*dayMs)));
          }
          if (sessionWeek === null) {
            sessionWeekIsCalendar = true;
            var d = now;
            var tt = new Date(Date.UTC(d.getFullYear(),d.getMonth(),d.getDate()));
            var dn = tt.getUTCDay() || 7;
            tt.setUTCDate(tt.getUTCDate()+4-dn);
            var ys = new Date(Date.UTC(tt.getUTCFullYear(),0,1));
            sessionWeek = Math.ceil(((tt-ys)/dayMs+1)/7);
          }

          // ── Per-role quick KPIs (small, the heavy ones come from feed) ──
          var attention = 0;
          for (var L in laneCounts) attention += laneCounts[L];

          var dctxResult = {
            success: true,
            bucket: bucket,
            activePhase: activePhase,
            laneCounts: laneCounts,
            laneItems: laneItems,       // ≤50 lightweight summaries for lane detail
            attention: attention,
            totalItems: totalItemSlots,
            session: pick ? {
              id: pickId,
              name: pick.name || '',
              year: pick.year || '',
              startDate: pick.openDate || pick.startDate || pick.created || '',
              deadline: pick.deadline || pick.dateEnd || '',
              week: sessionWeek,
              weekIsCalendar: sessionWeekIsCalendar,
              budget: Number(pick.budget) || Number(pick.totalBudget) || 0
            } : null,
            generatedAt: now.toISOString(),
            // Use `versions` (standard field name) so _captureServerDataVersions
            // on the frontend captures and forwards it as `_dv` on next call.
            versions: getDataVersions_()
          };
          // Store in CacheService so the 2nd call within the 5-min TTL is near-instant.
          try {
            var dctxJs = JSON.stringify(dctxResult);
            if (dctxJs.length < 50000) dctxSc.put(dctxKey, dctxJs, PERF_MODE ? 600 : 120);
          } catch (_) {}
          return dctxResult;
        } catch (err) {
          try { logError('getDashboardContext', err, body); } catch (_) {}
          return { success: false, error: 'getDashboardContext failed: ' + err.message };
        }
      }

      /**
       * UC-perf: Admin single-round-trip competition panel.
       * Returns competitions + applications for a given competition + reviewer pool
       * in ONE GAS execution, eliminating 3 sequential cold-starts from the
       * CompetitionsView (getcompetitions → getapplicationsbycompetition → getreviewers).
       * All three inner calls share per-execution memos (_compExecMemo_, _cachedSheetData_,
       * _reviewersListMemo_) so their sheet reads are collapsed to ≤3 total.
       */
      function getCompetitionPanel(body) {
        try {
          body = body || {};
          // PERF: notModified FIRST — if versions match, return ~120 bytes without
          // resolving auth. The isAdmin gate still fires on the full-rebuild path.
          var _nm = _ifVersionsMatch_(body, ['competitions', 'applications', 'reviewers']);
          if (_nm) return _nm;

          var auth = resolveAuthContext(body);
          if (!auth.isAdmin) return { success: false, error: 'Отказан достъп: Само администратори' };
          var competitionId = String(body.competitionId || '').trim();

          // ── Competitions (uses _compMappedMemo_ on 2nd call within execution) ──
          var compsResult;
          try {
            compsResult = getCompetitions({ isAdmin: true, userId: auth.userId, activeOnly: false });
          } catch (e) { compsResult = { success: false, error: e.message, competitions: [] }; }

          // ── Applications for selected competition ──────────────────────────
          var appsResult;
          if (competitionId) {
            try {
              appsResult = getApplicationsByCompetition({ competitionId: competitionId, isAdmin: true, userId: auth.userId });
            } catch (e) { appsResult = { success: false, error: e.message, applications: [], counts: {} }; }
          } else {
            appsResult = { success: true, applications: [], counts: { total: 0 } };
          }

          // ── Reviewer pool for selected competition ─────────────────────────
          // getReviewers uses _reviewersListMemo_ + _cachedSheetData_ so the
          // Reviewers sheet read is shared with getReviewDeadlines if called next.
          var reviewersResult;
          try {
            reviewersResult = getReviewers({ isAdmin: true, userId: auth.userId, competitionId: competitionId });
          } catch (e) { reviewersResult = { success: false, error: e.message, reviewers: [] }; }

          return {
            success: true,
            competitions: compsResult,
            applications: appsResult,
            reviewers: reviewersResult,
            versions: getDataVersions_()
          };
        } catch (err) {
          logError('getCompetitionPanel', err, body);
          return { success: false, error: 'getCompetitionPanel failed: ' + err.message };
        }
      }

      /**
       * Get project dashboard stats — admin overview.
       */
      function getProjectDashboard(body) {
        try {
          var auth = resolveAuthContext(body);

          // notModified short-circuit — dashboard stats depend on projects + system.
          var _nm = _ifVersionsMatch_(body, ['projects', 'system']);
          if (_nm) return _nm;

          // CacheService version-keyed cache (5 min in PERF_MODE, 2 min otherwise).
          // Key embeds project + system versions so any mutation via
          // touchDataVersion_('projects') produces a new key automatically.
          var dv = getDataVersions_();
          var cacheKey = 'gpd:v1:' + dv.projects + ':' + dv.system;
          var sc = _scriptCache_();
          try {
            var _cached = sc.get(cacheKey);
            if (_cached) {
              var _p = JSON.parse(_cached);
              if (_p && _p.success) { _p.cached = true; return _p; }
            }
          } catch (_) {}

          // Use _cachedSheetData_ so within-execution re-reads (e.g. from a
          // batchApi call that already touched these sheets) are free.
          var projSheet = getProjectsSheet();
          var projData = _cachedSheetData_(projSheet);
          var expSheet = getExpensesSheet();
          var expData = _cachedSheetData_(expSheet);
          var rptSheet = getReportsSheet();
          var rptData = _cachedSheetData_(rptSheet);

          var stats = {
            totalProjects: 0,
            byStatus: {},
            byDirection: {},
            byYear: {},
            totalBudgetAllocated: 0,
            totalBudgetSpent: 0,
            pendingExpenses: 0,
            pendingReports: 0,
            overdueReports: 0
          };

          for (var i = 1; i < projData.length; i++) {
            var r = projData[i];
            if (!String(r[PROJ_COL.ID - 1]).trim()) continue;
            stats.totalProjects++;
            var st = String(r[PROJ_COL.STATUS - 1]).trim() || 'unknown';
            stats.byStatus[st] = (stats.byStatus[st] || 0) + 1;
            var dir = String(r[PROJ_COL.DIRECTION - 1]).trim() || 'Без направление';
            stats.byDirection[dir] = (stats.byDirection[dir] || 0) + 1;
            var yr = String(r[PROJ_COL.YEAR - 1]).trim() || 'N/A';
            stats.byYear[yr] = (stats.byYear[yr] || 0) + 1;
            try {
              var b = JSON.parse(String(r[PROJ_COL.BUDGET - 1] || '{}'));
              stats.totalBudgetAllocated += parseFloat(b.total || 0) || 0;
            } catch (_) {}
            try {
              var be = JSON.parse(String(r[PROJ_COL.BUDGET_EXECUTION - 1] || '{}'));
              Object.keys(be).forEach(function(grp) {
                Object.keys(be[grp] || {}).forEach(function(y) { stats.totalBudgetSpent += parseFloat(be[grp][y] || 0) || 0; });
              });
            } catch (_) {}
          }

          // Pending expenses
          for (var e2 = 1; e2 < expData.length; e2++) {
            if (String(expData[e2][EXP_COL.STATUS - 1]).trim() === 'pending') stats.pendingExpenses++;
          }

          // Pending reports
          for (var r2 = 1; r2 < rptData.length; r2++) {
            var rs = String(rptData[r2][RPT_COL.STATUS - 1]).trim();
            if (rs === 'submitted') stats.pendingReports++;
          }

          // Overdue deadlines
          try {
            var dlRes = getReportDeadlines({ userId: auth.userId });
            if (dlRes.success) stats.overdueReports = dlRes.overdueCount || 0;
          } catch (_) {}

          var result = { success: true, dashboard: stats, versions: getDataVersions_() };
          // Store in CacheService — keyed by versions so stale-on-mutation is impossible.
          try {
            var js = JSON.stringify(result);
            if (js.length < 90000) sc.put(cacheKey, js, PERF_MODE ? 1800 : 120);
          } catch (_) {}
          return result;
        } catch (err) {
          logError('getProjectDashboard', err, body);
          return { success: false, error: 'getProjectDashboard failed: ' + err.message };
        }
      }

      // ============================================================
      //  UNIFIED BOARD DATA — single round-trip for the merged
      //  "Конкурси / Табло" view. Aggregates competitions + project
      //  dashboard + workflow stats in ONE call so the cold-start
      //  cost of the merged board is one GAS invocation instead of
      //  three sequential ones. Per-role filtering: applicants and
      //  reviewers receive the public competition list and NO
      //  privileged dashboard stats; admin / CKK / NIDD receive the
      //  full administrative payload. Read-only.
      //
      //  Scaling layers (cheapest → most expensive):
      //    1. notModified short-circuit — if the client's _dv versions match
      //       the server's, return ~120 bytes without touching any sheet.
      //    2. CacheService bundle — version + role-keyed; subsequent calls in
      //       the 5-min window are served from cache (~5 ms).
      //    3. Full rebuild — aggregates the role-appropriate sub-payloads.
      // ============================================================
      function getBoardData(body) {
        try {
          body = body || {};

          // (1) notModified — board depends on competitions, applications,
          //     projects and system versions. If none changed, the client's
          //     cached board is still authoritative.
          var _nm = _ifVersionsMatch_(body, ['competitions', 'applications', 'projects', 'system']);
          if (_nm) return _nm;

          var auth = resolveAuthContext(body);
          var role = String((auth && auth.role) || body.userRole || '').toLowerCase();
          var privileged = !!(auth && auth.isAdmin) ||
            role === 'ckk' || role === 'nidd' ||
            role === 'vice_rector' || role === 'rector' ||
            role === 'academic_council';

          // (2) CacheService bundle — keyed by versions + role bucket so any
          //     mutation (touchDataVersion_) auto-invalidates and roles never
          //     leak each other's payloads. User-scoped because the privileged
          //     context payload is per-user.
          var dv = getDataVersions_();
          var bucket = privileged ? 'priv' : 'pub';
          var who = privileged ? String((auth && auth.userId) || '').toLowerCase() : 'anon';
          var cacheKey = 'board:v2:' + bucket + ':' + who + ':' +
            dv.competitions + ':' + dv.applications + ':' + dv.projects + ':' + dv.system;
          var sc = _scriptCache_();
          try {
            var cached = sc.get(cacheKey);
            if (cached) {
              var cp = JSON.parse(cached);
              if (cp && cp.success) { cp.cached = true; return cp; }
            }
          } catch (_) {}

          // (3) Full rebuild — role-aware competitions list.
          var competitions;
          try {
            competitions = privileged
              ? getCompetitions({ isAdmin: true, userId: auth.userId, activeOnly: false })
              : getPublicCompetitions({ userId: auth.userId });
          } catch (e) {
            competitions = { success: false, error: e.message, competitions: [] };
          }

          var result = {
            success: true,
            role: role || (privileged ? 'admin' : 'applicant'),
            privileged: privileged,
            competitions: competitions,
            versions: dv
          };

          // Privileged-only: project dashboard + role-aware context.
          if (privileged) {
            try {
              var dash = getProjectDashboard({ userId: auth.userId, isAdmin: true });
              result.dashboard = (dash && dash.success) ? dash.dashboard : null;
            } catch (e) { result.dashboard = null; result.dashboardError = e.message; }
            try {
              if (typeof getDashboardContext === 'function') {
                var ctx = getDashboardContext({ userId: auth.userId, role: role, isAdmin: true, _adminCreds: body._adminCreds });
                result.context = (ctx && ctx.success) ? ctx : null;
              }
            } catch (e) { result.context = null; result.contextError = e.message; }
          }

          // Store the assembled bundle — keyed by versions so stale-on-mutation
          // is structurally impossible. Skip oversized payloads (CacheService
          // hard-caps a value at 100 KB).
          try {
            var jsB = JSON.stringify(result);
            if (jsB.length < 95000) sc.put(cacheKey, jsB, PERF_MODE ? 1800 : 300);
          } catch (_) {}

          return result;
        } catch (err) {
          logError('getBoardData', err, body);
          return { success: false, error: 'getBoardData failed: ' + err.message };
        }
      }

      // ============================================================
      //  CONTRACT SIGNING DEADLINE — 10-day enforcement per regulation
      //  "Договорите се сключват в 10-дневен срок след решението
      //   за окончателно класиране."
      // ============================================================

      /**
      /**
       * Get review deadlines: 10 days from consent date per regulation.
       * Returns list of reviewers with approaching/overdue deadlines.
       */
      function getReviewDeadlines(body) {
        try {
          var auth = resolveAuthContext(body);

          // CacheService version-keyed cache. Review deadlines change only when
          // the Reviewers sheet changes (consent dates, status transitions).
          var _rdDv = getDataVersions_();
          var _rdKey = 'rd:v1:' + _rdDv.reviewers;
          var _rdSc = _scriptCache_();
          try {
            var _rdCached = _rdSc.get(_rdKey);
            if (_rdCached) {
              var _rdP = JSON.parse(_rdCached);
              if (_rdP && _rdP.success) { _rdP.cached = true; return _rdP; }
            }
          } catch (_) {}

          // _cachedSheetData_ so getReviewers + getReviewDeadlines in the same
          // execution (e.g. getProjectDashboard) share the single Reviewers read.
          var revSheet = getReviewersSheet();
          var revData = _cachedSheetData_(revSheet);
          var now = new Date();
          var TEN_DAYS_MS = 10 * 24 * 60 * 60 * 1000;
          var deadlines = [];

          for (var i = 1; i < revData.length; i++) {
            var row = revData[i];
            var status = String(row[REV_COL.STATUS - 1] || '').trim();
            if (status !== 'consented') continue; // only track consented but not yet reviewed
            var consentRaw = String(row[REV_COL.CONSENT - 1] || '');
            var consentDate = null;
            try {
              var parsed = JSON.parse(consentRaw);
              if (parsed.consentDate) consentDate = new Date(parsed.consentDate);
            } catch (_) {
              // Legacy format: plain 'true' — no consent date tracked
            }
            if (!consentDate || isNaN(consentDate.getTime())) continue;
            var deadline = new Date(consentDate.getTime() + TEN_DAYS_MS);
            var overdue = now > deadline;
            var daysLeft = Math.ceil((deadline.getTime() - now.getTime()) / (24 * 60 * 60 * 1000));
            deadlines.push({
              reviewerEmail: String(row[REV_COL.EMAIL - 1] || '').trim(),
              reviewerName: String(row[REV_COL.NAME - 1] || '').trim(),
              formId: String(row[REV_COL.FORM_ID - 1] || '').trim(),
              competitionId: String(row[REV_COL.COMPETITION - 1] || '').trim(),
              consentDate: consentDate.toISOString().substring(0, 10),
              reviewDeadline: deadline.toISOString().substring(0, 10),
              daysLeft: daysLeft,
              overdue: overdue
            });
          }
          deadlines.sort(function(a, b) { return (a.overdue ? 0 : 1) - (b.overdue ? 0 : 1) || a.daysLeft - b.daysLeft; });
          var _rdResult = { success: true, deadlines: deadlines, overdueCount: deadlines.filter(function(d) { return d.overdue; }).length };
          try {
            var _rdJs = JSON.stringify(_rdResult);
            if (_rdJs.length < 50000) _rdSc.put(_rdKey, _rdJs, PERF_MODE ? 300 : 120);
          } catch (_) {}
          return _rdResult;
        } catch (err) {
          logError('getReviewDeadlines', err, body);
          return { success: false, error: 'getReviewDeadlines failed: ' + err.message };
        }
      }

      /**
       * Get overdue contract signing deadlines.
       * Scans approved_for_funding applications that lack a signed contract
       * beyond the 10-day window from approval.
       */
      function getContractDeadlines(body) {
        try {
          var auth = resolveAuthContext(body);
          var appSheet = getSheet();
          var data = appSheet.getDataRange().getValues();
          var now = new Date();
          var TEN_DAYS_MS = 10 * 24 * 60 * 60 * 1000;
          var deadlines = [];

          for (var i = 1; i < data.length; i++) {
            var r = data[i];
            var status = String(r[COL.STATUS - 1]).trim();
            if (status !== 'approved_for_funding' && status !== 'contracting') continue;
            var contractId = String(r[COL.CONTRACT_ID - 1] || '').trim();
            // Look for the approval timestamp in history
            var history = [];
            try { history = JSON.parse(String(r[COL.HISTORY - 1] || '[]')); } catch (_) {}
            var approvalDate = null;
            for (var h = history.length - 1; h >= 0; h--) {
              var action = String(history[h].action || '').toLowerCase();
              if (action.indexOf('approved_for_funding') >= 0 || action.indexOf('одобрено за финансиране') >= 0 || (history[h].status === 'approved_for_funding')) {
                approvalDate = new Date(history[h].date || history[h].ts || '');
                break;
              }
            }
            if (!approvalDate || isNaN(approvalDate.getTime())) continue;
            var deadline = new Date(approvalDate.getTime() + TEN_DAYS_MS);
            var overdue = now > deadline && !contractId;
            deadlines.push({
              formId: String(r[COL.ID - 1]),
              title: String(r[COL.TITLE - 1]),
              leaderEmail: String(r[COL.USER_EMAIL - 1]),
              leaderName: String(r[COL.USER_NAME - 1]),
              status: status,
              hasContract: !!contractId,
              approvalDate: approvalDate.toISOString().substring(0, 10),
              signingDeadline: deadline.toISOString().substring(0, 10),
              overdue: overdue
            });
          }

          deadlines.sort(function(a, b) { return (a.overdue ? 0 : 1) - (b.overdue ? 0 : 1) || (a.signingDeadline < b.signingDeadline ? -1 : 1); });
          return { success: true, deadlines: deadlines, overdueCount: deadlines.filter(function(d) { return d.overdue; }).length };
        } catch (err) {
          logError('getContractDeadlines', err, body);
          return { success: false, error: 'getContractDeadlines failed: ' + err.message };
        }
      }

      /**
       * Send contract signing deadline reminders.
       */
      /**
       * Send review-deadline reminder notifications.
       * Scans Reviewers sheet for consented reviewers whose 10-day deadline
       * is within horizonDays or already passed. Respects email_review_reminder
       * preference so reviewers can opt out.
       *
       * Body params:
       *   horizonDays  : Number   (default 3)
       *   dryRun       : Boolean  (default false)
       */
      function sendReviewDeadlineReminders(body) {
        try {
          body = body || {};
          var auth = resolveAuthContext(body);
          if (!auth.isAdmin) return { success: false, error: 'Нямате право.' };
          var horizonDays = Math.max(1, Math.min(30, Number(body.horizonDays) || 3));
          var dryRun = body.dryRun === true || body.dryRun === 'true';
          var revSheet = getReviewersSheet();
          var data = revSheet.getDataRange().getValues();
          var now = Date.now();
          var DUE_MS = 10 * 24 * 60 * 60 * 1000; // 10-day review deadline from consent
          var recipients = [];
          for (var i = 1; i < data.length; i++) {
            var row = data[i];
            var status = String(row[REV_COL.STATUS - 1] || '').toLowerCase().trim();
            if (status !== 'consented') continue;
            var consentRaw = String(row[REV_COL.CONSENT - 1] || '');
            var consentData = {};
            try { consentData = JSON.parse(consentRaw); } catch (_) {}
            if (!consentData.consented || !consentData.consentDate) continue;
            var consentTs = new Date(consentData.consentDate).getTime();
            if (isNaN(consentTs)) continue;
            var deadlineTs = consentTs + DUE_MS;
            var daysRemaining = Math.ceil((deadlineTs - now) / (24 * 60 * 60 * 1000));
            var overdue = daysRemaining <= 0;
            if (!overdue && daysRemaining > horizonDays) continue;
            var reviewerEmail = String(row[REV_COL.EMAIL - 1] || '').trim().toLowerCase();
            var reviewerName = String(row[REV_COL.NAME - 1] || '').trim();
            var formId = String(row[REV_COL.FORM_ID - 1] || '').trim();
            if (!reviewerEmail || !formId) continue;
            recipients.push({
              email: reviewerEmail,
              name: reviewerName,
              formId: formId,
              deadline: new Date(deadlineTs).toISOString().substring(0, 10),
              daysRemaining: daysRemaining,
              overdue: overdue
            });
          }
          if (dryRun) return { success: true, dryRun: true, recipients: recipients, count: recipients.length };
          var sent = 0;
          recipients.forEach(function(rcp) {
            try {
              var heading = rcp.overdue ? '⚠️ Просрочена рецензия' : '📋 Наближава краен срок за рецензия';
              var lines = [
                { label: 'Рецензент:', value: rcp.name || rcp.email },
                { label: 'Заявка:', value: rcp.formId },
                { label: 'Краен срок:', value: rcp.deadline },
                { label: 'Статус:', value: rcp.overdue ? 'ПРОСРОЧЕНА (' + Math.abs(rcp.daysRemaining) + ' дни)' : 'Остават ' + rcp.daysRemaining + ' дни' }
              ];
              var footer = rcp.overdue
                ? 'Рецензията е просрочена. Моля, подайте я възможно най-скоро.'
                : 'Моля, подайте рецензията преди изтичане на крайния срок (10 дни от даване на съгласие).';
              notifyApplicant_(rcp.email, heading + ' – ' + rcp.formId, buildNotificationHtml_(heading, lines, footer), 'review_reminder');
              sent++;
            } catch (_) {}
          });
          return { success: true, sent: sent, totalCandidates: recipients.length };
        } catch (err) {
          logError('sendReviewDeadlineReminders', err, body);
          return { success: false, error: 'sendReviewDeadlineReminders failed: ' + err.message };
        }
      }

      function sendContractReminders(body) {
        try {
          var auth = body ? resolveAuthContext(body) : { isAdmin: true, userId: 'system' };
          if (!auth.isAdmin) return { success: false, error: 'Нямате право.' };
          var dlRes = getContractDeadlines({ userId: auth.userId });
          if (!dlRes.success) return dlRes;
          var sent = 0;
          (dlRes.deadlines || []).forEach(function(dl) {
            if (!dl.hasContract && dl.leaderEmail) {
              var heading = dl.overdue ? '⚠️ Просрочен срок за подписване на договор' : '📝 Наближава краен срок за подписване';
              try {
                notifyApplicant_(dl.leaderEmail,
                  heading + ' – ' + (dl.title || dl.formId),
                  buildNotificationHtml_(heading,
                    [{ label: 'Проект:', value: dl.title || dl.formId }, { label: 'Краен срок:', value: dl.signingDeadline }, { label: 'Статус:', value: dl.overdue ? 'ПРОСРОЧЕН' : 'Предстоящ' }],
                    dl.overdue ? 'Договорът трябваше да бъде подписан до ' + dl.signingDeadline + '. Свържете се с администрацията.' : 'Моля, подпишете договора преди ' + dl.signingDeadline + '.'
                  ),
                  'contract'
                );
                sent++;
              } catch (_) {}
            }
          });
          return { success: true, sent: sent };
        } catch (err) {
          logError('sendContractReminders', err, body);
          return { success: false, error: 'sendContractReminders failed: ' + err.message };
        }
      }

      // ============================================================
      //  PUBLICATION LIBRARY TRACKING — per regulation:
      //  "Минимум 3 екземпляра или електронен екземпляр се предоставят
      //   на университетската библиотека в срок до 1 месец"
      // ============================================================

      /**
       * Register a publication result and optionally notify the library.
       */
      function registerPublication(body) {
        try {
          var auth = resolveAuthContext(body);
          var projectId = String(body.projectId || '').trim();
          if (!projectId) return { success: false, error: 'Липсва projectId.' };

          // Create deliverable
          var delBody = {
            projectId: projectId,
            type: body.publicationType || 'publication_other',
            title: String(body.title || '').trim(),
            description: String(body.description || '').trim(),
            status: body.status || 'completed',
            completedDate: body.completedDate || new Date().toISOString().substring(0, 10),
            url: String(body.url || '').trim(),
            metadata: JSON.stringify({
              journal: body.journal || '',
              doi: body.doi || '',
              authors: body.authors || '',
              indexing: body.indexing || '',
              copiesProvided: body.copiesProvided || false,
              electronicCopyProvided: body.electronicCopyProvided || false,
              libraryNotifiedAt: null
            }),
            userId: auth.userId
          };
          var delResult = addDeliverable(delBody);
          if (!delResult.success) return delResult;

          // Calculate library submission deadline (1 month from completion)
          var completionDate = new Date(delBody.completedDate);
          var libraryDeadline = new Date(completionDate);
          libraryDeadline.setMonth(libraryDeadline.getMonth() + 1);

          // Notify library (configurable via LIBRARY_EMAIL property or default)
          var libraryEmail = '';
          try { libraryEmail = _scriptProps_().getProperty('LIBRARY_EMAIL') || ''; } catch (_) {}
          var librarySent = false;
          if (body.notifyLibrary && libraryEmail) {
            try {
              var _libNr = notifyApplicant_(libraryEmail,
                '📚 Нова публикация от научен проект – ' + delBody.title,
                buildNotificationHtml_(
                  'Регистрирана е нова публикация от научен проект',
                  [
                    { label: 'Заглавие:', value: delBody.title },
                    { label: 'Автори:', value: body.authors || '' },
                    { label: 'Проект:', value: projectId },
                    { label: 'DOI:', value: body.doi || '—' },
                    { label: 'Списание:', value: body.journal || '—' },
                    { label: 'Индексиране:', value: body.indexing || '—' },
                    { label: 'Краен срок (библиотека):', value: libraryDeadline.toISOString().substring(0, 10) }
                  ],
                  'Съгласно правилника, минимум 3 екземпляра или електронно копие трябва да бъдат предоставени на библиотеката в срок до ' + libraryDeadline.toISOString().substring(0, 10) + '.'
                ),
                'report_due'
              );
              librarySent = !!(_libNr && _libNr.ok);
            } catch (le) { console.warn('Library notification failed: ' + le.message); }
          }

          return {
            success: true,
            deliverableId: delResult.deliverableId,
            libraryDeadline: libraryDeadline.toISOString().substring(0, 10),
            libraryNotified: librarySent
          };
        } catch (err) {
          logError('registerPublication', err, body);
          return { success: false, error: 'registerPublication failed: ' + err.message };
        }
      }

      /**
       * Get library submission status for publications across projects.
       */
      function getLibrarySubmissions(body) {
        try {
          var auth = resolveAuthContext(body);
          var projectId = String(body.projectId || '').trim();
          var delSheet = getDeliverablesSheet();
          var data = delSheet.getDataRange().getValues();
          var publications = [];
          var now = new Date();

          for (var i = 1; i < data.length; i++) {
            var r = data[i];
            var dtype = String(r[DEL_COL.TYPE - 1]).trim();
            if (!dtype.startsWith('publication_') && dtype !== 'monograph') continue;
            if (projectId && String(r[DEL_COL.PROJECT_ID - 1]).trim() !== projectId) continue;
            var meta = {};
            try { meta = JSON.parse(String(r[DEL_COL.METADATA - 1] || '{}')); } catch (_) {}
            var compDate = String(r[DEL_COL.COMPLETED_DATE - 1]).trim();
            var libDeadline = null;
            if (compDate) {
              libDeadline = new Date(compDate);
              libDeadline.setMonth(libDeadline.getMonth() + 1);
            }
            var copiesOk = !!(meta.copiesProvided || meta.electronicCopyProvided);
            publications.push({
              id: String(r[DEL_COL.ID - 1]),
              projectId: String(r[DEL_COL.PROJECT_ID - 1]),
              type: dtype,
              title: String(r[DEL_COL.TITLE - 1]),
              completedDate: compDate,
              libraryDeadline: libDeadline ? libDeadline.toISOString().substring(0, 10) : null,
              copiesProvided: copiesOk,
              overdue: libDeadline && !copiesOk && now > libDeadline,
              journal: meta.journal || '',
              doi: meta.doi || ''
            });
          }

          return {
            success: true,
            publications: publications,
            overdueCount: publications.filter(function(p) { return p.overdue; }).length,
            providedCount: publications.filter(function(p) { return p.copiesProvided; }).length
          };
        } catch (err) {
          logError('getLibrarySubmissions', err, body);
          return { success: false, error: 'getLibrarySubmissions failed: ' + err.message };
        }
      }

      /**
       * Mark library copies as provided for a publication.
       */
      function confirmLibrarySubmission(body) {
        try {
          var auth = resolveAuthContext(body);
          var deliverableId = String(body.deliverableId || '').trim();
          if (!deliverableId) return { success: false, error: 'Липсва deliverableId.' };
          var delSheet = getDeliverablesSheet();
          var data = delSheet.getDataRange().getValues();
          for (var i = 1; i < data.length; i++) {
            if (String(data[i][DEL_COL.ID - 1]).trim() !== deliverableId) continue;
            var meta = {};
            try { meta = JSON.parse(String(data[i][DEL_COL.METADATA - 1] || '{}')); } catch (_) {}
            meta.copiesProvided = !!body.copiesProvided;
            meta.electronicCopyProvided = !!body.electronicCopyProvided;
            meta.libraryNotifiedAt = new Date().toISOString();
            delSheet.getRange(i + 1, DEL_COL.METADATA).setValue(JSON.stringify(meta));
            logTransaction('CONFIRM_LIBRARY', auth.userId, deliverableId, { copiesProvided: meta.copiesProvided, electronicCopy: meta.electronicCopyProvided });
            return { success: true };
          }
          return { success: false, error: 'Публикацията не е намерена.' };
        } catch (err) {
          logError('confirmLibrarySubmission', err, body);
          return { success: false, error: 'confirmLibrarySubmission failed: ' + err.message };
        }
      }

      // ============================================================
      //  APPLICATION VERSION HISTORY — retrieve snapshots
      // ============================================================

      /**
       * Get version history (snapshots) from an application's history log.
       * Returns original and corrected versions for comparison.
       */
      function getApplicationVersions(body) {
        try {
          var auth = resolveAuthContext(body);
          var formId = String(body.formId || body.id || '').trim();
          if (!formId) return { success: false, error: 'Липсва formId.' };
          var sheet = getSheet();
          var found = findRowByID(sheet, formId);
          if (!found) return { success: false, error: 'Заявлението не е намерено.' };
          var history = [];
          try { history = JSON.parse(String(found.rowData[COL.HISTORY - 1] || '[]')); } catch (_) {}
          var versions = history.filter(function(h) { return h.snapshot; }).map(function(h) {
            return { version: h.snapshot.version, timestamp: h.date || h.ts, user: h.user, data: h.snapshot };
          });
          return { success: true, versions: versions, totalVersions: versions.length };
        } catch (err) {
          logError('getApplicationVersions', err, body);
          return { success: false, error: 'getApplicationVersions failed: ' + err.message };
        }
      }

