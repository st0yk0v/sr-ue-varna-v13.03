      // ── MinistryReports sheet ─────────────────────────────────
      var MINISTRY_REPORTS_SHEET_NAME = 'MinistryReports';
      var MON_COL = {
        ID:1, REPORT_TYPE:2, PERIOD:3, YEAR:4, STATUS:5,
        DATA_SNAPSHOT:6, EDITED_DATA:7, EDITORIAL_NOTES:8,
        DRAFT_BY:9, DRAFT_AT:10, EDITED_BY:11, EDITED_AT:12,
        FINALIZED_BY:13, FINALIZED_AT:14, SUBMITTED_BY:15, SUBMITTED_AT:16,
        SUBMISSION_REF:17, ACKNOWLEDGED_AT:18, EXPORT_FILE_ID:19,
        EXPORT_XLSX_ID:20, SIGNATURE_HASH:21, SIGNATURE_DATA:22,
        HISTORY:23, ATTACHMENTS:24, NOTES:25
      };
