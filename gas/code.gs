      /**
       * "Активни Конкурси" sheet — public contest board.
       * Applicants see active/open contests with deadline, description, and application count.
       * Columns: №, ID конкурс, Наименование, Краен срок, Оставащи дни, Описание, Статус, Брой заявления
       */
      function syncActiveContestsSheet_() {
        try {
          var ss = _getCachedSpreadsheet();
          var sheet = ss.getSheetByName(ACTIVE_CONTESTS_SHEET);
          var headers = ['№', 'ID конкурс', 'Наименование', 'Краен срок', 'Оставащи дни', 'Описание', 'Статус', 'Брой заявления'];

          if (!sheet) {
            sheet = ss.insertSheet(ACTIVE_CONTESTS_SHEET);
            sheet.setFrozenRows(1);
          }
          sheet.clear();
          sheet.getRange(1, 1, 1, headers.length).setValues([headers])
            .setBackground('#7B0000').setFontColor('#fff').setFontWeight('bold');
          sheet.setColumnWidth(1, 40);
          sheet.setColumnWidth(2, 110);
          sheet.setColumnWidth(3, 280);
          sheet.setColumnWidth(4, 130);
          sheet.setColumnWidth(5, 100);
          sheet.setColumnWidth(6, 350);
          sheet.setColumnWidth(7, 100);
          sheet.setColumnWidth(8, 120);

          var competitions = getOrCacheCompetitions(true);
          var appSheet = ss.getSheetByName(SHEET_NAME);
          var appData = appSheet ? _cachedSheetData_(appSheet) : [];

          // Count applications per competition
          var appCounts = {};
          for (var a = 1; a < appData.length; a++) {
            var cid = String(appData[a][COL.COMPETITION - 1] || '').trim();
            if (cid) appCounts[cid] = (appCounts[cid] || 0) + 1;
          }

          var now = Date.now();
          var rows = [];
          var seq = 0;
          for (var i = 0; i < competitions.length; i++) {
            var c = competitions[i];
            if (!shouldExposeCompetitionToApplicant_(c)) continue;
            seq++;
            var dl = String(c.deadline || c.dateEnd || '').trim();
            var daysLeft = '';
            if (dl) {
              var dlDate = new Date(dl);
              if (!isNaN(dlDate.getTime())) {
                daysLeft = Math.max(0, Math.ceil((dlDate.getTime() - now) / 86400000));
              }
            }
            var statusLabel = '';
            var norm = normalizeCompetitionStatus_(c.status);
            if (norm === 'active') statusLabel = 'Активен';
            else if (norm === 'closed') statusLabel = 'Затворен';
            else if (norm === 'draft') statusLabel = 'Чернова';
            else statusLabel = norm;

            rows.push([
              seq,
              String(c.id || ''),
              String(c.name || ''),
              dl ? Utilities.formatDate(new Date(dl), 'Europe/Sofia', 'dd.MM.yyyy') : '',
              daysLeft === '' ? '' : daysLeft,
              String(c.description || ''),
              statusLabel,
              appCounts[c.id] || 0
            ]);
          }

          if (rows.length > 0) {
            sheet.getRange(2, 1, rows.length, headers.length).setValues(rows);
            // Color active rows green-ish, closed yellow
            for (var r = 0; r < rows.length; r++) {
              var st = String(rows[r][6]).toLowerCase();
              var bg = st === 'активен' ? '#E8F5E9' : (st === 'затворен' ? '#FFFDE7' : '#FFFFFF');
              sheet.getRange(r + 2, 1, 1, headers.length).setBackground(bg);
            }
          }

          try { protectManagedSheet_(sheet, 'ERP Активни Конкурси — автоматично генерирана справка'); } catch (_) {}

        } catch (e) {
          console.warn('syncActiveContestsSheet_ failed: ' + e.message);
        }
      }

