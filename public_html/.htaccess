<IfModule mod_mime.c>
    # Serve PWA manifest with correct MIME type (required for installability)
    AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Disable content negotiation — without this Apache's MultiViews maps the
    # POST /api request to the real file /api.php (legacy backend) and serves
    # THAT instead of dispatching to index.php (Laravel /api bridge). This was
    # the root cause of "POST /api 500" — the SPA hit the legacy api.php, not
    # the Laravel bridge.
    Options -MultiViews

    # ── Directory index ─────────────────────────────────────────────────
    # The legacy JS SPA (public/index.html) is the PRIMARY frontend and is
    # served at "/". It talks to Laravel exclusively through the STATELESS
    # /api bridge (POST /api with Authorization: Bearer *** so it needs NO
    # PHP session and NO CSRF cookie). This is what makes it work inside the
    # cross-site iframe on scienceandresearch.ue-varna.bg (third-party cookie
    # / SameSite rules would otherwise break a session-based Inertia visit).
    # Laravel/Inertia (index.php) still answers every other path
    # (/dashboard, /login, /api, deep links), so the backend stays connected.
    DirectoryIndex index.html index.php

    # ── /api bridge → legacy database/api.php (stateless, must reach PHP) ──
    # Routes ALL /api requests to the legacy PHP backend (database/api.php)
    # which contains the full action_map + handlers. Laravel only handles
    # /sqldetachdocument; everything else is legacy. Placed FIRST so nothing
    # else can intercept it.
    RewriteRule ^api/?(.*)$ database/api.php?path=$1 [L,QSA]

    # Explicit, deterministic root → legacy SPA (in case server config
    # overrides DirectoryIndex). Real files (js/, assets/, css/) are served
    # directly by the rules below; /api is dispatched to index.php.
    RewriteCond %{REQUEST_URI} ^/$
    RewriteCond %{DOCUMENT_ROOT}/index.html -f
    RewriteRule ^ index.html [L]

    # ── HTTPS redirect ──────────────────────────────────────────────────
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L,QSA]

    # ── Security headers ────────────────────────────────────────────────
    <IfModule mod_headers.c>
        Header always set X-Content-Type-Options "nosniff"
        Header always set X-XSS-Protection "1; mode=block"
        Header always set Cross-Origin-Opener-Policy "unsafe-none"
        Header always set Cross-Origin-Embedder-Policy "unsafe-none"
        Header always set Referrer-Policy "strict-origin-when-cross-origin"
        Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
        Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
        Header always set Content-Security-Policy "frame-ancestors 'self' https://scienceandresearch.ue-varna.bg https://sr-ue-varna.com https://docs.google.com https://drive.google.com https://*.google.com; frame-src 'self' https://docs.google.com https://drive.google.com https://*.google.com;"
        # v12.32: never cache HTML/PHP app responses — prevents stale 404s from the
        # Hostinger hcdn edge after a deploy, and ensures authenticated pages are fresh.
        <FilesMatch "\.(html|php)$">
            Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
            Header set Pragma "no-cache"
        </FilesMatch>
    </IfModule>

    # ── Performance: gzip + Brotli compression ─────────────────────────
    # Prefer Brotli (mod_brotli) for ~15-20% better compression than gzip.
    # Fall back to gzip (mod_deflate) when Brotli is unavailable.
    <IfModule mod_brotli.c>
        BrotliCompressionQuality 6
        AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css \
            application/javascript application/json application/xml \
            image/svg+xml font/woff2 font/woff
        # Don't compress already-compressed formats — wastes CPU for <1% gain
        SetEnvIfNoCase Request_URI \.\(png\|jpe?g\|gif\|webp\|svg\|woff2\|ttf\|otf\|eot\)$ no-brotli
        SetEnvIfNoCase Request_URI \.\(zip\|gz\|br\|rar\|7z\)$ no-brotli
        # Don't compress tiny responses — overhead > savings under ~1KB
        Header append Vary User-Agent env=no-brotli
    </IfModule>

    <IfModule mod_deflate.c>
        # Fallback when Brotli unavailable (shared hosting often lacks mod_brotli)
        AddOutputFilterByType DEFLATE text/html text/plain text/css \
            application/javascript application/json application/xml \
            image/svg+xml font/woff2
        # Don't waste CPU compressing already-compressed images/fonts
        SetEnvIfNoCase Request_URI \.\(png\|jpe?g\|gif\|webp\|svg\|woff2\|ttf\|otf\|eot\)$ no-gzip
        SetEnvIfNoCase Request_URI \.\(zip\|gz\|br\|rar\|7z\)$ no-gzip
        # Add vary so CDNs cache both compressed + uncompressed variants
        Header append Vary Accept-Encoding env=no-gzip
    </IfModule>

    # ── Caching: long-lived versioned assets + stale-while-revalidate ──
    # All shipped JS/CSS/images carry a ?v= token (semver), so they are
    # content-addressed and safe to cache for a full year on browser + CDN.
    # The CDN edge may serve a stale copy for up to 8h while revalidating
    # in the background — transparent to the user, zero origin load for
    # repeat visits.
    <IfModule mod_expires.c>
        ExpiresActive On
        # Versioned static assets — immutable, 1-year browser + edge cache
        ExpiresByType image/png              "access plus 1 year"
        ExpiresByType image/jpeg             "access plus 1 year"
        ExpiresByType image/webp             "access plus 1 year"
        ExpiresByType image/svg+xml          "access plus 1 year"
        ExpiresByType font/woff2             "access plus 1 year"
        ExpiresByType font/woff              "access plus 1 year"
        ExpiresByType font/ttf               "access plus 1 year"
        ExpiresByType image/x-icon           "access plus 1 year"
        # Never cache JSON API responses — always fresh from origin
        ExpiresByType application/json       "access plus 0 seconds"
    </IfModule>

    # Edge+CDN caching rules for versioned assets: serve stale while
    # revalidating in background. Applies to hashed/?v= resources only.
    <IfModule mod_headers.c>
        <FilesMatch "\.(css|js|png|jpg|jpeg|webp|svg|woff2|woff|ttf|eot|ico)$">
            Header append Cache-Control "public, max-age=31536000, immutable"
        </FilesMatch>
        <FilesMatch "\.json$">
            Header append Cache-Control "private, no-cache, no-store, must-revalidate"
        </FilesMatch>
        # Stale-while-revalidate for versioned assets served from the edge/CDN.
        # The browser keeps using the stale copy for up to 1 hour while revalidating
        # in the background — zero layout shift, zero origin load for repeat visits.
        <FilesMatch "\.(css|js|png|jpg|jpeg|webp|svg|woff2|woff|ico)$">
            Header append Cache-Control "stale-while-revalidate=3600"
        </FilesMatch>
    </IfModule>

    # ── Block sensitive files ───────────────────────────────────────────
    <FilesMatch "\.(env|sql|md|log|gitignore|example|phar|bak|bak2)$">
        Require all denied
    </FilesMatch>

    # ── Laravel front controller ────────────────────────────────────────
    # /api is already routed to index.php above. Do NOT rewrite requests for
    # other real files (legacy api.php, assets, styles.css, uev.css, images).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Legacy endpoints + static assets are served directly by Apache.
    RewriteCond %{REQUEST_URI} ^/(api\.php|assets|styles\.css|styles-responsive\.css|uev\.css|uev-responsive\.css|css|js|build|favicon\.ico|robots\.txt|manifest\.webmanifest) [NC]
    RewriteRule ^ - [L]

    # ── SPA readable URLs (/projects*) → legacy SPA shell (index.html) ──
    # Senior-team requested readable URLs. Serve the legacy SPA for /projects*
    # so its parseRoute() can read the path client-side; Laravel/Inertia keeps
    # /api, /dashboard, /login. Placed after real-file/static-asset exclusions,
    # before the index.php fallback.
    # ── Real PHP files: serve directly, never route through index.php ──
    # stream-doc.php, proxy-doc.php, and other standalone PHP endpoints must
    # execute as real files — the catch-all index.php rule below must not
    # intercept them. v12.51.3.
    RewriteCond %{REQUEST_URI} !^.+/database/api\.php$
    RewriteCond %{REQUEST_URI} !^.+/stream-doc\.php$
    RewriteCond %{REQUEST_URI} !^.+/proxy-doc\.php$
    RewriteCond %{REQUEST_URI} !^.+/opcache-reset\.php$
    RewriteCond %{REQUEST_URI} !^.+/security-headers\.php$
    RewriteCond %{REQUEST_URI} !^.+/metrics\.php$
    # /reviewers → 301 redirect to /staff-members
    RewriteCond %{REQUEST_URI} ^/reviewers(/.*)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}/staff-members%1 [R=301,L]

    # /documents /projects /finance /dashboard /calendar /applications
    # /staff-members /teachers → serve the SPA shell (index.html)
    RewriteCond %{REQUEST_URI} ^/(login|myprofile|documents|projects|finance|dashboard|calendar|applications|staff-members|teachers)(/.*)?$ [NC]
    RewriteRule ^ index.html [END]
    RewriteRule ^ index.php [L]

    # ── SPA catch-all: serve index.html for any path not matching a real file/dir ──
    # Client-side router (parseRoute) handles /applications, /calendar, /projects,
    # /myprofile, /documents, and any other route. v12.54.50-uev.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [END]
</IfModule>
